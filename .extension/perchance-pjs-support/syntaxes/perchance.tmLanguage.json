{
  "$schema": "tmlanguage.schema.json",
  "name": "Perchance",
  "scopeName": "source.perchance",
  "fileTypes": ["pjs", "perchance"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#functionDefinition" },
    { "include": "#importAssignment" },
    { "include": "#specialBlocks" },
    { "include": "#assignment" },
    { "include": "#jsBlock" },
    { "include": "#alternation" },
    { "include": "#weights" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.perchance",
          "match": "^\\s*//.*$"
        }
      ]
    },
    "functionDefinition": {
      "name": "meta.function.perchance",
      "match": "^\\s*([A-Za-z_][\\w$]*)\\s*\\(([^)]*)\\)\\s*=>",
      "captures": {
        "1": { "name": "entity.name.function.perchance" },
        "2": { "name": "variable.parameter.perchance" }
      }
    },
    "importAssignment": {
      "name": "meta.import.perchance",
      "match": "^\\s*([A-Za-z_][\\w$]*)\\s*=\\s*\\{\\s*import:([^}]+)\\}",
      "captures": {
        "1": { "name": "variable.other.readwrite.perchance" },
        "2": { "name": "string.unquoted.perchance" }
      }
    },
    "specialBlocks": {
      "patterns": [
        {
          "name": "keyword.control.perchance",
          "match": "^\\s*(\\$meta|\\$output)\\b"
        }
      ]
    },
    "assignment": {
      "name": "meta.assignment.perchance",
      "match": "^\\s*([A-Za-z_][\\w$]*)\\s*=\\s*(.+)$",
      "captures": {
        "1": { "name": "variable.other.readwrite.perchance" },
        "2": { "name": "string.unquoted.perchance" }
      }
    },
    "jsBlock": {
      "name": "meta.embedded.block.js.perchance",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.perchance" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.perchance" }
      },
      "patterns": [{ "include": "#jsBlock" }, { "include": "source.js" }]
    },
    "alternation": {
      "name": "meta.alternation.perchance",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.perchance" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.perchance" }
      },
      "patterns": [
        {
          "name": "keyword.operator.separator.perchance",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.weight.perchance",
          "match": "\\^[0-9]+"
        },
        { "include": "#jsBlock" }
      ]
    },
    "weights": {
      "patterns": [
        {
          "name": "keyword.operator.weight.perchance",
          "match": "\\^[0-9]+"
        },
        {
          "name": "meta.weight.conditional.perchance",
          "begin": "\\^\\[",
          "beginCaptures": {
            "0": { "name": "keyword.operator.weight.perchance" }
          },
          "end": "\\^\\]",
          "endCaptures": {
            "0": { "name": "keyword.operator.weight.perchance" }
          },
          "patterns": [{ "include": "source.js" }]
        }
      ]
    }
  }
}
