{
  "Basic table": {
    "prefix": "table",
    "body": ["${1:tableName}", "  ${2:item1}", "  ${3:item2}", "  ${4:item3}"],
    "description": "Create a basic Perchance table"
  },
  "Weighted item": {
    "prefix": "weight",
    "body": ["${1:tableName}", "  ${2:item}^${3:2}"],
    "description": "Create a weighted item in a table"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "${1:fnName}(${2:args}) =>",
      "  ${3:// body}",
      "  return ${4:value};"
    ],
    "description": "Create a Perchance function"
  },
  "Output block": {
    "prefix": "output",
    "body": ["$output = [${1:tableName}]"],
    "description": "Set $output from a table"
  },
  "Meta block": {
    "prefix": "meta",
    "body": [
      "$meta",
      "  title = ${1:Title}",
      "  description = ${2:Description}"
    ],
    "description": "Create a $meta block"
  }
}
