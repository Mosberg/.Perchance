{
  "name": "perchance-pjs-support",
  "displayName": "Perchance (.pjs) Language Support",
  "description": "Language support for Perchance generator files (.pjs): syntax highlighting, IntelliSense, diagnostics, formatting, preview, and graph views.",
  "version": "0.1.0",
  "publisher": "perchance-tools",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "icon": "media/perchance-icon.png",
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:perchance",
    "onCommand:perchance.preview",
    "onCommand:perchance.previewMulti",
    "onCommand:perchance.showGraph",
    "onCommand:perchance.rebuildIndex"
  ],
  "contributes": {
    "languages": [
      {
        "id": "perchance",
        "aliases": [
          "Perchance",
          "perchance"
        ],
        "extensions": [
          ".pjs",
          ".perchance"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "perchance",
        "scopeName": "source.perchance",
        "path": "./syntaxes/perchance.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "perchance",
        "path": "./snippets/perchance.json"
      }
    ],
    "commands": [
      {
        "command": "perchance.preview",
        "title": "Perchance: Preview Output"
      },
      {
        "command": "perchance.previewMulti",
        "title": "Perchance: Preview Multiple Outputs"
      },
      {
        "command": "perchance.showGraph",
        "title": "Perchance: Show Table Dependency Graph"
      },
      {
        "command": "perchance.rebuildIndex",
        "title": "Perchance: Rebuild Workspace Index"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "perchance.preview",
          "group": "navigation",
          "when": "editorLangId == perchance"
        },
        {
          "command": "perchance.showGraph",
          "group": "navigation",
          "when": "editorLangId == perchance"
        }
      ]
    },
    "configuration": {
      "title": "Perchance (.pjs)",
      "properties": {
        "perchance.format.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Indent size (spaces) for formatted Perchance tables."
        },
        "perchance.format.alignWeights": {
          "type": "boolean",
          "default": true,
          "description": "Align ^weights in list items when formatting."
        },
        "perchance.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Perchance diagnostics (linting)."
        },
        "perchance.preview.defaultRuns": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Default number of runs for multi-preview."
        },
        "perchance.preview.defaultSeed": {
          "type": "string",
          "default": "",
          "description": "Default seed for deterministic preview (empty for random)."
        }
      }
    }
  }
}
