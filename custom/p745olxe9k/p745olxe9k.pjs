ai = {import:ai-text-plugin}
comments = {import:comments-plugin}
literal = {import:literal-plugin}
kv = {import:kv-plugin}
remember = {import:remember-plugin}

modes
  general
    category = Core
    label = 🧑‍💻 Freeform
    description = General-purpose mode for coding or writing requests.
    instructionPlaceholder = Write your instruction/question here.
    instruction
      [literal(instructionEl.value)]
      $output = [this.joinItems("\n")]

  brainy
    category = Core
    label = 🤓 Brainy
    description = Encourages deeper reasoning before answering.
    instructionPlaceholder = Ask a question where careful reasoning matters...
    instruction
      [literal(instructionEl.value)]
      [""]
      Think step by step and verify the answer before finalizing.
      $output = [this.joinItems("\n")]

  markdown
    category = Core
    label = 📝 Markdown
    description = Generates structured markdown documents.
    instructionPlaceholder = Describe what markdown content you want...
    instruction
      Generate markdown content based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Use clear headings, lists, links, and fenced code blocks when relevant.
      $output = [this.joinItems("\n")]

  character
    category = Core
    label = 👤 Character
    description = Creates detailed character profile outputs.
    instructionPlaceholder = Describe the character you want...
    instruction
      Generate a complete character profile based on this description:
      [literal(instructionEl.value)]
      [""]
      Include role, personality, style, and opening dialogue.
      $output = [this.joinItems("\n")]

  html
    category = Code
    label = 🌐 HTML/CSS/JS
    description = Generates web code and renders it in a sandbox frame.
    instructionPlaceholder = Describe the web page / UI / demo you want...
    instruction
      Generate HTML/CSS/JS code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Keep output self-contained in one HTML file with inline <style> and <script> when needed.
      $output = [this.joinItems("\n")]
    onFinish(data) =>
      let htmlPage;
      if(!htmlPage) htmlPage = (responseEl.value.match(/```(html|)(.+?)```/s) || [])[2];
      if(!htmlPage) htmlPage = (responseEl.value.match(/<!DOCTYPE html>(.+)<\/html>/s) || [])[0];
      if(!htmlPage) htmlPage = responseEl.value;
      renderedOutputEl.innerHTML = `<iframe srcdoc="" style="width:100%; height:700px; max-height:70vh;"></iframe>`;
      renderedOutputEl.querySelector("iframe").srcdoc = htmlPage;

  python
