settings
  instruction() =>
    this.lastModeUsed = normalizeMode(currentMode);
    let baseInstruction = modes[this.lastModeUsed].instruction.toString();
    return applyRuntimeDirectives(baseInstruction);
  startWith() =>
    if(responseEl.value.trim() === "") {
      return modes[normalizeMode(currentMode)].startWith || "";
    } else {
      return responseEl.value;
    }
  hideStartWith = [ responseEl.value.trim() === "" && modes[normalizeMode(currentMode)].hideStartWith === true ? true : false ]
  outputTo = [responseEl]
  onChunk(data) =>
    if(shouldAutoScroll() && responseEl.scrollTop + responseEl.offsetHeight > responseEl.scrollHeight - 80) {
      responseEl.scrollTop = responseEl.scrollHeight;
    }
    if(modes[this.lastModeUsed] && modes[this.lastModeUsed].onChunk) modes[this.lastModeUsed].onChunk(data);
  onStart(data) =>
    setBusyState(true);
    responseCopyBtn.style.display = "";
    if(modes[this.lastModeUsed] && modes[this.lastModeUsed].onStart) modes[this.lastModeUsed].onStart(data);
  onFinish(data) =>
    setBusyState(false);
    safeLsSet("response", responseEl.value || "");
    if(window.addHistoryItem) window.addHistoryItem({ mode: normalizeMode(currentMode), instruction: instructionEl.value || "", output: responseEl.value || "" });
    if(modes[this.lastModeUsed] && modes[this.lastModeUsed].onFinish) modes[this.lastModeUsed].onFinish(data);
  render = [ modes[normalizeMode(currentMode)].render || null ]

async generate() =>
  window.responseContentBeforeLastGenerate = responseEl.value;
  let pendingObj = ai(settings);
  stopBtn.style.display = "";
  if(bottomStopBtn) bottomStopBtn.style.display = "";
  function stopClickHandler() {
    pendingObj.stop();
    stopBtn.style.display = "none";
    if(bottomStopBtn) bottomStopBtn.style.display = "none";
  };
  stopBtn.onclick = stopClickHandler;
  if(bottomStopBtn) bottomStopBtn.onclick = stopClickHandler;
  loaderEl.innerHTML = pendingObj.loadingIndicatorHtml;
  let data = await pendingObj.onFinishPromise;
  stopBtn.style.display = "none";
  if(bottomStopBtn) bottomStopBtn.style.display = "none";

normalizeMode(modeName) =>
  let fallbackMode = (modes && modes.selectAll && modes.selectAll[0]) ? modes.selectAll[0].getName : "general";
  if(!modeName) return fallbackMode;
  if(modes[modeName]) return modeName;
  if(urlModeToActualMode[modeName]) return urlModeToActualMode[modeName];
  return fallbackMode;

safeLsGet(key, fallback) =>
  try {
    let value = localStorage.getItem(key);
    return value === null || value === undefined ? fallback : value;
  } catch(e) {
    return fallback;
  }

safeLsSet(key, value) =>
  try {
    localStorage.setItem(key, value);
  } catch(e) {
    // no-op if blocked
  }

shouldAutoScroll() =>
  try {
    if(window.autoScrollEl) return !!window.autoScrollEl.checked;
    return safeLsGet("acg.autoScroll", "1") === "1";
  } catch(e) {
    return true;
  }

setBusyState(isBusy) =>
  generateBtn.disabled = !!isBusy;
  continueBtn.disabled = !!isBusy;
  if(bottomContinueBtn) bottomContinueBtn.disabled = !!isBusy;
  retryBtn.disabled = !!isBusy;
  if(isBusy) {
    generateBtn.textContent = "Generating...";
  } else {
    generateBtn.textContent = responseEl.value.trim() ? "Regenerate" : "Generate";
    loaderEl.innerHTML = "";
  }

getSystemPresetText(presetKey) =>
  if(presetKey === "strict") return "Be strict and explicit. Follow constraints exactly and do not infer missing requirements.";
  if(presetKey === "fast") return "Optimize for speed and concise output while preserving correctness.";
  if(presetKey === "mentor") return "Use a teacher-like tone. Explain tradeoffs and best practices briefly.";
  if(presetKey === "production") return "Prioritize production-grade quality, reliability, and maintainability.";
  return "";

applyRuntimeDirectives(baseInstruction) =>
  let directives = [];

  let preset = safeLsGet("acg.preset", "balanced");
  let presetText = getSystemPresetText(preset);
  if(presetText) directives.push(`Preset: ${presetText}`);

  let length = safeLsGet("acg.length", "normal");
  if(length === "short") directives.push("Keep the answer short and focused.");
  if(length === "long") directives.push("Provide deeper detail with complete examples.");

  let format = safeLsGet("acg.format", "auto");
  if(format === "markdown") directives.push("Return markdown-formatted output.");
  if(format === "json") directives.push("Return strict JSON only when possible.");
  if(format === "code") directives.push("Return code-first output with minimal extra text.");

  let creativity = parseFloat(safeLsGet("acg.creativity", "0.55"));
  if(creativity >= 0.75) directives.push("Be creative and propose multiple options.");
  if(creativity <= 0.25) directives.push("Be deterministic and conservative.");

  if(safeLsGet("acg.includeChecklist", "0") === "1") {
    directives.push("Include a short checklist at the end.");
  }

  if(safeLsGet("acg.strictFences", "0") === "1") {
    directives.push("When returning code, always use proper fenced code blocks with language tags.");
  }

  if(safeLsGet("acg.includeComments", "1") === "1") {
    directives.push("Include helpful comments for non-obvious logic only.");
  } else {
    directives.push("Avoid unnecessary code comments.");
  }

  if(window.runtimeFocusEl && window.runtimeFocusEl.value && window.runtimeFocusEl.value.trim()) {
    directives.push(`Focus area: ${window.runtimeFocusEl.value.trim()}`);
  }

  if(directives.length === 0) return baseInstruction;
  return [baseInstruction, "", "Additional runtime directives:", directives.map(d => `- ${d}`).join("\n")].join("\n");

generateModesHtml() =>
  let groups = {};
  for(let m of modes.selectAll) {
    let cat = m.category || "Other";
    if(!groups[cat]) groups[cat] = [];
    groups[cat].push(m);
  }
  let html = "";
  for(let cat of Object.keys(groups).sort()) {
    html += `<optgroup label="${cat}">`;
    for(let m of groups[cat]) {
      let selected = (safeLsGet("currentMode", "") === m.getName) ? "selected" : "";
      html += `<option ${selected} value="${m.getName}">${m.label}</option>`;
    }
    html += `</optgroup>`;
  }
  return html;

urlModeToActualMode
  js = html
  javascript = html
  html = html
  css = html
  python = python
  markdown = markdown
  md = markdown
  character = character
  char = character
  general = general
  brainy = brainy
  perchance = perchanceLists
  perchanceLists = perchanceLists
  perchanceHtml = perchanceHtml
  router = router
  comparison = comparison
  presets = presets
  test = test
  refactor = refactor
  design = design
  tutorial = tutorial
  math = math
  schema = schema
  template = template
  agent = agent
  luau = luau
  gdscript = gdscript
  csharp = csharp_unity
  csharp_unity = csharp_unity
  ts = typescript
  typescript = typescript
  cpp = cpp
  cxx = cpp
  rust = rust
  sql = sql

$meta
  async dynamic(inputs) =>
    let titleTemplate = "AI #LANG# Generator (optimized, free, no sign-up)";
    let descriptionTemplate = "Free AI #LANG# generator with advanced mode presets, runtime controls, templates, history, export, and notebook features. #SUFFIX#";

    let modeParamToLangName = {
      js: "HTML/CSS/JS",
      javascript: "HTML/CSS/JS",
      html: "HTML/CSS/JS",
      css: "HTML/CSS/JS",
      python: "Python",
      markdown: "Markdown",
      md: "Markdown",
      character: "Character",
      char: "Character",
      general: "Code",
      brainy: "Reasoning",
      perchance: "Perchance",
      perchanceLists: "Perchance Lists",
      perchanceHtml: "Perchance HTML",
      router: "Routing",
      comparison: "Comparison",
      presets: "Presets",
      test: "Tests",
      refactor: "Refactor",
      design: "Design",
      tutorial: "Tutorial",
      math: "Math",
      schema: "Schema",
      template: "Templates",
      agent: "Agent",
      luau: "Luau",
      gdscript: "GDScript",
      csharp: "C#",
      csharp_unity: "C# (Unity)",
      ts: "TypeScript",
      typescript: "TypeScript",
      cpp: "C++",
      cxx: "C++",
      rust: "Rust",
      sql: "SQL",
    };

    let modeParamToSuffix = {
      html: "Includes live HTML sandbox rendering.",
      python: "Includes browser-based Python execution for fenced code blocks.",
      markdown: "Generates publication-ready markdown structure.",
      character: "Generates roleplay and character profile formats.",
      perchance: "Supports Perchance lists and HTML workflows.",
      test: "Supports unit and integration test-focused prompting.",
      refactor: "Supports readability and architecture improvement prompts.",
      schema: "Supports JSON schema and type model generation.",
      agent: "Supports agent spec and behavior design prompts.",
    };

    let requestedMode = inputs.urlParams.mode;
    if(requestedMode && modeParamToLangName[requestedMode]) {
      let langName = modeParamToLangName[requestedMode];
      let suffix = modeParamToSuffix[requestedMode] || "";
      return {
        title: titleTemplate.replaceAll("#LANG#", langName),
        description: descriptionTemplate.replaceAll("#LANG#", langName).replaceAll("#SUFFIX#", suffix),
      };
    }

    return {
      title: titleTemplate.replaceAll("#LANG#", "Code"),
      description: descriptionTemplate.replaceAll("#LANG#", "code").replaceAll("#SUFFIX#", "Supports many code, writing, and Perchance-specific modes."),
    };
