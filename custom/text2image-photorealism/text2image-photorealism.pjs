generateHTML = {import:text2image-framework-v4}

$meta
  title = Text2Image Photorealism Suite
  description = Photoreal generation tuned for natural light, lens realism, and production-grade details.

settings
  pageTitle = Text2Image Photorealism Suite
  subtitle = Photoreal models, realistic style packs, and precision prompt controls.
  theme = slate
  showComments = false

  enableShareLinks = true
  enableModifierGroups = true
  enablePersonaHooks = false

  defaultPrompt = realistic portrait in natural window light, precise skin texture, DSLR clarity
  defaultNegativePrompt = painterly look, cartoon outlines, low-res artifacts, text watermark
  defaultImageCount = 4

  enableRandomInputButton = true
  enableAiSuggestButton = true
  enableRandomAppendButton = true
  aiSuggestMode = append
  aiSuggestMaxCharacters = 220
  aiSuggestInstruction = Extend this photoreal prompt with camera, lens, and lighting details only.

  artStyle
    label = Realism Style
    type = select
    remember = true
    options
      Suite Realistic
        color = #f1bb77
        meta:import
          from = {import:text2image-styles-pack-realistic}

      Realism Legacy
        color = #ff9d6c
        meta:import
          from = {import:perstyles-realistic}

      Scene Expansions
        color = #87d0b4
        meta:import
          from = {import:t2i-scenery}

  imageButtons
    privateSave = true

  imageOptions
    style = border-radius:12px; box-shadow:0 10px 28px rgba(0,0,0,0.18);

  randomPromptPool
    photojournalistic street portrait at blue hour, realistic skin, subtle grain
    architectural interior shot, clean materials, physically accurate reflections
    macro flower capture with dew droplets, natural bokeh, lens realism
    documentary wildlife scene, natural motion blur, high-detail fur

  randomAppendPool
    realistic depth of field
    physically accurate reflections
    subtle film grain
    crisp edge detail
    natural color response