getChangelog() =>
  return [
    { version: "v2.9.0 — The Gallery Update", items: [
      "Added Community Gallery — share your best creations and browse art from other players",
      "Public per-generator gallery embedded directly in a new Gallery tab",
      "Sort by Top, Recent, or Trending — filter by time range from 1 day to all-time",
      "Share any generated character, location, or scene directly to the community gallery",
      "Share button regenerates your image with gallery save enabled — click the heart to publish",
      "Gallery entries include the character name and type as save metadata for easy browsing",
      "Content filter keeps the gallery appropriate: PG-13 and G modes available",
      "Adaptive height gallery that expands to fit all community submissions",
      "Custom gallery button on each tile for quick actions"
    ]},
    { version: "v2.8.0 — The Reverie Update", items: [
      "Added Dream Sequence Generator — surreal interlude chapters between main story beats",
      "Each dream generates a setting, mood, entity, action, symbol, reveal, color palette, sound, and phase",
      "6 dream phases: Descent, Wandering, Encounter, Turning, Revelation, and Dissolution",
      "16 surreal dream settings: breathing corridors, memory kitchens, mirror mazes, clock towers, and more",
      "16 dream entities: mirror-selves, door-children, paper-bird flocks, and things that wear your face",
      "16 dream actions: impossible movements, disturbing transformations, and encounters with your own reflection",
      "16 dream symbols: yellow raincoats, single shoes, keyless doors, and music boxes waiting to play",
      "15 dream reveals that recontextualize the entire sequence — was it a memory? A warning? A door?",
      "12 dream interpretations that give narrative meaning to each sequence",
      "10 color palettes and 12 soundscapes that paint each dream uniquely",
      "Dream sequences generate surreal artwork inspired by Beksinski, Dali, and Dave McKean",
      "Dream sequences can be saved to the Archive and are auto-collected into the Lore Compendium",
      "Added Achievement System — unlock badges for generating content and discovering secrets",
      "28 achievements across four rarity tiers: Common, Uncommon, Rare, and Epic",
      "Achievements track generation milestones: first character, all tabs explored, 50 and 100 items generated",
      "Type-specific achievements: generate 10 Monsters, 5 Protectors, fill the Suitcase with 20 characters",
      "Hidden achievements for discovering secrets — some require specific rare combinations",
      "Special achievements for easter egg hunters and title-clickers",
      "Achievement notifications appear as toasts when unlocked, with rarity-colored borders",
      "Achievement progress persists across sessions via IndexedDB storage"
    ]},
    { version: "v2.7.0 — The Forgemaster Update", items: [
      "Added Custom Character Creator — manually craft your own original character",
      "Full control over every field: type, name, gender, age, clothing, hair, skill, personality, fear, quirk, companion, and backstory",
      "Any field left blank is automatically randomized — fill in what you want, let the dark provide the rest",
