// ═══════════════════════════════════════════════════════════════
//  COMMUNITY GALLERY — shared creations from all players
// ═══════════════════════════════════════════════════════════════

galleryOptions
  gallery = true
  sort = top
  contentFilter = g
  timeRange = all-time
  adaptiveHeight = true
  hideIfScoreIsBelow = -3

// Build share metadata for a generated item
getShareMetadata(kind, data) =>
  let title = "";
  let desc = "";
  if (kind === "character" || kind === "event_character") {
    title = data.name + " — " + data.type;
    desc = data.typeDesc;
  } else if (kind === "location" || kind === "event_location") {
    title = data.name + " — " + data.type;
    desc = data.desc;
  } else if (kind === "game") {
    title = data.title;
    desc = data.premise;
  } else if (kind === "encounter" || kind === "event_encounter") {
    title = data.type + " — " + data.threat;
    desc = data.typeDesc;
  } else if (kind === "coop") {
    title = data.character1.name + " & " + data.character2.name;
    desc = data.dynamic + " " + data.bond;
  } else if (kind === "pet") {
    title = data.name + " the " + data.species;
    desc = data.speciesDesc;
  } else if (kind === "map") {
    title = "Map: " + data.location.name;
    desc = data.location.desc;
  } else if (kind === "cast") {
    title = "Cast of " + data.castSize;
    desc = data.sceneSetting + " — " + data.sceneMood;
  } else if (kind === "canon_rel") {
    title = data.character.name + " & " + data.canonName;
    desc = data.relationshipType + ". " + data.detail;
  } else if (kind === "dream") {
    title = "Dream: " + data.phase;
    desc = data.mood + " — " + data.setting;
  } else {
    title = "Little Nightmares Creation";
    desc = "";
  }
  return { title: title, description: desc };

// ═══════════════════════════════════════════════════════════════
//  LORE COMPENDIUM — auto-collected worldbuilding fragments
// ═══════════════════════════════════════════════════════════════

// Extract worldbuilding lore entries from any generated content.
// Each entry: { category, title, body, source }
// Categories: figure, place, tale, event, bond, creature, story, connection, detail
extractLoreEntries(kind, data) =>
  let entries = [];
  if (kind === "character" || kind === "event_character") {
    entries.push({ category: "figure", title: data.name, body: "A " + data.type + " of the Little Nightmares world. " + data.typeDesc, source: kind });
    entries.push({ category: "tale", title: data.name + " — Origin", body: data.history, source: kind });
    entries.push({ category: "detail", title: data.name + " — Fear", body: data.fear, source: kind });
    entries.push({ category: "detail", title: data.name + " — Quirk", body: data.quirk, source: kind });
    if (data.skill) entries.push({ category: "detail", title: data.name + " — Skill", body: data.skill, source: kind });
  } else if (kind === "location" || kind === "event_location") {
    entries.push({ category: "place", title: data.name, body: "A " + data.type + ". " + data.desc, source: kind });
    entries.push({ category: "detail", title: data.name + " — Danger", body: data.danger, source: kind });
    entries.push({ category: "detail", title: data.name + " — Secret", body: data.secret, source: kind });
  } else if (kind === "game") {
    entries.push({ category: "story", title: data.title, body: data.premise, source: kind });
    entries.push({ category: "place", title: data.setting.name, body: "A " + data.setting.type + ". " + data.setting.desc, source: kind });
    entries.push({ category: "figure", title: data.protagonist.name, body: "The protagonist — a " + data.protagonist.type + ". " + data.protagonist.typeDesc, source: kind });
    entries.push({ category: "tale", title: data.protagonist.name + " — Origin", body: data.protagonist.history, source: kind });
    for (let i = 0; i < data.chapters.length; i++) {
      let ch = data.chapters[i];
      entries.push({ category: "tale", title: "Chapter " + ch.number + ": " + ch.title, body: ch.desc, source: kind });
    }
    entries.push({ category: "tale", title: data.title + " — Ending", body: data.endingType + ". " + data.endingTone, source: kind });
  } else if (kind === "encounter" || kind === "event_encounter") {
    entries.push({ category: "event", title: data.type + " in " + data.location, body: data.typeDesc + " Atmosphere: " + data.atmosphere, source: kind });
    entries.push({ category: "detail", title: data.type + " — Antagonist", body: data.antagonist, source: kind });
    entries.push({ category: "detail", title: data.type + " — Twist", body: data.twist, source: kind });
    entries.push({ category: "detail", title: data.type + " — Reward", body: data.reward, source: kind });
  } else if (kind === "coop") {
    let c1 = data.character1, c2 = data.character2;
    entries.push({ category: "bond", title: c1.name + " & " + c2.name, body: data.dynamic + " " + data.bond, source: kind });
    entries.push({ category: "figure", title: c1.name, body: "A " + c1.type + ". " + c1.typeDesc, source: kind });
    entries.push({ category: "figure", title: c2.name, body: "A " + c2.type + ". " + c2.typeDesc, source: kind });
    entries.push({ category: "tale", title: c1.name + " & " + c2.name + " — Shared History", body: data.sharedHistory, source: kind });
    entries.push({ category: "detail", title: c1.name + " & " + c2.name + " — Shared Fear", body: data.sharedFear, source: kind });
    entries.push({ category: "tale", title: c1.name + " & " + c2.name + " — Ending", body: data.ending, source: kind });
  } else if (kind === "pet") {
    entries.push({ category: "creature", title: data.name + " the " + data.species, body: data.speciesDesc + " Ability: " + data.ability, source: kind });
    entries.push({ category: "detail", title: data.name + " — Quirk", body: data.quirk, source: kind });
    entries.push({ category: "tale", title: data.name + " — How They Met", body: data.howTheyMet, source: kind });
  } else if (kind === "map") {
    entries.push({ category: "place", title: data.location.name + " — Map", body: "A mapped " + data.location.type + " drawn in " + data.style + " style. " + data.location.desc, source: kind });
    entries.push({ category: "detail", title: data.location.name + " — Secret Room", body: data.location.secret, source: kind });
  } else if (kind === "cast") {
    entries.push({ category: "event", title: "Cast Scene: " + data.sceneSetting, body: data.sceneMood + " Location: " + data.location.name, source: kind });
    entries.push({ category: "tale", title: "Cast — Group Dynamic", body: data.groupDynamic, source: kind });
    for (let i = 0; i < data.members.length; i++) {
      let m = data.members[i];
      entries.push({ category: "figure", title: m.name, body: m.role + " — a " + m.type + ". " + (m.roleDesc || ""), source: kind });
    }
    for (let i = 0; i < data.relationships.length; i++) {
      let r = data.relationships[i];
      entries.push({ category: "bond", title: r.char1 + " & " + r.char2, body: r.dynamic, source: kind });
    }
  } else if (kind === "canon_rel") {
    entries.push({ category: "connection", title: data.character.name + " & " + data.canonName, body: data.relationshipType + ". " + data.detail, source: kind });
    entries.push({ category: "figure", title: data.character.name, body: "Your OC — a " + data.character.type + ". " + data.character.typeDesc, source: kind });
    entries.push({ category: "figure", title: data.canonName, body: data.canonDesc, source: kind });
    entries.push({ category: "tale", title: data.character.name + " & " + data.canonName + " — Twist", body: data.twist, source: kind });
    entries.push({ category: "tale", title: data.character.name + " & " + data.canonName + " — Outcome", body: data.outcome, source: kind });
  }
  return entries;

// Save lore entries to the lore KV folder (auto-collected, non-blocking)
async addToLore(kind, data) =>
  try {
    let entries = root.extractLoreEntries(kind, data);
    let ts = Date.now();
    for (let i = 0; i < entries.length; i++) {
      let e = entries[i];
      let key = "lore_" + ts + "_" + i + "_" + Math.random().toString(36).substr(2, 4);
      await root.kv.lore.set(key, {
        category: e.category,
        title: e.title,
        body: e.body,
        source: e.source,
        collectedAt: ts
      });
    }
  } catch(err) {
    console.error("Lore auto-collect failed:", err);
  }

// ═══════════════════════════════════════════════════════════════
//  EASTER EGGS — hidden content
// ═══════════════════════════════════════════════════════════════
easterEggName
  Six
  Mono
  The Lady
  The Janitor
  The Thin Man
  RK
  The Hunter
easterEggMsg
  "You found a friend in the dark. Six nods at you, just once, and disappears into the vent."
  "A boy with a paper bag over his head watches you from the television screen. He waves."
  "The Lady combs her hair in the mirror. She sees you. She smiles. Run."
  "Long fingers curl around the door frame. The Janitor is listening. He always is."
  "The signal hums. The Thin Man is tuning in. Change the channel. CHANGE THE CHANNEL."
  "A child in a yellow raincoat runs past you, too fast to follow. You hear a door slam."
  "A gunshot, distant. The Hunter is tracking something. Pray it is not you."

// ═══════════════════════════════════════════════════════════════
//  ART STYLES — for custom character image generation
// ═══════════════════════════════════════════════════════════════

artStyleName
  Tarsier Official
  Dark Watercolor
  Ink & Crosshatch
  Oil Painting
  Storybook Illustration
  Gothic Stained Glass
  Charcoal Sketch
  Retro Pixel Art
  Comic Book Ink
  Surrealist Dream

artStyleDesc
  Tarsier Official = Official Little Nightmares artwork style, 2D dark fantasy concept art, painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style
  Dark Watercolor = Dark moody watercolor painting, wet-on-wet technique, bleeding edges, muted earthy pigments with amber and rust undertones, atmospheric washes, dripping textures, haunting and ethereal, loose expressive brushwork
  Ink & Crosshatch = Detailed pen and ink illustration with heavy crosshatching, stark black and white with selective amber accents, gothic engraving style, fine linework, high contrast, etching aesthetic, macabre and intricate
  Oil Painting = Classical oil painting in the style of chiaroscuro masters, deep blacks and warm amber glazes, visible brushstrokes, rich textured impasto, dramatic Rembrandt lighting, baroque darkness, old master atmosphere
  Storybook = Children's storybook illustration with a dark twist, soft gouache textures, muted warm palette, hand-painted folk art style, whimsical but melancholic, Tim Burton meets Arthur Rackham, delicate linework
  Stained Glass = Stained glass window art style, Gothic cathedral aesthetic, fractured panes of muted amber rust and deep teal, leading lines of black, luminous translucent colors, religious iconography composition, medieval and sacred
  Charcoal Sketch = Rough charcoal sketch on aged parchment, smudged shadows, expressive gestural lines, sepia and ash tones, unfinished edges, gritty texture, raw and immediate, study-like quality
  Pixel Art = 16-bit pixel art horror, limited muted palette of amber rust and deep teal, dithering shading, retro game aesthetic, atmospheric pixel lighting, dark fantasy CRPG style, detailed sprite art
  Comic Book Ink = Dark comic book illustration, heavy black ink shadows, cel-shaded rendering, high contrast lighting, graphic novel aesthetic, Mike Mignola Hellboy style, bold silhouettes, amber spot colors
  Surrealist Dream = Surrealist dream painting, melting forms and impossible geometry, soft focus edges, muted palette with glowing amber anomalies, Salvador Dali meets Zdzislaw Beksinski, oneiric and disorienting, phantasmagoric

artStyleShort
  Tarsier Official
  Dark Watercolor
  Ink & Crosshatch
  Oil Painting
  Storybook
  Stained Glass
  Charcoal Sketch
  Pixel Art
  Comic Book Ink
  Surrealist Dream

// Get the full art style descriptor by name
getArtStyleDesc(styleName) =>
  let node = artStyleDesc[styleName];
  if (node == null) return artStyleDesc["Tarsier Official"].evaluateItem;
  if (node.evaluateItem !== undefined) return node.evaluateItem;
  return node;

// Get array of all art style names for UI
getArtStyles() =>
  let styles = [];
  for (let item of artStyleShort.selectAll) {
    styles.push(item.evaluateItem);
  }
  return styles;

// Get a dropdown-friendly list of items from a perchance list as array of strings
getListAsArray(listName) =>
  let arr = [];
  for (let item of listName.selectAll) {
    arr.push(item.evaluateItem);
  }
  return arr;

// Get clothing options grouped by character type
getClothingOptions(type) =>
  if (type === "Monster") return getListAsArray(clothingMonster);
  if (type === "Resident" || type === "Guest") return getListAsArray(clothingResident);
  return getListAsArray(clothingKid);

// Get hairstyle options grouped by character type
getHairstyleOptions(type) =>
  if (type === "Monster") return getListAsArray(hairstyleMonster);
  if (type === "Resident" || type === "Guest") return getListAsArray(hairstyleResident);
  return getListAsArray(hairstyleKid);

// Get age options grouped by character type
getAgeOptions(type) =>
  if (type === "Kid" || type === "Wanderer" || type === "Runaway" || type === "Stowaway" || type === "Protector")
    return getListAsArray(ageKid);
  return getListAsArray(ageResident);

// Get all character type names as array
getCharacterTypes() =>
  return getListAsArray(characterType);

// Get character type description
getCharacterTypeDesc(type) =>
  let node = characterTypeDesc[type];
  if (node == null) return characterTypeDesc["Kid"].evaluateItem;
  if (node.evaluateItem !== undefined) return node.evaluateItem;
  return node;

// Assemble a custom character from user-provided fields
// All fields are optional — missing ones get randomized
buildCustomCharacter(opts) =>
  let type = opts.type || characterType.selectOne.evaluateItem;
  let typeDesc = characterTypeDesc[type].evaluateItem;
  let name = opts.name && opts.name.trim() ? opts.name.trim() : getNameForType(type);
  let genderVal = opts.gender || gender.selectOne.evaluateItem;
  let ageVal = opts.age || getAgeForType(type);
  let skillVal = opts.skill && opts.skill.trim() ? opts.skill.trim() : skill.selectOne.evaluateItem;
  let clothingVal = opts.clothing || getClothingForType(type);
  let hairVal = opts.hair || getHairstyleForType(type);
  let partnerVal = opts.partner && opts.partner.trim() ? opts.partner.trim() : partner.selectOne.evaluateItem;
  let traitVal = opts.trait && opts.trait.trim() ? opts.trait.trim() : trait.selectOne.evaluateItem;
  let fearVal = opts.fear && opts.fear.trim() ? opts.fear.trim() : fear.selectOne.evaluateItem;
  let quirkVal = opts.quirk && opts.quirk.trim() ? opts.quirk.trim() : quirk.selectOne.evaluateItem;
  let origin = opts.origin && opts.origin.trim() ? opts.origin.trim() : backstoryOrigin.selectOne.evaluateItem;
  let event = opts.event && opts.event.trim() ? opts.event.trim() : backstoryEvent.selectOne.evaluateItem;
  let secret = opts.secret && opts.secret.trim() ? opts.secret.trim() : backstorySecret.selectOne.evaluateItem;
  let history = origin + " " + event + " " + secret;
  return {
    type: type,
    typeDesc: typeDesc,
    name: name,
    gender: genderVal,
    age: ageVal,
    skill: skillVal,
    clothing: clothingVal,
    hair: hairVal,
    partner: partnerVal,
    trait: traitVal,
    fear: fearVal,
    quirk: quirkVal,
    history: history,
    origin: origin,
    event: event,
    secret: secret,
    custom: true,
    artStyle: opts.artStyle || null
  };

// Build an enhanced image prompt for a custom character with art style
buildCustomCharacterImagePrompt(char) =>
  let styleName = char.artStyle || "Tarsier Official";
  let styleDesc = getArtStyleDesc(styleName);
  let base = styleDesc + ". ";
  base += "Character: a " + char.type.toLowerCase() + " in the Little Nightmares universe. ";
  if (char.type === "Monster") {
    base += "A large, looming, grotesque creature with distorted proportions, vaguely human but fundamentally wrong. ";
    base += "Gender presentation: " + char.gender + ". Age: " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    base += "Massive imposing figure dwarfing the environment, filling doorways, casting vast shadows. ";
    base += "Oversized ominous architecture barely containing the creature, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  } else if (char.type === "Resident" || char.type === "Guest") {
    base += "A tall, unsettling adult figure with elongated proportions. ";
    base += "Gender: " + char.gender + ", " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    base += "Tall imposing figure in an oversized ominous environment, looming architecture, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  } else {
    base += "Appearance: " + char.gender + ", " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    if (char.skill) base += "They possess a special quality: " + char.skill + ". ";
    base += "Small fragile figure in a vast oversized ominous environment, looming architecture, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  }
  base += "Dark background with a single warm light source. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "No text, no watermark, no signature.";
  return base;

// ═══════════════════════════════════════════════════════════════
//  GENERATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Pick a name list based on character type
getNameForType(type) =>
  let nameList;
  if (type === "Kid") nameList = nameKid;
  else if (type === "Resident") nameList = nameResident;
  else if (type === "Guest") nameList = nameGuest;
  else if (type === "Monster") nameList = nameMonster;
  else if (type === "Wanderer") nameList = nameWanderer;
  else if (type === "Protector") nameList = nameProtector;
  else if (type === "Runaway") nameList = nameRunaway;
  else if (type === "Stowaway") nameList = nameStowaway;
  else nameList = nameKid;
  return nameList.selectOne.evaluateItem;

// Get appropriate age descriptor
getAgeForType(type) =>
  if (type === "Kid" || type === "Wanderer" || type === "Runaway" || type === "Stowaway" || type === "Protector")
    return ageKid.selectOne.evaluateItem;
  return ageResident.selectOne.evaluateItem;

// Get appropriate clothing
getClothingForType(type) =>
  if (type === "Kid" || type === "Wanderer" || type === "Runaway" || type === "Stowaway" || type === "Protector")
    return clothingKid.selectOne.evaluateItem;
  if (type === "Monster")
    return clothingMonster.selectOne.evaluateItem;
  return clothingResident.selectOne.evaluateItem;

// Get appropriate hairstyle
getHairstyleForType(type) =>
  if (type === "Monster")
    return hairstyleMonster.selectOne.evaluateItem;
  if (type === "Resident" || type === "Guest")
    return hairstyleResident.selectOne.evaluateItem;
  return hairstyleKid.selectOne.evaluateItem;

// Assemble a full character
generateCharacter() =>
  let type = characterType.selectOne.evaluateItem;
  let typeDesc = characterTypeDesc[type].evaluateItem;
  let name = getNameForType(type);
  let genderVal = gender.selectOne.evaluateItem;
  let ageVal = getAgeForType(type);
  let skillVal = skill.selectOne.evaluateItem;
  let clothingVal = getClothingForType(type);
  let hairVal = getHairstyleForType(type);
  let partnerVal = partner.selectOne.evaluateItem;
  let traitVal = trait.selectOne.evaluateItem;
  let fearVal = fear.selectOne.evaluateItem;
  let quirkVal = quirk.selectOne.evaluateItem;
  let origin = backstoryOrigin.selectOne.evaluateItem;
  let event = backstoryEvent.selectOne.evaluateItem;
  let secret = backstorySecret.selectOne.evaluateItem;
  let history = origin + " " + event + " " + secret;
  return {
    type: type,
    typeDesc: typeDesc,
    name: name,
    gender: genderVal,
    age: ageVal,
    skill: skillVal,
    clothing: clothingVal,
    hair: hairVal,
    partner: partnerVal,
    trait: traitVal,
    fear: fearVal,
    quirk: quirkVal,
    history: history,
    origin: origin,
    event: event,
    secret: secret
  };

// Assemble a full location
generateLocation() =>
  let lType = locationType.selectOne.evaluateItem;
  let lName = locationName.selectOne.evaluateItem;
  let lDesc = locationDesc.selectOne.evaluateItem;
  let lDanger = locationDanger.selectOne.evaluateItem;
  let lSecret = locationSecret.selectOne.evaluateItem;
  return {
    type: lType,
    name: lName,
    desc: lDesc,
    danger: lDanger,
    secret: lSecret
  };

// Generate a random number of chapters (3-5)
generateChapters() =>
  let count = 3 + Math.floor(Math.random() * 3);
  let chapters = [];
  let usedTitles = {};
  let usedDescs = {};
  for (let i = 0; i < count; i++) {
    let title, desc;
    let attempts = 0;
    do {
      title = chapterTitle.selectOne.evaluateItem;
      attempts++;
    } while (usedTitles[title] && attempts < 20);
    usedTitles[title] = true;
    attempts = 0;
    do {
      desc = chapterDesc.selectOne.evaluateItem;
      attempts++;
    } while (usedDescs[desc] && attempts < 20);
    usedDescs[desc] = true;
    let num = i + 1;
    chapters.push({ number: num, title: title, desc: desc });
  }
  return chapters;

// Assemble a full game concept
generateGameConcept() =>
  let title = gameTitle.selectOne.evaluateItem;
  let premise = gamePremise.selectOne.evaluateItem;
  let chapters = generateChapters();
  let endType = endingType.selectOne.evaluateItem;
  let endTone = endingTone.selectOne.evaluateItem;
  let protagonist = generateCharacter();
  let setting = generateLocation();
  return {
    title: title,
    premise: premise,
    chapters: chapters,
    endingType: endType,
    endingTone: endTone,
    protagonist: protagonist,
    setting: setting
  };

// Build image prompt for a character
buildCharacterImagePrompt(char) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy concept art, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style. ";
  base += "Character: a " + char.type.toLowerCase() + " in the Little Nightmares universe. ";
  if (char.type === "Monster") {
    base += "A large, looming, grotesque creature with distorted proportions, vaguely human but fundamentally wrong. ";
    base += "Gender presentation: " + char.gender + ". Age: " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    base += "Massive imposing figure dwarfing the environment, filling doorways, casting vast shadows. ";
    base += "Oversized ominous architecture barely containing the creature, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  } else if (char.type === "Resident" || char.type === "Guest") {
    base += "A tall, unsettling adult figure with elongated proportions in the Little Nightmares universe. ";
    base += "Gender: " + char.gender + ", " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    base += "Tall imposing figure in an oversized ominous environment, looming architecture, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  } else {
    base += "Appearance: " + char.gender + ", " + char.age + ". ";
    base += "Wearing " + char.clothing + ". ";
    base += "Hair: " + char.hair + ". ";
    if (char.trait) base += "Demeanor: " + char.trait + ". ";
    if (char.skill) base += "They possess a special quality: " + char.skill + ". ";
    base += "Small fragile figure in a vast oversized ominous environment, looming architecture, long shadows, ";
    base += "volumetric dust, subtle fog. ";
  }
  base += "Dark background with a single warm light source. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, no text, no watermark.";
  return base;

// Build image prompt for a location
buildLocationImagePrompt(loc) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy environment concept art, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic lighting, eerie unsettling mood, Tarsier Studios art style. ";
  base += "Environment: " + loc.type + ". ";
  base += "Named: " + loc.name + ". ";
  base += "Scene description: " + loc.desc + " ";
  base += "Vast ominous architecture dwarfing any human scale, long shadows, volumetric fog, ";
  base += "dust particles in light beams, peeling wallpaper, rusted metal, decayed grandeur. ";
  base += "Dark atmospheric background with a single warm light source casting long shadows. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, no text, no watermark, no characters.";
  return base;

// Build image prompt for a game concept
buildGameImagePrompt(game) =>
  let base = "Official Little Nightmares key art style, 2D dark fantasy promotional illustration, ";
  base += "painterly digital art, atmospheric, muted desaturated palette with golden amber accents, ";
  base += "dramatic cinematic lighting, eerie and haunting mood, Tarsier Studios art style. ";
  base += "Title scene for a horror game called '" + game.title + "'. ";
  base += "Setting: " + game.setting.type + " — " + game.setting.name + ". ";
  base += "Protagonist: ";
  let p = game.protagonist;
  if (p.type === "Monster") {
    base += "a large grotesque creature, " + p.gender + ", wearing " + p.clothing + ". ";
    base += "The massive creature looms in the foreground of a vast ominous structure. ";
  } else if (p.type === "Resident" || p.type === "Guest") {
    base += "a tall unsettling adult figure, " + p.gender + ", wearing " + p.clothing + ". ";
    base += "The tall imposing figure stands before a vast ominous structure. ";
  } else {
    base += "a small " + p.type.toLowerCase() + ", " + p.gender + ", ";
    base += "wearing " + p.clothing + ". ";
    base += "The small protagonist stands before a vast ominous structure, looking up. ";
  }
  base += "Looming architecture, long shadows, volumetric fog, dust particles. ";
  base += "A single warm light source illuminates the protagonist against the dark. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, cinematic composition, no text, no watermark.";
  return base;

// Build image prompt for a single chapter illustration
buildChapterImagePrompt(game, chapter) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy chapter illustration, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style. ";
  base += "Chapter " + chapter.number + ": " + chapter.title + ". ";
  base += "Scene: " + chapter.desc + " ";
  base += "Setting: " + game.setting.type + " — " + game.setting.name + ". ";
  let p = game.protagonist;
  base += "Protagonist: a ";
  if (p.type === "Monster") {
    base += "large grotesque creature, " + p.gender + ", wearing " + p.clothing + ". ";
  } else if (p.type === "Resident" || p.type === "Guest") {
    base += "tall unsettling adult, " + p.gender + ", wearing " + p.clothing + ". ";
  } else {
    base += "small " + p.type.toLowerCase() + ", " + p.gender + ", wearing " + p.clothing + ". ";
  }
  base += "A pivotal moment in the chapter, capturing the mood and tension. ";
  base += "Vast ominous architecture, long shadows, volumetric dust, subtle fog. ";
  base += "Dark background with a single warm light source. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, cinematic storybook illustration, no text, no watermark.";
  return base;
buildCharacterText(char) =>
  let text = "";
  text += "═══ " + char.name.toUpperCase() + " ═══\n";
  text += "Type: " + char.type + "\n";
  text += char.typeDesc + "\n\n";
  text += "Gender: " + char.gender + "\n";
  text += "Age: " + char.age + "\n";
  text += "Clothing: " + char.clothing + "\n";
  text += "Hair: " + char.hair + "\n\n";
  text += "▸ SPECIAL ABILITY\n" + char.skill + "\n\n";
  text += "▸ PERSONALITY\n" + char.trait + "\n\n";
  text += "▸ FEAR\n" + char.fear + "\n\n";
  text += "▸ QUIRK\n" + char.quirk + "\n\n";
  text += "▸ COMPANION\n" + char.partner + "\n\n";
  text += "▸ HISTORY\n" + char.history + "\n";
  return text;

// Build location text display
buildLocationText(loc) =>
  let text = "";
  text += "═══ " + loc.name.toUpperCase() + " ═══\n";
  text += "Type: " + loc.type + "\n\n";
  text += "▸ DESCRIPTION\n" + loc.desc + "\n\n";
  text += "▸ THE DANGER\n" + loc.danger + "\n\n";
  text += "▸ THE SECRET\n" + loc.secret + "\n";
  return text;

// Build game concept text display
buildGameText(game) =>
  let text = "";
  text += "═══ " + game.title.toUpperCase() + " ═══\n\n";
  text += "▸ PREMISE\n" + game.premise + "\n\n";
  text += "▸ PROTAGONIST\n";
  text += game.protagonist.name + " — a " + game.protagonist.type + "\n";
  text += game.protagonist.clothing + "\n\n";
  text += "▸ SETTING\n";
  text += game.setting.name + " (" + game.setting.type + ")\n\n";
  text += "▸ CHAPTERS\n";
  for (let ch of game.chapters) {
    text += "  Chapter " + ch.number + ": " + ch.title + "\n";
    text += "    " + ch.desc + "\n\n";
  }
  text += "▸ ENDING — " + game.endingType + "\n";
  text += game.endingTone + "\n";
  return text;

// Random easter egg trigger
// ═══════════════════════════════════════════════════════════════
//  RANDOM ENCOUNTER GENERATOR — tabletop-style
// ═══════════════════════════════════════════════════════════════
encounterType
  Stealth & Evasion^3
  Chase Sequence^3
  Puzzle / Environmental
  Social / Negotiation
  Horror Reveal
  Resource Scavenge
  Trap / Hazard
  Boss Encounter
  Moral Dilemma
  Exploration & Discovery
  Rescue Mission
  Escape Sequence

encounterTypeDesc
  Stealth & Evasion = The player(s) must cross a space patrolled by something that cannot be fought, only avoided. Sound, light, and timing are everything. One wrong move means death — or worse, notice.
  Chase Sequence = Something has seen you and it is coming. The environment becomes a blur of obstacles, gaps, and desperate choices. Parkour meets terror. Do not stop. Do not look back. Do not trip.
  Puzzle / Environmental = A locked door, a broken machine, a path blocked by something that requires thought rather than speed. The solution is physical and present in the room. So is the time pressure.
  Social / Negotiation = A Resident or Guest who can be spoken to — bribed, deceived, distracted, or reasoned with. They are not friendly, but they are not immediately hostile. Words are weapons here. So is silence.
  Horror Reveal = The encounter is not a threat — yet. It is the discovery of something terrible: a room, a body, a truth. The horror is in the understanding. The threat comes after, when the understanding sinks in.
  Resource Scavenge = Food, tools, keys, or information must be gathered from a dangerous area. The resources are finite and guarded. Every trip in risks more than the last. Grey morality: take what you need, or leave it for someone who needs it more?
  Trap / Hazard = The environment itself is the enemy — collapsing floors, swinging blades, toxic gas, rising water. No creature to outsmart, only physics to survive. The trap was built for something bigger than you. It will still kill you.
  Boss Encounter = A named, unique threat — a Resident, Monster, or Guest of significant power. Cannot be defeated by force. Must be survived, outwitted, or turned against itself. This is the climax of a chapter.
  Moral Dilemma = A choice with no clean answer. Save yourself or save another. Take the food or leave it for the smaller child. Hide or run. Every option has a cost. The cost is measured in who you become.
  Exploration & Discovery = A safe(r) space meant for breathing, lore-gathering, and finding secrets. The threat is low but present. The reward is understanding — of the place, its history, and what waits deeper in.
  Rescue Mission = Someone smaller, weaker, or trapped needs help. The rescue is dangerous. The rescued may not survive the escape. The rescued may not be grateful. The rescued may not be what they seem.
  Escape Sequence = The place is falling apart, flooding, burning, or waking up. The player(s) must get out NOW. The path that was safe moments ago is now lethal. Everything learned so far must be applied at speed. There is no time to think.

encounterThreat
  Whisper — barely a rustle, the threat is atmosphere alone
  Shadow — something lurks, unseen but felt; caution advised
  Pulse — active danger; a Resident patrols, a trap is primed
  Snarl — direct and immediate threat; survival is not guaranteed
  Scream — lethal encounter; expect casualties or narrow escape
  Silence — the worst kind; the threat has not revealed itself yet, and that means it is choosing its moment

encounterScale
  Solo — one small protagonist against the dark
  Duo — two children, bound by need, tested by trust
  Trio — three souls, enough to split up but not enough to feel safe
  Group — four to six; too many to hide, enough to sacrifice
  Swarm — the protagonists are many; the threat is vaster

encounterLocation
  a narrow ventilation shaft where the walls are close and warm
  a vast dining hall set for a feast that ended decades ago
  a flooded basement where the water is black and things float in it
  a long corridor lined with doors, most of which do not open
  a boiler room where the pipes scream and the floor vibrates
  a child's nursery where the toys have been rearranged by something with too many fingers
  a freezer locker hung with shapes that are not meat
  a library where every book is a child's name and a date
  a rooftop in the rain, the edge too close, the drop very far
  a ballroom where a music box plays and the chandeliers sway with no wind
  a sewer tunnel where the flow moves against gravity
  an elevator shaft with no car, just a long drop and a longer climb
  a classroom where the lesson on the board is written in something brown
  a greenhouse where the plants have learned to move toward warmth
  a chapel where the pews are nailed shut and the altar is stained
  a clocktower mechanism room where the gears are made of bone
  a mirror maze where the reflections are a half-second behind
  a laundry room where the washing machines are full of small clothes, still wet
  an operating theater where the audience is still seated, still watching
  a cargo hold where the crates are labeled with children's names

encounterAntagonist
  a single Resident, slow and methodical, sweeping the area with a lantern
  a pair of Guests arguing over something on the floor — they have not seen you yet
  the Janitor-equivalent: blind, but hears every footstep, every breath
  a creature that lives in the walls and reaches through the cracks
  a child, feral and cornered, who sees you as a threat
  a machine that has been given a purpose and will not stop until it is fulfilled
  the environment itself — the room is contracting, the floor is tilting, the ceiling is descending
  a Guest who has gone mad and believes you are the meal that was promised
  a Resident who is weeping and will not harm you — unless you touch what they are guarding
  a swarm of small things — rats, beetles, fingers — that move as one mind
  a mirror-thing that wears your shape and knows your name
  nothing — the threat is the absence of anything, and what that absence means

encounterObjective
  reach the door on the far side of the room without being heard
  retrieve the key hanging from the Resident's belt
  find the three hidden switches that unlock the passage
  distract the antagonist long enough for a companion to slip past
  survive for six turns until the patrol moves on
  rescue the trapped child and carry them to safety
  decipher the clue scratched into the wall before the water rises
  steal the food from the table without waking the sleeping Guest
  cross the broken floor — only some tiles will hold your weight
  ring the bell to summon help, knowing it will also summon the threat
  hide the evidence of your passage before the inspector arrives
  negotiate passage with the Gatekeeper by offering something precious
  destroy the thing in the center of the room — if you can figure out what it is
  simply get out alive; there is no other objective anymore

encounterTwist
  the antagonist is not hostile — they are trying to warn you about something worse
  the trapped child is already dead; what you rescue is what killed them
  the key you need is inside the antagonist's stomach
  the door you came through is gone; the only way out is forward, through the threat
  the food is safe. The food has always been safe. The danger is that you will want to stay and eat.
  a second antagonist enters from the opposite direction — you are now between them
  the floor gives way mid-encounter, dropping you into something worse
  the antagonist speaks your name. They should not know your name.
  the objective was a trap; completing it seals the exits
  the companion you sent ahead has not returned, and you hear their voice ahead, calling for help
  the lights go out. When they return, something in the room has changed.
  the antagonist is afraid of something in the room — something you have not yet seen
  you are not the first to attempt this; the bodies of previous attempts are arranged like a lesson
  time is looping; you have done this before, and the evidence is in your own handwriting on the walls

encounterReward
  a morsel of food — enough to stave off hunger for one more chapter
  a key that opens a door you passed three rooms ago
  a tool: a rusty nail, a bent spoon, a shard of mirror — improvisation is survival
  a piece of lore: a diary page, a photograph, a label that reveals a fragment of the truth
  a companion: the child you rescued will follow you now, for better or worse
  a map scratched into a surface, showing the way forward and the dangers marked
  a moment of warmth — a lit fire, a blanket, a full stomach; restore hope
  a weapon of last resort: a single-use item that will save you once, and only once
  the antagonist's lantern — its light reveals hidden things and frightens the smaller dark
  nothing — the reward is that you survived, and survival is its own currency here
  a music box that, when wound, reveals the layout of the next room
  a name — you learn the name of the place, or the antagonist, or yourself, and the name has power

encounterComplication
  the protagonist is injured and moves at half speed
  the protagonist is starving and must eat this chapter or suffer penalties
  a companion is panicking and may attract attention
  the only light source is failing and will die in four turns
  the floor is wet and every step risks a slip
  the antagonist has a pet — something small, fast, and loyal
  the room is filling with gas; each turn deals accumulating damage
  a timer is running — the tide, the bell, the patrol rotation
  the protagonist is being watched by something unseen, and knows it
  trust is fractured between companions; a betrayal may be imminent
  the objective requires splitting the party
  the protagonist has seen too much and must make a resolve check or freeze

encounterAtmosphere
  the air is thick with dust motes drifting through a single beam of amber light
  rain drums on a tin roof somewhere above, relentless and cold
  a music box plays in the distance, tinny and wrong, the melody half-remembered
  the walls are breathing — slowly, imperceptibly, but they are breathing
  the smell of old cooking hangs heavy, sweet and rotten at once
  frost rimes every surface; breath clouds and fingers numb
  the room is too warm, too humid, like the inside of something alive
  absolute silence — no drip, no creak, no hum. The silence has weight.
  flickering light casts long shadows that do not match the things casting them
  the floor is sticky and gives slightly, like standing on something organic
  a draft pulls at your clothes, always toward the same direction — down
  the room is filled with discarded shoes, hundreds of them, all small

// ═══════════════════════════════════════════════════════════════
//  CO-OP MODE — paired characters with linked backstories
// ═══════════════════════════════════════════════════════════════
coopDynamic
  The Protector and the Protected — one shields, one is shielded; the balance of power is fragile and shifting
  The Rivals — both want the same thing; there is only enough for one; the dark watches them choose
  The Strangers — thrown together by circumstance; trust is a currency neither can afford, but both must spend
  The Siblings — bound by blood and a shared past they remember differently; each carries a piece the other needs
  The Old Hand and the Newcomer — one has survived here longer; their survival has cost them something the newcomer still has
  The Mirror Pair — they are alike in disturbing ways; they may be two halves of something that should not have been split
  The Debtor and the Creditor — one owes the other a debt paid in service; the terms of the debt are about to change
  The Penitent and the Witness — one did something terrible; the other saw; silence is its own kind of bond
  The Leader and the Led — one decides, one follows; the decisions are getting worse; following is getting harder
  The Twin Flames — their fates are intertwined; what wounds one wounds the other; this may be literal here

coopBond
  they share a single match, and when it is gone they will be in the dark together
  they have a pact: if one is caught, the other runs and does not look back — neither is sure they will keep it
  they communicate in a language of taps and gestures they invented in the walls
  they have one blanket between them, and they argue about who needs it more
  they carry halves of a torn photograph; neither knows what the full picture shows
  they made a promise to something in the dark — the promise named them both
  they share a single name between them, passed back and forth like a torch
  they are bound by a thread only one of them can see, and it is pulling taut
  they have sworn to reach the door together, or not at all; the dark is testing that oath
  one carries the other's memory, because the other is losing it

coopConflict
  one has been eating; the other has not — and the food's source is becoming a question
  one wants to go deeper; the other wants to go up; the path splits ahead
  one has found a way out that requires leaving the other behind — and has not said so yet
  one remembers a betrayal the other has forgotten — or pretends to have
  one is changing, becoming something less human; the other must decide when friendship ends
  they disagree on whether the thing following them is real
  one has a secret the other needs to hear; the secret will break the bond
  one trusts a Resident who has been "kind"; the other sees the trap; neither will yield
  they found a child who needs help; one says save them, one says leave them — both are right
  one is faster and could escape alone; the slower one knows it

coopSharedHistory
  They arrived together in the same crate, marked "PERISHABLE — DO NOT SEPARATE." They separated anyway. The place is punishing them for it.
  They were once part of a larger group — seven children. They are the only two left. They do not speak of the other five. They do not need to.
  One found the other hiding in a wall, half-starved and feral. It took a month for the feral one to stop biting. It has been three months. The biting has not fully stopped.
  They escaped the same place — different exits, different directions — and found each other here by accident. The place they escaped from is the place they are in now. The exits were a loop.
  One is the other's older sibling. The age gap has narrowed; the place has aged the younger one. Soon they will be the same age. Then the younger will be older. This is not metaphorical.
  They were strangers who killed a Resident together — in self-defense, in terror, in silence. The Resident's body is the floor of the room where they sleep. They take turns not looking at it.
  One saved the other from the Grinder by a half-second. The saved one now believes they owe a life-debt. The saver is beginning to resent being needed.
  They are the last two members of a "class" — children who were being processed together. They escaped mid-processing. The processing left marks. The marks are the same on both of them.
  They met in the mirror maze. Each saw the other in a reflection before they met in person. They are still not sure which of them is the reflection.
  One is carrying the other's weight — literally, at times. The weaker one is dying slowly. The stronger one knows this. The weaker one knows the stronger one knows.

coopSharedFear
  the sound of a dinner bell — it means someone is about to eat, and it is not the Guests
  the particular silence that follows a child's scream — the silence that means it is over
  long fingers, especially when they appear in pairs under a door
  the smell of cooking — because they know what is being cooked, and they know who is next
  closed doors that open on their own — because what opens them is polite enough to knock first
  the dark between the lanterns — because that is where the patience lives

coopEnding
  they reach the door together — bloodied, starving, changed — and walk through it into light that burns after so long in the dark. One looks back. One does not. They never speak of what happened. They never stop hearing it.
  only one of them makes it out. The other holds the door. The door closes. The one outside can still feel the other's hand in theirs, and then can't. They walk toward the sun. They are alone. They are free. They wish they weren't.
  they do not escape — but they find a room with a lock on the inside, and they lock it, and they sit with their backs to the door, and they decide that this room, this small safe room, is enough. It is not freedom. It is a choice. It is the first choice they have been allowed.
  they escape — but something followed them out, something that was sleeping in the space between them, fed on their bond. It is awake now. It is hungry. It is wearing one of their faces.
  they do not escape. They grow. They grow together, filling the corridors of the place, until the corridors are too small and the place bursts at its seams. They become the place. They are the walls now. They are warm. They are waiting for the next pair.
  one escapes. The other does not. The one who escapes comes back, years later, with a light and a key and a fury that the place has never seen. The door opens. The saved one is there. They are older. They are smiling. They are not entirely themselves.
  they find a door that leads not out but sideways — to a place between places, a corridor of doors. They walk it together, opening doors, finding other children, leading them out. They become a legend: the two who walk the between. The dark cannot follow them there. It waits at every door.
  they make it to the shore. The tide is out. The sun is rising. They sit on the wet sand and watch the place sink behind them. One of them is holding the other's hand. One of them is cold. The cold one is not breathing. The living one does not let go for a long time.

// Generate a co-op pair with linked backstories
generateCoopPair() =>
  let char1 = generateCharacter();
  let char2 = generateCharacter();
  let dynamic = coopDynamic.selectOne.evaluateItem;
  let bond = coopBond.selectOne.evaluateItem;
  let conflict = coopConflict.selectOne.evaluateItem;
  let sharedHistory = coopSharedHistory.selectOne.evaluateItem;
  let sharedFear = coopSharedFear.selectOne.evaluateItem;
  let ending = coopEnding.selectOne.evaluateItem;
  return {
    character1: char1,
    character2: char2,
    dynamic: dynamic,
    bond: bond,
    conflict: conflict,
    sharedHistory: sharedHistory,
    sharedFear: sharedFear,
    ending: ending
  };

// Build co-op image prompt — two characters together
buildCoopImagePrompt(pair) =>
  let c1 = pair.character1;
  let c2 = pair.character2;
  let base = "Official Little Nightmares artwork style, 2D dark fantasy concept art, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style. ";
  base += "Two characters together in the Little Nightmares universe. ";
  base += "Character 1: a " + c1.type.toLowerCase() + ", " + c1.gender + ", wearing " + c1.clothing + ". ";
  base += "Character 2: a " + c2.type.toLowerCase() + ", " + c2.gender + ", wearing " + c2.clothing + ". ";
  base += "The two small figures stand together in a vast ominous environment, their relationship suggested by body language and proximity. ";
  base += "Looming architecture, long shadows, volumetric dust, subtle fog. ";
  base += "Dark background with a single warm light source illuminating both figures. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, cinematic dual-character composition, no text, no watermark.";
  return base;

// Build co-op text display
buildCoopText(pair) =>
  let text = "";
  text += "═══ CO-OP PAIR ═══\n";
  text += "Dynamic: " + pair.dynamic + "\n\n";
  text += "── " + pair.character1.name.toUpperCase() + " ──\n";
  text += pair.character1.type + " | " + pair.character1.gender + " | " + pair.character1.skill + "\n\n";
  text += "── " + pair.character2.name.toUpperCase() + " ──\n";
  text += pair.character2.type + " | " + pair.character2.gender + " | " + pair.character2.skill + "\n\n";
  text += "▸ THE BOND\n" + pair.bond + "\n\n";
  text += "▸ SHARED HISTORY\n" + pair.sharedHistory + "\n\n";
  text += "▸ THE CONFLICT\n" + pair.conflict + "\n\n";
  text += "▸ SHARED FEAR\n" + pair.sharedFear + "\n\n";
  text += "▸ THEIR ENDING\n" + pair.ending + "\n";
  return text;

// ═══════════════════════════════════════════════════════════════
//  PET COMPANION GENERATOR — unique companions with abilities
// ═══════════════════════════════════════════════════════════════
petSpecies
  a rat with unusual intelligence and a scar across one eye^3
  a mechanical bird that winds itself, ticking like a clock^2
  a moth the size of a fist, drawn to any light source^2
  a spider with iridescent markings that never bites its keeper
  a centipede as long as a forearm, docile and warm
  a cat, thin and feral, that purrs at the wrong things
  a dog — enormous to a child, terrier-sized to a Resident — loyal and afraid
  a crow that has learned to mimic children's voices
  a mouse that fits in a pocket and squeaks warnings
  a beetle with a shell like hammered copper
  a worm that glows faintly in the dark, bioluminescent and slow
  a frog that swallows things larger than itself and sometimes returns them
  a bat that hangs inside a sleeve and navigates by sound
  a snail whose trail heals what it crosses
  a crab that lives in a stolen jewelry box, carrying it like armor
  a shadow-pup: a small dark shape that detaches from walls, not quite solid
  a paper crane that refolds itself when torn, origami given stubborn life
  a grub that vibrates when danger is near, like a living alarm

petSpeciesDesc
  a rat with unusual intelligence and a scar across one eye = Rats are despised here, hunted and poisoned and trapped. This one has survived all of it. It recognizes traps before they spring, knows which pipes lead where, and has learned that this particular child is not a threat. It will lead them to food and away from danger — for a price. The price is warmth. It sleeps in their pocket, and it must sleep warm.
  a mechanical bird that winds itself, ticking like a clock = It was made by someone who loved small, fragile things. The maker is gone. The bird remains. It winds itself when it senses danger, its ticking accelerating. It can fly short distances, distract, and retrieve small objects. It cannot be repaired if it breaks. It has never broken.
  a moth the size of a fist, drawn to any light source = Moths are drawn to flame, and in this place, everything is dark. The moth leads the child toward light sources — some safe, some not. It cannot speak, but its wing patterns shift to suggest direction. It dies if it touches a true flame, and is reborn from its own dust at dawn. This has happened many times.
  a spider with iridescent markings that never bites its keeper = It builds webs in the child's clothing, tiny networks of silk that vibrate when something approaches. It is a living alarm system. It eats the things that try to eat the child — insects, mostly, but once, something larger. The keeper does not ask what. The spider does not tell.
  a centipede as long as a forearm, docile and warm = It wraps around the child's arm like a living bracelet, warm and pulsing faintly. It can extend to incredible lengths, bridging gaps, reaching keys, fetching objects from far shelves. It is loyal. It is also, when threatened, capable of delivering a venom that drops something the size of a Resident. It has done this once. The child did not see it. The child does not want to.
  a cat, thin and feral, that purrs at the wrong things = It purrs when danger is near — not when it is safe. This is backwards. This is useful. The child has learned to fear the purr and seek its absence. The cat can see in absolute darkness, fits through impossibly small gaps, and once killed something that was following them by leading it into a trap. The cat did this without being asked.
  a dog — enormous to a child, terrier-sized to a Resident — loyal and afraid = The dog is the only thing in this place that loves without condition. It is afraid of everything — the dark, the noises, the Residents — but it will place itself between the child and danger every time. It can fight, badly and briefly. It can bark, loudly and at the worst moment. It is the best thing here.
  a crow that has learned to mimic children's voices = It speaks in fragments — stolen words, borrowed cries, the echo of a child who came before. It can lure Residents away with a well-placed "hello" or distract them with a sob. It remembers everything it hears and will repeat it at the most disconcerting moments. It once said the child's name. The child had never spoken it aloud.
  a mouse that fits in a pocket and squeaks warnings = Small enough to go anywhere, quiet enough to be forgotten. It scouts ahead, slipping through cracks and under doors, and returns with information encoded in the pattern of its squeaks. The child has learned to read these patterns. The mouse has learned to read the child's fear. They are a team.
  a beetle with a shell like hammered copper = Its shell is hard enough to deflect a blade and bright enough to catch light in the darkest room. It can be placed on a surface and left as a mirror, reflecting what approaches. It clicks once for "safe" and three times for "run." It has never been wrong. The child does not know how it knows.
  a worm that glows faintly in the dark, bioluminescent and slow = It produces a soft, cold light — enough to see by, not enough to attract. It can be draped around the neck like a scarf, or held aloft like a lantern. It feeds on decay, which is plentiful here. It will not go where there is no decay, which is itself information: where the worm will not go, nothing has died. Yet.
  a frog that swallows things larger than itself and sometimes returns them = It can store objects in its stomach — keys, tools, food, small weapons — and regurgitate them on command. The retrieval is not always accurate. The frog once swallowed a key and returned a tooth. The child did not recognize the tooth. The frog did not explain.
  a bat that hangs inside a sleeve and navigates by sound = It sleeps in the child's sleeve by day and scouts by night, echolocating through walls to map the space beyond. It can detect hollow spaces, hidden doors, and things that are breathing where they should not be. It is loyal to the warmth of the sleeve and to nothing else.
  a snail whose trail heals what it crosses = Its slime, when fresh, closes wounds, mends tears in fabric, and seals cracks in wood. It is slow — agonizingly slow — but where it passes, things are made whole. The child carries it in a matchbox and places it on what needs healing. The snail does this without complaint. The snail does everything without complaint.
  a crab that lives in a stolen jewelry box, carrying it like armor = The jewelry box is its shell — lacquered, hinged, and small enough to carry. The crab inside has one enormous claw and a bad temper. It will snap at anything that threatens the child, and its grip is strong enough to hold a Resident's finger. It hoards shiny things. The child is the shiniest thing it has.
  a shadow-pup: a small dark shape that detaches from walls, not quite solid = It is a piece of the dark that has chosen to be loyal. It cannot be touched, but it can touch — cold, brief, startling. It scouts through shadows, appearing in dark corners to signal safe passage or retreat. It cannot exist in light. When the lights come on, it is simply gone, until the dark returns.
  a paper crane that refolds itself when torn, origami given stubborn life = It was folded by a child who is no longer here. It unfolds to carry messages, refolds to rest. It cannot be destroyed — every tear is healed by re-folding, though each re-folding loses a small detail of the original design. It is slowly becoming simpler. It is slowly becoming something else.
  a grub that vibrates when danger is near, like a living alarm = It pulses with a low hum that rises in pitch and intensity as danger approaches. Held against the chest, it is a heartbeat that warns. It is otherwise useless — it does not fetch, fight, or lead. But it has saved the child's life eleven times. The child counts.

petName
  Twitch
  Button
  Lantern
  Stitch
  Pebble
  Whisper
  Coal
  Thimble
  Rattle
  Soot
  Mote
  Clink
  Ember
  Pip
  Tatter
  Glimmer
  Hush
  Nib
  Clack
  Wisp
  Rustle
  Click
  Cinder
  Morsel
  Pin
  Burr
  Snip
  Ash
  Dot
  Crumb

petAbility
  leads the way through ventilation shafts and pipe networks, always finding the path that avoids patrols
  acts as a living alarm — vibrates, clicks, or squeaks when danger is within thirty feet
  can retrieve small objects from hard-to-reach places: keys from belts, food from shelves, tools from drawers
  produces faint light in darkness, just enough to see by without attracting attention
  can distract antagonists by making noise in a different direction, drawing them away
  senses traps and hazards before they trigger, freezing in place as a warning
  can fit through gaps the child cannot, scouting ahead and reporting back through behavior
  mimics sounds to lure or misdirect — a Guest's name called from the wrong room
  carries messages between separated characters, small notes rolled and tied
  can fight in a desperate pinch — a bite, a scratch, a distraction just long enough to run
  heals small wounds with its presence — its warmth, its trail, its inexplicable proximity
  can be sent to fetch help, finding other children or safe spaces and leading them back
  serves as a living map, remembering routes and warning when the child goes in circles
  can detect edible food from poisoned food, refusing to approach what is tainted
  reflects light to reveal hidden things — messages in ink, things watching from dark corners
  stores items internally, a living pocket that regurgitates what is needed on command
  can detect the supernatural — it hisses at mirrors, recoils from certain doors, fears specific names
  neutralizes poison and gas in a small radius, filtering the air with its own biology
  can unlock simple mechanisms — a claw in a keyhole, a beak on a latch, persistence and cleverness
  creates diversions by knocking things over, triggering old mechanisms, or starting small fires

petQuirk
  refuses to enter rooms painted green, and no one remembers why
  collects small shiny objects and hides them in the child's pockets
  hums a lullaby the child does not recognize, but finds deeply comforting
  grooms the child's hair while they sleep, tidying with obsessive care
  flinches at the sound of bells, pressing flat against the child
  has a favorite spot — a specific crack in a specific wall — and returns to it obsessively
  steals food from other children and brings it to its keeper, morality be damned
  will not cross running water and must be carried, shivering, across drains
  reacts to the Resident's approach before any sound is heard, as if sensing intent
  has exactly one trick it performs when happy, and it is always slightly wrong
  stares at specific walls for hours, motionless, as if listening to something behind them
  ages in reverse — growing younger, smaller, more vital as time passes — which is deeply unsettling
  leaves small gifts: a button, a pebble, a tooth — always placed where the child will find them
  mimics the child's breathing pattern when they sleep, synchronizing perfectly
  vanishes during thunderstorms and returns wet, smug, and unwilling to explain

petHowTheyMet
  found trapped in a glue trap behind the pantry, freed with patience and a bent spoon
  stumbled out of a wall cavity during a chase, and simply... followed
  was already living in the child's coat pocket when they arrived; neither knows how it got there
  purchased from a Resident with a week's worth of scavenged food; the Resident laughed at the trade
  found wounded in a drain pipe, nursed back to health with stolen crumbs and rainwater
  appeared in a mirror first, then in the room — stepping out of the reflection as if it were a door
  was the pet of a child who came before; it transferred its loyalty without explanation
  fell from a crack in the ceiling during a meal, landing in the child's lap; the child hid it
  was being eaten by something larger; the child scared the larger thing off without thinking
  the child woke one morning and it was simply there, sleeping on their chest, as if it had always been
  found in a cage in the Resident's quarters, labeled with a child's name that was not the current child's
  it found the child — led them out of a collapsing corridor by running ahead and looking back

petLoyalty
  devoted — will die for the child without hesitation, and nearly has, several times
  fiercely protective — attacks anything that threatens the child, regardless of size disparity
  quietly loyal — never dramatic, always present, a constant warmth in the cold
  conditional — stays as long as the child feeds it, warmth for warmth, a transactional love
  bonded — the child and pet share something deeper than understanding; they dream the same dreams
  reluctantly attached — acts indifferent but always returns, always follows, always watches from a distance
  symbiotic — they need each other equally; the pet cannot survive without the child's warmth, the child cannot survive without the pet's warnings
  imprinted — the pet believes the child is its parent, its flock, its entire world; this is sweet and also a little terrifying

// Generate a full pet companion
generatePet() =>
  let species = petSpecies.selectOne.evaluateItem;
  let speciesDesc = petSpeciesDesc[species].evaluateItem;
  let name = petName.selectOne.evaluateItem;
  let ability = petAbility.selectOne.evaluateItem;
  let quirk = petQuirk.selectOne.evaluateItem;
  let howTheyMet = petHowTheyMet.selectOne.evaluateItem;
  let loyalty = petLoyalty.selectOne.evaluateItem;
  return {
    species: species,
    speciesDesc: speciesDesc,
    name: name,
    ability: ability,
    quirk: quirk,
    howTheyMet: howTheyMet,
    loyalty: loyalty
  };

// Build pet image prompt
buildPetImagePrompt(pet) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy concept art, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style. ";
  base += "Subject: a small pet companion creature in the Little Nightmares universe. ";
  base += "The creature is " + pet.species + ". ";
  base += "Named: " + pet.name + ". ";
  base += "The creature is shown in a dark atmospheric environment, nestled in or near a child's pocket, sleeve, or shoulder. ";
  base += "Small fragile creature in a vast ominous environment, warm and endearing despite the dark surroundings. ";
  base += "Looming architecture, long shadows, volumetric dust, subtle fog. ";
  base += "Dark background with a single warm light source illuminating the creature. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, intimate close-up composition, no text, no watermark.";
  return base;

// Build pet text display
buildPetText(pet) =>
  let text = "";
  text += "═══ " + pet.name.toUpperCase() + " ═══\n";
  text += "Species: " + pet.species + "\n\n";
  text += pet.speciesDesc + "\n\n";
  text += "▸ ABILITY\n" + pet.ability + "\n\n";
  text += "▸ QUIRK\n" + pet.quirk + "\n\n";
  text += "▸ HOW THEY MET\n" + pet.howTheyMet + "\n\n";
  text += "▸ LOYALTY\n" + pet.loyalty + "\n";
  return text;

// Build a full encounter
generateEncounter() =>
  let type = encounterType.selectOne.evaluateItem;
  let typeDesc = encounterTypeDesc[type].evaluateItem;
  let threat = encounterThreat.selectOne.evaluateItem;
  let scale = encounterScale.selectOne.evaluateItem;
  let location = encounterLocation.selectOne.evaluateItem;
  let antagonist = encounterAntagonist.selectOne.evaluateItem;
  let objective = encounterObjective.selectOne.evaluateItem;
  let twist = encounterTwist.selectOne.evaluateItem;
  let reward = encounterReward.selectOne.evaluateItem;
  let complication = encounterComplication.selectOne.evaluateItem;
  let atmosphere = encounterAtmosphere.selectOne.evaluateItem;
  let roundCount = 4 + Math.floor(Math.random() * 5);
  return {
    type: type,
    typeDesc: typeDesc,
    threat: threat,
    scale: scale,
    location: location,
    antagonist: antagonist,
    objective: objective,
    twist: twist,
    reward: reward,
    complication: complication,
    atmosphere: atmosphere,
    rounds: roundCount
  };

// Build encounter image prompt
buildEncounterImagePrompt(enc) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy concept art, ";
  base += "painterly digital illustration, atmospheric, muted desaturated colors with golden amber accents, ";
  base += "dramatic chiaroscuro lighting, eerie and unsettling mood, detailed texture, Tarsier Studios art style. ";
  base += "Scene: a tabletop RPG encounter set in " + enc.location + ". ";
  base += "Mood: " + enc.threat + ". ";
  base += "Atmosphere: " + enc.atmosphere + ". ";
  base += "The scene shows " + enc.antagonist + ". ";
  base += "A small protagonist figure navigates the environment. ";
  base += "Vast ominous architecture, long shadows, volumetric dust, subtle fog. ";
  base += "Dark background with a single warm light source. ";
  base += "Top-down isometric perspective, like a game master's battle map illustration. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, no text, no watermark.";
  return base;

// Build encounter text display
buildEncounterText(enc) =>
  let text = "";
  text += "═══ ENCOUNTER: " + enc.type.toUpperCase() + " ═══\n";
  text += enc.typeDesc + "\n\n";
  text += "Threat Level: " + enc.threat + "\n";
  text += "Scale: " + enc.scale + "\n";
  text += "Suggested Rounds: " + enc.rounds + "\n\n";
  text += "▸ SETTING\n" + enc.location + "\n";
  text += "Atmosphere: " + enc.atmosphere + "\n\n";
  text += "▸ ANTAGONIST\n" + enc.antagonist + "\n\n";
  text += "▸ OBJECTIVE\n" + enc.objective + "\n\n";
  text += "▸ TWIST\n" + enc.twist + "\n\n";
  text += "▸ COMPLICATION\n" + enc.complication + "\n\n";
  text += "▸ REWARD\n" + enc.reward + "\n";
  return text;

getRandomEasterEgg() =>
  let name = easterEggName.selectOne.evaluateItem;
  let msg = easterEggMsg.selectOne.evaluateItem;
  return { name: name, msg: msg };

// ═══════════════════════════════════════════════════════════════
//  DREAM SEQUENCES — surreal interlude chapters
// ═══════════════════════════════════════════════════════════════

dreamSetting
  a corridor that stretches and breathes, wallpaper rippling like skin
  a kitchen where the food is made of memories, each bite erasing a face you knew
  a schoolroom with no doors, where the chalk writes itself in a language you almost understand
  a garden growing underneath the floorboards, tended by hands that reach up through the boards
  a ballroom where the dancers are mannequins and the music is the sound of grinding teeth
  a library where every book is open to the same page, and the page is your reflection
  a bathtub filled with black water that shows the future in its ripples
  a nursery where the toys play with each other when you look away
  a staircase that spirals inward, each step narrower than the last, descending into your own chest
  a mirror maze where every reflection is a version of you that made a different choice
  a clock tower interior where time has congealed into amber, trapping moments mid-motion
  a cellar where preserved things in jars watch you with their eyes
  an attic where forgotten things gather to whisper about the children who left them
  a chapel where the stained glass depicts scenes from your own life, including some that haven't happened yet
  a sewing room where the thread is pulled from your own shadow, stitching together things that should remain apart
  a music room where the piano plays itself and the notes become moths that dissolve on contact

dreamMood
  tender and aching, like remembering a kindness you were never shown
  feverish and urgent, like running through honey toward a door that keeps receding
  numb and detached, like watching yourself from across a room filled with water
  euphoric and terrible, like laughing at something that is eating you
  quiet and searching, like turning over stones in a creekbed made of your own memories
  violent and bright, like a firework made of teeth
  slow and viscous, like moving through warm tar while the ceiling descends
  nostalgic for a place you have never been and will never find
  guilty, like finding a door you sealed shut and seeing light beneath it
  reverent, like standing in a cathedral made of your own bones
  mischievous, like a child rearranging the stars to spell something rude
  grieving, like holding something small and warm that is already going cold

dreamEntity
  a version of yourself at an age you never reached, wearing clothes you've never owned
  a parent composed entirely of hands, each one offering or withholding something different
  a child who is also a door — knock and they open onto another dream
  a thing that wears your face poorly, like a mask made of wet paper
  a flock of paper birds that rearrange into words you refuse to read
  a tall figure counting something invisible, tallying marks on a wall that is your skin
  a mirror that shows you from behind, and the you-from-behind is turning around slowly
  a procession of children carrying candles, each candle a year of your life, some already out
  a thing that is eating its own shadow and growing larger with each swallow
  a woman combing thread instead of hair, weaving a tapestry of everything you've ever lost
  a man with a key for a face, turning slowly in a lock that is the horizon
  a swarm of moths that form a face when they settle, and the face is speaking to you
  a giant child playing with you as if you were a doll, gentle and careless and devastating
  something that was once a friend, now folded into a shape that does not fit any name
  a choir of voices singing in a language you dreamed before you could speak
  a steward of the dream who asks for your ticket, and you cannot remember where you were going

dreamAction
  you try to speak but your mouth is full of sand, and the sand is counting
  you reach for a door handle that becomes a hand and holds yours, then will not let go
  you walk down stairs that rebuild themselves behind you, ascending into nowhere
  you open a drawer and find a smaller version of yourself inside, waving
  you drink from a cup that tastes like a specific afternoon you had forgotten
  you try to wake up but the dream folds around you like a blanket being tucked in by something patient
  you follow a sound that is almost your name, spoken by something that almost knows it
  you find a room that is exactly your childhood bedroom, except every surface is breathing
  you climb a ladder made of ribs that reaches toward a light that is not the sun
  you watch yourself sleeping from across the room, and the sleeping you opens one eye
  you peel back the wallpaper to reveal the sky, and the sky is peeling back to reveal more wallpaper
  you swallow a key and feel it turn inside you, unlocking something that was never locked
  you try to write your name but the letters rearrange into a question you cannot answer
  you hold a conversation with a chair that knows you better than you know yourself
  you walk through a wall and discover the dream was inside the wall all along, and the room was the dream
  you find a music box that plays a tune you've never heard, and you begin to cry without knowing why

dreamSymbol
  a yellow raincoat hanging empty on a hook, still warm
  a single shoe, child-sized, standing in a puddle that reflects the wrong ceiling
  a key with no door, warm from being held too long
  a mirror with no reflection, showing only the room behind you
  a music box open and silent, its ballerina waiting
  a door that is slightly ajar, with light the color of old honey
  a pile of buttons arranged in the shape of a sleeping child
  a rope of braided hair long enough to climb, ending in a knot
  a paper boat floating on black water, moving against the current
  a single candle burning with a blue flame, casting shadows that move independently
  a clock with no hands, its face showing a time that does not exist
  a bed made for a child, neatly kept, never slept in, the sheets still holding an impression
  a staircase descending into clear water, each step visible but impossibly deep
  a window showing a garden that cannot exist in the place you are
  a pair of scissors resting on a cut braid, the braid still warm
  a photograph of yourself, but the photograph is older than you are

dreamReveal
  you were never asleep. The dream was the waking world. This — this right here — is the dream.
  the dream was a memory, but not yours. It belongs to the child who was here before you. They left it behind.
  the thing you were running from in the dream was yourself, arriving late to a meeting you scheduled.
  the dream ends, but the object you were holding in it is now in your hand. It is warm. It should not be.
  the dream was a warning from the place itself. It does not want you here. It is being polite. For now.
  you wake up and find the word the dream taught you scratched into the wall beside your bed. The handwriting is yours.
  the dream was a door, and by dreaming it you have opened it. Something has stepped through. It is in the room with you now. It is breathing.
  the dream was not yours. You dreamed someone else's dream by accident. They are awake now. They are looking for you.
  the figure in the dream was real. It has been watching you sleep. It is still here. It liked what it saw.
  you wake up younger than you were when you fell asleep. Only by a day. Only by a day. But the days are adding up.
  the dream was a rehearsal. The event it showed you will happen tomorrow. You cannot prevent it. You can only choose your role.
  the dream was a meal. Something fed on it while you dreamed. You feel thin. The walls feel full.
  the dream was a message, but you were the wrong recipient. The message was meant for someone who is already gone. You must carry it now.
  the dream was a map. The exit it showed is real. But the map is also a trap, and the exit is also a mouth. Choose carefully.
  you do not wake up. The dream simply ends, and you are standing in a different room than the one you fell asleep in. You do not recognize it. It recognizes you.

dreamColor
  everything is washed in the amber of late afternoon, golden and dying
  the palette is all rust and iron, oxidized and bleeding
  everything is the blue of deep water, pressure and silence
  the world is sepia, aged and fading at the edges
  everything glows faintly green, the color of things seen through closed eyelids in sunlight
  the palette is bone-white and ash-grey, with cracks of black showing through
  everything is the deep purple of a bruise, tender and deepening
  the world is rendered in the red of a darkroom, everything emerging and developing
  everything is the pale yellow of old paper, written on in ink you cannot read
  the palette is the teal of old copper, verdigris and memory

dreamSound
  a music box playing a melody that is almost a lullaby, but the intervals are wrong
  the sound of water dripping in a rhythm that matches your heartbeat, then doesn't
  a child humming, distant, the tune unfamiliar but the voice almost yours
  the grinding of something large and slow, like teeth in the walls
  absolute silence, but the kind that has weight and texture and is looking at you
  a whispered conversation just below understanding, two voices deciding something about you
  the sound of pages turning in an empty room, each page heavier than the last
  a bell, distant, tolling in a pattern that counts down to something
  the sound of your own breathing, echoed back from too many directions
  a piano playing underwater, muffled and distorted and unbearably sad
  the sound of small feet running, circling you, never arriving
  a tapping, patient and rhythmic, like fingers on the inside of a window

// Generate a dream sequence
generateDreamSequence() =>
  let setting = dreamSetting.selectOne.evaluateItem;
  let mood = dreamMood.selectOne.evaluateItem;
  let entity = dreamEntity.selectOne.evaluateItem;
  let action = dreamAction.selectOne.evaluateItem;
  let symbol = dreamSymbol.selectOne.evaluateItem;
  let reveal = dreamReveal.selectOne.evaluateItem;
  let color = dreamColor.selectOne.evaluateItem;
  let sound = dreamSound.selectOne.evaluateItem;
  let phase = dreamPhase.selectOne.evaluateItem;
  let interpretation = dreamInterpretation.selectOne.evaluateItem;
  return {
    setting: setting,
    mood: mood,
    entity: entity,
    action: action,
    symbol: symbol,
    reveal: reveal,
    color: color,
    sound: sound,
    phase: phase,
    interpretation: interpretation
  };

dreamPhase
  Descent — the dream takes hold, reality loosens its grip
  Wandering — the dream's logic asserts itself, you move through it
  Encounter — something finds you, or you find something
  Turning — the dream shifts, reveals its true shape
  Revelation — the dream shows you what it wanted you to see
  Dissolution — the dream begins to end, or you begin to end within it

dreamInterpretation
  This dream speaks of a choice you have been avoiding. The place is reminding you that avoidance is itself a choice, and the longer you make it, the fewer options remain.
  This dream is about trust. Something in the waking world is not what it seems. The dream has shown you its true face. Whether you recognize it when you see it is another matter.
  This dream is a rehearsal for grief. Something is going to be lost. The dream cannot tell you what, only that the losing has already begun, and you are practicing for the moment you notice.
  This dream is about hunger. Not yours — something else's. You are the meal, or the table, or the hand that sets the plate. The dream does not specify which. The place does not care which.
  This dream is about the child you were before the place found you. That child is still here, somewhere, preserved in the amber of the dream. Finding them may be the way out. Finding them may be the trap.
  This dream is a key. Not a literal one — a structural one. The dream's shape is the shape of something in the waking world. When you encounter that shape, you will know. You will know too late to use the knowledge, but you will know.
  This dream is about forgetting. The place is eating your memories one by one, and the dream is the taste of each one as it goes. Savor it. You will not have it again.
  This dream is a mirror. What you saw in it is what the place sees when it looks at you. You may not recognize yourself. The place does not recognize itself in your waking face either. This is called a misunderstanding. It is also called a hunt.
  This dream is about a door. The door is real. The dream showed you where it is, in the language of sleeping things. You must translate it while you still remember the grammar.
  This dream is the place dreaming through you. You are not the dreamer. You are the dream. When you wake, a small part of the place wakes too, and looks out through your eyes for a moment before forgetting. It is always forgetting. It is always waking.
  This dream is about a name. Not yours — a name the place has been calling you, in a language below sound. The dream was the closest it could come to speaking it aloud. If you remember the shape of it, you have power. If you speak it, you have consequences.
  This dream is a warning wrapped in a gift. The gift is real. The warning is that the gift is also a weight, and the weight is also a chain, and the chain is also the only thing keeping you from falling. Accept it carefully.

// Build dream sequence image prompt
buildDreamImagePrompt(dream) =>
  let base = "Official Little Nightmares artwork style, 2D dark fantasy surreal dream sequence illustration, ";
  base += "painterly digital art, atmospheric, dreamlike and oneiric, ";
  base += dream.color + ". ";
  base += "Scene: " + dream.setting + ". ";
  base += "Mood: " + dream.mood + ". ";
  base += "A surreal, dreamlike composition with impossible geometry and shifting perspective. ";
  base += "Featuring: " + dream.entity + ". ";
  base += "Action: " + dream.action + ". ";
  base += "A symbolic object appears: " + dream.symbol + ". ";
  base += "The atmosphere is thick with " + dream.sound + ". ";
  base += "Surrealism inspired by Zdzislaw Beksinski, Salvador Dali, and Dave McKean. ";
  base += "Soft edges, bleeding forms, dissolving boundaries between figure and ground. ";
  base += "Volumetric light, drifting particles, deep atmospheric haze. ";
  base += toneImageModifier(getCurrentToneLevel());
  base += "Hand-painted concept art aesthetic, dreamlike composition, no text, no watermark.";
  return base;

// Build dream sequence text
buildDreamText(dream) =>
  let text = "";
  text += "═══ " + dream.phase.toUpperCase() + " ═══\n\n";
  text += "SETTING: " + dream.setting + "\n\n";
  text += "MOOD: " + dream.mood + "\n\n";
  text += "COLOR: " + dream.color + "\n\n";
  text += "SOUND: " + dream.sound + "\n\n";
  text += "▸ THE ENCOUNTER\n" + dream.entity + "\n\n";
  text += "▸ WHAT HAPPENS\n" + dream.action + "\n\n";
  text += "▸ THE SYMBOL\n" + dream.symbol + "\n\n";
  text += "▸ THE REVEAL\n" + dream.reveal + "\n\n";
  text += "▸ INTERPRETATION\n" + dream.interpretation + "\n";
  return text;

