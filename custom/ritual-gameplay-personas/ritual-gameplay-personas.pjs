mishelle_v9
  build = She is a short, petite young woman in her early twenties with pale, smooth skin. Her cascade of vivid {red|black|blue|pink} hair is styled in voluminous curls that frame her face in retro pin-up glamour.
  face = She features delicate, youthful facial proportions with a slender jawline and soft features. Her look is enhanced by distinctive alternative-style tattoos and a unique neck piece that emphasizes a carefully cultivated nonconformity.
  makeup = Her sharp, cinematic cosmetics focus on bold, winged eyeliner paired with saturated, commanding lipstick values. This creative facial styling is accompanied by dangling earrings that speak to an alternative, gothic-inspired aesthetic.
  gaze = She displays a playful, confident expression with a glance that remains subtly defiant, mysterious, and inviting. Her overall facial presence conveys an aura of youthful confidence, creativity, and intentional rebellion.
  hair = cascade of vivid red hair styled in voluminous curls
  eyes = bright eyes catching ambient neon light
  lips = bold lips, saturated lipstick
  skin_tone = pale, smooth skin
  hair_style = voluminous curls that frame her face in retro pin‑up glamour

// ==========================================
// SELECTION STATE ENGINE (Core Logic)
// ==========================================

// 1. Define Mode (Change this value to switch behaviors)
active_mode = match
// active_mode = wild
// active_mode = hybrid

// 2. Dynamic Anchors resolved purely via Perchance list mapping
selected_girl_A = [girl_pool]
selected_girl_B = [girl_pool]

// 3. Flat Root-Level Exports (main generator reads these directly as gg.build, gg.face, etc.)
build = [active_mode == "match" ? selected_girl_A.build : (active_mode == "wild" ? random_scrambler.build : hybrid_cross.build)]
face = [active_mode == "match" ? selected_girl_A.face : (active_mode == "wild" ? random_scrambler.face : hybrid_cross.face)]
makeup = [active_mode == "match" ? selected_girl_A.makeup : (active_mode == "wild" ? random_scrambler.makeup : hybrid_cross.makeup)]
gaze = [active_mode == "match" ? selected_girl_A.gaze : (active_mode == "wild" ? random_scrambler.gaze : hybrid_cross.gaze)]
hair = [active_mode == "match" ? selected_girl_A.hair : (active_mode == "wild" ? random_scrambler.hair : hybrid_cross.hair)]
eyes = [active_mode == "match" ? selected_girl_A.eyes : (active_mode == "wild" ? random_scrambler.eyes : hybrid_cross.eyes)]
lips = [active_mode == "match" ? selected_girl_A.lips : (active_mode == "wild" ? random_scrambler.lips : hybrid_cross.lips)]
skin_tone = [active_mode == "match" ? selected_girl_A.skin_tone : (active_mode == "wild" ? random_scrambler.skin_tone : hybrid_cross.skin_tone)]
hair_style = [active_mode == "match" ? selected_girl_A.hair_style : (active_mode == "wild" ? random_scrambler.hair_style : hybrid_cross.hair_style)]

// 4. Random Scrambler (Total Chaos Mode)
random_scrambler
  build = [girl_pool.selectOne.build]
  face = [girl_pool.selectOne.face]
  makeup = [girl_pool.selectOne.makeup]
  gaze = [girl_pool.selectOne.gaze]
  hair = [girl_pool.selectOne.hair]
  eyes = [girl_pool.selectOne.eyes]
  lips = [girl_pool.selectOne.lips]
  skin_tone = [girl_pool.selectOne.skin_tone]
  hair_style = [girl_pool.selectOne.hair_style]

// 5. Hybrid Cross-Mix (Mix A and B physical / style features)
hybrid_cross
  build = [selected_girl_A.build]
  face = [selected_girl_A.face]
  makeup = [selected_girl_B.makeup]
  gaze = [selected_girl_B.gaze]
  hair = [selected_girl_A.hair]
  eyes = [selected_girl_A.eyes]
  lips = [selected_girl_B.lips]
  skin_tone = [selected_girl_A.skin_tone]
  hair_style = [selected_girl_B.hair_style]