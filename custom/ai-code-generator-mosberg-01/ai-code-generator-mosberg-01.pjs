generateText = {import:ai-text-plugin}
commentsPlugin = {import:comments-plugin}
literal = {import:literal-plugin}

// 🧩 Modular HTML/CSS Generator Lists
@component
  [header]
  [section]
  [footer]

@header
  <header>
    <h1>[title]</h1>
    <p>[subtitle]</p>
  </header>

@title
  Welcome to [siteName]

@siteName
  CodeCraft
  DevNest
  PixelForge
  SyntaxLab

@subtitle
  Your AI-powered code companion
  Build smarter with Perchance
  Generate beautiful interfaces instantly
  Modular design made easy

@section
  <section>
    <h2>[sectionTitle]</h2>
    <p>[sectionText]</p>
    <img src="https://source.unsplash.com/random/?interface,design" alt="design preview" />
  </section>

@sectionTitle
  Features
  How It Works
  Why Choose Us
  Get Started

@sectionText
  Discover powerful tools for developers.
  Generate clean, responsive code with ease.
  Customize your layout with intuitive controls.
  Explore themes and components built for scale.

@footer
  <footer>
    <p>&copy; [year] [siteName]. All rights reserved.</p>
  </footer>

@year
  2023
  2024
  2025
