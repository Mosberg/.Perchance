needsAn(word) =>
  word = String(word).trim().toLowerCase();
  if (!word) return false;
  if (/^(hour|honest|heir|honor|honour)/.test(word)) return true;
  let first = word[0];
  if ('aeiou'.includes(first)) {
    if (first === 'u' && /^(uni|use|uto|ubi|uru|ula|uve)/.test(word)) return false;
    return true;
  }
  return false;

fixArticles(text) =>
  text = String(text);
  return text.replace(/\b([Aa])n?\s+(\w+)/g, (match, art, word) => {
    let an = needsAn(word);
    let wasAn = match.trim().toLowerCase().startsWith('an');
    if (an && !wasAn) return (art === 'A' ? 'An' : 'an') + ' ' + word;
    if (!an && wasAn) return (art === 'A' ? 'A' : 'a') + ' ' + word;
    return match;
  });

buildAgreementCache() =>
  if (buildAgreementCache._c) return buildAgreementCache._c;
  let c = {subjects: new Set(), verbs: new Set(), colors: new Set()};
  let allLists = [subject, subjectsingleonly, time, day];
  for (let list of allLists) {
    for (let s of list.selectAll) {
      let w = String(s.evaluateItem).toLowerCase().trim();
      c.subjects.add(w);
      let parts = w.split(/\s+/);
      if (parts.length > 1) c.subjects.add(parts[parts.length-1]);
    }
  }
  ["thoughts","memories","feelings","emotions","horrors","clouds","skies","heavens"].forEach(w => c.subjects.add(w));
  for (let v of verb.selectAll) c.verbs.add(String(v.evaluateItem).toLowerCase());
  ["come","proceed","continue"].forEach(v => c.verbs.add(v));
  for (let i = 0; i < 15; i++) {
    for (let item of color.selectAll) {
      String(item.evaluateItem).toLowerCase().split(/[^a-z]+/).forEach(part => { if (part) c.colors.add(part); });
    }
  }
  buildAgreementCache._c = c;
  return c;

isPluralWord(word) =>
  word = word.toLowerCase();
  if (word === 'christmas') return false;
  if (/(ss|us|is|os)$/.test(word)) return false;
  if (/s$/.test(word)) return true;
  return false;

deconjugateS(w) =>
  if (/ies$/.test(w)) return w.slice(0,-3)+'y';
  if (/(oes|ses|xes|zes|ches|shes)$/.test(w)) return w.slice(0,-2);
  if (/s$/.test(w) && !/ss$/.test(w)) return w.slice(0,-1);
  return w;

conjugateS(v) =>
  if (/(s|x|z|ch|sh|o)$/.test(v)) return v+'es';
  if (/[^aeiou]y$/.test(v)) return v.slice(0,-1)+'ies';
  return v+'s';

findVerbBase(w, c) =>
  if (c.verbs.has(w)) return w;
  let b = deconjugateS(w);
  if (b !== w && c.verbs.has(b)) return b;
  return null;

matchCase(tmpl, src) =>
  if (!src || !src.length) return tmpl;
  if (src === src.toUpperCase()) return tmpl.toUpperCase();
  if (src[0] === src[0].toUpperCase()) return tmpl[0].toUpperCase()+tmpl.slice(1);
  return tmpl;

fixWord(raw, newWord) =>
  let m = raw.match(/^([^a-zA-Z']*)([a-zA-Z']+)([^a-zA-Z']*)$/);
  if (!m) return raw;
  return m[1]+matchCase(newWord, m[2])+m[3];

fixAgreement(text) =>
  let c = buildAgreementCache();
  text = fixArticles(text);
  let words = text.split(/(\s+)/);
  for (let i = 2; i < words.length; i += 2) {
    let raw = words[i];
    if (!raw || !raw.trim()) continue;
    let lower = raw.toLowerCase().replace(/[^a-z']/g, '');
    if (!lower) continue;
    let pi = i - 2;
    let prevRaw = words[pi];
    if (!prevRaw) continue;
    let prev = prevRaw.toLowerCase().replace(/[^a-z']/g, '');
    if (!prev) continue;
    let skipRel = false;
    if (prev === 'that' || prev === 'who' || prev === 'which') {
      pi -= 2; prevRaw = words[pi];
      if (!prevRaw) continue;
      prev = prevRaw.toLowerCase().replace(/[^a-z']/g, '');
      if (!prev) continue;
      skipRel = true;
    }
    if (lower === 'is' || lower === 'are' || lower === 'has' || lower === 'have') {
      if (!skipRel) continue;
      if (!c.subjects.has(prev)) continue;
      let pl = isPluralWord(prev);
      if (pl && (lower === 'is' || lower === 'has')) words[i] = fixWord(raw, lower === 'is' ? 'are' : 'have');
      else if (!pl && (lower === 'are' || lower === 'have')) words[i] = fixWord(raw, lower === 'are' ? 'is' : 'has');
      continue;
    }
    let vb = findVerbBase(lower, c);
    if (!vb) continue;
    let isBase = (lower === vb);
    let ambiguous = c.subjects.has(vb);
    if (ambiguous && !skipRel) continue;
    if (c.colors.has(lower) && c.colors.has(prev)) continue;
    if (c.subjects.has(prev)) {
      let pl = isPluralWord(prev);
      if (pl && !isBase) words[i] = fixWord(raw, vb);
      else if (!pl && isBase) words[i] = fixWord(raw, conjugateS(vb));
      continue;
    }
    if (['i','you','we','they'].includes(prev) && !isBase) words[i] = fixWord(raw, vb);
    else if (['he','she','it'].includes(prev) && isBase) words[i] = fixWord(raw, conjugateS(vb));
  }
  for (let i = 2; i < words.length; i += 2) {
    let raw = words[i];
    if (!raw) continue;
    let lower = raw.toLowerCase().replace(/[^a-z]/g, '');
    if (lower !== 'was' && lower !== 'were') continue;
    let prev = (words[i-2]||'').toLowerCase().replace(/[^a-z']/g, '');
    let prevPrev = (words[i-4]||'').toLowerCase().replace(/[^a-z']/g, '');
    if (['with','for','to','at','in','on','by','from','of','about','behind','beside','between','among','against','above','below','under','over','through','towards'].includes(prevPrev)) continue;
    if (['i','he','she','it'].includes(prev) && lower === 'were') words[i] = fixWord(raw, 'was');
    else if (['you','we','they'].includes(prev) && lower === 'was') words[i] = fixWord(raw, 'were');
  }
  return words.join('');

outputFixed() =>
  let text = output.selectOne.evaluateItem;
  return fixAgreement(text);
 
