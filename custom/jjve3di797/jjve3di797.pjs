backgroundPlugin = {import:background-image-plugin}

title = Selestial-Skies' Random Art Title Generator
// Upload your background image to imgur and replace the following link with it.
// It must be *direct* link - i.e. ending in png or jpg, etc. - to get the direct link of an imgur image, right-click on the image and click "copy image address" or "copy image location"
// Unsplash has great images that are free to use: https://unsplash.com/t/wallpapers  (don't forget to upload them to imgur before using, and make sure you download the high-res version of the unsplash image to upload to imgur)
// IMPORTANT: The reason you should upload your image to imgur is because if you link to another website, it's likely that the link will eventually "break", or the image will move to a different URL.
// Imgur never deletes your image, and uploading an image to imgur is as easy as pasting a url on this page:  https://imgur.com/upload
backgroundImage =  https://i.imgur.com/M3wXrLE.jpg
