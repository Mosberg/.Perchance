$meta
  title = Karyotic
  description = A top-down horror shooter. Part 1: the Karyotic laboratory — dark halls, flickering lights, and a flashlight that cuts through the black.
  tags = horror, shooter, top-down, survival, karyotic

// ===== Karyotic — Part 1: The Laboratory =====
// Config knobs the user may want to tweak.

config
  tile = 40              // pixel size of one map tile
  mapW = 56              // map width  in tiles
  mapH = 40              // map height in tiles
  playerSpeed = 2.6      // px per frame at full stick
  playerRadius = 12      // collision radius
  darkness = 0.93        // 0 = full bright, 1 = pitch black
  flashlightRange = 360  // how far the beam reaches (px)
  flashlightSpread = 0.62// half-angle of the cone (radians ~ 35deg)
  flashlightStrength = 1.0
  ambientRange = 150     // radius of ceiling light pools (px)
  flickerChance = 0.012  // per-frame chance a light flickers
  viewW = 0
  viewH = 0

// Lab palette
palette
  floor   = #e9eef2
  floorLine = #c9d6e2
  wall    = #f4f7fa
  wallEdge = #2a6fd6
  wallTrim = #9ec3ef
  accent  = #1f4fa8
  dark    = #05070d
