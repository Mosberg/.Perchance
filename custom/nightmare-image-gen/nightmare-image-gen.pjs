$meta
  title = Nightmarish Image Generator
  description = Turn any prompt into a nightmarish AI image.
  image = https://user.uploads.dev/file/e461b8988fb68000238621ae5429102d.png

textToImage = {import:text-to-image-plugin}

userPrompt
  empty

hasGenerated
  empty

imageCount
  1

imageFormat
  square768

output
  [outputEmpty] ^[hasGenerated == "empty"]
  [outputGenerated] ^[hasGenerated == "generated"]

outputEmpty
  <div class\="empty-state">Enter a prompt and click Generate to create a nightmarish image.</div>

outputGenerated
  <div class\="image-grid count-[imageCount] format-square">[imageItemSquare512.selectMany(imageCount)]</div> ^[imageFormat == "square512"]
  <div class\="image-grid count-[imageCount] format-square">[imageItemSquare768.selectMany(imageCount)]</div> ^[imageFormat == "square768"]
  <div class\="image-grid count-[imageCount] format-portrait">[imageItemPortrait.selectMany(imageCount)]</div> ^[imageFormat == "portrait"]
  <div class\="image-grid count-[imageCount] format-landscape">[imageItemLandscape.selectMany(imageCount)]</div> ^[imageFormat == "landscape"]

imageItemSquare512
  <div class\="image-card">[textToImage(promptOptionsSquare512)]</div>

imageItemSquare768
  <div class\="image-card">[textToImage(promptOptionsSquare768)]</div>

imageItemPortrait
  <div class\="image-card">[textToImage(promptOptionsPortrait)]</div>

imageItemLandscape
  <div class\="image-card">[textToImage(promptOptionsLandscape)]</div>

promptOptionsSquare512
  prompt = [finalPrompt]
  negativePrompt = [negativePrompt]
  guidanceScale = 8
  resolution = 512x512

promptOptionsSquare768
  prompt = [finalPrompt]
  negativePrompt = [negativePrompt]
  guidanceScale = 8
  resolution = 768x768

promptOptionsPortrait
  prompt = [finalPrompt]
  negativePrompt = [negativePrompt]
  guidanceScale = 8
  resolution = 512x768

promptOptionsLandscape
  prompt = [finalPrompt]
  negativePrompt = [negativePrompt]
  guidanceScale = 8
  resolution = 768x512

finalPrompt
  [nightmareBefore] [userPrompt]. [nightmareAfter]

