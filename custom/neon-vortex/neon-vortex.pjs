$meta
  title = NEON VORTEX: Cyberpunk Looter Shooter - Game
  description = Dive into NEON VORTEX, a fast-paced cyberpunk looter shooter built in HTML5. Command a neon-glowing ship through infinite grid arenas, blast pursuing enemies, collect tiered loot (STIMPACKS heal, OVERCLOCK boosts speed, NUKE CORES amp damage), manage inventory buffs, level up with persistent progress, and survive escalating waves in retro CRT-styled glory. Mobile-ready with virtual joystick and fire button—pure arcade adrenaline!
  image = https://user.uploads.dev/file/b33288e7c416e5c50c62441fbcdc64da.jpg?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80
  tags = cyberpunk, looter-shooter, html5, arcade, neon, top-down, shooter, loot, inventory, mobile, single-file, javascript, fabric

$game
  name = NEON VORTEX: Cyberpunk Looter Shooter
  genre = Action, Shooter, Arcade
  platform = HTML5 (Web, Mobile)
  description = Command a neon-glowing ship through infinite grid arenas, blast pursuing enemies, collect tiered loot (STIMPACKS heal, OVERCLOCK boosts speed, NUKE CORES amp damage), manage inventory buffs, level up with persistent progress, and survive escalating waves in retro CRT-styled glory. Mobile-ready with virtual joystick and fire button—pure arcade adrenaline!
  features =
    - Fast-paced top-down shooter action
    - Infinite procedurally generated grid arenas
    - Tiered loot system with STIMPACKS, OVERCLOCK, and NUKE CORES
    - Inventory management with temporary buffs
    - Persistent leveling system with unlockable upgrades
    - Retro CRT-style visuals and neon aesthetics
    - Mobile-friendly controls with virtual joystick and fire button
  release_date = 2024-06-01
  developer = [Mosberg]
  publisher = [Mosberg]
  website = https://perchance.org/neon-vortex
  license = MIT