    const dir = i % 2 === 0 ? "swirlA" : "swirlB";
    swirl.style.cssText = `position:absolute;bottom:${yPct}%;left:50%;width:${w}px;height:${w*0.14}px;border-radius:50%;border:1.5px solid hsla(200,15%,60%,0.25);border-top-color:hsla(200,20%,75%,0.45);border-bottom-color:transparent;animation:${id}${dir} ${dur}s linear infinite;filter:blur(1.5px);`;
