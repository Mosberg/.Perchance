  const total = 55;
  const duration = 1800;
  for (let i = 0; i < total; i++) {
    const item = document.createElement("div");
    item.textContent = debris[Math.floor(Math.random() * debris.length)];
    const size = 14 + Math.random() * 26;
    item.style.cssText = `position:absolute;font-size:${size}px;left:50%;top:-50px;opacity:0;user-select:none;`;
    funnelWrap.appendChild(item);
    const delay = Math.random() * 6000;
    const spin = 360 + Math.random() * 1440;
    const orbits = 4 + Math.floor(Math.random() * 4);
    const keyframes = [{ transform: `translate(0px, 0px) rotate(0deg)`, opacity: 0 }];
    for (let o = 1; o <= orbits; o++) {
      const frac = o / orbits;
      const y = window.innerHeight * 0.1 + (window.innerHeight * 0.75) * frac;
      const orbitDir = o % 2 === 0 ? 1 : -1;
      const orbitRadius = (1 - frac * 0.75) * (60 + Math.random() * 80);
      const x = orbitDir * orbitRadius;
      keyframes.push({ transform: `translate(${x}px, ${y}px) rotate(${spin * frac}deg)`, opacity: 0.85 - frac * 0.3, offset: frac });
    }
    keyframes.push({ transform: `translate(0px, ${window.innerHeight + 60}px) rotate(${spin}deg)`, opacity: 0 });
    item.animate(keyframes, { duration: duration + Math.random() * 2500, delay, easing: "linear", fill: "forwards" });
  }
  for (let i = 0; i < 8; i++) {
    const bolt = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    bolt.setAttribute("viewBox", "0 0 100 200");
    bolt.setAttribute("preserveAspectRatio", "none");
    bolt.style.cssText = `position:absolute;top:0;width:${8+Math.random()*6}%;height:${30+Math.random()*25}%;left:${Math.random()*90}%;opacity:0;z-index:99997;filter:drop-shadow(0 0 6px #aacfff);`;
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    let d = "M50,0";
    let x = 50, y = 0;
    while (y < 200) {
      x += (Math.random() - 0.5) * 30;
      y += 15 + Math.random() * 25;
      d += ` L${x.toFixed(0)},${y.toFixed(0)}`;
    }
    path.setAttribute("d", d);
    path.setAttribute("fill", "none");
    path.setAttribute("stroke", "white");
    path.setAttribute("stroke-width", "2");
    bolt.appendChild(path);
    layer.appendChild(bolt);
    const strikeTime = Math.random() * 7;
    bolt.animate(
      [
        { opacity: 0 },
        { opacity: 0, offset: strikeTime / 8 },
        { opacity: 0.9, offset: strikeTime / 8 + 0.005 },
        { opacity: 0.3, offset: strikeTime / 8 + 0.02 },
        { opacity: 0.7, offset: strikeTime / 8 + 0.03 },
        { opacity: 0, offset: strikeTime / 8 + 0.05 },
        { opacity: 0, offset: 1 }
      ],
      { duration: 8000, easing: "ease-out", fill: "forwards" }
    );
  }
  setTimeout(() => {
    setTimeout(() => layer.remove(), 800);
  }, 9000);
stormEffect(name) =>
  const layer = document.createElement("div");
