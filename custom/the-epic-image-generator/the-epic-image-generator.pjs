  moveWaypoints.push({ left: (Math.random() < 0.5 ? -10 : 110) + "%" });
  funnelWrap.animate(moveWaypoints, { duration: 9000, easing: "ease-in-out", fill: "forwards" });
  const funnelBody = document.createElement("div");
