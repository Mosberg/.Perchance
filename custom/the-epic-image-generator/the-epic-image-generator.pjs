    );
  }
  for (let s = 0; s < 2; s++) {
    const bolt2 = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    bolt2.setAttribute("viewBox", "0 0 100 200");
    bolt2.setAttribute("preserveAspectRatio", "none");
    bolt2.style.cssText = `position:absolute;top:0;width:${8+Math.random()*5}%;height:${30+Math.random()*20}%;left:${15+Math.random()*70}%;opacity:0;`;
    generateLightning(bolt2, 50 + (Math.random()-0.5)*30);
    layer.appendChild(bolt2);
    const t2 = (2.5 + Math.random()*5) / 10;
    bolt2.animate(
      [
        { opacity: 0 },
        { opacity: 0, offset: t2 - 0.005 },
        { opacity: 0.8, offset: t2 },
        { opacity: 0.1, offset: t2 + 0.015 },
        { opacity: 0.5, offset: t2 + 0.025 },
        { opacity: 0, offset: t2 + 0.04 },
        { opacity: 0, offset: 1 }
      ],
      { duration: 10000, easing: "ease-out", fill: "forwards" }
    );
  }
  const total = 260;
  const duration = 550;
  const windAngle = 12 + Math.random() * 8;
  for (let i = 0; i < total; i++) {
    const drop = document.createElement("div");
    const len = 8 + Math.random() * 18;
    drop.style.cssText = `position:absolute;width:1.5px;height:${len}px;left:${Math.random()*110-5}%;top:-${len}px;opacity:${0.2+Math.random()*0.4};background:linear-gradient(to bottom, transparent, #88aacc);transform:rotate(${windAngle}deg);`;
    layer.appendChild(drop);
    const delay = Math.random() * 8000;
    drop.animate(
      [
        { transform: `translateY(0) rotate(${windAngle}deg)` },
        { transform: `translateY(${window.innerHeight + len}px) translateX(${windAngle*3}px) rotate(${windAngle}deg)` }
      ],
      { duration: duration + Math.random() * 400, delay, easing: "linear", fill: "forwards" }
    );
  }
  const leaves = ["🍂","🍃","🪶","📰","🧾","📄"];
  for (let i = 0; i < 12; i++) {
    const leaf = document.createElement("div");
    leaf.textContent = leaves[Math.floor(Math.random() * leaves.length)];
    const size = 14 + Math.random() * 12;
    leaf.style.cssText = `position:absolute;font-size:${size}px;left:-50px;top:${20+Math.random()*60}%;opacity:0;user-select:none;`;
    layer.appendChild(leaf);
    leaf.animate(
      [
        { transform: `translate(0,0) rotate(0deg)`, opacity: 0 },
        { transform: `translate(40vw,${Math.random()*60-30}px) rotate(${180+Math.random()*180}deg)`, opacity: 0.8, offset: 0.3 },
        { transform: `translate(80vw,${Math.random()*80-40}px) rotate(${360+Math.random()*360}deg)`, opacity: 0.6, offset: 0.7 },
        { transform: `translate(120vw,${Math.random()*100-50}px) rotate(${540+Math.random()*360}deg)`, opacity: 0 }
      ],
      { duration: 3000 + Math.random() * 3000, delay: Math.random() * 6000, easing: "linear", fill: "forwards" }
    );
  }
  const rippleCtn = document.createElement("div");
  rippleCtn.style.cssText = "position:fixed;bottom:0;left:0;width:100%;height:60px;overflow:hidden;";
  layer.appendChild(rippleCtn);
  for (let i = 0; i < 30; i++) {
    setTimeout(() => {
      if (!layer.parentElement) return;
      const ripple = document.createElement("div");
      const sz = 10 + Math.random() * 30;
      ripple.style.cssText = `position:absolute;bottom:0;left:${Math.random()*100}%;width:${sz}px;height:${sz}px;border:1.5px solid hsla(200,50%,70%,0.4);border-radius:50%;transform:scale(0);animation:${id}ripple ${0.8+Math.random()*0.4}s ease-out forwards;`;
      rippleCtn.appendChild(ripple);
      setTimeout(() => ripple.remove(), 1300);
    }, 1500 + Math.random() * 7500);
  }
  setTimeout(() => {
    setTimeout(() => layer.remove(), 800);
  }, 10000);
blackholeEffect(name) =>
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const _bhLabel = document.createElement("div");
  _bhLabel.textContent = "\u{1F573}\u{FE0F} Triggered by: " + (name || "Admin");
  _bhLabel.style.cssText = "position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(0,0,0,0.8);color:#ffaa00;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #ffaa00;box-shadow:0 0 10px #ffaa00;text-shadow:0 0 6px #ffaa00;pointer-events:none;white-space:nowrap;";
  layer.appendChild(_bhLabel);
  const id = "bh" + Date.now();
  const cx = window.innerWidth / 2;
  const cy = window.innerHeight / 2;
  const bhSize = Math.min(window.innerWidth, window.innerHeight) * 0.12;
  const maxRadius = Math.max(window.innerWidth, window.innerHeight) * 0.8;
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}fadeIn { from{opacity:0;} to{opacity:1;} }
    @keyframes ${id}fadeOut { from{opacity:1;} to{opacity:0;} }
    @keyframes ${id}warpIn { 0%{transform:scale(0) rotate(0deg);opacity:0;} 60%{transform:scale(1.2) rotate(180deg);opacity:1;} 100%{transform:scale(1) rotate(360deg);opacity:1;} }
    @keyframes ${id}diskSpin { to { transform: translate(-50%,-50%) rotate(360deg); } }
    @keyframes ${id}diskSpinR { to { transform: translate(-50%,-50%) rotate(-360deg); } }
    @keyframes ${id}diskPulse { 0%,100%{opacity:0.85;filter:blur(3px) brightness(1);} 50%{opacity:1;filter:blur(2px) brightness(1.3);} }
    @keyframes ${id}ringExpand { 0%{transform:translate(-50%,-50%) scale(0);opacity:0.8;} 50%{opacity:0.4;} 100%{transform:translate(-50%,-50%) scale(3);opacity:0;} }
    @keyframes ${id}photonRing { 0%{transform:translate(-50%,-50%) rotate(0deg) scale(1);opacity:0.9;} 50%{transform:translate(-50%,-50%) rotate(180deg) scale(1.05);opacity:1;} 100%{transform:translate(-50%,-50%) rotate(360deg) scale(1);opacity:0.9;} }
    @keyframes ${id}jetPulse { 0%,100%{opacity:0.3;transform:translateX(-50%) scaleY(1);} 50%{opacity:0.6;transform:translateX(-50%) scaleY(1.15);} }
    @keyframes ${id}starTwinkle { 0%,100%{opacity:0.3;} 50%{opacity:1;} }
    @keyframes ${id}vignette { 0%{opacity:0;} 30%{opacity:0.6;} 100%{opacity:0.85;} }
    @keyframes ${id}implosion { 0%{transform:scale(1);opacity:1;} 70%{transform:scale(0.3);opacity:1;} 100%{transform:scale(0);opacity:0;} }
    @keyframes ${id}shockwave { 0%{transform:translate(-50%,-50%) scale(1);opacity:0;border-width:20px;} 50%{opacity:0.6;border-width:5px;} 100%{transform:translate(-50%,-50%) scale(8);opacity:0;border-width:1px;} }
  `;
  layer.appendChild(styleEl);

  // dark vignette / gravitational dimming
  const vignette = document.createElement("div");
  vignette.style.cssText = `position:fixed;inset:0;background:radial-gradient(circle at ${cx}px ${cy}px,transparent 15%,rgba(0,0,0,0.4) 50%,rgba(0,0,0,0.85) 100%);animation:${id}vignette 3s ease-in forwards;`;
  layer.appendChild(vignette);

  // main black hole container
  const bhCtn = document.createElement("div");
  bhCtn.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:${bhSize}px;height:${bhSize}px;animation:${id}warpIn 1.5s cubic-bezier(0.16,1,0.3,1) forwards;`;
  layer.appendChild(bhCtn);

  // gravitational lensing ring (photon sphere)
  const photonRing = document.createElement("div");
  photonRing.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*1.6}px;height:${bhSize*1.6}px;border-radius:50%;border:2px solid hsla(45,100%,80%,0.6);box-shadow:0 0 20px hsla(40,100%,60%,0.5),inset 0 0 20px hsla(30,100%,50%,0.3);animation:${id}photonRing 4s linear infinite;`;
  bhCtn.appendChild(photonRing);

  // outer accretion disk (large, diffuse, orange-red)
  const disk1 = document.createElement("div");
  disk1.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*4}px;height:${bhSize*1.0}px;border-radius:50%;background:conic-gradient(from 0deg,transparent 0%,hsla(15,100%,50%,0.5) 10%,hsla(30,100%,65%,0.7) 25%,hsla(45,100%,75%,0.8) 40%,hsla(20,100%,55%,0.6) 55%,transparent 70%,hsla(200,80%,50%,0.3) 85%,transparent 100%);filter:blur(6px);animation:${id}diskSpin 6s linear infinite,${id}diskPulse 3s ease-in-out infinite;`;
  bhCtn.appendChild(disk1);

  // inner accretion disk (tighter, hotter, white-yellow)
  const disk2 = document.createElement("div");
  disk2.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*2.8}px;height:${bhSize*0.7}px;border-radius:50%;background:conic-gradient(from 90deg,transparent,hsla(45,100%,85%,0.9),hsla(55,100%,95%,1),hsla(35,100%,75%,0.8),transparent,hsla(190,70%,50%,0.4),transparent);filter:blur(2px);animation:${id}diskSpinR 3s linear infinite;`;
  bhCtn.appendChild(disk2);

  // event horizon (pure black core with subtle edge glow)
  const eventHorizon = document.createElement("div");
  eventHorizon.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*0.8}px;height:${bhSize*0.8}px;border-radius:50%;background:radial-gradient(circle,#000 50%,rgba(0,0,0,0.9) 80%,transparent 100%);box-shadow:0 0 ${bhSize*0.5}px hsla(30,100%,50%,0.4),inset 0 0 ${bhSize*0.3}px #000;`;
  bhCtn.appendChild(eventHorizon);

  // relativistic jets (top and bottom)
  const jetTop = document.createElement("div");
  jetTop.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*0.3}px;height:${bhSize*3}px;background:linear-gradient(to top,hsla(200,80%,70%,0.5),hsla(180,100%,90%,0.3),transparent);border-radius:50%;filter:blur(4px);transform:translateX(-50%) translateY(-100%);animation:${id}jetPulse 2s ease-in-out infinite;`;
  bhCtn.appendChild(jetTop);
  const jetBottom = document.createElement("div");
  jetBottom.style.cssText = `position:absolute;left:50%;top:50%;width:${bhSize*0.3}px;height:${bhSize*3}px;background:linear-gradient(to bottom,hsla(200,80%,70%,0.5),hsla(180,100%,90%,0.3),transparent);border-radius:50%;filter:blur(4px);transform:translateX(-50%);animation:${id}jetPulse 2s ease-in-out infinite;`;
  bhCtn.appendChild(jetBottom);

  // background star field that gets lensed/sucked in
  const stars = [];
  for (let i = 0; i < 120; i++) {
    const star = document.createElement("div");
    const ang = Math.random() * Math.PI * 2;
    const dist = bhSize * 2 + Math.random() * maxRadius;
    const sz = 1 + Math.random() * 2.5;
    const hue = 180 + Math.random() * 80;
    star.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:${sz}px;height:${sz}px;border-radius:50%;background:hsla(${hue},80%,85%,${0.3 + Math.random() * 0.5});box-shadow:0 0 ${sz*2}px hsla(${hue},80%,70%,0.4);transform:translate(-50%,-50%);animation:${id}starTwinkle ${1+Math.random()*3}s ease-in-out infinite ${Math.random()*2}s;`;
    layer.appendChild(star);
    stars.push({
      el: star,
      ang,
      dist,
      angSpeed: (0.008 + Math.random() * 0.025) * (Math.random() < 0.5 ? 1 : -1),
      distSpeed: 30 + Math.random() * 80,
      sz,
      hue
    });
  }

  // orbiting debris
  const debrisEmojis = ["🍂","🪨","📰","🪵","🌾","🍃","📦","🧹","🧱","🪶","🥫","🕷️","🪟","🚪","🪣","🥄","🔪","🪓","🔨","🔧","🧲","💡","🪲","🦴","🧦","🎩","🪑","🛞","⛏️","⭐","🌠","☄️","🪐","🌑","💫","✨","🔥","💥","⚡","🌌"];
  const captured = [];
  let bhActive = true;

  function spawnDebris() {
    if (!bhActive) return;
    const item = document.createElement("div");
    item.textContent = debrisEmojis[Math.floor(Math.random() * debrisEmojis.length)];
    const size = 14 + Math.random() * 22;
    const ang = Math.random() * Math.PI * 2;
    const dist = maxRadius * (0.5 + Math.random() * 0.5);
    const startX = cx + Math.cos(ang) * dist;
    const startY = cy + Math.sin(ang) * dist;
    item.style.cssText = `position:fixed;left:0;top:0;font-size:${size}px;opacity:0;user-select:none;z-index:99999;will-change:transform;transform:translate(${startX}px,${startY}px);`;
    layer.appendChild(item);
    captured.push({
      el: item,
      ang,
      dist,
      angSpeed: (0.012 + Math.random() * 0.035) * (Math.random() < 0.5 ? 1 : -1),
      distSpeed: 60 + Math.random() * 140,
      spin: Math.random() * 360,
      spinSpeed: (Math.random() - 0.5) * 12,
      opacity: 0,
      fadeRate: 2 + Math.random() * 2,
    });
  }
  const spawnInterval = setInterval(spawnDebris, 120);

  // periodic shockwave rings
  function spawnShockwave() {
    if (!bhActive) return;
    const ring = document.createElement("div");
    ring.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:${bhSize*2}px;height:${bhSize*2}px;border-radius:50%;border:15px solid hsla(40,100%,60%,0.5);transform:translate(-50%,-50%) scale(1);animation:${id}shockwave 3s ease-out forwards;`;
    layer.appendChild(ring);
    setTimeout(() => ring.remove(), 3500);
  }
  const shockInterval = setInterval(spawnShockwave, 2500);
  setTimeout(spawnShockwave, 500);

  // main animation loop
  function rafLoop() {
    if (!bhActive) return;
    for (let i = stars.length - 1; i >= 0; i--) {
      const s = stars[i];
      s.dist -= s.distSpeed / 60;
      s.ang += s.angSpeed;
      if (s.dist < bhSize * 0.4) {
        s.el.remove();
        stars.splice(i, 1);
        continue;
      }
      const x = cx + Math.cos(s.ang) * s.dist;
      const y = cy + Math.sin(s.ang) * s.dist * 0.35;
      const stretch = Math.max(1, (s.dist / maxRadius) * 3);
      const opacity = Math.min(1, s.dist / (bhSize * 3));
      s.el.style.transform = `translate(-50%,-50%) translate(${x - cx}px,${y - cy}px) scaleY(${stretch})`;
      s.el.style.opacity = opacity;
    }
    for (let i = captured.length - 1; i >= 0; i--) {
      const c = captured[i];
      c.dist -= c.distSpeed / 60;
      c.ang += c.angSpeed;
      c.spin += c.spinSpeed;
      if (c.opacity < 1 && c.fadeRate > 0) c.opacity = Math.min(1, c.opacity + c.fadeRate / 60);
      if (c.dist < bhSize * 0.35) {
        c.opacity -= 0.1;
        if (c.opacity <= 0) {
          c.el.remove();
          captured.splice(i, 1);
          continue;
        }
      }
      const x = cx + Math.cos(c.ang) * c.dist;
      const y = cy + Math.sin(c.ang) * c.dist * 0.35;
      const scale = Math.max(0.15, c.dist / maxRadius);
      c.el.style.opacity = c.opacity;
      c.el.style.transform = `translate(${x}px,${y}px) rotate(${c.spin}deg) scale(${scale})`;
    }
    requestAnimationFrame(rafLoop);
  }
  rafLoop();

  // dramatic implosion finale
  setTimeout(() => {
    bhActive = false;
    clearInterval(spawnInterval);
    clearInterval(shockInterval);
    // final shockwave
    const finalRing = document.createElement("div");
    finalRing.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:${bhSize*2}px;height:${bhSize*2}px;border-radius:50%;border:20px solid hsla(45,100%,70%,0.8);transform:translate(-50%,-50%) scale(1);animation:${id}shockwave 2s ease-out forwards;`;
    layer.appendChild(finalRing);
    // implode
    bhCtn.style.animation = `${id}implosion 1.5s cubic-bezier(0.7,0,0.84,0) forwards`;
    // fade stars and debris
    for (const s of stars) { s.el.style.transition = "opacity 0.8s ease"; s.el.style.opacity = "0"; }
    for (const c of captured) { c.el.style.transition = "opacity 0.5s ease"; c.el.style.opacity = "0"; }
    vignette.style.transition = "opacity 1s ease";
    vignette.style.opacity = "0";
    setTimeout(() => layer.remove(), 2000);
  }, 10000);

abstractionEffect(name) =>
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const id = "abs" + Date.now();
  const W = window.innerWidth, H = window.innerHeight;
  const cx = W / 2, cy = H / 2;
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}chunkIn { 0%{transform:scale(0) rotate(0deg);opacity:0;} 60%{opacity:1;} 100%{transform:scale(1) rotate(var(--rot));opacity:1;} }
    @keyframes ${id}chunkOut { from{transform:scale(1) rotate(var(--rot));opacity:1;} to{transform:scale(0) rotate(var(--rot));opacity:0;} }
    @keyframes ${id}jitter { 0%,100%{transform:translate(0,0) rotate(var(--rot));} 10%{transform:translate(-4px,3px) rotate(var(--rot));} 20%{transform:translate(3px,-2px) rotate(var(--rot));} 30%{transform:translate(-2px,4px) rotate(var(--rot));} 40%{transform:translate(4px,1px) rotate(var(--rot));} 50%{transform:translate(-3px,-3px) rotate(var(--rot));} 60%{transform:translate(2px,3px) rotate(var(--rot));} 70%{transform:translate(-4px,-1px) rotate(var(--rot));} 80%{transform:translate(3px,4px) rotate(var(--rot));} 90%{transform:translate(-1px,-4px) rotate(var(--rot));} }
    @keyframes ${id}pulse { 0%,100%{filter:brightness(1) contrast(1);} 50%{filter:brightness(1.4) contrast(1.5);} }
    @keyframes ${id}eyeOpen { 0%{transform:scaleY(0);opacity:0;} 40%{transform:scaleY(0.3);opacity:0.6;} 100%{transform:scaleY(1);opacity:1;} }
    @keyframes ${id}eyeBlink { 0%,88%,100%{transform:scaleY(1);} 92%{transform:scaleY(0.1);} 96%{transform:scaleY(1);} }
    @keyframes ${id}eyeDart { 0%,100%{transform:translate(0,0);} 20%{transform:translate(3px,-2px);} 40%{transform:translate(-3px,2px);} 60%{transform:translate(2px,3px);} 80%{transform:translate(-2px,-3px);} }
    @keyframes ${id}colorShift { 0%{filter:hue-rotate(0deg) saturate(1.5);} 50%{filter:hue-rotate(180deg) saturate(2);} 100%{filter:hue-rotate(360deg) saturate(1.5);} }
    @keyframes ${id}tearSlide { 0%{opacity:0;transform:translateX(0);} 20%{opacity:0.7;} 100%{opacity:0;transform:translateX(var(--slide));} }
    @keyframes ${id}voidGrow { 0%{transform:translate(-50%,-50%) scale(0);opacity:0;} 40%{opacity:1;} 100%{transform:translate(-50%,-50%) scale(1);opacity:1;} }
    @keyframes ${id}voidPulse { 0%,100%{filter:brightness(0.8) blur(2px);} 50%{filter:brightness(1.2) blur(4px);} }
    @keyframes ${id}voidClose { 0%{transform:translate(-50%,-50%) scale(1);opacity:1;} 60%{transform:translate(-50%,-50%) scale(0.3);opacity:1;} 100%{transform:translate(-50%,-50%) scale(0);opacity:0;} }
    @keyframes ${id}bigEyeOpen { 0%{transform:translate(-50%,-50%) scaleY(0);opacity:0;} 30%{transform:translate(-50%,-50%) scaleY(0.2);opacity:0.5;} 100%{transform:translate(-50%,-50%) scaleY(1);opacity:1;} }
    @keyframes ${id}bigEyeClose { 0%{transform:translate(-50%,-50%) scaleY(1);opacity:1;} 100%{transform:translate(-50%,-50%) scaleY(0);opacity:0;} }
    @keyframes ${id}screenTear { 0%{transform:translateX(0);} 25%{transform:translateX(var(--tear));} 50%{transform:translateX(0);} 75%{transform:translateX(calc(var(--tear) * -1));} 100%{transform:translateX(0);} }
    @keyframes ${id}staticNoise { 0%,100%{opacity:0.05;} 50%{opacity:0.15;} }
    @keyframes ${id}flash { 0%{opacity:0;} 10%{opacity:0.9;} 20%{opacity:0;} 100%{opacity:0;} }
    @keyframes ${id}finalFlash { 0%{opacity:0;} 50%{opacity:1;} 100%{opacity:0;} }
    @keyframes ${id}labelGlitch { 0%,100%{transform:translateX(-50%) skewX(0deg);text-shadow:0 0 8px #ff00ff,0 0 4px #00ffff;} 25%{transform:translateX(-50%) skewX(5deg);text-shadow:-3px 0 #ff0000,3px 0 #00ffff;} 75%{transform:translateX(-50%) skewX(-5deg);text-shadow:3px 0 #ff0000,-3px 0 #00ffff;} }
    @keyframes ${id}vortexSpin { to { transform: translate(-50%,-50%) rotate(360deg); } }
    @keyframes ${id}tentacleWave { 0%,100%{transform:rotate(var(--ang)) scaleY(1);} 50%{transform:rotate(var(--ang)) scaleY(1.3);} }
    @keyframes ${id}suck { to { transform: translate(var(--dx), var(--dy)) scale(0.05) rotate(var(--spin)); opacity: 0; } }
  `;
  layer.appendChild(styleEl);

  const eyeColors = ["#ff0040","#ff8000","#ffe000","#00ff40","#00bfff","#7000ff","#ff00ff","#ffffff","#00ffff","#ff0080"];

  // full-screen static noise overlay
  const noiseC = document.createElement("canvas");
  noiseC.width = 200; noiseC.height = 200;
  const nctx = noiseC.getContext("2d");
  const nImg = nctx.createImageData(200, 200);
  function refreshNoise() {
    for (let i = 0; i < nImg.data.length; i += 4) { const v = Math.random()*255|0; nImg.data[i]=v; nImg.data[i+1]=v; nImg.data[i+2]=v; nImg.data[i+3]=Math.random()*50; }
    nctx.putImageData(nImg, 0, 0);
  }
  refreshNoise();
  const noiseOverlay = document.createElement("div");
  noiseOverlay.style.cssText = `position:fixed;inset:0;background-image:url(${noiseC.toDataURL()});background-size:200px 200px;mix-blend-mode:screen;animation:${id}staticNoise 0.1s steps(1) infinite;pointer-events:none;z-index:99999;`;
  layer.appendChild(noiseOverlay);

  // screen tear bars (RGB-split horizontal slices)
  const tearBars = [];
  for (let i = 0; i < 8; i++) {
    const tb = document.createElement("div");
    const th = 10 + Math.random() * 40;
    const ty = Math.random() * 100;
    tb.style.cssText = `position:fixed;left:0;top:${ty}%;width:100%;height:${th}px;background:hsla(${Math.random()*360},80%,50%,0.08);--tear:${Math.random()*40-20}px;animation:${id}screenTear ${0.2+Math.random()*0.4}s steps(2) infinite;animation-delay:${Math.random()*2}s;z-index:99999;pointer-events:none;mix-blend-mode:screen;`;
    layer.appendChild(tb);
    tearBars.push(tb);
  }

  // initial white flash
  const flash = document.createElement("div");
  flash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}flash 0.5s ease-out forwards;z-index:100000;pointer-events:none;`;
  layer.appendChild(flash);

  // central void rift
  const voidCtn = document.createElement("div");
  voidCtn.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:${Math.min(W,H)*0.5}px;height:${Math.min(W,H)*0.5}px;animation:${id}voidGrow 2s cubic-bezier(0.16,1,0.3,1) forwards;`;
  layer.appendChild(voidCtn);

  // swirling vortex inside the void
  const vortex = document.createElement("div");
  vortex.style.cssText = `position:absolute;left:50%;top:50%;width:100%;height:100%;border-radius:50%;background:conic-gradient(from 0deg, transparent, rgba(128,0,255,0.3), rgba(0,255,255,0.2), transparent, rgba(255,0,128,0.3), transparent);animation:${id}vortexSpin 4s linear infinite;`;
  voidCtn.appendChild(vortex);

  // dark void core
  const voidCore = document.createElement("div");
  voidCore.style.cssText = `position:absolute;left:50%;top:50%;width:80%;height:80%;border-radius:50%;background:radial-gradient(circle, #000 20%, #050005 50%, transparent 80%);box-shadow:0 0 60px rgba(128,0,255,0.3);animation:${id}voidPulse 3s ease-in-out infinite;transform:translate(-50%,-50%);`;
  voidCtn.appendChild(voidCore);

  // giant central eye that tracks the mouse
  const bigEyeWrap = document.createElement("div");
  bigEyeWrap.style.cssText = `position:absolute;left:50%;top:50%;opacity:0;animation:${id}bigEyeOpen 1.5s 1.5s cubic-bezier(0.2,0.8,0.4,1) forwards;`;
  voidCtn.appendChild(bigEyeWrap);
  const bigEye = document.createElement("div");
  const bec = eyeColors[Math.floor(Math.random() * eyeColors.length)];
  const bec2 = eyeColors[Math.floor(Math.random() * eyeColors.length)];
  const beSize = Math.min(W,H) * 0.18;
  bigEye.style.cssText = `position:absolute;left:${-beSize/2}px;top:${-beSize/2}px;width:${beSize}px;height:${beSize*0.6}px;border-radius:50%;background:radial-gradient(ellipse at center, ${bec} 0%, ${bec2} 50%, transparent 90%);box-shadow:0 0 40px ${bec},0 0 80px ${bec}80;overflow:hidden;animation:${id}colorShift 3s linear infinite;`;
  bigEyeWrap.appendChild(bigEye);
  const bigPupil = document.createElement("div");
  const bps = beSize * 0.3;
  bigPupil.style.cssText = `position:absolute;left:50%;top:50%;width:${bps}px;height:${bps}px;margin-left:${-bps/2}px;margin-top:${-bps/2}px;border-radius:50%;background:#000;box-shadow:0 0 8px #000,inset 0 0 6px #fff;`;
  bigEye.appendChild(bigPupil);
  const bigGlint = document.createElement("div");
  bigGlint.style.cssText = `position:absolute;left:30%;top:20%;width:${bps*0.3}px;height:${bps*0.3}px;border-radius:50%;background:rgba(255,255,255,0.9);`;
  bigPupil.appendChild(bigGlint);

  // tentacle-like tendrils radiating from the void
  const tendrils = [];
  for (let i = 0; i < 10; i++) {
    const ang = (i / 10) * 360;
    const tend = document.createElement("div");
    const tw = 8 + Math.random() * 12;
    const tl = 60 + Math.random() * 120;
    tend.style.cssText = `position:absolute;left:50%;top:50%;width:${tw}px;height:${tl}px;margin-left:${-tw/2}px;margin-top:${-tl}px;background:linear-gradient(to top, transparent, hsla(${Math.random()*360},80%,50%,0.4), transparent);border-radius:50%;--ang:${ang}deg;transform:rotate(${ang}deg);transform-origin:bottom center;animation:${id}tentacleWave ${1+Math.random()*2}s ease-in-out infinite ${Math.random()*1}s;`;
    voidCtn.appendChild(tend);
    tendrils.push(tend);
  }

  function genSpikyClip(numSpikes) {
    const pts = [];
    for (let i = 0; i < numSpikes * 2; i++) {
      const ang = (i / (numSpikes * 2)) * Math.PI * 2 - Math.PI / 2;
      const isOuter = i % 2 === 0;
      const r = isOuter ? 46 + Math.random() * 6 : 20 + Math.random() * 16;
      const x = 50 + Math.cos(ang) * r;
      const y = 50 + Math.sin(ang) * r;
      pts.push(`${x.toFixed(1)}% ${y.toFixed(1)}%`);
    }
    return `polygon(${pts.join(", ")})`;
  }

  function makeEye(parent, ex, ey, w, h, delay) {
    const c = eyeColors[Math.floor(Math.random() * eyeColors.length)];
    const c2 = eyeColors[Math.floor(Math.random() * eyeColors.length)];
    const wrap = document.createElement("div");
    wrap.style.cssText = `position:absolute;left:${ex}px;top:${ey}px;width:0;height:0;animation:${id}eyeOpen ${0.4 + Math.random() * 0.5}s ${delay}s cubic-bezier(0.2,0.8,0.4,1) backwards,${id}eyeBlink ${3 + Math.random() * 4}s ${2 + Math.random() * 3}s ease-in-out infinite;`;
    parent.appendChild(wrap);
    const el = document.createElement("div");
    el.style.cssText = `position:absolute;left:${-w/2}px;top:${-h/2}px;width:${w}px;height:${h}px;border-radius:50%;background:radial-gradient(ellipse at center, ${c} 0%, ${c2} 55%, transparent 100%);box-shadow:0 0 ${w*0.8}px ${c},0 0 ${w*1.5}px ${c}80;overflow:hidden;animation:${id}colorShift ${2 + Math.random() * 3}s linear infinite;`;
    wrap.appendChild(el);
    const ps = Math.min(w, h) * 0.4;
    const pupil = document.createElement("div");
    pupil.style.cssText = `position:absolute;left:50%;top:50%;width:${ps}px;height:${ps}px;margin-left:${-ps/2}px;margin-top:${-ps/2}px;border-radius:50%;background:#000;box-shadow:0 0 4px #000,inset 0 0 3px #fff;animation:${id}eyeDart ${1 + Math.random() * 2}s ease-in-out infinite;`;
    el.appendChild(pupil);
    const glint = document.createElement("div");
    glint.style.cssText = `position:absolute;left:30%;top:25%;width:${ps*0.35}px;height:${ps*0.35}px;border-radius:50%;background:rgba(255,255,255,0.8);`;
    pupil.appendChild(glint);
    return { wrap, el };
  }

  function makeChunk(cx, cy, size, rot) {
    const numSpikes = 7 + Math.floor(Math.random() * 5);
    const clip = genSpikyClip(numSpikes);
    const chunk = document.createElement("div");
    chunk.style.cssText = `position:absolute;left:${cx}px;top:${cy}px;width:${size}px;height:${size}px;margin-left:${-size/2}px;margin-top:${-size/2}px;--rot:${rot}deg;animation:${id}chunkIn ${0.6 + Math.random() * 0.4}s ${Math.random() * 0.5}s cubic-bezier(0.2,0.9,0.3,1) forwards,${id}jitter 0.1s steps(1) infinite;`;
    layer.appendChild(chunk);
    const inner = document.createElement("div");
    inner.style.cssText = `position:absolute;inset:0;clip-path:${clip};-webkit-clip-path:${clip};overflow:hidden;`;
    chunk.appendChild(inner);
    const blob = document.createElement("div");
    blob.style.cssText = `position:absolute;inset:0;background:radial-gradient(circle at 40% 40%, #0a0a0a 25%, #000 55%, #050005 80%, transparent 100%);box-shadow:inset 0 0 ${size*0.2}px #000;animation:${id}pulse ${2 + Math.random() * 2}s ease-in-out infinite;`;
    inner.appendChild(blob);
    const cNoiseC = document.createElement("canvas");
    cNoiseC.width = 100; cNoiseC.height = 100;
    const cnCtx = cNoiseC.getContext("2d");
    const cnImg = cnCtx.createImageData(100, 100);
    function refreshCN() {
      for (let i = 0; i < cnImg.data.length; i += 4) { const v = Math.random()*255|0; cnImg.data[i]=v; cnImg.data[i+1]=v; cnImg.data[i+2]=v; cnImg.data[i+3]=Math.random()*50; }
      cnCtx.putImageData(cnImg, 0, 0);
    }
    refreshCN();
    const noiseDiv = document.createElement("div");
    noiseDiv.style.cssText = `position:absolute;inset:0;background-image:url(${cNoiseC.toDataURL()});background-size:100px 100px;opacity:0.25;mix-blend-mode:screen;`;
    inner.appendChild(noiseDiv);
    const numEyes = 2 + Math.floor(Math.random() * 4);
    const chunkEyes = [];
    for (let i = 0; i < numEyes; i++) {
      const ex = size/2 + (Math.random() - 0.5) * size * 0.5;
      const ey = size/2 + (Math.random() - 0.5) * size * 0.5;
      const ew = size * (0.12 + Math.random() * 0.12);
      const eh = ew * (0.5 + Math.random() * 0.3);
      chunkEyes.push(makeEye(inner, ex, ey, ew, eh, 0.4 + Math.random() * 1.2));
    }
    const tearCtn = document.createElement("div");
    tearCtn.style.cssText = `position:absolute;inset:0;overflow:hidden;`;
    inner.appendChild(tearCtn);
    const glow = document.createElement("div");
    glow.style.cssText = `position:absolute;inset:0;clip-path:${clip};-webkit-clip-path:${clip};background:transparent;box-shadow:0 0 ${size*0.2}px rgba(128,0,255,0.25);pointer-events:none;`;
    chunk.appendChild(glow);
    return { chunk, blob, noiseDiv, tearCtn, chunkEyes, noiseC: cNoiseC, refreshN: refreshCN };
  }

  // More chunks scattered all around the screen
  const chunkSize = Math.min(W, H) * 0.2;
  const chunkPositions = [
    { x: chunkSize * 0.55, y: chunkSize * 0.55 },
    { x: W - chunkSize * 0.55, y: chunkSize * 0.55 },
    { x: chunkSize * 0.55, y: H - chunkSize * 0.55 },
    { x: W - chunkSize * 0.55, y: H - chunkSize * 0.55 },
    { x: W * 0.5, y: chunkSize * 0.45 },
    { x: chunkSize * 0.45, y: H * 0.5 },
    { x: W - chunkSize * 0.45, y: H * 0.5 },
    { x: W * 0.2, y: H * 0.25 },
    { x: W * 0.8, y: H * 0.75 },
    { x: W * 0.15, y: H * 0.75 },
    { x: W * 0.85, y: H * 0.25 },
  ];
  const chunks = chunkPositions.map(p => makeChunk(p.x, p.y, chunkSize * (0.6 + Math.random() * 0.5), (Math.random() - 0.5) * 30));

  // track mouse with the big eye pupil
  let mouseX = cx, mouseY = cy;
  const onMove = (e) => { mouseX = e.clientX; mouseY = e.clientY; };
  window.addEventListener("mousemove", onMove);

  let absActive = true;
  function spawnTears() {
    if (!absActive) return;
    chunks.forEach(ch => {
      if (Math.random() < 0.6) {
        const tear = document.createElement("div");
        const th = 2 + Math.random() * 6;
        const w = 20 + Math.random() * 80;
        const gc = eyeColors[Math.floor(Math.random() * eyeColors.length)];
        tear.style.cssText = `position:absolute;left:${-w*0.3}px;top:${Math.random()*100}%;width:${w}px;height:${th}px;background:linear-gradient(90deg,transparent,${gc},transparent);--slide:${30 + Math.random()*80}px;animation:${id}tearSlide ${0.3 + Math.random()*0.4}s linear;`;
        ch.tearCtn.appendChild(tear);
        setTimeout(() => tear.remove(), 500);
      }
    });
  }
  const tearInterval = setInterval(spawnTears, 100);
  const noiseInterval = setInterval(() => {
    if (!absActive) return;
    refreshNoise();
    noiseOverlay.style.backgroundImage = `url(${noiseC.toDataURL()})`;
    chunks.forEach(ch => { ch.refreshN(); ch.noiseDiv.style.backgroundImage = `url(${ch.noiseC.toDataURL()})`; });
  }, 90);

  let glitchFrame = 0;
  function rafLoop() {
    if (!absActive) return;
    glitchFrame++;
    const dx = mouseX - cx;
    const dy = mouseY - cy;
    const dist = Math.sqrt(dx*dx + dy*dy);
    const maxOff = beSize * 0.15;
    const offX = dist > 0 ? (dx / dist) * Math.min(maxOff, dist * 0.05) : 0;
    const offY = dist > 0 ? (dy / dist) * Math.min(maxOff * 0.6, dist * 0.03) : 0;
    bigPupil.style.transform = `translate(${offX}px, ${offY}px)`;
    if (glitchFrame % 25 === 0) {
      chunks.forEach(ch => {
        ch.chunk.style.filter = `hue-rotate(${Math.random()*360}deg) saturate(${1+Math.random()*1.5})`;
        setTimeout(() => ch.chunk.style.filter = "", 50);
      });
    }
    if (glitchFrame % 60 === 0) {
      voidCtn.style.transform = `translate(${(Math.random()-0.5)*20}px, ${(Math.random()-0.5)*20}px)`;
    }
    requestAnimationFrame(rafLoop);
  }
  rafLoop();

  // admin name label
  const label = document.createElement("div");
  label.textContent = "\u{1F441}\u{FE0F} " + (name || "Admin") + " tore reality apart! \u{1F441}\u{FE0F}";
  label.style.cssText = `position:fixed;top:20px;left:50%;font:bold 16px courier;color:#fff;z-index:100001;pointer-events:none;white-space:nowrap;animation:${id}labelGlitch 0.3s steps(1) infinite;`;
  layer.appendChild(label);

  // collapse finale — everything sucked into the void
  setTimeout(() => {
    absActive = false;
    clearInterval(tearInterval);
    clearInterval(noiseInterval);
    window.removeEventListener("mousemove", onMove);
    chunks.forEach(ch => {
      const rect = ch.chunk.getBoundingClientRect();
      const dx = cx - (rect.left + rect.width/2);
      const dy = cy - (rect.top + rect.height/2);
      ch.chunk.style.setProperty("--dx", dx + "px");
      ch.chunk.style.setProperty("--dy", dy + "px");
      ch.chunk.style.setProperty("--spin", (Math.random()*720) + "deg");
      ch.chunk.style.animation = `${id}suck 1s cubic-bezier(0.7,0,0.84,0) forwards`;
      ch.chunkEyes.forEach(e => { e.wrap.style.transition = "opacity 0.3s ease"; e.wrap.style.opacity = "0"; });
    });
    tendrils.forEach(t => { t.style.transition = "height 0.8s ease, opacity 0.8s ease"; t.style.height = "0"; t.style.opacity = "0"; });
    bigEyeWrap.style.animation = `${id}bigEyeClose 0.8s 0.5s ease-in forwards`;
    voidCtn.style.animation = `${id}voidClose 1.2s 0.7s cubic-bezier(0.7,0,0.84,0) forwards`;
    tearBars.forEach(tb => { tb.style.transition = "opacity 0.5s ease"; tb.style.opacity = "0"; });
    noiseOverlay.style.transition = "opacity 0.5s ease"; noiseOverlay.style.opacity = "0";
    label.style.transition = "opacity 0.5s ease"; label.style.opacity = "0";
    const finalFlash = document.createElement("div");
    finalFlash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}finalFlash 0.4s 1.2s ease-out forwards;z-index:100001;pointer-events:none;`;
    layer.appendChild(finalFlash);
    setTimeout(() => layer.remove(), 2000);
  }, 9000);

confettiEffect(name) =>
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const colors = ["#ff0040","#ff8000","#ffe000","#00ff40","#00bfff","#7000ff","#ff00ff","#ffffff"];
  const total = 120;
  const duration = 3000;
  for (let i = 0; i < total; i++) {
    const piece = document.createElement("div");
    const color = colors[Math.floor(Math.random() * colors.length)];
    const size = 6 + Math.random() * 10;
    const isCircle = Math.random() < 0.3;
    piece.style.cssText = `position:absolute;width:${size}px;height:${isCircle ? size : size * (0.4 + Math.random() * 0.4)}px;background:${color};left:${Math.random()*100}%;top:-20px;opacity:${0.8+Math.random()*0.2};border-radius:${isCircle ? "50%" : "1px"};`;
    layer.appendChild(piece);
    const drift = (Math.random() - 0.5) * 300;
    const rot = 360 + Math.random() * 720;
    const delay = Math.random() * 1500;
    piece.animate(
      [
        { transform: "translateY(0) translateX(0) rotate(0deg)", opacity: 1 },
        { transform: `translateY(${window.innerHeight + 40}px) translateX(${drift}px) rotate(${rot}deg)`, opacity: 0.3 }
      ],
      { duration: duration + Math.random() * 2000, delay, easing: "cubic-bezier(0.3,0.7,0.6,1)", fill: "forwards" }
    );
  }
  const label = document.createElement("div");
  label.textContent = "🎉 " + (name || "Admin") + " started a confetti party! 🎉";
  label.style.cssText = "position:fixed;top:20px;left:50%;transform:translateX(-50%);font:bold 16px courier;color:#fff;text-shadow:0 0 8px #ff00ff,0 0 4px #00ffff;z-index:99999;pointer-events:none;white-space:nowrap;";
  layer.appendChild(label);
  setTimeout(() => layer.remove(), 7000);
  
