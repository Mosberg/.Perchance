rainEffect(name) =>
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const _rLabel = document.createElement("div");
  _rLabel.textContent = "\u{1F327}\u{FE0F} Triggered by: " + (name || "Admin");
  _rLabel.style.cssText = "position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(0,0,0,0.8);color:#6ab7ff;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #6ab7ff;box-shadow:0 0 10px #6ab7ff;text-shadow:0 0 6px #6ab7ff;pointer-events:none;white-space:nowrap;";
  layer.appendChild(_rLabel);
  const total = 120;
  const duration = 1200;
  for (let i = 0; i < total; i++) {
    const drop = document.createElement("div");
    const len = 10 + Math.random() * 20;
    drop.style.cssText = `position:absolute;width:2px;height:${len}px;left:${Math.random()*100}%;top:-${len}px;opacity:${0.3+Math.random()*0.5};background:linear-gradient(to bottom, transparent, #6ab7ff);`;
    layer.appendChild(drop);
    const delay = Math.random() * 3000;
    drop.animate(
      [{ transform: `translateY(0)` }, { transform: `translateY(${window.innerHeight + len}px)` }],
      { duration: duration + Math.random() * 800, delay, easing: "linear", fill: "forwards" }
    );
  }
  setTimeout(() => layer.remove(), 6000);

tornadoEffect(name) =>
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const id = "tw" + Date.now();
  const userBadge = document.createElement("div");
  userBadge.textContent = "🌪️ Triggered by: " + (name || "Admin");
  userBadge.style.cssText = "position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(0,0,0,0.8);color:#ff6600;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #ff6600;box-shadow:0 0 10px #ff6600;text-shadow:0 0 6px #ff6600;pointer-events:none;white-space:nowrap;";
  layer.appendChild(userBadge);
  const funH = window.innerHeight;
  const topW = 440;
  const botW = 26;
  const clipPoly = `polygon(0% 0%, 100% 0%, ${(50 + botW/topW*50).toFixed(1)}% 100%, ${(50 - botW/topW*50).toFixed(1)}% 100%)`;
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}wobble { 0%,100%{transform:rotate(-4deg);} 50%{transform:rotate(4deg);} }
    @keyframes ${id}tex { to { background-position: ${topW}px 0, -${topW}px 0; } }
    @keyframes ${id}tex2 { to { background-position: -${topW}px 0, ${topW}px 0; } }
    @keyframes ${id}tex3 { to { background-position: ${topW * 1.5}px 0; } }
    @keyframes ${id}swirlA { to { transform: translateX(-50%) rotate(360deg); } }
    @keyframes ${id}swirlB { to { transform: translateX(-50%) rotate(-360deg); } }
    @keyframes ${id}streak { 0%{opacity:0;transform:translateX(-50%) rotate(var(--a)) scaleX(0.3);} 20%{opacity:0.7;} 80%{opacity:0.5;} 100%{opacity:0;transform:translateX(-50%) rotate(calc(var(--a) + var(--s))) scaleX(1);} }
    @keyframes ${id}dust { 0%,100%{transform:translateX(-50%) scale(1);opacity:0.4;} 50%{transform:translateX(-50%) scale(1.4);opacity:0.65;} }
    @keyframes ${id}suction { 0%{opacity:0;transform:translate(-50%,0) scale(1);} 20%{opacity:0.6;} 100%{opacity:0;transform:translate(-50%,-${funH*0.5}px) scale(0.15);} }
    @keyframes ${id}skyDarken { 0%{opacity:0;} 12%{opacity:0.45;} 85%{opacity:0.4;} 100%{opacity:0;} }
    @keyframes ${id}flash { 0%,100%{opacity:0;} 30%{opacity:0;} 31%{opacity:0.5;} 33%{opacity:0;} 62%{opacity:0;} 63%{opacity:0.7;} 65%{opacity:0;} }
    @keyframes ${id}shake { 0%,100%{transform:translate(0,0);} 25%{transform:translate(-2px,1px);} 50%{transform:translate(2px,-1px);} 75%{transform:translate(-1px,-2px);} }
    @keyframes ${id}warnPulse { 0%,100%{opacity:0.15;} 50%{opacity:0.35;} }
    @keyframes ${id}debrisSpin { to { transform: translateX(-50%) rotate(360deg); } }
  `;
  layer.appendChild(styleEl);
  const skyDarken = document.createElement("div");
  skyDarken.style.cssText = `position:fixed;inset:0;background:linear-gradient(to bottom, hsla(210,30%,10%,0.5), hsla(200,20%,20%,0.3) 40%, transparent 70%);animation:${id}skyDarken 9s ease-in-out forwards;z-index:99997;`;
  layer.appendChild(skyDarken);
  const flash = document.createElement("div");
  flash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}flash 9s linear;z-index:99997;`;
  layer.appendChild(flash);
  const warnVignette = document.createElement("div");
  warnVignette.style.cssText = `position:fixed;inset:0;background:radial-gradient(ellipse at center, transparent 40%, hsla(0,80%,40%,0.3) 100%);animation:${id}warnPulse 1.5s ease-in-out infinite;z-index:99997;`;
  layer.appendChild(warnVignette);
  const funnelWrap = document.createElement("div");
