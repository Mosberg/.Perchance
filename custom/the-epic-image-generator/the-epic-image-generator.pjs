//////////////////////////////////////
        
  defaultCommentOptions // for comments plugin: https://perchance.org/comments-plugin
    adminFlair = 💎!OWNER!💎
    deleteButtonIcon = ❌   
    width = 100%
    height = 400
    commentPlaceholderText = Type a friendly comment...
    submitButtonText = submit comment
    bannedUsers = [bannedUsersList]
    adminPasswordHash = 64c38614675dad8f3eceacdccee80f284f17bdf9d253ed77f6b2ffa904c7506f
    customEmojiSize = 1.5
    loadFonts = Pixelify Sans
    submitButtonSuccessText = COMMENT SUBMITTED!
    fullscreenButtonStyle = background: #0a1a0a; border: 2px solid #00ff66; box-shadow: inset 2px 2px 0px #00FF66, inset -2px -2px 0px #002200, 0 0 6px rgba(0,255,0,0.25); border-radius: 0px; font-family: 'Pixelify Sans', monospace; color: #00ff66; padding: 4px 6px; line-height: 1.15; text-shadow: 0 0 5px #00ff66, 2px 2px 0px #003300; image-rendering: pixelated
    settingsButtonStyle = color: #00ff66; background: rgba(0,20,0,0.3); border: 1px solid #00ff66; box-shadow: inset 1px 1px 0px #003300, inset -1px -1px 0px #001a00; border-radius: 0px; font-family: 'Pixelify Sans', monospace; padding: 4px 6px; line-height: 1.15; text-shadow: 0 0 3px rgba(0,255,0,0.4)
    messageFeedStyle = border-radius: 0px; color: #00ff66; border: 2px solid #00ff66; background-color: rgba(5,10,5,0.5); font-family: 'Pixelify Sans', monospace; box-shadow: inset 2px 2px 0px #001a00, inset -2px -2px 0px #003300, 0 0 5px rgba(0,255,0,0.15)
    messageBubbleStyle = color: #00ff66; background: rgba(0,20,0,0.3); border: 1px solid #00ff66; box-shadow: inset 1px 1px 0px #003300, inset -1px -1px 0px #001a00; border-radius: 0px; font-family: 'Pixelify Sans', monospace; padding: 4px 6px; line-height: 1.15; text-shadow: 0 0 3px rgba(0,255,0,0.4)
    submitButtonStyle = background: #0a1a0a; border: 2px solid #00ff66; box-shadow: inset 2px 2px 0px #00FF66, inset -2px -2px 0px #002200, 0 0 6px rgba(0,255,0,0.25); border-radius: 0px; font-family: 'Pixelify Sans', monospace; color: #00ff66; text-shadow: 0 0 5px #00ff66, 2px 2px 0px #003300; image-rendering: pixelated
    inputAreaStyle = border-radius: 0px; color: #00ff66; border: 2px solid #00ff66; background: rgba(5,10,5,0.7); font-family: 'Pixelify Sans', monospace; box-shadow: inset 2px 2px 0px #001a00, inset -2px -2px 0px #003300, 0 0 5px rgba(0,255,0,0.15); text-shadow: 0 0 3px #00ff66
    customEmojis = {import:the-epic-emoji-list}
    beforeSubmit({inputText}) =>
      let words = bannedWordsList.selectAll.map(item => item.getRawListText);
      let esc = w => w.replace(/[.*+?^${}()|[\]\\]/g, m => "\\" + m);
      let sorted = words.map(esc).sort((a,b) => b.length - a.length);
      let re = new RegExp("\\b(" + sorted.join("|") + ")\\b", "gi");
      let censorEmoji = (window._currentUserNickname === "Jax") ? " :TADC_Censor_Jax: " : " :TADC_Censor: ";
      let replaced = inputText.replace(re, censorEmoji);
      if (replaced === inputText) return;
      return replaced;
    onComment(comment) =>
      if (window?.perchNotifyToggle === false) return
      if (comment.byCurrentUser) {
        if (comment.user?.name) window._currentUserName = comment.user.name;
        if (comment.user?.nickname) window._currentUserNickname = comment.user.nickname;
      }
      if (comment.user && !comment.user.name) comment.user.name = comment.user.nickname || window._currentUserName || "Admin"
      if (/(:awoo:|_awoo_|_awoo:|_awoof:|:awoo_)/i.test(comment.message)) notify("Awoo!");
      const imgMatch = comment.message.match(/https?:\/\/\S+\.(?:png|jpe?g|gif|webp|bmp|svg|avif)(?:\?\S*)?/i);  // Only match image URLs
      if (imgMatch) {
        const uname = comment.user?.nickname || comment.user?.name || window._currentUserName || "Unknown";
        const tag = comment.user?.visualId ? `@${comment.user.visualId}` : "";
        notifyWithImage(`🖼️ Image from ${uname}${tag ? ` (${tag})` : ""}:`, imgMatch[0]);
      }
      if (comment.message.startsWith("Announcement:") && comment.user?.isAdmin)
      notify("🔔 𝗔𝗻𝗻𝗼𝘂𝗻𝗰𝗲𝗺𝗲𝗻𝘁:\n" + comment.message.slice(13).trim())
      if (/\b(user.?ban|troll.?ban|you\s*(are|have)?\s*banned|you're\s*banned|user\s*banned|already\s*banned|ban\s*user)\b/i.test(comment.message) && comment.user?.isAdmin) triggerGlobalRefresh("🛑 A user has been banned! Refresh required.")
      if (/:NEWS:/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) triggerGlobalRefresh("⚡ New feature live! Check #Announcement channel. Refresh to apply.")
      if (/:UPDATE:/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) triggerGlobalRefresh("⚡ New feature live! Check #Announcement channel. Refresh to apply.")
      if (/:animated_refresh:/i.test(comment.message) && comment.user?.isAdmin) triggerGlobalRefresh("⟳︎ Refresh to apply updates.")
      if (/:REFRESH_column1::REFRESH_column2::REFRESH_column3::REFRESH_column4::REFRESH_column5:/m.test(comment.message.normalize("NFC"))) triggerGlobalRefresh("⟳︎ Refresh to apply updates.")
      if (/:BAN:/is.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) triggerGlobalRefresh("🛑 A user has been banned! Refresh required.")
      if (/\blast warning[\s.!?]*$/i.test(comment.message) && comment.user?.isAdmin) notify("⚠️ LAST WARNING!\nSomeone has been warned. Follow the rules.");
      if (/warn/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) notify("⚠️ WARNING!\nSomeone has been warned. Follow the rules.");
      if (/:IGNORE_column1::IGNORE_column2::IGNORE_column3::IGNORE_column4:/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) triggerGlobalRefresh("⊘ IGNORE! Troll has been banned. ⟳︎ Refreash and move on.")
      if (/:ATTENTION_column1::ATTENTION_column2::ATTENTION_column3::ATTENTION_column4::ATTENTION_column5:/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) notify("⚠️ 𝗔𝗧𝗧𝗘𝗡𝗧𝗜𝗢𝗡: A new user has entered the 🔞 chat.\nIf 𝘆𝗼𝘂 𝗮𝗿𝗲 𝘁𝗵𝗮𝘁 𝘂𝘀𝗲𝗿, please 𝗰𝗼𝗻𝘁𝗮𝗰𝘁 𝗮 𝗺𝗼𝗱𝗲𝗿𝗮𝘁𝗼𝗿 𝗻𝗼𝘄 to confirm your age.")
    
      if (/@(?:binarycat111|BinaryCodedCat|Owner)(?:\s|$)/i.test(comment.message)) notify("💎Owner💎 binarycat111 has been summoned!💎");
      if (/@(?:binarycatexe|BinaryCodedCat.EXE|Owner.EXE)(?:\s|$)/i.test(comment.message)) notify("binarycatexe11 Mentioned?👤 and let's not mention that name around here...")
      if (/@(?:thiccberry1)(?:\s|$)/i.test(comment.message)) notify("User thiccberry1 Mentioned?👤")
      if (/@(?:tajred2)(?:\s|$)/i.test(comment.message)) notify("User tajred2 Mentioned?👤")
      if (/@(?:insufferable)(?:\s|$)/i.test(comment.message)) notify("User insufferable Mentioned?👤")
      if (/@(?:proponent2)(?:\s|$)/i.test(comment.message)) notify("User proponent2 Mentioned?👤")
      
      if (/^@news\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        const customMessage = comment.message.replace(/^@news\b\s*/i, "").trim();
        triggerGlobalRefresh("⚡ New feature live! Check #Announcement channel. Refresh to apply.", customMessage || null);
      }
      if (/^@update\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        const customMessage = comment.message.replace(/^@update\b\s*/i, "").trim();
        triggerGlobalRefresh("⚡ New feature live! Check #Announcement channel. Refresh to apply.", customMessage || null);
      }
      if (/^@refresh\b/i.test(comment.message) && comment.user?.isAdmin) {
        const customMessage = comment.message.replace(/^@refresh\b\s*/i, "").trim();
        triggerGlobalRefresh("⟳︎ Refresh to apply updates.", customMessage || null);
      }
      if (/^@ban\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        const reason = comment.message.replace(/^@ban\b\s*/i, "").trim();
        const reasonMessage = reason ? "<b>Ban Reason:</b> " + reason : null;
        triggerGlobalRefresh("🛑 A user has been banned! Refresh required.", reasonMessage);
      }
      if (/^@gm\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) { //gm is short for globalmessage — broadcast via Ably so everyone sees it regardless of channel
        const customMessage = comment.message.replace(/^@gm\b\s*/i, "").trim();
        const gmKey = comment.user?.name + "|" + customMessage;
        const now = Date.now();
        if (!window._gmRecent) window._gmRecent = {};
        if (!window._gmRecent[gmKey] || now - window._gmRecent[gmKey] > 5000) {
          window._gmRecent[gmKey] = now;
          if (window.gmChannel) { window.gmChannel.publish("gm", { text: customMessage, name: comment.user?.name }); }
          else { globalMessage(customMessage, comment.user?.name); } // fallback if Ably not ready yet
        }
      }
      // — — — @vote command (admin starts a poll: @vote Question | Option1 | Option2 | ...) — — —
      if (/^@vote\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        const raw = comment.message.replace(/^@vote\b\s*/i, "").trim();
        const parts = raw.split("|").map(s => s.trim()).filter(Boolean);
        if (parts.length >= 2) {
          const voteData = { question: parts[0], options: parts.slice(1), voteId: "vote_" + Date.now(), name: comment.user?.name || "Admin" };
          window._voteOpened = window._voteOpened || {};
          window._voteOpened[voteData.voteId] = Date.now(); // dedup our own broadcast echo
          if (window.gmChannel) { window.gmChannel.publish("vote_open", voteData); } // broadcast to ALL tabs (global) regardless of comment channel
          if (typeof showVotePopup === "function") showVotePopup(voteData);
        }
      }
      // — — — @voteclose command (admin closes the active vote) — — —
      if (/^@voteclose\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        if (window.gmChannel) { window.gmChannel.publish("vote_close", { name: comment.user?.name || "Admin" }); }
        if (typeof closeVotePopup === "function") closeVotePopup();
      }
      // — — — @countdown command (admin starts a global countdown: @countdown 10 [optional message]) — — —
      if (/^@countdown\b/i.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) {
        const raw = comment.message.replace(/^@countdown\b\s*/i, "").trim();
        const m = raw.match(/^(\d+)\s*(.*)$/);
        if (m) {
          const start = Math.max(1, Math.min(300, parseInt(m[1], 10)));
          const message = (m[2] || "GO!").trim();
          const cdData = { start, message, countdownId: "cd_" + Date.now(), name: comment.user?.name || "Admin" };
          window._countdownShown = window._countdownShown || {};
          window._countdownShown[cdData.countdownId] = Date.now(); // dedup our own broadcast echo
          if (window.gmChannel) { window.gmChannel.publish("countdown_start", cdData); } // broadcast to ALL tabs (global)
          if (typeof showCountdown === "function") showCountdown(cdData);
        }
      }
      // — — — Effect commands (registry-driven: @disco @confetti @fireworks @snow @matrix @hearts ... @allevents) — — —
      if (comment.user?.isAdmin) {
        const normMsg = comment.message.normalize("NFC");
        if (/@\ballevents\b/i.test(normMsg)) dispatchAllEffects(comment.user?.name);
        const reg = fxRegistry();
        for (const cmd in reg) {
          if (new RegExp("@\\b" + cmd + "\\b", "i").test(normMsg)) dispatchEffect(cmd, comment.user?.name);
        }
      }
      if (/IGNORE/m.test(comment.message.normalize("NFC")) && comment.user?.isAdmin) triggerGlobalRefresh("⊘ IGNORE! Troll has been banned. ⟳︎ Refresh and move on.")
    slashCommands
