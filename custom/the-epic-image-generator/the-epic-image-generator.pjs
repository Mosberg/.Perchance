    const cloud = document.createElement("div");
    const w = 200 + Math.random() * 300;
    const h = 80 + Math.random() * 60;
    const left = Math.random() * 100 - 20;
    cloud.style.cssText = `position:absolute;top:${Math.random()*40}%;left:${left}%;width:${w}px;height:${h}px;background:radial-gradient(ellipse at center, hsla(220,15%,15%,0.8), hsla(220,10%,10%,0.6) 60%, transparent 80%);border-radius:50%;filter:blur(15px);animation:${id}cloudDrift ${8+Math.random()*6}s ease-in-out infinite alternate;`;
    cloudCtn.appendChild(cloud);
  }
  const generateLightning = (svg, startX) => {
    const ns = "http://www.w3.org/2000/svg";
    const mainPath = document.createElementNS(ns, "path");
    let d = `M${startX},0`;
    let x = startX, y = 0;
    const points = [];
    while (y < 200) {
      x += (Math.random() - 0.5) * 25;
      y += 10 + Math.random() * 20;
      d += ` L${x.toFixed(1)},${y.toFixed(1)}`;
      if (y < 180 && Math.random() < 0.3) {
        let bx = x, by = y;
        let bd = ` M${bx},${by}`;
        for (let j = 0; j < 3 + Math.floor(Math.random()*4); j++) {
          bx += (Math.random() - 0.3) * 20;
          by += 8 + Math.random() * 15;
          bd += ` L${bx.toFixed(1)},${by.toFixed(1)}`;
        }
        const branch = document.createElementNS(ns, "path");
        branch.setAttribute("d", bd);
        branch.setAttribute("fill", "none");
        branch.setAttribute("stroke", "white");
        branch.setAttribute("stroke-width", "1");
        branch.setAttribute("opacity", "0.6");
        branch.setAttribute("filter", "drop-shadow(0 0 4px #88bbff)");
        svg.appendChild(branch);
      }
    }
    mainPath.setAttribute("d", d);
    mainPath.setAttribute("fill", "none");
    mainPath.setAttribute("stroke", "white");
    mainPath.setAttribute("stroke-width", "2");
    mainPath.setAttribute("filter", "drop-shadow(0 0 8px #aacfff) drop-shadow(0 0 16px #4488ff)");
    svg.appendChild(mainPath);
    return svg;
  };
  const strikeTimes = [1.5 + Math.random()*1.5, 4 + Math.random()*1.5, 6.5 + Math.random()*1.5];
  for (let s = 0; s < 3; s++) {
    const bolt = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    bolt.setAttribute("viewBox", "0 0 100 200");
    bolt.setAttribute("preserveAspectRatio", "none");
    bolt.style.cssText = `position:absolute;top:0;width:${12+Math.random()*8}%;height:${45+Math.random()*25}%;left:${10+Math.random()*75}%;opacity:0;`;
    generateLightning(bolt, 50 + (Math.random()-0.5)*20);
    layer.appendChild(bolt);
    const t = strikeTimes[s] / 10;
    bolt.animate(
      [
        { opacity: 0 },
        { opacity: 0, offset: t - 0.01 },
        { opacity: 1, offset: t },
        { opacity: 0.2, offset: t + 0.02 },
        { opacity: 0.9, offset: t + 0.03 },
