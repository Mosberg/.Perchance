  const closeBtn = document.createElement("span")
  closeBtn.innerText = "✕"
  closeBtn.style.cursor = "pointer"
  closeBtn.style.color = "#00ff66"
  closeBtn.style.fontSize = "14px"
  closeBtn.style.marginLeft = "auto"
  closeBtn.onclick = () => {
    clearTimeout(timeoutId)
    dismiss()
  }

  notificationBox.appendChild(textSpan)
  notificationBox.appendChild(link)
  notificationBox.appendChild(closeBtn)
  document.body.appendChild(notificationBox)

  const dismiss = () => {
    notificationBox.style.top = "-50px"
    setTimeout(() => notificationBox.remove(), 500)
  }

  let startX = 0, startY = 0
  notificationBox.addEventListener("touchstart", e => {
    startX = e.touches[0].clientX
    startY = e.touches[0].clientY
  })

  notificationBox.addEventListener("touchend", e => {
    const dx = Math.abs(startX - e.changedTouches[0].clientX)
    const dy = Math.abs(startY - e.changedTouches[0].clientY)
    if (dx > 50 || dy > 50) {
      clearTimeout(timeoutId)
      dismiss()
    }
  })

  const timeoutId = setTimeout(() => dismiss(), 8000)

  setTimeout(() => {
    notificationBox.style.top = "20px"
  }, 100)

notifyWithImage(message, url) =>
  const notificationBox = document.createElement("div")
  notificationBox.style.position = "fixed"
  notificationBox.style.top = "-300px"
  notificationBox.style.left = "50%"
  notificationBox.style.transform = "translateX(-50%)"
  notificationBox.style.padding = "10px"
  notificationBox.style.background = "black"
  notificationBox.style.color = "#00ff66"
  notificationBox.style.borderRadius = "8px"
  notificationBox.style.setProperty("border", "2px solid #00ff66")
  notificationBox.style.boxShadow = "0px 4px 10px #00ff66"
  notificationBox.style.fontSize = "14px"
  notificationBox.style.fontFamily = "courier"
  notificationBox.style.zIndex = "99999"
  notificationBox.style.transition = "top 0.5s ease-in-out"
  notificationBox.style.display = "flex"
  notificationBox.style.flexDirection = "column"
  notificationBox.style.alignItems = "center"
  notificationBox.style.gap = "8px"
  notificationBox.style.maxWidth = "90vw"

  const header = document.createElement("div")
  header.style.display = "flex"
  header.style.alignItems = "center"
  header.style.gap = "12px"
  header.style.width = "100%"

  const label = document.createElement("span")
  label.textContent = message

  const link = document.createElement("a")
  link.href = url
  link.target = "_blank"
  link.rel = "noopener noreferrer"
  link.textContent = url
  link.style.color = "#00ffff"
  link.style.textDecoration = "underline"
  link.style.fontSize = "11px"
  link.style.wordBreak = "break-all"
  link.style.flex = "1"

  const closeBtn = document.createElement("span")
  closeBtn.innerText = "✕"
  closeBtn.style.cursor = "pointer"
  closeBtn.style.color = "#00ff66"
  closeBtn.style.fontSize = "14px"
  closeBtn.style.marginLeft = "auto"
  closeBtn.onclick = () => {
    clearTimeout(timeoutId)
    dismiss()
  }

  header.appendChild(label)
  header.appendChild(link)
  header.appendChild(closeBtn)
  notificationBox.appendChild(header)

  const img = document.createElement("img")
  img.src = url
  img.style.maxWidth = "300px"
  img.style.maxHeight = "200px"
  img.style.objectFit = "contain"
  img.style.borderRadius = "4px"
  img.style.filter = "blur(20px)"
  img.style.transition = "filter 0.3s ease"
  img.onerror = () => {
    img.remove()
    unblurBtn.remove()
    const err = document.createElement("div")
    err.textContent = "(image failed to load)"
    err.style.color = "#ff4444"
    err.style.fontSize = "12px"
    notificationBox.appendChild(err)
  }
  notificationBox.appendChild(img)

  const unblurBtn = document.createElement("button")
  unblurBtn.textContent = "👁 Unblur"
  unblurBtn.style.cssText = "padding:4px 12px;font-size:0.85em;background:black;color:#00ff66;border:2px solid #00ff66;border-radius:4px;cursor:pointer;font-family:courier;"
  unblurBtn.onclick = () => {
    img.style.filter = "none"
    unblurBtn.remove()
  }
  notificationBox.appendChild(unblurBtn)
  document.body.appendChild(notificationBox)

  const dismiss = () => {
    notificationBox.style.top = "-300px"
    setTimeout(() => notificationBox.remove(), 500)
  }

  let startX = 0, startY = 0
  notificationBox.addEventListener("touchstart", e => {
    startX = e.touches[0].clientX
    startY = e.touches[0].clientY
  })

  notificationBox.addEventListener("touchend", e => {
    const dx = Math.abs(startX - e.changedTouches[0].clientX)
    const dy = Math.abs(startY - e.changedTouches[0].clientY)
    if (dx > 50 || dy > 50) {
      clearTimeout(timeoutId)
      dismiss()
    }
  })

  const timeoutId = setTimeout(() => dismiss(), 8000)

  setTimeout(() => {
    notificationBox.style.top = "20px"
  }, 100)

globalMessage(rawText, username) =>
  const text = String(rawText || "").trim();
  if (!text) return;
  const name = String(username || "Admin").trim();
  if (!window._emojiMap) window._emojiMap = {};
  let html = String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/:([A-Za-z0-9_]+):/g, (match, name) => {
    return window._emojiMap[name] ? `<img src="${window._emojiMap[name]}" style="max-height:2em;vertical-align:middle;display:inline-block;">` : match;
  });
  const box = document.createElement("div");
  box.style.cssText = `
    position: fixed; top: -200px; left: 50%; transform: translateX(-50%);
    z-index: 99999; transition: top 0.5s ease-in-out, opacity 0.5s ease-in-out;
    opacity: 0; display: flex; flex-direction: column; align-items: stretch;
    max-width: 90vw; min-width: 300px;
  `;
  const header = document.createElement("div");
  header.style.cssText = `
    background: black; color: #00ff66; padding: 8px 20px; border-radius: 8px 8px 0 0;
    font-family: courier; font-size: 13px; text-align: center; font-weight: bold;
    border: 2px solid #00ff66; border-bottom: none; text-shadow: 0 0 8px #00ff66;
    box-shadow: 0 0 12px #00ff66; display: flex; align-items: center; justify-content: center; gap: 8px;
  `;
  header.innerHTML = `<span>📢 GLOBAL MESSAGE</span><span style="opacity:0.7;font-weight:normal;">from ${name}</span>`;
  const body = document.createElement("div");
  body.style.cssText = `
    background: black; color: #00ff66; padding: 14px 24px; border-radius: 0 0 8px 8px;
    font-family: courier; font-size: 15px; text-align: center; line-height: 1.5;
    border: 2px solid #00ff66; border-top: none; text-shadow: 0 0 6px #00ff66; box-shadow: 0 0 12px #00ff66;
    word-wrap: break-word; overflow-wrap: break-word;
  `;
  body.innerHTML = html;
  const closeBtn = document.createElement("div");
  closeBtn.textContent = "✕";
  closeBtn.style.cssText = `position:absolute;top:6px;right:10px;cursor:pointer;color:#00ff66;font-size:13px;opacity:0.6;padding:2px 6px;`;
  closeBtn.onmouseenter = () => closeBtn.style.opacity = "1";
  closeBtn.onmouseleave = () => closeBtn.style.opacity = "0.6";
  box.appendChild(header);
  box.appendChild(body);
  box.appendChild(closeBtn);
  document.body.appendChild(box);
  const dismiss = () => { box.style.top = "-200px"; box.style.opacity = "0"; setTimeout(() => box.remove(), 500); };
  closeBtn.onclick = () => { clearTimeout(timer); dismiss(); };
  let sx = 0, sy = 0;
  box.addEventListener("touchstart", e => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; });
  box.addEventListener("touchend", e => { if (Math.abs(sx - e.changedTouches[0].clientX) > 50 || Math.abs(sy - e.changedTouches[0].clientY) > 50) { clearTimeout(timer); dismiss(); } });
  const timer = setTimeout(() => dismiss(), 15000);
  setTimeout(() => { box.style.top = "30px"; box.style.opacity = "1"; }, 100);

//////////////////////////////////////
//══════════════════════════════════//
//— — —  🎆 FX ENGINE (v2)  — — — —//
//══════════════════════════════════//
//////////////////////////////////////
// Unified registry + dispatch for all  //
// visual effect commands. Adding a new  //
// effect = one entry in fxRegistry() +  //
// one function. Everything else (dedup, //
// broadcast, receive, badge) is shared. //
//////////////////////////////////////

fxRegistry() =>
  return {
    disco:         { fn: discoEffect,        emoji: "🪩",   color: "#ff00ff", cooldown: 10000 },
    confetti:      { fn: confettiEffect,     emoji: "🎉",   color: "#ffeb3b", cooldown: 10000 },
    verityrain:    { fn: verityRain,         emoji: "👁️",  color: "#cc88ff", cooldown: 10000 },
    rain:          { fn: rainEffect,         emoji: "🌧️",  color: "#6ab7ff", cooldown: 6000  },
    tornado:       { fn: tornadoEffect,      emoji: "🌪️",  color: "#ff6600", cooldown: 10000 },
    storm:         { fn: stormEffect,        emoji: "⛈️",  color: "#88ccff", cooldown: 10000 },
    blackhole:     { fn: blackholeEffect,    emoji: "🕳️",  color: "#9b59b6", cooldown: 10000 },
    abstraction:   { fn: abstractionEffect,  emoji: "👁️‍🗨️", color: "#8a2be2", cooldown: 10000 },
    perchancerain: { fn: perchanceRain,      emoji: "🌧️",  color: "#88ccff", cooldown: 10000 },
    ohmypc:        { fn: ohmypcEffect,       emoji: "💻",   color: "#00ff66", cooldown: 11000 },
    realitytear:   { fn: realitytearEffect,  emoji: "🌌",   color: "#ff00ff", cooldown: 10000 },
    fireworks:     { fn: fireworksEffect,    emoji: "🎆",   color: "#ffcc00", cooldown: 10000 },
    snow:          { fn: snowEffect,         emoji: "❄️",   color: "#b3e0ff", cooldown: 10000 },
    matrix:        { fn: matrixEffect,       emoji: "🟢",   color: "#00ff66", cooldown: 10000 },
    hearts:        { fn: heartsEffect,       emoji: "💖",   color: "#ff69b4", cooldown: 10000 },
  };

fxList() =>
  const reg = fxRegistry();
  return Object.keys(reg);

// Sender side: dedup → broadcast via gmChannel (or run locally if no channel) → track on FX bar
dispatchEffect(cmd, source) =>
  const reg = fxRegistry();
  const entry = reg[cmd];
  if (!entry || typeof entry.fn !== "function") return;
  const src = source || "Admin";
  if (!window._fxSent) window._fxSent = {};
  const key = src + "|" + cmd;
  if (window._fxSent[key] && Date.now() - window._fxSent[key] < entry.cooldown) return;
  window._fxSent[key] = Date.now();
  if (window.gmChannel) { window.gmChannel.publish(cmd, { name: src }); }
  else { entry.fn(src); fxBarTrack(cmd, entry.emoji, entry.color, src, entry.cooldown); }

// Receiver side: dedup → run locally → track on FX bar
receiveEffect(cmd, source) =>
  const reg = fxRegistry();
  const entry = reg[cmd];
  if (!entry || typeof entry.fn !== "function") return;
  const src = source || "Admin";
  if (!window._fxRecv) window._fxRecv = {};
  const key = src + "|" + cmd;
  if (window._fxRecv[key] && Date.now() - window._fxRecv[key] < entry.cooldown) return;
  window._fxRecv[key] = Date.now();
  entry.fn(src);
  fxBarTrack(cmd, entry.emoji, entry.color, src, entry.cooldown);

// @allevents — sender: publish each cmd individually (triggers receiveEffect on every tab)
dispatchAllEffects(source) =>
  const reg = fxRegistry();
  const src = source || "Admin";
  if (!window._fxSent) window._fxSent = {};
  const aKey = src + "|allevents";
  if (window._fxSent[aKey] && Date.now() - window._fxSent[aKey] < 10000) return;
  window._fxSent[aKey] = Date.now();
  const cmds = Object.keys(reg);
  cmds.forEach((cmd, i) => setTimeout(() => {
    const e = reg[cmd];
    if (!e || typeof e.fn !== "function") return;
    if (window.gmChannel) { window.gmChannel.publish(cmd, { name: src }); }
    else { e.fn(src); }
  }, i * 100));
  fxBarTrack("allevents", "✨", "#ffffff", src, 10000);

// @allevents — receiver fallback (only fires if "allevents" is published directly)
receiveAllEffects(source) =>
  const reg = fxRegistry();
  const src = source || "Admin";
  Object.keys(reg).forEach((cmd, i) => setTimeout(() => {
    const e = reg[cmd];
    if (e && typeof e.fn === "function") e.fn(src);
  }, i * 100));

// Shared overlay builder — used by new effects (existing effects keep their own overlays)
makeFxOverlay(opts) =>
  const overlay = document.createElement("div");
  overlay.id = opts.id;
  overlay.style.cssText = "position:fixed;inset:0;z-index:99998;pointer-events:none;overflow:hidden;";
  const badge = document.createElement("div");
  badge.textContent = (opts.emoji || "✨") + "  Triggered by: " + (opts.source || "Admin");
  const c = opts.color || "#00ff66";
  badge.style.cssText = "position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(0,0,0,0.85);color:" + c + ";padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid " + c + ";box-shadow:0 0 10px " + c + ";text-shadow:0 0 6px " + c + ";pointer-events:none;white-space:nowrap;";
  overlay.appendChild(badge);
  document.body.appendChild(overlay);
  let dismissed = false;
  const dismiss = () => {
    if (dismissed) return;
    dismissed = true;
    overlay.style.transition = "opacity 0.4s ease";
    overlay.style.opacity = "0";
    setTimeout(() => overlay.remove(), 400);
  };
  document.addEventListener("keydown", function h(e) { if (e.key === "Escape") { dismiss(); document.removeEventListener("keydown", h); } });
  if (opts.duration) setTimeout(dismiss, opts.duration);
  return { overlay, badge, dismiss };

// FX Tracker bar — bottom-right chips showing what's running + who triggered it
fxBarTrack(cmd, emoji, color, source, ttl) =>
  if (!window._fxBar) {
    const bar = document.createElement("div");
    bar.id = "fxBar";
    bar.style.cssText = "position:fixed;bottom:8px;right:8px;z-index:99999;display:flex;flex-direction:column;gap:4px;pointer-events:none;font-family:monospace;font-size:12px;max-width:60vw;";
    document.body.appendChild(bar);
    window._fxBar = bar;
  }
  const chip = document.createElement("div");
  chip.style.cssText = "pointer-events:auto;background:rgba(0,0,0,0.85);color:" + color + ";border:1px solid " + color + ";border-radius:6px;padding:3px 9px;display:flex;align-items:center;gap:6px;box-shadow:0 0 8px " + color + ";text-shadow:0 0 4px " + color + ";cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;";
  chip.innerHTML = "<span>" + emoji + "</span><span>" + (source || "Admin") + "</span><span style='opacity:0.5;font-size:10px;'>✕</span>";
  chip.title = cmd + " — click to dismiss this tracker";
  window._fxBar.appendChild(chip);
  const remove = () => { chip.style.transition = "opacity .3s, transform .3s"; chip.style.opacity = "0"; chip.style.transform = "translateX(20px)"; setTimeout(() => { chip.remove(); if (window._fxBar && !window._fxBar.children.length) { window._fxBar.remove(); window._fxBar = null; } }, 300); };
  chip.onclick = remove;
  setTimeout(remove, ttl || 10000);

//////////////////////////////////////
// — — —  NEW EFFECTS (v2)  — — — —//
//////////////////////////////////////

fireworksEffect(name) =>
  const { overlay, dismiss } = makeFxOverlay({ id: "fireworksOverlay", color: "#ffcc00", emoji: "🎆", source: name, duration: 8000 });
  const canvas = document.createElement("canvas");
  canvas.style.cssText = "position:fixed;inset:0;";
  overlay.appendChild(canvas);
  const ctx = canvas.getContext("2d");
  const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
  resize();
  const onResize = () => resize();
  window.addEventListener("resize", onResize);
  const particles = [];
  const colors = ["#ff0040","#ffcc00","#00ff80","#00bfff","#ff00ff","#ff8000","#ffffff"];
  function burst(x, y) {
    const color = colors[Math.floor(Math.random()*colors.length)];
    const count = 36 + Math.floor(Math.random()*28);
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 * i) / count + Math.random()*0.15;
      const speed = 2 + Math.random()*4.5;
      particles.push({ x, y, vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed, life: 1, color, size: 1.5+Math.random()*2.5 });
    }
  }
  let lastBurst = 0;
  function loop(t) {
    if (!document.getElementById("fireworksOverlay")) { window.removeEventListener("resize", onResize); return; }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (!lastBurst || t - lastBurst > 350 + Math.random()*550) { lastBurst = t; burst(Math.random()*canvas.width, 60 + Math.random()*(canvas.height*0.55)); }
    for (let i = particles.length-1; i >= 0; i--) {
      const p = particles[i];
      p.vy += 0.06; p.vx *= 0.99; p.x += p.vx; p.y += p.vy; p.life -= 0.011;
      if (p.life <= 0) { particles.splice(i,1); continue; }
      ctx.globalAlpha = Math.max(0, p.life);
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(loop);
  }
  burst(canvas.width*0.3, canvas.height*0.3);
  burst(canvas.width*0.7, canvas.height*0.35);
  requestAnimationFrame(loop);

snowEffect(name) =>
  const { overlay, dismiss } = makeFxOverlay({ id: "snowOverlay", color: "#b3e0ff", emoji: "❄️", source: name, duration: 9000 });
  const glyphs = ["❄","❅","❆","✻"];
  for (let i = 0; i < 140; i++) {
    const f = document.createElement("div");
    const size = 6 + Math.random()*14;
    const left = Math.random()*100;
    const dur = 4000 + Math.random()*4500;
    const delay = Math.random()*5000;
    f.textContent = glyphs[Math.floor(Math.random()*glyphs.length)];
    f.style.cssText = "position:fixed;left:" + left + "%;top:-30px;font-size:" + size + "px;color:rgba(255,255,255,0.9);text-shadow:0 0 8px rgba(180,220,255,0.7);pointer-events:none;will-change:transform;";
    overlay.appendChild(f);
    const drift = (Math.random()-0.5)*140;
    const h = window.innerHeight;
    const k = [{ transform: "translateY(0) translateX(0) rotate(0deg)", opacity: 0 }, { transform: "translateY(40px) translateX(" + (drift*0.3) + "px) rotate(90deg)", opacity: 0.9, offset: 0.08 }, { transform: "translateY(" + (h+60) + "px) translateX(" + drift + "px) rotate(" + (360+Math.random()*360) + "deg)", opacity: 0.7, offset: 0.95 }, { transform: "translateY(" + (h+80) + "px) translateX(" + drift + "px) rotate(" + (420+Math.random()*360) + "deg)", opacity: 0 }];
    f.animate(k, { duration: dur, delay, easing: "linear", fill: "forwards" });
    setTimeout(() => f.remove(), dur + delay + 500);
  }

matrixEffect(name) =>
  const { overlay, dismiss } = makeFxOverlay({ id: "matrixOverlay", color: "#00ff66", emoji: "🟢", source: name, duration: 8000 });
  const canvas = document.createElement("canvas");
  canvas.style.cssText = "position:fixed;inset:0;";
  overlay.appendChild(canvas);
  const ctx = canvas.getContext("2d");
  const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; dropsRef.drops = null; };
  const onResize = () => resize();
  window.addEventListener("resize", onResize);
  const dropsRef = { drops: null };
  const chars = "01";
  const fontSize = 16;
  function loop() {
    if (!document.getElementById("matrixOverlay")) { window.removeEventListener("resize", onResize); return; }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (!dropsRef.drops) {
      const cols = Math.max(1, Math.floor(canvas.width / fontSize));
      dropsRef.drops = new Array(cols).fill(1).map(() => Math.random() * canvas.height / fontSize);
    }
    ctx.font = "bold " + fontSize + "px monospace";
    for (let i = 0; i < dropsRef.drops.length; i++) {
      const ch = chars[Math.floor(Math.random()*chars.length)];
      const bright = Math.random() > 0.975;
      ctx.fillStyle = bright ? "#ccffcc" : "#00ff66";
      ctx.fillText(ch, i * fontSize, dropsRef.drops[i] * fontSize);
      if (dropsRef.drops[i] * fontSize > canvas.height && Math.random() > 0.975) dropsRef.drops[i] = 0;
      dropsRef.drops[i]++;
    }
    requestAnimationFrame(loop);
  }
  resize();
  requestAnimationFrame(loop);

heartsEffect(name) =>
  const { overlay, dismiss } = makeFxOverlay({ id: "heartsOverlay", color: "#ff69b4", emoji: "💖", source: name, duration: 8000 });
  const hearts = ["💖","💕","💗","💓","❤️","🩷","💞","💘","🧡","💛","💚","🩵","💙","💜","🤎","🖤","🩶","🤍","🩷","💝","❤️‍🩹"];
  let stopped = false;
  const spawn = () => {
    if (stopped || !document.getElementById("heartsOverlay")) return;
    const h = document.createElement("div");
    h.textContent = hearts[Math.floor(Math.random()*hearts.length)];
    const size = 16 + Math.random()*30;
    h.style.cssText = "position:fixed;left:" + Math.random()*100 + "%;bottom:-40px;font-size:" + size + "px;pointer-events:none;filter:drop-shadow(0 0 6px rgba(255,105,180,0.6));will-change:transform;";
    overlay.appendChild(h);
    const dur = 4000 + Math.random()*3500;
    const drift = (Math.random()-0.5)*120;
    const rot = (Math.random()-0.5)*50;
    const hi = window.innerHeight;
    const k = [{ transform: "translateY(0) translateX(0) rotate(0deg)", opacity: 0 }, { transform: "translateY(-" + (hi*0.4) + "px) translateX(" + (drift*0.5) + "px) rotate(" + rot + "deg)", opacity: 1, offset: 0.25 }, { transform: "translateY(-" + (hi+80) + "px) translateX(" + drift + "px) rotate(" + (rot*1.5) + "deg)", opacity: 0 }];
    h.animate(k, { duration: dur, easing: "ease-out", fill: "forwards" });
    setTimeout(() => h.remove(), dur + 200);
  };
  const iv = setInterval(spawn, 110);
  setTimeout(() => { stopped = true; clearInterval(iv); }, 7600);


discoEffect(name) =>
  if (document.getElementById("discoOverlay")) return;
  const overlay = document.createElement("div");
  overlay.id = "discoOverlay";
  overlay.style.cssText = "position:fixed;inset:0;z-index:99998;pointer-events:none;overflow:hidden;";
  const id = "ds" + Date.now();
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}bgPulse { 0%{filter:hue-rotate(0deg) brightness(0.3);} 50%{filter:hue-rotate(180deg) brightness(0.5);} 100%{filter:hue-rotate(360deg) brightness(0.3);} }
    @keyframes ${id}ballSpin { to { transform: translate(-50%,-50%) rotate(360deg); } }
    @keyframes ${id}ballBob { 0%,100%{top:60px;} 50%{top:80px;} }
    @keyframes ${id}raySweep { 0%{transform:rotate(var(--rot)) scaleY(1);opacity:0.4;} 50%{transform:rotate(calc(var(--rot) + 25deg)) scaleY(1.3);opacity:0.7;} 100%{transform:rotate(calc(var(--rot) + 50deg)) scaleY(1);opacity:0.4;} }
    @keyframes ${id}laser { 0%,100%{opacity:0;} 50%{opacity:1;} }
    @keyframes ${id}laserMove { 0%{transform:rotate(var(--angle));} 100%{transform:rotate(calc(var(--angle) + 360deg));} }
    @keyframes ${id}floorScroll { 0%{background-position:0 0;} 100%{background-position:80px 0;} }
    @keyframes ${id}floorScrollY { 0%{background-position:0 0;} 100%{background-position:0 80px;} }
    @keyframes ${id}eqBar { 0%,100%{height:15%;} 50%{height:100%;} }
    @keyframes ${id}strobe { 0%,92%,100%{opacity:0;} 94%,96%{opacity:0.8;} 98%{opacity:0;} }
    @keyframes ${id}glitterFall { 0%{transform:translateY(-20px) rotate(0deg);opacity:1;} 100%{transform:translateY(100vh) rotate(720deg);opacity:0;} }
    @keyframes ${id}labelGlow { 0%,100%{text-shadow:0 0 8px #ff00ff,0 0 4px #00ffff;} 50%{text-shadow:0 0 20px #ff00ff,0 0 10px #00ffff,0 0 30px #ff0066;} }
    @keyframes ${id}danceFloorTile { 0%{background:hsla(var(--h),100%,50%,0.15);} 50%{background:hsla(calc(var(--h) + 60),100%,60%,0.35);} 100%{background:hsla(calc(var(--h) + 120),100%,50%,0.15);} }
  `;
  overlay.appendChild(styleEl);

  // animated gradient background
  const bg = document.createElement("div");
  bg.style.cssText = `position:fixed;inset:0;background:linear-gradient(135deg,hsla(280,80%,10%,0.4),hsla(200,80%,10%,0.4),hsla(330,80%,10%,0.4));background-size:300% 300%;animation:${id}bgPulse 3s ease-in-out infinite;mix-blend-mode:screen;`;
  overlay.appendChild(bg);

  // strobe flash
  const strobe = document.createElement("div");
  strobe.style.cssText = `position:fixed;inset:0;background:white;animation:${id}strobe 2s linear infinite;mix-blend-mode:overlay;`;
  overlay.appendChild(strobe);

  // disco ball with light rays
  const hanger = document.createElement("div");
  hanger.style.cssText = "position:fixed;top:0;left:50%;transform:translateX(-50%);width:3px;height:55px;background:linear-gradient(#aaa,#555);z-index:99999;";
  overlay.appendChild(hanger);
  const ballCtn = document.createElement("div");
  ballCtn.style.cssText = `position:fixed;left:50%;top:60px;width:100px;height:100px;z-index:99999;transform:translateX(-50%);animation:${id}ballBob 2s ease-in-out infinite;`;
  const ball = document.createElement("div");
  ball.style.cssText = `position:absolute;left:50%;top:50%;width:100px;height:100px;border-radius:50%;background:conic-gradient(from 0deg,#ff0040,#ff8000,#ffe000,#00ff40,#00bfff,#7000ff,#ff0040);box-shadow:0 0 50px rgba(255,255,255,0.5),0 0 90px rgba(128,0,255,0.4);transform:translate(-50%,-50%);animation:${id}ballSpin 2s linear infinite;overflow:hidden;`;
  const tiles = document.createElement("div");
  tiles.style.cssText = "position:absolute;inset:0;border-radius:50%;background-image:repeating-linear-gradient(0deg,transparent 0,transparent 8px,rgba(255,255,255,0.5) 8px,rgba(255,255,255,0.5) 10px),repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(255,255,255,0.4) 8px,rgba(255,255,255,0.4) 10px);mix-blend-mode:overlay;";
  ball.appendChild(tiles);
  const ballShine = document.createElement("div");
  ballShine.style.cssText = "position:absolute;top:10%;left:20%;width:25%;height:25%;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,0.8),transparent 70%);";
  ball.appendChild(ballShine);
  ballCtn.appendChild(ball);
  overlay.appendChild(ballCtn);
  // light rays from ball
  for (let i = 0; i < 8; i++) {
    const ray = document.createElement("div");
    const rot = i * 45;
    ray.style.cssText = `position:absolute;left:50%;top:110px;width:4px;height:60vh;transform-origin:top center;background:linear-gradient(to bottom,hsla(${i*45},100%,60%,0.3),transparent);--rot:${rot}deg;animation:${id}raySweep ${1.5 + Math.random()}s ease-in-out infinite alternate;`;
    ballCtn.appendChild(ray);
  }

  // rotating laser beams from corners
  const corners = [[0,0],[100,0],[0,100],[100,100]];
  const laserColors = ["#ff0040","#00ff80","#00bfff","#ff00ff"];
  corners.forEach((c, ci) => {
    for (let j = 0; j < 2; j++) {
      const laser = document.createElement("div");
      const angle = Math.random() * 360;
      laser.style.cssText = `position:fixed;left:${c[0]}%;top:${c[1]}%;width:2px;height:120vh;transform-origin:top center;background:linear-gradient(to bottom,${laserColors[ci]},transparent);--angle:${angle}deg;animation:${id}laserMove ${2 + Math.random() * 3}s linear infinite ${j * 0.5}s,${id}laser 0.8s ease-in-out infinite ${j * 0.3}s;mix-blend-mode:screen;opacity:0.6;`;
      overlay.appendChild(laser);
    }
  });

  // colored spotlight pools that drift
  const spotlights = [];
  for (let i = 0; i < 6; i++) {
    const sp = document.createElement("div");
    const hue = (i / 6) * 360;
    sp.style.cssText = `position:fixed;width:${250 + Math.random() * 200}px;height:${250 + Math.random() * 200}px;border-radius:50%;background:radial-gradient(circle,hsla(${hue},100%,55%,0.25),transparent 70%);mix-blend-mode:screen;transition:left 1.5s ease-in-out,top 1.5s ease-in-out;`;
    overlay.appendChild(sp);
    spotlights.push({el: sp});
  }

  // checkerboard dance floor
  const floor = document.createElement("div");
  floor.style.cssText = `position:fixed;bottom:0;left:0;right:0;height:35vh;perspective:200px;perspective-origin:50% 0%;overflow:hidden;`;
  const floorGrid = document.createElement("div");
  floorGrid.style.cssText = `position:absolute;inset:0;transform:rotateX(60deg);transform-origin:bottom;background-image:repeating-linear-gradient(0deg,transparent 0,transparent 39px,rgba(255,255,255,0.08) 39px,rgba(255,255,255,0.08) 40px),repeating-linear-gradient(90deg,transparent 0,transparent 39px,rgba(255,255,255,0.08) 39px,rgba(255,255,255,0.08) 40px);background-size:40px 40px;animation:${id}floorScroll 1s linear infinite,${id}floorScrollY 1.5s linear infinite;`;
  floor.appendChild(floorGrid);
  const floorTiles = document.createElement("div");
  floorTiles.style.cssText = `position:absolute;inset:0;transform:rotateX(60deg);transform-origin:bottom;`;
  const tileColors = [];
  for (let row = 0; row < 4; row++) {
    for (let col = 0; col < 20; col++) {
      const tile = document.createElement("div");
      const hue = ((col * 18 + row * 30) % 360);
      tile.style.cssText = `position:absolute;left:${col * 5}%;top:${row * 25}%;width:5%;height:25%;--h:${hue};animation:${id}danceFloorTile ${0.8 + Math.random() * 0.6}s ease-in-out infinite ${Math.random() * 0.5}s;`;
      floorTiles.appendChild(tile);
    }
  }
  floor.appendChild(floorTiles);
  overlay.appendChild(floor);

  // equalizer bars at bottom
  const eqCtn = document.createElement("div");
  eqCtn.style.cssText = "position:fixed;bottom:0;left:0;right:0;height:120px;display:flex;align-items:flex-end;justify-content:center;gap:3px;pointer-events:none;z-index:99999;";
  const numBars = Math.floor(window.innerWidth / 12);
  for (let i = 0; i < numBars; i++) {
    const bar = document.createElement("div");
    const hue = (i / numBars) * 360;
    bar.style.cssText = `flex:1;max-width:10px;background:linear-gradient(to top,hsla(${hue},100%,50%,0.8),hsla(${hue + 60},100%,70%,0.6));border-radius:2px 2px 0 0;animation:${id}eqBar ${0.3 + Math.random() * 0.4}s ease-in-out infinite ${i * 0.03}s;`;
    eqCtn.appendChild(bar);
  }
  overlay.appendChild(eqCtn);

  // falling glitter
  const glitterInterval = setInterval(() => {
    if (!document.getElementById("discoOverlay")) { clearInterval(glitterInterval); return; }
    for (let i = 0; i < 3; i++) {
      const g = document.createElement("div");
      const hue = Math.random() * 360;
      g.style.cssText = `position:fixed;left:${Math.random()*100}%;top:-10px;width:${2+Math.random()*4}px;height:${2+Math.random()*4}px;border-radius:50%;background:hsla(${hue},100%,70%,0.9);box-shadow:0 0 4px hsla(${hue},100%,60%,0.8);animation:${id}glitterFall ${2+Math.random()*3}s linear forwards;`;
      overlay.appendChild(g);
      setTimeout(() => g.remove(), 6000);
    }
  }, 100);

  // label
  const label = document.createElement("div");
  label.textContent = "🪩 " + (name || "Admin") + " started a disco!";
  label.style.cssText = `position:fixed;top:170px;left:50%;transform:translateX(-50%);font:bold 15px courier;color:#fff;z-index:100000;pointer-events:none;white-space:nowrap;animation:${id}labelGlow 1s ease-in-out infinite;`;
  overlay.appendChild(label);

  // click to dismiss
  const dismissCtn = document.createElement("div");
  dismissCtn.style.cssText = "position:fixed;top:60px;left:50%;transform:translateX(-50%);width:100px;height:100px;z-index:100001;cursor:pointer;border-radius:50%;";
  dismissCtn.title = "Click to stop disco";
  overlay.appendChild(dismissCtn);

  document.body.appendChild(overlay);

  // animate spotlights drifting
  const spotInterval = setInterval(() => {
    spotlights.forEach(sp => {
      sp.el.style.left = Math.random() * 100 + "%";
      sp.el.style.top = Math.random() * 80 + "%";
    });
  }, 1500);

  const dismissDisco = () => {
    clearInterval(spotInterval);
    clearInterval(glitterInterval);
    overlay.style.transition = "opacity 0.5s ease";
    overlay.style.opacity = "0";
    setTimeout(() => overlay.remove(), 500);
  };
  dismissCtn.onclick = dismissDisco;
  const dTimer = setTimeout(dismissDisco, 20000);

notifyPinned (rawText) =>
  const text = String(rawText || "").trim() || "Pinned"
  const box  = document.createElement("div")
  box.style.position = "fixed"
  box.style.top = "-50px"
  box.style.left = "50%"
  box.style.transform = "translateX(-50%)"
  box.style.padding = "10px 20px"
  box.style.background = "black"
  box.style.color = "#00ff66"
  box.style.borderRadius = "8px"
  box.style.setProperty("border", "1px solid #00ff66")
  box.style.boxShadow = "0px 4px 10px #00ff66"
  box.style.textShadow = "0px 4px 10px #00ff66"
  box.style.fontSize = "14px"
  box.style.fontFamily = "courier"
  box.style.zIndex = "99999"
  box.style.transition = "top 0.5s ease-in-out"
  box.style.display = "flex"
  box.style.alignItems = "center"
  box.style.gap = "12px"
  box.innerHTML = `<span>📌 Pinned Message: ${text}</span>`

  // close (only close + gesture; no auto-timeout)
  const closeId = "pinClose" + Math.floor(Math.random()*999999)
  const closeBtn = document.createElement("span")
  closeBtn.id = closeId
  closeBtn.innerText = "❌"
  closeBtn.style.cursor = "pointer"
  closeBtn.style.color = "#00ff66"
  closeBtn.style.fontSize = "14px"
  closeBtn.style.marginLeft = "auto"
  closeBtn.onclick = () => dismiss()

  box.appendChild(closeBtn)
  document.body.appendChild(box)

  const dismiss = () => {
    box.style.top = "-50px"
    setTimeout(() => box.remove(), 500)
  }

  // swipe-to-dismiss (same as @all notify)
  let startX = 0, startY = 0
  box.addEventListener("touchstart", e => {
    startX = e.touches[0].clientX
    startY = e.touches[0].clientY
  })
  box.addEventListener("touchend", e => {
    const dx = Math.abs(startX - e.changedTouches[0].clientX)
    const dy = Math.abs(startY - e.changedTouches[0].clientY)
    if (dx > 50 || dy > 50) dismiss()
  })

  // slide in (top-center, like @all)
  setTimeout(() => { box.style.top = "20px" }, 100)  
  
ohmypcEffect(name) =>
  if (document.getElementById("ohmypcOverlay")) return;
  const overlay = document.createElement("div");
  overlay.id = "ohmypcOverlay";
  overlay.style.cssText = "position:fixed;inset:0;z-index:9990;pointer-events:none;overflow:hidden;";
  const audio = new Audio("https://user.uploads.dev/file/d8088e7d8b64ec091629ff2ab5c0006a.mp3");
  audio.volume = 0.8;
  audio.loop = true;
  audio.play().catch(() => {});
  const id = "ohmypc" + Date.now();
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}flicker { 0%{opacity:0;} 50%{opacity:1;} 100%{opacity:0.3;} }
    @keyframes ${id}shake { 0%{transform:translate(0,0);} 25%{transform:translate(-3px,2px);} 50%{transform:translate(2px,-2px);} 75%{transform:translate(-2px,-3px);} 100%{transform:translate(3px,1px);} }
    @keyframes ${id}glitch { 0%{clip-path:inset(0 0 0 0);} 20%{clip-path:inset(20% 0 30% 0);} 40%{clip-path:inset(50% 0 10% 0);} 60%{clip-path:inset(10% 0 60% 0);} 80%{clip-path:inset(40% 0 20% 0);} 100%{clip-path:inset(0 0 0 0);} }
    @keyframes ${id}rgbSplit { 0%,100%{text-shadow:0 0 0 transparent;} 50%{text-shadow:-3px 0 #ff0000,3px 0 #00ffff;} }
    @keyframes ${id}tearSlide { 0%{transform:translateX(0);} 50%{transform:translateX(var(--tear));} 100%{transform:translateX(0);} }
    @keyframes ${id}errPop { 0%{transform:scale(0) rotate(var(--rot));opacity:0;} 60%{transform:scale(1.1) rotate(var(--rot));opacity:1;} 100%{transform:scale(1) rotate(var(--rot));opacity:1;} }
    @keyframes ${id}glitchBlock { 0%{opacity:0;transform:translateY(0);} 10%{opacity:0.8;} 90%{opacity:0.6;} 100%{opacity:0;transform:translateY(var(--gby));} }
    @keyframes ${id}bsod { 0%,88%,100%{opacity:0;} 91%,95%{opacity:1;} }
    @keyframes ${id}crtOff { 0%{transform:scaleY(1) scaleX(1);opacity:1;filter:brightness(1);} 30%{transform:scaleY(1) scaleX(1);opacity:1;filter:brightness(3);} 50%{transform:scaleY(0.01) scaleX(1);opacity:1;filter:brightness(4);} 75%{transform:scaleY(0.01) scaleX(0.03);opacity:1;filter:brightness(4);} 100%{transform:scaleY(0.01) scaleX(0);opacity:0;filter:brightness(4);} }
    @keyframes ${id}scanlineMove { 0%{top:-100%;} 100%{top:100%;} }
    @keyframes ${id}vignettePulse { 0%,100%{opacity:0.3;} 50%{opacity:0.6;} }
  `;
  overlay.appendChild(styleEl);
  const flicker = document.createElement("div");
  flicker.style.cssText = `position:fixed;inset:0;background:rgba(0,80,160,0.15);mix-blend-mode:screen;z-index:9990;pointer-events:none;animation:${id}flicker 0.08s steps(1) infinite;`;
  overlay.appendChild(flicker);
  const scanlines = document.createElement("div");
  scanlines.style.cssText = "position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent 0,transparent 2px,rgba(0,0,0,0.12) 2px,rgba(0,0,0,0.12) 4px);z-index:9990;pointer-events:none;";
  overlay.appendChild(scanlines);
  const movingScan = document.createElement("div");
  movingScan.style.cssText = `position:fixed;left:0;width:100%;height:80px;background:linear-gradient(to bottom,transparent,rgba(0,150,255,0.06),transparent);z-index:9990;pointer-events:none;animation:${id}scanlineMove 4s linear infinite;`;
  overlay.appendChild(movingScan);
  const vignette = document.createElement("div");
  vignette.style.cssText = `position:fixed;inset:0;background:radial-gradient(ellipse at center,transparent 50%,rgba(0,0,0,0.5) 100%);z-index:9990;pointer-events:none;animation:${id}vignettePulse 1.5s ease-in-out infinite;`;
  overlay.appendChild(vignette);
  const bsod = document.createElement("div");
  bsod.style.cssText = `position:fixed;inset:0;background:#0000aa;color:white;font-family:monospace;font-size:14px;padding:40px;z-index:9995;pointer-events:none;display:flex;flex-direction:column;justify-content:center;align-items:center;animation:${id}bsod 7s steps(1) forwards;`;
  bsod.innerHTML = `<div style="font-size:48px;margin-bottom:20px;">:(</div><div style="text-align:center;max-width:500px;">Your PC ran into a problem and needs to restart.<br>We're just collecting some error info, and then we'll restart for you.<br><span style="font-size:12px;">0% complete</span></div><div style="margin-top:30px;font-size:11px;text-align:center;">For more information about this issue and possible fixes, visit<br>https://perchance.org/ohmypc<br>If you call a support person, give them this info:<br>Stop code: TORNADO_IN_THE_MACHINE</div>`;
  bsod.style.opacity = "0";
  overlay.appendChild(bsod);
  for (let i = 0; i < 12; i++) {
    const block = document.createElement("div");
    const w = 40 + Math.random() * 200;
    const h = 4 + Math.random() * 30;
    block.style.cssText = `position:fixed;left:${Math.random()*100}%;top:${Math.random()*100}%;width:${w}px;height:${h}px;background:hsla(${Math.random()*360},80%,50%,0.3);mix-blend-mode:screen;z-index:9991;pointer-events:none;--gby:${Math.random()*200-100}px;animation:${id}glitchBlock ${0.3+Math.random()*0.6}s steps(1) infinite;animation-delay:${Math.random()*2}s;`;
    overlay.appendChild(block);
  }
  for (let i = 0; i < 6; i++) {
    const tear = document.createElement("div");
    const y = Math.random() * 100;
    const h = 20 + Math.random() * 80;
    tear.style.cssText = `position:fixed;left:0;top:${y}%;width:100%;height:${h}px;background:rgba(0,0,0,0);border-top:1px solid rgba(0,255,0,0.3);border-bottom:1px solid rgba(255,0,0,0.2);z-index:9992;pointer-events:none;--tear:${Math.random()*40-20}px;animation:${id}tearSlide ${0.1+Math.random()*0.3}s steps(2) infinite;animation-delay:${Math.random()*1}s;`;
    overlay.appendChild(tear);
  }
  const glitchChars = "01░▒▓█▄▀▌▐╔╗╚╝║═┤├┐└┘┴┬─┼■□●○♦♥♣♠";
  for (let i = 0; i < 20; i++) {
    const txt = document.createElement("div");
    txt.textContent = Array.from({length: 4 + Math.floor(Math.random()*12)}, () => glitchChars[Math.floor(Math.random()*glitchChars.length)]).join("");
    txt.style.cssText = `position:fixed;left:${Math.random()*90}%;top:${Math.random()*90}%;color:hsla(${Math.random()*360},80%,60%,0.5);font-family:monospace;font-size:${10+Math.random()*14}px;z-index:9993;pointer-events:none;mix-blend-mode:screen;text-shadow:1px 0 #f00,-1px 0 #0ff;animation:${id}flicker ${0.05+Math.random()*0.1}s steps(1) infinite;`;
    overlay.appendChild(txt);
  }
  const errorMessages = [
    { title: "System Error", body: "Keyboard not detected.<br>Press F1 to continue.", code: "0xC0000005" },
    { title: "⚠ CRITICAL WARNING", body: "Your computer has been infected by a tornado.<br>Do not panic.", code: "0xDEADBEEF" },
    { title: "Error 404", body: "Brain.exe has stopped responding.<br>Windows is searching for a solution to the problem.", code: "ERR_BRAIN_NOT_FOUND" },
    { title: "⚠️ SYSTEM FAILURE", body: "Something went wrong and everything is on fire.<br>Please remain calm.", code: "ERR_EVERYTHING_IS_FINE" },
    { title: "Windows", body: "Your GPU has left the chat.<br>[OK] [Cancel]", code: "GPU_GHOSTED" },
    { title: "Fatal Exception", body: "The operation completed successfully.<br>But also everything is broken.", code: "0x42" },
    { title: "⚠ ALERT", body: "Detected unauthorized reality breach.<br>Please contact your nearest tornado.", code: "BREACH_77" },
  ];
  const errorWindows = [];
  const spawnError = () => {
    if (!document.getElementById("ohmypcOverlay")) return;
    const msg = errorMessages[Math.floor(Math.random() * errorMessages.length)];
    const win = document.createElement("div");
    win.style.cssText = `position:fixed;left:${5+Math.random()*70}%;top:${5+Math.random()*60}%;width:280px;background:#c0c0c0;border:2px outset #fff;z-index:9994;pointer-events:none;font-family:'Segoe UI',Tahoma,sans-serif;font-size:12px;--rot:${(Math.random()-0.5)*4}deg;animation:${id}errPop 0.25s ease-out forwards;box-shadow:4px 4px 12px rgba(0,0,0,0.5);`;
    win.innerHTML = `<div style="background:#0000aa;color:white;padding:3px 6px;display:flex;justify-content:space-between;font-weight:bold;"><span>${msg.title}</span><span style="cursor:default;">✕</span></div><div style="padding:14px;display:flex;gap:10px;"><div style="font-size:28px;">⚠️</div><div style="flex:1;color:#000;">${msg.body}</div></div><div style="text-align:right;padding:0 10px 10px;"><button style="padding:2px 16px;background:#c0c0c0;border:2px outset #fff;font-size:11px;">OK</button></div><div style="padding:0 10px 8px;font-size:9px;color:#666;">Code: ${msg.code}</div>`;
    overlay.appendChild(win);
    errorWindows.push(win);
    setTimeout(() => { win.style.transition = "opacity 0.3s"; win.style.opacity = "0"; setTimeout(() => win.remove(), 300); }, 2500 + Math.random() * 2000);
  };
  document.body.appendChild(overlay);
  // shake removed to preserve position:fixed behavior
  const userBadge = document.createElement("div");
  userBadge.textContent = "💻 Triggered by: " + (name || "Admin");
  userBadge.style.cssText = "position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:9996;background:black;color:#00ff66;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #00ff66;box-shadow:0 0 10px #00ff66;text-shadow:0 0 6px #00ff66;pointer-events:none;white-space:nowrap;";
  overlay.appendChild(userBadge);
  const glitchEls = [];
  [...document.querySelectorAll("img, video, canvas, iframe")].forEach((el, i) => {
    if (i > 40) return;
    if (overlay.contains(el)) return;
    let node = el;
    while (node && node !== document.body) {
      const cs = getComputedStyle(node);
      if (cs.position === "fixed" && Number(cs.zIndex) >= 9990) return;
      node = node.parentElement;
    }
    glitchEls.push({ el, anim: el.style.animation, filter: el.style.filter, textShadow: el.style.textShadow });
    el.style.animation = `${id}glitch ${0.05 + Math.random() * 0.1}s steps(1) infinite`;
    el.style.filter = `hue-rotate(${Math.random() * 360}deg) saturate(2)`;
    el.style.textShadow = `-2px 0 #ff0000, 2px 0 #00ffff`;
  });
  let freezeTimer = null;
  let freezeCount = 0;
  const startFreeze = () => {
    if (freezeCount >= 4) return;
    freezeCount++;
    const overlay2 = document.getElementById("ohmypcOverlay");
    if (!overlay2) return;
    overlay2.style.background = "rgba(255,255,255,0.15)";
    const freezeDur = 200 + Math.random() * 600;
    freezeTimer = setTimeout(() => {
      const o2 = document.getElementById("ohmypcOverlay");
      if (o2) o2.style.background = "transparent";
      const nextDelay = 1200 + Math.random() * 3500;
      freezeTimer = setTimeout(startFreeze, nextDelay);
    }, freezeDur);
  };
  freezeTimer = setTimeout(startFreeze, 2000 + Math.random() * 3000);
  const errorInterval = setInterval(() => { spawnError(); }, 1500 + Math.random() * 1000);
  let bsodShown = false;
  const bsodTimer = setTimeout(() => { bsodShown = true; spawnError(); spawnError(); spawnError(); }, 4500);
  let dismissed = false;
  const dismissOhmypc = () => {
    if (dismissed) return;
    dismissed = true;
    clearTimeout(freezeTimer);
    clearInterval(errorInterval);
    clearTimeout(bsodTimer);
    audio.pause();
    glitchEls.forEach(g => { g.el.style.animation = g.anim; g.el.style.filter = g.filter; g.el.style.textShadow = g.textShadow; });
    errorWindows.forEach(w => { w.style.transition = "opacity 0.2s"; w.style.opacity = "0"; });
    const crtDiv = document.createElement("div");
    crtDiv.style.cssText = `position:fixed;inset:0;z-index:9997;background:white;pointer-events:none;animation:${id}crtOff 0.5s ease-in forwards;`;
    document.body.appendChild(crtDiv);
    setTimeout(() => { crtDiv.remove(); overlay.remove(); }, 600);
  };
  overlay.dataset.dismiss = "1";
  document.addEventListener("keydown", function escHandler(e) {
    if (e.key === "Escape") { dismissOhmypc(); document.removeEventListener("keydown", escHandler); }
  });
  const autoDismissTimer = setTimeout(dismissOhmypc, 11000);
  audio.addEventListener("error", () => { clearTimeout(autoDismissTimer); setTimeout(dismissOhmypc, 8000); });

realitytearEffect(name) =>
  if (document.getElementById("realitytearOverlay")) return;
  const overlay = document.createElement("div");
  overlay.id = "realitytearOverlay";
  overlay.style.cssText = "position:fixed;inset:0;z-index:9990;pointer-events:none;overflow:hidden;";
  const id = "rt" + Date.now();
  const W = window.innerWidth, H = window.innerHeight;
  const styleEl = document.createElement("style");
  styleEl.textContent = `
    @keyframes ${id}shake { 0%,100%{transform:translate(0,0);} 10%{transform:translate(-4px,2px);} 20%{transform:translate(3px,-3px);} 30%{transform:translate(-2px,4px);} 40%{transform:translate(4px,1px);} 50%{transform:translate(-3px,-2px);} 60%{transform:translate(2px,3px);} 70%{transform:translate(-4px,-1px);} 80%{transform:translate(3px,-4px);} 90%{transform:translate(-1px,2px);} }
    @keyframes ${id}flapL { 0%{transform:translateX(0) skewY(0deg);} 100%{transform:translateX(-6%) skewY(-1.5deg);} }
    @keyframes ${id}flapR { 0%{transform:translateX(0) skewY(0deg);} 100%{transform:translateX(6%) skewY(1.5deg);} }
    @keyframes ${id}flapCloseL { 0%{transform:translateX(-6%) skewY(-1.5deg);} 100%{transform:translateX(0) skewY(0deg);} }
    @keyframes ${id}flapCloseR { 0%{transform:translateX(6%) skewY(1.5deg);} 100%{transform:translateX(0) skewY(0deg);} }
    @keyframes ${id}riftOpen { 0%{clip-path:inset(0 50% 0 50%);opacity:0;} 100%{clip-path:inset(0 0 0 0);opacity:1;} }
    @keyframes ${id}riftPulse { 0%,100%{filter:brightness(1) hue-rotate(0deg);} 50%{filter:brightness(1.6) hue-rotate(60deg);} }
    @keyframes ${id}riftClose { 0%{clip-path:inset(0 0 0 0);opacity:1;} 100%{clip-path:inset(0 50% 0 50%);opacity:0;} }
    @keyframes ${id}shardFall { 0%{transform:translate(0,0) rotate(0deg);opacity:0;} 10%{opacity:1;} 100%{transform:translate(var(--dx),110vh) rotate(var(--rot));opacity:0;} }
    @keyframes ${id}glitchBar { 0%,100%{opacity:0;transform:translateX(0);} 20%{opacity:0.7;transform:translateX(var(--tear));} 40%{opacity:0;transform:translateX(0);} 60%{opacity:0.5;transform:translateX(calc(var(--tear) * -1));} 80%{opacity:0;} }
    @keyframes ${id}flicker { 0%,100%{opacity:0.15;} 50%{opacity:0.35;} }
    @keyframes ${id}flash { 0%{opacity:0;} 10%{opacity:0.95;} 20%{opacity:0;} 100%{opacity:0;} }
    @keyframes ${id}finalFlash { 0%{opacity:0;} 50%{opacity:0.9;} 100%{opacity:0;} }
    @keyframes ${id}labelGlitch { 0%,100%{transform:translateX(-50%) skewX(0deg);text-shadow:0 0 8px #ff00ff,0 0 4px #00ffff;} 25%{transform:translateX(-50%) skewX(6deg);text-shadow:-3px 0 #ff0040,3px 0 #00ffff;} 75%{transform:translateX(-50%) skewX(-6deg);text-shadow:3px 0 #ff0040,-3px 0 #00ffff;} }
    @keyframes ${id}staticNoise { 0%,100%{opacity:0.05;} 50%{opacity:0.18;} }
    @keyframes ${id}crackGrow { 0%{stroke-dashoffset:2000;} 100%{stroke-dashoffset:0;} }
    @keyframes ${id}voidSpin { to { transform: translate(-50%,-50%) rotate(360deg); } }
  `;
  overlay.appendChild(styleEl);

  // screen shake wrapper
  const shakeWrap = document.createElement("div");
  shakeWrap.style.cssText = `position:fixed;inset:0;animation:${id}shake 0.18s steps(2) infinite;`;
  overlay.appendChild(shakeWrap);

  // static noise overlay
  const noiseC = document.createElement("canvas");
  noiseC.width = 200; noiseC.height = 200;
  const nctx = noiseC.getContext("2d");
  const nImg = nctx.createImageData(200, 200);
  for (let i = 0; i < nImg.data.length; i += 4) { const v = Math.random()*255|0; nImg.data[i]=v; nImg.data[i+1]=v; nImg.data[i+2]=v; nImg.data[i+3]=Math.random()*60; }
  nctx.putImageData(nImg, 0, 0);
  const noiseOverlay = document.createElement("div");
  noiseOverlay.style.cssText = `position:fixed;inset:0;background-image:url(${noiseC.toDataURL()});background-size:200px 200px;mix-blend-mode:screen;animation:${id}staticNoise 0.1s steps(1) infinite;pointer-events:none;z-index:99998;`;
  shakeWrap.appendChild(noiseOverlay);

  // initial flash
  const flash = document.createElement("div");
  flash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}flash 0.5s ease-out forwards;z-index:99999;pointer-events:none;`;
  shakeWrap.appendChild(flash);

  // dark backdrop dimming
  const dim = document.createElement("div");
  dim.style.cssText = `position:fixed;inset:0;background:rgba(0,0,0,0.45);animation:${id}flicker 0.3s steps(1) infinite;z-index:9990;`;
  shakeWrap.appendChild(dim);

  // the rift (glowing otherworldly void revealed behind the tear)
  const rift = document.createElement("div");
  rift.style.cssText = `position:fixed;left:50%;top:50%;width:${Math.min(W,H)*1.4}px;height:${Math.min(W,H)*1.4}px;transform:translate(-50%,-50%);background:conic-gradient(from 0deg, rgba(255,0,255,0.5), rgba(0,255,255,0.5), rgba(128,0,255,0.5), rgba(255,0,128,0.5), rgba(255,0,255,0.5));border-radius:50%;filter:blur(40px);clip-path:inset(0 50% 0 50%);animation:${id}riftOpen 1.2s cubic-bezier(0.16,1,0.3,1) forwards, ${id}riftPulse 3s 1.2s ease-in-out infinite;z-index:9991;`;
  shakeWrap.appendChild(rift);

  // spinning void core inside the rift
  const voidCore = document.createElement("div");
  voidCore.style.cssText = `position:fixed;left:50%;top:50%;width:${Math.min(W,H)*0.6}px;height:${Math.min(W,H)*0.6}px;transform:translate(-50%,-50%);background:radial-gradient(circle, #000 25%, rgba(20,0,40,0.8) 50%, transparent 75%);border-radius:50%;clip-path:inset(0 50% 0 50%);animation:${id}riftOpen 1.2s cubic-bezier(0.16,1,0.3,1) forwards;z-index:9992;`;
  shakeWrap.appendChild(voidCore);
  const voidSpin = document.createElement("div");
  voidSpin.style.cssText = `position:fixed;left:50%;top:50%;width:${Math.min(W,H)*0.5}px;height:${Math.min(W,H)*0.5}px;transform:translate(-50%,-50%);background:conic-gradient(from 0deg, transparent, rgba(0,255,255,0.3), transparent, rgba(255,0,255,0.3), transparent);border-radius:50%;clip-path:inset(0 50% 0 50%);animation:${id}riftOpen 1.2s cubic-bezier(0.16,1,0.3,1) forwards, ${id}voidSpin 6s 1.2s linear infinite;z-index:9993;`;
  shakeWrap.appendChild(voidSpin);

  // the two "flaps" — left and right halves that peel apart, opaque so they hide the rift except down the middle
  // build a jagged tear edge using clip-path polygons
  function jaggedClip(side) {
    const pts = [];
    const cols = 24;
    const mid = [];
    for (let i = 0; i <= cols; i++) {
      const t = i / cols;
      const y = (t * 100).toFixed(2);
      const jitter = (Math.random() * 4 - 2).toFixed(2);
      mid.push(`${(50 + Number(jitter)).toFixed(2)}% ${y}%`);
    }
    if (side === "L") {
      return `polygon(0% 0%, ${mid.join(", ")}, 0% 100%)`;
    } else {
      return `polygon(100% 0%, ${mid.join(", ")}, 100% 100%)`;
    }
  }
  // snapshot the current page as an image to use as the "flap" surface (so it looks like reality itself is tearing)
  let snapUrl = null;
  try {
    // we can't easily screenshot cross-origin iframes, so use a stylized gradient "reality" surface instead
    snapUrl = null;
  } catch (e) {}

  const flapL = document.createElement("div");
  flapL.style.cssText = `position:fixed;left:0;top:0;width:100%;height:100%;background:linear-gradient(135deg, rgba(10,10,20,0.92), rgba(40,20,60,0.92));clip-path:${jaggedClip("L")};-webkit-clip-path:${jaggedClip("L")};transform-origin:right center;animation:${id}flapL 1.2s cubic-bezier(0.16,1,0.3,1) forwards;z-index:9995;box-shadow:inset -20px 0 40px rgba(0,0,0,0.6);`;
  shakeWrap.appendChild(flapL);
  const flapR = document.createElement("div");
  flapR.style.cssText = `position:fixed;left:0;top:0;width:100%;height:100%;background:linear-gradient(225deg, rgba(10,10,20,0.92), rgba(20,40,60,0.92));clip-path:${jaggedClip("R")};-webkit-clip-path:${jaggedClip("R")};transform-origin:left center;animation:${id}flapR 1.2s cubic-bezier(0.16,1,0.3,1) forwards;z-index:9995;box-shadow:inset 20px 0 40px rgba(0,0,0,0.6);`;
  shakeWrap.appendChild(flapR);

  // glowing crack line down the tear (SVG)
  const crackSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  crackSvg.setAttribute("width", "100%");
  crackSvg.setAttribute("height", "100%");
  crackSvg.style.cssText = "position:fixed;inset:0;z-index:9996;pointer-events:none;";
  let crackPath = `M ${W/2} 0`;
  let cx = W/2;
  for (let y = 0; y <= H; y += H/18) {
    cx = W/2 + (Math.random()*60 - 30);
    crackPath += ` L ${cx.toFixed(1)} ${y.toFixed(1)}`;
  }
  const crackLine = document.createElementNS("http://www.w3.org/2000/svg", "path");
  crackLine.setAttribute("d", crackPath);
  crackLine.setAttribute("stroke", "url(#rtgrad" + id + ")");
  crackLine.setAttribute("stroke-width", "3");
  crackLine.setAttribute("fill", "none");
  crackLine.setAttribute("stroke-linecap", "round");
  crackLine.style.cssText = `stroke-dasharray:2000;stroke-dashoffset:2000;animation:${id}crackGrow 1.2s cubic-bezier(0.16,1,0.3,1) forwards;filter:drop-shadow(0 0 6px #ff00ff) drop-shadow(0 0 10px #00ffff);`;
  const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
  defs.innerHTML = `<linearGradient id="rtgrad${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#00ffff"/><stop offset="50%" stop-color="#ff00ff"/><stop offset="100%" stop-color="#ff0040"/></linearGradient>`;
  crackSvg.appendChild(defs);
  crackSvg.appendChild(crackLine);
  shakeWrap.appendChild(crackSvg);

  // glitch tear bars (RGB-split horizontal slices sliding)
  for (let i = 0; i < 10; i++) {
    const tb = document.createElement("div");
    const th = 8 + Math.random() * 36;
    const ty = Math.random() * 100;
    tb.style.cssText = `position:fixed;left:0;top:${ty}%;width:100%;height:${th}px;background:hsla(${Math.random()*360},90%,55%,0.12);--tear:${(Math.random()*50-25).toFixed(1)}px;animation:${id}glitchBar ${0.25+Math.random()*0.4}s steps(2) infinite;animation-delay:${(Math.random()*2).toFixed(2)}s;z-index:9997;pointer-events:none;mix-blend-mode:screen;`;
    shakeWrap.appendChild(tb);
  }

  // floating reality shards that peel off and fall
  const shards = [];
  for (let i = 0; i < 18; i++) {
    const sh = document.createElement("div");
    const sw = 20 + Math.random() * 60;
    const shh = 20 + Math.random() * 60;
    const sx = Math.random() * W;
    const sy = -40 - Math.random() * 200;
    const hue = Math.random() * 360;
    sh.style.cssText = `position:fixed;left:${sx}px;top:${sy}px;width:${sw}px;height:${shh}px;background:hsla(${hue},80%,55%,0.45);border:1px solid hsla(${hue},90%,70%,0.6);box-shadow:0 0 10px hsla(${hue},90%,60%,0.6);--dx:${(Math.random()*200-100).toFixed(0)}px;--rot:${(Math.random()*720-360).toFixed(0)}deg;clip-path:polygon(${Math.random()*40}% 0%, ${60+Math.random()*40}% ${Math.random()*30}%, ${50+Math.random()*40}% 100%, ${Math.random()*30}% ${70+Math.random()*30}%);animation:${id}shardFall ${3+Math.random()*3}s ${1+Math.random()*2}s ease-in forwards;z-index:9994;pointer-events:none;`;
    shakeWrap.appendChild(sh);
    shards.push(sh);
  }

  // glitch effect on page media (RGB-split + hue shift)
  const glitchEls = [];
  [...document.querySelectorAll("img, video, canvas, iframe")].forEach((el, i) => {
    if (i > 40) return;
    if (overlay.contains(el)) return;
    let node = el;
    while (node && node !== document.body) {
      const cs = getComputedStyle(node);
      if (cs.position === "fixed" && Number(cs.zIndex) >= 9990) return;
      node = node.parentElement;
    }
    glitchEls.push({ el, anim: el.style.animation, filter: el.style.filter, textShadow: el.style.textShadow });
    el.style.animation = `${id}flicker ${0.08 + Math.random() * 0.12}s steps(1) infinite`;
    el.style.filter = `hue-rotate(${Math.random() * 360}deg) saturate(2)`;
    el.style.textShadow = `-2px 0 #ff0040, 2px 0 #00ffff`;
  });

  // label
  const label = document.createElement("div");
  label.textContent = "撕裂 REALITY TEAR";
  label.style.cssText = `position:fixed;top:24px;left:50%;transform:translateX(-50%);font:bold 18px courier;color:#fff;z-index:100000;pointer-events:none;white-space:nowrap;animation:${id}labelGlitch 0.3s steps(1) infinite;letter-spacing:2px;`;
  shakeWrap.appendChild(label);

  // triggered-by badge
  const userBadge = document.createElement("div");
  userBadge.textContent = "🌌 Triggered by: " + (name || "Admin");
  userBadge.style.cssText = "position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:100000;background:rgba(0,0,0,0.85);color:#ff00ff;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #ff00ff;box-shadow:0 0 10px #ff00ff;text-shadow:0 0 6px #ff00ff;pointer-events:none;white-space:nowrap;";
  shakeWrap.appendChild(userBadge);

  document.body.appendChild(overlay);

  let dismissed = false;
  const dismissRealityTear = () => {
    if (dismissed) return;
    dismissed = true;
    // reverse the flaps and rift
    flapL.style.animation = `${id}flapCloseL 0.8s cubic-bezier(0.16,1,0.3,1) forwards`;
    flapR.style.animation = `${id}flapCloseR 0.8s cubic-bezier(0.16,1,0.3,1) forwards`;
    rift.style.animation = `${id}riftClose 0.8s ease-in forwards`;
    voidCore.style.animation = `${id}riftClose 0.8s ease-in forwards`;
    voidSpin.style.animation = `${id}riftClose 0.8s ease-in forwards`;
    crackLine.style.animation = "none";
    crackLine.style.opacity = "0";
    shakeWrap.style.animation = "none";
    const finalFlash = document.createElement("div");
    finalFlash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}finalFlash 0.5s ease-out forwards;z-index:100001;pointer-events:none;`;
    overlay.appendChild(finalFlash);
    glitchEls.forEach(g => { g.el.style.animation = g.anim; g.el.style.filter = g.filter; g.el.style.textShadow = g.textShadow; });
    setTimeout(() => overlay.remove(), 900);
  };
  document.addEventListener("keydown", function escHandler(e) {
    if (e.key === "Escape") { dismissRealityTear(); document.removeEventListener("keydown", escHandler); }
  });
  setTimeout(dismissRealityTear, 9000);

triggerGlobalRefresh(customMessage, reasonMessage) =>
  let countdown = 30;
  const container = document.createElement("div");
  container.style.cssText = `
    position: fixed;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99999;
    transition: top 0.5s ease-in-out, opacity 0.5s ease-in-out;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
  `;

  const refreshBox = document.createElement("div");
  refreshBox.style.cssText = `
    background: black;
    padding: 10px 20px;
    border-radius: 8px;
    font-family: courier;
    font-size: 14px;
    color: #00ff66;
    box-shadow: 0px 4px 10px #00ff66;
    border: 1px solid #00ff66;
    text-shadow:0px 4px 10px #00ff66;
    display: flex;
    align-items: center;
    text-align: left;
    gap: 14px;
  `;
  refreshBox.innerHTML = `
    <div style="flex:1; text-align:left; line-height:1.4;">${customMessage}</div>
    <div class="cancelRefreshBtn" style="position:relative; flex-shrink:0; width:36px; height:36px; cursor:pointer;">
      <svg width="36" height="36" viewBox="0 0 40 40" style="pointer-events:none;">
        <circle cx="20" cy="20" r="12" stroke="#555" stroke-width="2" fill="none"/>
        <circle id="progressCircle" cx="20" cy="20" r="12" stroke="white" stroke-width="2" fill="none"
          stroke-dasharray="75.4" stroke-dashoffset="0" transform="rotate(-90 20 20)"/>
      </svg>
      <i class="fa-solid fa-pause" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-size:10px; color:#00ff66; pointer-events:none;"></i>
    </div>
  `;
  container.appendChild(refreshBox);

  let reasonBox = null;
  if (reasonMessage) {
    reasonBox = document.createElement("div");
    reasonBox.style.cssText = `
      background: black;
      padding: 10px 20px;
      border-radius: 8px;
      font-family: courier;
      font-size: 14px;
      color: #00ff66;
      box-shadow: 0px 4px 10px #00ff66;
      text-shadow: 0px 4px 10px #00ff66;
      border: 1px solid #00ff66;
      box-sizing: border-box;
      text-align: left;
      overflow-wrap: break-word;
    `;
    reasonBox.innerHTML = reasonMessage;
    container.appendChild(reasonBox);
  }

  document.body.appendChild(container);

  const dismiss = (shouldReload = false) => {
    clearInterval(interval);
    container.style.opacity = "0";
    container.style.top = "-150px";
    setTimeout(() => {
      container.remove();
      if (shouldReload) window.location.reload();
    }, 500);
  };

  setTimeout(() => {
    if (reasonBox) {
      const refreshBoxWidth = refreshBox.offsetWidth;
      reasonBox.style.width = `${refreshBoxWidth}px`;
    }
    container.style.top = "20px";
    container.style.opacity = "1";
  }, 100);

  const circle = container.querySelector("#progressCircle");
  const updateCircle = () => circle.style.strokeDashoffset = (75.4 * (1 - countdown / 30)).toFixed(2);
  updateCircle();

  const interval = setInterval(() => {
    countdown -= 1;
    updateCircle();
    if (countdown <= 0) dismiss(true);
  }, 1000);

  container.querySelector(".cancelRefreshBtn").addEventListener("click", () => {
    clearInterval(interval);
    const closeBtnId = "refreshCloseBtn" + Math.floor(Math.random() * 999999);
    refreshBox.innerHTML = `
      <div style="flex:1; text-align:left; line-height:1.4;">
        Refresh has been cancelled.
          <span class="material-symbols-outlined" style="font-size:1em;line-height:1;">chrome_reader_mode</span>
      </div>
      <div id="${closeBtnId}" style="flex-shrink:0; width:18px; height:18px; display:flex; align-items:center; justify-content:center; font-size:12px; color:#aaa; cursor:pointer;">✕</div>
    `;
    document.getElementById(closeBtnId).onclick = () => dismiss(false);
    setTimeout(() => dismiss(false), 8000);
  });

verityRain(name) =>
  const imgUrl = "https://user.uploads.dev/file/8259231dabe76246da35648cad986937.webp";
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;";
  document.body.appendChild(layer);
  const _vrLabel = document.createElement("div");
  _vrLabel.textContent = "\u{1F441}\u{FE0F} Triggered by: " + (name || "Admin");
  _vrLabel.style.cssText = "position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(0,0,0,0.8);color:#cc88ff;padding:6px 16px;border-radius:6px;font-family:monospace;font-size:13px;border:1px solid #cc88ff;box-shadow:0 0 10px #cc88ff;text-shadow:0 0 6px #cc88ff;pointer-events:none;white-space:nowrap;";
  layer.appendChild(_vrLabel);
  const total = 110;
  const duration = 4000;
  for (let i = 0; i < total; i++) {
    const img = document.createElement("img");
    img.src = imgUrl;
    const size = 20 + Math.random() * 45;
    img.style.cssText = `position:absolute;width:${size}px;height:${size}px;left:${Math.random()*100}%;top:-${size}px;opacity:${0.6+Math.random()*0.4};object-fit:cover;border-radius:50%;`;
    layer.appendChild(img);
    const delay = Math.random() * 4000;
    const fall = img.animate(
      [{ transform: `translateY(0) rotate(0deg)` }, { transform: `translateY(${window.innerHeight + size}px) rotate(${360 + Math.random()*360}deg)` }],
      { duration: duration + Math.random() * 3000, delay, easing: "linear", fill: "forwards" }
    );
  }
  setTimeout(() => layer.remove(), 10000);

