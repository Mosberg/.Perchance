    @keyframes ${id}flash { 0%,100%{opacity:0;} 30%{opacity:0;} 31%{opacity:0.85;} 33%{opacity:0.1;} 34%{opacity:0.6;} 36%{opacity:0;} 55%{opacity:0;} 56%{opacity:0.95;} 58%{opacity:0.2;} 60%{opacity:0;} }
    @keyframes ${id}darken { 0%{opacity:0;} 10%{opacity:0.6;} 85%{opacity:0.55;} 100%{opacity:0;} }
    @keyframes ${id}shake { 0%,100%{transform:translate(0,0);} 30%{transform:translate(0,0);} 31%{transform:translate(-3px,2px);} 32%{transform:translate(2px,-1px);} 33%{transform:translate(0,0);} 56%{transform:translate(-2px,1px);} 57%{transform:translate(1px,-2px);} 58%{transform:translate(0,0);} }
    @keyframes ${id}cloudDrift { 0%{transform:translateX(-10%);} 100%{transform:translateX(10%);} }
    @keyframes ${id}ripple { 0%{transform:scale(0);opacity:0.6;} 100%{transform:scale(1);opacity:0;} }
    @keyframes ${id}leafBlow { 0%{transform:translate(0,0) rotate(0deg);opacity:0;} 10%{opacity:0.8;} 90%{opacity:0.6;} 100%{transform:translate(120vw,${Math.random()*200-100}px) rotate(${360+Math.random()*360}deg);opacity:0;} }
  `;
  layer.appendChild(styleEl);
  const darken = document.createElement("div");
  darken.style.cssText = `position:fixed;inset:0;background:linear-gradient(to bottom, #05051a 0%, #0a0a2a 40%, #0a0a1a 100%);animation:${id}darken 10s ease-in-out forwards;`;
  layer.appendChild(darken);
  const flash = document.createElement("div");
  flash.style.cssText = `position:fixed;inset:0;background:white;animation:${id}flash 10s linear;`;
  layer.appendChild(flash);
  const cloudCtn = document.createElement("div");
  cloudCtn.style.cssText = "position:fixed;top:0;left:0;width:100%;height:30%;overflow:hidden;";
  layer.appendChild(cloudCtn);
