T2i = {import:text-to-image-plugin}
userCounter = {import:user-counter}
commentsPlugin = {import:comments-plugin}
generatorStats = {import:generator-stats-plugin}
ai = {import:ai-text-plugin}
favicon = {import:favicon-plugin}
$meta
  title = Ai Studio
  description = Generate AI images using top camera styles (Sony a7rv, Nikon z9, 17 Pro Max) and our inbuilt Prompt Generator.
  tags = AI image generator, prompt architect, stable diffusion, shot on iphone 17 pro max, s26 ultra photography, sony alpha a7rv, professional dslr styles, prompt engineering, cinematic lighting, mobile photography, 8k resolution, character creator, fantasy art, concept art generator, macro photography, f/1.2 bokeh, unreal engine 5, mirrorless camera look, raw photo fidelity, pro-workflow, high-end AI studio, creative assistant.
  image = https://user.uploads.dev/file/2bde006c0c22c34b0119ce535848ab0c.jpg
  header
    mode = minimal
    background = radial-gradient(circle at bottom right, #151336 0, #070b14 100%)
v
  userPrompt = Sliced fruits and vegetables served in a plate at British restaurant 
  userNegative = (worst quality, low quality:1.4)
  userScale = 7
  userCount = 1
  selectedSize = 768x768
  userStyle = 
  userCamera = 
  userSeed = 
  finalPrompt = Sliced fruits and vegetables restaurant in India 
  activeSeed = 
  itemGap = 12px
  studioGuideTitle =Guide & Rules
  studioArchitectTitle = Prompt Architect 
  studioInstructions = <div style="margin-bottom:[v.itemGap]"><b>1. Negative Prompts:</b> Negative prompts are no longer required for high-quality results. By using a single, descriptive prompt, you’ll get more accurate images with less "prompt clutter.".</div><div style="margin-bottom:[v.itemGap]"><b>2. Styles:</b> Selecting a Camera or Art Style will automatically append professional-grade descriptors to your prompt, helping you achieve specific lighting and textures effortlessly.</div><div style="margin-bottom:[v.itemGap]"><b>3. Lite Mode:</b> If you experience lag, UI stuttering, or want to save battery, toggle the 'Lite' mode at the bottom of the sidebar. This disables heavy blurs and animations.</div><div style="margin-bottom:[v.itemGap]"><b>4. Seeds:</b> Leave the seed blank for random results. If you find a composition you love, copy the seed number and enter it here to 'lock' that specific structure.</div><div style="margin-bottom:[v.itemGap]"><b>5. Update: New Prompt Logic:</b> You can now toggle between Exclusive and Merge modes. Choose to focus on a single aesthetic or blend Style and Camera settings for unexpected results.</div><div style="margin-bottom:[v.itemGap]"><b>6. Prompt Architect:</b> Use the Prompt Architect feature to turn simple ideas into rich scenes. Our AI handles the creative description while leaving the technical camera and style settings entirely in your control.</div>
  
outputArea = <div class="empty-state"><h3>Your creation gallery is empty</h3><p>Enter a prompt on the left to begin</p></div>

singleGen
  [T2i({ prompt: v.finalPrompt, guidanceScale: v.userScale * 1, resolution: v.selectedSize, seed: v.activeSeed })]

galleryOptions
  gallery = true
  hideIfScoreIsBelow = -1
  adaptiveHeight = true

