generateHTML = {import:text2image-framework-v4}

$meta
  title = Text2Image Pro Suite
  description = Full-control professional workflow with rich style routing, seed mechanics, and metadata-ready output.

settings
  pageTitle = Text2Image Pro Suite
  subtitle = Advanced mode with expanded random pools, style packs, and pro-focused control surface.
  theme = aurora
  showComments = false

  enableShareLinks = true
  enableModifierGroups = true
  enablePersonaHooks = true

  defaultPrompt = cinematic hero scene, complex environment, layered depth, production concept art
  defaultNegativePrompt = blurry, duplicate limbs, low quality, washed colors, text artifacts
  defaultImageCount = 10

  enableRandomInputButton = true
  enableAiSuggestButton = true
  enableRandomAppendButton = true
  aiSuggestMode = append
  aiSuggestMaxCharacters = 280
  aiSuggestInstruction = Add one concise high-impact visual continuation, no explanation.

  artStyle
    label = Pro Style Router
    type = select
    remember = true
    options
      Suite Default
        color = #50d0a7
        meta:import
          from = {import:text2image-styles-pack-default}

      Suite Anime
        color = #7f9cff
        meta:import
          from = {import:text2image-styles-pack-anime}

      Suite Realistic
        color = #f1bc7d
        meta:import
          from = {import:text2image-styles-pack-realistic}

      Legacy General
        color = #ff96a2
        meta:import
          from = {import:perstyles-general}

      Legacy Anime
        color = #d48eff
        meta:import
          from = {import:perstyles-anime}

      Legacy Realistic
        color = #ffb06b
        meta:import
          from = {import:perstyles-realistic}

  imageButtons
    privateSave = true

  imageOptions
    style = border-radius:14px; box-shadow:0 16px 40px rgba(0,0,0,0.25);

  commentOptions
    channel = text2image-pro-suite
    width = 100%
    height = 400
    commentPlaceholderText = Share workflows, seeds, and parameter stacks.
    submitButtonText = submit

  persona
    enableAiDescription = true
    enableAiName = true
    defaultInstruction = Produce Name and Description tailored to the visual prompt.
    chatBaseUrl = https://perchance.org/ai-character-chat

  randomPromptPool
    floating megacity over ocean cliffs, dramatic weather, ultra detailed
    mythic guardian in crystal cavern, particles, volumetric god rays
    high-fashion cyberpunk character sheet, full body, material callouts
    surreal botanical cathedral, impossible architecture, cinematic framing
    luxury product studio shot, precision reflections, soft shadow gradient

  randomAppendPool
    ultra detailed
    dynamic composition
    atmospheric perspective
    volumetric lighting
    crisp focal point
    clean silhouette
    rich material definition
    production-ready concept quality

