generateHTML = {import:text2image-framework-v4}

$meta
  title = Text2Image Anime Suite
  description = Anime-first generator with curated anime styles, expressive prompts, and smart seed flows.

settings
  pageTitle = Text2Image Anime Suite
  subtitle = Anime-focused workflows with style-aware prompt shaping.
  theme = sunrise
  showComments = false

  enableShareLinks = true
  enableModifierGroups = true
  enablePersonaHooks = true

  defaultPrompt = anime key visual, confident heroine, dramatic perspective, rich cel shading
  defaultNegativePrompt = photoreal skin, blurry lines, broken anatomy, low quality
  defaultImageCount = 8

  enableRandomInputButton = true
  enableAiSuggestButton = true
  enableRandomAppendButton = true
  aiSuggestMode = append
  aiSuggestMaxCharacters = 200
  aiSuggestInstruction = Continue this anime prompt in one concise line with strong visual cues.

  artStyle
    label = Anime Style
    type = select
    remember = true
    options
      Suite Anime
        color = #84a9ff
        meta:import
          from = {import:text2image-styles-pack-anime}

      Anime Legacy
        color = #7b5bff
        meta:import
          from = {import:perstyles-anime}

      Stylized Defaults
        color = #57d4c3
        meta:import
          from = {import:text2image-styles-pack-default}

  imageButtons
    privateSave = true

  imageOptions
    style = border-radius:14px; box-shadow:0 14px 34px rgba(16,18,36,0.28);

  randomPromptPool
    anime swordsman on stormy rooftop, electric sparks, dynamic angle
    magical academy hallway, warm lanterns, polished anime painting
    mecha pilot close-up, cockpit reflections, high-energy scene
    cozy slice-of-life cafe, soft lighting, expressive faces

  randomAppendPool
    expressive line art
    cinematic anime framing
    vibrant cel shading
    polished highlights
    bold color design

