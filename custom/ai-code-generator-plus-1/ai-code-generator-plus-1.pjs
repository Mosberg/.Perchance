$meta
  async dynamic(inputs) =>
    let DEFAULT_NAME = "Code";
    let DEFAULT_SUFFIX = "Can code in many languages and formats.";
    let DEFAULT_EXT = "txt";

    // small default ext map used only when templates or mode do not provide an ext
    let EXT_MAP = {
      javascript: "js",
      typescript: "ts",
      html: "html",
      css: "css",
      python: "py",
      markdown: "md",
      rust: "rs",
      cpp: "cpp",
      sql: "sql",
      general: "txt"
    };

    let modeKey = inputs.urlParams.mode;
    let name = DEFAULT_NAME;
    let suffix = DEFAULT_SUFFIX;
    let ext = DEFAULT_EXT;

    if (modeKey && EXT_MAP[modeKey]) {
      ext = EXT_MAP[modeKey];
    }
    return {
      title: `AI ${name} Generator ➕ (free, no sign-up, unlimited)`,
      description: `Free, high-quality AI ${name.toLowerCase()} generator. ${suffix}`,
    };

settings
  instruction() =>
    this.lastModeUsed = currentMode;
    return modes[currentMode].instruction.toString();
  startWith() =>
    responseEl.value.trim() === "" ? (modes[currentMode].startWith || "") : responseEl.value;
  hideStartWith = [ responseEl.value.trim() === "" && modes[currentMode].hideStartWith === true ? true : false ]
  outputTo = [responseEl]
  onChunk(data) =>
    if (responseEl.scrollTop + responseEl.offsetHeight > responseEl.scrollHeight - 60) responseEl.scrollTop = responseEl.scrollHeight;
    if (modes[this.lastModeUsed] && modes[this.lastModeUsed].onChunk) modes[this.lastModeUsed].onChunk(data);
  onStart(data) =>
    UI.setRunningState();
    if (modes[this.lastModeUsed] && modes[this.lastModeUsed].onStart) modes[this.lastModeUsed].onStart(data);
  onFinish(data) =>
    UI.setIdleState();
    localStorage.setItem("response", responseEl.value || "");
    if (modes[this.lastModeUsed] && modes[this.lastModeUsed].onFinish) modes[this.lastModeUsed].onFinish(data);
  render = [ modes[currentMode].render || null ]

ai = {import:ai-text-plugin}
comments = {import:comments-plugin}
kv = {import:kv-plugin}
remember = {import:remember-plugin}
literal = {import:literal-plugin}
kvStorageKey = "acg_notebook_pages_v1"
modes = {import:acg-modes}

urlModeToActualMode
  html = html
  javascript = html
  css = html
  python = python
  markdown = markdown
  character = character
  doc = markdown
  char = character
  general = general
  brainy = brainy
  perchance = perchanceLists
  perchanceLists = perchanceLists
  perchanceHtml = perchanceHtml
  router = router
  comparison = comparison
  presets = presets
  test = test
  refactor = refactor
  design = design
  tutorial = tutorial
  math = math
  schema = schema
  template = template
  agent = agent
  luau = luau
  gdscript = gdscript
  csharp_unity = csharp_unity
  typescript = typescript
  cpp = cpp
  rust = rust
  sql = sql