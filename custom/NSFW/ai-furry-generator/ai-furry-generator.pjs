// commentChannels 
  commentChannels
    general
      label = General
      commentPlaceholderText = Type a friendly, 𝗦𝗙𝗪 comment and read the rules ⓘ avoid risky links
      allowBots = false // disallows 'speak via character' for this channel, default is allowed except for general
      bannedWords = [jail.PG13BannedWords] // PG ban words + regular ban words
      
    roleplay
      label = Roleplay
      commentPlaceholderText = Start a 𝗦𝗙𝗪 roleplay or type your character's action...
      submitButtonText = send roleplay
      bannedWords = [jail.PG13BannedWords] // PG ban words + regular ban words
      onComment(comment) =>
        baseOnComment(comment);
        
        const u = comment.user;
        const hasPfp = u && (u.avatar || u.avatarUrl);
        const isTrueAnon = !u || (!u.name && !u.nickname && !u.nick && !hasPfp);
        const hasMessage = comment.message && comment.message.trim();

        // Show the RP-specific name warning to anonymous users
        if (isTrueAnon && hasMessage && comment.byCurrentUser) {
          showRPSignupModal();
        }

        if (window?.perchNotifyToggle === false) return;
        
        // Broadcast to mods if an anon is trolling the RP chat
        if (isTrueAnon && hasMessage) {
          const vid = (u && u.visualId) ? String(u.visualId).toUpperCase() : "ANON";
          window._alertedMods = window._alertedMods || new Set();
          
          if (!window._alertedMods.has(vid + "_anon_rp")) {
            window._alertedMods.add(vid + "_anon_rp");
            notifyPinned("Heads up! Anonymous user [" + vid + "] is attempting to roleplay without a name.");
          }
        }
      
    chat2
      label = 18+ General
      submitButtonStyle = font-family:"Open Sans",sans-serif; height:28px; min-height:28px; padding:1px 10px; border-radius:8px; border:1px solid light-dark(rgba(230,81,0,0.34),rgba(243,130,2,0.42)); background:light-dark(rgba(230,81,0,0.07),rgba(243,130,2,0.11)); color:light-dark(#E65100,#F38202); font-size:12px; font-weight:700; line-height:1; box-shadow:none; text-transform:none; cursor:pointer; display:flex; align-items:center; justify-content:center; box-sizing:border-box;
      commentPlaceholderText = ⚠︎ Newcomers must add “18+” to their nickname or face a ban
      submitButtonText = 🔞 submit
      allowBots = false
      onComment(comment) =>
        // 1. Run all the global moderation rules first
        baseOnComment(comment);
        
        const u = comment.user;
        const hasPfp = u && (u.avatar || u.avatarUrl);
        const isLiteral18 = u && !u.name && !hasPfp && (u.nickname === "18+" || u.nick === "18+");
        const isTrueAnon = !u || (!u.name && !u.nickname && !u.nick && !hasPfp);
        const hasMessage = comment.message && comment.message.trim();

        // 2. Mandatory Warning: Only True Anons get the popup.
        if (isTrueAnon && hasMessage && comment.byCurrentUser) {
          showAgeVerificationModal();
        }

        // 3. Top-text / pinned notification kill switch
        if (window?.perchTextAlertsToggle === false) return;
        
        // 4. Mod Broadcast
        if (hasMessage) {
          const vid = (u && u.visualId) ? String(u.visualId).toUpperCase() : "ANON";
          window._alertedMods = window._alertedMods || new Set();
          
          if (isTrueAnon) {
            // Trigger 1: Once-per-ID for unconfirmed age
            if (!window._alertedMods.has(vid + "_anon_minor")) {
              window._alertedMods.add(vid + "_anon_minor");
              notifyPinned("Heads up! Anonymous user [" + vid + "] age not confirmed (potential minor)!");
            }
          } else if (isLiteral18) {
            // Trigger 2: Once-per-ID for Mr. Dumb Question
            if (!window._alertedMods.has(vid + "_dumb")) {
              window._alertedMods.add(vid + "_dumb");
              notifyPinned("User [" + vid + "] might be 'Mr. Dumb Question' (or it could just be a coincidence).");
            }
          }
        }
      
    adult-lounge
      label = Adult Lounge
      submitButtonStyle = font-family:"Open Sans",sans-serif; height:28px; min-height:28px; padding:1px 10px; border-radius:8px; border:1px solid light-dark(rgba(230,81,0,0.34),rgba(243,130,2,0.42)); background:light-dark(rgba(230,81,0,0.07),rgba(243,130,2,0.11)); color:light-dark(#E65100,#F38202); font-size:12px; font-weight:700; line-height:1; box-shadow:none; text-transform:none; cursor:pointer; display:flex; align-items:center; justify-content:center; box-sizing:border-box;
      commentPlaceholderText = ⚠︎ Newcomers must add “18+” to their nickname or face a ban
      submitButtonText = 🍸 softcore only
      allowBots = false
      onComment(comment) =>
        // 1. Run all the global moderation rules first
        baseOnComment(comment);
        
        const u = comment.user;
        const hasPfp = u && (u.avatar || u.avatarUrl);
        const isTrueAnon = !u || (!u.name && !u.nickname && !u.nick && !hasPfp);
        const hasMessage = comment.message && comment.message.trim();

        // 2. Mandatory Warning: Bypasses the notification toggle so they can't hide from it
        if (isTrueAnon && hasMessage && comment.byCurrentUser) {
          showAgeVerificationModal();
        }

        // 3. Top-text / pinned notification kill switch
        if (window?.perchTextAlertsToggle === false) return;
        
        // 4. Mod Broadcast
        if (isTrueAnon && hasMessage) {
          const vid = (u && u.visualId) ? String(u.visualId).toUpperCase() : "ANON";
          window._alertedMods = window._alertedMods || new Set();
          
          if (!window._alertedMods.has(vid + "_anon_minor")) {
            window._alertedMods.add(vid + "_anon_minor");
            notifyPinned("Heads up! Anonymous user [" + vid + "] age not confirmed (potential minor)!");
          }
        }
                
