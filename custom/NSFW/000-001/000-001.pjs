Create dependencies for ai text generation and ai text to image generation and import them in the lists of the generator which use the dependencies like this example of art styles:

    artStyle
      label = 🎨 Art Style
      type = select
      remember = true // <-- makes it so the selected option will be remembered even if the user refreshes/closes the page
      options
        Custom Styles
          color = #f6c344
          𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
            prompt = [input.description].
            negative = [input.negative].
            meta:position = 0
          𝐌𝐓𝐆 𝐂𝐚𝐫𝐝
            prompt = [input.description], magic the gathering card
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 1
          𝗧𝗖𝗚 𝗖𝗮𝗿𝗱
            prompt = [input.description], pokemon trading card game
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 2
            meta:tags = [({pokemon:10, tcg:3})]
          𝑷𝒊𝒙𝒆𝒍 𝑨𝒓𝒕
            prompt = [input.description], pixel art
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 3
            meta:tags = [({pokemon:10, pixel:3})]
          𝘾𝙖𝙧𝙩𝙤𝙤𝙣
            prompt = [input.description], cartoon
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 4
          𝔸𝕟𝕚𝕞𝕖
            prompt = [input.description], anime
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 5
          Pokemon
            prompt = [input.description], pokemon pixel art
            negative = [input.negative], low-quality, deformed, blurry, bad art
            meta:position = 6
            meta:tags = [({pokemon:10, pixel:3})]
        
        Moss Default Styles
          color = #00ff00
          meta:import
            from = {import:t2i-styles-mosberg-default}
            
        Moss Anime Styles
          color = #0000ff
          meta:import
            from = {import:t2i-styles-mosberg-anime}

        Moss Character Styles
          color = #00ffff
          meta:import
            from = {import:t2i-styles-moss-character}

        Moss Character Gender Styles
          color = #ffff00
          meta:import
            from = {import:t2i-styles-moss-character-gender}
            
        NSFW / Adult Styles
          color = #ff0000
          meta:import
            from = {import:t2i-styles-mosberg-nsfw}

        Hentai Artist Styles
          color = #a8ff31
          meta:import
            from = {import:hentai-artist-styles}


