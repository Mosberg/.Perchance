loop_mode_compact_layer = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let mode=String(d.generation_mode||"Image").trim();let map={"Free":"Image","Free Image":"Image","Image":"Image","Avatar":"Presence","Character":"Presence","Character Avatar":"Presence","Presence":"Presence","World":"World View","World Preview":"World View","World View":"World View","Map":"World Map","World Map":"World Map","Scene":"Journey Scene","Story Scene":"Journey Scene","Journey Scene":"Journey Scene"};mode=map[mode]||"Image";if(mode==="Presence")return String(loop_mode_compact_character||"");if(mode==="World View")return String(loop_mode_compact_world||"");if(mode==="World Map")return String(loop_mode_compact_map||"");if(mode==="Journey Scene")return String(loop_mode_compact_story||"");return String(loop_mode_compact_free||"")}catch(e){return String(loop_mode_compact_free||"")}})()]

