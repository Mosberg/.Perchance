// ─────────────────────────────────────────────
// 3) MODE DIRECTOR — WHAT IS BEING MADE
// ─────────────────────────────────────────────

loop_mode_layer
  [loop_mode_free] ^[loopModeFree]
  [loop_mode_character] ^[loopModeCharacter]
  [loop_mode_world] ^[loopModeWorld]
  [loop_mode_map] ^[loopModeWorldMap]
  [loop_mode_story] ^[loopModeStory]

loop_mode_free
  polished standalone ASW image, user subject has priority, flexible visual interpretation, clear subject, balanced composition, finished key visual

loop_mode_character
  ASW Presence image, one primary character, reusable presence identity card, clear face visibility, readable costume, strong silhouette, expressive pose, contextual atmospheric background, not a plain cutout

loop_mode_world
  ASW World View image, environment concept art, reusable world or location card, establishing composition, strong sense of place, foreground midground background, lived-in atmospheric details

loop_mode_map
  ASW World Map image, cartographic world map, readable terrain and routes, visible landmarks or zones, strong spatial logic, no character portrait takeover

loop_mode_story
  ASW Journey Scene image, cinematic narrative still, visible story beat, emotional action or consequence, character and world integrated, scene must feel like a moment from an ongoing ASW Journey

