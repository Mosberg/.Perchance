  [loop_style_flavor_anti_generic_3d] ^[loopCore3D && loopDraftSignatureFlavor != "None"]
  [loop_style_flavor_anti_generic_highfantasy] ^[loopCoreHighFantasy && loopDraftSignatureFlavor != "None"]

loop_style_flavor_anti_generic_anime
  prioritize the chosen flavor's distinct atmosphere, line behavior, mood, and visual identity with specific anime-style clarity

loop_style_flavor_anti_generic_comic
  prioritize the chosen flavor's distinct line logic, contrast behavior, illustration identity, and graphic storytelling clarity

loop_style_flavor_anti_generic_3d
  prioritize the chosen flavor's distinct surface treatment, render mood, design identity, and material behavior

loop_style_flavor_anti_generic_highfantasy
