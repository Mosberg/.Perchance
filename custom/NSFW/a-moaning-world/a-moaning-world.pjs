

// TYPO-ZILLA-SLAB-1A — Zilla Slab is the global ASW typography authority across LEFT-hosted Gallery and Comments surfaces.
// TYPO-CANON-1A — Comments/Gallery consume ASW canonical typography roles.
// DAY-MODE-RESTORE-1A — LEFT Gallery and Comments Ash/Night parity restored over current Image Engine baseline.
// ============================================================================
// 00 — NATIVE PLUGIN IMPORTS
// Core Perchance imports used by the right-panel runtime.
// =============================================================================
kv = {import:kv-plugin}
ai = {import:ai-text-plugin}
image = {import:text-to-image-plugin}
commentsPlugin = {import:comments-plugin}
tabbedCommentsPlugin = {import:tabbed-comments-plugin-v1}
icon = {import:rpg-icon-plugin}
uploadPlugin = {import:upload-plugin}
// MIG-1A MORO image-engine compatibility imports/aliases. Existing ASW imports remain authoritative.
upload = {import:upload-plugin}
fullscreenButton = {import:fullscreen-button-plugin}
generatorStats = {import:generator-stats-plugin}
literal = {import:literal-plugin}
bugReport = {import:bug-report-plugin}
createTextEditor = {import:text-editor-plugin-v1}
favicon = {import:favicon-plugin}
generateInterfaceHTML = {import:t2i-framework-plugin-v2}
createMediaGallery = {import:cmgp}
createASWLibrary = {import:library-for-journey-to-silent-world}
createASWPresences = {import:presences-journey-to-silent-world}
createServerSocket = {import:server-plugin}
// ============================================================================
// 01 — PAGE METADATA
// Public generator metadata.
// ============================================================================
$meta
  title = A Moaning World
  description = 18+ Explicit Adult RPG | Erotic Story | Worldbuilder, Map & Zones
  image = https://user.uploads.dev/file/288de548df79b4c8a85f6fbd108e4fec.jpg


// ============================================================================
// 02A — PRIVATE GALLERY NATIVE FRAMEWORK
// Mirrors LOOP's left-panel private-gallery switch. The RIGHT panel provides
// ASW-specific open/save bridges; this LEFT block enables the native private
// save/gallery infrastructure.
// ============================================================================
settings
  pageTitle = A Moaning World
  numImages = [Number(loopEngineNumImages)]
  socialFeatures = button after 4 clicks

  imageButtons
    privateSave = true
    personality = true

  imageOptions
    saveTitle = [loop_save_title]
    saveDescription = [loop_save_description]
    prompt = [final_prompt]
    negativePrompt = [loop_negative_prompt]
    resolution = [loopEngineResolution]

  prompt = [""]

// ============================================================================
// 02 — COMMENT CHANNELS
// Native comment channel keys for the Comments & Feedback modal.
// ============================================================================
commentChannels
  general
    label = General
    commentPlaceholderText = Add a naughty comment — share, discuss, or leave a steamy note...
    allowBots = false
  feedback
    label = Feedback
    commentPlaceholderText = Add feedback, report a bug, or leave a dirty note...
    allowBots = false

// ============================================================================
// 03 — ASW COMMENT ACCENT + THEME BRIDGE
// Keeps Perchance comments aligned with ASW Shell theme/accent through official
// comments-plugin options. Storage keys are read-only and unchanged.
// ============================================================================
aswCommentShellTheme = [((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})())]
aswCommentColorScheme = [(()=>{try{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "light" : "dark";}catch(e){return "dark"}})()]
aswCommentAccentMode = [(()=>{try{let raw=String(localStorage.getItem("asw_native_accent_mode_v1")||"matte-red").trim().toLowerCase();let aliases={red:"matte-red",asw:"matte-red","asw-red":"matte-red",matte:"matte-red",green:"forest-green",forest:"forest-green",blue:"moonlight-blue",moon:"moonlight-blue",moonlight:"moonlight-blue",purple:"sunset-purple",sunset:"sunset-purple",dusk:"sunset-purple",violet:"sunset-purple",orange:"afterglow-horizon",afterglow:"afterglow-horizon",horizon:"afterglow-horizon",glow:"afterglow-horizon"};let id=aliases[raw]||raw||"matte-red";return ["matte-red","forest-green","moonlight-blue","sunset-purple","afterglow-horizon"].includes(id)?id:"matte-red";}catch(e){return "matte-red"}})()]
aswCommentAccentColor = [(()=>{try{const clean=v=>String(v||"").trim();const valid=v=>/^#[0-9a-fA-F]{3,8}$/.test(clean(v));const roots=[document.documentElement,document.body,document.querySelector("#aswApp"),document.querySelector("[data-asw-shell-theme]"),document.querySelector("[data-asw-accent]")].filter(Boolean);for(const root of roots){const css=getComputedStyle(root);const vars=["--asw-accent","--asw-color-accent","--asw-shell-accent","--asw-active-accent","--asw-user-accent"];for(const key of vars){const val=clean(css.getPropertyValue(key));if(valid(val))return val;}}let raw=clean(localStorage.getItem("asw_native_accent_mode_v1")||document.documentElement.getAttribute("data-asw-accent")||"matte-red").toLowerCase();let aliases={red:"matte-red",asw:"matte-red","asw-red":"matte-red",matte:"matte-red",green:"forest-green",forest:"forest-green",blue:"moonlight-blue",moon:"moonlight-blue",moonlight:"moonlight-blue",purple:"sunset-purple",sunset:"sunset-purple",dusk:"sunset-purple",violet:"sunset-purple",orange:"afterglow-horizon",afterglow:"afterglow-horizon",horizon:"afterglow-horizon",glow:"afterglow-horizon"};let id=aliases[raw]||raw||"matte-red";let colors={"matte-red":"#8A6E42","forest-green":"#305711","moonlight-blue":"#506886","sunset-purple":"#6C476C","afterglow-horizon":"#FB7906"};return colors[id]||colors["matte-red"];}catch(e){return "#8A6E42"}})()]
aswCommentOnAccent = [(()=>{try{let raw=String(localStorage.getItem("asw_native_accent_mode_v1")||document.documentElement.getAttribute("data-asw-accent")||"matte-red").trim().toLowerCase();return /afterglow|horizon|orange/.test(raw)?"#17130E":"#FFFFFF";}catch(e){return "#FFFFFF"}})()]
aswCommentChrome = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#F1EEE7" : "#17191A"})()]
aswCommentChromeHigh = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#F7F5F0" : "#1E1E1E"})()]
aswCommentField = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#FAF8F3" : "#111313"})()]
aswCommentControl = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#E5E1D8" : "#202324"})()]
aswCommentText = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#29251F" : "#E8E0CF"})()]
aswCommentMuted = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "#5D5548" : "rgba(232,224,207,0.62)"})()]
aswCommentLine = [(()=>{return ((()=>{try{const roots=[document.documentElement,document.body,document.querySelector("#aswNativeApp"),document.querySelector("[data-asw-shell-theme]")].filter(Boolean);let raw="";for(const root of roots){raw=String(root.getAttribute&&root.getAttribute("data-asw-shell-theme")||root.dataset&&root.dataset.aswShellTheme||"").trim().toLowerCase();if(raw)break;}if(!raw)raw=String(localStorage.getItem("asw_native_shell_theme_v1")||"midnight").trim().toLowerCase();return ["ash","day","light"].includes(raw)?"ash":"midnight";}catch(e){return "midnight"}})()) === "ash" ? "rgba(41,37,31,0.14)" : "rgba(232,224,207,0.12)"})()]

// ============================================================================
// 04 — DEFAULT COMMENT OPTIONS
// Shared ASW styling for Perchance comments. Uses official comments-plugin
// options so the RIGHT panel does not need to force plugin internals.
// ============================================================================
defaultCommentOptions
  width = 100%
  height = 100%
  loadFonts = Zilla Slab
  forceColorScheme = [aswCommentColorScheme]
  commentPlaceholderText = Add a naughty comment — share, discuss, or leave a steamy note...
  submitButtonText = send
  submitButtonSuccessText = sent
  hideDates = false
  hideFullscreenButton = true
  deleteButtonIcon = ✕  
  adminPasswordHash = 036a2f6b57c1f9ba76acccbd2d43476f5fd020ad1b5848a7cfbb09c9ce44731d
  adminFlair = 👑MOD👑
  rateLimits = 1 per 20 seconds, 6 per 10 minutes
  containerStyle = width:100%; height:100%; box-sizing:border-box; background:[aswCommentChrome]; color:[aswCommentMuted]; font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1.44; overflow:hidden; color-scheme:[aswCommentColorScheme]; border-radius:0;
  messageFeedStyle = background:[aswCommentChrome]; color:[aswCommentMuted]; font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1.44; padding:6px; gap:5px; box-sizing:border-box; border-radius:0;
  messageBubbleStyle = background:transparent; color:[aswCommentText]; border:1px solid [aswCommentLine]; border-radius:0; font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1.48; font-weight:400; padding:8px 9px; margin:0 0 5px 0; box-shadow:none;
  inputAreaStyle = min-height:46px; max-height:92px; background:transparent; color:[aswCommentText]; border:1px solid [aswCommentLine]; border-radius:0; font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1.44; font-weight:400; padding:8px 9px; box-sizing:border-box;
  submitButtonStyle = min-height:28px; height:28px; padding:0 10px; background:[aswCommentAccentColor]; color:[aswCommentOnAccent]; border:1px solid [aswCommentAccentColor]; border-radius:var(--asw-modal-radius-small,4px); font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1; font-weight:650; letter-spacing:0.08em; text-transform:uppercase; opacity:1; box-shadow:none;
  settingsButtonStyle = min-height:26px; height:26px; padding:0 8px; background:transparent; color:[aswCommentMuted]; border:1px solid [aswCommentLine]; border-radius:var(--asw-modal-radius-small,4px); font-family:"Zilla Slab",Georgia,"Times New Roman",serif; font-size:var(--asw-type-ui-size,0.875rem); line-height:1; opacity:0.86; box-shadow:none;
  fullscreenButtonStyle = display:none;
  customEmojiSize = 1
  loneCustomEmojiSizeMultiplier = 1.55
  customEmojis = {import:huge-emoji-list}
  bannedUsers
    300cb70b21f2d67b1496
    c3fc848cb123db2793f8
    403b16b3422020848cd0


