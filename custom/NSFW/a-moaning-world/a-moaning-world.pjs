loop_core_registry_detail_layer = [(()=>{try{let core=String(loopDraftRenderCore||"MORO Core Style v1");let map={"MORO Core Style v1": "core medium: ASW Core Style v1. Use silent mythic realism, cinematic restraint, atmospheric world memory, subtle ancient cultural traces, worn materials, soft environmental depth, restrained fantasy realism, elegant readable detail, clear subject readability, controlled ornament, grounded fantasy language, and disciplined detail hierarchy. This core defines medium, atmosphere, and visual handling while the user subject remains the content authority.", "Anime": "core medium: Anime. Use stylized 2D image grammar, clean contour discipline, expressive simplified anatomy, readable silhouette control, and anime-native color and shading behavior. This core defines the medium and visual handling while the user subject remains the content authority.", "Cinematic Realism": "core medium: Cinematic Realism. Use live-action image grammar, lens-aware framing, physically plausible light and material response, atmospheric depth, and grounded tonal control. This core defines the medium and visual handling while the user subject remains the content authority.", "Comic": "core medium: Comic. Use ink-led graphic storytelling, assertive contour authority, stylized anatomy, bold value separation, and panel-minded visual clarity. This core defines the medium and visual handling while the user subject remains the content authority.", "3D Render": "core medium: 3D Render. Use dimensional form logic, coherent volume, material-aware shading, surface-specific light response, and unmistakable spatial depth. This core defines the medium and visual handling while the user subject remains the content authority.", "High Fantasy": "core medium: High Fantasy. Use mythic illustrative language, painterly depth, lore-rich atmosphere, elevated narrative grandeur, atmospheric layering, and refined fantasy-image craftsmanship. This core defines the medium and visual handling while the user subject remains the content authority."};return map[core]||"";}catch(e){return ""}})()]

loop_core_style_alignment_layer
  Core is the medium container and Style Flavor is the active visual branch inside that container; preserve the selected core medium and apply style influence through line, color, light, texture, mood, and composition

loop_style_flavor_canonical_layer = [(()=>{try{let key=String(loopDraftStyleFlavorKey||"").trim(); if(!key) return ""; let map={"anime__akira_toriyama_artwork_style": "bold clean contours, rounded geometric anatomy, playful heroic proportions, extremely readable silhouettes, energetic visual clarity", "anime__hayao_miyazaki_film_aesthetic": "Hayao Miyazaki film aesthetic, Spirited Away and The Wind Rises used for visual reference, handcrafted animation warmth, natural motion rhythm, painterly background depth, humane expression, organic form language, clear staging, soft mythic feeling", "anime__makoto_shinkai_cinematic_visual_style": "Makoto Shinkai cinematic animation, Your Name, Weathering with You, and 5 Centimeters per Second used for visual reference, luminous atmospheric light, crystalline color transitions, reflective surface polish, clean modern anime realism, emotionally heightened composition", "anime__satoshi_kon_visual_storytelling_style": "Satoshi Kon cinematic anime visual language, Perfect Blue, Millennium Actress, and Paprika used as visual references for psychological editorial framing, reality-dream transition logic, precise urban staging, mature character realism, controlled color tension, graphic match-cut clarity, and surreal grounded atmosphere", "anime__mamoru_hosoda_animation_style": "warm expressive acting, clean movement rhythm, sunlit color softness, emotionally direct staging, friendly modern polish", "anime__naoko_takeuchi_manga_art_style": "elegant elongated forms, decorative line grace, jewel-like color accents, delicate glamour, refined romantic stylization", "anime__yoshiaki_kawajiri_action_visual_style": "hard-edged contour drama, sharp kinetic tension, sleek high-contrast energy, severe tonal force, striking silhouette authority",  "anime__clamp_character_design_style": "elongated elegant anatomy, decorative precision, ornate line finesse, graceful stylization, dramatic compositional elegance",  "anime__neon_genesis_evangelion_aesthetic": "angular design discipline, stark contrast control, psychological tension, minimal-yet-severe framing, coded color restraint",  "anime__your_name_cinematic_anime_style": "Makoto Shinkai cinematic animation language, Your Name used for visual reference, luminous atmospheric light, crystalline color transitions, reflective surface polish, delicate depth, clean modern anime realism", "anime__spirited_away_visual_aesthetic": "Studio Ghibli and Hayao Miyazaki visual language, Spirited Away used for visual reference, handcrafted line softness, warm color rhythm, painterly background treatment, fluid animation charm, tactile atmosphere", "anime__princess_mononoke_visual_style": "Princess Mononoke visual language, hand-painted mythic animation, earthy color harmony, tactile environmental texture, solemn dramatic staging, disciplined contour, organic movement, intense natural atmosphere", "anime__attack_on_titan_visual_tone": "tense dynamic perspective, sharp action readability, gritty value structure, urgent motion emphasis, severe visual pressure", "anime__one_piece_expressive_animation_style": "elastic silhouette language, bold exaggeration, vivid color punch, lively motion emphasis, adventurous visual energy", "anime__naruto_shonen_anime_style": "clear shonen readability, punchy motion rhythm, dynamic pose logic, strong silhouette clarity, energetic line flow", "anime__sailor_moon_magical_girl_aesthetic": "graceful elongated forms, sparkling highlights, elegant line rhythm, decorative delicacy, luminous feminine polish",   "anime__modern_shonen_anime_visual_style": "sharp high-energy linework, vivid contrast control, clean stylized anatomy, aggressive readability, fast visual rhythm",    "cinematic_realism__denis_villeneuve_cinematic_style": "Denis Villeneuve cinematic language, Arrival, Blade Runner 2049, and Dune used as visual references for monumental restraint, patient widescreen framing, austere scale, quiet negative space, atmospheric color discipline, pr