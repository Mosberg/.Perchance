// ─────────────────────────────────────────────
// 1) RIGHT UI PAYLOAD READER — JS BRIDGE ONLY
// ─────────────────────────────────────────────
// M9B CONTRACT: This block is the sole LEFT-side reader for RIGHT UI draft payload.
// It may normalize values for safety/backward compatibility, but it must not rename
// the storage key or require a migration.

loopDraftRaw = [(()=>{try{return String(localStorage.getItem("loopImageCreateDraft")||"{}")}catch(e){return "{}"}})()]

loopDraftSubject = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");return String(d.subject||d.prompt||d.image_prompt||"").trim();}catch(e){return ""}})()]
loopDraftNameTitle = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");return String(d.name_title||"").trim();}catch(e){return ""}})()]
loopDraftAssetDescription = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");return String(d.asset_description||"").trim();}catch(e){return ""}})()]
loopDraftNegativeGuard = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");return String(d.negative_guard||"").trim().replace(/\s+/g," ").slice(0,1200);}catch(e){return ""}})()]

loopDraftGenerationMode = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let m=String(d.generation_mode||d.image_type||"Image").trim();let map={"Free":"Image","Free Image":"Image","Image":"Image","Avatar":"Presence","Character":"Presence","Character Avatar":"Presence","Presence":"Presence","World":"World View","World Preview":"World View","World View":"World View","Map":"World Map","World Map":"World Map","Scene":"Journey Scene","Story Scene":"Journey Scene","Journey Scene":"Journey Scene"};return map[m]||"Image";}catch(e){return "Image"}})()]
loopDraftRenderCore = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let c=String(d.render_core||"MORO Core Style v1").trim();if(c==="Sword & Sorcery Painting"||c==="Tolkien Illustration")return "High Fantasy";if(c==="MORO Sample"||c==="MORO Sample Style"||c==="MORO STYLE (Sample)")return "MORO Core Style v1";if(c==="Graphic Illustration"||c==="Editorial Illustration")return "MORO Core Style v1";return c||"MORO Core Style v1";}catch(e){return "MORO Core Style v1"}})()]
loopDraftSignatureFlavor = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let s=String(d.signature_flavor||"None").trim();let blocked=["3d render \u2014 architectural visualization (archviz) style","3d render \u2014 archviz","3d render \u2014 ash thorp","3d render \u2014 blade runner 2049","3d render \u2014 blade runner 2049 environment","3d render \u2014 cinematic vfx","3d render \u2014 cinematic vfx render","3d render \u2014 game engine real-time","3d render \u2014 game engine realtime","3d render \u2014 hard-surface modeling","3d render \u2014 hard-surface modeling style","3d render \u2014 high-end","3d render \u2014 jakub javora","3d render \u2014 jeremiah shaw","3d render \u2014 organic 3d","3d render \u2014 pbr material realism","3d render \u2014 pbr-based","3d render \u2014 photorealistic cgi","3d render \u2014 product visualization","3d render \u2014 ready player one","3d render \u2014 soft organic 3d","3d render \u2014 the matrix","3d render \u2014 the matrix cgi","3d render \u2014 tron: legacy","3d render \u2014 vitaly bulgarov","anime \u2014 90s anime","anime \u2014 akira (1988)","anime \u2014 classic 80s","anime \u2014 classic 80s anime","anime \u2014 contemporary","anime \u2014 contemporary cinematic anime","anime \u2014 cowboy bebop","anime \u2014 sakuga-driven","anime \u2014 sakuga-driven animation","anime \u2014 shinichiro watanabe","cinematic realism \u2014 alfonso cuar\u00f3n","cinematic realism \u2014 alfonso cuar\u00f3n long-take cinematic style","cinematic realism \u2014 anamorphic","cinematic realism \u2014 anamorphic cinematic","cinematic realism \u2014 blade runner (1982)","cinematic realism \u2014 blade runner 2049","cinematic realism \u2014 blade runner 2049 cinematic","cinematic realism \u2014 christopher nolan","cinematic realism \u2014 contemporary realistic cinema","cinematic realism \u2014 contemporary realistic cinematic style","cinematic realism \u2014 david fincher","cinematic realism \u2014 david fincher controlled realism style","cinematic realism \u2014 film grain","cinematic realism \u2014 high-contrast digital cinema","cinematic realism \u2014 high-contrast digital cinema style","cinematic realism \u2014 inception","cinematic realism \u2014 inception dream-layer","cinematic realism \u2014 interstellar","cinematic realism \u2014 interstellar space cinematic style","cinematic realism \u2014 modern blockbuster","cinematic realism \u2014 modern blockbuster cinematic style","cinematic realism \u2014 neo-noir","cinematic realism \u2014 neo-noir cinematic","cinematic realism \u2014 quentin tarantino","cinematic realism \u2014 quentin tarantino framing and composition style","cinematic realism \u2014 stanley kubrick","cinematic realism \u2014 stanley kubrick precise visual composition style","cinematic realism \u2014 the dark knight","cinematic realism \u2014 the dark knight gritty cinematic tone","cinematic realism \u2014 the matrix","cinematic realism \u2014 the matrix (1999)","cinematic realism \u2014 wong kar-wai","cinematic realism \u2014 wong kar-wai atmospheric cinematic style","comic \u2014 indie","comic \u2014 indie comic","editorial illustration \u2014 adrian johnson","editorial illustration \u2014 adrian johnson conceptual","editorial illustration \u2014 bea feitler","editorial illustration \u2014 communicative stylized","editorial illustration \u2014 communicative stylized image design","editorial illustration \u2014 concept-led","editorial illustration \u2014 concept-led illustration","editorial illustration \u2014 conceptual editorial","editorial illustration \u2014 conceptual editorial tone","editorial illustration \u2014 editorial magazine","editorial illustration \u2014 editorial magazine layout","editorial illustration \u2014 idea-forward illustration","editorial illustration \u2014 magazine concept","editorial illustration \u2014 mario wagner","editorial illustration \u2014 mario wagner modern editorial","editorial illustration \u2014 modern edi