loop_signature_compat_loop_style_v1
  keep ASW Core Style v1 dominant: silent mythic realism, cinematic restraint, atmospheric world memory, clear subject readability, elegant cultural traces, soft environmental depth, restrained ornament, grounded fantasy language

loop_signature_compat_anime
  keep anime visual grammar dominant: anime-native facial construction, clean drawing discipline, stylized anatomy, expressive eyes, controlled anime shading

loop_signature_compat_cinematic
  keep cinematic realism dominant: believable textures, grounded lighting, lens-aware composition, realistic spatial depth, no cartoon takeover

loop_signature_compat_comic
  keep comic language dominant: ink authority, strong silhouettes, panel readability, graphic shadow design, no soft photoreal drift

loop_signature_compat_3d
  keep stylized 3D dominant: coherent geometry, polished material logic, volumetric form, cinematic 3D lighting, no flat illustration takeover



loop_signature_compat_high_fantasy
  keep High Fantasy dominant: mythic illustration, painterly fantasy atmosphere, lore-rich environment, heroic or ancient-world scale, no generic modern fantasy poster flattening

loop_legacy_style_flavor_authority_layer = [(()=>{try{let flavor=String(loopDraftSignatureFlavor||"None").trim();let core=String(loopDraftRenderCore||"MORO Core Style v1").trim();if(!flavor||flavor==="None")return "";let genericCore=core==="MORO Core Style v1"?"generic fantasy art":(core==="3D Render"?"generic 3D render":(core==="Cinematic Realism"?"generic cinematic realism":(core==="High Fantasy"?"generic fantasy art":("generic "+core.toLowerCase()))));return "legacy MORO style flavor authority: strongly apply "+flavor+" as the selected visual influence; make this influence immediately visible and recognizable inside the selected "+core+" core; preserve the core medium, but let "+flavor+" strongly shape line logic, rendering behavior, silhouette language, atmosphere, color behavior, and detail emphasis; do not dilute the result into "+genericCore;}catch(e){return ""}})()]


