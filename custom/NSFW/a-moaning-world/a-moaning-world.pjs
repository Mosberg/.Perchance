            else if (typeof window.loopApplyUserCommentIdentity === "function") window.loopApplyUserCommentIdentity(com);
          } catch(e) {}
        },
        adminPasswordHash: "036a2f6b57c1f9ba76acccbd2d43476f5fd020ad1b5848a7cfbb09c9ce44731d",
        adminFlair: "👑MOD👑"
