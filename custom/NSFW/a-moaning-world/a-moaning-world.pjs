// Human-readable checkpoint marker only.
// ============================================================================
aswNativePhase
  checkpoint = ASW_LEFT_DAY_MODE_RESTORE_1A_GALLERY_COMMENTS_PARITY_2026-07-21
  direction = Current MORO/ASW image render engine preserved; LEFT Comments, Public Gallery, Gallery Comments plugin, and Gallery Comments modal follow the persisted ASW Ash/Day or Midnight/Night shell theme
  focus = Restores end-to-end LEFT Day Mode parity without changing storage keys, gallery channels, moderation rules, Image Engine prompt assembly, render options, Presence/Library imports, or bridge identities
  moroRenderContract = localStorage.loopImageCreateDraft, final_prompt, loop_negative_prompt, loopImageRenderOptions, loopImageRenderOutput, loopBridge*
  accRole = donor/reference only
  activeRuntime = ASW right panel
  storage = ASW storage unchanged; MORO loopImageCreateDraft preserved as compatibility payload key for Visions
  ai = ai-text-plugin singular import
  noACCUI = true
  noACCDOM = true
  noACCPatching = true

