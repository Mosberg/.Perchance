loopHasRenderableSubject = [loopDraftSubject ? 1 : 0]
loop_subject_layer = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let subject=String(loopDraftSubject||"").trim().replace(/\s+/g," ");if(!subject)return "";let isCustom=String(d.style_source||"core").trim().toLowerCase()==="custom"&&String(d.custom_style_prompt||"").trim();if(isCustom)return subject;let key=String(d.style_flavor_key||"").trim();if(!key||key.endsWith("__none"))return subject;let prefix={"high_fantasy__frank_frazetta_painting_style":"Frank Frazetta-inspired heroic fantasy oil painting of ","high_fantasy__alan_lee_tolkien_inspired_fantasy_art_style":"Alan Lee-inspired pencil-and-watercolor fantasy illustration of ","high_fantasy__john_howe_epic_fantasy_illustration_style":"John Howe-inspired epic fantasy illustration of ","high_fantasy__brom_artwork_style":"Brom-inspired dark fantasy painting of ","high_fantasy__dark_souls_atmospheric_fantasy_style":"Dark Souls-inspired atmospheric fantasy concept art of ","comic__moebius_ligne_claire_comic_style":"Moebius-inspired ligne-claire sci-fantasy illustration of ","comic__moebius_jean_giraud_ligne_claire_comic_style":"Moebius-inspired ligne-claire sci-fantasy illustration of ","loop_core_style_v1__moebius_horizon":"Moebius-inspired ligne-claire sci-fantasy illustration of ","loop_core_style_v1__franco_belgian_lumiere":"Franco-Belgian ligne-claire comic illustration of ","loop_core_style_v1__grounded_ghibli_realism":"Studio Ghibli-inspired fantasy animation artwork of ","anime__hayao_miyazaki_film_aesthetic":"Hayao Miyazaki-inspired feature-animation artwork of ","anime__princess_mononoke_visual_style":"hand-painted mythic Studio Ghibli-style animation artwork of ","anime__makoto_shinkai_cinematic_visual_style":"Makoto Shinkai-inspired cinematic anime artwork of ","anime__satoshi_kon_visual_storytelling_style":"Satoshi Kon-inspired psychological cinematic anime artwork of ","anime__your_name_cinematic_anime_style":"Makoto Shinkai-inspired cinematic anime film still of ","anime__spirited_away_visual_aesthetic":"Studio Ghibli-style handcrafted animation artwork of ","loop_core_style_v1__disney_atelier":"classic Disney feature-animation-inspired storybook artwork of ","loop_core_style_v1__graphic_nocturne":"Graphic Nocturne mature shadow-led illustration of ","loop_core_style_v1__majestic_reverie":"Majestic Reverie luminous romantic fantasy painting of ","cinematic_realism__classic_hollywood_cinematic_style":"classic Hollywood-inspired film-still artwork of ","cinematic_realism__denis_villeneuve_cinematic_style":"Denis Villeneuve-inspired cinematic realism artwork of ","cinematic_realism__dune_2021_visual_tone":"Dune-inspired austere cinematic sci-fantasy still of ","cinematic_realism__mad_max_fury_road_cinematic_action_style":"Mad Max Fury Road-inspired kinetic cinematic action artwork of ","cinematic_realism__the_revenant_natural_lighting_style":"The Revenant-inspired natural-light cinematic realism artwork of ","3d_render__simon_stalenhag_hybrid_realism_style":"Simon Stålenhag-inspired retro-future realism illustration of ","3d_render__arcane_fortiche_painterly_animation_style":"Arcane / Fortiche-inspired painterly 3D animation artwork of ","3d_render__pixar_inspired_stylized_3d_animation_style":"Pixar-inspired stylized 3D feature-animation artwork of ","3d_render__laika_stop_motion_cinematic_style":"LAIKA-inspired tactile stop-motion animation artwork of ","3d_render__ian_hubert_practical_vfx_realism":"Ian Hubert-inspired practical VFX realism artwork of ","3d_render__beeple_surreal_3d_style":"Beeple-inspired surreal digital 3D artwork of ","anime__akira_toriyama_artwork_style":"Akira Toriyama-inspired J-fantasy manga-game illustration of ","anime__one_piece_expressive_animation_style":"Eiichiro Oda / One Piece-inspired expressive adventure manga artwork of ","anime__attack_on_titan_visual_tone":"Hajime Isayama-inspired dark action manga artwork of ","comic__one_piece_manga_visual_style":"Eiichiro Oda-inspired expressive manga illustration of ","comic__attack_on_titan_manga_tone":"Hajime Isayama-inspired severe manga illustration of ","comic__akira_manga_panel_style":"Katsuhiro Otomo-inspired detailed cinematic manga illustration of ","comic__manga_panel_storytelling_style":"manga-panel-inspired narrative illustration of ","comic__frank_miller_comic_style":"Frank Miller-inspired noir comic illustration of ","comic__jim_lee_superhero_art_style":"Jim Lee-inspired mainstream comic illustration of ","comic__todd_mcfarlane_dynamic_ink_style":"Todd McFarlane-inspired dynamic ink comic illustration of ","comic__alex_ross_realistic_comic_painting_style":"Alex Ross-inspired painted comic illustration of "};return (prefix[key]||"")+subject}catch(e){return String(loopDraftSubject||"").trim()}})()]
loop_subject_fidelity_guard_layer
  Preserve the user subject faithfully; keep the requested subject identity, apparent gender presentation if specified, species if specified, action, clothing, props, mood, and setting. Style must enhance the user subject, not replace it.
