  [loop_style_flavor_authority_alexross] ^[loopDraftSignatureFlavor == "Comic — Alex Ross"]
  [loop_style_flavor_authority_arcane] ^[loopDraftSignatureFlavor == "3D — Arcane" || loopDraftSignatureFlavor == "3D Render — Arcane"]
  [loop_style_flavor_authority_pixar] ^[loopDraftSignatureFlavor == "3D — Pixar" || loopDraftSignatureFlavor == "3D Render — Pixar"]
  [loop_style_flavor_authority_beeple] ^[loopDraftSignatureFlavor == "3D Render — Beeple"]
  [loop_style_flavor_authority_frazetta] ^[loopDraftSignatureFlavor == "High Fantasy — Frank Frazetta" || loopDraftSignatureFlavor == "Sword & Sorcery — Frank Frazetta"]
  [loop_style_flavor_authority_alanlee] ^[loopDraftSignatureFlavor == "High Fantasy — Alan Lee" || loopDraftSignatureFlavor == "Tolkien — Alan Lee"]
  [loop_style_flavor_authority_johnhowe] ^[loopDraftSignatureFlavor == "High Fantasy — John Howe" || loopDraftSignatureFlavor == "Tolkien — John Howe"]

loop_style_flavor_authority_shinkai
  make Makoto Shinkai influence clearly visible inside anime core: luminous sky drama, reflective surfaces, emotionally radiant backlight, clean modern anime polish, atmospheric weather, romantic color separation, cinematic city-or-sky framing, beautiful environmental glow

loop_style_flavor_authority_miyazaki
  make Hayao Miyazaki influence clearly visible inside anime core: hand-crafted fantasy warmth, humane expressions, organic motion, whimsical environmental life, natural wonder, soft painterly air, gentle but vivid color harmony, quiet magical atmosphere

