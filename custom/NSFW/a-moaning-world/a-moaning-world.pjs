// NOTE: This is Perchance lists-editor function DSL, not raw JavaScript.
// A multi-line body after `=>` is valid here; do not convert it to JS braces.
showASWGalleryCommentModal(commentsHtml, data, accentColor, colorMode) =>
  const old = document.getElementById('asw-gallery-comment-modal');
  if (old) old.remove();

  const accent = /^#[0-9a-fA-F]{3,8}$/.test(String(accentColor || '').trim()) ? String(accentColor).trim() : '#B69A67';
  const mode = String(colorMode || '').trim().toLowerCase() === 'light' ? 'light' : 'dark';
  const modalChrome = mode === 'light' ? '#FAF8F3' : '#1B1E1F';
  const modalDepth = mode === 'light' ? '#F1EEE7' : '#111313';
  const modalField = mode === 'light' ? '#E5E1D8' : '#202324';
  const modalText = mode === 'light' ? '#29251F' : '#EDE6D8';
  const modalMuted = mode === 'light' ? 'rgba(59,53,43,.70)' : 'rgba(237,230,216,.62)';
  const modalBorder = mode === 'light' ? 'rgba(41,37,31,.14)' : 'rgba(237,230,216,.12)';
  const modalOnAccent = String(accent).toUpperCase() === '#FB7906' ? '#17130E' : '#FFFFFF';
  const modalBackdrop = mode === 'light' ? 'rgba(41,37,31,.30)' : 'rgba(19,21,22,.66)';

  const imageUrl = (() => {
    const safe = value => {
      const url = String(value || '').trim();
      if (!url) return '';
      if (/^(https?:|blob:)/i.test(url)) return url;
      if (/^data:image\//i.test(url)) return url;
      return '';
    };
    const d = data || {};
    const nestedOutput = d.textToImagePluginOutput || d.output || d.result || {};
    const candidates = [
      d.imageUrl,
      d.image_url,
      d.url,
      d.src,
      d.dataUrl,
      d.image,
      nestedOutput.imageUrl,
      nestedOutput.image_url,
      nestedOutput.url,
      nestedOutput.src,
      nestedOutput.dataUrl,
      nestedOutput.image
    ];
    for (const candidate of candidates) {
      const resolved = safe(candidate);
      if (resolved) return resolved;
    }
    return '';
  })();

  const overlay = document.createElement('div');
  overlay.id = 'asw-gallery-comment-modal';
  overlay.setAttribute('data-asw-theme', mode);
  overlay.tabIndex = 0;
  overlay.style.cssText = `
    position: fixed;
    inset: 0;
    z-index: 100002;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    background: ${modalBackdrop};
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-sizing: border-box;
    font-family: "Zilla Slab", Georgia, "Times New Roman", serif;
    color-scheme: ${mode};
  `;

  overlay.innerHTML = `
    <style>
      #asw-gallery-comment-modal * { box-sizing: border-box; }
      #asw-gallery-comment-modal { color-scheme: ${mode}; }
      #asw-gallery-comment-modal .asw-gallery-comment-card {
        width: min(520px, calc(100vw - 24px)) !important;
        max-width: calc(100vw - 24px) !important;
        height: auto !important;
        max-height: calc(100dvh - 24px) !important;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: var(--asw-modal-radius-small, 4px);
        border: 1px solid ${modalBorder};
        background: ${modalChrome};
        color: ${modalText};
        box-shadow: none;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-head {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 10px;
        border-bottom: 1px solid ${modalBorder};
        background: ${modalChrome};
        flex: 0 0 auto;
        position: relative;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-title-wrap {
        min-width: 0;
        display: grid;
        gap: 2px;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-title {
        font-size: var(--asw-type-section-title-size, 1.125rem);
        line-height: 1.15;
        font-weight: 650;
        color: ${modalText};
      }
      #asw-gallery-comment-modal .asw-gallery-comment-subtitle {
        font-size: var(--asw-type-meta-size, .75rem);
        line-height: 1.25;
        color: ${modalMuted};
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-close {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid ${modalBorder};
        border-radius: var(--asw-modal-radius-small, 4px);
        background: ${modalDepth};
        color: ${modalText};
        font-size: 19px;
        line-height: 1;
        cursor: pointer;
        flex: 0 0 auto;
        position: static !important;
        inset: auto !important;
        top: auto !important;
        right: auto !important;
        margin-left: auto;
        align-self: center;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-close:hover,
      #asw-gallery-comment-modal .asw-gallery-comment-close:focus-visible {
        background: color-mix(in srgb, ${accent} 88%, #131516);
        border-color: ${accent};
        color: ${modalOnAccent};
        outline: none;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-main {
        flex: 0 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: start;
        background: ${modalChrome};
        overflow: hidden;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview {
        width: min(184px, 31vw);
        min-width: 132px;
        min-height: 0;
        display: grid;
        align-content: start;
        background: transparent;
        border-right: 0;
        overflow: visible;
        align-self: start;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="portrait"] { width: min(148px, 28vw); }
      #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="square"] { width: min(160px, 29vw); }
      #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="landscape"] { width: min(184px, 31vw); }
      #asw-gallery-comment-modal .asw-gallery-comment-preview-frame {
        width: 100%;
        min-height: 0;
        max-height: 232px;
        aspect-ratio: var(--asw-comment-preview-ratio, 1 / 1);
        display: grid;
        place-items: center;
        background: ${modalDepth};
        overflow: hidden;
        border-right: 1px solid ${modalBorder};
        border-radius: var(--asw-modal-radius-small, 4px) 0 0 var(--asw-modal-radius-small, 4px);
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview-img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        object-position: center center;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        background: transparent;
        opacity: 0;
        visibility: hidden;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview.is-loaded .asw-gallery-comment-preview-img {
        opacity: 1;
        visibility: visible;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview-empty {
        min-height: 132px;
        display: grid;
        place-items: center;
        padding: 14px;
        color: ${modalMuted};
        font-size: var(--asw-type-meta-size, .75rem);
        line-height: 1.35;
        text-align: center;
        background: ${modalDepth};
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview.is-loaded .asw-gallery-comment-preview-empty { display: none; }
      #asw-gallery-comment-modal .asw-gallery-comment-body {
        min-width: 0;
        min-height: 208px;
        width: 100% !important;
        height: min(248px, calc(100dvh - 118px)) !important;
        max-height: calc(100dvh - 118px) !important;
        max-width: 100% !important;
        overflow: hidden;
        background: ${modalChrome};
        padding: 0;
        align-self: start;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body > * {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        max-width: 100% !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body textarea,
      #asw-gallery-comment-modal .asw-gallery-comment-body input,
      #asw-gallery-comment-modal .asw-gallery-comment-body button {
        font-family: "Zilla Slab", Georgia, "Times New Roman", serif !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body textarea {
        border-radius: var(--asw-modal-radius-small, 4px) !important;
        padding: 9px 10px !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body button,
      #asw-gallery-comment-modal .asw-gallery-comment-body input[type="button"],
      #asw-gallery-comment-modal .asw-gallery-comment-body input[type="submit"] {
        min-height: 30px !important;
        border-radius: var(--asw-modal-radius-small, 4px) !important;
        opacity: 1 !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body button[type="submit"],
      #asw-gallery-comment-modal .asw-gallery-comment-body input[type="submit"] {
        background: ${accent} !important;
        color: ${modalOnAccent} !important;
        border: none !important;
        font-weight: 650 !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body iframe,
      #asw-gallery-comment-modal .asw-gallery-comment-body > div {
        background: ${modalChrome} !important;
        color: ${modalText} !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body textarea,
      #asw-gallery-comment-modal .asw-gallery-comment-body input {
        background: ${modalDepth} !important;
        color: ${modalText} !important;
        border-color: ${modalBorder} !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body textarea::placeholder,
      #asw-gallery-comment-modal .asw-gallery-comment-body input::placeholder {
        color: ${modalMuted} !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-body textarea:focus,
      #asw-gallery-comment-modal .asw-gallery-comment-body input:focus,
      #asw-gallery-comment-modal .asw-gallery-comment-body button:focus-visible {
        border-color: ${accent} !important;
        box-shadow: 0 0 0 1px ${accent} inset !important;
        outline: none !important;
      }
      #asw-gallery-comment-modal .asw-gallery-comment-preview-frame { box-shadow: inset 0 0 0 1px ${mode === 'light' ? 'rgba(41,37,31,.035)' : 'rgba(237,230,216,.04)'}; }
      @media (max-width: 760px) {
        #asw-gallery-comment-modal {
          align-items: flex-end;
          justify-content: center;
          padding: 10px;
        }
        #asw-gallery-comment-modal .asw-gallery-comment-card {
          width: calc(100vw - 16px) !important;
          height: auto !important;
          max-height: min(80dvh, calc(100dvh - 14px)) !important;
          border-radius: var(--asw-modal-radius-small, 4px);
        }
        #asw-gallery-comment-modal .asw-gallery-comment-main {
          grid-template-columns: 1fr;
          grid-template-rows: auto minmax(0, auto);
          align-items: start;
        }
        #asw-gallery-comment-modal .asw-gallery-comment-preview,
        #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="portrait"],
        #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="square"],
        #asw-gallery-comment-modal .asw-gallery-comment-preview[data-orientation="landscape"] {
          width: min(100%, 240px);
          justify-self: center;
          max-height: 30dvh;
          border-right: 0;
          border-bottom: 0;
        }
        #asw-gallery-comment-modal .asw-gallery-comment-preview-frame {
          min-height: 0;
          max-height: 30dvh;
          border-right: 0;
          border-bottom: 1px solid ${modalBorder};
        }
        #asw-gallery-comment-modal .asw-gallery-comment-preview-img {
          width: 100%;
          height: 100%;
          max-width: 100%;
          max-height: 30dvh;
          justify-self: center;
        }
        #asw-gallery-comment-modal .asw-gallery-comment-body {
          height: min(296px, calc(100dvh - 176px)) !important;
          min-height: 242px;
        }
        #asw-gallery-comment-modal .asw-gallery-comment-preview-empty { min-height: 96px; }
        #asw-gallery-comment-modal .asw-gallery-comment-subtitle { display: none; }
      }
    </style>
    <section class="asw-gallery-comment-card" role="dialog" aria-modal="true" aria-label="Image Gallery Comments">
      <div class="asw-gallery-comment-head">
        <div class="asw-gallery-comment-title-wrap">
          <div class="asw-gallery-comment-title">Image Gallery Comments</div>
          <div class="asw-gallery-comment-subtitle">Comments attached to this image</div>
        </div>
        <button class="asw-gallery-comment-close" type="button" aria-label="Close">×</button>
      </div>
      <div class="asw-gallery-comment-main">
        <aside class="asw-gallery-comment-preview" data-orientation="unknown" aria-label="Commented image preview">
          <div class="asw-gallery-comment-preview-frame">
            <div class="asw-gallery-comment-preview-empty">No image preview</div>
            <img class="asw-gallery-comment-preview-img" alt="Gallery image preview" loading="eager" decoding="async">
          </div>
        </aside>
        <div class="asw-gallery-comment-body">
          ${commentsHtml || ""}
        </div>
      </div>
    </section>
  `;

  const close = () => overlay.remove();
  overlay.addEventListener('mousedown', e => { if (e.target === overlay) close(); });
  overlay.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  overlay.querySelector('.asw-gallery-comment-close').onclick = close;

  document.body.appendChild(overlay);

  const preview = overlay.querySelector('.asw-gallery-comment-preview');
  const previewFrame = overlay.querySelector('.asw-gallery-comment-preview-frame');
  const img = overlay.querySelector('.asw-gallery-comment-preview-img');
  const empty = overlay.querySelector('.asw-gallery-comment-preview-empty');
  let previewLoadTimer = null;
  if (imageUrl && preview && img) {
    if (empty) empty.textContent = 'Loading image...';
    img.onload = () => {
      if (previewLoadTimer) clearTimeout(previewLoadTimer);
      const w = img.naturalWidth || 1;
      const h = img.naturalHeight || 1;
      preview.classList.add('is-loaded');
      preview.setAttribute('data-orientation', w > h ? 'landscape' : h > w ? 'portrait' : 'square');
      preview.style.setProperty('--asw-comment-preview-ratio', `${w} / ${h}`);
      if (previewFrame) previewFrame.style.setProperty('--asw-comment-preview-ratio', `${w} / ${h}`);
    };
    img.onerror = () => {
      if (previewLoadTimer) clearTimeout(previewLoadTimer);
      preview.classList.remove('is-loaded');
      preview.setAttribute('data-orientation', 'missing');
      if (empty) empty.textContent = 'Image preview unavailable';
    };
    previewLoadTimer = setTimeout(() => {
      if (preview.classList.contains('is-loaded')) return;
      preview.setAttribute('data-orientation', 'missing');
      if (empty) empty.textContent = 'Image preview unavailable';
    }, 8000);
    img.src = imageUrl;
  } else if (preview) {
    preview.setAttribute('data-orientation', 'missing');
  }

  setTimeout(() => overlay.focus(), 0);


// ============================================================================
