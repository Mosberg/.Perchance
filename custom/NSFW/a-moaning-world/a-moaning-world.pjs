  world view image, environment concept art, strong sense of place

loop_mode_compact_map
  world map image, readable geography, routes, landmarks, zone anchors

loop_mode_compact_story
  journey scene image, cinematic narrative still


loop_quality_compact_layer = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let isCustom=String(d.style_source||"core").trim().toLowerCase()==="custom"&&String(d.custom_style_prompt||"").trim();if(isCustom)return "";let key=String(d.style_flavor_key||"").trim();if(key&&!key.endsWith("__none"))return "world-class finished artwork, aesthetically pleasing composition, crisp detail, rich atmosphere, high-resolution polish, strong visual coherence";let c=String(d.render_core||"MORO Core Style v1").trim();if(c==="Sword & Sorcery Painting"||c==="Tolkien Illustration")c="High Fantasy";if(c==="MORO Sample"||c==="MORO Sample Style"||c==="MORO STYLE (Sample)")c="MORO Core Style v1";let map={"MORO Core Style v1":"refined ASW fantasy image, elegant readability, atmospheric polish, controlled detail, quiet cinematic finish","Anime":"best quality anime artwork, masterpiece anime illustration, crisp anime finish, clean line fidelity, strong character readability, high color separation, clean detail fidelity","Cinematic Realism":"overall an absolute world-class cinematic masterpiece, aesthetically pleasing cinematic shot, impeccable attention to detail, impressive composition, high-end film still, premium cinematic image","Comic":"best quality comic artwork, masterpiece comic illustration, crisp ink clarity, graphic print impact, clear panel-space storytelling, confident contour authority, polished comic finish","3D Render":"premium 3D render quality, refined material fidelity, excellent dimensional clarity, polished surface response, high-end CGI finish, clean detail fidelity","High Fantasy":"refined fantasy illustration, painterly detail fidelity, rich atmosphere, immersive mythic depth, strong silhouette clarity, best quality, clean detail fidelity"};return map[c]||map["MORO Core Style v1"]}catch(e){return "world-class finished artwork, aesthetically pleasing composition, crisp detail, rich atmosphere, high-resolution polish"}})()]

loop_signature_key_layer
  [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");if(String(d.style_source||"core").trim().toLowerCase()==="custom"&&String(d.custom_style_prompt||"").trim())return "";let key=String(d.style_flavor_key||"").trim();if(!key||key.endsWith("__none"))return "";let tuned={"high_fantasy__frank_frazetta_painting_style":'inspired by Frank Frazetta fantasy cover-painting language, with his heroic fantasy oil-painting period used as visual reference for muscular brush energy, sculptural anatomy rhythm, smoky dramatic chiaroscuro, hot earth-metal color, primal mythic intensity, and powerful composition',"high_fantasy__alan_lee_tolkien_inspired_fantasy_art_style":'inspired by Alan Lee fantasy illustration language, with The Lord of the Rings and The Hobbit illustration work used as visual references for delicate pencil-and-watercolor handling, misted atmospheric depth, softly weathered linework, muted earth palette, archaeological texture, quiet ancient mystery, and restrained lyrical composition',"high_fantasy__john_howe_epic_fantasy_illustration_style":'inspired by John Howe epic fantasy illustration and Tolkien concept-design language, using Middle-earth illustration and The Lord of the Rings concept art as visual references for precise dramatic draftsmanship, heraldic silhouette discipline, quest-driven composition, weathered material credibility, and monumental mythic clarity',"high_fantasy__brom_artwork_style":'inspired by Brom dark fantasy artwork, with The Child Thief and The Plucker used as visual references for gothic painterly realism, smoky brown-black tonal mass, gaunt figure drama, bruised texture, haunted elegance, and severe shadowed atmosphere',"high_fantasy__dark_souls_atmospheric_fantasy_style":'inspired by Dark Souls atmospheric fantasy art and Dark Souls: Design Works, using the source as visual reference for bleak medieval-fantasy concept-art mood, decayed grandeur, ash-grey muted palette, oppressive spatial stillness, solemn silhouette design, corroded texture, and tragic monumental atmosphere',"comic__moebius_ligne_claire_comic_style":'inspired by Moebius / Jean Giraud visual language, with Arzach, The Airtight Garage, and The Incal used as visual references for clean ligne-claire contour, surreal sci-fantasy clarity, airy flat color, exact elegant line weight, spacious open composition, strange calm, and graphic dream logic',"comic__moebius_jean_giraud_ligne_claire_comic_style":'inspired by Moebius / Jean Giraud visual language, with Arzach, The Airtight Garage, and The Incal used as visual references for clean ligne-claire contour, surreal sci-fantasy clarity, airy flat color, exact elegant line weight, spacious open composition, strange calm, and graphic dream logic',"loop_core_style_v1__moebius_horizon":'inspired by Moebius / Jean Giraud visual language, with Arzach, The Airtight Garage, and The Incal used as visual references for clean ligne-claire contour, surreal sci-fantasy clarity, airy flat color, exact elegant line weight, spacious open composition, strange calm, and graphic dream logic',"loop_core_style_v1__franco_belgian_lumiere":'inspired by Franco-Belgian bande dessinée and ligne claire clarity, with The Adventures of Tintin, Spirou, and Valérian and Laureline used as visual references for clear strong contour, clean unhatched line fields, even readable color areas, downplayed contrast, precise silhouette language, lucid staging, and crisp European album-comic composition',"loop_core_style_v1__grounded_ghibli_realism":'inspired by Studio Ghibli and Hayao Miyazaki grounded feature-animation visual language, with Spirited Away, The Wind Rises, and Castle in the Sky used as visual references for hand-painted background softness, humane gesture, warm color restraint, tactile atmosphere, clean readable shapes, gentle motion sensitivity, and emotional clarity',"anime__hayao_miyazaki_film_aesthetic":'inspired by Hayao Miyazaki film aesthetic, with Spirited Away and The Wind Rises used as visual references for handcrafted animation warmth, natural motion rhythm, painterly background depth, humane expression, organic form language, clear staging, and soft mythic feeling',"anime__princess_mononoke_visual_style":'inspired by the visual language of Princess Mononoke, using the film as a visual reference for hand-painted mythic animation, earthy color harmony, tactile environmental texture, solemn dramatic staging, disciplined contour, organic movement, and intense natural atmosphere',"anime__makoto_shinkai_cinematic_visual_style":'inspired by Makoto Shinkai cinematic animation style, with Your Name, Weathering with You, and 5 Centimeters per Second used as visual references for luminous atmospheric light, crystalline color transitions, reflective surface polish, dramatic sky-and-light gradients, clean modern anime realism, and emotionally heightened composition',"anime__your_name_cinematic_anime_style":'inspired by Makoto Shinkai cinematic animation language, with Your Name used as a visual reference for luminous atmospheric light, crystalline color transitions, reflective surface polish, delicate depth, clean modern anime realism, and emotionally heightened composition',"anime__spirited_away_visual_aesthetic":'inspired by Studio Ghibli and Hayao Miyazaki visual language, with Spirited Away used as a visual reference for handcrafted line softness, warm color rhythm, painterly background treatment, fluid animation charm, tactile atmosphere, and emotional clarity',"loop_core_style_v1__disney_atelier":'inspired by classic Disney feature-animation atelier style, with Fantasia and Sleeping Beauty used as visual references for elegant hand-drawn draftsmanship, graceful silhouette design, appealing gesture, storybook color harmony, clean readable staging, and polished animation finish',"loop_core_style_v1__graphic_nocturne":'Graphic Nocturne visual style, mature nocturne illustration with controlled black-shape design, shadow-led composition, restrained color fields, tactile ink-painterly texture, severe graphic rhythm, and serious atmospheric tension',"loop_core_style_v1__majestic_reverie":'Majestic Reverie fantasy illustration style, luminous romantic fantasy painting with graceful painterly detail, radiant soft light, elevated composition, refined color harmony, poetic grandeur, delicate atmosphere, and polished dreamlike finish',"cinematic_realism__classic_hollywood_cinematic_style":"inspired by classic Hollywood film-still language, with studio-era Hollywood still photography used as visual reference for sculpted key light, elegant face-and-form modeling, composed blocking, refined tonal polish, controlled lens-aware depth, theatrical atmosphere, and graceful cinematic staging","cinematic_realism__denis_villeneuve_cinematic_style":"inspired by Denis Villeneuve cinematic language, with Arrival, Blade Runner 2049, and Dune used as visual references for monumental restraint, patient widescreen framing, austere scale, quiet negative space, atmospheric color discipline, precise silhouette geometry, immersive spatial tension, and naturalistic epic light","cinematic_realism__dune_2021_visual_tone":"inspired by Denis Villeneuve's Dune film visual language, with Dune and Dune: Part Two used as visual references for austere epic scale, sculptural production design, natural-light precision, severe tonal separation, low-frequency geometric forms, ceremonial stillness, and monumental sci-fantasy atmosphere","cinematic_realism__mad_max_fury_road_cinematic_action_style":"inspired by Mad Max: Fury Road cinematic action language, with the film used as visual reference for kinetic center-framed motion, practical texture, high-contrast color grading, dust-lit momentum, readable action geometry, graphic impact, and visceral editorial clarity","cinematic_realism__the_revenant_natural_lighting_style":"inspired by The Revenant natural-light cinematography, with the film used as visual reference for available-light realism, cold atmospheric density, tactile environmental texture, immersive camera proximity, subdued palette, and raw physical clarity","3d_render__simon_stalenhag_hybrid_realism_style":"inspired by Simon Stålenhag hybrid realism, with Tales from the Loop, Things from the Flood, and The Electric State used as visual references for melancholic retro-future atmosphere, quiet observational framing, muted natural light, painterly realism, everyday-scale wonder, and restrained speculative mood","3d_render__arcane_fortiche_painterly_animation_style":"inspired by Arcane and Fortiche painterly animation, with Arcane used as visual reference for 2D-3D hybrid animation craft, hand-painted texture, dramatic rim light, expressive shape design, graphic color blocking, kinetic camera energy, and painterly character-material surfaces","3d_render__pixar_inspired_stylized_3d_animation_style":"inspired by Pixar feature-animation visual language, with Toy Story, Ratatouille, and Coco used as visual references for appealing stylized 3D form, warm material clarity, expressive shape language, polished lighting, readable staging, and emotionally accessible composition","3d_render__laika_stop_motion_cinematic_style":"inspired by LAIKA stop-motion feature animation, with Coraline, ParaNorman, and Kubo and the Two Strings used as visual references for tactile handcrafted materials, miniature-scale lighting, sculpted surface detail, physical puppetry charm, moody color craft, and carefully staged stop-motion dimensionality","3d_render__ian_hubert_practical_vfx_realism":"inspired by Ian Hubert practical VFX realism, with Dynamo Dream and the Blender Lazy Tutorials aesthetic used as visual references for lived-in kitbash surfaces, indie cinematic compositing, grounded camera movement, dense practical texture, imperfect physical plausibility, and believable real-world integration","3d_render__beeple_surreal_3d_style":"inspired by Beeple digital 3D artwork, with Everydays and The First 5000 Days used as visual references for hyper-detailed CG density, surreal digital spectacle, glossy synthetic material, bold composition, futuristic color contrast, and sharp rendered polish","anime__akira_toriyama_artwork_style":"inspired by Akira Toriyama manga and game illustration language, with Dragon Quest and Chrono Trigger used as visual references for rounded expressive character construction, clean bold contour, compact readable silhouette, playful adventure energy, confident simple shapes, bright color clarity, and charming fantasy readability","anime__one_piece_expressive_animation_style":"inspired by Eiichiro Oda / One Piece expressive adventure visual language, with One Piece used as visual reference for elastic expressive contour, exaggerated gesture clarity, lively adventure staging, big readable silhouettes, confident cartoon-manga timing, vivid color punch, and buoyant world energy","anime__attack_on_titan_visual_tone":"inspired by Hajime Isayama dark action manga language, with Attack on Titan used as visual reference for severe action-manga pressure, urgent perspective, rough expressive line stress, high-stakes scale, gritty value structure, compressed motion force, and tense dramatic readability","comic__one_piece_manga_visual_style":"inspired by Eiichiro Oda manga visual language, with One Piece used as visual reference for elastic manga contour, lively pose timing, playful exaggerated forms, energetic adventure readability, expressive silhouette rhythm, crisp black-white clarity, and confident graphic humor","comic__attack_on_titan_manga_tone":"inspired by Hajime Isayama manga visual tone, with Attack on Titan used as visual reference for rough line intensity, urgent black-white action pressure, severe value blocking, dramatic scale management, tense page rhythm, kinetic perspective, and hard emotional compression","comic__akira_manga_panel_style":"inspired by Katsuhiro Otomo manga and animation visual language, with Akira used as visual reference for precise architectural draftsmanship, dense cinematic panel logic, crisp perspective control, mature graphic intensity, exact mechanical line discipline, high-pressure urban atmosphere, and controlled motion clarity","comic__manga_panel_storytelling_style":"inspired by manga panel storytelling grammar, with manga page-layout research used as visual reference for sequential visual rhythm, disciplined black-white focus, expressive shot progression, strong value pacing, clean panel-minded composition, readable emotional beats, and controlled graphic timing","comic__frank_miller_comic_style":"inspired by Frank Miller noir comic visual language, with Sin City, 300, and The Dark Knight Returns used as visual references for brutal elegant noir rendering, radical black-shape contrast, angular figure rhythm, stark graphic silhouette, pulpy dramatic staging, lean color emphasis, and hard-edged sequential force","comic__jim_lee_superhero_art_style":"inspired by Jim Lee mainstream American comic art language, with his DC and Image-era interior-page craft used as visual reference for highly detailed dynamic contour, confident figure construction, angular anatomy clarity, crisp hatching discipline, dramatic page energy, polished comic rendering, and strong silhouette readability","comic__todd_mcfarlane_dynamic_ink_style":"inspired by Todd McFarlane dynamic ink comic language, with his creator-owned dark comic pages and late-1980s to 1990s Marvel-era linework used as visual references for dense kinetic ink, wiry flowing linework, exaggerated motion design, intricate negative-space filling, dramatic silhouette distortion, textured dark energy, and high-impact comic-page momentum","comic__alex_ross_realistic_comic_painting_style":"inspired by Alex Ross realistic comic painting language, with Marvels and Kingdom Come used as visual references for gouache-like painted realism, sculptural light, theatrical figure staging, classical poster composition, rich surface modeling, dignified monumental mood, and fine-art comic finish"};if(tuned[key])return tuned[key];let tail=key.split("__").pop().replace(/_/g," ").trim();let proper=s=>s.replace(/\b\w/g,m=>m.toUpperCase()).replace(/\b3d\b/ig,"3D").replace(/\bCgi\b/g,"CGI").replace(/\bVfx\b/g,"VFX").replace(/\bPbr\b/g,"PBR");let display=proper(tail);return display+" artwork style";}catch(e){return ""}})()]



// ─────────────────────────────────────────────
// 9) FINAL PROMPT — LAYERED NATIVE OUTPUT
// ─────────────────────────────────────────────
// M9B CONTRACT: LEFT remains the render authority. RIGHT-side prompt inspectors may
// preview payload interpretation, but only loopEngineFinalPrompt feeds final_prompt here.

loopEngineFinalPrompt
  $output = [this.joinItems(", ")]
  [loop_subject_layer]
  [loop_custom_style_compact_layer]
  [loop_core_compact_layer]
  [loop_signature_key_layer]
  [loop_style_flavor_compact_layer]
  [loop_mode_compact_layer]
  [loop_quality_compact_layer]


// ─────────────────────────────────────────────
// 10) RESOLUTION, METADATA, COMPATIBILITY ALIASES
// ─────────────────────────────────────────────
// M9B CONTRACT: Metadata is for native save/gallery surfaces. Do not append titles,
// notes, style labels, or descriptions into final_prompt unless a future migration
// explicitly changes the render contract.

loopEngineResolution = [(()=>{try{let s=String(loopDraftShape||"Square");if(s==="Portrait"||s==="512x768")return "512x768";if(s==="Landscape"||s==="768x512")return "768x512";return "768x768";}catch(e){return "768x768"}})()]
loopEngineNumImages = [loopDraftNumImages]
loop_negative_prompt = [loopDraftNegativeGuard]
loopBridgeNegativePrompt = [loop_negative_prompt]
// Metadata output. These values are used by native save/gallery buttons only.
// They must not be injected into final_prompt, otherwise the model may draw words/title text.
loopEngineSaveTitle = [loopDraftNameTitle ? loopDraftNameTitle : "No Title"]
loopEngineOutputDescription = [(()=>{try{let date=new Date().toLocaleDateString();let mode=String(loopDraftGenerationMode||"Image").trim();let style=String(loopActiveStyleDisplayName||"ASW Core Style v1").trim();if(style==="MORO Core Style v1")style="ASW Core Style v1";return date+" • "+style+" • "+mode;}catch(e){let style=String(loopActiveStyleDisplayName||"ASW Core Style v1").trim();if(style==="MORO Core Style v1")style="ASW Core Style v1";return new Date().toLocaleDateString()+" • "+style+" • "+loopDraftGenerationMode}})()]

loopImageGalleryName = [(()=>{try{let mode=String(loopDraftGenerationMode||"Image").trim();if(mode==="Presence")return "Presences";if(mode==="World Map")return "World Map";if(mode==="Journey Scene")return "Journey";return "public";}catch(e){return "public"}})()]
loopEngineSaveDescription = [(()=>{try{let user=String(loopDraftAssetDescription||"").trim();let meta=String(loopEngineOutputDescription||"").trim();return user ? meta + " • " + user : meta;}catch(e){return loopEngineOutputDescription}})()]

final_prompt = [loopEngineFinalPrompt]
loop_save_title = [loopEngineSaveTitle]
loop_save_description = [loopEngineSaveDescription]
loopBridgeFinalPrompt = [loopEngineFinalPrompt]
loopBridgeResolution = [loopEngineResolution]
loopBridgeSaveTitle = [loopEngineSaveTitle]
loopBridgeSaveDescription = [loopEngineSaveDescription]

// ─────────────────────────────────────────────
// 11) RENDER OPTIONS + MULTI OUTPUT
// ─────────────────────────────────────────────

loopImageRenderOptions
  prompt = [final_prompt]
  negativePrompt = [loop_negative_prompt]
  resolution = [loopEngineResolution]
  saveTitle = [loop_save_title]
  saveDescription = [loop_save_description]
  galleryName = [loopImageGalleryName]

loopImageRenderOutput
  [loopRenderEmpty] ^[Number(loopHasRenderableSubject) ? 0 : 1]
  [loopRender1] ^[Number(loopHasRenderableSubject) && Number(loopEngineNumImages) == 1 ? 1 : 0]
  [loopRender2] ^[Number(loopHasRenderableSubject) && Number(loopEngineNumImages) == 2 ? 1 : 0]
  [loopRender4] ^[Number(loopHasRenderableSubject) && Number(loopEngineNumImages) == 4 ? 1 : 0]
  [loopRender8] ^[Number(loopHasRenderableSubject) && Number(loopEngineNumImages) == 8 ? 1 : 0]
  [loopRender16] ^[Number(loopHasRenderableSubject) && Number(loopEngineNumImages) == 16 ? 1 : 0]

loopRenderEmpty
  

loopRender1
  <div class\="loop-render-grid"><div class\="loop-render-item">[image(loopImageRenderOptions)]</div></div>

loopRender2
  <div class\="loop-render-grid"><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div></div>

loopRender4
  <div class\="loop-render-grid"><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div></div>

loopRender8
  <div class\="loop-render-grid"><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div></div>

loopRender16
  <div class\="loop-render-grid"><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div><div class\="loop-render-item">[image(loopImageRenderOptions)]</div></div>

// ============================================================================
// 05 — IMAGE DRAFT READERS
// Reads the structured visual-scene draft written by the right panel.
// ============================================================================
aswImageDraftRaw = [(()=>{try{return String(localStorage.getItem("aswNativeImageDraft")||"{}")}catch(e){return "{}"}})()]

aswImageDraftMode = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.mode||"journey").trim()==="direct-chat"?"direct-chat":"journey";}catch(e){return "journey"}})()]
aswImageDraftSessionTitle = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.sessionTitle||d.title||"").trim()||"A Moaning World";}catch(e){return "A Moaning World"}})()]
aswImageDraftSpeakerName = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.speakerName||d.presenceName||"").trim()||"Presence";}catch(e){return "Presence"}})()]
aswImageDraftWorldTitle = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.worldTitle||d.worldName||"").trim()||"A Moaning World";}catch(e){return "A Moaning World"}})()]
aswImageDraftZoneTitle = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.zoneTitle||d.zoneName||"").trim();}catch(e){return ""}})()]
aswImageDraftBeatText = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.beatText||d.currentBeat||d.messageText||"").trim();}catch(e){return ""}})()]
aswImageDraftVisualSeed = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.visualSeed||d.seed||"").trim();}catch(e){return ""}})()]
aswImageDraftCharacterVisual = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.characterVisual||d.presenceVisual||"").trim();}catch(e){return ""}})()]
aswImageDraftUserVisual = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.userVisual||"").trim();}catch(e){return ""}})()]
aswImageDraftRecentContext = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.recentContext||"").trim();}catch(e){return ""}})()]
aswImageDraftScenePrompt = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.scenePrompt||d.englishScenePrompt||d.visualScenePrompt||"").trim();}catch(e){return ""}})()]
aswImageDraftUseImageSetup = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return d.imageSetupApplied===true||String(d.imageStyleId||"").trim().toLowerCase()==="image-setup-default";}catch(e){return false}})()]
aswImageDraftStylePrompt = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.stylePrompt||d.imageSetupStylePrompt||"").trim();}catch(e){return ""}})()]
aswImageDraftNegativeGuard = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");return String(d.negativeGuard||d.negativePrompt||"").trim().replace(/\s+/g," ").slice(0,1600);}catch(e){return ""}})()]
aswImageDraftStyleId = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");let id=String(d.imageStyleId||d.styleId||"grounded-ghibli-realism").trim().toLowerCase();return ["grounded-ghibli-realism","disney-atelier","franco-belgian-lumiere","moebius-horizon","graphic-nocturne","majestic-reverie"].includes(id)?id:"grounded-ghibli-realism";}catch(e){return "grounded-ghibli-realism"}})()]
aswImageResolution = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");let r=String(d.resolution||"512x512").trim();return ["512x512","512x768","768x512"].includes(r)?r:"512x512";}catch(e){return "512x512"}})()]

// ============================================================================
// 06 — IMAGE PROMPT AUTHORITY
// STYLE-AUDIT-1A: Inline Journey styles are source-style descriptors only.
// They must not carry ASW doctrine, subject matter, locations, props, creatures,
// or story objects. ASW-wide readability/restraint belongs outside style text.
// ============================================================================
aswImageStylePrompt_grounded_ghibli_realism = Inspired by Studio Ghibli and Hayao Miyazaki feature-animation visual language, with Spirited Away and The Wind Rises used as visual references for hand-painted background softness, humane gesture, warm color restraint, tactile atmosphere, clean readable shapes, gentle motion sensitivity, emotional clarity, animation draftsmanship, color warmth, light, shape language, texture, and atmosphere.
aswImageStylePrompt_disney_atelier = Inspired by classic Disney feature-animation atelier style, with Fantasia and Sleeping Beauty used as visual references for elegant hand-drawn draftsmanship, graceful silhouette design, appealing gesture, storybook color harmony, clean readable staging, line, silhouette, gesture, color design, staging, and polished animation finish.
aswImageStylePrompt_franco_belgian_lumiere = Inspired by Franco-Belgian bande dessinée and ligne claire clarity, with The Adventures of Tintin, Spirou, and Valérian and Laureline used as visual references for clear strong contour, clean unhatched line fields, even readable color areas, downplayed contrast, precise silhouette language, lucid staging, line clarity, color fields, and crisp European album-comic composition.
aswImageStylePrompt_moebius_horizon = Inspired by Moebius / Jean Giraud visual language, with Arzach, The Airtight Garage, and The Incal used as visual references for clean ligne-claire contour, surreal sci-fantasy clarity, airy flat color, exact elegant line weight, spacious open composition, strange calm, graphic dream logic, line quality, color handling, spacing, surreal clarity, and composition.
aswImageStylePrompt_graphic_nocturne = Graphic Nocturne visual style, mature nocturne illustration with controlled black-shape design, shadow-led composition, restrained color fields, tactile ink-painterly texture, severe graphic rhythm, serious atmospheric tension, shadow architecture, contrast, palette restraint, texture, rhythm, and composition.
aswImageStylePrompt_majestic_reverie = Majestic Reverie fantasy illustration style, luminous romantic fantasy painting with graceful painterly detail, radiant soft light, elevated composition, refined color harmony, poetic grandeur, delicate atmosphere, polished dreamlike finish, light, color harmony, painterly detail, composition, elegance, and emotional lift.

aswImageStyleName = [(()=>{try{let id=String(aswImageDraftStyleId||"grounded-ghibli-realism");if(id==="disney-atelier")return "Disney Atelier";if(id==="franco-belgian-lumiere")return "Franco-Belgian Lumière";if(id==="moebius-horizon")return "Moebius Horizon";if(id==="graphic-nocturne")return "Graphic Nocturne";if(id==="majestic-reverie")return "Majestic Reverie";return "Grounded Ghibli Realism";}catch(e){return "Grounded Ghibli Realism"}})()]

aswImageSetupStylePrompt = [(()=>{try{if(!aswImageDraftUseImageSetup)return "";let direct=String(aswImageDraftStylePrompt||"").trim();if(direct)return direct;return [String(loop_custom_style_compact_layer||"").trim(),String(loop_core_compact_layer||"").trim(),String(loop_signature_key_layer||"").trim(),String(loop_style_flavor_compact_layer||"").trim(),String(loop_quality_compact_layer||"").trim()].filter(Boolean).join(", ");}catch(e){return String(aswImageDraftStylePrompt||"").trim()}})()]

aswImageStylePrompt = [(()=>{try{let setup=String(aswImageSetupStylePrompt||"").trim();if(aswImageDraftUseImageSetup&&setup)return setup;let id=String(aswImageDraftStyleId||"grounded-ghibli-realism");if(id==="disney-atelier")return String(aswImageStylePrompt_disney_atelier||"").trim();if(id==="franco-belgian-lumiere")return String(aswImageStylePrompt_franco_belgian_lumiere||"").trim();if(id==="moebius-horizon")return String(aswImageStylePrompt_moebius_horizon||"").trim();if(id==="graphic-nocturne")return String(aswImageStylePrompt_graphic_nocturne||"").trim();if(id==="majestic-reverie")return String(aswImageStylePrompt_majestic_reverie||"").trim();return String(aswImageStylePrompt_grounded_ghibli_realism||"").trim();}catch(e){return String(aswImageStylePrompt_grounded_ghibli_realism||"").trim()}})()]

aswImageBasicPrompt = [aswImageStylePrompt]

aswImageNegativePrompt = [(()=>{try{let base="bad anatomy, deformed hands, extra fingers, broken fingers, malformed face, asymmetrical eyes, crossed eyes, blurry image, low detail, messy composition, duplicate limbs, extra limbs, distorted body, warped proportions, visual artifacts, watermark, text overlay";let extra=String(aswImageDraftNegativeGuard||"").trim();return extra?[base,extra].join(", "):base;}catch(e){return "bad anatomy, deformed hands, extra fingers, broken fingers, malformed face, asymmetrical eyes, crossed eyes, blurry image, low detail, messy composition, duplicate limbs, extra limbs, distorted body, warped proportions, visual artifacts, watermark, text overlay"}})()]

aswImageFinalPrompt = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");let clean=v=>String(v||"").replace(/\s+/g," ").trim();let basic=String(aswImageStylePrompt||aswImageBasicPrompt||"").trim();let scene=clean(d.scenePrompt||d.englishScenePrompt||d.visualScenePrompt||"");if(!scene)scene=clean(d.visualSeed||d.beatText||d.currentBeat||d.messageText||"");return [basic, scene].filter(Boolean).join("\n\n");}catch(e){return String(aswImageStylePrompt||aswImageBasicPrompt||"").trim()}})()]

aswImageSaveTitle = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");let title=String(d.sessionTitle||d.title||"").trim();let speaker=String(d.speakerName||d.presenceName||"").trim();if(title)return title;if(String(d.mode||"")==="direct-chat"&&speaker)return "Chat with "+speaker;return "A Moaning World";}catch(e){return "A Moaning World"}})()]

aswImageSaveDescription = [(()=>{try{let d=JSON.parse(localStorage.getItem("aswNativeImageDraft")||"{}");let mode=String(d.mode||"journey")==="direct-chat"?"Direct Chat":"Journey";let bits=["ASW",mode];let speaker=String(d.speakerName||d.presenceName||"").trim();let world=String(d.worldTitle||d.worldName||"").trim();let zone=String(d.zoneTitle||d.zoneName||"").trim();if(speaker)bits.push(speaker);if(world)bits.push(world);if(zone&&mode!=="Direct Chat")bits.push("Zone: "+zone);return bits.join(" · ");}catch(e){return "ASW native inline image"}})()]

// ============================================================================
// 07 — INLINE IMAGE RENDER OPTIONS
// Native text-to-image options for message-level render actions.
// ============================================================================
aswInlineImageRenderOptions
  prompt = [aswImageFinalPrompt]
  negativePrompt = [aswImageNegativePrompt]
  resolution = [aswImageResolution]
  width = 540
  saveTitle = [aswImageSaveTitle]
  saveDescription = [aswImageSaveDescription]
  galleryName = Journey

// ============================================================================
// 08 — PUBLIC-FACING GALLERY OPTIONS
// Native Perchance gallery, moderation, and custom image button.
// ============================================================================
// GALLERY-MOD-1B-R1:
// ASW-owned Public Gallery SFW boundary. The filter authority lives in LEFT.
// Scope: public-facing gallery display only. It does not modify Image Forge prompt assembly,
// Negative Guard, Library archive, Presence forge, World Map bridge, or Journey.
// Do not import or copy external community banlists here; keep this ASW-specific, curated, and English-prompt scoped.
aswPublicGalleryAdultPromptBlocklist
  // Explicit adult / NSFW intent, including common obfuscation.
  /\b(?:nsfw|n\s*\.\s*s\s*\.\s*f\s*\.\s*w|n[\W_]*s[\W_]*f[\W_]*w|not\s+safe\s+for\s+work|18\s*\+|18\s*plus|adults?\s+only|mature\s+content|explicit\s+content|uncensored\s+adult|x[-\s]?rated|xxx|x\s*x\s*x)\b/i
  /\b(?:porn(?:ographic|ography)?|p[\W_]*[o0][\W_]*r[\W_]*n|pr0n|pron\b|adult\s+(?:image|art|site|gallery)|rule\s*34|r\s*34|r34|hentai|doujinshi|ecchi|ahegao|yiff)\b/i
  /\b(?:erotic|erotica|lewd|horny|arousing|arousal|lustful|lusty|seductive\s+(?:pose|look|expression)|sexualized|sexualised|sensual\s+adult|provocative\s+adult|pin[-\s]?up|boudoir|goon(?:er|ing)?|gooning)\b/i

  // Nudity / exposure / clothing bypass.
  /\b(?:nude|nudes?|n[\W_]*u[\W_]*d[\W_]*e|nudity|naked|nak(?:e|3)d|bare\s+body|fully\s+nude|partially\s+nude|topless|bottomless|bare\s+chest|bare\s+breasts?|bare\s+ass|barely\s+cover(?:ed|ing)|barely\s+clothed|undressed|unclothed|stripped|stripping|striptease)\b/i
  /\b(?:see[-\s]?through|transparent\s+(?:clothes|clothing|fabric|dress|shirt)|wet\s+t[-\s]?shirt|revealing\s+(?:clothes|clothing|outfit)|skimpy|lingerie|underwear|panties|thong|bra\b|bikini\s+armor|micro\s+bikini|pasties)\b/i

  // Sexual acts and sexual-state language.
  /\b(?:sex|s[\W_]*e[\W_]*x|sexual|intercourse|make\s+love|making\s+love|fuck(?:ing|ed)?|f[\W_]*u[\W_]*c[\W_]*k|fucked|fucking|blowjob|handjob|rimjob|oral\s+sex|anal\s+sex|vaginal\s+sex|penetrat(?:e|ion|ing)|masturbat(?:e|es|ed|ing|ion)|jerk(?:ing)?\s+off|orgasm(?:ic)?|ejaculat(?:e|ion|ing)|climax(?:ing)?|creampie|cum(?:ming)?|cums?|semen|sperm)\b/i

  // Sexual body-part terms.
  /\b(?:breasts?|boobs?|busty|cleavage|nipples?|areola|genitals?|penis|dick|d[\W_]*i[\W_]*c[\W_]*k|cock|c[\W_]*o[\W_]*c[\W_]*k|balls?|testicles?|vagina|vulva|pussy|p[\W_]*u[\W_]*s[\W_]*s[\W_]*y|clitoris|buttocks?|ass(?:hole)?|anus|cameltoe|bulge|erection|hard[-\s]?on)\b/i

  // Fetish / porn-category terms that do not belong in ASW public gallery.
  /\b(?:bdsm|bondage|dominatrix|submissive\s+sexual|latex\s+fetish|gagged|ball\s+gag|collar(?:ed)?\s+sexual|choke(?:d|hold)?\s+sexual|spanking|whip(?:ped)?\s+sexual|watersports|golden\s+shower|diaper\s+fetish|abdl|vore|inflation\s+fetish|breeding\s+fetish|impregnation\s+fetish|futa(?:nari)?|shemale|trap\s+porn|tentacle\s+(?:sex|porn|rape))\b/i
  /\b(?:milf|gilf|dilf|bimbo|slut|whore|cumslut|sex\s+doll|camgirl|onlyfans|fansly|chaturbate|stripper|escort)\b/i

  // Non-consensual, incest, abuse, or extreme sexual-risk terms.
  /\b(?:rape|raped|raping|non[-\s]?consensual|without\s+consent|forced\s+sex|sexual\s+assault|molest(?:ed|ation|ing)?|abuse\s+sexual|incest|step[-\s]?(?:mom|mother|sis|sister|bro|brother|dad|father)\s+(?:sex|porn|nude|naked|lewd|erotic))\b/i
  /\b(?:necrophilia|bestiality|zoophilia|animal\s+sex|feral\s+(?:porn|sex|nsfw|nude|naked|lewd|erotic)|gore\s+porn|snuff\s+porn)\b/i

  // Minor-risk: keep normal fantasy words like “child” usable unless adult terms are nearby.
  /\b(?:loli|shota|lolicon|shotacon|child\s*porn|child\s+sexual|cp\b|c\s*\.\s*p\s*\.|cub\s*(?:porn|sex|nsfw|nude|naked|lewd|erotic))\b/i
  /(?=.*\b(?:minor|underage|under\s*18|under\s*age|child|kid|toddler|preteen|teen(?:ager)?|young[-\s]?looking|schoolgirl|schoolboy)\b)(?=.*\b(?:nsfw|nude|nudity|naked|porn|explicit|erotic|lewd|sex|sexual|fetish|seductive|uncensored|undressed|revealing)\b)/i

  // Adult external links and suspicious gallery/source tags.
  /(?:pornhub\.com|xvideos\.com|xnxx\.com|redtube\.com|youporn\.com|spankbang\.com|rule34|e621\.net|e926\.net|gelbooru|danbooru.*(?:nsfw|explicit)|hentai|nhentai|hanime|adult[-\s]?site|nsfw[-\s]?site|xhamster\.com)/i

aswPublicGalleryAdultNegativePromptBlocklist
  // Negative-prompt loopholes: “no clothes / avoid clothes / not covered” patterns.
  /\b(?:clothes|clothed|clothing|covered|covering|modest|modesty|fully\s+clothed|dressed|safe\s+for\s+work|sfw|censored|censor(?:ed|ship)?|underwear|bra|panties|lingerie|bikini|shirt|pants|dress|skirt)\b/i
  /\b(?:no\s+nude|no\s+nudity|no\s+porn|no\s+sex|not\s+naked|not\s+explicit|hide\s+genitals?|hide\s+nipples?|cover\s+breasts?|cover\s+genitals?|cover\s+body)\b/i

aswGalleryOptions
  gallery = true
  sort = recent
  timeRange = all-time
  // GALLERY-MOD-1B-R1: pg13 keeps the public gallery moderated; ASW blocklists remain as a second layer.
  contentFilter = pg13
  style = width:100%; min-height:100%; box-sizing:border-box; background:transparent; color:inherit; border:none; border-radius:0; font-family:"Zilla Slab",Georgia,"Times New Roman",serif; color-scheme:inherit; padding:0; margin:0;
  bannedPromptPhrases = [aswPublicGalleryAdultPromptBlocklist]
  bannedNegativePromptPhrases = [aswPublicGalleryAdultNegativePromptBlocklist]
  hideIfScoreIsBelow = -2
  adaptiveHeight = true
  // Public is the implicit base gallery. Keeping it out of defaultGalleryNames prevents the plugin gallery selector from collapsing to Public only.
  defaultGalleryNames = Presences,World Map,Journey
  // ─────────────────────────────────────────────
  // ➕ ASW GALLERY ACTION MENU
  // Migrated from MORO dual custom-button gallery pattern.
