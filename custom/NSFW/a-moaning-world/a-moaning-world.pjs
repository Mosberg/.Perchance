// ─────────────────────────────────────────────
// 9A) COMPACT VISUAL PROMPT BUILDER — SHORT, IMAGE-FIRST
// ─────────────────────────────────────────────
// V20 principle:
// - Subject = what appears in the image.
// - Core = medium / visual language.
// - Style = how the subject is drawn.
// - Quality = polish.
// Keep final positive prompt visual and short. Keep administrative rules out of positive prompt.

// ASW STYLE CONTRACT:
// - `MORO Core Style v1` remains the internal compatibility key for the legacy render engine.
// - `ASW Core Style v1` is the user-facing display label handled by RIGHT/metadata layers.
// - Do not inject title/description metadata into final_prompt.
// STYLE-PROMPT-1B: ASW Core is tuned toward quiet cinematic myth, not noisy futurist ornament.
// STYLE-TUNE-1A: first source-accuracy batch tunes Frazetta, Alan Lee, John Howe, Brom, Dark Souls, Moebius, and Franco-Belgian ligne claire with research-backed anchors and subject guards.
// STYLE-PROMPT-1C: named visual styles become the primary prompt anchor. ASW Core is suppressed when a named style is selected; source works are visual-language references only.
// STYLE-TUNE-1C: cinematic, sci-fantasy, and 3D/render styles are research-tuned with positive-only visual scope and no object-negative leakage.
// STYLE-TUNE-1E: remaining style pass tunes Satoshi Kon and Classic Hollywood Film Still, synchronizes Denis Villeneuve and Grounded Ghibli metadata, and restores gallery category fallback labels.

loop_core_compact_layer = [(()=>{try{let d=JSON.parse(localStorage.getItem("loopImageCreateDraft")||"{}");let isCustom=String(d.style_source||"core").trim().toLowerCase()==="custom"&&String(d.custom_style_prompt||"").trim();if(isCustom)return "";let key=String(d.style_flavor_key||"").trim();if(key&&!key.endsWith("__none"))return "";let c=String(d.render_core||"MORO Core Style v1").trim();if(c==="Sword & Sorcery Painting"||c==="Tolkien Illustration")c="High Fantasy";if(c==="MORO Sample"||c==="MORO Sample Style"||c==="MORO STYLE (Sample)")c="MORO Core Style v1";let map={"MORO Core Style v1":"ASW Core Style v1, silent mythic realism, cinematic restraint, clear focal composition, atmospheric world memory, subtle ancient cultural traces, worn materials, restrained fantasy realism, soft environmental depth, controlled color separation, elegant readable detail, grounded fantasy language, dignified finished key visual","Anime":"anime artwork, clean line fidelity, strong character readability, rich color separation, polished animation finish","Cinematic Realism":"cinematic realism, film-still composition, dynamic lighting, sharp focus, fine detail, cinematic color grading, depth of field","Comic":"comic visual language, ink-led graphic storytelling, strong line authority, bold silhouette control, graphic shadow architecture, clean print finish","3D Render":"stylized 3D render language, coherent geometry, polished materials, refined surfaces, cinematic depth, dimensional form clarity","High Fantasy":"high fantasy illustration language, mythic visual atmosphere, painterly depth, lore-rich mood, dramatic coherent light, ancient-world grandeur"};return map[c]||map["MORO Core Style v1"]}catch(e){return "ASW Core Style v1, silent mythic realism, cinematic restraint, atmospheric world memory, clear focal composition"}})()]

