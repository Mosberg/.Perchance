      window._aswCurrentImageData = data
      if (typeof window.showASWImageActionModal === "function") {
        window.showASWImageActionModal(data)
      }

  // ─────────────────────────────────────────────
  // 💬 ASW IMAGE COMMENTS BUTTON
  // Migrated from MORO gallery customButton2 pattern.
  // ─────────────────────────────────────────────
  customButton2
    emoji = 💬
    onClick(data) =>
      const aswAccent = (() => {
        const css = getComputedStyle(document.documentElement);
        const val = String(css.getPropertyValue('--asw-accent') || css.getPropertyValue('--asw-color-accent') || css.getPropertyValue('--asw-red') || '#B69A67').trim();
        return /^#[0-9a-fA-F]{3,8}$/.test(val) ? val : '#B69A67';
      })();
      const aswThemeRaw = (() => {
        try { return String(document.documentElement.getAttribute('data-asw-shell-theme') || document.body?.getAttribute('data-asw-shell-theme') || document.querySelector('#aswNativeApp')?.getAttribute('data-asw-shell-theme') || localStorage.getItem('asw_native_shell_theme_v1') || 'midnight').trim().toLowerCase(); }
        catch(error) { return 'midnight'; }
      })();
      const aswGalleryCommentMode = ['ash','day','light'].includes(aswThemeRaw) ? 'light' : 'dark';
      const aswCommentChrome = aswGalleryCommentMode === 'light' ? '#F1EEE7' : '#17191A';
      const aswCommentDepth = aswGalleryCommentMode === 'light' ? '#FAF8F3' : '#111313';
      const aswCommentBubble = aswGalleryCommentMode === 'light' ? '#E5E1D8' : '#202324';
      const aswCommentText = aswGalleryCommentMode === 'light' ? '#29251F' : '#EDE6D8';
      const aswCommentBorder = aswGalleryCommentMode === 'light' ? 'rgba(41,37,31,.14)' : 'rgba(237,230,216,.12)';
      const aswCommentOnAccent = String(aswAccent).toUpperCase() === '#FB7906' ? '#17130E' : '#FFFFFF';
      let commentsBox = commentsPlugin({
        channel: "image-" + String(data.imageId || data.imageUrl || data.image_url || data.url || data.prompt || Date.now()).slice(0,25),
        width: "100%",
        height: "100%",
        loadFonts: "Zilla Slab",
        forceColorScheme: aswGalleryCommentMode,
        style: `display:block;width:100%;height:100%;max-width:100%;background:${aswCommentChrome};color:${aswCommentText};color-scheme:${aswGalleryCommentMode};`,
        containerStyle: `width:100%;height:100%;max-width:100%;font-family:"Zilla Slab",Georgia,"Times New Roman",serif;border:0;overflow:hidden;background:${aswCommentChrome};color:${aswCommentText};color-scheme:${aswGalleryCommentMode};`,
        messageFeedStyle: `padding:10px;min-height:0;background:${aswCommentChrome};color:${aswCommentText};`,
        messageBubbleStyle: `background:${aswCommentBubble};color:${aswCommentText};border:1px solid ${aswCommentBorder};border-radius:var(--asw-modal-radius-small,4px);padding:8px 9px;font-family:"Zilla Slab",Georgia,"Times New Roman",serif;font-size:var(--asw-type-ui-size,0.875rem);line-height:1.5;`,
        inputAreaStyle: `background:${aswCommentDepth};color:${aswCommentText};border:1px solid ${aswCommentBorder};border-radius:var(--asw-modal-radius-small,4px);min-height:50px;padding:9px 10px;font-family:"Zilla Slab",Georgia,"Times New Roman",serif;font-size:var(--asw-type-ui-size,0.875rem);line-height:1.5;`,
        submitButtonStyle: `background:${aswAccent};color:${aswCommentOnAccent};border:1px solid ${aswAccent};border-radius:var(--asw-modal-radius-small,4px);font-weight:650;font-family:"Zilla Slab",Georgia,"Times New Roman",serif;min-height:32px;min-width:92px;opacity:1;box-shadow:none;`,
        settingsButtonStyle: `background:${aswAccent};color:${aswCommentOnAccent};border:1px solid ${aswAccent};border-radius:var(--asw-modal-radius-small,4px);min-height:32px;`,
        fullscreenButtonStyle: `background:${aswAccent};color:${aswCommentOnAccent};border:1px solid ${aswAccent};border-radius:var(--asw-modal-radius-small,4px);min-height:32px;`,
        commentPlaceholderText: "Add a friendly comment...",
        submitButtonText: "send",
        beforeSubmit: (com) => {
