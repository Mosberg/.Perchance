// Feel free to edit the settings below and then save your own copy of this generator!
// You'll probably just want to scroll down to the artStyle list and edit those - it's pretty self-explanatory, just follow the format.

settings
  text
    safetyReminder = 
    timeoutMs = 60000
    maxRetries = 3
    retryDelayMs = 1000
    stream = true
    endButtons = continue,copy,improve,enchant,regenerate,translate,summarize,count,export,edit,clear
    continuePrompt = Continue the following text naturally, picking up exactly where it ends. Maintain tone, style, pov, and formatting. Output ONLY the continuation; do not repeat any of the original text.
    improvePrompt = Improve the following text: refine the prose, fix awkward phrasing, strengthen word choice, improve flow and clarity, and correct any errors. Preserve meaning, length, and tone. Output only the improved version.
    continueSeparator = \n\n
    enchantPreset = dramatic
  image
    resolution = 768x768
    guidanceScale = 7
    variations = 1
    style = border-radius:3px;
  gallery
    enabled = true
    sort = trending
    contentFilter = pg13
    hideIfScoreIsBelow = -1
    adaptiveHeight = true
  ui
    theme = auto
    layout = tabs
    maxWidth = 1100px
    showTips = true
    showEndButtons = true
    defaultTranslateLang = Spanish
    persistHistory = true
  chat
    persona = Assistant
    keep = 8
    compactAtRatio = 0.9
    maxParagraphsPerMessage = 2
  // Character generator specific settings
  pageTitle = ❤️‍🔥 AI Character Generator - NSFW Dating Simulator Edition 🖼️
