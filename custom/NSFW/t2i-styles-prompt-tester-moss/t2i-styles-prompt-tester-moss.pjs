styles = {import:t2i-styles-moss-nsfw}
textToImage = {import:text-to-image-plugin}

promptOptions
  prompt = [prompt]
  negativePrompt = [styles[selectEl.value].negative]
  resolution = 512x768
  
prompt
  [window.input.description=testSubject.evaluateItem, styles[selectEl.value].prompt] ^[customStylePromptEl.value.trim() === ""]
  [testSubject], [customStylePromptEl.value] ^[customStylePromptEl.value.trim() !== ""]

negativePrompt
  [styles[selectEl.value].negative] ^[customStylePromptEl.value.trim() === ""]
  [customStyleNegativePromptEl.value] ^[customStylePromptEl.value.trim() !== ""]

selectOptions
  [styles.selectAll.map(s => `<option>${s.getName}</option>`).join("")]

testSubject
  mysterious mermaid, her iridescent scales glistening as she arches her back against ancient stone pillars, her tail wrapping around a diver's waist in the underwater ruins  
  retro robot, his metallic fingers tracing electric pulses across a human lover's thighs in the flickering neon of a futuristic city  
  old man, his leathery hands gripping the librarian's hips against dusty tomes in the post-apocalyptic library  
  young samurai, his calloused palms sliding beneath silk robes beneath the sakura tree at night  
  lonely astronaut, her spacesuit peeled away as she writhes against an alien's phosphorescent tendrils beneath twin moons  
  playful child, their laughter echoing as they tumble through sunflowers, sticky with nectar and summer sweat  
  fierce viking warrior, his beard tangled in his lover's fists as they rut against the icy cavern walls  
  medieval witch, her thighs clamping around a knight's armored waist as candles gutter in her tower  
  teenage girl, suspended in zero gravity, her legs wrapped around a fellow stowaway as they float through the cosmos  
  vintage race car driver, her oil-streaked fingers fumbling with a mechanic's overalls in the 1950s pit stop  
  brave firefighter, his soot-streaked body pressing a survivor against the burning building's shuddering beams  
  rock star zombie, his decaying fingers plucking at groupies' fishnets on the concert stage  
  inventor's daughter, her corset unlaced as steam hisses from the pipes in the steampunk workshop  
  city-dwelling dragon, his forked tongue tracing the curve of a thief's spine atop the skyline  
  love-struck alien, their translucent skin flushing as tentacles entwine in the intergalactic bar  
  desert nomad, his robes parted by the wind as he pins a rival tribeswoman atop the sand dunes  
  buddhist monk, his robes pooling around his hips as he's taken by a spirit in the lantern-lit temple  
  unseen ghost, their spectral form vibrating against a mortal's shuddering body in the old mansion  
  ancient warrior, his bloodied grip tangling in his enemy's hair on the battlefield  
  cybernetic ninja, his neural ports sparking as he fucks a hacker against neon-lit alley walls  
  carnival contortionist, her limbs twisting around the ringmaster's waist in the vintage circus tent  
  samoyed puppy, his wet nose nudging at a mate's flank on the snowy mountain peak  
  fairy prince, his wings quivering as he takes an elf against bioluminescent mushrooms  
  rebellious princess, her gown ripped open by the stableboy in the medieval castle's hayloft  
  cowboy, his spurs digging into a saloon girl's thighs in the sun-soaked desert  
  detective, her stockings torn as she's bent over a rain-soaked alley dumpster  
  rock climber, his harness straps biting into his partner's flesh on the cliff edge  
  mechanic, his grease-smeared chest heaving as he fucks an apprentice on the steam-wreathed workbench  
  spy, her thighs clamped around a target's waist on the rooftop at night  
  jungle explorer, his pith helmet discarded as he takes the native guide against the lost temple's altar  
  graffiti artist, her back arched against subway tiles as a rival tags her skin with his teeth  
  samurai, his sword abandoned as he parts his lover's robes in the cherry blossom grove  
  stargazing girl, her telescope forgotten as a classmate's mouth finds her thighs on the rooftop  
  pirate, his peg leg hooked around a cabin boy's waist in the abandoned shipwreck  
  victorian vampire, his fangs glistening as he pins a maiden to the gothic castle's organ  
  ballet dancer, her pointe shoes discarded as she's taken in the wings under moonlit stage lights  
  dj, her fingers tangled in raver fishnets as bass shakes the lively club's booth  
  jazz musician, his sax strap snapping as he bends a singer over the smoky bar's piano  
  forest nymph, her petals parting for a lost traveler in the magical glen  
  homeless man, his cardboard blanket shifting as he shares warmth under the city bridge  
  marine biologist, her wetsuit peeled down by an octopus's curious limbs in the coral reef  
  secret agent, her grapple line straining as she's taken mid-descent down the building  
  ancient pharaoh, his golden collar clinking as a concubine kneels in the royal tomb  
  ballerina, her tutu rucked up by a street musician's hands on the bustling city street  
  moon goddess, her silver skin glowing as constellations align inside her celestial palace  
  eclectic wizard, his spellbook forgotten as an apprentice rides his staff in the mystical library  
  grim reaper, his scythe propped against a headstone as he claims a widow in the foggy graveyard