generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}
cssStyle = {import:css-style-plugin}
rememberPlugin = {import:remember-plugin}

// ------------------------------------------------------------
//  HELPER: relationship stage from affection
// ------------------------------------------------------------
getRelationshipStage(aff) =>
  let stage = relationshipStages[0];
  for (let s of relationshipStages) {
    if (aff >= s.minAff) stage = s;
  }
  return stage;

// ------------------------------------------------------------
//  HELPER: clamp
// ------------------------------------------------------------
clamp(v, min, max) =>
  return Math.max(min, Math.min(max, v));

// ------------------------------------------------------------
//  PICK HELPER — random element from an array (root-attached)
// ------------------------------------------------------------
pick(arr) =>
  if (!arr || !arr.length) return "";
  return arr[Math.floor(Math.random() * arr.length)];

pickN(arr, n) =>
  if (!arr || !arr.length) return [];
  let pool = arr.slice();
  let out = [];
  let count = Math.min(n, pool.length);
  for (let i = 0; i < count; i++) {
    let idx = Math.floor(Math.random() * pool.length);
    out.push(pool.splice(idx, 1)[0]);
  }
  return out;

// ------------------------------------------------------------
//  RANDOMIZE CHARACTER — fills advanced fields from data lists
// ------------------------------------------------------------
randomizeCharacter(c) =>
  let r = root;
  c.identity = c.identity || {};
  c.identity.species = c.identity.species || pick(r.speciesList);
  c.identity.birthplace = c.identity.birthplace || pick(r.birthplaces);
  c.identity.nationality = c.identity.nationality || pick(r.nationalities);

  c.body = c.body || {};
  c.body.skinTone = c.body.skinTone || pick(r.skinTones);
  c.body.heightCm = c.body.heightCm || (150 + Math.floor(Math.random()*50));
  c.body.weight = c.body.weight || (45 + Math.floor(Math.random()*45));
  c.body.hair = c.body.hair || {};
  c.body.hair.color = c.body.hair.color || pick(r.hairColors);
  c.body.hair.style = c.body.hair.style || pick(r.hairStyles);
  c.body.hair.length = c.body.hair.length || pick(r.hairLengths);
  c.body.hair.facialHair = c.body.hair.facialHair || pick(r.facialHairStyles);
  c.body.eyes = c.body.eyes || {};
  c.body.eyes.color = c.body.eyes.color || pick(r.eyeColors);
  c.body.eyes.shape = c.body.eyes.shape || pick(r.eyeShapes);
  c.body.eyes.size = c.body.eyes.size || pick(r.eyeSizes);
  c.body.face = c.body.face || {};
  c.body.face.shape = c.body.face.shape || pick(r.faceShapes);
  c.body.face.noseShape = c.body.face.noseShape || pick(r.noseShapes);
  c.body.face.mouthShape = c.body.face.mouthShape || pick(r.mouthShapes);

  c.bodyMods = c.bodyMods || {};
  if (Math.random() < 0.5) {
    c.bodyMods.tattoos = {
      location: pick(r.tattooLocations),
      style: pick(r.tattooStyles),
      theme: pick(r.tattooThemes),
      density: pick(r.tattooDensities),
      visibility: pick(r.bodyModVisibilities)
    };
  } else c.bodyMods.tattoos = null;
  if (Math.random() < 0.5) {
    c.bodyMods.piercings = {
      facial: pick(r.piercingFacial),
      ear: pick(r.piercingEar),
      body: pick(r.piercingBody),
      jewelry: pick(r.piercingJewelry),
      style: pick(r.piercingStyles)
    };
  } else c.bodyMods.piercings = null;
  if (Math.random() < 0.4) {
    c.bodyMods.scars = {
      origin: pick(r.scarOrigins),
      type: pick(r.scarTypes),
      location: pick(r.scarLocations),
      visibility: pick(r.bodyModVisibilities),
      symbolism: pick(r.scarSymbolisms)
    };
  } else c.bodyMods.scars = null;
  if (Math.random() < 0.5) {
    c.bodyMods.freckles = {
      density: pick(r.freckleDensities),
      tone: pick(r.freckleTones),
      pattern: pick(r.frecklePatterns),
      visibility: pick(r.bodyModVisibilities),
      origin: pick(r.freckleOrigins)
    };
  } else c.bodyMods.freckles = null;

  c.personality = c.personality || {};
  c.personality.strengths = c.personality.strengths && c.personality.strengths.length ? c.personality.strengths : pickN(r.personalityStrengths, 3);
  c.personality.flaws = c.personality.flaws && c.personality.flaws.length ? c.personality.flaws : pickN(r.personalityFlaws, 2);
  c.personality.fears = c.personality.fears && c.personality.fears.length ? c.personality.fears : pickN(r.personalityFears, 2);
  c.personality.motivations = c.personality.motivations && c.personality.motivations.length ? c.personality.motivations : pickN(r.personalityMotivations, 2);
  c.personality.values = c.personality.values && c.personality.values.length ? c.personality.values : pickN(r.personalityValues, 2);
  c.personality.temperament = c.personality.temperament || pick(r.temperaments);
  c.personality.humorStyle = c.personality.humorStyle || pick(r.humorStyles);
  c.personality.socialStyle = c.personality.socialStyle || pick(r.socialStyles);
  c.personality.decisionStyle = c.personality.decisionStyle || pick(r.decisionStyles);
  c.personality.conflictStyle = c.personality.conflictStyle || pick(r.conflictStyles);

  c.background = c.background || {};
  c.background.childhood = c.background.childhood || pick(r.childhoods);
  c.background.education = c.background.education || pick(r.educations);
  c.background.pastOccupations = (c.background.pastOccupations && c.background.pastOccupations.length) ? c.background.pastOccupations : pickN(r.pastOccupations, 2);
  c.background.majorEvents = (c.background.majorEvents && c.background.majorEvents.length) ? c.background.majorEvents : pickN(r.majorEvents, 2);
  c.background.traumas = (c.background.traumas && c.background.traumas.length) ? c.background.traumas : (Math.random()<0.5 ? pickN(r.traumas, 1) : []);
  c.background.achievements = (c.background.achievements && c.background.achievements.length) ? c.background.achievements : pickN(r.achievements, 2);
  c.background.secrets = (c.background.secrets && c.background.secrets.length) ? c.background.secrets : pickN(r.secrets, 1);

  c.stats = c.stats || {};
  c.stats.core = c.stats.core || {};
  let coreKeys = ["strength","dexterity","constitution","intelligence","wisdom","charisma"];
  for (let k of coreKeys) c.stats.core[k] = (typeof c.stats.core[k] === "number") ? c.stats.core[k] : (6 + Math.floor(Math.random()*13));
  c.stats.secondary = c.stats.secondary || {};
  let secKeys = ["luck","perception","willpower","sanity","mana","stamina"];
  for (let k of secKeys) c.stats.secondary[k] = (typeof c.stats.secondary[k] === "number") ? c.stats.secondary[k] : (6 + Math.floor(Math.random()*13));

  c.powers = c.powers || {};
  c.powers.magicType = c.powers.magicType || (Math.random()<0.4 ? pick(r.magicTypes) : "");
  c.powers.spellList = (c.powers.spellList && c.powers.spellList.length) ? c.powers.spellList : (c.powers.magicType ? pickN(r.spellExamples, 3) : []);
  c.powers.superpowers = (c.powers.superpowers && c.powers.superpowers.length) ? c.powers.superpowers : (Math.random()<0.3 ? pickN(r.superpowers, 2) : []);
  c.powers.mutations = (c.powers.mutations && c.powers.mutations.length) ? c.powers.mutations : (Math.random()<0.2 ? pickN(r.mutations, 1) : []);
  c.powers.cybernetics = (c.powers.cybernetics && c.powers.cybernetics.length) ? c.powers.cybernetics : (Math.random()<0.2 ? pickN(r.cybernetics, 1) : []);
  c.powers.psionics = (c.powers.psionics && c.powers.psionics.length) ? c.powers.psionics : (Math.random()<0.2 ? pickN(r.psionics, 1) : []);
  c.powers.curses = (c.powers.curses && c.powers.curses.length) ? c.powers.curses : (Math.random()<0.2 ? pickN(r.curses, 1) : []);
  c.powers.transformations = (c.powers.transformations && c.powers.transformations.length) ? c.powers.transformations : (Math.random()<0.15 ? pickN(r.transformations, 1) : []);
  c.powers.limitations = (c.powers.limitations && c.powers.limitations.length) ? c.powers.limitations : pickN(r.powerLimitations, 1);

  c.inventory = c.inventory || {};
  c.inventory.weapons = (c.inventory.weapons && c.inventory.weapons.length) ? c.inventory.weapons : (Math.random()<0.5 ? pickN(r.weapons, 1) : []);
  c.inventory.armor = (c.inventory.armor && c.inventory.armor.length) ? c.inventory.armor : (Math.random()<0.3 ? pickN(r.armorList, 1) : []);
  c.inventory.gear = (c.inventory.gear && c.inventory.gear.length) ? c.inventory.gear : pickN(r.gearList, 2);
  c.inventory.currency = (typeof c.inventory.currency === "number") ? c.inventory.currency : Math.floor(Math.random()*500);
  c.inventory.vehicles = (c.inventory.vehicles && c.inventory.vehicles.length) ? c.inventory.vehicles : (Math.random()<0.3 ? [pick(r.vehicles)] : []);

  c.social = c.social || {};
  c.social.factions = (c.social.factions && c.social.factions.length) ? c.social.factions : (Math.random()<0.5 ? pickN(r.factions, 1) : []);
  c.social.allies = (c.social.allies && c.social.allies.length) ? c.social.allies : pickN(r.allyTypes, 1);
  c.social.enemies = (c.social.enemies && c.social.enemies.length) ? c.social.enemies : (Math.random()<0.5 ? pickN(r.enemyTypes, 1) : []);
  c.social.contacts = (c.social.contacts && c.social.contacts.length) ? c.social.contacts : pickN(r.contactTypes, 1);

  c.story = c.story || {};
  c.story.archetype = c.story.archetype || pick(r.storyArchetypes);
  c.story.plotFunction = c.story.plotFunction || pick(r.plotFunctions);
  c.story.currentGoal = c.story.currentGoal || pick(r.shortTermGoals);
  c.story.longTermGoal = c.story.longTermGoal || pick(r.longTermGoals);
  c.story.stakes = c.story.stakes || pick(r.storyStakes);

  c.metadata = c.metadata || {};
  c.metadata.id = c.metadata.id || ("char_" + Math.random().toString(36).slice(2,10));
  c.metadata.version = "1.0.0";
  c.metadata.createdAt = c.metadata.createdAt || new Date().toISOString();
  c.metadata.updatedAt = new Date().toISOString();
  c.metadata.tags = c.metadata.tags || [c.archetype, c.identity.species];

  return c;

