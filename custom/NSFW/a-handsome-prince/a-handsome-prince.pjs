  [hp_expression_remaining]^2


hp_expression_preferred


  [hp_expr_domination]
  [hp_expr_demanding]
  [hp_expr_aggressive]
  [hp_expr_fierce]
  [hp_expr_sad]
  [hp_expr_cute]
