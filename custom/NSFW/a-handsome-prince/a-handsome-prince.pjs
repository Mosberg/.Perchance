generateInterfaceHTML = {import:t2i-framework-plugin-v2}

// === HERE BEGINNETH YE ROYAL RECORD ===
$meta
  title = Handsome Prince Generator
  description = Conjure richly styled vintage portraits of handsome princes.
  header
    mode = minimal

// === HEREIN ARE SET YE MACHINATIONS OF THIS PAGE ===
settings
  pageTitle = a Handsome Prince
  introMessage = Strike ye crown, stir Fate from her slumber, and behold a handsome prince richly arrayed and poorly advised.
  numImages = [input.numImages]
  socialFeatures = disabled

  imageButtons
    privateSave = true

  // === HEREIN IS YE ROYAL PORTRAIT SUMMONED ===
  imageOptions
    prompt = [hp_visual_open] [hp_comp_reset] [hp_age] [hp_skin] [hp_body] He is handsome with chiseled facial features. [input.scene_mode === "on" ? hp_comp_expression : hp_expression] [hp_facial_hair] [hp_prince_hair] [hp_hair_color] [hp_comp_crop] [hp_comp_pose] [hp_prince_outfit] [hp_comp_anatomy] good hands, anatomically correct adult male proportions, [hp_location] [hp_analog_close]
    negativePrompt = ""
    guidanceScale = [input.Gscale]
    resolution = [input.shape]
    seed = [input.seed]

  // === OF KNOBS, LEVERS, AND OTHER COURTLY COMMANDS ===
  userInputs
    numImages
      label = <b>No. Of Portraits</b>
      type = select
      remember = true
      options
        Customary = 7
        I = 1
        II = 2
        III = 3
        IV = 4
        V = 5
        VI = 6
        VII = 7
        VIII = 8
        IX = 9
        X = 10
        XI = 11
        XII = 12
        XIII = 13
        XV = 15
        XX = 20
        XXX = 30
        XL = 40
        L = 50
        LXX = 70
    shape
      label = <b>Shape of Ye Portrait</b>
      type = select
      remember = true
      options
        Proper Square = 768x768
        Courtly Tall = 512x768       
        Kingdom Wide = 768x512
        As Fate Decideth = [hp_random_shape]

    Gscale
      label = ⭐️<b>Spell Strength</b>
      type = select
      remember = true
      options
        Customary = 19
        I = 1
        II = 2
        III = 3
        IV = 4
        V = 5
        VI = 6
        VII = 7
        VIII = 8
        IX = 9
        X = 10
        XI = 11
        XII = 12
        XIII = 13
        XIV = 14
        XV = 15
        XVI = 16
        XVII = 17
        XVIII = 18
        XIX = 19
        XX = 20
        XXI = 21
        XXII = 22
        XXIII = 23
        XXIV = 24
        XXV = 25
        XXVI = 26
        XXVII = 27
        XXVIII = 28
        XXIX = 29
        XXX = 30

    seed
      label = 🌱 <b>Seed of Fate</b>
      type = text
      remember = true
      width = min(750px, 100%)

    // This hidden decree is ruled by ye Courtly Companie button in ye right-hand box.
    scene_mode
      label = Courtly Companie
      type = select
      remember = true
      visible = [eval("() => false")]
      options
        Nay = off
        Aye = on

  showFeedback = false

// === OF YE ANCIENT SEVENTIES PHOTOGRAPHIC SPELL ===
hp_visual_open
  famous vintage 70s photo, , grainy photograph, 1970s photo with film grain, 70s photo with vignetting, retro, r/OldSchoolCool, 70s photo, vintage photo,

hp_analog_close
  (Kodak Portra 400, humanistic photography, raw photo, everyday imperfect people with genuine flaws, micro details on skin, natural pores and fine hair, skin blemishes, slight beauty flaws, authentic human details, casual snapshot, everyday reality, authentic lifestyle).

// === BRIDGES UNTO YE POSTURES AND COURTLY ENCOUNTERS ===
hp_comp_reset
  [eval("window.__hpCompositionResolved = null; window.__hpOutfitResolved = null; window.__hpHairColorPool = 'full'; ''")]

hp_comp_expression
  [eval("window.__hpGetExpressionPrompt ? window.__hpGetExpressionPrompt(String(input.scene_mode || 'off')) : ''")]

hp_comp_crop
  [eval("window.__hpGetCropPrompt ? window.__hpGetCropPrompt(String(input.scene_mode || 'off')) : ''")]

hp_comp_pose
  [eval("window.__hpGetPosePrompt ? window.__hpGetPosePrompt(String(input.scene_mode || 'off')) : ''")]

hp_comp_anatomy
  [eval("window.__hpGetAnatomyPrompt ? window.__hpGetAnatomyPrompt(String(input.scene_mode || 'off')) : ''")]

// === SMALL CHARMS OF CONVENIENCE ===
hp_random_shape
  {768x768|512x768|768x512}

// === OF HIS YEARS, BE THEY FEW ===
hp_age
  There is an 18 year old man,
  There is a 19 year old man,
  There is a 20 year old man,  
  There is a 21 year old man,
  There is a 22 year old man,
  There is a 23 year old man,
  There is a 24 year old man,
  There is a 25 year old man,
  There is a 27 year old man,
  There is a 30 year old man,

// === OF HIS FORM AND ROYAL PROPORTIONS ===
hp_body
  [hp_prince_physique]
  [hp_all_physiques]

hp_prince_physique
  He has a lean toned physique with low body fat and subtle muscle definition,
  He has a toned fit body with moderate muscle definition and compact athletic shape,
  He has an average male body with natural proportions and an ordinary build,
  He has a sporty active body with casual fitness, lightly muscular legs, and a healthy build,
  He has an athletic body with strong shoulders, defined arms, and balanced fit proportions,
  He has a tall statuesque body with long elegant proportions and a strong upright frame,
  He has a tall statuesque body with long elegant proportions and a strong upright frame,  
  He has a muscular body with defined arms, chest, shoulders, and abdomen,

hp_all_physiques
  He has a skinny narrow body with little muscle definition,
  He has an extremely tall lanky body with long limbs and stretched-out narrow proportions,
  He has a slender lightly built body with narrow shoulders and delicate proportions,
  He has a slim proportionate body with a lean waist and lightly defined torso,
  He has a lean toned physique with low body fat and subtle muscle definition,
  He has a toned fit body with moderate muscle definition and compact athletic shape,
  He has an average male body with natural proportions and an ordinary build,
  He has a soft body with a gentle belly, softer waist, and less muscle definition,
  He has a slightly chubby body with less defined muscle tone,
  He has a sporty active body with casual fitness, lightly muscular legs, and a healthy build,
  He has an athletic body with strong shoulders, defined arms, and balanced fit proportions,
  He has a tall statuesque body with long elegant proportions and a strong upright frame,
  He has a broad-shouldered masculine body with a wide chest and strong upper frame,
  He has a muscular body with defined arms, chest, shoulders, and abdomen,
  He has a lean toned bodybuilder physique with dense muscle mass and defined proportions,
  He has a thickset sturdy stocky body with a compact frame, broad torso, and strong limbs,

// === OF COMPLEXION AND FAR-FLUNG KINGDOMS ===
hp_skin
