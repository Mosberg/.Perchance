kv = {import:kv-plugin}
url = {import:url-params-plugin}
upload = {import:upload-plugin}
remember = {import:remember-plugin}
aiText = {import:ai-text-plugin}

$meta
  title = Photon Harvest Omega: Advanced Survival Arena
  description = A deep, feature-rich evolution of Photon Harvest with multiple enemy archetypes, bosses, weapon loadouts, active abilities, build upgrades, meta-progression lab tech, and plugin-backed persistence and sharing.
  image = https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1400&q=80
  tags = game, html5, canvas, arcade, survival, roguelite, mobile, desktop, perchance, kv-plugin, url-params-plugin, upload-plugin

$game
  name = Photon Harvest Omega
  genre = Arcade Survival, Roguelite Shooter
  platform = HTML5 (Web, Mobile)
  description = Command an omega skimmer in a collapsing neon arena. Survive escalating swarms, counter specialist enemy types, defeat periodic bosses, and evolve your run with tactical upgrades while investing persistent lab credits between runs.
  features =
    - 60 FPS requestAnimationFrame loop with capped frame delta
    - Multiple enemy archetypes, enemy projectiles, and titan boss phases
    - Weapon loadouts: Pulse, Scatter, Rail
    - Active abilities: Overcharge Burst, Dash, Temporal Warp
    - Wave progression, objective events, combo scoring, and elite encounters
    - Level-up upgrade picks with synergies and build diversity
    - Persistent lab upgrades and profile stats via kv-plugin fallback
    - URL-driven config for difficulty, mode, seed, weapon, sound, and motion
    - Upload-plugin run sharing and remember-plugin preference support
    - Responsive desktop/mobile controls with touch action pad and ability buttons
  release_date = 2026-04-19
  developer = [Mosberg]
  publisher = [Mosberg]
  website = https://perchance.org/photon-harvest-omega
  license = MIT

output = Photon Harvest Omega is running in the HTML panel.
