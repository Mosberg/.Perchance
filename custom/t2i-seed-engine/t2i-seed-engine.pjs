// t2i-seed-engine
// Wrapper plugin for advanced seed controls.

smartseed = {import:smartseed}
betterSequencer = {import:better-sequencer}

$meta
  title = t2i-seed-engine
  description = Smart seed, seed skipping, and sequence control helpers.

settings
  seedMode = auto
  smartSkipDefault = 1
  smartSkipMin = 1
  smartSkipMax = 10
  allowSpecialSeed = true

apis
  toggleLock = SmartSeedButton
  smartSeed = smartSeed
  smartSeedArray = smartSeedArray
  smartSeedInput = inputSmartSeedV2
  skipSeedToggle = skipSeedNumber
