// AI-driven pixel image evolver
// Fetches photos, AI-filters to theme, AI finds visual details and fetches more
// matching images, extracts palette via Web Workers, evolves pixel-art with AI feedback.

generateText = {import:ai-text-plugin}
superFetch = {import:super-fetch-plugin}

config
  canvasW = 48
  canvasH = 48
  paletteSize = 28
  maxIter = 20000
  fetchConcurrency = 12
  keywordsPerTheme = 6
  perKeyword = 6
