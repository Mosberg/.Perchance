// Note: Text that comes after "//" is ignored, which allows
// you to write notes - like the one you're reading now!

title
  Ptolemian Name Generator

output
  [name.selectMany(10).joinItems("<br>")]

name
  [egyptianname] [egyptianname]^12
  [modernfirst] {[modernlast]|[last]}^24
