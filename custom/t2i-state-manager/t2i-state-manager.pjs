// t2i-state-manager
// Wrapper plugin for shared state and persistence helpers.

qolFunctions = {import:qol-functions-blackyt}
toolFunctions = {import:tools-functions-byt}
copyTextPlugin = {import:copy-text-plugin}

$meta
  title = t2i-state-manager
  description = Shared state wrapper around stable QoL and utility plugins.

stateDefaults
  storageKey = text2image-suite-state-v1
  historyLimit = 150
  pinnedLimit = 60
  queueLimit = 64

features
  persistentHistory = true
  persistentPinnedPrompts = true
  queueSupport = true
  sessionTag = true
