// plugins
superFetch = {import:super-fetch-plugin}

// meta tag
$meta
  title = Perchance TV
  description = A modern, minimal viewer for public IPTV streams. Browse thousands of live channels from around the world.
  tags = iptv, tv, modern, video, streaming, live

// tv config (iptv-org public M3U)
tv
  playlistUrl = https://iptv-org.github.io/iptv/index.m3u
  brand = Perchance TV
  defaultVolume = 0.6
  channelPageSize = 150

// radio config (radio-browser.info public API)
radio
  apiUrl = https://de1.api.radio-browser.info
  topCount = 3000

// filters config
filters
  // when building country/language dropdowns, hide options with fewer than this many channels
  minCount = 1
  // persist the user's country/language/geo filter choice across reloads
  persist = true
