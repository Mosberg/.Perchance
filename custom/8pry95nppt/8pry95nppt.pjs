// ---------- GENERATION LOGIC ----------
pickN(list, n) =>
  let all = list.selectAll;
  let pool = all.slice();
  let out = [];
  for (let i = 0; i < n && pool.length > 0; i++) {
    let idx = Math.floor(Math.random() * pool.length);
    out.push(pool[idx].evaluateItem);
    pool.splice(idx, 1);
  }
  return out;

pickOne(list) =>
  let all = list.selectAll;
  return all[Math.floor(Math.random() * all.length)].evaluateItem;

pickMaybe(list, chance) =>
  if (Math.random() < chance) return pickOne(list);
  return "";

generateArchPrompt() =>
  let space = pickOne(interiorSpace);
  let view = pickOne(viewAngle);
  let bldg = pickOne(buildingType);
  let mat = pickOne(material);
  let loc = pickOne(location);
  let style = pickOne(designStyle);
  let feat = pickOne(archFeature);
  let dec1 = pickOne(decor);
  let dec2 = pickOne(decor);
  let bkdrop = pickOne(backdrop);
  let light = pickOne(lighting);
  let photo = pickOne(photoStyle);
  let cam = pickOne(cameraSpec);

  let parts = [];
  parts.push(space + ", " + view + ", " + bldg + ", " + mat + ", " + loc + ", " + style + ", " + feat + ", " + dec1 + ", " + dec2 + ", " + bkdrop + ", " + light + ", " + photo + ", " + cam);

  let params = [];
  params.push(pickOne(chaosParam));
  params.push(pickOne(arParam));

  let srefCount = 1 + Math.floor(Math.random() * 2);
  let srefs = pickN(sref, srefCount);
  params.push("--sref " + srefs.join(" "));

  params.push(pickOne(swParam));
  params.push(pickOne(stylizeParam));

  let w = pickMaybe(weirdParam, 0.6);
  if (w) params.push(w);

  params.push(pickOne(versionParam));

  let opt = pickMaybe(optFlag, 0.4);
  if (opt) params.push(opt);

  let neg = pickMaybe(negPrompt, 0.25);
  if (neg) params.push(neg);

  return parts.join(", ") + ",\n" + params.join("\n");

generateGlitterPrompt() =>
  let pools = [glAnimal, glFood, glObject, glFashion, glMarine, glFlower, glDessert, glSurreal, glBadge];
  let selPool = pools[Math.floor(Math.random() * pools.length)];
  let subj = pickOne(selPool);
  let glMat = pickOne(glMaterial);
  let bg = pickOne(glBackground);
  let light = pickOne(glLighting);
  let comp = pickOne(glComposition);

  let srefCount = 1 + Math.floor(Math.random() * 4);
  let srefs = pickN(glSref, srefCount);

  let ar = pickOne(glArParam);
  let prof = pickOne(glProfileParam);
  let version = pickOne(glVersionFlag);

  let extras = [];
  if (Math.random() < 0.5) extras.push(pickOne(glStylizeParam));
  if (Math.random() < 0.4) extras.push(pickOne(glChaosParam));

  let prompt = "";

  if (selPool === glBadge) {
    let txt = pickOne(glBadgeText);
    prompt = comp + ' of ' + subj + ' made of ' + glMat + ' ribbons. The circle inside is light lilac and has big bold black text embroidered on it: "' + txt + '", ' + light + ', ' + bg + ', close-up, high saturated colors';
  } else if (selPool === glSurreal) {
    prompt = comp + ' of ' + subj + ' made entirely of ' + glMat + ', floating in the air, ' + bg + ', ultra realistic, highly detailed, ' + light;
  } else if (selPool === glMarine) {
    prompt = comp + ' of an open ' + subj + ', inside placed a glossy cherry lollipop, set against ' + bg + ', eye level perspective, ' + light + ', lively colors';
  } else if (selPool === glFood || selPool === glDessert) {
    prompt = comp + ' of ' + subj + ' covered in ' + glMat + ', melting, ' + bg + ', ' + light;
  } else {
    prompt = comp + ' of ' + subj + ' completely decorated with ' + glMat + '. ' + bg + ', ' + light + ', hyper-realistic, vibrant highly saturated colors, minimal composition';
  }

  let params = ar;
  if (extras.length > 0) params += " " + extras.join(" ");
  params += " --sref " + srefs.join(" ");
  params += " " + prof;
  params += " " + version;

  return prompt + " " + params;

generateProductPrompt() =>
  let pType = pickOne(prodType);
  let pMat = pickOne(prodMaterial);
  let pColor1 = pickOne(prodColor);
  let pColor2 = pickOne(prodColor);
  let pBg = pickOne(prodBackground);
  let pLayout = pickOne(prodLayout);
  let pLight = pickOne(prodLighting);
  let pComp = pickOne(prodComposition);
  let pBrand = pickOne(prodBrand);
  let pTagline = pickOne(prodTagline);
  let pLabel = pickOne(prodLabelText);
  let pCount = 1 + Math.floor(Math.random() * 10);

  let prompt = "";

  let styleRoll = Math.floor(Math.random() * 4);

  if (styleRoll === 0) {
    // Collection / multi-product layout
    prompt = "a collection of " + pCount + ' "' + pBrand + '" branded ' + pType + ', exhibiting a gradient of shades from ' + pColor1 + ' to ' + pColor2 + ', ' + pMat + '. the ' + pType + ' are ' + pLayout + ', contributing to a clean and organized display. ' + pLight + '. ';
  } else if (styleRoll === 1) {
    // Single product, branded background
    prompt = 'a ' + pColor1 + ' backdrop highlights ' + pType.slice(0, -1) + ', primarily ' + pColor1 + ' with a thin ' + pColor2 + ' edge. the product is ' + pLayout + ', made of ' + pMat + '. on its surface, the brand name "' + pBrand + '" is prominently displayed, accompanied by the tagline "' + pTagline + '" underneath. the text "' + pLabel + '" is also visible. ' + pLight + '. ';
  } else if (styleRoll === 2) {
    // Flat lay / top-down
    prompt = pComp + ' on a ' + pBg + ' displays ' + pType + ' and textured objects. the ' + pType + ' are ' + pColor1 + ', ' + pMat + ', ' + pLayout + '. the product features the text "' + pBrand + '", "' + pTagline + '", and "' + pLabel + '" printed on it. ' + pLight + '. ';
  } else {
    // Stacked / sculptural arrangement
    prompt = pCount + ' ' + pColor1 + ', stacked ' + pType + ' with ' + pMat + ' are captured in ' + pComp + '. a ribbon is wrapped around them, featuring the brand name "' + pBrand + '" and the phrase "' + pTagline + '" printed in small font. the ' + pType + ' are ' + pLayout + ', creating a sculptural form. ' + pLight + '. the ' + pBg + ' allows the focus to remain entirely on the product. ';
  }

  let params = [];
  params.push(pickOne(prodArParam));
  params.push(pickOne(prodVersionFlag));

  let extra = "";
  if (Math.random() < 0.3) extra = " " + pickOne(prodChaosParam);
  if (Math.random() < 0.3) extra += " " + pickOne(prodStylizeParam);

  return prompt.trim() + " " + params.join(" ") + extra;

generatePrompt(mode) =>
  if (mode === "glitter") return generateGlitterPrompt();
  if (mode === "product") return generateProductPrompt();
  return generateArchPrompt();
