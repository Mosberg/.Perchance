joinLists = {import:join-lists-plugin}
filterList = {import:filter-list-plugin}

title = Clothes Generator
description = Provides data for the Clothes dropdown on <a href="https://perchance.org/wanif62763-generator">https://perchance.org/wanif62763-generator</a>

$output = [joinLists(clothesCategories, casualEverydayDresses, cocktailDresses, eveningDresses, partyClubDresses, romanticDresses, coutureDresses, luxuryDresses, specialOccasion, cozySeduction, shortOutfits, effortlessChic, softFeminine, coldDays, sunDresses, resortVacation, beachWear, bikinis, swimsuits, cottageElegance, luxuryElegance, cuteRomance, casinoRoyal, businessOutfits, academicChic, schoolCampus, casualStreetwear, dateNight, valentinesCollection, dessous, nobleVillainess, gothicOutfits, darkKawaiiGothic, operaDiva, danceCollection, circusElegance, cheerleader, easternElegance, maidOutfits, sexyWorkClothes, halloweenWorkClothes, workCosplay, idolOutfits, fantasyClassesDresses, fantasyDresses, royalCourt, mythicBrides, elementalCollection, arcaneAcademy, fantasyDancers, darkFantasyBeings, promptAlchemy, randomClothes)]


