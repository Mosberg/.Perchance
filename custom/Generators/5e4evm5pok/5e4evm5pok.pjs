// ============================================================
//  Character & Scene Prompt Generator
//  A richly-structured perchance list system for building
//  AI image-generation prompts from composable attributes.
// ============================================================

// ---------- Global Settings (tweakable) ----------
settings
  artStyleWeight = 1
  realismWeight = 2
  negativeStrength = strong
  detailLevel = high
  includeLighting = true
  includeCamera = true
  includeMood = true
  seedLocked = false

// ---------- Input (defaults; override at runtime) ----------
input
  description = a portrait of a

// ---------- Helper Functions ----------
pickWeighted(list, n=1) =>
  let arr = list.selectAll;
  let out = [];
  let pool = arr.slice();
  for (let i = 0; i < n && pool.length; i++) {
    let idx = Math.floor(Math.random() * pool.length);
    out.push(pool[idx].evaluateItem);
    pool.splice(idx, 1);
  }
  return out;

joinList(arr, sep=", ") =>
  return arr.filter(Boolean).join(sep);

cap(s) =>
  return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;

maybe(str, odds=0.7) =>
  return Math.random() < odds ? str : "";

oddsRoll(weightedArr) =>
  let total = weightedArr.reduce((s, [_, w]) => s + w, 0);
  let r = Math.random() * total;
  for (let [val, w] of weightedArr) { r -= w; if (r <= 0) return val; }
  return weightedArr[0][0];

// ---------- Master Output ----------
$output
  Gender
    prompt
      [input.description] [genderModifiers].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [genderModifiers]
  Sexuality
    prompt = [input.description.replace(/\b(realistic)\b/i, "actual")].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [sexualityModifiers]
  Age
    prompt = [cap(ageRange)] [ageDescriptor].
    negative = [input.negative || "child, minor, underage"]
    meta:tags = [({})]
    meta:image = []
    modifiers = [ageRange]
  Body Type
    prompt = [bodyType.build].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [bodyType]
  Ethnicity
    prompt = [ethnicity] heritage.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [ethnicity]
  Hair
    prompt = [hairLength] [hairColor] [hairStyle].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [hairStyle]
  Eyes
    prompt = [eyeColor], [eyeShape] eyes.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [eyeColor]
  Expression
    prompt = [expression] expression.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [expression]
  Clothing
    prompt = wearing [clothingStyle] [clothingColor] [clothingType].
    negative = [input.negative || "nude, naked"]
    meta:tags = [({})]
    meta:image = []
    modifiers = [clothingType]
  Personality
    prompt = [personalityTrait], [personalityTrait] personality.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [personalityTrait]
  Occupation
    prompt = works as a [occupation].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [occupation]
  Setting
    prompt = set in [settingLocation], [timeOfDay].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [settingLocation]
  Pose
    prompt = [pose] pose.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [pose]
  Art Style
    prompt = [artStyle], [artMedium].
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [artStyle]
  Lighting
    prompt = [lightingType] lighting.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [lightingType]
  Camera
    prompt = [cameraAngle], [cameraShot] shot.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [cameraAngle]
  Mood
    prompt = [mood] atmosphere.
    negative = [input.negative || ""]
    meta:tags = [({})]
    meta:image = []
    modifiers = [mood]

