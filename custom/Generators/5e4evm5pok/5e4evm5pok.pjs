// ============================================================
//  Composite Prompt Builder (functions)
// ============================================================

fullPrompt() =>
  let g = root.genderModifiers.selectOne.evaluateItem;
  let a = root.ageRange.selectOne.evaluateItem;
  let b = root.bodyType.selectOne.evaluateItem;
  let e = root.ethnicity.selectOne.evaluateItem;
  let hl = root.hairLength.selectOne.evaluateItem;
  let hc = root.hairColor.selectOne.evaluateItem;
  let hs = root.hairStyle.selectOne.evaluateItem;
  let ec = root.eyeColor.selectOne.evaluateItem;
  let ex = root.expression.selectOne.evaluateItem;
  let cls = root.clothingStyle.selectOne.evaluateItem;
  let cc = root.clothingColor.selectOne.evaluateItem;
  let ct = root.clothingType.selectOne.evaluateItem;
  let oc = root.occupation.selectOne.evaluateItem;
  let sl = root.settingLocation.selectOne.evaluateItem;
  let tod = root.timeOfDay.selectOne.evaluateItem;
  let p = root.pose.selectOne.evaluateItem;
  let as = root.artStyle.selectOne.evaluateItem;
  let am = root.artMedium.selectOne.evaluateItem;
  let lt = root.lightingType.selectOne.evaluateItem;
  let ca = root.cameraAngle.selectOne.evaluateItem;
  let cs = root.cameraShot.selectOne.evaluateItem;
  let md = root.mood.selectOne.evaluateItem;
  let cap = s => s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
  return `A ${cap(a)} ${e} ${g} with ${hl} ${hc} ${hs} hair and ${ec} eyes, ${ex} expression. ${cap(b)} body type, wearing ${cls} ${cc} ${ct}. Works as a ${oc}. Set in ${sl} ${tod}. ${cap(p)} pose. ${cap(as)} style, ${am}. ${cap(lt)} lighting, ${ca} angle, ${cs}. ${cap(md)} atmosphere.`;

fullNegative() =>
  let base = "low quality, blurry, deformed, extra limbs, bad anatomy, watermark, signature, text, ugly, duplicate, cropped, worst quality, low resolution, artifact, jpeg artifacts, malformed hands, missing fingers, fused fingers, too many fingers, mutated, disfigured, bad proportions, unnatural pose";
  let extra = root.input.negative;
  if (extra) {
    let s = typeof extra === "string" ? extra : (extra.evaluateItem || "");
    s = s.replace(/^["']|["']$/g, "").trim();
    if (s) return base + ", " + s;
  }
  return base;

// ============================================================
//  Quick Presets
// ============================================================

preset
  Fantasy Hero
    artStyle = oil painting
    clothingType = armor
    settingLocation = a medieval castle
    occupation = warrior
  Cyberpunk Rebel
    artStyle = cyberpunk
    clothingStyle = streetwear
    settingLocation = a neon-lit alley
    lightingType = neon glow
    occupation = programmer
  Cozy Slice-of-Life
    artStyle = anime
    clothingStyle = casual
    settingLocation = a cozy cottage
    mood = peaceful
    occupation = barista
  Epic Portrait
    artStyle = photorealistic
    cameraShot = portrait
    lightingType = dramatic
    mood = epic
    pose = standing
