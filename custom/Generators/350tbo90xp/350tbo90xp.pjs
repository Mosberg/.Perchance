// محرك الترجمة الدقيق بين الإنجليزية والعربية

generateText = {import:ai-text-plugin}

title
  محرك الترجمة الدقيق

// تعليمات الترجمة الأساسية — مصممة لدقة عالية
translationInstruction(direction, text) =>
  let sys = "You are a master translator and linguist expert in both English and Arabic. ";
  sys += "Translate the user's text with maximum accuracy and fidelity. Rules:\n";
  sys += "1. Preserve meaning, tone, register, and nuance exactly.\n";
  sys += "2. Do NOT add explanations, notes, parentheses, or transliteration unless the source itself contains them.\n";
  sys += "3. Keep proper nouns, names, brands, and technical terms in their conventional form (transliterate only if no established form exists).\n";
  sys += "4. Match punctuation style to the target language (Arabic uses «» and ،؛ — English uses \"\" and ,;).\n";
  sys += "5. Preserve formatting: line breaks, lists, markdown, and code blocks stay intact.\n";
  sys += "6. Numbers: convert Western digits 0-9 to Arabic-Indic ٠-٩ ONLY when the target is Arabic AND the source uses Arabic-Indic or the context is purely Arabic literary; otherwise keep source digit style.\n";
  sys += "7. Output ONLY the translation — nothing else, no preamble, no quotes around the whole thing.\n";
  let dir;
  if (direction == "en-ar") dir = "Translate from English to Arabic.";
  else if (direction == "ar-en") dir = "Translate from Arabic to English.";
  else dir = "Auto-detect the source language and translate to the other language (Arabic→English or English→Arabic).";
  return sys + "\n" + dir + "\n\nTEXT TO TRANSLATE:\n" + text;

// كشف اللغة البسيط
detectLang(text) =>
  let arabic = /[\u0600-\u06FF]/.test(text);
  let latin = /[a-zA-Z]/.test(text);
  if (arabic && !latin) return "ar";
  if (latin && !arabic) return "en";
  if (arabic && latin) return "mixed";
  return "unknown";

// اتجاه الترجمة من الإعداد
pickDirection(setting, text) =>
  if (setting == "auto") {
    let l = detectLang(text);
    if (l == "ar") return "ar-en";
    if (l == "en") return "en-ar";
    return "en-ar";
  }
  return setting;
