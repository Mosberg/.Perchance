kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}

// ============================================================
// Infinite Text — AI CYOA Adventure Engine (config + prompts)
// Tweak values and prompt text here. Logic lives in index.html.
// ============================================================

config
  minRooms = 6
  maxRooms = 10
  maxTranscriptEntries = 24
  defaultTheme = An unknown realm

// --- Prompt builders (called from index.html as root.mapPrompt etc.) ---

mapPrompt(theme, desc) =>
  let details = desc ? `\nScenario details: ${desc}` : "";
  return `Generate a JSON map for a text adventure.\nTheme: ${theme}${details}\nRules:\n- ${config.minRooms} to ${config.maxRooms} rooms.\n- Each room needs: id (snake_case), name (short evocative title, 2-4 words), short_summary (one sentence), connections (array of other room ids), interactables (array of 1-4 short noun phrases).\n- Connections must be mutual: if room A lists room B, then B must list A.\n- startRoomId must match one of the room ids.\nOutput ONLY this JSON shape, no markdown fences, no commentary:\n{"startRoomId":"...","rooms":[{"id":"...","name":"...","short_summary":"...","connections":["..."],"interactables":["..."]}]}`;

roomDescPrompt(theme, roomName, summary, exits) =>
  return `You are the narrator of a text adventure. Theme: ${theme}.\nLocation: ${roomName}. Context: ${summary}.\nConnected areas: ${exits}.\nWrite a vivid room description (2-4 short paragraphs, plain text, no markdown, no headers).\nAfter the description, on a new line write:\nINTERACTABLES: name1, name2\nThen on a new line write:\nEXITS: ${exits}`;

actionPrompt(theme, roomName, exits, inventory, transcript, action) =>
  return `Text adventure. Theme: ${theme}.\nCurrent room: ${roomName}. Exits: ${exits}. Player inventory: ${inventory}.\n<TRANSCRIPT>\n${transcript}\n</TRANSCRIPT>\nTASK: Narrate the result of the player's action: "${action}". Write 1-3 sentences, plain text, no markdown. If they travel to a connected room, add a final line: GOTO: RoomName. If inventory changes, add a final line: INVENTORY_ADD: Item or INVENTORY_REMOVE: Item. If the room's description should change, add a final line: UPDATED_ROOM: new description.`;

interactPrompt(theme, roomName, inventory, transcript, item) =>
  return `Text adventure. Theme: ${theme}.\nCurrent room: ${roomName}. Player inventory: ${inventory}.\n<TRANSCRIPT>\n${transcript}\n</TRANSCRIPT>\nTASK: Narrate what happens when the player interacts with: ${item}. Write 1-3 sentences, plain text, no markdown. If inventory changes, add a final line: INVENTORY_ADD: Item or INVENTORY_REMOVE: Item. If the room's description should change, add a final line: UPDATED_ROOM: new description.`;
