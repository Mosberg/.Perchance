// Perchance generator imports for the ultra-detailed character metadata generator
loadDependencies = {import:ai-character-chat-dependencies-v1}
aiTextPlugin = {import:ai-text-plugin}
superFetch = {import:super-fetch-plugin}
uploadPlugin = {import:upload-plugin}
generatorStats = {import:generator-stats-plugin}
kvPlugin = {import:kv-plugin}
rememberPlugin = {import:remember-plugin}
copyText = {import:copy-text-plugin}
tooltip = {import:tooltip-plugin}
commentsPlugin = {import:comments-plugin}
tabbedCommentsPlugin = {import:tabbed-comments-plugin-v1}

$meta
	title = Ultra-Detailed Character Metadata Generator From URL
	description = Extracts ultra-detailed character metadata from one or more URLs and outputs JSON conforming to the selected schema.
