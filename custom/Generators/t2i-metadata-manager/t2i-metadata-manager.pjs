// t2i-metadata-manager
// Metadata wrapper plugin.

imageMetadataPlugin = {import:image-metadata-byt}
imageRegenerationPlugin = {import:image-regeneration-byt}

$meta
  title = t2i-metadata-manager
  description = Metadata extraction, embedding, and image regeneration wrappers.

schema
  version = 1.0.0
  keys
    prompt = text
    negative = text
    model = text
    seed = number
    cfg = number
    steps = number
    style = text
    createdAt = iso-date

options
  embedMetadataOnDownload = true
  enableRegenerationImport = true
