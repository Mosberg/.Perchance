// t2i-modifier-groups
// Reusable modifier catalogs.

$meta
  title = t2i-modifier-groups
  description = Shared camera, mood, lighting, and quality modifiers.

camera
  none =
  wide = wide-angle lens, dynamic perspective
  portrait = 85mm portrait lens, shallow depth of field
  macro = macro detail, intricate textures

lighting
  none =
  golden = golden hour lighting, warm highlights
  studio = soft studio light, balanced contrast
  neon = neon rim lighting, moody glow

mood
  none =
  epic = epic cinematic mood, heroic energy
  calm = serene atmosphere, soft ambience
  mystery = mysterious ambience, subtle shadows

quality
  none =
  ultra = ultra detailed, sharp focus, clean composition
  painterly = rich brushwork texture, expressive strokes
  realism = photoreal textures, physically plausible lighting
