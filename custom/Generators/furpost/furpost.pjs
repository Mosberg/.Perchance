commentsPlugin = {import:comments-plugin}
emoji = {import:huge-emojilist-furry-generator}
secret = {import:secret-plugin}
upload = {import:upload-plugin}
favicon = {import:favicon-plugin}

$meta
  title = FurPost — Private Inbox
  description = Create a DM/inbox link. Other visitors cannot see the inbox, while the owner can see everything.
  image = https://user.uploads.dev/file/7ba3461770342b07f2c0e91f1de46cb8.webp
  header 
    mode = minimal

// Based on Secret Messages Link: https://perchance.org/secret
// FurPost keeps message-text encryption while changing the product from anonymous secrets to a private inbox with owner-visible sender details.