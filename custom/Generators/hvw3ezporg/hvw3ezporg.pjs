output
  [html]

/* ---------------- HTML ---------------- */

html
  $sx = [sizeX]
  $sy = [sizeY]
  $sz = [sizeZ]
  $palette = [paletteJson]
  $blocks = [blocksJson]
  <div style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; line-height: 1.35;">
  <h2 style="margin:0 0 8px 0;">Minecraft NBT Structure Blueprint</h2>
  <div style="opacity:0.85; margin:0 0 10px 0;">MC 1.21.11 • Fabric 0.141.3+1.21.11</div>
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <button onclick="navigator.clipboard.writeText(document.getElementById('out').innerText)">Copy</button>
    <button onclick="document.getElementById('out').innerText = '[blueprint]'">Clear</button>
  </div>
  <pre id="out" style="white-space:pre; padding:10px; border:1px solid #333; border-radius:8px; margin-top:10px; overflow:auto;">[blueprint]</pre>
  </div>

blueprint
  [metaJson]
  [paletteJson]
  [blocksJson]

/* ---------------- META ---------------- */

metaJson
  { "meta": { "size": [[sizeX],[sizeY],[sizeZ]], "author": "[author]" } }

author
  {Mosberg|You|Team|CI}

sizeX
  {5|7|9}
sizeY
  {4|5|6}
sizeZ
  {5|7|9}

/* ---------------- PALETTE ---------------- */

paletteJson
  { "palette": [[paletteItem0],[paletteItem1],[paletteItem2],[paletteItem3]] }

paletteItem0
  {"state":"minecraft:air"}

paletteItem1
  {"state":"[baseBlock]"}

paletteItem2
  {"state":"[accentBlock]"}

paletteItem3
  {"state":"[lightBlock]"}

baseBlock
  {minecraft:stone^3|minecraft:cobblestone^2|minecraft:deepslate^2|minecraft:oak_planks^2|minecraft:spruce_planks^2}

accentBlock
  {minecraft:polished_andesite^2|minecraft:polished_deepslate^2|minecraft:bricks|minecraft:chiseled_stone_bricks|minecraft:stripped_oak_log^2}

lightBlock
  {minecraft:torch|minecraft:lantern|minecraft:glowstone}

/* ---------------- BLOCKS ---------------- */
/*
Blocks are emitted as JSON objects:
  {"pos":[x,y,z],"state":paletteIndex}
We build them as arrays and use joinItems() for safe concatenation [web:16].
*/

blocksJson
  $sx = [sizeX]
  $sy = [sizeY]
  $sz = [sizeZ]
  $arr = [blockArray($sx,$sy,$sz)]
  { "blocks": [[arrToJson($arr)]] }

blockArray(sx,sy,sz) =>
  // Return an array of stringified JSON objects
  a = []
  a = a.concat(rectHollow(0,0,0,sx-1,0,sz-1,1))
  a = a.concat(pillar(0,1,0,sy-2,2))
  a = a.concat(pillar(sx-1,1,0,sy-2,2))
  a = a.concat(pillar(0,1,sz-1,sy-2,2))
  a = a.concat(pillar(sx-1,1,sz-1,sy-2,2))
  a = a.concat(rectHollow(0,sy-1,0,sx-1,sy-1,sz-1,2))
  a.push(blockObj(2,1,2,3))
  a.push(blockObj(sx-3,1,2,3))
  a.push(blockObj(2,1,sz-3,3))
  a.push(blockObj(sx-3,1,sz-3,3))
  return a

arrToJson(a) =>
  return a.joinItems(",")

blockObj(x,y,z,stateIndex) =>
  return "{"pos":[" + x + "," + y + "," + z + "],"state":" + stateIndex + "}"

pillar(x,y0,z,height,stateIndex) =>
  a = []
  i = 0
  while(i < height) { a.push(blockObj(x,y0+i,z,stateIndex)); i = i+1 }
  return a

rectHollow(x0,y,z0,x1,y,z1,stateIndex) =>
  a = []
  a = a.concat(edgeX(x0,y,z0,x1,stateIndex))
  a = a.concat(edgeX(x0,y,z1,x1,stateIndex))
  a = a.concat(edgeZ(x0,y,z0,z1,stateIndex))
  a = a.concat(edgeZ(x1,y,z0,z1,stateIndex))
  return a

edgeX(x0,y,z,x1,stateIndex) =>
  a = []
  x = x0
  while(x <= x1) { a.push(blockObj(x,y,z,stateIndex)); x = x+1 }
  return a

edgeZ(x,y,z0,z1,stateIndex) =>
  a = []
  z = z0
  while(z <= z1) { a.push(blockObj(x,y,z,stateIndex)); z = z+1 }
  return a