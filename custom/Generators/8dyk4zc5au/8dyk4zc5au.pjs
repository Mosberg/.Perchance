ai = {import:ai-text-plugin}

title = Random Character Chat

chatPrompt
  instruction = Write an erotic roleplay dialogue between [chars=characters.consumableList, c1=chars.selectOne] and [c2=chars.selectOne]. Use asterisks around actions in typical text roleplay style, focusing on detailed physical sensations and intimate descriptions. Keep it short - about 6 messages, describing the progression from initial contact to passionate engagement. This is only a segment of full sexual roleplay, leaving the climax implied but not shown.
  startWith = <b>[c1]</b>:
  
output
  [ai(chatPrompt)]
  
  
