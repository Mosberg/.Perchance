// LEFT panel — paste into Perchance's list editor

t2i            = {import:text-to-image-plugin}
aiText         = {import:ai-text-plugin}
commentsPlugin = {import:comments-plugin}
favicon        = {import:favicon-plugin}
kv             = {import:kv-plugin}
upload         = {import:upload-plugin}

$meta
  title = imggen
  description = A text-to-image generator with a clean desktop UI — cool styles, an AI prompt helper, a scratchpad, and your own private history. Deep charcoal dark mode or a parchment light mode.
  // Replace with a preview image you upload to Perchance (social/share card):
  image = https://user.uploads.dev/file/REPLACE-with-your-preview.png
  header
    mode = minimal

// -------- Community chat (comments-plugin) — dual-render, cross-faded by OPACITY --------
// Two instances (hardcoded light / dark colours). height=100% + containerStyle height:100% make each
// FILL its window (Gengenie/Furry pattern). The RIGHT panel stacks both and shows whichever matches the
// app theme via OPACITY (never display:none — that hangs the plugin's iframe tracker). Both forward
// onComment to window.imggenOnComment (dedup + unread badge).

commentOptionsLight
  width = 100%
  height = 100%
  loadFonts = IBM Plex Mono,Spectral
  commentPlaceholderText = Say something to the room…
  submitButtonText = Post
  submitButtonSuccessText = ☕ posted
  hideFullscreenButton
  containerStyle = width:100%; height:100%; box-sizing:border-box; background:#f5edd9;
  messageFeedStyle = background:#f5edd9; color:#342a20; font-family:'IBM Plex Mono',monospace;
  messageBubbleStyle = background:#efe6cd; color:#342a20; border:1px solid #cbb488; border-radius:4px;
  inputAreaStyle = background:#efe6cd; color:#342a20; border:1px solid #cbb488; border-radius:4px; font-family:'IBM Plex Mono',monospace;
  submitButtonStyle = background:#cd5240; color:#fdf3e2; border:1px solid #a83a2b; border-radius:4px; font-family:'IBM Plex Mono',monospace;
  settingsButtonStyle = color:#77664e; border-radius:4px;
  adminPasswordHash = f4840760500f34c51a54deec25da1fd8bed3fb63e8ddd698425f304633bbd432
  adminFlair = ☕
  onComment(comment) =>
    if (window.imggenOnComment) window.imggenOnComment(comment);

commentOptionsDark
  width = 100%
  height = 100%
  loadFonts = IBM Plex Mono,Spectral
  commentPlaceholderText = Say something to the room…
  submitButtonText = Post
  submitButtonSuccessText = ☕ posted
  hideFullscreenButton
  containerStyle = width:100%; height:100%; box-sizing:border-box; background:#0f0b09;
  messageFeedStyle = background:#0f0b09; color:#ecdcbb; font-family:'IBM Plex Mono',monospace;
  messageBubbleStyle = background:#1d1712; color:#ecdcbb; border:1px solid #322820; border-radius:4px;
  inputAreaStyle = background:#171210; color:#ecdcbb; border:1px solid #322820; border-radius:4px; font-family:'IBM Plex Mono',monospace;
  submitButtonStyle = background:#c05648; color:#ffffff; border:1px solid #9c4133; border-radius:4px; font-family:'IBM Plex Mono',monospace;
  settingsButtonStyle = color:#9c8f7f; border-radius:4px;
  adminPasswordHash = f4840760500f34c51a54deec25da1fd8bed3fb63e8ddd698425f304633bbd432
  adminFlair = ☕
  onComment(comment) =>
    if (window.imggenOnComment) window.imggenOnComment(comment);
