kv = {import:kv-plugin}
url = {import:url-params-plugin}
upload = {import:upload-plugin}
remember = {import:remember-plugin}

$meta
  title = Photon Harvest: Neon Survival Arena
  description = Survive escalating swarms in a neon sci-fi arena, collect photon cores, trigger an overcharge burst, and evolve your build with run-based upgrades. Built for Perchance with persistent profiles, URL customization, and optional run sharing.
  image = https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80
  tags = game, html5, arcade, shooter, survival, mobile, canvas, sci-fi, perchance, plugin

$game
  name = Photon Harvest
  genre = Arcade, Survival Shooter
  platform = HTML5 (Web, Mobile)
  description = Pilot a pulse skimmer through a collapsing arena, auto-fire into swarms, gather photon cores, and choose upgrades between levels to survive as long as possible.
  features =
    - Fast arena survival with escalating enemy pressure
    - Core collection and overcharge burst mechanic
    - Level-up upgrade picks with build variety
    - Desktop and touch controls
    - URL-driven difficulty and seed options
    - Persistent profile save with kv-plugin fallback
    - Optional upload-plugin run sharing
  release_date = 2026-04-19
  developer = [Mosberg]
  publisher = [Mosberg]
  website = https://perchance.org/photon-harvest
  license = MIT
