// ─────────────────────────────────────────────────────────────────────
//  t2t-t2i-framework-plugin — Full-Feature Demo Generator
//  Imports the plugin and exposes every option/setting/function it offers.
// ─────────────────────────────────────────────────────────────────────

fw = {import:t2t-t2i-framework-plugin}
commentsPlugin = {import:comments-plugin}

// Every config key the plugin's mergeDefaults knows about, surfaced so the
// user can tweak any default directly here in main.pjs.
settings
  text
    instruction = ""
    startWith = ""
    stopSequences = [[""]]
    maxRetries = 3
    timeoutMs = 60000
    retryDelayMs = 1000
    stream = true
    hideStartWith = false
    endButtons = continue,copy,improve,enchant,regenerate,translate,summarize,count,export,edit,clear
    style = ""
    safetyReminder = "Keep responses helpful and safe."
    continuePrompt = Continue the following text naturally, picking up exactly where it ends. Maintain tone, style, pov, and formatting. Output ONLY the continuation; do not repeat any of the original text.
    improvePrompt = Improve the following text: refine the prose, fix awkward phrasing, strengthen word choice, improve flow and clarity, and correct any errors. Preserve meaning, length, and tone. Output only the improved version.
    continueSeparator = \n\n
    enchantPreset = dramatic
  image
    prompt = ""
    negativePrompt = ""
    resolution = 768x768
    seed = -1
    guidanceScale = 7
    removeBackground = false
    saveTitle = ""
    saveDescription = ""
    hideGalleryButtons = false
    width = 0
    style = border-radius:6px; max-width:100%;
    variations = 1
  gallery
    enabled = true
    sort = top
    contentFilter = g
    timeRange = all-time
    hideIfScoreIsBelow = -2
    adaptiveHeight = true
    defaultGalleryNames = ""
    style = ""
  ui
    theme = auto
    showHeader = true
    showTips = true
    layout = tabs
    maxWidth = 1100px
    showEndButtons = true
    endButtonsPosition = below
    defaultTranslateLang = Spanish
    markdownRender = false
    persistHistory = true
  chat
    keep = 8
    compactAtRatio = 0.9
    maxParagraphsPerMessage = 2
    persona = Assistant

// A few perchance lists used to seed the playground with sample content.
sampleInstructions
  Write a haiku about a forgotten lighthouse.
  Compose a short noir detective scene set on Mars.
  Describe a bustling alien marketplace using all five senses.
  Draft a motivational speech for a robot entering retirement.

samplePrompts
  a majestic dragon perched on a mountain peak at sunset, cinematic, highly detailed
  an enchanted library inside a giant tree, glowing runes, volumetric light
  a cyberpunk ramen bar in the rain, neon reflections, moody
  a cozy cottage in a snowstorm at night, warm window light, watercolor

sampleQuestions
  Describe this image in vivid detail.
  What objects and colors dominate this image?
  Write a one-paragraph story inspired by this image.
  Identify the artistic style and suggest a title.

$meta
  title = t2t-t2i Framework Playground
  description = A full-feature demo of the t2t-t2i-framework-plugin: text-to-text, text-to-image, chat, vision, image-to-image, galleries, styles, share links, stats, and token budgeting.
  tags = ai, text-to-image, text-to-text, framework, demo, plugin
