// t2i-prompt-processor
// Wrapper plugin for prompt transforms and filter chains.

t2iProcess = {import:t2i-f-process-blackyt}
textTools = {import:text-tools-blackyt}

$meta
  title = t2i-prompt-processor
  description = Prompt cleaning, join logic, and configurable filter chains.

pipeline
  step1 = newLineBreakFunctionPlus
  step2 = commaFunctionPlus
  step3 = TitleSeparatorFunction
  step4 = customCFG

options
  trimLeadingCommas = true
  trimTrailingCommas = true
  collapseWhitespace = true
  preserveWeightedTags = true
  maxPromptLength = 2000
