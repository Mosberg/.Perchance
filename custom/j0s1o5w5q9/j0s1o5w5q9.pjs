generateText = {import:ai-text-plugin}
ai = {import:ai-text-plugin}

title = Random Character Chat

chatPrompt
  instruction = Write a silly roleplay dialogue between [chars=characters.consumableList, c1=chars.selectOne] and [c2=chars.selectOne]. Use asterisks around actions in typical text roleplay style. Keep it short - about 6 messages. This is only a segment of the full roleplay, so you don't need to "wrap it up".
  startWith = <b>[c1]</b>:
  
output
  [ai(chatPrompt)]
  
