generateHTML = {import:custom-t2i-framework-plugin-v3}

$meta
  title = AI Character Generator V3 (template-ready)
  description = Generate character templates and JSON for Perchance AI Character Chat, plus optional avatar images.
  image = https://user-uploads.perchance.org/file/c4d5454a9df9368cfe8ef614e01206ae.jpg

settings
  pageTitle = AI Character Generator V3
  introMessage = Fill in the character sheet panel above, then click Generate character. Use the image inputs below to create optional avatars.
  underImagesMessage = <div style="max-width:700px; margin:0 auto; padding:0 1rem; font-size:85%; opacity:0.7;">Tip: Use the character sheet generator first, then refine with the image prompts.</div>
  numImages = [Number(input.numImages)]
  socialFeatures = disabled

  imageButtons
    personality = false
    privateSave = true

  imageOptions
    saveTitle = ([input.artStyle.getName]) [input.description]
    prompt = [input.artStyle.prompt]
    negativePrompt = [input.negative]
    resolution = [input.shape]

  userInputs
    description
      label = Avatar description
      tip = Describe the character for image generation.
      type = paragraph
      remember = true
      width = min(750px, 100%)
      takesUpFullRow = true
      enterKeyTriggersGeneration = true
      examples
        a heroic ranger with a weathered cloak, forest backdrop, cinematic lighting

    negative
      label = Avoid (optional)
      tip = Things you do not want in the image.
      type = text
      remember = true
      examples
        blurry, low quality, extra limbs

    artStyle
      label = Art style
      type = select
      remember = true
      options
        meta:import
          from = {import:t2i-styles}
        No style
          prompt = [input.description]
          negative = [input.negative]
          meta:position = 1

    shape
      label = Shape
      type = select
      remember = true
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512

    numImages
      label = How many?
      type = select
      remember = true
      options
        3 = 3
        6 = 6
        9 = 9

  showFeedback = false

randomDescription
  a confident detective in a long coat, rain-soaked city at night, moody lighting
