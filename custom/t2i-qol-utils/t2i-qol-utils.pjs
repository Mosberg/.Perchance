// t2i-qol-utils
// QoL helper wrapper.

copyText = {import:copy-text-plugin}
textTools = {import:text-tools-blackyt}
toolFunctions = {import:tools-functions-byt}
datePlugin = {import:date-plugin}

$meta
  title = t2i-qol-utils
  description = Shared copy, date, and utility functions for generator UX.

features
  copyPromptButton = true
  copyNegativePromptButton = true
  exportConfigButton = true
  importConfigButton = true
  presetButtons = true
