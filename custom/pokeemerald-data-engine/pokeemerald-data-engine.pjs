// =============================================================
//  AI PokeAPI → Pokeemerald-Expansion Data Engine
//  main.pjs  —  config, emerald mapping packs, perchance lists
// =============================================================

superFetch = {import:super-fetch-plugin}
kv = {import:kv-plugin}

$meta
  title = PokéEmerald Data Engine
  description = Fetch, edit, create, randomize, enchant, inject, and export PokéAPI data as pokeemerald-expansion tables.
  tags = pokemon, pokeapi, pokeemerald, romhack, data, generator
  header
    mode = minimal

// -------------------------------------------------------------
// CONFIG  (tweakable by user)
// -------------------------------------------------------------
pokeApiBase = https://pokeapi.co/api/v2
kvFolder = pokemon
defaultGeneration = generation-iii
defaultRegion = hoenn

// -------------------------------------------------------------
// EMERALD MAPPING PACKS  —  defined in index.html (JS module)
//   (kept there so they stay plain JS arrays; main.pjs is for
//    config + perchance lists only). See MAP constant in JS.
// -------------------------------------------------------------
// PERCHANCE LISTS  (used by Generator tab)
// -------------------------------------------------------------
randomNicknames
  Sparky
  Buddy
  Tiny
  Biggs
  Zappy
  Frosty
  Ember
  Mossy
  Glimmer
  Bolt
  Pebble
  Gale
  Misty
  Crimson
  Azure
  Jade
  Onyx
  Violet
  Topaz
  Quartz

randomNatures
  hardy
  lonely
  brave
  adamant
  naughty
  bold
  docile
  relaxed
  impish
  lax
  timid
  hasty
  serious
  jolly
  naive
  modest
  mild
  quiet
  bashful
  rash
  calm
  gentle
  sassy
  careful
  quirky

randomItems
  oran-berry
  sitrus-berry
  leftovers
  choice-band
  choice-scarf
  choice-specs
  life-orb
  focus-sash
  lum-berry
  chesto-berry

enchantPrefixes
  Ancient
  Primal
  Gigantamax
  Mega
  Shadow
  Shiny
  Crystal
  Astral
  Void
  Radiant

enchantSuffixes
  Flame
  Frost
  Storm
  Mist
  Void
  Light
  Legend
  Ruin
