$meta
  title = Rhythm — Multi-Genre
  description = A rhythm game with custom songs: chill jazz, intense boss fight, heavenly choir hymn, mechanical jiggy jazz trombones, neon synthwave, dreamy vaporwave, dark ethereal, and a demonic Japanese oni boss fight with an epic samurai duel B-side. Five difficulties, each with its own gimmick.
  tags = rhythm, game, music, jazz, boss, heavenly, trombone, synthwave, vaporwave, ethereal, oni, demonic, japanese, samurai

