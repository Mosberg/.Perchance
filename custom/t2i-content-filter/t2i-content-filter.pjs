// t2i-content-filter
// Content moderation wrapper.

filterCore = {import:aaga-fbdn}

$meta
  title = t2i-content-filter
  description = Wrapper around moderation and blocked-token logic.

filterModes
  safe = strict
  mature = medium
  off = disabled

defaults
  mode = safe
  hideBlockedOutput = true
  showBlockReason = true
