generateImage = {import:text-to-image-plugin}

$output
  Character
    prompt
      [input.description ? input.description + " " : ""][gender] [ageRange] year old [bodyType] [ethnicity] person, [hairStyle] [hairColor] hair, [eyeColor] eyes, [facialFeature], wearing [clothingStyle], [expression] expression, [setting] background, [artStyle], highly detailed, [lighting]
    negative = [input.negative || "blurry, low quality, distorted, deformed, ugly, extra limbs, bad anatomy, watermark, signature"]
    meta:tags = [({})]
    meta:image = []
    modifiers = [characterModifiers]

gender
  male^5
  female^5
  androgynous
  non-binary

ageRange = {18|22|25|28|30|35|40|45|50|55|60|65|70|75|80}

bodyType
  slim
  athletic
  muscular
  curvy
  slender
  average
  stocky
  petite
  tall and lean
  plus-size

ethnicity
  Caucasian
  African
  East Asian
  South Asian
  Southeast Asian
  Middle Eastern
  Hispanic
  Native American
  Pacific Islander
  mixed

hairStyle
  short
  long
  medium length
  curly
  wavy
  straight
  braided
  ponytail
  bun
  undercut
  buzz cut
  afro
  dreadlocks
  pixie cut
  bob
  messy
  slicked back

