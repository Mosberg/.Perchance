  .ftepic-banner-content h3 {
    margin: 0 0 5px;
    font-size: 1.2rem;
  }
  
  .ftepic-banner-content p {
    margin: 0;
    opacity: 0.9;
    font-size: 0.9rem;
  }
  
  .ftepic-banner-button {
