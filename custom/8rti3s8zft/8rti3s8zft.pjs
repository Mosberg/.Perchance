  <a href="https://ftepic.com/ai-writer" class="tool-card">
    <div class="tool-icon">✍️</div>
    <h3>AI Writer</h3>
    <p>Generate creative content</p>
  </a>
  <a href="https://ftepic.com/code-generator" class="tool-card">
    <div class="tool-icon">💻</div>
    <h3>Code Generator</h3>
    <p>AI-powered coding assistant</p>
  </a>
  <a href="https://ftepic.com/image-upscaler" class="tool-card">
    <div class="tool-icon">🔍</div>
    <h3>Image Upscaler</h3>
    <p>Enhance image resolution</p>
  </a>
  <a href="https://ftepic.com/nes" class="tool-card">
    <div class="tool-icon">🎮</div>
    <h3>Retro Games</h3>
    <p>Play classic NES games online</p>
  </a>
</div>

<div id="notification" class="notification">
  <div class="notification-icon">✅</div>
  <div class="notification-message">Settings saved successfully!</div>
  <button class="notification-close" onclick="hideNotification()">×</button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Load scratchpad content from localStorage
    const savedScratchpad = localStorage.getItem('aiGeneratorScratchpad');
    if (savedScratchpad) {
      document.getElementById('scratchpad').value = savedScratchpad;
    }
    
    // Enhance generate button
    const generateButton = document.querySelector('button[type="submit"]');
    if (generateButton) {
      generateButton.classList.add('generate-button');
      generateButton.innerHTML = '✨ Generate Images';
    }
    
    // Add classes to input containers
    const inputContainers = document.querySelectorAll('.input-container, .select-container');
    inputContainers.forEach(container => {
      container.classList.add('input-container');
    });
    
    // Add gallery title
    const galleryElement = document.querySelector('[data-gallery="true"]');
    if (galleryElement) {
      const galleryTitle = document.createElement('h2');
      galleryTitle.classList.add('gallery-title');
      galleryTitle.textContent = '🖼️ Community Gallery';
      galleryElement.parentNode.insertBefore(galleryTitle, galleryElement);
      galleryElement.classList.add('gallery-container');
    }
    
    // Add model badges
    const modelSelect = document.querySelector('select[name="model"]');
    if (modelSelect) {
      const modelBadgeContainer = document.createElement('div');
      modelBadgeContainer.style.marginTop = '10px';
      
      const modelOptions = Array.from(modelSelect.options);
      modelOptions.slice(0, 3).forEach(option => {
        const badge = document.createElement('span');
        badge.classList.add('model-badge');
        badge.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg> ${option.text}`;
        modelBadgeContainer.appendChild(badge);
      });
      
      const modelContainer = modelSelect.closest('.select-container');
      if (modelContainer) {
        modelContainer.appendChild(modelBadgeContainer);
      }
    }
    
    // Add animation effects
    document.querySelectorAll('.input-container').forEach(container => {
      container.style.transition = 'transform 0.3s ease, box-shadow 0.3s ease';
      container.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-2px)';
        this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.1)';
      });
      container.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = '0 2px 10px rgba(0,0,0,0.05)';
      });
    });
    
    // Move the form into the basic tab
    const form = document.querySelector('form');
    if (form) {
      const basicTab = document.getElementById('basic');
      if (basicTab) {
        basicTab.appendChild(form);
      }
    }
    
    // Add animation to feature cards
    document.querySelectorAll('.feature-card, .tool-card').forEach((card, index) => {
      card.style.opacity = "0";
      card.style.transform = "translateY(20px)";
      card.style.transition = "opacity 0.5s ease, transform 0.5s ease";
      card.style.transitionDelay = `${index * 0.1}s`;
      
      setTimeout(() => {
        card.style.opacity = "1";
        card.style.transform = "translateY(0)";
      }, 100);
    });
    
    // Custom shape handling
    const shapeSelect = document.querySelector('select[name="shape"]');
    if (shapeSelect) {
      shapeSelect.addEventListener('change', function() {
        if (this.value === 'custom') {
          // Update resolution in the imageOptions
          const widthInput = document.querySelector('input[name="customWidth"]');
          const heightInput = document.querySelector('input[name="customHeight"]');
          
          if (widthInput && heightInput) {
            const updateCustomResolution = () => {
              const width = widthInput.value;
              const height = heightInput.value;
              // Here we would need to update the resolution value that gets passed to the image generator
              console.log(`Custom resolution set to ${width}x${height}`);
            };
            
            widthInput.addEventListener('change', updateCustomResolution);
            heightInput.addEventListener('change', updateCustomResolution);
          }
        }
      });
    }
  });
  
  // Tab functionality
  function showTab(tabId) {
    // Hide all tabs
    document.querySelectorAll('.tab-content').forEach(tab => {
      tab.classList.remove('active');
    });
    
    // Deactivate all buttons
    document.querySelectorAll('.tab-button').forEach(button => {
      button.classList.remove('active');
    });
    
    // Show selected tab
    document.getElementById(tabId).classList.add('active');
    
    // Activate the clicked button
    document.querySelectorAll('.tab-button').forEach(button => {
      if (button.textContent.toLowerCase().includes(tabId)) {
        button.classList.add('active');
      }
    });
  }
  
  // Function to use example prompts
  function usePrompt(button) {
    const promptText = button.previousElementSibling.textContent;
    const descriptionTextarea = document.querySelector('textarea[name="description"]');
    if (descriptionTextarea) {
      descriptionTextarea.value = promptText;
      descriptionTextarea.focus();
      // Scroll to the form
      const form = document.querySelector('form');
      if (form) {
        form.scrollIntoView({ behavior: 'smooth' });
      }
      // Show the basic tab
      showTab('basic');
    }
  }
  
  // Toggle advanced settings
  function toggleAdvancedSettings(element) {
    const content = element.nextElementSibling;
    element.classList.toggle('collapsed');
    content.classList.toggle('collapsed');
  }
  
  // Scratchpad functions
  function saveScratchpad() {
    const scratchpadContent = document.getElementById('scratchpad').value;
    localStorage.setItem('aiGeneratorScratchpad', scratchpadContent);
    showNotification('Scratchpad saved successfully!');
  }
  
  function clearScratchpad() {
    document.getElementById('scratchpad').value = '';
    localStorage.removeItem('aiGeneratorScratchpad');
    showNotification('Scratchpad cleared!');
  }
  
  // Notification functions
  function showNotification(message) {
    const notification = document.getElementById('notification');
    const messageElement = notification.querySelector('.notification-message');
    messageElement.textContent = message;
    notification.classList.add('show');
    
    // Auto-hide after 3 seconds
    setTimeout(() => {
      hideNotification();
    }, 3000);
  }
  
  function hideNotification() {
    const notification = document.getElementById('notification');
    notification.classList.remove('show');
  }
  
  // Handle custom resolution
  function updateCustomResolution() {
    const widthInput = document.querySelector('input[name="customWidth"]');
    const heightInput = document.querySelector('input[name="customHeight"]');
    
    if (widthInput && heightInput) {
      const width = widthInput.value;
      const height = heightInput.value;
      
      // Update the shape value to reflect custom dimensions
      const customResolution = `${width}x${height}`;
      console.log(`Setting custom resolution: ${customResolution}`);
      
      // Here we would ideally update the actual resolution that gets used
      // This might require additional integration with the framework
    }
  }
</script>
"""

generateHTML = {import:t2i-framework-plugin-v2}

font = {import:font-plugin}
generateText = {import:ai-text-plugin} 
generateImage = {import:text-to-image-plugin}  
commentsPlugin = {import:comments-plugin}  
background = [d('background-image-plugin')]
art = {import:art-style-updated2} 
forum = {import:comments-plugin}
favicon = {import:favicon-plugin}
generatorStats = {import:generator-stats-plugin}