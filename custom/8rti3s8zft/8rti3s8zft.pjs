generateHTML = {import:t2i-framework-plugin-v2}

$meta
  title = Ultimate AI Image Generator Pro
  description = Create stunning AI-generated images with professional settings and advanced customization. Powered by cutting-edge AI models with no limits, no sign-up required. Generate photorealistic images, artistic masterpieces, and creative concepts instantly.
  image = 
  author = 
  keywords = AI image generator, text to image, stable diffusion, AI art, free image generator, ftepic, NSFW generator, professional AI

settings 
  pageTitle = 🎨 Ultimate AI Image Generator Pro
  introMessage = <br><br>Transform your ideas into stunning visuals with our advanced AI. Simply describe what you want, adjust settings, and click <b>Generate</b>.<br><br>
  numImages = [Number(input.numImages)]
  socialFeatures = button after 3 clicks
  
  imageOptions
    model = [input.model]
    sampler = [input.sampler]
    steps = [Number(input.steps)]
    cfgScale = [Number(input.cfgScale)]
    seed = [input.seed === "" ? -1 : Number(input.seed)]
    saveTitle = ([input.artStyle.getName]) [input.description]
    prompt = [input.artStyle.prompt], [input.quality], [input.lighting], [input.atmosphere], [input.enhancement], [input.subject], [input.location], [input.time]
    negativePrompt = [input.artStyle.negative], [input.negative], low quality, blurry, distorted, deformed, ugly, amateur, bad anatomy
    resolution = [input.shape]
    upscale = [input.upscale === "true"]
    denoise = [Number(input.denoise)]
    removeBackground = [input.removeBackground === "true"]
  
  userInputs
    description
      label = 📝 Description
      tip = Pro Tips:\n- Use {option1|option2} for random selection\n- Use [brackets] for emphasis\n- Be specific with details\n- Hover over any image to see its prompt\n- Add @username to tag people
      type = paragraph
      width = min(900px, 100%)
      takesUpFullRow = true
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description.input, event:artStyle.change
      enterKeyTriggersGeneration = true
      defaultValue = Create a stunning image
      examples = [input.artStyle?.randomPrompt || randomDescription]
      random = [input.artStyle?.randomPrompt || randomDescription]

    artStyle
      label = 🎨 Art Style
      type = select
      remember = true
      options
        Photorealistic
          prompt = [input.description], photorealistic, hyperrealistic, 8k uhd, professional photography, detailed
          negative = cartoon, painting, illustration, drawing, anime, 3d render, low quality
          meta:position = 1
          
        Cinematic
          prompt = [input.description], cinematic, film still, movie scene, dramatic lighting, high budget production
          negative = cartoon, low budget, amateur, low quality
          meta:position = 2
          
        Digital Art
          prompt = [input.description], digital art, concept art, detailed, vibrant colors, high detail
          negative = photograph, low quality, blurry
          meta:position = 3
          
        Oil Painting
          prompt = [input.description], oil painting, masterpiece, detailed brushwork, traditional media, canvas texture
          negative = digital art, 3d, photograph, low quality
          meta:position = 4
          
        Anime
          prompt = [input.description], anime style, manga, detailed, vibrant, studio ghibli inspired
          negative = photorealistic, 3d render, western style, low quality
          meta:position = 5
          
        Fantasy
          prompt = [input.description], fantasy art, magical, mystical, detailed, vibrant colors, epic scene
          negative = modern, mundane, realistic, low quality
          meta:position = 6
          
        Sci-Fi
          prompt = [input.description], science fiction, futuristic, high tech, detailed, cyberpunk elements
          negative = medieval, fantasy, low tech, low quality
          meta:position = 7
          
        3D Render
          prompt = [input.description], 3d render, octane render, unreal engine, ray tracing, detailed textures
          negative = 2d, flat, photograph, painting, low quality
          meta:position = 8
          
        Watercolor
          prompt = [input.description], watercolor painting, flowing colors, artistic, traditional media
          negative = digital art, 3d, photograph, low quality
          meta:position = 9
          
        Pencil Sketch
          prompt = [input.description], pencil sketch, detailed drawing, graphite, monochrome
          negative = color, painting, photograph, digital art, low quality
          meta:position = 10
          
        Pop Art
          prompt = [input.description], pop art style, bold colors, comic-like, andy warhol inspired
          negative = realistic, subtle, muted colors, low quality
          meta:position = 11
          
        Vintage
          prompt = [input.description], vintage style, retro, old photograph, nostalgic, film grain
          negative = modern, digital, clean, low quality
          meta:position = 12
          
        Cyberpunk
          prompt = [input.description], cyberpunk style, neon lights, futuristic city, high tech low life
          negative = natural, rural, historical, low quality
          meta:position = 13
          
        Steampunk
          prompt = [input.description], steampunk style, victorian futurism, brass, gears, steam-powered
          negative = modern, digital, sleek, low quality
          meta:position = 14
          
        Surrealism
          prompt = [input.description], surrealist art, dreamlike, salvador dali inspired, impossible physics
          negative = realistic, logical, mundane, low quality
          meta:position = 15
          
        Minimalist
          prompt = [input.description], minimalist style, simple, clean lines, limited color palette
          negative = detailed, complex, busy, cluttered, low quality
          meta:position = 16
          
        Abstract
          prompt = [input.description], abstract art, non-representational, shapes and colors, artistic expression
          negative = realistic, figurative, representational, low quality
          meta:position = 17
          
        Portrait
          prompt = [input.description], portrait style, focused on subject, detailed facial features
          negative = landscape, wide shot, low quality
          meta:position = 18
          
        Landscape
          prompt = [input.description], landscape art, panoramic view, scenic, detailed environment
          negative = portrait, close-up, low quality
          meta:position = 19
          
        NSFW Art
          prompt = [input.description], artistic nude, tasteful, high quality, professional photography
          negative = explicit, pornographic, crude, low quality, childish
          meta:position = 20
          
        Casual Photo
          prompt = [input.description], casual photo, natural beauty, authentic moment
          negative = bad photo, bad lighting, unnatural studio lighting, photoshopped, low quality
          meta:position = 21
          
        No Style
          prompt = [input.description]
          negative = [input.negative], low quality
          meta:position = 22

    subject
      label = 👤 Subject
      type = select
      remember = true
      options
        None = 
        Person = person, human subject, portrait subject
        Woman = woman, female subject
        Man = man, male subject
        Child = child, young person
        Elderly = elderly person, senior
        Couple = couple, two people
        Group = group of people, crowd
        Animal = animal, creature
        Fantasy = fantasy creature, mythical being
        Robot = robot, android, mechanical being
        Abstract = abstract subject, conceptual entity
      visible() =>
        return Number(localStorage.generateClickCount) > 1;

    location
      label = 🌎 Location
      type = select
      remember = true
      options
        None = 
        Urban = urban cityscape, city environment, metropolitan area
        Nature = natural environment, outdoors, wilderness
        Beach = beach, seaside, coastal area
        Mountains = mountains, alpine, highlands
        Forest = forest, woods, trees
        Desert = desert, arid landscape, sand dunes
        Space = outer space, cosmic, stellar
        Underwater = underwater, submerged, oceanic
        Indoor = indoor setting, interior space
        Studio = studio setting, controlled environment
        Fantasy = fantasy realm, magical location
        Sci-Fi = science fiction setting, futuristic environment
      visible() =>
        return Number(localStorage.generateClickCount) > 1;

    time
      label = ⏰ Time & Weather
      type = select
      remember = true
      options
        None = 
        Day = daytime, daylight, sunny day
        Night = nighttime, night, darkness
        Sunset = sunset, dusk, golden hour
        Sunrise = sunrise, dawn, morning light
        Rainy = rainy weather, rain, wet conditions
        Snowy = snowy weather, snow, winter scene
        Foggy = foggy, misty, hazy conditions
        Stormy = stormy weather, storm, tempest
        Clear Sky = clear sky, blue sky, cloudless
        Cloudy = cloudy, overcast, gray skies
      visible() =>
        return Number(localStorage.generateClickCount) > 1;

    model
      label = 🧠 AI Model
      type = select
      remember = true
      options
        SD XL = stable-diffusion-xl
        SD 1.5 = stable-diffusion-v1-5
        Realistic Vision = realistic-vision-v4
        Dreamshaper = dreamshaper-8
        Deliberate = deliberate-v2
        Anything = anything-v5
        Openjourney = openjourney-v4
      
    quality
      label = 💎 Quality Level
      type = select
      remember = true
      options
        Masterpiece = masterpiece, best quality, mastercraft quality, perfect detail, professional grade, 8k uhd
        Professional = professional quality, high detail, industry standard, excellent quality
        Premium = premium quality, enhanced detail, high quality
        Standard = standard quality, good detail
        Artistic = artistic quality, stylized detail

    lighting
      label = 💡 Lighting
      type = select
      remember = true
      options
        None = 
        Natural = natural lighting, perfect exposure, soft shadows
        Studio = professional studio lighting, controlled environment, perfect exposure
        Dramatic = dramatic lighting, high contrast, mood lighting, shadows
        Cinematic = cinematic lighting, film quality, perfect balance, atmospheric
        Sunset = golden hour lighting, warm tones, natural glow, orange hues
        Night = night lighting, moonlit, atmospheric, dark with highlights
        Neon = neon lighting, colorful glows, cyberpunk aesthetic
        Backlit = backlit subject, rim lighting, silhouette effect

    atmosphere
      label = 🌟 Atmosphere
      type = select
      remember = true
      options
        None = 
        Professional = professional atmosphere, clean, polished
        Dramatic = dramatic atmosphere, intense, powerful
        Peaceful = peaceful atmosphere, serene, calming
        Mysterious = mysterious atmosphere, enigmatic, intriguing
        Ethereal = ethereal atmosphere, dreamlike, magical
        Romantic = romantic atmosphere, soft, intimate
        Dynamic = dynamic atmosphere, energetic, vibrant
        Nostalgic = nostalgic atmosphere, vintage feel, timeless

    enhancement
      label = ✨ Enhancement
      type = select
      remember = true
      options
        None = 
        HDR = HDR enhancement, perfect exposure, vivid
        Soft = soft focus effect, dreamy quality
        Sharp = ultra sharp, crystal clear detail
        Bokeh = beautiful bokeh effect, depth of field
        Glow = subtle glow effect, ethereal quality
        Contrast = enhanced contrast, deep blacks
        Vibrant = vibrant colors, rich saturation
        Film Grain = subtle film grain, analog feel
        Detailed = highly detailed, intricate

    shape
      label = 📐 Dimensions
      type = select
      remember = true
      options
        Portrait HD = 512x768
        Square HD = 512x512
        Landscape HD = 768x512
        Cinema = 896x512
        Vertical = 512x896
        Portrait 4K = 1024x1536
        Landscape 4K = 1536x1024
        Square 4K = 1024x1024
        Custom = custom

    customWidth
      label = 📏 Custom Width
      type = number
      remember = true
      min = 256
      max = 2048
      step = 64
      defaultValue = 512
      visible() =>
        return input.shape === "custom";

    customHeight
      label = 📏 Custom Height
      type = number
      remember = true
      min = 256
      max = 2048
      step = 64
      defaultValue = 512
      visible() =>
        return input.shape === "custom";

    sampler
      label = ⚙️ Sampling Method
      type = select
      remember = true
      options
        Euler a = Euler a
        DPM++ 2M = DPM++ 2M
        DPM++ SDE = DPM++ SDE
        DDIM = DDIM
        UniPC = UniPC
        DPM3 = DPM3
        PLMS = PLMS
      visible() =>
        return Number(localStorage.generateClickCount) > 2;

    steps
      label = 🔄 Generation Steps
      type = number
      remember = true
      min = 20
      max = 150
      step = 5
      defaultValue = 35
      tip = Higher values = better quality but slower generation
      visible() =>
        return Number(localStorage.generateClickCount) > 2;

    cfgScale
      label = 🎯 CFG Scale
      type = number
      remember = true
      min = 1
      max = 30
      step = 0.5
      defaultValue = 7.5
      tip = Controls how closely the image follows your prompt
      visible() =>
        return Number(localStorage.generateClickCount) > 2;

    seed
      label = 🎲 Seed
      type = text
      tip = Leave empty for random results or enter a number for reproducible images
      remember = true
      visible() =>
        return Number(localStorage.generateClickCount) > 2;
        
    upscale
      label = 🔍 Upscale
      type = select
      remember = true
      options
        Yes = true
        No = false
      visible() =>
        return Number(localStorage.generateClickCount) > 3;
        
    denoise
      label = 🧹 Denoise Strength
      type = number
      remember = true
      min = 0.1
      max = 1.0
      step = 0.05
      defaultValue = 0.7
      tip = Higher values create cleaner images but may lose details
      visible() =>
        return Number(localStorage.generateClickCount) > 3;
        
    removeBackground
      label = 🖼️ Remove Background
      type = select
      remember = true
      options
        No = false
        Yes = true
      visible() =>
        return Number(localStorage.generateClickCount) > 3;

    negative
      label = 🚫 Negative Prompt
      type = text
      width = min(900px, 100%)
      takesUpFullRow = true
      examples
        things you don't want in the image
        unwanted elements, bad quality, errors
      visible() =>
        return Number(localStorage.generateClickCount) > 1;

    numImages
      label = 🖼️ Batch Size
      type = select
      remember = true
      options
        3 = 3
        6 = 6
        9 = 9
        12 = 12
        15 = 15
      visible() =>
        return Number(localStorage.generateClickCount) > 1;
        
    nsfw
      label = 🔞 Content Filter
      type = select
      remember = true
      options
        PG-13 = pg13
        No Filter = none
      visible() =>
        return Number(localStorage.generateClickCount) > 4;

    promptEnhance
      label = 🧠 AI Prompt Enhancement
      type = select
      remember = true
      options
        No = false
        Yes = true
      visible() =>
        return Number(localStorage.generateClickCount) > 2;
        
  defaultCommentOptions
    width = 100%
    height = 400
    commentPlaceholderText = Share your thoughts or prompt ideas...
    submitButtonText = Submit Comment
    bannedUsers = [bannedUsersList]
    
  commentChannels
    general
      label = 💬 General
    prompts
      label = 📝 Prompt Ideas
      commentPlaceholderText = Share a cool prompt or technique
      submitButtonText = Share Prompt
    feedback
      label = 📢 Feedback
      commentPlaceholderText = Let us know how we can improve
      submitButtonText = Send Feedback
    nsfw
      label = 🔞 NSFW
      commentPlaceholderText = Share adult-oriented prompts here
      submitButtonText = Share Prompt
      contentFilter = none
  
  galleryOptions
    gallery = true
    sort = trending
    timeRange = 1-week
    hideIfScoreIsBelow = -1
    adaptiveHeight = true
    contentFilter = [input.nsfw || "pg13"]
    showInfo = true
    showControls = true
    columns = responsive
    spacing = 10
    
  showFeedback = false
  
  // Footer content
  footerContent
    style = display: flex; justify-content: center; align-items: center; padding: 20px; gap: 30px; margin-top: 50px; border-top: 1px solid #eee; background-color: #f8f9fa;
    links
      ftepic
        text = FtEpic.com
        url = https://ftepic.com
        style = color: #ff6b00; font-weight: bold; font-size: 16px; text-decoration: none; transition: color 0.3s ease;
        hoverStyle = color: #ff8533;
      portfolio
        text = AI Tools
        url = https://ftepic.com/ai-tools
        style = color: #4a90e2; font-weight: bold; font-size: 16px; text-decoration: none; transition: color 0.3s ease;
        hoverStyle = color: #2a70c2;
      games
        text = Retro Games
        url = https://ftepic.com/games
        style = color: #8a2be2; font-weight: bold; font-size: 16px; text-decoration: none; transition: color 0.3s ease;
        hoverStyle = color: #9f3fff;
    template = """
      <div style="[footerContent.style]">
        <a href="[footerContent.links.ftepic.url]" target="_blank" style="[footerContent.links.ftepic.style]" onmouseover="this.style.color='[footerContent.links.ftepic.hoverStyle.color]'" onmouseout="this.style.color='[footerContent.links.ftepic.style.color]'">
          [footerContent.links.ftepic.text]
        </a>
        <a href="[footerContent.links.portfolio.url]" target="_blank" style="[footerContent.links.portfolio.style]" onmouseover="this.style.color='[footerContent.links.portfolio.hoverStyle.color]'" onmouseout="this.style.color='[footerContent.links.portfolio.style.color]'">
          [footerContent.links.portfolio.text]
        </a>
        <a href="[footerContent.links.games.url]" target="_blank" style="[footerContent.links.games.style]" onmouseover="this.style.color='[footerContent.links.games.hoverStyle.color]'" onmouseout="this.style.color='[footerContent.links.games.style.color]'">
          [footerContent.links.games.text]
        </a>
      </div>
    """

