randomDescription
  // Professional Portraits
  professional portrait of a [profession], [location], [time], detailed lighting
  artistic portrait, [profession] with {dramatic|subtle|natural} lighting, [location]
  environmental portrait, [profession] in [location], [time], {candid|posed} shot
  
  // Character Studies
  detailed character study, {mysterious|intriguing|charismatic} [profession], [location]
  emotional portrait of a [profession], {intense|subtle|powerful} expression, [time]
  character portrait, [profession] with {strong|unique|compelling} features, [location]
  
  // Landscapes & Environments
  breathtaking view of [location] during [time], {panoramic|wide-angle|telephoto} shot
  majestic landscape, [location] with {dramatic clouds|clear skies|misty atmosphere}, [time]
  immersive environment, [location] with {intricate details|atmospheric lighting|dynamic elements}
  
  // Conceptual & Abstract
  conceptual {image|artwork|composition} representing {freedom|love|time|power|change}, [location] elements
  abstract {visualization|representation|interpretation} of {motion|emotion|transformation|growth}, [time] colors
  surreal {scene|composition|artwork} blending [profession] and [location] with {impossible physics|dreamlike elements}
  
  // Technical Showcases
  {ultra-detailed|photorealistic|hyperreal} [profession] in [location], {8k|studio quality|professional lighting}
  technical demonstration of {lighting|composition|color theory|perspective} using [location] during [time]
  showcase of {material rendering|atmospheric effects|dynamic lighting} with [profession] in [location]
  
  // Stylized Art
  {impressionist|cubist|art nouveau|pop art} style [profession] in [location], artistic interpretation
  {watercolor|oil painting|digital art|pencil sketch} of [location] during [time], {vibrant|muted|monochrome} palette
  stylized {portrait|scene|composition} of [profession] with {exaggerated|simplified|distorted} features
  
  // Atmospheric & Moody
  moody {portrait|scene|environment} of [profession] in [location], {low-key|high-contrast|atmospheric} lighting
  atmospheric [location] during [time], {fog|mist|rain|snow} creating {depth|mystery|drama}
  emotional {moment|scene|capture} with [profession] in [location], {melancholic|joyful|tense} mood
  
  // Action & Dynamic
  dynamic {action shot|movement capture|freeze frame} of [profession] in [location], {mid-motion|peak action}
  energetic {scene|moment|composition} with [profession] {running|jumping|flying|dancing} in [location]
  high-energy {portrait|capture|scene} of [profession] during {intense moment|critical action|peak performance}
  
  // Futuristic & Sci-Fi
  futuristic {portrait|scene|environment} with [profession] in {neon-lit|high-tech|cybernetic} [location]
  sci-fi interpretation of [profession], {advanced technology|alien landscape|space elements}, [location]
  cyberpunk {character|scene|world} with [profession] in {dystopian|neon|technological} [location]
  
  // Historical & Vintage
  historical {portrait|scene|moment} of [profession] in [location], {victorian|renaissance|ancient|medieval} era
  vintage style {photograph|image|portrait} of [profession], {sepia tones|film grain|analog feel}
  retro-inspired {scene|composition|artwork} with [profession] in [location], {nostalgic|timeless|classic} feel
  
  // Fantasy & Magical
  fantasy {character|scene|world} featuring a [profession] with {magical abilities|mystical artifacts|enchanted items}
  magical {landscape|environment|realm} with [profession] as {guardian|explorer|creator}, [time] atmosphere
  enchanted [location] with [profession] {casting spells|performing rituals|harnessing powers}, {mystical|ethereal|arcane} elements
  
  // Anime & Stylized
  anime-style {character|portrait|scene} of [profession] in [location], {vibrant colors|expressive features|dynamic pose}
  manga-inspired {artwork|illustration|composition} featuring [profession] during {dramatic moment|action sequence|emotional scene}
  stylized {character design|concept art|illustration} of [profession] with {unique costume|signature weapon|distinctive features}
  
  // Architectural & Urban
  architectural {marvel|wonder|masterpiece} in [location], {intricate details|perfect symmetry|stunning design}
  urban {landscape|environment|scene} in [location] during [time], {bustling activity|quiet moment|dramatic weather}
  detailed {interior|exterior|structure} of {modern|historic|futuristic} building in [location], {perfect lighting|dramatic shadows|atmospheric mood}
  
  // NSFW Additions
  beautiful {elven|tiefling} [profession], {tight dress|peekaboo cutout dress}, narrow waist
  {succubus|demon girl}, wind blowing hair, {high-waisted shorts|plunging neckline}, {ethereal|bokeh}
  {cheerful|shy|surprised}, blushing, {midriff|velvet choker}, {backlit|tilt-shift}
  {catgirl|wolfgirl|foxgirl}, moonlit, {low|high}-angle shot
  {tank top|oversized shirt|ripped jeans}, beautiful detailed face, {high contrast|low depth of field|long exposure}
  {kimono|cheongsam|thigh-high slit dress}, long elegant legs, {wide|narrow} hips, {cyberpunk|blue skies|candle-lit}
  {petite|curvy}, {21-35} years old, {athletic|graceful}, {green|red|blue|hot pink} short shorts
  overlooking the {city|harbor|kingdom|valley|sea} at night, wind blowing hair, {tight|short|off-the-shoulder} dress, sleek figure

