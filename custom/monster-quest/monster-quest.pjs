$meta
  title = Monster Quest
  description = A Pokemon-style creature battler with AI-generated monsters. Explore biomes, catch creatures, and battle!
  tags = game, rpg, monsters, ai, pixel-art, creature-collector
  image = https://perchance.org/monster-quest-icon.png

generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

namePrefix
  Pyro
  Hydro
  Volt
  Cryo
  Terra
  Aero
  Drago
  Spectre
  Toxi
  Metallo
  Fae
  Nimbus
  Shadow
  Psycho
  Petra
  Geo
  Flora
  Ignis
  Aqua
  Storm
  Frost
  Bould
  Venin
  Chloro
  Magnet
  Cryst
  Lumin
  Umbra
  Solar
  Lunar
  Neon
  Quartz

nameSuffix
  saur
  mon
  rex
  drake
  wolf
  beast
  claw
  fang
  horn
  wing
  tail
  spike
  flame
  surge
  shard
  leaf
  eye
  roar
  pup
  cub
  ling
  ant
  odon
  ix
  tus
  fin
  moth
  bull
  rix
  dawn
