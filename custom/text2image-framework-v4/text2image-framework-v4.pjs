// text2image-framework-v4
// Multi-engine compatibility wrapper with settings normalization.

frameworkCore = {import:text2image-framework}
frameworkMossV1 = {import:t2i-framework-plugin-moss}
frameworkMossV2 = {import:t2i-framework-plugin-moss-v2}
frameworkVulkcatV3 = {import:t2i-framework-plugin-vulkcat-v3}
stateManager = {import:t2i-state-manager}
seedEngine = {import:t2i-seed-engine}
promptProcessor = {import:t2i-prompt-processor}
modifierGroups = {import:t2i-modifier-groups}
contentFilter = {import:t2i-content-filter}
metadataManager = {import:t2i-metadata-manager}
qolUtils = {import:t2i-qol-utils}

$meta
  title = text2image-framework-v4
  description = Multi-engine compatibility layer that normalizes settings and routes to core, moss-v1/v2, or vulkcat-v3.

mode
  auto = auto
  core = core
  moss-v1 = moss-v1
  moss = moss-v2
  vulkcat = vulkcat-v3

normalizeEngineName(raw) => (String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "auto" ? "auto" : (String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "core" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "text2image-framework" ? "core" : (String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "moss" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "moss-v2" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "v2" ? "moss-v2" : (String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "moss-v1" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "moss1" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "v1" ? "moss-v1" : (String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "vulkcat" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "vulkcat-v3" || String(raw === undefined || raw === null ? "" : raw).toLowerCase().trim() === "v3" ? "vulkcat-v3" : "")))))

prepareSettings(s) => (s = s || {}, s.frameworkV4 = s.frameworkV4 || {}, s.imageOptions = s.imageOptions || {}, s.imageButtons = s.imageButtons || {}, s.pageTitle = s.pageTitle || s.title || s.pageTitle, s.subtitle = s.subtitle || s.pageSubtitle || s.description || s.subtitle, s.defaultImageCount = (s.defaultImageCount !== undefined ? Math.max(1, Math.round(Number(s.defaultImageCount))) : (s.numImages !== undefined ? Math.max(1, Math.round(Number(s.numImages))) : s.defaultImageCount)), s.numImages = (s.numImages !== undefined ? s.numImages : (s.defaultImageCount !== undefined ? s.defaultImageCount : s.numImages)), s.imageButtons.privateSave = (s.imageButtons.privateSave === undefined ? true : s.imageButtons.privateSave), s.enablePersonaHooks = (s.enablePersonaHooks === undefined ? (s.imageButtons.personality === undefined ? s.enablePersonaHooks : !!s.imageButtons.personality) : s.enablePersonaHooks), s.imageButtons.personality = (s.imageButtons.personality === undefined ? (s.enablePersonaHooks === undefined ? s.imageButtons.personality : !!s.enablePersonaHooks) : s.imageButtons.personality), s.showComments = (s.showComments === undefined ? (s.socialFeatures !== undefined ? (String(s.socialFeatures).toLowerCase() !== "disabled") : false) : s.showComments), s.frameworkV4.modules = { stateManager: stateManager, seedEngine: seedEngine, promptProcessor: promptProcessor, modifierGroups: modifierGroups, contentFilter: contentFilter, metadataManager: metadataManager, qolUtils: qolUtils }, s)

resolveEngine(s) => (normalizeEngineName(s.frameworkV4.engine || s.frameworkEngine || s.framework || s.engine) && normalizeEngineName(s.frameworkV4.engine || s.frameworkEngine || s.framework || s.engine) !== "auto" ? normalizeEngineName(s.frameworkV4.engine || s.frameworkEngine || s.framework || s.engine) : (s.frameworkV4.preferVulkcat === true ? "vulkcat-v3" : (s.frameworkV4.preferMoss === true ? "moss-v2" : (s.frameworkV4.preferMossV1 === true ? "moss-v1" : ((s.userInputs || s.categoryBar || s.promptTemplateConfig || s.videoPanel) ? "vulkcat-v3" : ((s.frameworkV2 || s.socialFeatures !== undefined || s.commentChannels || s.defaultCommentOptions) ? "moss-v2" : "core"))))))

applyEngineCompat(s) => (s.frameworkV4.engineResolved = resolveEngine(s), s.frameworkV4.engineResolved = ((s.frameworkV4.engineResolved === "moss-v1" || s.frameworkV4.engineResolved === "moss-v2" || s.frameworkV4.engineResolved === "vulkcat-v3") && !s.userInputs ? "core" : s.frameworkV4.engineResolved), (s.frameworkV4.engineResolved === "moss-v1" || s.frameworkV4.engineResolved === "moss-v2") ? (s.socialFeatures = (s.socialFeatures === undefined ? (s.showComments ? "button" : "disabled") : s.socialFeatures), s.frameworkV2 = s.frameworkV2 || { enabled: true, showQuickActions: true, keyboardShortcuts: true, showSessionStats: true, showScrollTopButton: true }, s.imageOptions.prompt = s.imageOptions.prompt || "[input.artStyle?.prompt || input.description]", s.imageOptions.negativePrompt = s.imageOptions.negativePrompt || "[input.artStyle?.negative || input.negative]", s.imageOptions.resolution = s.imageOptions.resolution || "[input.shape]") : "", (s.frameworkV4.engineResolved === "vulkcat-v3") ? (s.categoryBar = s.categoryBar || { width: "fit-content", Prompt: "description, negative", Controls: "artStyle, shape, numImages, seed, guidanceScale" }, s.promptTemplateConfig = s.promptTemplateConfig || { title: "Prompt Builder", storageKey: "t2i_v4_prompt_template_v1" }, s.imageOptions.prompt = s.imageOptions.prompt || "[input.artStyle?.prompt || input.description]", s.imageOptions.negativePrompt = s.imageOptions.negativePrompt || "[input.artStyle?.negative || input.negative]", s.imageOptions.resolution = s.imageOptions.resolution || "[input.shape]") : "", s)

renderByEngineV4(s) => (s = applyEngineCompat(prepareSettings(s)), window.t2iFrameworkV4 = window.t2iFrameworkV4 || {}, window.t2iFrameworkV4.lastResolvedEngine = s.frameworkV4.engineResolved, window.t2iFrameworkV4.lastSettings = s, s.frameworkV4.engineResolved === "moss-v1" ? (frameworkMossV1 ? frameworkMossV1(s) : (frameworkMossV2 ? frameworkMossV2(s) : (frameworkCore ? frameworkCore(s) : ""))) : (s.frameworkV4.engineResolved === "moss-v2" ? (frameworkMossV2 ? frameworkMossV2(s) : (frameworkMossV1 ? frameworkMossV1(s) : (frameworkCore ? frameworkCore(s) : ""))) : (s.frameworkV4.engineResolved === "vulkcat-v3" ? (frameworkVulkcatV3 ? frameworkVulkcatV3(s) : (frameworkMossV2 ? frameworkMossV2(s) : (frameworkCore ? frameworkCore(s) : ""))) : (frameworkCore ? frameworkCore(s) : (frameworkMossV2 ? frameworkMossV2(s) : (frameworkVulkcatV3 ? frameworkVulkcatV3(s) : (frameworkMossV1 ? frameworkMossV1(s) : "")))))))

$output(settings) =>
  [renderByEngineV4(settings)]
