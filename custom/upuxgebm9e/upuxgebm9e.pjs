generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}

$meta
  title = Gerador de Personagens Consistentes
  description = Crie um personagem e gere imagens dele em diferentes poses e cenários mantendo a consistência visual.
  tags = character, image, consistent, rpg, portrait

// --- listas de sugestão para o formulário (valores em inglês pro prompt) ---
