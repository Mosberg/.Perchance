// --- função que monta o prompt detalhado do personagem ---
// Este é o coração da consistência: a descrição física fica idêntica em todas as gerações.
buildCharacterPrompt(char) =>
  let parts = [];
  parts.push(`a ${char.age||"adult"} year old ${char.gender||""} character`);
  if (char.race) parts.push(`(${char.race})`);
  let body = [];
  if (char.bodyType) body.push(char.bodyType);
  if (char.height) body.push(char.height);
  if (body.length) parts.push(body.join(", ") + " build");
  if (char.skinTone) parts.push(char.skinTone);
  let hair = [];
  if (char.hairColor) hair.push(char.hairColor);
  if (char.hairStyle) hair.push(char.hairStyle + " hair");
  if (hair.length) parts.push(hair.join(" "));
  if (char.eyeColor) parts.push(char.eyeColor + " eyes");
  if (char.faceShape) parts.push(char.faceShape + " face");
  if (char.clothing) parts.push("wearing " + char.clothing);
  if (char.accessories) parts.push("with " + char.accessories);
  if (char.distinctiveFeature && char.distinctiveFeature !== "nenhum") parts.push("distinctive " + char.distinctiveFeature);
  if (char.personality) parts.push("expressing a " + char.personality + " demeanor");
  return parts.join(", ");

// --- função que monta o prompt completo da cena ---
buildScenePrompt(char, scene) =>
  let charDesc = root.buildCharacterPrompt(char);
  let sceneParts = [];
  sceneParts.push(charDesc);
  if (scene.pose) sceneParts.push(scene.pose);
  let env = [];
  if (scene.scenario) env.push(scene.scenario);
  if (scene.timeOfDay) env.push("during " + scene.timeOfDay);
  if (scene.mood) env.push(scene.mood + " atmosphere");
  if (env.length) sceneParts.push(env.join(", "));
  if (scene.extra) sceneParts.push(scene.extra);
  let style = char.artStyle || "digital painting";
  let full = `${sceneParts.join(", ")}. Style: ${style}, highly detailed, masterpiece, trending on artstation, sharp focus, professional illustration`;
  return full;

// --- traduz texto livre do jogador para inglês ---
async translateToEnglish(text) =>
  if (!text || !text.trim()) return text;
  let instruction = "Translate the following text to English. Keep it concise and suitable for an image generation prompt. Output ONLY the translation, nothing else. Do NOT use square brackets.\n\nText: " + text;
  let translated = await root.generateText({ instruction: instruction });
  let cleaned = translated.trim();
  cleaned = cleaned.replace(/\[/g, "(").replace(/\]/g, ")");
  return cleaned;

// --- analisa a pose e otimiza o prompt removendo detalhes invisíveis ---
async optimizePromptByPose(fullPrompt, pose) =>
  let instruction = "You are an image prompt optimizer. Given a full image prompt and a pose, remove ONLY physical character details that would NOT be visible in that pose/angle. For example, if the character is seen from behind, remove eye color, face shape, facial features, facial expressions. If sitting, leg details may be hidden. IMPORTANT: Keep ALL scene, background, environment, lighting, mood, time of day, and style keywords COMPLETELY intact. Do NOT remove or change any scene/background details. Do NOT use square brackets in your output. Output ONLY the optimized prompt, nothing else.\n\nFull prompt: " + fullPrompt + "\nPose: " + pose + "\n\nOptimized prompt:";
  let result = await root.generateText({ instruction: instruction });
  let cleaned = result.trim();
  cleaned = cleaned.replace(/\[/g, "(").replace(/\]/g, ")");
  return cleaned;

// --- derivar um seed estável a partir do personagem ---
// Mesmo personagem => mesmo seed => maior consistência visual entre gerações.
seedFromCharacter(char) =>
  let s = JSON.stringify(char);
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = ((h << 5) - h) + s.charCodeAt(i);
    h = h & 0x7fffffff;
  }
  return h % 1000000;
