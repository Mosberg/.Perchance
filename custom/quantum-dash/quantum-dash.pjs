kv = {import:kv-plugin}
url = {import:url-params-plugin}
upload = {import:upload-plugin}
remember = {import:remember-plugin}

$meta
  title = Quantum Dash: Phase-Shift Runner
  description = Pilot a quantum skimmer through collapsing lanes, flip between A/B phases to survive polarity gates, chain multipliers, and push your high score in this high-speed neon arcade runner. Built for Perchance with URL params, persistent saves, and optional run sharing.
  image = https://user.uploads.dev/file/0bc6a5ccd4b0ec8ca498511055aa229b.jpg
  tags = game, html5, arcade, endless-runner, sci-fi, neon, mobile, canvas, perchance, plugins

$game
  name = Quantum Dash
  genre = Arcade, Endless Runner, Reflex
  platform = HTML5 (Web, Mobile)
  description = Shift between quantum phases and thread through hostile gates as speed and pressure ramp up. Designed for fast sessions, smooth controls, and clear readability on desktop and touch devices.
  features =
    - Phase-shift mechanic with lane-based gate matching
    - Desktop and mobile controls
    - URL driven difficulty and seed configuration
    - Persistent profile and best-score storage via kv-plugin with local fallback
    - Optional upload-plugin run sharing at game over
    - Responsive HUD and motion-accessibility toggle
  release_date = 2026-04-19
  developer = [Mosberg]
  publisher = [Mosberg]
  website = https://perchance.org/quantum-dash
  license = MIT