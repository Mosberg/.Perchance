$meta
	title = JSON Studio - A JSON Playground
	description = Visualize JSON data into interactive graphs. Convert, format, validate, and generate code from JSON, JSONC, JSON5, YAML, CSV, XML, TOML, NDJSON, and more. Full IDE for structured data with schema tools, patches, AI suggestions, and plugin support.
	tags = json, jsonc, json5, yaml, csv, xml, toml, ndjson, visualize, graph, convert, format, codegen, schema, diff, tools, patch, ai

