baseFramework = {import:t2i-framework-plugin-v2}
aiText = {import:ai-text-plugin}
prompt2 = {import:prompt2-plugin}

$output(settings) =>
  let baseHtml = baseFramework(settings)

  if(!window.__v3CharacterPanelScript) {
    window.__v3CharacterPanelScript = function() {
      function ensureStyles() {
        if(document.getElementById("v3CharacterPanelStyle")) return;
        var styleEl = document.createElement("style");
        styleEl.id = "v3CharacterPanelStyle";
        styleEl.textContent = [
          ".v3-character-panel {",
          "  margin: 1rem 0 1.5rem 0;",
          "  padding: 0.75rem;",
          "  border: 1px solid rgba(0,0,0,0.15);",
          "  border-radius: 6px;",
          "  background: var(--box-color, #f3f3f3);",
          "  color: var(--text-color, #111);",
          "}",
          ".v3-character-panel h2 {",
          "  margin: 0 0 0.5rem 0;",
          "  font-size: 1rem;",
          "}",
          ".v3-grid {",
          "  display: grid;",
          "  grid-template-columns: repeat(2, minmax(0, 1fr));",
          "  gap: 0.75rem;",
          "}",
          ".v3-col label {",
          "  display: block;",
          "  font-size: 0.8rem;",
          "  margin: 0.5rem 0 0.2rem 0;",
          "}",
          ".v3-col input,",
          ".v3-col textarea,",
          ".v3-col select {",
          "  width: 100%;",
          "  box-sizing: border-box;",
          "  padding: 6px 8px;",
          "  border-radius: 4px;",
          "  border: 1px solid rgba(0,0,0,0.2);",
          "  background: #fff;",
          "  color: #111;",
          "}",
          ".v3-col textarea {",
          "  min-height: 4.5rem;",
          "}",
          ".v3-actions {",
          "  display: flex;",
          "  gap: 0.5rem;",
          "  align-items: center;",
          "  flex-wrap: wrap;",
          "  margin-top: 0.5rem;",
          "}",
          ".v3-actions button {",
          "  padding: 0.35rem 0.6rem;",
          "}",
          ".v3-output textarea {",
          "  min-height: 10rem;",
          "  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace;",
          "  font-size: 0.8rem;",
          "}",
          ".v3-note {",
          "  font-size: 0.75rem;",
          "  opacity: 0.7;",
          "}",
          ".v3-warning {",
          "  font-size: 0.75rem;",
          "  color: #a00000;",
          "}",
          "@media (max-width: 900px) {",
          "  .v3-grid {",
          "    grid-template-columns: 1fr;",
          "  }",
          "}"
        ].join("\n");
        document.head.appendChild(styleEl);
      }

      function insertPanel() {
        var main = document.getElementById("mainColumnEl85394739");
        if (!main) { setTimeout(insertPanel, 200); return; }
        if (document.getElementById("characterGenPanelV3")) return;

        ensureStyles();

        var panel = document.createElement("div");
        panel.id = "characterGenPanelV3";
        panel.className = "v3-character-panel";
        panel.innerHTML = [
          "<h2>Character Sheet Generator (V3)</h2>",
          "<div class=\"v3-note\">Generates a full character template (Markdown) and a character JSON object for AI Character Chat.</div>",
          "<div class=\"v3-grid\">",
          "  <div class=\"v3-col\">",
          "    <label for=\"v3_name\">Character name</label>",
          "    <input id=\"v3_name\" type=\"text\" placeholder=\"Name\">",
          "",
          "    <label for=\"v3_seed\">Seed description (short)</label>",
          "    <textarea id=\"v3_seed\" placeholder=\"One paragraph describing the character concept.\"></textarea>",
          "",
          "    <label for=\"v3_genre\">Genre / setting</label>",
          "    <input id=\"v3_genre\" type=\"text\" placeholder=\"Fantasy, sci-fi, modern, etc.\">",
          "",
          "    <label for=\"v3_tone\">Tone</label>",
          "    <input id=\"v3_tone\" type=\"text\" placeholder=\"Warm, serious, noir, comedic, etc.\">",
          "",
          "    <label for=\"v3_role\">Role or job</label>",
          "    <input id=\"v3_role\" type=\"text\" placeholder=\"Detective, healer, rogue, etc.\">",
          "",
          "    <label for=\"v3_user_guidance\">Player/user interaction guidance</label>",
          "    <textarea id=\"v3_user_guidance\" placeholder=\"How the character should treat {{user}}.\"></textarea>",
          "",
          "    <label for=\"v3_quick_mode\">Quick mode</label>",
          "    <select id=\"v3_quick_mode\">",
          "      <option value=\"false\">Full detail</option>",
          "      <option value=\"true\">Quick (short sections)</option>",
          "    </select>",
          "",
          "    <label for=\"v3_use_image_prompt\">Use current image prompt as inspiration</label>",
          "    <select id=\"v3_use_image_prompt\">",
          "      <option value=\"true\">Yes</option>",
          "      <option value=\"false\">No</option>",
          "    </select>",
          "",
          "    <label for=\"v3_reminder\">Character reminder note</label>",
          "    <textarea id=\"v3_reminder\" placeholder=\"Short reminder for the AI.\"></textarea>",
          "",
          "    <label for=\"v3_initial_messages\">Initial chat messages</label>",
          "    <textarea id=\"v3_initial_messages\" placeholder=\"[AI]: Hello...\\n[USER]: Hi...\"></textarea>",
          "",
          "    <label for=\"v3_avatar_url\">Character avatar URL</label>",
          "    <input id=\"v3_avatar_url\" type=\"text\" placeholder=\"https://...\">",
          "",
          "    <label for=\"v3_lore_urls\">Lorebook URLs (one per line, .txt)</label>",
          "    <textarea id=\"v3_lore_urls\" placeholder=\"https://.../lore.txt\"></textarea>",
          "    <div class=\"v3-actions\">",
          "      <button id=\"v3_lore_format\">Format</button>",
          "      <div id=\"v3_lore_warning\" class=\"v3-warning\"></div>",
          "    </div>",
          "",
          "    <label for=\"v3_image_prefix\">Image prompt prefix</label>",
          "    <textarea id=\"v3_image_prefix\" placeholder=\"cinematic lighting, ultra-detailed,\"></textarea>",
          "",
          "    <label for=\"v3_image_suffix\">Image prompt suffix</label>",
          "    <textarea id=\"v3_image_suffix\" placeholder=\", sharp focus, (negativePrompt:::blurry)\"></textarea>",
          "",
          "    <label for=\"v3_image_triggers\">Image prompt triggers</label>",
          "    <textarea id=\"v3_image_triggers\" placeholder=\"Hero: A brave figure...\\n/forest.?path/: A misty forest...\"></textarea>",
          "",
          "    <div class=\"v3-actions\">",
          "      <button id=\"v3_generate_btn\">Generate character</button>",
          "      <button id=\"v3_stop_btn\" style=\"display:none;\">Stop</button>",
          "    </div>",
          "    <div id=\"v3_status\" class=\"v3-note\"></div>",
          "  </div>",
          "",
          "  <div class=\"v3-col v3-output\">",
          "    <label for=\"v3_description_output\">Description block (roleInstruction)</label>",
          "    <textarea id=\"v3_description_output\" placeholder=\"Generated description block\"></textarea>",
          "    <div class=\"v3-actions\">",
          "      <button data-copy-target=\"v3_description_output\">Copy</button>",
          "    </div>",
          "",
          "    <label for=\"v3_markdown_output\">Full character Markdown</label>",
          "    <textarea id=\"v3_markdown_output\" placeholder=\"Generated full character template\"></textarea>",
          "    <div class=\"v3-actions\">",
          "      <button data-copy-target=\"v3_markdown_output\">Copy</button>",
          "    </div>",
          "",
          "    <label for=\"v3_json_output\">Character JSON</label>",
          "    <textarea id=\"v3_json_output\" placeholder=\"Generated character JSON\"></textarea>",
          "    <div class=\"v3-actions\">",
          "      <button data-copy-target=\"v3_json_output\">Copy</button>",
          "    </div>",
          "  </div>",
          "</div>"
        ].join("\n");

        var userInputsCtn = document.getElementById("userInputsCtn8462746262");
        if (userInputsCtn) {
          main.insertBefore(panel, userInputsCtn);
        } else {
          main.insertBefore(panel, main.firstChild);
        }

        wirePanel();
      }

      function byId(id) { return document.getElementById(id); }
      function val(id) { var el = byId(id); return el ? String(el.value || "") : ""; }
      function setVal(id, v) { var el = byId(id); if (el) el.value = v; }
      function boolVal(id) { return val(id) === "true"; }
      function cleanLines(text) {
        return String(text || "").replace(/\r\n/g, "\n").replace(/\n\n\n+/g, "\n\n").trim();
      }

      function buildRoleInstruction(data) {
        return [
          "# {{char}} Visual Description:\n" + (data.visualDescription || ""),
          "# {{char}} Personality Description:\n" + (data.personalityDescription || ""),
          "# {{char}} Roleplay Behavior Examples:\n" + (data.roleplayBehaviorExamples || ""),
          "# {{char}} Tone and Mannerisms:\n" + (data.toneAndMannerisms || ""),
          "# {{char}} Background and History:\n" + (data.backgroundAndHistory || ""),
          "# {{char}} Goals and Motivations:\n" + (data.goalsAndMotivations || ""),
          "# {{char}} Relationships and Interactions:\n" + (data.relationshipsAndInteractions || ""),
          "# {{char}} Additional Notes:\n" + (data.additionalNotes || ""),
          "# {{char}} Core Values and Beliefs:\n" + (data.coreValuesAndBeliefs || ""),
          "# {{char}} Strengths and Weaknesses:\n" + (data.strengthsAndWeaknesses || ""),
          "# {{char}} Fears and Triggers:\n" + (data.fearsAndTriggers || ""),
          "# {{char}} Secrets and Lies (public vs private):\n" + (data.secretsAndLiesPublicPrivate || ""),
          "# {{char}} Skills and Competencies:\n" + (data.skillsAndCompetencies || ""),
          "# {{char}} Limits and Boundaries (topics, behaviors, taboos):\n" + (data.limitsAndBoundaries || ""),
          "# {{char}} Speech Patterns and Vocabulary:\n" + (data.speechPatternsAndVocabulary || ""),
          "# {{char}} Dialogue Quirks (catchphrases, filler, pacing):\n" + (data.dialogueQuirks || ""),
          "# {{char}} Physical Tics and Body Language:\n" + (data.physicalTicsAndBodyLanguage || ""),
          "# {{char}} Emotional Range and Regulation:\n" + (data.emotionalRangeAndRegulation || ""),
          "# {{char}} Social Status and Reputation:\n" + (data.socialStatusAndReputation || ""),
          "# {{char}} Daily Routine and Habits:\n" + (data.dailyRoutineAndHabits || ""),
          "# {{char}} Likes/Dislikes and Preferences:\n" + (data.likesDislikesAndPreferences || ""),
          "# {{char}} Equipment, Keepsakes, or Signature Items:\n" + (data.equipmentKeepsakesOrSignatureItems || ""),
          "# {{char}} Environment and Setting Hooks:\n" + (data.environmentAndSettingHooks || ""),
          "# {{char}} Conflict Style (avoid, confront, negotiate):\n" + (data.conflictStyle || ""),
          "# {{char}} Relationship Dynamics (power, trust, intimacy):\n" + (data.relationshipDynamics || ""),
          "# {{char}} Evolution Over Time (growth arcs):\n" + (data.evolutionOverTime || ""),
          "# {{char}} Player/User Interaction Guidance (dos/donts):\n" + (data.playerUserInteractionGuidance || "")
        ].join("\n\n");
      }

      function buildFullMarkdown(data, extras) {
        var roleInstruction = buildRoleInstruction(data);
        return [
          "# Character",
          "",
          "## Character name",
          "",
          "```plaintext",
          (data.name || ""),
          "```",
          "",
          "## Character description/personality/instruction/role",
          "",
          "```md",
          roleInstruction,
          "```",
          "",
          "## Character avatar image URL",
          "",
          "```url",
          (extras.avatarUrl || ""),
          "```",
          "",
          "## Character reminder note",
          "",
          "```md",
          (extras.reminderMessage || ""),
          "```",
          "",
          "## Initial chat messages",
          "",
          "```md",
          (extras.initialMessagesText || ""),
          "```",
          "",
          "## General writing instructions preset",
          "",
          "```plaintext",
          (extras.generalWritingInstructionsPreset || ""),
          "```",
          "",
          "## General writing instructions (custom)",
          "",
          "```md",
          (extras.generalWritingInstructions || ""),
          "```",
          "",
          "## Strict message length limit",
          "",
          "```plaintext",
          (extras.maxParagraphCountPerMessage || ""),
          "```",
          "",
          "## User's name",
          "",
          "```plaintext",
          (extras.userCharacterName || ""),
          "```",
          "",
          "## User's description/role",
          "",
          "```md",
          (extras.userCharacterRoleInstruction || ""),
          "```",
          "",
          "## User's avatar pic URL",
          "",
          "```url",
          (extras.userCharacterAvatarUrl || ""),
          "```",
          "",
          "## User reminder note",
          "",
          "```md",
          (extras.userCharacterReminderMessage || ""),
          "```",
          "",
          "## Default message style (color, font, size, etc.)",
          "",
          "```plaintext",
          (extras.messageWrapperStyle || ""),
          "```",
          "",
          "## Chat background image/video URL",
          "",
          "```url",
          (extras.sceneBackgroundUrl || ""),
          "```",
          "",
          "## Chat background music/audio URL",
          "",
          "```url",
          (extras.sceneMusicUrl || ""),
          "```",
          "",
          "## Image generation prompt starter",
          "",
          "```plaintext",
          (extras.imagePromptPrefix || ""),
          "```",
          "",
          "## Image generation prompt ending",
          "",
          "```plaintext",
          (extras.imagePromptSuffix || ""),
          "```",
          "",
          "## Image prompt keyword triggers",
          "",
          "```plaintext",
          (extras.imagePromptTriggers || ""),
          "```",
          "",
          "## Lorebook URLs - one URL per line",
          "",
          "```plaintext",
          (extras.loreBookUrlsText || ""),
          "```",
          "",
          "## Method for fitting messages within model's context limit",
          "",
          "```plaintext",
          (extras.fitMessagesInContextMethod || ""),
          "```",
          "",
          "## Extended character memory",
          "",
          "```plaintext",
          (extras.autoGenerateMemories || ""),
          "```",
          "",
          "## Character avatar pic size",
          "",
          "```plaintext",
          (extras.avatarSize || ""),
          "```",
          "",
          "## Character avatar shape",
          "",
          "```plaintext",
          (extras.avatarShape || ""),
          "```",
          "",
          "## User avatar pic size",
          "",
          "```plaintext",
          (extras.userAvatarSize || ""),
          "```",
          "",
          "## User avatar shape",
          "",
          "```plaintext",
          (extras.userAvatarShape || ""),
          "```",
          "",
          "## Shortcut buttons (above reply box)",
          "",
          "```plaintext",
          (extras.shortcutButtonsText || ""),
          "```",
          "",
          "## Custom JavaScript code",
          "",
          "```javascript",
          (extras.customCode || ""),
          "```",
          "",
          "## System's name",
          "",
          "```plaintext",
          (extras.systemCharacterName || ""),
          "```",
          "",
          "## System's avatar pic URL",
          "",
          "```url",
          (extras.systemCharacterAvatarUrl || ""),
          "```",
          "",
          "## Message input placeholder",
          "",
          "```plaintext",
          (extras.messageInputPlaceholder || ""),
          "```",
          "",
          "## Social media share link preview title",
          "",
          "```plaintext",
          (extras.metaTitle || ""),
          "```",
          "",
          "## Social media share link preview description",
          "",
          "```plaintext",
          (extras.metaDescription || ""),
          "```",
          "",
          "## Social media share link preview image",
          "",
          "```plaintext",
          (extras.metaImage || ""),
          "```"
        ].join("\n");
      }

      function buildCharacterJson(data, extras) {
        var roleInstruction = buildRoleInstruction(data);
        return {
          name: data.name || "",
          roleInstruction: roleInstruction,
          avatarUrl: extras.avatarUrl || "",
          reminderMessage: extras.reminderMessage || "",
          initialMessagesText: extras.initialMessagesText || "",
          generalWritingInstructionsPreset: extras.generalWritingInstructionsPreset || "",
          generalWritingInstructions: extras.generalWritingInstructions || "",
          maxParagraphCountPerMessage: extras.maxParagraphCountPerMessage || "",
          userCharacterName: extras.userCharacterName || "",
          userCharacterRoleInstruction: extras.userCharacterRoleInstruction || "",
          userCharacterAvatarUrl: extras.userCharacterAvatarUrl || "",
          userCharacterReminderMessage: extras.userCharacterReminderMessage || "",
          messageWrapperStyle: extras.messageWrapperStyle || "",
          sceneBackgroundUrl: extras.sceneBackgroundUrl || "",
          sceneMusicUrl: extras.sceneMusicUrl || "",
          imagePromptPrefix: extras.imagePromptPrefix || "",
          imagePromptSuffix: extras.imagePromptSuffix || "",
          imagePromptTriggers: extras.imagePromptTriggers || "",
          loreBookUrlsText: extras.loreBookUrlsText || "",
          fitMessagesInContextMethod: extras.fitMessagesInContextMethod || "",
          autoGenerateMemories: extras.autoGenerateMemories || "",
          avatarSize: extras.avatarSize || "",
          avatarShape: extras.avatarShape || "",
          userAvatarSize: extras.userAvatarSize || "",
          userAvatarShape: extras.userAvatarShape || "",
          shortcutButtonsText: extras.shortcutButtonsText || "",
          customCode: extras.customCode || "",
          systemCharacterName: extras.systemCharacterName || "",
          systemCharacterAvatarUrl: extras.systemCharacterAvatarUrl || "",
          messageInputPlaceholder: extras.messageInputPlaceholder || "",
          metaTitle: extras.metaTitle || "",
          metaDescription: extras.metaDescription || "",
          metaImage: extras.metaImage || ""
        };
      }

      function getExtras() {
        return {
          avatarUrl: cleanLines(val("v3_avatar_url")),
          reminderMessage: cleanLines(val("v3_reminder")),
          initialMessagesText: cleanLines(val("v3_initial_messages")),
          generalWritingInstructionsPreset: "@roleplay1",
          generalWritingInstructions: "",
          maxParagraphCountPerMessage: "",
          userCharacterName: "",
          userCharacterRoleInstruction: "",
          userCharacterAvatarUrl: "",
          userCharacterReminderMessage: "",
          messageWrapperStyle: "",
          sceneBackgroundUrl: "",
          sceneMusicUrl: "",
          imagePromptPrefix: cleanLines(val("v3_image_prefix")),
          imagePromptSuffix: cleanLines(val("v3_image_suffix")),
          imagePromptTriggers: cleanLines(val("v3_image_triggers")),
          loreBookUrlsText: cleanLines(val("v3_lore_urls")),
          fitMessagesInContextMethod: "summarizeOld",
          autoGenerateMemories: "v1",
          avatarSize: "1.0",
          avatarShape: "portrait",
          userAvatarSize: "1.0",
          userAvatarShape: "circle",
          shortcutButtonsText: "",
          customCode: "",
          systemCharacterName: "",
          systemCharacterAvatarUrl: "",
          messageInputPlaceholder: "",
          metaTitle: "",
          metaDescription: "",
          metaImage: ""
        };
      }

      function useImagePrompt() {
        var useIt = boolVal("v3_use_image_prompt");
        if (!useIt) return "";
        var descriptionEl = (window.___userSettings746291937 && window.___userSettings746291937.userInputs && window.___userSettings746291937.userInputs.description) ? window.___userSettings746291937.userInputs.description._element : null;
        if (!descriptionEl) return "";
        return String(descriptionEl.value || "").trim();
      }

      function buildInstruction(seed) {
        var quick = boolVal("v3_quick_mode");
        var name = val("v3_name").trim();
        var genre = val("v3_genre").trim();
        var tone = val("v3_tone").trim();
        var role = val("v3_role").trim();
        var guidance = val("v3_user_guidance").trim();
        var imagePrompt = useImagePrompt();

        var lengthNote = quick ? "Keep each field short (1-2 sentences)." : "Each field should be 2-5 sentences with concrete detail.";

        var lines = [
          "You are generating a character sheet for Perchance AI Character Chat.",
          "Return ONLY valid JSON. Do not include markdown, commentary, or code fences.",
          "Use this schema and keys exactly. All values must be strings.",
          "",
          "Required keys:",
          "name, visualDescription, personalityDescription, roleplayBehaviorExamples, toneAndMannerisms, backgroundAndHistory, goalsAndMotivations, relationshipsAndInteractions, additionalNotes, coreValuesAndBeliefs, strengthsAndWeaknesses, fearsAndTriggers, secretsAndLiesPublicPrivate, skillsAndCompetencies, limitsAndBoundaries, speechPatternsAndVocabulary, dialogueQuirks, physicalTicsAndBodyLanguage, emotionalRangeAndRegulation, socialStatusAndReputation, dailyRoutineAndHabits, likesDislikesAndPreferences, equipmentKeepsakesOrSignatureItems, environmentAndSettingHooks, conflictStyle, relationshipDynamics, evolutionOverTime, playerUserInteractionGuidance.",
          "",
          "Notes:",
          "- The roleplayBehaviorExamples value should be a numbered list with 3-6 examples using quotes for dialogue and asterisks for actions.",
          "- Use {{char}} and {{user}} only if needed. Otherwise write normally.",
          "- Avoid explicit sexual content.",
          "- " + lengthNote,
          "",
          "Character seed:",
          "Name: " + (name || "(invent a name)"),
          "Genre/Setting: " + (genre || ""),
          "Tone: " + (tone || ""),
          "Role/Job: " + (role || ""),
          "User interaction guidance: " + (guidance || ""),
          "Seed description: " + (seed || "")
        ];

        if (imagePrompt) lines.push("Image prompt: " + imagePrompt);

        return lines.join("\n").trim();
      }

      async function generateCharacter() {
        var seed = cleanLines(val("v3_seed"));
        var statusEl = byId("v3_status");
        var generateBtn = byId("v3_generate_btn");
        var stopBtn = byId("v3_stop_btn");

        if (statusEl) statusEl.textContent = "Generating...";
        if (generateBtn) generateBtn.disabled = true;
        if (stopBtn) stopBtn.style.display = "inline-block";

        var instruction = buildInstruction(seed);
        var outputText = "";

        var generateObj = aiText({
          instruction: instruction,
          onChunk: function(data) {
            outputText = data.fullTextSoFar || outputText;
          }
        });

        if (stopBtn) {
          stopBtn.onclick = function() {
            if (generateObj && generateObj.stop) generateObj.stop();
          };
        }

        try {
          await generateObj;
        } catch (e) {
          console.error(e);
        }

        if (generateBtn) generateBtn.disabled = false;
        if (stopBtn) stopBtn.style.display = "none";

        var jsonText = outputText;
        var jsonStart = jsonText.indexOf("{");
        var jsonEnd = jsonText.lastIndexOf("}");
        if (jsonStart === -1 || jsonEnd === -1 || jsonEnd <= jsonStart) {
          if (statusEl) statusEl.textContent = "Failed to parse JSON. Try again.";
          return;
        }

        var parsed = null;
        try {
          parsed = JSON.parse(jsonText.slice(jsonStart, jsonEnd + 1));
        } catch (e) {
          console.error(e);
          if (statusEl) statusEl.textContent = "Invalid JSON returned. Try again.";
          return;
        }

        var data = {
          name: parsed.name || val("v3_name").trim(),
          visualDescription: parsed.visualDescription || "",
          personalityDescription: parsed.personalityDescription || "",
          roleplayBehaviorExamples: parsed.roleplayBehaviorExamples || "",
          toneAndMannerisms: parsed.toneAndMannerisms || "",
          backgroundAndHistory: parsed.backgroundAndHistory || "",
          goalsAndMotivations: parsed.goalsAndMotivations || "",
          relationshipsAndInteractions: parsed.relationshipsAndInteractions || "",
          additionalNotes: parsed.additionalNotes || "",
          coreValuesAndBeliefs: parsed.coreValuesAndBeliefs || "",
          strengthsAndWeaknesses: parsed.strengthsAndWeaknesses || "",
          fearsAndTriggers: parsed.fearsAndTriggers || "",
          secretsAndLiesPublicPrivate: parsed.secretsAndLiesPublicPrivate || "",
          skillsAndCompetencies: parsed.skillsAndCompetencies || "",
          limitsAndBoundaries: parsed.limitsAndBoundaries || "",
          speechPatternsAndVocabulary: parsed.speechPatternsAndVocabulary || "",
          dialogueQuirks: parsed.dialogueQuirks || "",
          physicalTicsAndBodyLanguage: parsed.physicalTicsAndBodyLanguage || "",
          emotionalRangeAndRegulation: parsed.emotionalRangeAndRegulation || "",
          socialStatusAndReputation: parsed.socialStatusAndReputation || "",
          dailyRoutineAndHabits: parsed.dailyRoutineAndHabits || "",
          likesDislikesAndPreferences: parsed.likesDislikesAndPreferences || "",
          equipmentKeepsakesOrSignatureItems: parsed.equipmentKeepsakesOrSignatureItems || "",
          environmentAndSettingHooks: parsed.environmentAndSettingHooks || "",
          conflictStyle: parsed.conflictStyle || "",
          relationshipDynamics: parsed.relationshipDynamics || "",
          evolutionOverTime: parsed.evolutionOverTime || "",
          playerUserInteractionGuidance: parsed.playerUserInteractionGuidance || ""
        };

        var extras = getExtras();
        var roleInstruction = buildRoleInstruction(data);
        var fullMarkdown = buildFullMarkdown(data, extras);
        var characterJson = buildCharacterJson(data, extras);

        setVal("v3_description_output", roleInstruction);
        setVal("v3_markdown_output", fullMarkdown);
        setVal("v3_json_output", JSON.stringify(characterJson, null, 2));

        if (statusEl) statusEl.textContent = "Done.";
      }

      function formatLoreUrls() {
        var warningEl = byId("v3_lore_warning");
        var text = cleanLines(val("v3_lore_urls"));
        if (!text) { if (warningEl) warningEl.textContent = ""; return; }
        var lines = text.split("\n").map(function(line){ return line.trim(); }).filter(Boolean);
        var bad = lines.filter(function(line){ return !/\.txt(\?.*)?$/.test(line); });
        if (warningEl) warningEl.textContent = bad.length ? "Non-.txt URLs detected." : "";
        setVal("v3_lore_urls", lines.join("\n"));
      }

      function wirePanel() {
        var genBtn = byId("v3_generate_btn");
        var loreBtn = byId("v3_lore_format");

        if (genBtn) genBtn.onclick = function() { generateCharacter(); };
        if (loreBtn) loreBtn.onclick = function() { formatLoreUrls(); };

        Array.from(document.querySelectorAll("[data-copy-target]"))
          .forEach(function(btn){
            btn.onclick = function() {
              var targetId = btn.getAttribute("data-copy-target");
              var target = byId(targetId);
              if (!target) return;
              navigator.clipboard.writeText(target.value || "");
              btn.textContent = "Copied";
              setTimeout(function(){ btn.textContent = "Copy"; }, 1500);
            };
          });
      }

      insertPanel();
    };
  }

  let panelHtml = "<script>window.__v3CharacterPanelScript && window.__v3CharacterPanelScript();</script>"
  return baseHtml + panelHtml
