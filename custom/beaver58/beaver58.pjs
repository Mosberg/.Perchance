// JToH Tower Name Generator
// Generates funny/clever tower names in the style of Juke's Towers of Hell

structureType
  Tower of
  Steeple of
  Citadel of
  Obelisk of
  Mini Tower of
  Room of
  Edifice of
  Spire of

// Name patterns: pick a style, fill in the blanks
// Style 1: "[Adjective] [Noun]" (e.g. "Frightening Nightmares")
adjective
  Frightening
  Sudden
  Broken
  Endless
  Impossible
  Wacky
  Bizarre
  Chaotic
  Questionable
  Mildly Annoying
  Totally Normal
  Suspicious
  Forgotten
  Glitchy
  Cosmic
  Melting
  Crumbling
  Inverted
  Unfinished
  Cursed

noun
  Nightmares
  Confusion
  Despair
  Regret
  Tomatoes
  Misery
  Obstacle Courses
  Falling
  Pixels
  Frames
  Buttons
  Lava
  Darkness
  Shenanigans
  tomfoolery
  Mistakes
  Doom
  Heights
  Spinning
  Desync

// Style 2: phrases / sentences (e.g. "Oops, Failed That", "A June Date")
phrase
  Oops, Failed That
  A June Date
  Why Are We Here
  No Jumping Allowed
  Definitely Not Rigged
  Trust The Process
  Skill Issue Detected
  Just Give Up
  You're Gonna Have A Bad Time
  Don't Look Down
  Plot Twist
  It's A Feature
  Lagging Out
  Hitbox Woes
  Ping Issues
  Frame Perfect
  Good Luck
  No Thoughts, Head Empty
  Brain Power Required
  Something Went Wrong

// Style 3: "Adjective Noun and More Noun" style compound names
connector
  and
  vs
  inside
  beneath
  beyond

moreNoun
  Chaos
  Madness
  Terror
  Glitches
  Pain
  Confusion
  Nothing
  Everything
  Doom
  Hope

// Difficulty-flavored suffix words (JToH difficulties inspire these)
diffWord
  Easy
  Medium
  Hard
  Difficult
  Intense
  Remorseless
  Insane
  Extreme
  Terrifying
  Catastrophic

// Pick a random naming style and build a full tower name
generateName() =>
  let style = Math.floor(Math.random() * 4);
  let prefix = structureType.selectOne.evaluateItem;
  let name;
  if (style === 0) {
    name = adjective.selectOne.evaluateItem + " " + noun.selectOne.evaluateItem;
  } else if (style === 1) {
    name = phrase.selectOne.evaluateItem;
  } else if (style === 2) {
    name = adjective.selectOne.evaluateItem + " " + noun.selectOne.evaluateItem + " " + connector.selectOne.evaluateItem + " " + moreNoun.selectOne.evaluateItem;
  } else {
    name = diffWord.selectOne.evaluateItem + " " + noun.selectOne.evaluateItem;
  }
  return prefix + " " + name;

// Generate N unique names
generateNames(n) =>
  let names = [];
  let seen = {};
  let tries = 0;
  while (names.length < n && tries < n * 50) {
    let nm = generateName();
    if (!seen[nm]) {
      seen[nm] = true;
      names.push(nm);
    }
    tries++;
  }
  return names;
