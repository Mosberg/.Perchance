generateHTML = {import:text2image-framework-v4}

$meta
  title = Text2Image Core Suite
  description = Advanced baseline generator with modular plugins, smart seed, metadata, and style packs.

settings
  pageTitle = Text2Image Core Suite
  subtitle = High-control generation workspace with queue, presets, prompt tools, and style routing.
  theme = aurora
  showComments = false

  enableShareLinks = true
  enableModifierGroups = true
  enablePersonaHooks = true

  defaultPrompt = cinematic environment concept, intricate details, global illumination
  defaultNegativePrompt = blurry, noisy, low quality, watermark, text artifacts
  defaultImageCount = 6

  enableRandomInputButton = true
  enableAiSuggestButton = true
  enableRandomAppendButton = true
  aiSuggestMode = append
  aiSuggestMaxCharacters = 240
  aiSuggestInstruction = Generate one concise continuation for this image prompt. Return prompt text only.

  artStyle
    label = Style Preset
    type = select
    remember = true
    options
      Suite Default
        color = #63c89f
        meta:import
          from = {import:text2image-styles-pack-default}

      Suite Anime
        color = #80a8ff
        meta:import
          from = {import:text2image-styles-pack-anime}

      Suite Realistic
        color = #f2b56f
        meta:import
          from = {import:text2image-styles-pack-realistic}

      Legacy General
        color = #ff8fb1
        meta:import
          from = {import:perstyles-general}

  imageButtons
    privateSave = true

  imageOptions
    style = border-radius:14px; box-shadow:0 14px 34px rgba(0,0,0,0.22);

  commentOptions
    channel = text2image-core-suite
    width = 100%
    height = 360
    commentPlaceholderText = Share your prompt, seed, and style recipe.
    submitButtonText = post

  persona
    enableAiDescription = true
    enableAiName = true
    defaultInstruction = Create a concise persona profile based on the current image prompt.
    chatBaseUrl = https://perchance.org/ai-character-chat

  randomPromptPool
    cinematic canyon city at dawn, layered fog, high detail
    bioluminescent forest temple, god rays, atmospheric depth
    futuristic fashion editorial, dramatic angle, glossy textures
    stylized creature concept sheet, turnarounds, neutral background

  randomAppendPool
    ultra detailed
    dynamic composition
    balanced contrast
    physically plausible lighting
    carefully framed subject


