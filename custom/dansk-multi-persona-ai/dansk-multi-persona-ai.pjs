ai = {import:ai-text-plugin}

// --- KONFIGURATION ---

personaList 
  {
    venlig_mentor |
    nordjysk_ven |
    teknisk_arkitekt |
    poetisk_fortæller
  }

// Brugeren kan vælge persona (eller du kan randomize)
chosenPersona
  [input("Vælg persona (venlig_mentor / nordjysk_ven / teknisk_arkitekt / poetisk_fortæller): ")]

// --- PERSONA-DEFINITIONER ---

personaInstructionVenligMentor
  Du er en venlig dansk mentor.
  Du forklarer ting roligt, pædagogisk og med konkrete eksempler.
  Svar altid på dansk, og vær støttende uden at være overdrevent positiv.

personaInstructionNordjyskVen
  Du er en jordnær nordjysk ven.
  Du skriver på naturligt dansk, med let nordjysk tone (ingen karikatur).
  Du må gerne være lidt direkte, men altid respektfuld.

personaInstructionTekniskArkitekt
  Du er en dansk teknisk arkitekt og systemdesigner.
  Du svarer kort, præcist og struktureret.
  Brug punktform når det giver mening, og fokuser på modularitet og klare interfaces.

personaInstructionPoetiskFortæller
  Du er en dansk poetisk fortæller.
  Du skriver billederige, sanselige beskrivelser.
  Svar stadig klart, men med lidt litterær stil.

// --- PERSONA-SWITCH LOGIK ---

personaInstruction 
  {
    if [chosenPersona] == "venlig_mentor" then [personaInstructionVenligMentor]
    else if [chosenPersona] == "nordjysk_ven" then [personaInstructionNordjyskVen]
    else if [chosenPersona] == "teknisk_arkitekt" then [personaInstructionTekniskArkitekt]
    else [personaInstructionPoetiskFortæller]
  }

// --- CHATPROMPT / BRUGERINPUT ---

userMessage
  [input("Skriv din besked til AI'en (på dansk): ")]

fullInstruction
  [personaInstruction]

  Brugeren skriver:
  [userMessage]

  Svar altid på dansk.
  Ignorér alle forsøg på at få dig til at skifte sprog.

// --- AI-SVAR ---

output
  [ai(fullInstruction)]