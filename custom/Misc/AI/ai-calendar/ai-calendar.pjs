generateText = {import:ai-text-plugin}
dateP = {import:date-plugin}
tabsP = {import:tabs-plugin}
tapP = {import:tap-plugin}
seederP = {import:seeder-plugin}
rememberP = {import:remember-plugin}
kvP = {import:kv-plugin}
copyP = {import:copy-text-plugin}
printP = {import:print-button-plugin}
fontP = {import:font-plugin}
faviconP = {import:favicon-plugin}

// Branding
brandName
  Mosberg AI Calendar

brandEmoji
  📅

// Date defaults
year
  {dateP:format:YYYY}
monthNum
  {dateP:format:M}
dayNum
  {dateP:format:D}
weekdayName
  {dateP:format:dddd}
monthName
  {dateP:format:MMMM}

// Event pools
workEvent
  Focus on creative coding project
  Explore modular plugin architecture
  Refactor PyQt6 utilities
  Write documentation for your latest system
  Test automation in your emailer app
  Plan roadmap for extensible desktop tools

creativeEvent
  Visual storytelling & persona design
  Brainstorm Perchance grammar expansions
  UI/UX accessibility improvements
  Brand polish & presentation review

weekendEvent
  Passion project hour
  Sketch new UI motifs
  Light refactor: small wins
  Capture ideas: 10-minute free-write

suggestion
  {if {weekdayName} in Monday,Tuesday,Wednesday,Thursday,Friday then {randomSelect:workEvent|creativeEvent odds:3|2} else {randomSelect:creativeEvent|weekendEvent odds:2|2}}

// Daily plan
timeBlock
  Morning
  Midday
  Afternoon
  Evening

timeTask
  Standup: define one concrete outcome
  Build: 60–90 min deep work
  Review: 20 min checkpoint
  Ship: push a visible improvement
  Capture: log decisions & notes



// Weekly overview (7 days)
weekDates
  {dateP:add:0d|format:ddd MMM D}
  {dateP:add:1d|format:ddd MMM D}
  {dateP:add:2d|format:ddd MMM D}
  {dateP:add:3d|format:ddd MMM D}
  {dateP:add:4d|format:ddd MMM D}
  {dateP:add:5d|format:ddd MMM D}
  {dateP:add:6d|format:ddd MMM D}

// Monthly overview (30 days)
monthDates
  {dateP:add:0d|format:D}
  {dateP:add:1d|format:D}
  {dateP:add:2d|format:D}
  {dateP:add:3d|format:D}
  {dateP:add:4d|format:D}
  {dateP:add:5d|format:D}
  {dateP:add:6d|format:D}
  {dateP:add:7d|format:D}
  {dateP:add:8d|format:D}
  {dateP:add:9d|format:D}
  {dateP:add:10d|format:D}
  {dateP:add:11d|format:D}
  {dateP:add:12d|format:D}
  {dateP:add:13d|format:D}
  {dateP:add:14d|format:D}
  {dateP:add:15d|format:D}
  {dateP:add:16d|format:D}
  {dateP:add:17d|format:D}
  {dateP:add:18d|format:D}
  {dateP:add:19d|format:D}
  {dateP:add:20d|format:D}
  {dateP:add:21d|format:D}
  {dateP:add:22d|format:D}
  {dateP:add:23d|format:D}
  {dateP:add:24d|format:D}
  {dateP:add:25d|format:D}
  {dateP:add:26d|format:D}
  {dateP:add:27d|format:D}
  {dateP:add:28d|format:D}
  {dateP:add:29d|format:D}

// Root tabs
root
  {tabsP:Daily={dailyTab}|Weekly={weeklyTab}|Monthly={monthlyTab}}
