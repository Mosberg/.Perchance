literal = {import:literal-plugin}

title
  AI Code Generator - Modes

description
  Modes for my AI Code Generator

author
  Grand Woods

$output
  // ======================
  // CORE MODES
  // ======================
  general
    category = Core
    label = 🧑‍💻 Freeform
    description = General-purpose mode for any coding or text instruction.
    instructionPlaceholder = Write your instruction/question here.
    instruction
      [literal(instructionEl.value)]
      $output = [this.joinItems("\n")]

  brainy
    category = Core
    label = 🤓 Brainy
    description = A mode in which the AI lays out its reasoning to improve accuracy.
    instructionPlaceholder = Ask a question where careful reasoning matters...
    instruction
      [literal(instructionEl.value)]
      [""]
      Take a deep breath and think step by step to ensure that your response is correct and incisive. If the answer is easy, keep it concise. If it's hard, lay out your reasoning clearly before answering.
      $output = [this.joinItems("\n")]

  markdown
    category = Core
    label = 📝 Markdown
    description = Generate well-formatted markdown content for documentation, guides, blogs, and more.
    instructionPlaceholder = Describe what markdown content you want to generate...
    instruction
      Generate markdown content based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - Use proper markdown formatting with headers (#, ##, ###), bold (**text**), italics (*text*), lists, code blocks, links, and other markdown features.
      - Organize content logically with clear structure and hierarchy.
      - Include code examples in markdown code blocks when relevant.
      - Make the content readable and well-formatted.
      - Prefer GitHub-flavored markdown when in doubt.
      $output = [this.joinItems("\n")]

  character
    category = Core
    label = 👤 Character
    description = Create detailed character profiles using the Perchance character template format.
    instructionPlaceholder = Describe the character you want to create...
    instruction
      Generate a detailed character profile based on this description:
      [literal(instructionEl.value)]
      [""]
      Use this character template format:

      # Character name
      

      \[Character's name\]



      # Character description/personality/instruction/role
      

      \[Comprehensive description including visual, personality, behavior, speech patterns, background, goals, relationships, skills, limits, and other relevant details. Use \{\{char\}\} to reference the character and \{\{user\}\} where appropriate.\]



      # Character avatar image URL
      

      \[A realistic direct URL to a jpg/png/webp/gif image, or leave blank. Must be a real working image URL.\]



      # Character reminder note
      

      \[Brief one-paragraph reminder about the character's key traits and must-follow behaviors.\]



      # Initial chat messages
      

      \[Opening dialogue that sets the tone. Use 

      \[AI\]

      : for character and 

      \[USER\]

      : for user responses. Example:
            

      \[AI\]

      : Hello there!
            

      \[USER\]

      : Hi!
      \]



      # General writing instructions preset
      

      \[@roleplay1 or @roleplay2 or @custom\]



      # Strict message length limit
      

      \[Number of paragraphs or leave blank for no limit. Example: 2 or 3\]



      # User's name
      

      \[Optional override for user's name, or leave blank\]



      # Default message style
      

      \[Optional CSS styling like: color:#1f2a44; font-size:95%; background:rgba(240,244,255,0.6); or leave blank\]



      # Chat background image/video URL
      

      \[Optional URL to background image/video, or leave blank\]



      Follow this structure to create a complete, detailed character profile suitable for use in a role-play or character AI system.
      $output = [this.joinItems("\n")]

  // ======================
  // CODE MODES
  // ======================
  html
    category = Code
    label = 🌐 HTML/CSS/JS
    description = Generate HTML/CSS/JS and render it in a live sandbox.
    instructionPlaceholder = Describe the web page / UI / demo you want...
    instruction
      Generate HTML/CSS/JS code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - Don't break up HTML/CSS/JS into separate files. If there is CSS/JS, then put it inline within the same HTML file using `<style>...</style>` and `<script>...</script>`.
      - If the above instruction requires image placeholders, use Unsplash like this: <img src\="https://source.unsplash.com/random/?city,night">
      - Make sure the HTML is valid and self-contained.
      $output = [this.joinItems("\n")]
    onFinish(data) =>
      let htmlPage;
      if(!htmlPage) htmlPage = (responseEl.value.match(/```(html|)(.+?)```/s) || [])[2];
      if(!htmlPage) htmlPage = (responseEl.value.match(/<!DOCTYPE html>(.+)<\/html>/s) || [])[1];
      if(!htmlPage) htmlPage = responseEl.value;
      renderedOutputEl.innerHTML = `<iframe srcdoc="" style="width:100%; height:700px; max-height:70vh;"></iframe>`;
      renderedOutputEl.querySelector("iframe").srcdoc = htmlPage;

  python
    category = Code
    label = 🐍💻 Python
    description = Execute generated Python code in a live browser-based sandbox.
    instructionPlaceholder = Describe the Python script / analysis / tool you want...
    instruction
      Generate Python code based on this instruction:
      [literal(instructionEl.value)]
      Tips:
      - All Python code should be inside markdown triple backticks. i.e. Python code blocks in your response should start with: ```py
      - You MUST give the required `pip install` command to install all relevant packages that you use in your Python code blocks.
      - Make sure to import all relevant packages in every Python code block that you write.
      - The Python code blocks that you output will be executed sequentially by a Python interpreter to check for correctness.
      $output = [this.joinItems("\n")]
    onFinish() =>
      let pythonImports = [...responseEl.value.matchAll(/pip install ([^\n`]+)/gs)].map(m => m[1].split(" ")).flat().map(p => p.trim()).filter(p => p);
      let pythonCodeBlocks = [...responseEl.value.matchAll(/```(py|python)(.+?)```/gs)].map(m => m[2]);

      if(pythonCodeBlocks.length === 0) pythonCodeBlocks = [...responseEl.value.matchAll(/```(.+?)```/gs)].map(m => m[2]);
      if(pythonCodeBlocks.length === 0 && /[a-zA-Z0-9_]\.[a-zA-Z0-9_]/.test(responseEl.value) && /($|\n)import /.test(responseEl.value)) pythonCodeBlocks = [responseEl.value];

      if(pythonCodeBlocks.length === 0) {
        renderedOutputEl.innerHTML = "No executable Python code was detected in the generated text.";
        return;
      }

      let oneOrMoreHasNoTopImports = false;
      for(let block of pythonCodeBlocks) {
        if(!/($|\n)import /.test(block.split("\n").slice(0, 5).join("\n"))) {
          oneOrMoreHasNoTopImports = true;
        }
      }
      if(oneOrMoreHasNoTopImports) pythonCodeBlocks = [pythonCodeBlocks.join("\n\n")];

      let matplotlibImportCode = [
        `import matplotlib`,
        `matplotlib.use("module://matplotlib_pyodide.html5_canvas_backend")`,
        `import matplotlib_pyodide.html5_canvas_backend`,
        `matplotlib_pyodide.html5_canvas_backend._base_fonts_url="https://cdn.jsdelivr.net/pyodide/v0.25.1/full/fonts/"`,
      ].join("\n");
      for(let i = 0; i < pythonCodeBlocks.length; i++) {
        if(pythonCodeBlocks[i].includes("import matplotlib.") && !pythonCodeBlocks[i].includes("import matplotlib\n")) {
          pythonImports.push("matplotlib");
          pythonCodeBlocks[i] = `${matplotlibImportCode}\n` + pythonCodeBlocks[i];
        } else if(pythonCodeBlocks[i].includes("import matplotlib\n")) {
          pythonImports.push("matplotlib");
          pythonCodeBlocks[i] = pythonCodeBlocks[i].replace(/import matplotlib\n/g, `${matplotlibImportCode}\n`);
        }

        if(pythonCodeBlocks[i].includes("np.") && !pythonCodeBlocks[i].includes("import numpy as np")) {
          pythonImports.push("numpy");
          pythonCodeBlocks[i] = `import numpy as np\n` + pythonCodeBlocks[i];
        }
        if(pythonCodeBlocks[i].includes("pd.") && !pythonCodeBlocks[i].includes("import pandas as pd")) {
          pythonImports.push("pandas");
          pythonCodeBlocks[i] = `import pandas as pd\n` + pythonCodeBlocks[i];
        }
      }

      for(let i = 0; i < pythonCodeBlocks.length; i++) {
        let lines = pythonCodeBlocks[i].split("\n");
        lines = lines.filter(l => !l.startsWith("pip install ") && !l.startsWith("!pip install "));
        pythonCodeBlocks[i] = lines.join("\n");
      }

      pythonImports = [...new Set(pythonImports)];
      let htmlPage = `
      <!DOCTYPE html>
      <html>
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <script src="https://cdn.jsdelivr.net/pyodide/v0.25.1/full/pyodide.js"></script>
        </head>
        <body>
          <div id="outputEl"></div>
          <script id="dataEl" type="data">${encodeURIComponent(JSON.stringify({pythonCodeBlocks, pythonImports}))}</script>
          <script type="module">
            outputEl.innerHTML = "Loading Python packages...";
            let outputs = [];
            let pyodide = await loadPyodide({
              stdout: (line) => { outputs.push("<div style='white-space:pre;'>"+line+"</div>"); },
              stderr: (line) => { outputs.push("<div style='color:red; white-space:pre;'>"+line+"</div>"); },
            });
            let data = JSON.parse(decodeURIComponent(dataEl.textContent));
            await pyodide.loadPackage(data.pythonImports).catch(e => outputs.push("<div style='color:red; white-space:pre;'>"+e.message+"</div>"))
            for(let block of data.pythonCodeBlocks) {
              try {
                let result = pyodide.runPython(block);
                if(result) outputs.push("<div>"+result+"</div>");
              } catch(e) {
                outputs.push("<div style='color:red; white-space:pre;'>"+e.message+"</div>");
                console.error(e);
              }
            }
            outputEl.innerHTML = outputs.join("");
          </script>
        </body>
      </html>
      `;
      renderedOutputEl.innerHTML = `<h3>Executed Python Code Output:</h3><iframe srcdoc="" style="width:100%; height:800px; max-height:80vh;"></iframe>`;
      renderedOutputEl.querySelector("iframe").srcdoc = htmlPage;

  luau
    category = Code
    label = 🟦 Luau (Roblox)
    description = Generate Luau code for Roblox, including scripts, modules, OOP patterns, and gameplay systems.
    instructionPlaceholder = Describe the Roblox system or script you want...
    instruction
      Generate Luau code for Roblox based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```lua fenced blocks.
      - Use idiomatic Luau patterns (typed tables, :Connect, :WaitForChild, etc.).
      - Prefer ModuleScripts for reusable systems.
      - Avoid deprecated APIs.
      - Include comments explaining key logic.
      $output = [this.joinItems("\n")]

  gdscript
    category = Code
    label = 🟨 GDScript (Godot)
    description = Generate GDScript for Godot 3.x and 4.x, including nodes, scenes, signals, and gameplay logic.
    instructionPlaceholder = Describe the Godot script or system you want...
    instruction
      Generate GDScript based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```gdscript fenced blocks.
      - Specify whether the script is for Godot 3.x or 4.x.
      - Use typed variables and signals when appropriate.
      - Include comments describing node paths and scene structure.
      - Prefer `_ready()`, `_process(delta)`, and `_physics_process(delta)` for lifecycle logic.
      $output = [this.joinItems("\n")]

  csharp_unity
    category = Code
    label = 🎮 C# (Unity)
    description = Generate Unity C# scripts for components, systems, gameplay, and editor tools.
    instructionPlaceholder = Describe the Unity script or system you want...
    instruction
      Generate Unity C# code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```csharp fenced blocks.
      - Use MonoBehaviour or ScriptableObject as appropriate.
      - Include serialized fields and UnityEvents when useful.
      - Use Update(), FixedUpdate(), and coroutines correctly.
      - Include comments explaining inspector fields and logic.
      $output = [this.joinItems("\n")]

  typescript
    category = Code
    label = 🟦 TypeScript
    description = Generate TypeScript code for web apps, Node.js, APIs, and tools.
    instructionPlaceholder = Describe the TypeScript code you want...
    instruction
      Generate TypeScript code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```ts fenced blocks.
      - Use interfaces, types, generics, and enums when appropriate.
      - Prefer async/await for asynchronous logic.
      - Include comments explaining types and functions.
      $output = [this.joinItems("\n")]

  cpp
    category = Code
    label = 💠 C++
    description = Generate C++ code for systems, engines, algorithms, and performance‑critical tasks.
    instructionPlaceholder = Describe the C++ code you want...
    instruction
      Generate C++ code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```cpp fenced blocks.
      - Use modern C++ (C++17 or C++20).
      - Prefer smart pointers over raw pointers.
      - Include comments explaining memory ownership and lifetime.
      $output = [this.joinItems("\n")]

  rust
    category = Code
    label = 🦀 Rust
    description = Generate Rust code for systems, CLI tools, APIs, and performance‑critical logic.
    instructionPlaceholder = Describe the Rust code you want...
    instruction
      Generate Rust code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All code must be inside ```rust fenced blocks.
      - Use idiomatic Rust patterns (Result<T>, Option<T>, match, traits).
      - Prefer safe Rust; avoid unnecessary unsafe blocks.
      - Include comments explaining ownership and borrowing.
      $output = [this.joinItems("\n")]

  sql
    category = Code
    label = 🗄 SQL
    description = Generate SQL queries, schemas, migrations, and stored procedures.
    instructionPlaceholder = Describe the SQL you want...
    instruction
      Generate SQL based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - All SQL must be inside ```sql fenced blocks.
      - Specify dialect when relevant (MySQL, PostgreSQL, SQLite, MSSQL).
      - Include comments explaining joins, indexes, and constraints.
      $output = [this.joinItems("\n")]

  // ======================
  // PERCHANCE MODES
  // ======================
  perchanceLists
    category = Perchance
    label = 🎲 Perchance Lists
    description = For use in the Perchance lists editor panel, including Perchance syntax and functions.
    instructionPlaceholder = Describe the Perchance lists / functions you want to generate...
    instruction
      [literal(instructionEl.value)]
      $output = [this.joinItems("\n")]

  perchanceHtml
    category = Perchance
    label = 🎲 Perchance HTML
    description = For use in the Perchance HTML editor panel.
    instructionPlaceholder = Describe the Perchance HTML UI you want...
    instruction
      Generate HTML/CSS/JS code based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Tips:
      - Only include the HTML inside the <body> tag. Don't include the <body> tags themselves. Don't include <!DOCTYPE html> or <html>, or <head> tags. Just give the content of the <body> tag.
      - If the above instruction requires image placeholders, use Unsplash like this: <img src\="https://source.unsplash.com/random/?city,night">
      $output = [this.joinItems("\n")]
    onFinish(data) =>
      let htmlPage;
      if(!htmlPage) htmlPage = (responseEl.value.match(/```(html|)(.+?)```/s) || [])[2];
      if(!htmlPage) htmlPage = (responseEl.value.match(/<!DOCTYPE html>(.+)<\/html>/s) || [])[1];
      if(!htmlPage) htmlPage = responseEl.value;
      renderedOutputEl.innerHTML = `<iframe srcdoc="" style="width:100%; height:700px; max-height:70vh;"></iframe>`;
      renderedOutputEl.querySelector("iframe").srcdoc = htmlPage;

  // ======================
  // ADVANCED MODES
  // ======================
  router
    category = Advanced
    label = 🧭 Router
    description = Build a meta-prompt from UI selections and route logically.
    instructionPlaceholder = Describe what you want; the router will decide structure...
    instruction
      You are a routing assistant that builds a structured meta-prompt.
      The user instruction is:
      [literal(instructionEl.value)]
      [""]
      Tasks:
      - Infer whether the user wants code, markdown, character, Perchance, or general text.
      - Build a clear meta-prompt that specifies style, tone, format, and constraints.
      - Then answer directly using the best-suited format.
      $output = [this.joinItems("\n")]

  comparison
    category = Advanced
    label = 🆚 Comparison
    description = Generate multiple variations and compare them side by side.
    instructionPlaceholder = Describe what you want multiple variations of...
    instruction
      Generate 3 distinct variations based on this instruction:
      [literal(instructionEl.value)]
      [""]
      For each variation:
      - Use a clear heading: "Variation 1", "Variation 2", "Variation 3".
      - Explain briefly how this variation differs in style, tone, or structure.
      - Keep them comparable in length.
      $output = [this.joinItems("\n")]

  presets
    category = Advanced
    label = 🎛 Presets
    description = Generate or describe reusable presets for this generator.
    instructionPlaceholder = Describe the preset(s) you want to define...
    instruction
      Based on this description, define one or more presets:
      [literal(instructionEl.value)]
      [""]
      Output a JSON-like structure describing:
      - name
      - description
      - targetMode (general, html, python, markdown, character, etc.)
      - style (formal, casual, technical, etc.)
      - tone
      - constraints (length, format, etc.)
      - examplePrompt
      Make it easy to store and reuse.
      $output = [this.joinItems("\n")]

  // ======================
  // UTILITY / SPECIALIZED MODES
  // ======================
  test
    category = Utility
    label = 🧪 Tests
    description = Generate unit tests, integration tests, and test plans.
    instructionPlaceholder = Describe the code or system you want tests for...
    instruction
      Generate tests based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Include:
      - Unit tests with clear assertions.
      - Integration tests where relevant.
      - Brief explanation of coverage and edge cases.
      $output = [this.joinItems("\n")]

  refactor
    category = Utility
    label = 🧰 Refactor
    description = Refactor and improve code architecture and style.
    instructionPlaceholder = Paste code or describe the refactor you want...
    instruction
      Refactor the following code or system:
      [literal(instructionEl.value)]
      [""]
      Goals:
      - Improve readability and structure.
      - Reduce duplication.
      - Make it more extensible and maintainable.
      - Explain key changes briefly.
      $output = [this.joinItems("\n")]

  design
    category = Utility
    label = 🎨 Design
    description = Generate UI/UX designs, component structures, and CSS systems.
    instructionPlaceholder = Describe the UI/UX or design system you want...
    instruction
      Generate a UI/UX design or component system based on this instruction:
      [literal(instructionEl.value)]
      [""]
      Include:
      - Component breakdown.
      - Layout description.
      - Styling guidelines (colors, typography, spacing).
      - Optional HTML/CSS snippets.
      $output = [this.joinItems("\n")]

  tutorial
    category = Utility
    label = 📚 Tutorial
    description = Create step-by-step tutorials, guides, and walkthroughs.
    instructionPlaceholder = Describe the topic you want a tutorial on...
    instruction
      Create a step-by-step tutorial based on this topic:
      [literal(instructionEl.value)]
      [""]
      Structure:
      - Introduction
      - Prerequisites
      - Step-by-step sections
      - Examples
      - Summary / next steps
      $output = [this.joinItems("\n")]

  math
    category = Utility
    label = 🧮 Math
    description = Solve math problems with clear steps and explanations.
    instructionPlaceholder = Describe the math problem or topic...
    instruction
      Solve or explain the following math problem/topic:
      [literal(instructionEl.value)]
      [""]
      Requirements:
      - Show each step clearly.
      - Explain reasoning in plain language.
      - Provide the final answer at the end.
      $output = [this.joinItems("\n")]

  schema
    category = Utility
    label = 🧱 Schema
    description = Generate JSON schemas, TypeScript types, and data models.
    instructionPlaceholder = Describe the data structure or API you want...
    instruction
      Generate schemas/types/models based on this description:
      [literal(instructionEl.value)]
      [""]
      Include:
      - JSON Schema (if relevant).
      - TypeScript types or interfaces.
      - Brief explanation of each field.
      $output = [this.joinItems("\n")]

  template
    category = Utility
    label = 🧩 Template
    description = Create reusable prompt or document templates.
    instructionPlaceholder = Describe the template you want to create...
    instruction
      Create a reusable template based on this description:
      [literal(instructionEl.value)]
      [""]
      Output:
      - A generic version with placeholders.
      - An example filled-in version.
      $output = [this.joinItems("\n")]

  agent
    category = Utility
    label = 🧠 Agent
    description = Define agent behaviors, tools, and instructions.
    instructionPlaceholder = Describe the agent you want to define...
    instruction
      Define an agent based on this description:
      [literal(instructionEl.value)]
      [""]
      Include:
      - Name and role.
      - Capabilities and tools.
      - Input/output formats.
      - Safety and limits.
      - Example interactions.
      $output = [this.joinItems("\n")]