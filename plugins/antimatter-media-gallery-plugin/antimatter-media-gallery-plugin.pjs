kv = {import:kv-plugin}
superFetch = {import:super-fetch-plugin}
AMShared = {import:antimatter-shared}
createMediaGallery = [$output]
$output(name) =>
  if(!name) name = "";
  if(!/^[a-zA-Z0-9_]*$/.test(name)) throw new Error("Gallery name must be alphanumeric");
  const pre = `localMediaGallery_${name}.`;
  const galleriesKey = pre + "names";
  const tagsKey = pre + "allTags";
  const defaultGallery = "general";
  let activeGalleryName = localStorage[pre + "activeGalleryName"] || defaultGallery;
  let currentRowH = parseInt(localStorage[pre + "rowH"] || "200");
  // Theme, fonts, and modal shell come from AMShared
  const AMS = AMShared();
  AMS.applyTheme();
  AMS.ensureModalShellStyles();
  AMS.ensureFormStyles();
  AMS.ensureWidgetStyles();
  // Normalizes an info object to string values, keeping known metadata keys
  const cleanInfo = i => {
    if (!i || typeof i !== "object") i = {};
    const o = {};
    for (const [k, v] of Object.entries(i)) {
      if (v !== undefined && typeof v !== 'function') o[k] = String(v);
    }
    const knownKeys = ["prompt", "negativePrompt", "guidanceScale", "seed", "shape", "model", "cfgScale", "sampler", "steps"];
    for (const k of knownKeys) {
      if (i[k] !== undefined && o[k] === undefined) {
        o[k] = String(i[k]);
      }
    }
    return o;
  };
  if (!document.getElementById("mg-system-styles")) {
    const l = document.createElement("link");
    l.id = "mg-system-styles";
    l.rel = "stylesheet";
    l.href = "https://fonts.googleapis.com/icon?family=Material+Icons";
    document.head.appendChild(l);
    const s = document.createElement("style");
    s.textContent = `
      .mg-btn { background: rgba(255,255,255,0.04); color: var(--text-muted); border: 1px solid var(--border-color); border-radius: var(--radius-sm); width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all var(--transition-fast); }
      .mg-btn:hover { background: rgba(255,255,255,0.08); color: var(--text-main); border-color: var(--border-focus); }
      .mg-btn:active { background: rgba(255,255,255,0.12); }
      .mg-btn.mg-btn--flat { background: transparent; border: none; }
      .mg-sel-card { position: absolute; inset: 0; background: rgba(0,0,0,0.6); border: 2px solid var(--accent-color); display: flex; align-items: center; justify-content: center; z-index: 5; pointer-events: none; }
      .mg-card-bar { position: absolute; bottom: 4px; left: 4px; right: 4px; display: flex; flex-wrap: wrap; justify-content: center; gap: 2px; background: var(--bg-elevated); border: 1px solid var(--border-color); padding: 2px; border-radius: var(--radius-sm); z-index: 10; pointer-events: auto; opacity: 0; transition: opacity 0.15s; }
      .mg-card:hover .mg-card-bar { opacity: 1; }
      .mg-badge { position: absolute; top: 4px; left: 4px; z-index: 6; pointer-events: none; opacity: 0; transition: opacity 0.15s; display:flex; align-items:center; gap:2px; background:rgba(0,0,0,0.55); border-radius:var(--radius-sm); padding:1px 4px; }
      .mg-card:hover .mg-badge { opacity: 1; }
      .mg-badge.always-show { opacity: 1; }
      .mg-input { background: var(--bg-body); color: var(--text-main); border: 1px solid var(--border-color); padding: 6px 8px; outline: none; font-family: var(--font-mono); font-size: 12px; border-radius: var(--radius-sm); transition: border-color var(--transition-fast); }
      .mg-input:focus { border-color: var(--border-focus); }
      /* .mg-slider now comes from AMShared's .am-slider (set width:90px inline where used). */
      .mg-checklist-toggle { position:relative; width:34px; height:18px; cursor:pointer; flex-shrink:0; }
      .mg-checklist-toggle input { opacity:0; width:0; height:0; position:absolute; }
      .mg-checklist-track { position:absolute; inset:0; background: var(--bg-body); border:1px solid var(--border-color); border-radius: var(--radius-pill); transition:all 0.2s; }
      .mg-checklist-toggle input:checked + .mg-checklist-track { background:rgba(139,92,246,0.35); border-color: var(--accent-color); }
      .mg-checklist-thumb { position:absolute; top:1px; left:1px; width:14px; height:14px; border-radius:50%; background: var(--text-dim); transition:all 0.2s; }
      .mg-checklist-toggle input:checked ~ .mg-checklist-thumb { left:17px; background: var(--accent-color); }
      #localMediaGallery_root * { box-sizing: border-box; }
      #localMediaGallery_root ::-webkit-scrollbar { width: 6px; height: 6px; }
      #localMediaGallery_root ::-webkit-scrollbar-track { background: transparent; }
      #localMediaGallery_root ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 3px; }
      #localMediaGallery_root ::-webkit-scrollbar-thumb:hover { background: var(--text-dim); }
    `;
    document.head.appendChild(s);
  }
  const getGalleryNames = () => JSON.parse(localStorage.getItem(galleriesKey) || `["${defaultGallery}"]`);
  const saveGalleryNames = a => localStorage.setItem(galleriesKey, JSON.stringify([...new Set(a)]));
  const getAllTags = () => JSON.parse(localStorage.getItem(tagsKey) || "[]");
  const saveAllTags = arr => localStorage.setItem(tagsKey, JSON.stringify([...new Set(arr.filter(Boolean))].sort((a,b)=>a.localeCompare(b))));
  const registerTags = tags => {
    if (!tags || !tags.length) return;
    const cur = getAllTags();
    const curLower = cur.map(t => t.toLowerCase());
    const additions = tags.filter(t => t && !curLower.includes(t.toLowerCase()));
    if (additions.length) saveAllTags([...cur, ...additions]);
  };
  const $ = (t,p={},...k)=>{
    const el=document.createElement(t);
    for(const [k2,v] of Object.entries(p)){
      if(k2==="style")el.style.cssText=v;
      else if(k2==="dataset")Object.assign(el.dataset,v);
      else if(k2==="innerHTML")el.innerHTML=v;
      else el[k2]=v;
    }
    k.forEach(c => c && el.append(c));
    return el;
  };
  // Small toggle switch used by the tag manager checklist
  const buildToggle = (checked, onChange) => {
    const wrap = $("label", {className:"mg-checklist-toggle"});
    const inp = $("input", {type:"checkbox", checked});
    inp.onchange = () => onChange(inp.checked);
    wrap.appendChild(inp);
    wrap.appendChild($("span", {className:"mg-checklist-track"}));
    wrap.appendChild($("span", {className:"mg-checklist-thumb"}));
    return wrap;
  };
  const dims = b=>new Promise(r=>{
    if (b.type.startsWith("image/")) {
      const i=new Image();i.onload=()=>r({w:i.width,h:i.height});i.src=URL.createObjectURL(b);
    } else if(b.type.startsWith("video/")) {
      const v=document.createElement("video");v.onloadedmetadata=()=>r({w:v.videoWidth||300,h:v.videoHeight||300});v.src=URL.createObjectURL(b);
    } else {
      r({w:300,h:300});
    }
  });
  const blobs = kv[pre+"blobs"];
  const originalBlobsSet = blobs.set.bind(blobs);
  blobs.set = async (id, data) => {
    const blob = data?.blob ?? data;
    const info = data?.info ?? null;
    const arrayBuffer = await blob.arrayBuffer();
    return originalBlobsSet(id, { buffer: arrayBuffer, type: blob.type, info });
  };
  const originalBlobsGet = blobs.get.bind(blobs);
  blobs.get = async (id) => {
    const rec = await originalBlobsGet(id);
    if (!rec) return null;
    if (rec instanceof Blob) return { blob: rec, info: null };
    if (rec.blob instanceof Blob) return rec;
    if (rec.buffer) {
      const blob = new Blob([rec.buffer], { type: rec.type || 'application/octet-stream' });
      return { blob, info: rec.info ?? null };
    }
    return rec;
  };
  let jszipMod=null;
  // Lazy-loads JSZip from CDN, caching the module after first load
  const getJSZip=()=>jszipMod?jszipMod:import("https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm").then(m=>(jszipMod=m.default||m));
  // Downloads a .zip backup of every gallery's media and metadata
  async function saveBackup(){
    if(!confirm("Download a .zip backup of all galleries?"))return;
    const files=[];
    for(const g of getGalleryNames()){
      const items = await kv[pre+g].values();
      for(const m of items){
        const rec = await blobs.get(m.id);
        const b = rec?.blob||rec;
        const ext = (b.type.split("/")[1]||"bin").replace(/[^\w.-]/g,'');
        files.push({name:`galleries/${g}/${m.id}.${ext}`,blob:b});
        files.push({name:`galleries/${g}/${m.id}.info.json`,blob:new Blob([JSON.stringify({meta:m,info:rec?.info||null,mime:b.type},null,2)],{type:"application/json"})});
      }
    }
    files.push({name:`tags.json`, blob:new Blob([JSON.stringify(getAllTags(),null,2)],{type:"application/json"})});
    const JSZip = await getJSZip();
    const zip = new JSZip();
    files.forEach(f=>zip.file(f.name,f.blob));
    const zipBlob = await zip.generateAsync({type:"blob"});
    const a=$("a",{href:URL.createObjectURL(zipBlob),download:`backup_${Date.now()}.zip`});
    a.click();URL.revokeObjectURL(a.href);
  }
  // Restores galleries/tags from a .zip backup, merging into existing data without overwriting existing items
  async function loadBackup(galDropdown){
    return new Promise(resolve => {
      const inp=$("input",{type:"file",accept:".zip",style:"display:none"});
      inp.onchange=async()=>{
        try {
          const file=inp.files[0];
          if(!file) return;
          if(!confirm("Importing will merge the backup into current galleries. Continue?")) return;
          const JSZip = await getJSZip();
          const zip = await JSZip.loadAsync(file);
          const entries = [];
          let importedTags = [];
          await Promise.all(Object.values(zip.files).map(async z => {
            if(z.dir)return;
            if(z.name === "tags.json"){
              try{ importedTags = JSON.parse(await z.async("text")); }catch(e){}
              return;
            }
            entries.push({name:z.name,blob:await z.async("blob")});
          }));
          const infoMap = Object.create(null);
          const mediaMap = Object.create(null);
          for(const e of entries){
            if(e.name.endsWith(".info.json")){
              const m = /^galleries\/([^\/]+)\/([^\/]+)\.info\.json$/.exec(e.name);
              if(!m)continue;
              infoMap[m[1]]??={};
              infoMap[m[1]][m[2]]=JSON.parse(await e.blob.text());
            }else{
              const m = /^galleries\/([^\/]+)\/([^\/]+)$/.exec(e.name);
              if(!m) continue;
              const id = m[2].replace(/\.[^.]+$/,'');
              mediaMap[m[1]] ??= {};
              mediaMap[m[1]][id] = e.blob;
            }
          }
          const allTagsFromImport = [...importedTags];
          for(const [gal,objs] of Object.entries(mediaMap)){
            const current = getGalleryNames();
            if(!current.includes(gal)) saveGalleryNames([...current,gal]);
            for(const [id, blob] of Object.entries(objs)){
              const skip = await blobs.get(id);
              if(skip) continue;
              const inf = infoMap[gal]?.[id]||{};
              let b = blob;
              if(!b.type && inf.mime) b = new Blob([await blob.arrayBuffer()], {type:inf.mime});
              const {w,h}=await dims(b);
              await blobs.set(id,{blob:b,info:cleanInfo(inf.info||null)});
              const tags = Array.isArray(inf.meta?.tags)?inf.meta.tags:[];
              allTagsFromImport.push(...tags);
              await kv[pre+gal].set(id,{id,date:inf.meta?.date||Date.now(),rating:inf.meta?.rating||0,w,h,tags});
            }
          }
          registerTags(allTagsFromImport);
        } finally {
          resolve();
        }
      };
      document.body.appendChild(inp);
      inp.click();
      inp.remove();
    });
  }
  // Checks all galleries for an existing item with matching prompt/negativePrompt/seed/guidanceScale
  async function findDuplicateAnywhere(info) {
    const dupeFields = ["prompt", "negativePrompt", "seed", "guidanceScale"];
    const allRecords = await blobs.values();
    for (const rec of allRecords) {
      const ri = rec?.info;
      if (!ri) continue;
      const isMatch = dupeFields.every(k => String(ri[k] ?? '') === String(info[k] ?? ''));
      if (isMatch) return true;
    }
    return false;
  }
  // Adds a blob (plus prompt info and tags) to a gallery folder, warning on duplicates
  async function add(inputData, opts={}) {
    let folder = opts.folder ?? activeGalleryName;
    let infoObj = opts.info ?? {};
    let blob = inputData;
    if (inputData && inputData.blob instanceof Blob) {
      blob = inputData.blob;
    }
    if (inputData && typeof inputData === 'object') {
      const knownKeys = ["prompt", "negativePrompt", "guidanceScale", "seed", "shape", "model", "cfgScale", "sampler", "steps"];
      for (const k of knownKeys) {
        if (inputData[k] !== undefined && infoObj[k] === undefined) {
          infoObj[k] = inputData[k];
        }
      }
    }
    const info = cleanInfo(infoObj);
    if (!opts.skipDuplicateCheck) {
      const isDupe = await findDuplicateAnywhere(info);
      if (isDupe && !confirm("Image matching prompt and seed already exists, do you want to add it again?")) {
        return null;
      }
    }
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    const {w, h} = await dims(blob);
    await blobs.set(id, {blob, info});
    const tags = Array.isArray(opts.tags) ? opts.tags : [];
    await kv[pre+folder].set(id, {id, date:Date.now(), rating:0, w, h, tags});
    registerTags(tags);
    const names = getGalleryNames();
    if(!names.includes(folder)) saveGalleryNames([...names, folder]);
    return id;
  }
  // Permanently wipes all galleries, tags, and blobs after a confirmation prompt
  async function clearAllData(){
    if(prompt('Type "yes" to permanently delete ALL data:')!=="yes")return;
    for(const n of getGalleryNames()) await kv[pre+n].clear();
    await blobs.clear();
    saveGalleryNames([defaultGallery]);
    localStorage.removeItem(tagsKey);
    activeGalleryName = defaultGallery;
    localStorage.removeItem(pre+"activeGalleryName");
  }
  // Builds a reusable button + popup menu dropdown (icon-only or labeled)
  const createDropdown = (config, items, onSelect, activeVal = null) => {
    const cont = $("div", {style:"position:relative;display:inline-flex;align-items:center;"});
    const btn = $("button", {className:"mg-btn", style:"width:auto;height:26px;padding:0 10px;gap:6px;border-radius:var(--radius-sm);"});
    if(config.type === "icon") {
      btn.classList.add("mg-btn--flat");
      btn.style.width = "26px";
      btn.style.padding = "0";
    }
    const menu = $("div", {style:"position:absolute;top:100%;left:0;margin-top:6px;background:var(--bg-elevated);border:1px solid var(--border-color);border-radius:var(--radius-md);box-shadow:var(--shadow-lg);display:none;flex-direction:column;min-width:160px;z-index:10002;overflow-y:auto;max-height:60vh;"});
    let isOpen = false;
    const close = () => { menu.style.display="none"; isOpen=false; };
    btn.onclick = (e) => { e.stopPropagation(); isOpen = !isOpen; menu.style.display = isOpen ? "flex" : "none"; };
    document.addEventListener("click", close);
    cont.onclick = e => e.stopPropagation();
    const updateItems = (newItems, newActive) => {
      menu.innerHTML = "";
      newItems.forEach(item => {
        if(item.divider) {
          menu.appendChild($("div", {style:"height:1px;background:var(--border-color);margin:4px 0;"}));
          return;
        }
        const opt = $("button", {style:`padding:10px 12px;background:${item.value===newActive ? 'rgba(139,92,246,0.12)' : 'transparent'};border:none;color:var(--text-main);text-align:left;display:flex;align-items:center;gap:10px;cursor:pointer;font-size:12px;font-family:var(--font-ui);`});
        if(item.icon) {
          const ic = $("span", {className:"material-icons", style:`font-size:18px;${item.color?`color:${item.color}`:'color:var(--text-muted);'}`});
          ic.textContent = item.icon;
          opt.appendChild(ic);
        }
        opt.appendChild($("span", {style:"flex:1;"}, item.text));
        if(item.value === newActive) opt.appendChild($("span", {className:"material-icons", style:"font-size:16px;color:var(--accent-color);"}, "check"));
        opt.onmouseover = () => { opt.style.background = "rgba(255,255,255,0.06)"; };
        opt.onmouseout = () => { opt.style.background = item.value===newActive ? 'rgba(139,92,246,0.12)' : 'transparent'; };
        opt.onclick = () => { close(); onSelect(item.value); };
        menu.appendChild(opt);
      });
      if(config.type === "icon") {
        btn.innerHTML = `<span class='material-icons' style='font-size:20px;'>${config.icon}</span>`;
      } else {
        const activeItem = newItems.find(i => i.value === newActive) || newItems[0];
        btn.innerHTML = `<span style='font-size:12px;font-weight:600;font-family:var(--font-ui);color:var(--text-main);'>${activeItem ? activeItem.text : config.fallback}</span><span class='material-icons' style='font-size:16px;color:var(--text-dim);'>arrow_drop_down</span>`;
      }
    };
    updateItems(items, activeVal);
    cont.appendChild(btn);
    cont.appendChild(menu);
    return { cont, btn, updateItems };
  };
  // Shared modal for assigning/creating tags on one item or a batch selection
  async function openTagManager(items, onAnyChange){
    if (!items || !items.length) return;
    registerTags(items.flatMap(m => m.tags||[]));
    let query = "";
    const overlay = $("div", {className:"modal-overlay active", style:"z-index:10003;"});
    const bg = $("div", {className:"modal-bg"});
    const modal = $("div", {className:"modal-content sm", style:"width:360px;"});
    overlay.appendChild(bg);
    overlay.appendChild(modal);
    const headerWrap = $("div", {className:"modal-header-wrapper"});
    const head = $("div", {className:"modal-head"});
    head.appendChild($("span", {className:"modal-title", innerHTML:`<span class="modal-title-icon"><span class="material-icons" style="font-size:12px;">sell</span></span> Manage Tags${items.length>1?` <span style="opacity:0.6;font-weight:400;text-transform:none;letter-spacing:0;">(${items.length} selected)</span>`:''}`}));
    const closeBtn = $("div", {className:"modal-close", innerHTML:"<span class='material-icons' style='font-size:14px;'>close</span>"});
    head.appendChild(closeBtn);
    headerWrap.appendChild(head);
    modal.appendChild(headerWrap);
    const body = $("div", {className:"modal-body"});
    modal.appendChild(body);
    const searchInp = $("input", {className:"mg-input", placeholder:"Search tags…", style:"width:100%;margin-bottom:10px;"});
    body.appendChild(searchInp);
    const list = $("div", {className:"am-checklist"});
    body.appendChild(list);
    const newTagRow = $("div", {style:"display:flex;gap:6px;margin-top:10px;"});
    const newTagInp = $("input", {className:"mg-input", placeholder:"New tag name…", style:"flex:1;"});
    const addBtn = $("button", {className:"mg-btn", title:"Create tag", innerHTML:"<span class='material-icons' style='font-size:18px;'>add</span>"});
    newTagRow.appendChild(newTagInp);
    newTagRow.appendChild(addBtn);
    body.appendChild(newTagRow);
    const persist = async m => { await kv[pre + activeGalleryName].set(m.id, m); };
    const rebuildList = () => {
      list.innerHTML = "";
      const q = query.trim().toLowerCase();
      const all = getAllTags().filter(t => !q || t.toLowerCase().includes(q));
      if (!all.length) { list.appendChild($("div", {className:"am-checklist-empty"}, q ? "No tags match your search." : "No tags created yet — add one below.")); return; }
      all.forEach(tag => {
        const row = $("div", {className:"am-checklist-row"});
        row.appendChild($("span", {className:"am-checklist-row-label"}, tag));
        const checked = items.every(m => (m.tags||[]).includes(tag));
        row.appendChild(buildToggle(checked, async newVal => {
          for (const m of items) {
            const set = new Set(m.tags||[]);
            newVal ? set.add(tag) : set.delete(tag);
            m.tags = [...set];
            await persist(m);
          }
          onAnyChange?.();
        }));
        list.appendChild(row);
      });
    };
    searchInp.oninput = e => { query = e.target.value; rebuildList(); };
    addBtn.onclick = async () => {
      const name = newTagInp.value.trim();
      if (!name) return;
      registerTags([name]);
      for (const m of items) {
        const set = new Set(m.tags||[]);
        set.add(name);
        m.tags = [...set];
        await persist(m);
      }
      newTagInp.value = "";
      rebuildList();
      onAnyChange?.();
    };
    newTagInp.onkeydown = e => { if (e.key === "Enter") addBtn.onclick(); };
    rebuildList();
    const close = () => overlay.remove();
    closeBtn.onclick = close;
    bg.addEventListener("mousedown", e => { if (e.target === bg) close(); });
    document.body.appendChild(overlay);
    searchInp.focus();
  }
  // Renders and mounts the full gallery viewer overlay
  async function show() {
    const isMobile = window.matchMedia("(pointer: coarse)").matches && window.innerWidth < 500;
    document.getElementById("localMediaGallery_root")?.remove();
    const prevHtmlOv = document.documentElement.style.overflow;
    const prevBodyOv = document.body.style.overflow;
    document.documentElement.style.overflow = document.body.style.overflow = "hidden";
    const root=$("div",{id:"localMediaGallery_root", style:"background:var(--bg-body);color:var(--text-main);position:fixed;inset:0;z-index:9999;font-family:var(--font-mono);display:flex;flex-direction:column;"});
    document.body.appendChild(root);
    let isSelMode = false;
    let selSet = new Set();
    let mediaArr=[];
    // Cache of lowercased prompt text per item id, for fast search matching
    const promptCache = new Map();
    const ensurePromptCache = async () => {
      await Promise.all(mediaArr.filter(m => !promptCache.has(m.id)).map(async m => {
        const rec = await blobs.get(m.id);
        promptCache.set(m.id, String(rec?.info?.prompt || "").toLowerCase());
      }));
    };
    const closeGallery = () => {
      document.removeEventListener("keydown", onKeyGallery);
      document.documentElement.style.overflow = prevHtmlOv;
      document.body.style.overflow = prevBodyOv;
      root.remove();
    };
    const onKeyGallery = e => {
      if (e.key === "Escape" && !document.querySelector("[data-local-media-gallery-lightbox]") && !document.getElementById("info-editor-overlay") && !document.querySelector(".modal-overlay.active")) closeGallery();
    };
    document.addEventListener("keydown", onKeyGallery);
    const headerBarEl = root.appendChild($("div",{style:"padding:8px 12px;display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--border-color);background:var(--bg-surface);flex-wrap:wrap;"}));
    const grid=root.appendChild($("div",{style:"flex:1;overflow:auto;display:flex;flex-wrap:wrap;gap:12px;padding:20px;align-content:flex-start;justify-content:center;"}));
    const normalBar = $("div", {style:"display:flex;flex:1;gap:10px;align-items:center;flex-wrap:wrap;"});
    const batchBar = $("div", {style:"display:none;flex:1;gap:10px;align-items:center;flex-wrap:wrap;"});
    headerBarEl.appendChild(normalBar);
    headerBarEl.appendChild(batchBar);
    const menuOpts = [
      {value:"saveBackup", text:"Save Backup", icon:"save"},
      {value:"loadBackup", text:"Load Backup", icon:"restore"},
      {value:"importLocal", text:"Import Local", icon:"upload_file"},
      {value:"importURL", text:"Import URL", icon:"link"},
      {value:"storageInfo", text:"Storage Info", icon:"storage"},
      {divider:true},
      {value:"clearAll", text:"Clear ALL Data", icon:"delete_forever", color:"#cf6679"}
    ];
    const handleMenuSelect = async val => {
      if(val==="saveBackup"){ await saveBackup(); }
      else if(val==="loadBackup"){ await loadBackup(galDropdown); galDropdown.updateItems(getGalOpts(), activeGalleryName); await loadGallery(); }
      else if(val==="importLocal"){
        const inp=$("input",{type:"file",multiple:true,style:"display:none"});
        inp.onchange=async()=>{
          for(const f of inp.files) await add(f);
          await loadGallery();
        };
        document.body.appendChild(inp);inp.click();inp.remove();
      }
      else if(val==="importURL"){
        const u=prompt("URL to import:");
        if(u){
          try{
            const resp=await superFetch(u);
            if(!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const b=await resp.blob();
            await add(b);
            await loadGallery();
          }catch(e){ alert("Failed: "+e.message); }
        }
      }
      else if(val==="storageInfo"){
        const {usage,quota}=await navigator.storage.estimate();
        alert(`Using ${(usage/1024**3).toFixed(1)} GB out of ${(quota/1024**3).toFixed(1)} GB.`);
      }
      else if(val==="clearAll"){
        await clearAllData();
        galDropdown.updateItems(getGalOpts(), activeGalleryName);
        loadGallery();
      }
    };
    const mainDropdown = createDropdown({type:"icon", icon:"menu"}, menuOpts, handleMenuSelect);
    normalBar.appendChild(mainDropdown.cont);
    const getGalOpts = () => [
      ...getGalleryNames().map(n => ({value:n, text:n, icon:"folder"})),
      {divider:true},
      {value:"__new__", text:"New Folder", icon:"create_new_folder"},
      {value:"__del__", text:"Delete Folder", icon:"folder_delete", color:"#cf6679"}
    ];
    let galDropdown;
    const handleGalSelect = async val => {
      if(val === "__new__") {
        const n=prompt("Folder name:");
        if(!n) { galDropdown.updateItems(getGalOpts(), activeGalleryName); return; }
        saveGalleryNames( [...getGalleryNames(),n] );
        activeGalleryName=n;
        localStorage[pre+"activeGalleryName"]=n;
      } else if(val === "__del__") {
        const n=prompt("Type exact folder name to delete:");
        if(!n||n===defaultGallery||!getGalleryNames().includes(n)) { galDropdown.updateItems(getGalOpts(), activeGalleryName); return; }
        if(!confirm(`Delete folder "${n}"?`)) { galDropdown.updateItems(getGalOpts(), activeGalleryName); return; }
        await kv[pre+n].clear();
        saveGalleryNames( getGalleryNames().filter(x=>x!==n) );
        if(activeGalleryName===n){ activeGalleryName=defaultGallery; localStorage[pre+"activeGalleryName"]=activeGalleryName; }
      } else {
        activeGalleryName = val;
        localStorage[pre+"activeGalleryName"] = activeGalleryName;
      }
      galDropdown.updateItems(getGalOpts(), activeGalleryName);
      isSelMode=false; selSet.clear(); updateTopBar();
      loadGallery();
    };
    galDropdown = createDropdown({type:"text", fallback:"Gallery"}, getGalOpts(), handleGalSelect, activeGalleryName);
    normalBar.appendChild(galDropdown.cont);
    const sortOpts = [
      {value:"dateDesc", text:"Newest", icon:"arrow_downward"},
      {value:"dateAsc", text:"Oldest", icon:"arrow_upward"},
      {value:"ratingDesc", text:"Best", icon:"star"},
      {value:"ratingAsc", text:"Worst", icon:"star_border"}
    ];
    let currentSort = "dateDesc";
    const sortDropdown = createDropdown({type:"text", fallback:"Sort"}, sortOpts, val => {
      currentSort = val;
      sortDropdown.updateItems(sortOpts, currentSort);
      render();
    }, currentSort);
    normalBar.appendChild(sortDropdown.cont);
    // Unified search — matches against tags and/or prompt text depending on the selected mode
    let searchQuery = "";
    let searchMode = localStorage[pre + "searchMode"] || "both";
    const searchModeOpts = [
      {value:"both", text:"Tags & Prompt", icon:"search"},
      {value:"prompt", text:"Prompt Only", icon:"article"},
      {value:"tags", text:"Tags Only", icon:"sell"}
    ];
    const searchModePlaceholders = {both:"Search tags or prompt…", prompt:"Search prompt…", tags:"Search tags…"};
    const searchInp = $("input", {className:"mg-input", placeholder:searchModePlaceholders[searchMode], style:"width:160px;", oninput:e=>{
      searchQuery = e.target.value;
      render();
    }});
    const searchModeDropdown = createDropdown({type:"text", fallback:"Search"}, searchModeOpts, val => {
      searchMode = val;
      localStorage[pre + "searchMode"] = searchMode;
      searchModeDropdown.updateItems(searchModeOpts, searchMode);
      searchInp.placeholder = searchModePlaceholders[searchMode];
      render();
    }, searchMode);
    normalBar.appendChild(searchModeDropdown.cont);
    normalBar.appendChild(searchInp);
    // Tag filter — clickable multi-select tag list with an Any(OR)/All(AND) match mode
    let filterTags = new Set(JSON.parse(localStorage[pre + "filterTags"] || "[]"));
    let filterMode = localStorage[pre + "filterMode"] || "or"; // "or" = any selected tag, "and" = all selected tags
    const tagFilterCont = $("div", {style:"position:relative;display:inline-flex;align-items:center;"});
    const tagFilterBtn = $("button", {className:"mg-btn", style:"width:auto;height:26px;padding:0 10px;gap:6px;border-radius:var(--radius-sm);"});
    const tagFilterMenu = $("div", {style:"position:absolute;top:100%;left:0;margin-top:6px;background:var(--bg-elevated);border:1px solid var(--border-color);border-radius:var(--radius-md);box-shadow:var(--shadow-lg);display:none;flex-direction:column;min-width:220px;max-width:280px;z-index:10002;padding:10px;gap:8px;"});
    let tagFilterOpen = false;
    const closeTagFilter = () => { tagFilterMenu.style.display = "none"; tagFilterOpen = false; };
    tagFilterBtn.onclick = e => { e.stopPropagation(); tagFilterOpen = !tagFilterOpen; tagFilterMenu.style.display = tagFilterOpen ? "flex" : "none"; if (tagFilterOpen) rebuildTagChips(); };
    document.addEventListener("click", closeTagFilter);
    tagFilterCont.onclick = e => e.stopPropagation();
    const modeRow = $("div", {style:"display:flex;gap:4px;"});
    const anyBtn = $("button", {style:"flex:1;padding:5px 0;border-radius:var(--radius-sm);border:1px solid var(--border-color);background:transparent;color:var(--text-main);font-size:11px;font-family:var(--font-ui);cursor:pointer;"}, "Any (OR)");
    const allBtn = $("button", {style:"flex:1;padding:5px 0;border-radius:var(--radius-sm);border:1px solid var(--border-color);background:transparent;color:var(--text-main);font-size:11px;font-family:var(--font-ui);cursor:pointer;"}, "All (AND)");
    modeRow.appendChild(anyBtn); modeRow.appendChild(allBtn);
    tagFilterMenu.appendChild(modeRow);
    const tagChipWrap = $("div", {style:"display:flex;flex-wrap:wrap;gap:6px;max-height:220px;overflow-y:auto;padding-top:2px;"});
    tagFilterMenu.appendChild(tagChipWrap);
    const clearRow = $("div", {style:"display:flex;justify-content:flex-end;"});
    const clearFilterBtn = $("button", {style:"background:transparent;border:none;color:var(--text-dim);font-size:11px;font-family:var(--font-ui);cursor:pointer;text-decoration:underline;padding:2px 0;"}, "Clear tag filter");
    clearRow.appendChild(clearFilterBtn);
    tagFilterMenu.appendChild(clearRow);
    const updateTagFilterBtnLabel = () => {
      const n = filterTags.size;
      tagFilterBtn.innerHTML = `<span class='material-icons' style='font-size:16px;color:${n?'var(--accent-color)':'var(--text-dim)'};'>filter_alt</span><span style='font-size:12px;font-weight:600;font-family:var(--font-ui);color:var(--text-main);'>${n ? `Tags (${n})` : 'Filter Tags'}</span>`;
    };
    const updateModeBtns = () => {
      anyBtn.style.background = filterMode === "or" ? "rgba(139,92,246,0.25)" : "transparent";
      anyBtn.style.borderColor = filterMode === "or" ? "var(--accent-color)" : "var(--border-color)";
      allBtn.style.background = filterMode === "and" ? "rgba(139,92,246,0.25)" : "transparent";
      allBtn.style.borderColor = filterMode === "and" ? "var(--accent-color)" : "var(--border-color)";
    };
    anyBtn.onclick = () => { filterMode = "or"; localStorage[pre+"filterMode"]=filterMode; updateModeBtns(); render(); };
    allBtn.onclick = () => { filterMode = "and"; localStorage[pre+"filterMode"]=filterMode; updateModeBtns(); render(); };
    const rebuildTagChips = () => {
      tagChipWrap.innerHTML = "";
      const all = getAllTags();
      if (!all.length) { tagChipWrap.appendChild($("div", {style:"font-size:11px;color:var(--text-dim);"}, "No tags yet.")); return; }
      all.forEach(tag => {
        const active = filterTags.has(tag);
        const chip = $("button", {style:`padding:4px 10px;border-radius:var(--radius-pill);border:1px solid ${active?'var(--accent-color)':'var(--border-color)'};background:${active?'rgba(139,92,246,0.25)':'transparent'};color:var(--text-main);font-size:11px;font-family:var(--font-ui);cursor:pointer;`}, tag);
        chip.onclick = () => {
          if (filterTags.has(tag)) filterTags.delete(tag); else filterTags.add(tag);
          localStorage[pre+"filterTags"] = JSON.stringify([...filterTags]);
          rebuildTagChips();
          updateTagFilterBtnLabel();
          render();
        };
        tagChipWrap.appendChild(chip);
      });
    };
    clearFilterBtn.onclick = () => {
      filterTags.clear();
      localStorage[pre+"filterTags"] = "[]";
      rebuildTagChips();
      updateTagFilterBtnLabel();
      render();
    };
    updateModeBtns();
    updateTagFilterBtnLabel();
    rebuildTagChips();
    tagFilterCont.appendChild(tagFilterBtn);
    tagFilterCont.appendChild(tagFilterMenu);
    normalBar.appendChild(tagFilterCont);
    // Size control — slider with -5%/+5% step buttons on either end
    const SIZE_MIN = 100, SIZE_MAX = 1000;
    const SIZE_STEP_PCT = Math.round((SIZE_MAX - SIZE_MIN) * 0.05 / 10) * 10; // rounded to a multiple of the slider's step
    const sizeBar = $("div", {style:"display:flex;gap:6px;align-items:center;"});
    const setRowH = val => {
      currentRowH = Math.max(SIZE_MIN, Math.min(SIZE_MAX, val));
      sizeSlider.value = currentRowH;
      sizeSlider.title = `${currentRowH}px`;
      localStorage[pre + "rowH"] = currentRowH;
      render();
    };
    const sizeIconSmall = $("button", {className:"mg-btn mg-btn--flat", title:"Decrease size (-5%)", style:"width:20px;height:20px;", innerHTML:"<span class='material-icons' style='font-size:14px;color:var(--text-dim);'>photo_size_select_small</span>"});
    sizeIconSmall.onclick = () => setRowH(currentRowH - SIZE_STEP_PCT);
    sizeBar.appendChild(sizeIconSmall);
    const sizeSlider = $("input", {className:"am-slider", style:"width:90px", type:"range", min:SIZE_MIN, max:SIZE_MAX, step:10, value:currentRowH, title:`${currentRowH}px`});
    sizeSlider.oninput = () => setRowH(parseInt(sizeSlider.value));
    sizeBar.appendChild(sizeSlider);
    const sizeIconLarge = $("button", {className:"mg-btn mg-btn--flat", title:"Increase size (+5%)", style:"width:24px;height:24px;", innerHTML:"<span class='material-icons' style='font-size:20px;color:var(--text-dim);'>photo_size_select_large</span>"});
    sizeIconLarge.onclick = () => setRowH(currentRowH + SIZE_STEP_PCT);
    sizeBar.appendChild(sizeIconLarge);
    normalBar.appendChild(sizeBar);
    const toggleSelBtn = $("button", {className:"mg-btn", style:"margin-left:4px;", title:"Select", innerHTML:"<span class='material-icons' style='font-size:20px;'>checklist</span>"});
    toggleSelBtn.onclick = () => {
      isSelMode = true;
      selSet.clear();
      updateTopBar();
      render();
    };
    normalBar.appendChild(toggleSelBtn);
    const closeBtn = $("button", {className:"mg-btn", style:"margin-left:auto;", title:"Close", innerHTML:"<span class='material-icons' style='font-size:20px;'>close</span>", onclick:closeGallery});
    headerBarEl.appendChild(closeBtn);
    const batchCount = $("span", {style:"font-weight:600;font-size:12px;font-family:var(--font-ui);"});
    batchBar.appendChild(batchCount);
    const getSelectedItems = () => mediaArr.filter(m => selSet.has(m.id));
    const bTagBtn = $("button", {className:"mg-btn", title:"Tags", innerHTML:"<span class='material-icons' style='font-size:20px;'>sell</span>"});
    bTagBtn.onclick = async () => {
      if(!selSet.size) return;
      await openTagManager(getSelectedItems(), render);
    };
    batchBar.appendChild(bTagBtn);
    const bRateBtn = $("button", {className:"mg-btn", title:"Rate", innerHTML:"<span class='material-icons' style='font-size:20px;'>star_rate</span>"});
    bRateBtn.onclick = async () => {
      if(!selSet.size) return;
      const v = prompt(`Rating for ${selSet.size} item(s) (numeric):`);
      if (v == null) return;
      let rating = Number(v);
      if (isNaN(rating)) rating = 0;
      for (const m of getSelectedItems()) {
        m.rating = rating;
        await kv[pre + activeGalleryName].set(m.id, m);
      }
      selSet.clear(); isSelMode = false; updateTopBar(); loadGallery();
    };
    batchBar.appendChild(bRateBtn);
    const bMovBtn = $("button", {className:"mg-btn", title:"Move", innerHTML:"<span class='material-icons' style='font-size:20px;'>drive_file_move</span>"});
    bMovBtn.onclick = async () => {
      if(!selSet.size) return;
      const t = prompt("Move selected to folder:");
      if(!t || t === activeGalleryName) return;
      for(const id of selSet) {
        let m = mediaArr.find(x=>x.id===id);
        if(m){
          await kv[pre+t].set(id, m);
          await kv[pre+activeGalleryName].delete(id);
        }
      }
      saveGalleryNames([...getGalleryNames(), t]);
      selSet.clear(); isSelMode = false; galDropdown.updateItems(getGalOpts(), activeGalleryName); updateTopBar();
      loadGallery();
    };
    batchBar.appendChild(bMovBtn);
    const bDwnBtn = $("button", {className:"mg-btn", title:"Download", innerHTML:"<span class='material-icons' style='font-size:20px;'>download</span>"});
    bDwnBtn.onclick = async () => {
      if(!selSet.size) return;
      const JSZip = await getJSZip();
      const zip = new JSZip();
      for(const id of selSet) {
        const rec = await blobs.get(id);
        const b = rec?.blob||rec;
        const ext = (b.type.split("/")[1]||"bin").replace(/[^\w.-]/g,'');
        zip.file(`${id}.${ext}`, b);
      }
      const zipBlob = await zip.generateAsync({type:"blob"});
      const a=$("a",{href:URL.createObjectURL(zipBlob),download:`batch_${Date.now()}.zip`});
      a.click();
      selSet.clear(); isSelMode = false; updateTopBar(); render();
    };
    batchBar.appendChild(bDwnBtn);
    const bDelBtn = $("button", {className:"mg-btn", title:"Delete", innerHTML:"<span class='material-icons' style='font-size:20px;color:#cf6679'>delete</span>"});
    bDelBtn.onclick = async () => {
      if(!selSet.size) return;
      if(!confirm(`Delete ${selSet.size} items?`)) return;
      for(const id of selSet) {
        await blobs.delete(id);
        await kv[pre+activeGalleryName].delete(id);
      }
      selSet.clear(); isSelMode = false; updateTopBar(); loadGallery();
    };
    batchBar.appendChild(bDelBtn);
    const bCanBtn = $("button", {style:"margin-left:auto;padding:0 12px;height:26px;background:transparent;border:1px solid var(--border-color);color:var(--text-main);border-radius:var(--radius-sm);font-size:12px;font-family:var(--font-ui);cursor:pointer;", innerHTML:"Cancel"});
    bCanBtn.onclick = () => { isSelMode = false; selSet.clear();
    updateTopBar(); render(); };
    batchBar.appendChild(bCanBtn);
    const updateTopBar = () => {
      if(isSelMode) {
        normalBar.style.display = "none";
        batchBar.style.display = "flex";
        closeBtn.style.display = "none";
        batchCount.innerHTML = `${selSet.size} selected`;
      } else {
        normalBar.style.display = "flex";
        batchBar.style.display = "none";
        closeBtn.style.display = "flex";
      }
    };
    let io;
    const observe=()=>{
      io?.disconnect();
      io=new IntersectionObserver(es => es.forEach(async en => {
        if(en.isIntersecting&&!en.target.dataset.loaded) {
          en.target.dataset.loaded = 1;
          const rec = await blobs.get(en.target.dataset.id);
          const b = rec?.blob||rec;
          if(!b) return;
          if(b.type.startsWith("image/")){
            en.target.appendChild($("img",{src:URL.createObjectURL(b),style:"width:100%;height:100%;object-fit:cover;"}));
          } else if(b.type.startsWith("video/")){
            en.target.appendChild($("video",{src:URL.createObjectURL(b),style:"width:100%;height:100%;object-fit:cover;",muted:true,loop:true,autoplay:true,playsInline:true}));
          } else {
            en.target.appendChild($("div",{style:"width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);", innerHTML:"<span class='material-icons' style='font-size:30px;opacity:0.3;'>audiotrack</span>"}));
          }
        }
      }), {root:grid,rootMargin:"300px"});
      [...grid.children].forEach(c=>io.observe(c));
    };
    const lightbox = id0 => {
      let idx = mediaArr.findIndex(m => m.id===id0);
      const ov = $("div",{dataset:{localMediaGalleryLightbox:1}, style:"position:fixed;inset:0;background:var(--bg-body);color:var(--text-main);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10000;padding:20px;", onclick:e=>e.target===ov&&close()});
      const holder = $("div", {style:"display:flex;align-items:center;justify-content:center;max-width:100%;flex:1;overflow:hidden;pointer-events:none;"});
      const bottomControls = $("div", {style:"display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;margin-top:10px;padding:5px;width:100%;"});
      const onKey = e => {
        if(e.key==="ArrowLeft" && idx>0) { idx--; load(); }
        else if(e.key==="ArrowRight" && idx<mediaArr.length-1) { idx++; load(); }
        else if(e.key==="Escape") close();
      };
      const close = ()=>{ document.removeEventListener("keydown",onKey); ov.remove(); };
      document.addEventListener("keydown", onKey);
      const load = async() => {
        holder.innerHTML = "";
        bottomControls.innerHTML = "";
        const rec = await blobs.get(mediaArr[idx].id);const b=rec?.blob||rec;
        let el;
        if(b.type.startsWith("image/")) el = $("img",{src:URL.createObjectURL(b),style:"max-width:100%;max-height:100%;object-fit:contain;pointer-events:auto;"});
        else if(b.type.startsWith("video/")) el = $("video",{src:URL.createObjectURL(b),style:"max-width:100%;max-height:100%;object-fit:contain;pointer-events:auto;",controls:true,autoplay:true});
        else el = $("audio", {src:URL.createObjectURL(b),controls:true,style:"pointer-events:auto;"});
        holder.appendChild(el);
        const navBar = $("div", {style:"display:flex;align-items:center;justify-content:center;gap:20px;margin-bottom:5px;"});
        const counterText = $("span", {style:"font-size:12px;font-weight:600;color:var(--text-dim);min-width:50px;text-align:center;font-family:var(--font-mono);"}, `${idx + 1} / ${mediaArr.length}`);
        const btnPrev = $("button",{innerHTML:"<span class='material-icons' style='font-size:16px;'>arrow_back_ios_new</span>",className:"mg-btn",style:"background:var(--accent-color);color:#fff;border:none;width:44px;height:32px;border-radius:var(--radius-pill);",onclick:e=>{ e.stopPropagation(); if(idx>0){idx--;load();} }});
        const btnNext = $("button",{innerHTML:"<span class='material-icons' style='font-size:16px;'>arrow_forward_ios</span>",className:"mg-btn",style:"background:var(--accent-color);color:#fff;border:none;width:44px;height:32px;border-radius:var(--radius-pill);",onclick:e=>{ e.stopPropagation(); if(idx<mediaArr.length-1){idx++;load();} }});
        btnPrev.style.opacity = idx===0?0.3:1;
        btnNext.style.opacity = idx===mediaArr.length-1?0.3:1;
        navBar.appendChild(btnPrev);
        navBar.appendChild(counterText);
        navBar.appendChild(btnNext);
        const dummyPh = {remove: () => { close(); render(); }, appendChild: () => {}};
        const actBar = controls(mediaArr[idx], dummyPh);
        actBar.style.position = "static";
        actBar.style.border = "none";
        actBar.style.background = "transparent";
        actBar.style.padding = "0";
        bottomControls.appendChild(navBar);
        bottomControls.appendChild(actBar);
      };
      ov.appendChild(holder);
      ov.appendChild(bottomControls);
      ov.appendChild($("button",{innerHTML:"<span class='material-icons' style='font-size:20px;'>close</span>",className:"mg-btn",style:"position:absolute;top:15px;right:15px;background:var(--bg-elevated);border:1px solid var(--border-color);width:36px;height:36px;",onclick:close}));
      document.body.appendChild(ov);load();
    };
    // Info editor modal — Tags row is read-only here; editing goes through the Tag Manager
    async function openInfoEditor(m){
      const rec = await blobs.get(m.id);
      if(!rec) return;
      const infoOrig = cleanInfo(rec.info||{});
      const origStr = JSON.stringify(infoOrig);
      const overlay=$("div",{id:"info-editor-overlay",className:"modal-overlay active",style:"z-index:10003;"});
      const bg = $("div", {className:"modal-bg"});
      const modal=$("div",{className:"modal-content sm", style:"width:500px;"});
      overlay.appendChild(bg);
      const headerWrap = $("div", {className:"modal-header-wrapper"});
      const head = $("div", {className:"modal-head"});
      head.appendChild($("span", {className:"modal-title", innerHTML:`<span class="modal-title-icon"><span class="material-icons" style="font-size:12px;">info</span></span> File Info`}));
      const headClose = $("div", {className:"modal-close", innerHTML:"<span class='material-icons' style='font-size:14px;'>close</span>"});
      head.appendChild(headClose);
      headerWrap.appendChild(head);
      modal.appendChild(headerWrap);
      const body=$("div",{className:"modal-body"});
      modal.appendChild(body);
      // Tags section
      const tagsSection = $("div", {className:"modal-section"});
      const tagsHead = $("div", {style:"display:flex;align-items:center;justify-content:space-between;gap:8px;"});
      tagsHead.appendChild($("div", {className:"modal-section-title", innerHTML:"<span class='material-icons'>sell</span> Tags"}));
      const editTagsBtn = $("button", {className:"mg-btn", title:"Edit tags", innerHTML:"<span class='material-icons' style='font-size:16px;'>edit</span>"});
      editTagsBtn.onclick = () => { overlay.remove(); openTagManager([m], render); };
      tagsHead.appendChild(editTagsBtn);
      tagsSection.appendChild(tagsHead);
      const tagsValue = $("div", {style:"display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;"});
      if ((m.tags||[]).length) m.tags.forEach(t => tagsValue.appendChild($("span", {className:"am-tag-chip"}, t)));
      else tagsValue.appendChild($("span", {style:"font-family:var(--font-mono);font-size:10px;color:var(--text-dim);"}, "(none)"));
      tagsSection.appendChild(tagsValue);
      body.appendChild(tagsSection);
      const list=$("div",{className:"modal-section", style:"display:flex;flex-direction:column;gap:12px;"});
      body.appendChild(list);
      const rows=[];
      const addRow=(k="",v="")=>{
        const row=$("div",{style:"display:flex;flex-direction:column;gap:6px;background:var(--bg-elevated);padding:10px;border-radius:var(--radius-sm);position:relative;border:1px solid var(--border-color);"});
        const topRow=$("div",{style:"display:flex;justify-content:space-between;align-items:center;"});
        const keyInp=$("input",{className:"input-field",value:k,style:"width:150px;padding:4px 6px;font-size:11px;color:#fff;",placeholder:"Key"});
        const delRow=$("button",{className:"mg-btn",innerHTML:"<span class='material-icons' style='font-size:18px;color:#cf6679'>delete</span>",style:"width:28px;height:28px;flex-shrink:0;margin-left:8px;"});
        delRow.onclick = () => row.remove();
        topRow.appendChild(keyInp);
        topRow.appendChild(delRow);
        const valArea=$("textarea",{className:"input-field",value:v,style:"flex:0 0 auto;min-height:40px;resize:vertical;overflow:hidden;color:#fff;",placeholder:"Value"});
        const autoExpand = () => {
          valArea.style.height = 'auto';
          valArea.style.height = (valArea.scrollHeight) + 'px';
        };
        valArea.oninput = autoExpand;
        setTimeout(autoExpand, 10);
        row.appendChild(topRow);
        row.appendChild(valArea);
        rows.push({keyInp,valArea,row});
        list.appendChild(row);
      };
      for(const [k,v] of Object.entries(infoOrig)) addRow(k,v);
      const plusBtn=$("button",{innerHTML:"+ Add Field",style:"align-self:flex-start;background:transparent;border:none;color:var(--accent-color);cursor:pointer;font-size:12px;font-family:var(--font-ui);padding:4px 0;",onclick:()=>addRow("","")});
      body.appendChild(plusBtn);
      const gather=()=>{
        const o = {};
        rows.forEach(({keyInp,valArea,row}) => {
          if(!row.parentNode) return;
          const k = keyInp.value.trim();
          if(k) o[k] = String(valArea.value);
        });
        return o;
      };
      const acts = $("div",{className:"modal-action-row", style:"margin-top:0;border-top:1px solid var(--border-color);padding-top:14px;"});
      const copyBtn=$("button",{className:"modal-action-btn-secondary", innerHTML:"Copy Prompt", style:"flex:0 1 auto;margin-right:auto;"});
      const cancelBtn=$("button",{className:"modal-action-btn-secondary", innerHTML:"Cancel"});
      const saveBtn=$("button",{className:"am-btn-primary", innerHTML:"Save", style:"flex:1;"});
      acts.appendChild(copyBtn); acts.appendChild(cancelBtn); acts.appendChild(saveBtn);
      body.appendChild(acts);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      const maybeClose = () => {
        if(JSON.stringify(gather()) !== origStr){
          if(!confirm("Discard changes?")) return false;
        }
        overlay.remove();
        return true;
      };
      bg.addEventListener("mousedown", e => { if(e.target===bg) maybeClose(); });
      headClose.onclick=e=>{e.stopPropagation();maybeClose();};
      cancelBtn.onclick=e=>{e.stopPropagation();maybeClose();};
      copyBtn.onclick = e => {
        e.stopPropagation();
        const o = gather();
        let text = o.prompt || "";
        const extras = ["negativePrompt", "seed", "guidanceScale"];
        for (const k of extras) {
          if (o[k] !== undefined && o[k] !== "") {
            text += ` (${k}:::${o[k]})`;
          }
        }
        navigator.clipboard.writeText(text).then(() => {
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = "Copied!";
          setTimeout(() => { copyBtn.innerHTML = orig; }, 1500);
        });
      };
      saveBtn.onclick=async e=>{
        let activeRows = rows.filter(r=>r.row.parentNode);
        let keys = activeRows.map(({keyInp}) => keyInp.value.trim()).filter(k => k);
        if(keys.length !== new Set(keys).size) return alert("Keys must be unique.");
        e.stopPropagation();
        const newInfo = gather();
        await blobs.set(m.id,{blob:rec.blob||rec,info:newInfo});
        promptCache.set(m.id, String(newInfo.prompt || "").toLowerCase());
        overlay.remove();
      };
    }
    const controls = (m, ph) => {
      const bar = $("div", {className:"mg-card-bar"});
      bar.appendChild($("button", {className:"mg-btn", title:"Rate", innerHTML:"<span class='material-icons' style='font-size:18px;'>star_rate</span>", onclick:async e => {
        e.stopPropagation();
        const v = prompt("Rating (numeric):", m.rating);
        if (v == null) return;
        m.rating = Number(v);
        if (isNaN(m.rating)) m.rating = 0;
        await kv[pre + activeGalleryName].set(m.id, m);
        render();
      }}));
      bar.appendChild($("button", {className:"mg-btn", title:"Tags", innerHTML:"<span class='material-icons' style='font-size:18px;'>sell</span>", onclick:async e => {
        e.stopPropagation();
        await openTagManager([m], render);
      }}));
      bar.appendChild($("button", {className:"mg-btn", title:"Edit Info", innerHTML:"<span class='material-icons' style='font-size:18px;'>info</span>", onclick:async e => {
        e.stopPropagation();
        openInfoEditor(m);
      }}));
      bar.appendChild($("button", {className:"mg-btn", title:"Move", innerHTML:"<span class='material-icons' style='font-size:18px;'>drive_file_move</span>", onclick:async e => {
        e.stopPropagation();
        const t = prompt("Move to folder:");
        if (!t || t === activeGalleryName) return;
        await kv[pre + t].set(m.id, m);
        await kv[pre + activeGalleryName].delete(m.id);
        saveGalleryNames([...getGalleryNames(), t]);
        galDropdown.updateItems(getGalOpts(), activeGalleryName);
        loadGallery();
        if (document.querySelector("[data-local-media-gallery-lightbox]")) ph.remove();
      }}));
      bar.appendChild($("button", {className:"mg-btn", title:"Download", innerHTML:"<span class='material-icons' style='font-size:18px;'>download</span>", onclick:async e => {
        e.stopPropagation();
        const rec = await blobs.get(m.id);
        const b = rec?.blob || rec;
        const a = $("a", {href:URL.createObjectURL(b), download:`${m.id}.${(b.type.split("/")[1] || "bin")}`});
        a.click();
      }}));
      bar.appendChild($("button", {className:"mg-btn", title:"Delete", innerHTML:"<span class='material-icons' style='font-size:18px;color:#cf6679'>delete</span>", onclick:async e => {
        e.stopPropagation();
        if (!confirm("Delete?")) return;
        await blobs.delete(m.id);
        await kv[pre + activeGalleryName].delete(m.id);
        mediaArr = mediaArr.filter(x => x.id !== m.id);
        ph.remove();
      }}));
      // Tag indicator badge (top left), only shown when the item has tags
      if ((m.tags||[]).length){
        const tagBadge = $("div", {className:"mg-badge", title:m.tags.join(", ")});
        tagBadge.innerHTML = `<span class='material-icons' style='font-size:14px;color:#64b5f6;'>sell</span><span style='font-size:11px;color:var(--text-main);'>${m.tags.length}</span>`;
        ph.appendChild(tagBadge);
      }
      return bar;
    };
    const sortFn=()=>{
      switch(currentSort){
        case"dateAsc":    return (a,b) => a.date-b.date;
        case"ratingDesc": return (a,b) => b.rating-a.rating;
        case"ratingAsc":  return (a,b) => a.rating-b.rating;
        default:          return (a,b) => b.date-a.date;
      }
    };
    const render = () => {
      grid.innerHTML = "";
      mediaArr.sort(sortFn());
      const q = searchQuery.trim().toLowerCase();
      let visibleArr = q ? mediaArr.filter(m => {
		const tagMatch = (m.tags||[]).some(t => t.toLowerCase().includes(q));
		const promptMatch = (promptCache.get(m.id)||"").includes(q);
		if (searchMode === "tags") return tagMatch;
		if (searchMode === "prompt") return promptMatch;
		return tagMatch || promptMatch;
	  }) : mediaArr;
      if (filterTags.size) {
        const wanted = [...filterTags];
        visibleArr = visibleArr.filter(m => {
          const tags = m.tags || [];
          return filterMode === "and" ? wanted.every(t => tags.includes(t)) : wanted.some(t => tags.includes(t));
        });
      }
      visibleArr.forEach(m => {
        let w = m.w ? (m.w / m.h) * currentRowH : currentRowH;
        if (isMobile) w = Math.min(w, window.innerWidth - 40);
        const ph = $("div", {className:"mg-card", dataset:{id:m.id}, style:`flex:0 0 ${w}px;height:${currentRowH}px;background:var(--bg-elevated);position:relative;overflow:hidden;cursor:pointer;border-radius:var(--radius-sm);`});
        if (!isSelMode) {
          ph.onclick = () => lightbox(m.id);
          ph.appendChild(controls(m, ph));
        } else {
          const selOverlay = $("div", {className:"mg-sel-card", innerHTML: selSet.has(m.id) ? "<span class='material-icons' style='font-size:40px;color:var(--accent-color);'>check_circle</span>" : ""});
          if (selSet.has(m.id)) {
            selOverlay.style.background = "rgba(0,0,0,0.8)";
            selOverlay.style.borderWidth = "2px";
          }
          ph.appendChild(selOverlay);
          ph.onclick = () => {
            if (selSet.has(m.id)) selSet.delete(m.id);
            else selSet.add(m.id);
            updateTopBar();
            render();
          };
        }
        grid.appendChild(ph);
      });
      observe();
    };
    const loadGallery = async()=>{
      mediaArr=await kv[pre+activeGalleryName].values();
      await ensurePromptCache();
      render();
    };
    loadGallery();
  }
  return {add,show,getActiveFolderName:()=>activeGalleryName,clearAllData};