// === css-style-plugin ===
// cssStyle = {import:css-style-plugin}

injectStyles() =>
  if (document.getElementById('css-style-plugin-injected')) return '';
  let css = '*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}:root{--csp-bg:#0f1117;--csp-bg-alt:#1a1d27;--csp-surface:#21252f;--csp-surface-hover:#2a2f3b;--csp-border:#363b48;--csp-text:#e4e6eb;--csp-text-dim:#9ba1ad;--csp-text-faint:#6b7180;--csp-primary:#6c8cff;--csp-primary-hover:#8aa3ff;--csp-primary-dim:#3a4d80;--csp-accent:#c08cff;--csp-success:#5dd39e;--csp-warning:#ffc857;--csp-danger:#ff6b6b;' +
    '--csp-info:#5ec8ff;--csp-font:\'Segoe UI\',system-ui,-apple-system,Roboto,sans-serif;--csp-font-mono:\'Cascadia Code\',\'SF Mono\',Consolas,monospace;--csp-fs-xs:0.75rem;--csp-fs-sm:0.875rem;--csp-fs-base:1rem;--csp-fs-lg:1.25rem;--csp-fs-xl:1.5rem;--csp-fs-2xl:2rem;--csp-fs-3xl:2.75rem;--csp-lh:1.6;--csp-sp-1:0.25rem;--csp-sp-2:0.5rem;--csp-sp-3:0.75rem;--csp-sp-4:1rem;--csp-sp-5:1.5rem;--csp-sp-6:2rem;' +
    '--csp-sp-7:3rem;--csp-radius:8px;--csp-radius-sm:4px;--csp-radius-lg:14px;--csp-radius-full:9999px;--csp-shadow-sm:0 1px 2px rgba(0,0,0,.2);--csp-shadow:0 4px 12px rgba(0,0,0,.3);--csp-shadow-lg:0 12px 40px rgba(0,0,0,.4);--csp-t:0.18s ease;--csp-t-slow:0.35s ease;--csp-max-w:960px}[data-csp-theme="light"]{--csp-bg:#f6f7f9;--csp-bg-alt:#eceef2;--csp-surface:#ffffff;--csp-surface-hover:#f0f2f5;--csp-border:#d4d8e0;' +
    '--csp-text:#1a1d24;--csp-text-dim:#5a6172;--csp-text-faint:#9298a8;--csp-primary:#4a63d8;--csp-primary-hover:#3a52c0;--csp-primary-dim:#c8d4f8;--csp-shadow-sm:0 1px 2px rgba(0,0,0,.06);--csp-shadow:0 4px 12px rgba(0,0,0,.1);--csp-shadow-lg:0 12px 40px rgba(0,0,0,.15)}[data-csp]{font-family:var(--csp-font);font-size:var(--csp-fs-base);line-height:var(--csp-lh);color:var(--csp-text)}img{max-width:100%;' +
    'display:block}a{color:var(--csp-primary);text-decoration:none;transition:color var(--csp-t)}a:hover{color:var(--csp-primary-hover)}button,input,select,textarea{font:inherit;color:inherit}ul,ol{padding-left:var(--csp-sp-5)}code,pre{font-family:var(--csp-font-mono)}.csp-container{width:100%;max-width:var(--csp-max-w);margin-inline:auto;padding-inline:var(--csp-sp-4)}.csp-flex{display:flex}.csp-flex-col{flex-direction:column}' +
    '.csp-flex-wrap{flex-wrap:wrap}.csp-items-center{align-items:center}.csp-items-start{align-items:flex-start}.csp-justify-center{justify-content:center}.csp-justify-between{justify-content:space-between}.csp-gap-1{gap:var(--csp-sp-1)}.csp-gap-2{gap:var(--csp-sp-2)}.csp-gap-3{gap:var(--csp-sp-3)}.csp-gap-4{gap:var(--csp-sp-4)}.csp-gap-5{gap:var(--csp-sp-5)}.csp-grid{display:grid;gap:var(--csp-sp-4)}.csp-grid-2{grid-template-columns:repeat(2,1fr)}' +
    '.csp-grid-3{grid-template-columns:repeat(3,1fr)}.csp-grid-auto{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}.csp-hidden{display:none !important}.csp-full-w{width:100%}.csp-text-center{text-align:center}.csp-text-left{text-align:left}.csp-text-right{text-align:right}.csp-mt-1{margin-top:var(--csp-sp-1)}.csp-mt-2{margin-top:var(--csp-sp-2)}.csp-mt-3{margin-top:var(--csp-sp-3)}.csp-mt-4{margin-top:var(--csp-sp-4)}' +
    '.csp-mt-5{margin-top:var(--csp-sp-5)}.csp-mt-6{margin-top:var(--csp-sp-6)}.csp-mb-1{margin-bottom:var(--csp-sp-1)}.csp-mb-2{margin-bottom:var(--csp-sp-2)}.csp-mb-3{margin-bottom:var(--csp-sp-3)}.csp-mb-4{margin-bottom:var(--csp-sp-4)}.csp-mb-5{margin-bottom:var(--csp-sp-5)}.csp-mb-6{margin-bottom:var(--csp-sp-6)}.csp-p-2{padding:var(--csp-sp-2)}.csp-p-3{padding:var(--csp-sp-3)}.csp-p-4{padding:var(--csp-sp-4)}' +
    '.csp-p-5{padding:var(--csp-sp-5)}.csp-py-4{padding-block:var(--csp-sp-4)}.csp-py-6{padding-block:var(--csp-sp-6)}.csp-px-4{padding-inline:var(--csp-sp-4)}.csp-h1{font-size:var(--csp-fs-3xl);font-weight:800;line-height:1.15}.csp-h2{font-size:var(--csp-fs-2xl);font-weight:700;line-height:1.2}.csp-h3{font-size:var(--csp-fs-xl);font-weight:600}.csp-h4{font-size:var(--csp-fs-lg);font-weight:600}.csp-lead{font-size:var(--csp-fs-lg);' +
    'color:var(--csp-text-dim)}.csp-dim{color:var(--csp-text-dim)}.csp-faint{color:var(--csp-text-faint)}.csp-mono{font-family:var(--csp-font-mono)}.csp-xs{font-size:var(--csp-fs-xs)}.csp-sm{font-size:var(--csp-fs-sm)}.csp-lg{font-size:var(--csp-fs-lg)}.csp-bold{font-weight:700}.csp-italic{font-style:italic}.csp-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--csp-sp-2);padding:var(--csp-sp-2) var(--csp-sp-5);' +
    'border:1px solid var(--csp-border);border-radius:var(--csp-radius);background:var(--csp-surface);color:var(--csp-text);font-weight:600;font-size:var(--csp-fs-sm);cursor:pointer;user-select:none;transition:all var(--csp-t);white-space:nowrap}.csp-btn:hover{background:var(--csp-surface-hover);border-color:var(--csp-primary-dim)}.csp-btn:active{transform:translateY(1px)}.csp-btn:disabled{opacity:0.5;cursor:not-allowed}' +
    '.csp-btn-primary{background:var(--csp-primary);border-color:var(--csp-primary);color:#fff}.csp-btn-primary:hover{background:var(--csp-primary-hover);border-color:var(--csp-primary-hover)}.csp-btn-success{background:var(--csp-success);border-color:var(--csp-success);color:#0a2e1c}.csp-btn-warning{background:var(--csp-warning);border-color:var(--csp-warning);color:#3a2c00}.csp-btn-danger{background:var(--csp-danger);' +
    'border-color:var(--csp-danger);color:#fff}.csp-btn-ghost{background:transparent;border-color:transparent}.csp-btn-ghost:hover{background:var(--csp-surface-hover)}.csp-btn-sm{padding:var(--csp-sp-1) var(--csp-sp-3);font-size:var(--csp-fs-xs)}.csp-btn-lg{padding:var(--csp-sp-3) var(--csp-sp-6);font-size:var(--csp-fs-lg)}.csp-btn-block{display:flex;width:100%}.csp-btn-group{display:inline-flex}.csp-btn-group .csp-btn{border-radius:0}' +
    '.csp-btn-group .csp-btn:first-child{border-radius:var(--csp-radius) 0 0 var(--csp-radius)}.csp-btn-group .csp-btn:last-child{border-radius:0 var(--csp-radius) var(--csp-radius) 0}.csp-btn-group .csp-btn:not(:last-child){border-right:none}.csp-card{background:var(--csp-surface);border:1px solid var(--csp-border);border-radius:var(--csp-radius);padding:var(--csp-sp-5);box-shadow:var(--csp-shadow-sm);' +
    'transition:border-color var(--csp-t),box-shadow var(--csp-t)}.csp-card-hover:hover{border-color:var(--csp-primary-dim);box-shadow:var(--csp-shadow)}.csp-card-flush{padding:0;overflow:hidden}.csp-card-header{padding:var(--csp-sp-4) var(--csp-sp-5);border-bottom:1px solid var(--csp-border);font-weight:700}.csp-card-body{padding:var(--csp-sp-5)}.csp-card-footer{padding:var(--csp-sp-3) var(--csp-sp-5);' +
    'border-top:1px solid var(--csp-border);color:var(--csp-text-dim);font-size:var(--csp-fs-sm)}.csp-input,.csp-select,.csp-textarea{width:100%;padding:var(--csp-sp-2) var(--csp-sp-3);background:var(--csp-bg-alt);border:1px solid var(--csp-border);border-radius:var(--csp-radius-sm);color:var(--csp-text);transition:border-color var(--csp-t),box-shadow var(--csp-t)}.csp-input:focus,.csp-select:focus,.csp-textarea:focus{outline:none;' +
    'border-color:var(--csp-primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--csp-primary) 25%,transparent)}.csp-input::placeholder{color:var(--csp-text-faint)}.csp-textarea{resize:vertical;min-height:80px}.csp-label{display:block;margin-bottom:var(--csp-sp-1);font-size:var(--csp-fs-sm);font-weight:600;color:var(--csp-text-dim)}.csp-field{margin-bottom:var(--csp-sp-4)}.csp-checkbox{width:auto;accent-color:var(--csp-primary)}' +
    '.csp-fieldset{border:1px solid var(--csp-border);border-radius:var(--csp-radius);padding:var(--csp-sp-4)}.csp-switch{position:relative;width:44px;height:24px}.csp-switch input{opacity:0;width:0;height:0}.csp-switch-slider{position:absolute;inset:0;background:var(--csp-border);border-radius:var(--csp-radius-full);cursor:pointer;transition:var(--csp-t)}.csp-switch-slider::before{content:"";position:absolute;' +
    'width:18px;height:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:var(--csp-t)}.csp-switch input:checked + .csp-switch-slider{background:var(--csp-primary)}.csp-switch input:checked + .csp-switch-slider::before{transform:translateX(20px)}.csp-badge{display:inline-flex;align-items:center;padding:2px var(--csp-sp-2);background:var(--csp-surface-hover);border:1px solid var(--csp-border);' +
    'border-radius:var(--csp-radius-full);font-size:var(--csp-fs-xs);font-weight:600;color:var(--csp-text-dim)}.csp-badge-primary{background:var(--csp-primary-dim);border-color:var(--csp-primary);color:var(--csp-primary-hover)}.csp-badge-success{background:color-mix(in srgb,var(--csp-success) 18%,transparent);border-color:var(--csp-success);color:var(--csp-success)}.csp-badge-warning{background:color-mix(in srgb,var(--csp-warning) 18%,transparent);' +
    'border-color:var(--csp-warning);color:var(--csp-warning)}.csp-badge-danger{background:color-mix(in srgb,var(--csp-danger) 18%,transparent);border-color:var(--csp-danger);color:var(--csp-danger)}.csp-badge-info{background:color-mix(in srgb,var(--csp-info) 18%,transparent);border-color:var(--csp-info);color:var(--csp-info)}.csp-tag{display:inline-block;padding:var(--csp-sp-1) var(--csp-sp-3);background:var(--csp-bg-alt);' +
    'border:1px solid var(--csp-border);border-radius:var(--csp-radius-sm);font-size:var(--csp-fs-sm)}.csp-alert{display:flex;gap:var(--csp-sp-3);align-items:flex-start;padding:var(--csp-sp-4);border:1px solid var(--csp-border);border-left-width:4px;border-radius:var(--csp-radius);background:var(--csp-surface);overflow:auto}.csp-alert-info{border-left-color:var(--csp-info)}.csp-alert-success{border-left-color:var(--csp-success)}' +
    '.csp-alert-warning{border-left-color:var(--csp-warning)}.csp-alert-danger{border-left-color:var(--csp-danger)}.csp-progress{height:8px;background:var(--csp-bg-alt);border-radius:var(--csp-radius-full);overflow:hidden}.csp-progress-bar{height:100%;background:var(--csp-primary);border-radius:var(--csp-radius-full);transition:width var(--csp-t-slow)}.csp-spinner{width:28px;height:28px;border:3px solid var(--csp-border);' +
    'border-top-color:var(--csp-primary);border-radius:50%;animation:csp-spin 0.7s linear infinite}@keyframes csp-spin{to{transform:rotate(360deg)}}.csp-divider{border:none;border-top:1px solid var(--csp-border);margin:var(--csp-sp-5) 0}.csp-modal-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);padding:var(--csp-sp-4);backdrop-filter:blur(2px)}' +
    '.csp-modal{background:var(--csp-surface);border:1px solid var(--csp-border);border-radius:var(--csp-radius-lg);box-shadow:var(--csp-shadow-lg);max-width:520px;width:100%;max-height:85vh;overflow:auto}.csp-tabs{display:flex;gap:0;border-bottom:2px solid var(--csp-border)}.csp-tab{padding:var(--csp-sp-2) var(--csp-sp-4);background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-2px;' +
    'cursor:pointer;color:var(--csp-text-dim);font-weight:600;font-size:var(--csp-fs-sm);transition:all var(--csp-t)}.csp-tab:hover{color:var(--csp-text)}.csp-tab.csp-active{color:var(--csp-primary);border-bottom-color:var(--csp-primary)}.csp-table{width:100%;border-collapse:collapse}.csp-table th,.csp-table td{padding:var(--csp-sp-2) var(--csp-sp-3);text-align:left;border-bottom:1px solid var(--csp-border)}' +
    '.csp-table th{font-weight:700;color:var(--csp-text-dim);font-size:var(--csp-fs-sm)}.csp-table tbody tr:hover{background:var(--csp-surface-hover)}.csp-tooltip{position:relative}.csp-tooltip::after{content:attr(data-csp-tip);position:absolute;bottom:100%;left:50%;transform:translateX(-50%) translateY(-4px);background:var(--csp-text);color:var(--csp-bg);padding:4px var(--csp-sp-2);border-radius:var(--csp-radius-sm);' +
    'font-size:var(--csp-fs-xs);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity var(--csp-t)}.csp-tooltip:hover::after{opacity:1}.csp-fade-in{animation:csp-fade-in var(--csp-t-slow) ease}.csp-slide-up{animation:csp-slide-up var(--csp-t-slow) ease}@keyframes csp-fade-in{from{opacity:0}to{opacity:1}}@keyframes csp-slide-up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}' +
    '}.csp-scroll::-webkit-scrollbar{width:8px}.csp-scroll::-webkit-scrollbar-track{background:var(--csp-bg-alt)}.csp-scroll::-webkit-scrollbar-thumb{background:var(--csp-border);border-radius:var(--csp-radius-full)}.csp-scroll::-webkit-scrollbar-thumb:hover{background:var(--csp-text-faint)}@media (max-width:768px){.csp-grid-2,.csp-grid-3{grid-template-columns:1fr}.csp-grid-auto{grid-template-columns:1fr}' +
    '.csp-h1{font-size:var(--csp-fs-2xl)}.csp-flex-res{flex-direction:column}}';
  let el = document.createElement('style');
  el.id = 'css-style-plugin-injected';
  el.textContent = css;
  document.head.appendChild(el);
  return '';

cssStyle = [injectStyles]
