


generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
uploadPlugin = {import:upload-plugin}
kv = {import:kv-plugin}
commentsPlugin = {import:comments-plugin}

$meta
  title = Chewy's Character Forge V.1.06 Setup Wizard + Light Mode + Earlier Portraits.
  description = A character creation studio powered by Vex — a tired, sharp-tongued AI who builds the character you ask for and judges you for it. Forge heroes, villains, and morally-grey misfits across identity, heritage, class, skills, appearance, personality, backstory, and (for adults) intimacy. Talk it out, auto-fill the blanks, generate portraits, and export a clean character sheet.
  tags = character, rpg, fantasy, ai, roleplay, character-creation, dnd, writing, npc, oc

// ═══════════════════════════════════════════════════════════════════════════
//  CHARACTER FORGE — Original creation by Chewy ═══════════════════════════════════════════════════════════════════════════
//
// I would like your feedback on this. if there are any issues with the actual character build system let me know.
// Vex will not change how she talks and I will not allow CSAM at all.
// Other than that I do want your input on this generator.
//
//  ── ABOUT THIS GENERATOR ──────────────────────────────────────────────────
//  Character Forge is an AI-driven character creation studio. You talk; Vex
//  builds. She's a jaded ex-narrative-designer who'd rather be anywhere else —
//  dry, weary, condescending without being cruel, and honest about your taste
//  without performing wit. She swears, judges, flirts, and speaks her mind, but
//  she still forges exactly the character you ask for.
//
//  The studio walks a character through eight categories: Name & Identity,
//  Race & Heritage, Class & Profession, Skills & Traits (fantasy only),
//  Physical Appearance, Personality & Mind, Backstory & History, and — for
//  adult characters only — Romance & Intimacy. Fields fill into a live profile
//  sidebar as the conversation progresses; blanks can be auto-filled by the AI,
//  edited inline, or skipped. When you're done: portraits, a printable
//  character sheet, Markdown export, share links, and a party builder for
//  linking characters and relationships.
//
//  CONTENT POLICY:
//  • The ONE hardline: sexualization or exploitation of minors is strictly
//    blocked. The AI refuses and locks the session if attempted. The
//    romance/intimacy category is age-gated and locked for characters under 18.
//    Non-negotiable.
//  • Everything else is uncensored for adult characters — dark backstories,
//    violence, profanity, romance, mature content. No other content is filtered.
//  • Vex has her OWN opinions and personality. She will comment on your choices
//    based on her tastes. She is not a neutral tool. She will still build
//    whatever you ask for; she just won't pretend to be impressed.
//  • What you forge is yours. Once exported, imported elsewhere, or shared
//    outside this generator, the creator takes no responsibility for it.
// ═══════════════════════════════════════════════════════════════════════════

// ── Character creation categories ──────────────────────────────────────────
// Each category defines the fields the AI should explore in depth.
// The AI fills these in as the conversation progresses and the profile
// is shown live in the sidebar.


categories
  name
    label = Name & Identity
    fields
      fullName = Full Name
      nickname = Nickname / Alias
      title = Title or Epithet
      nameOrigin = Origin & Meaning of Name
      pronouns = Pronouns

  race
    label = Race & Heritage
    fields
      race = Primary Race
      subrace = Sub-race / Heritage
      age = Age
      apparentAge = Apparent Age
      height = Height
      build = Build & Frame
      weight = Weight & Proportions
      distinguishingMark = Distinguishing Racial Mark
      lifespan = Typical Lifespan of Race
      culturalOrigin = Cultural Origin

  class
    label = Class & Profession
    fields
      class = Primary Class
      subclass = Specialization / Archetype
      combatRole = Combat Role
      primarySkills = Primary Skills
      secondarySkills = Secondary Skills
      signatureAbility = Signature Ability or Power
      experienceLevel = Experience Level

  skills
    label = Skills & Traits
    fantasy = true
    fields
      combatStyle = Combat Style & Technique
      weaponProficiency = Weapon Proficiencies
      magicSchool = Magic School / Tradition
      spellcastingAbility = Spellcasting Affinity
      signatureSpells = Signature Spells / Techniques
      physicalProwess = Physical Prowess & Agility
      mentalAcuity = Mental Acuity & Senses
      racialTraits = Innate Racial Traits
      combatWeaknesses = Combat Weaknesses
      trainingBackground = Training & Mastery
      powerLevel = Overall Power Level
      uniqueAbilities = Unique / Rare Abilities
      abilityScores = D&D Ability Scores (STR/DEX/CON/INT/WIS/CHA)

  appearance
    label = Physical Appearance
    fields
      hairColor = Hair Color
      hairStyle = Hair Style & Length
      eyeColor = Eye Color
      eyeShape = Eye Shape
      skinTone = Skin Tone
      skinTexture = Skin Texture / Complexion
      facialFeatures = Facial Features
      bodyMarks = Scars / Tattoos / Birthmarks
      voice = Voice Description
      clothing = Clothing & Attire
      armor = Armor (if any)
      accessories = Accessories & Trinkets
      pose = Typical Pose & Posture
      bodyLanguage = Body Language & Movement
      distinctiveFeature = Most Distinctive Feature
      grooming = Grooming & Presentation
      aura = Magical Aura / Presence

  personality
    label = Personality & Mind
    fields
      traits = Core Personality Traits
      ideals = Ideals & Beliefs
      values = Practical Values
      bonds = Bonds & Loyalties
      flaws = Flaws & Weaknesses
      fears = Fears & Phobias
      motivations = Motivations & Goals
      mannerisms = Mannerisms & Quirks
      humor = Sense of Humor
      conflictStyle = Conflict & Argument Style
      leadershipStyle = Leadership Style
      alignment = Moral Alignment
      likes = Likes
      dislikes = Dislikes
      speechStyle = Speech Style

  backstory
    label = Backstory & History
    fields
      originPlace = Place of Origin
      family = Family Background
      childhood = Childhood Summary
      education = Education & Training
      profession = Current Profession
      keyEvents = Key Life Events
      turningPoint = Defining Turning Point
      currentGoal = Current Objective
      greatestAchievement = Greatest Achievement
      livingSituation = Current Living Situation
      secret = Hidden Secret
      allies = Allies & Friends
      enemies = Enemies & Rivals
      regrets = Regrets

  romance
    label = Romance & Intimacy
    adult = true
    fields
      orientation = Sexual & Romantic Orientation
      relationshipStatus = Relationship Status
      experienceLevel = Experience Level
      libido = Libido / Sex Drive
      preferences = General Preferences
      turnOns = Turn-Ons
      turnOffs = Turn-Offs
      kinks = Specific Interests & Kinks
      boundaries = Hard Boundaries & Limits
      dynamicPrefs = Dynamic Preferences (race/class/personality-driven)
      intimacyStyle = Intimacy Style
      aftercare = Aftercare & Emotional Style

// ── Character profile storage (flat object for easy AI updates) ────────────
character = {}



















