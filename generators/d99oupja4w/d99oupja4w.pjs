buildWord() => 
  {
    wrd = "";
    mx = Math.floor((Math.random() * 7) + 3);
    let i = 0;
    while (i < mx) {
      wrd+=[getLetter]; // Outputs numbers 0 to 4
      i++;
    }
    return wrd;
  }
words
  [buildWord()]
gibberish
  [words.selectMany(getRand()).joinItems(" ")]
