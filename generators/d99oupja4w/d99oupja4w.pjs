oilPainters
  El Greco
    prompt = (by El Greco, sharp elongated features, dramatic lighting with deep shadows, intense expression, vibrant and moody colors, swirling expressive background, oil on canvas, highly detailed, expressive brushstrokes)
    negative = ""
  Caravaggio
    prompt = (by Caravaggio, dramatic chiaroscuro, intense spotlighting from the side, deep, thick shadows, emotional expression, detailed textures, baroque style, 17th-century masterpiece)
    negative = ""
  Leonardo da Vinci
    prompt = (by Leonardo da Vinci, Soft sfumato technique, subtle transitions between colors, deep chiaroscuro lighting. Muted earthy oil paint palette (sienna, ochre, umber), meticulous details on fabric, aged canvas texture, realistic human expressions, mysterious atmosphere, masterpiece, 15th-century renaissance painting)
    negative = ""
  Michelangelo
    prompt = (in the style of Michelangelo, Rich, vibrant colors with deep blues, fiery reds, and luminous golds. Intricate anatomical details, high emotional intensity, painted fresco texture, high renaissance, Fresco, Mannerism, Tenebrism)
    negative = ""
  Raphael
    prompt = (Raphael style, soft, gentle lighting, serene expression, tender atmosphere, harmonious, rich velvet clothing, delicate sfumato, cinematic depth, 16th-century painting.)
    negative = ""
  Titian
    prompt = (by Titian, Oil on canvas, impasto, sfumato, glazing, rich color palette, Dramatic lighting, chiaroscuro, emotive, luxurious.)
    negative = ""
  Rembrandt
    prompt = (dramatic Rembrandt chiaroscuro, intense light beams from a side window illuminating dust, warm golden tones, brown and amber palette, detailed textures, baroque style, 10-bit color grade, moody atmosphere, painterly realism, thick impasto texture, ultra-realistic oil painting)
    negative = ""
  Vermeer
    prompt = (by Vermeer, 17th-century Dutch Master style, softly blended, fine oil painting, natural light, chiaroscuro, luminous depth, painters: Johannes Vermeer)
    negative = ""
  Rubens
    prompt = (Peter Paul Rubens painting. Energetic, dynamic composition with strong emotional tension, Dramatic chiaroscuro lighting, deep vibrant colors, thick textured brushstrokes, 17th-century Flemish baroque masterpiece. dramatic, painterly, baroque lighting)
    negative = ""
  Velázquez
    prompt = (in the distinct style of Diego Velázquez. Rich, muted color palette with deep browns, blacks, and touches of crimson. Masterful chiaroscuro, soft light from a single source. Detailed, intricate textures, but with loose, impressionistic brushstrokes on the dark background. 17th-century Baroque realism, regal and enigmatic, masterpiece.)
    negative = ""
  Goya
    prompt = (Francisco Goya style, dark and gloomy, Spanish romanticism, painterly, impasto brushstrokes, chiaroscuro, earthy tones, emotive. Oil on canvas, dramatic lighting, textured, sombre, haunting, expressive.)
    negative = ""
  Delacroix
    prompt = (in the style of Eugène Delacroix, characterized by expressive, energetic brushwork, rich color palette with dramatic reds and blues, dramatic Chiaroscuro lighting, chaotic atmosphere, high emotion, Romanticism, thick impasto painting)
    negative = ""
  Manet
    prompt = (By Édouard Manet, Alla prima, bold brushstrokes, impasto, flat color planes. Strong chiaroscuro, high contrast, moody, theatrical lighting. Modern life, cafes, portraits, bold realism.)
    negative = ""
  Monet
    prompt = (Impressionism, Impressionist oil painting, Claude Monet style. Short, broken strokes, thick impasto, painterly, loose and rapid. Shimmering light, color vibration, diffused light, soft shadows, golden hour. Pastel palette, lavender, soft pinks, light blue, cream, vibrant.)
    negative = ""
  Renoir
    prompt = (Renoir impressionism style, soft focus, detailed creamy brushwork, warm tones, luminous skin tones, lively atmosphere)
    negative = ""
  Degas
    prompt = (impressionist painting in the style of Edgar Degas, Pastel drawing, impressionism, charcoal sketch, oil on canvas, Degas-esque. candid moments, Asymmetrical, high angle, cropped figures, candid perspective. Soft light, backlighting, muted tones, intense pastels, light-and-shadow. chiaroscuro.)
    negative = ""
  Cézanne
    prompt = (in the style of Paul Cézanne, post-impressionism, oil on canvas, structural, geometric forms, muted earth tones mixed with vibrant blues and ochre, textured thick brushstrokes, masterful composition,.)
    negative = ""
  Gauguin
    prompt = (in the style of Paul Gauguin, Post-Impressionism, Tahiti period, flat areas of intense color, thick black outlines, expressive brushstrokes, warm color palette, rustic texture, artistic, masterpiece.)
    negative = ""
  Van Gogh
    prompt = (painted in the style of Van Gogh, thick swirling paint, vibrant yellow and deep blue contrasts, expressive brushwork, post-impressionist art)
    negative = ""
  Seurat
    prompt = (in the style of Georges Seurat, pointillism technique, thousands of tiny, precise dots of vibrant color making up the scene, long shadows, luminous light, Neo-Impressionism, high artistic detail, calm atmosphere.)
    negative = ""
  Toulouse-Lautrec
    prompt = (in the style of Toulouse-Lautrec, bold linework, sketchy painterly style, muted greens and blues, dramatic lighting, moody and expressive, high contrast.)
    negative = ""
  Matisse
    prompt = (A vibrant painting in the style of Henri Matisse, bold outlines, flat, deep red, blue, and green color palette, joyful and expressive movement, Fauvist aesthetic, rhythmic flowing lines, masterpiece.)
    negative = ""
  Picasso
    prompt = (in the style of Picasso, Cubism, fragmented geometric forms, muted earth tones, sharp angles, oil on canvas, highly textured, artistic portrait, in the abstract and geometric style of Cubism)
    negative = ""
  Braque
    prompt = (An analytic cubism painting in the style of Georges Braque. Highly fragmented forms, muted earthy tones, ochre, grey, and deep black palette. Faceted surfaces with intense geometric breakdown, oil on canvas texture, complex overlapping planes, somber and intellectual mood, modernism style.)
    negative = ""
  Gris
    prompt = (by Gris, Watercolor, watercolor painting, ink painting, minimalist, surrealism, digital painting, soft textures. Mood: Melancholy, serene, dreamlike, emotional, artistic.Composition: Wide shots, tiny characters in large environments, environmental storytelling. Palette: Start with monochrome (light gray), slowly introducing muted colors (desaturated blues, greens, reds, yellows).)
    negative = ""
  Léger
    prompt = (Fernand Léger art style, mechanical, tubular forms, thick black outlines, primary colors, flat design, cubism, industrial art.)
    negative = ""
  Modigliani
    prompt = (in the style of Modigliani, muted color palette with brown and blue, simplified features, oil on canvas, highly textured, artistic portrait)
    negative = ""
  Chagall
    prompt = (A whimsical, surreal painting in the style of Marc Chagall. Distorted, colorful cubist, Vivid colors: fauvist greens, bright yellow, and intense blue. Nostalgic, folk art storytelling, dreamlike atmosphere, poetic composition, oil painting with visible brushstrokes.)
    negative = ""
  Klee
    prompt = (Paul Klee style, Bauhaus, surrealist, childlike drawing, geometric abstraction, lyrical abstraction. Watercolor on paper, ink line work, oil transfer, pointillism, textured canvas, muted tones, parchment. Whimsical)
    negative = ""
  Kandinsky
    prompt = (Geometric art of a sprawling cityscape in the style of Kandinsky, bold lines, sharp angles, multicolored, musical rhythm, abstract composition.)
    negative = ""
  Mondrian
    prompt = (An abstract composition inspired by Mondrian, featuring a geometric grid of primary red, blue, yellow, and white, overlaid with a subtle, aged oil-on-canvas texture, cracks in the paint, artistic, high contrast.)
    negative = ""
  Dali
    prompt = (A surrealist painting in the style of Dalí. desolate, dreamlike landscape. The scene is filled with bizarre juxtapositions, long dramatic shadows, high-definition quality, cinematic lighting.)
    negative = ""
  Magritte
    prompt = (Masterpiece, oil on canvas painting, (Style of Rene Magritte), Surrealism, meticulous detail, 1940s surrealism, muted colors with sharp contrast, strange juxtaposition.)
    negative = ""
  Pollock
    prompt = (Abstract expressionism painting in the style of Jackson Pollock, dense chaotic web of overlapping paint drips, splatters, and gestural lines, vibrant yellow and black enamel paint with subtle hints of red, thick texture, action painting, high energy, spontaneous, masterpiece, 8k resolution)
    negative = ""
  Rothko
    prompt = (A color field painting in the style of Mark Rothko, large soft-edged vertical rectangles of ([color] color) and ([color] color) floating on a ([color] color) background, luminous, ethereal, moody, thin paint washes, textured canvas, abstract expressionism, deep emotional resonance, 4k)
    negative = ""
  Warhol
    prompt = (by Warhol, A four-panel, 2x2 grid pop art piece, each panel uses a different, jarring, high-contrast neon color combination, Warhol silkscreen style, graphic, vivid colors.)
    negative = ""
  Hockney
    prompt = (in the style of David Hockney,, bright, bold, saturated colors, flat planes of color, geometric architecture, stark shadows, shimmering blue water, sunlight, acrylic painting, high quality)
    negative = ""
  Bacon
    prompt = (A raw, intimate oil painting in the style of Francis Bacon, violent brushstrokes, dark background with a beige cage structure, harsh top lighting, muted color palette with intense blacks and blood red, visceral and terrifying atmosphere.)
    negative = ""
  Freud
    prompt = (in the painting style of Lucian Freud, thick impasto technique, somber mood, earthy muted colors, high contrast lighting, raw realism.)
    negative = ""
  Hirst
    prompt = (An abstract painting in the style of Damien Hirst, High contrast, vibrant colors, minimalist composition, glossy finish, studio lighting, extremely detailed.)
    negative = ""
