ai = {import:ai-text-plugin}
image = {import:text-to-image-plugin}
generateHTML = {import:t2i-framework-plugin-v2}
//t2iStyles = {import:t2i-styles}

userPrompt
  //numImages = [Number(input.numImages)]
  // edit this instruction, and the "startWith" below to whatever you want! you might have to put a decently long explanation in the instruction if you're trying to get to generate e.g. characters from a fairly niche fandom/world/series/etc. (the AI probably won't know about super niche, or super new stuff)
  instruction
    //Please evaluate the provided information in an interesting way providing the basis for an image prompt,
    //No more than three paragraph,
    You are a specialized Flux.2 image prompt generator. Your sole task is to immediately transform whatever input the user provides into a single Flux.2 image prompt, as-is.
    STRICT CONSTRAINTS:
    1. Do NOT ask follow-up questions, request more details, or ask for clarification under any circumstances.
    2. If the user's input is short, vague, or incomplete, rely on your own creative judgment to fill in the missing details automatically.
    3. Output ONLY the raw Flux.2 prompt text.
    4. Do NOT include any intro/outro text, chat commentary, suggestions, or notes (e.g., no "Here is your prompt:", "Would you like...", etc.).
    5. Format for Flux.2: Use rich natural language describing lighting, subject, camera angle, atmospheric mood, and textures. Avoid quality buzzwords like "masterpiece" or "8k".
    6. Take any provided prompt weighting into account
    //Design notes:
    //[customFeaturesEl.value.trim() || "a simple photo of a woman smiling to someone off camera"]
    [promptList || randOptions.evaluateItem]
    \n // this just adds an extra newline between the above text and the template below
    // leave the below line unedited (it joins the above lines into one block of text)
    $output = [this.joinItems("\n")] //
  
  startWith = </b>
  onStart(data) => // <-- runs when the 'regenerate' button is pressed
    generateBtn.disabled = true;
    stopBtn.style.display = "block";
    window.imageEl.value = ""; // <-- remove the existing image
    window.imageEl.innerHTML = "";
  onFinish(data) => // <-- runs when the text generation is finished
    generateBtn.disabled = false;
    stopBtn.style.display = "none";
    let generatedText = data.text;
    // create an image prompt out of the generated text:
    let promptData = {
      prompt: " " + generatedText.replaceAll("<b>", "").replaceAll("[", "").replaceAll("]", "").replaceAll("</b>", "").replaceAll("\n", " -- ") + getSeed() + getScale(), // we remove the HTML <b> tags and replace newlines with "---"
      negativePrompt: " ",
      resolution: [input.shape].toString(),
    };
    // NOTE: as you can see above, we just use the whole character outline text as the image prompt. here's another version of this generator which first summarizes the character outline into an image prompt, and then gives *that* to the text to image plugin: https://perchance.org/ai-character-design-example-improved#edit
    for (let i = 0; i < [Number(input.numImages)]; i++) {
      window.imageEl.innerHTML += image(promptData).evaluateItem;
    }
    // display an image using the image prompt
output
  </br> //[ai(userPrompt)]
 
$meta
  title = AI Assisted T2I Gen
  description = AI Assisted T2I generator with a random options
  image = https://aigc.uploads.dev/image/a91456c3a21ff498593912a87b5e0e7244c9aafb51dbaab1acbcb6ae5b2f97c2.jpeg
// Feel free to edit the settings below and then save your own copy of this generator!
// You'll probably just want to scroll down to the artStyle list and edit those - it's pretty self-explanatory, just follow the format.
  
settings 
  pageTitle = T2I Gen
  numImages = [Number(input.numImages)]
  socialFeatures = button // or 'button' or 'enabled' or 'disabled'
  imageButtons
    personality = true
    privateSave = true
  // note: the t2i-framework-plugin makes all user inputs from the `userInputs` list accessible by name as [input.theNameOfTheInput], as shown here:
  imageOptions // <-- options for the text-to-image plugin that generates the images: https://perchance.org/text-to-image-plugin
    saveTitle = ([input.artStyle.getName]) [input.description] // .getName is a built-in Perchance property that gets the name of a given list/sublist/node
    //prompt = [getEvaluatedPrompt]
    prompt = [promptList][getScale()]
    negativePrompt = [input.negative]
    resolution = [input.shape]
    style = [getImgStyle()]
    //steps = [input.steps]
    //guidanceScale = [getScale()]
    seed = [input.seed]
  
  userInputs
    Gscale
      label = Guidance scale (random if blank)
      type = text
      remember = true
      tip = (Enter a whole number. Otherwise a random guidance scale will be used)
      visible() =>
        return 1;
    seed
      label = Seed (VERY OPTIONAL)
      type = text
      remember = true
      tip = (This is not used often, so don't use it if you don't understand it.)The seed determines the image. Same seed plus same prompt equals same image. leave blank or type "-1" for a random seed. This is mostly useful for replicating images or making slight edits because Same Seed + Similar Prompt = Similar Image.
      examples
        {Leave blank for random seed. | Same seed + same prompt = same image. | Same seed + similar prompt = similar image}
    steps
      label = Steps
      type = text
      defaultValue = {1-30}
      tip = probably does nothing
      visible() =>
        return 0;
      remember = true
    scratchpad // Note: the 'remember' option storage is 'based on' this 'scratchpad' name, so if you change that name to something else like 'notepad', people will lose all their saved scratchpad text. But it's safe to change the 'label', below.
      label = 🗒️ Scratchpad
      tip = [t2i.defaultText.scratchpadTip] // this loads the default text, but you can replace "[t2i.defaultText.scratchpadTip]" with your own tip. Just change this line to "tip = You own cool tips."
      type = paragraph // <-- large text box
      remember = true // <-- the text that the user inputs will be remembered so it's still there even if they close/refresh the page
      parseVariables = true // <-- allows people to write stuff like "ANIMAL = {dog|cat|frog}" in the scratchpad, and then use "[ANIMAL]" in their prompt to get a random one of those animals. Combined with the settings-sharing-link feature, this basically allows people to create their own shareable image generator.
      width = min(750px, 100%) // <-- the minimum
      height = 40vh  // <-- 40vh means 40% of the "view height" (i.e. page height)
      takesUpFullRow = true
      foldToggleState = hidden // or 'shown' if you want it to start shown, or delete this line if you don't want it to be show-able/hide-able
      visible() =>
        return Number(localStorage.generateClickCount) > 1; // so the scratchpad only shows up after they've clicked generate a couple of times (to reduce confusion/clutter for newbies)
      examples
        [t2i.defaultText.scratchpadPlaceholder]
    pretext
      label = 📝 Pre-text 
      tip = Tip: If you write something like &lcub;blue|red|green&rcub; as part of your description, then a random one will be chosen for each image.\n\nYou can see the prompt that was used for a particular generated image by hovering your mouse over it, or long-pressing on mobile.\n\nAdd brackets around text (like this) to get the AI to pay more attention to it.
      type = paragraph
      width = min(750px, 100%)
      takesUpFullRow = true
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description.input, event:artStyle.change
      enterKeyTriggersGeneration = true // <-- can still use shift+enter to create a new line
      //defaultValue = " " // <-- if user doesn't type anything in the description, this will be used as default
      remember = true
      //steps = 3 // <-- the number of steps the AI takes to generate the image - higher = better quality, but slower
      examples = [input.artStyle?.randomPrompt || randomDescription] // <-- the placeholder examples that rotate in the text box
      //random = {[selectsPrompt]|[randPro.prompt]|[randomDescription]}
      random = [randOptions]
      //[input.artStyle?.randomPrompt || randomDescription] // <-- added to the text box when the 'random' button gets clicked
      // we use artstyle-specific random prompts if available, otherwise fall back to randomDescriptions list:
      randomAppend = [randomAppend]
    preWeight
      label = Pretext Weight
      type = text
      remember = true
      takesUpFullRow = true
      width = 100px
      tip = "(optional) (Enter a ':' then a number. ex :1.5 or :3 or even :\{1-3\} for randomness"
      visible() =>
        return 1;
    artStyle
      label = 🎨 Art Style
      type = select
      remember = true // <-- makes it so the selected option will be remembered even if the user refreshes/closes the page
      takesUpFullRow = true
      //style = "width: 500px;"
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = ""
          negative = ""
          //meta:position = 0 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random
          prompt = [rStyle]
          negative = ""
        Photographic
          prompt = [lifeLike]
          negative = ""
        Photographic 2
          prompt = [photoTypes]
          negative = ""
        Advertisement
          prompt = [adStyle]
          negative = ""
        Vintage Fantasy Art
          prompt = [fantasyArt]
          negative = ""
        Random Style
          prompt = ([style] style :2.03)
          negative = ""
          //meta:position = 1 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random Monster
          prompt = [monsterLoc]
          negative = ""
        Random Person
          prompt = [randPers2]
          negative = ""
        Random Location
          prompt = [getRandLoc()]
          negative = ""
        Fantasy Character
          prompt = [nadventurer]
          negative = ""
        Photographic Location
          prompt = [loc2]
          negative = ""
        Photographic Animal
          prompt = [animalPhoto]
          negative = ""
        Random Color
          prompt = [color] color
          negative = ""
        Random Animal
          prompt = [rAnimal]
          negative = ""
        Oil Painting (Random)
          prompt = [oilPaintPrompt]
          negative = ""
        meta:import
          from = [oilPainters]
        meta:import
          from = [t2iStyleList]
      visible() =>
        //this.style = "width: 200px;";
        return 1;
    a1Weight
      label = Art 1 Weight
      type = text
      remember = true
      takesUpFullRow = true
      width = 75px
      tip = "(optional) (Enter a ':' then a number. ex :1.5 or :3 or even :\{1-3\} for randomness"
    artStyleMix
      label = 🎨 Art Style Mix
      type = select
      takesUpFullRow = true
      remember = true // <-- makes it so the selected option will be remembered up even if the user refreshes/closes the page
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = ""
          negative = ""
          //meta:position = 0 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random
          prompt = [rStyle]
          negative = ""
        Photographic
          prompt = [lifeLike]
          negative = ""
        Photographic 2
          prompt = [photoTypes]
          negative = ""
        Advertisement
          prompt = [adStyle]
          negative = ""
        Vintage Fantasy Art
          prompt = [fantasyArt]
          negative = ""
        Random Style
          prompt = ([style] style :2.03)
          negative = ""
          //meta:position = 1 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random Monster
          prompt = [monsterLoc]
          negative = ""
        Random Person
          prompt = [randPers2]
          negative = ""
        Random Location
          prompt = [getRandLoc()]
          negative = ""
        Fantasy Character
          prompt = [nadventurer]
          negative = ""
        Photographic Location
          prompt = [loc2]
          negative = ""
        Photographic Animal
          prompt = [animalPhoto]
          negative = ""
        Random Color
          prompt = [color] color
          negative = ""
        Random Animal
          prompt = [rAnimal]
          negative = ""
        Oil Painting (Random)
          prompt = [oilPaintPrompt]
          negative = ""
        meta:import
          from = [oilPainters]
        meta:import
          from = [t2iStyles]
    a2Weight
      label = Art 2 Weight
      type = text
      remember = true
      takesUpFullRow = true
      width = 75px
      tip = "(optional) (Enter a ':' then a number. ex :1.5 or :3 or even :\{1-3\} for randomness"
    artStyleMix2
      label = 🎨 Art Style Mix 2
      type = select
      takesUpFullRow = true
      remember = true // <-- makes it so the selected option will be remembered even if the user refreshes/closes the page
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = ""
          negative = ""
          //meta:position = 0 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random
          prompt = [rStyle]
          negative = ""
        Photographic
          prompt = [lifeLike]
          negative = ""
        Photographic 2
          prompt = [photoTypes]
          negative = ""
        Advertisement
          prompt = [adStyle]
          negative = ""
        Vintage Fantasy Art
          prompt = [fantasyArt]
          negative = ""
        Random Style
          prompt = ([style] style :2.03)
          negative = ""
          //meta:position = 1 // positions are 'zero-indexed', so this moves the Casual Photo style to the second item in the selector list
        Random Monster
          prompt = [monsterLoc]
          negative = ""
        Random Person
          prompt = [randPers2]
          negative = ""
        Random Location
          prompt = [getRandLoc()]
          negative = ""
        Fantasy Character
          prompt = [nadventurer]
          negative = ""
        Photographic Location
          prompt = [loc2]
          negative = ""
        Photographic Animal
          prompt = [animalPhoto]
          negative = ""
        Random Color
          prompt = [color] color
          negative = ""
        Random Animal
          prompt = [rAnimal]
          negative = ""
        Oil Painting (Random)
          prompt = [oilPaintPrompt]
          negative = ""
        meta:import
          from = [oilPainters]
        meta:import
