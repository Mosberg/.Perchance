promptList = [getPrompt()]
t2iStyleList = [t2iStyles]
getPrompt() =>
  temp = (artsy + nsfwTxt + fixedPrompt() + getTheme()).toString().trim();
  if (temp != ""){
    //temp += getScale();
  }
  return temp
getImgStyle() =>
  //st = "height: 100%; width: 100%; object-fit: none;";
  //st = "height: 100%; width: 100%; object-fit: none; zoom: 200%;";
  st = "max-width: "+[input.picSize]+"; max-height: "+[input.picSize]+"; height: "+[input.picSize]+"; zoom: "+[input.picSize]+";";
  return st
imgtgl = 1
imgSylToggle() =>
  imgtgl = !imgtgl;
  return (imgtgl ? "contain" : "none");
randOptions
  {[lifeLike]|[vintPhoto] ^0.5} ({[randPrompt]|[randPers2]|[randomDescription]} :5)
  [loc2]
  [animalPhoto]
  [ageDesc] {male|female} [nadventurer]
  [nfemale]
  [nadventurer]
  {[lifeLike]|[vintPhoto] ^0.5} ([nActress] :1.5)
randOptions2
  [randPrompt]
  [randomDescription]
  [rAnimal]
fixedPrompt() =>
  p = "";
  t = input.pretext;
  if(t != ''){
    //return input.description
  } else {
    t = t.replace("“","\"");
  }
  if(t != '""'){
    if(t != ''){
      p += "("+t+" "+[input.preWeight]+")";
    }
  }
  t = window.input.artStyle.prompt;
  if(t != '""'){
    if(t != ''){
      p += ", ("+t+" "+[input.a1Weight]+")";
    }
  }
  t = window.input.artStyleMix.prompt;
  if(t != '""'){
    if(t != ''){
      p += ", ("+t+" "+[input.a2Weight]+")";
    }
  }
  t = window.input.artStyleMix2.prompt;
  if(t != '""'){
    if(t != ''){
      p += ", ("+t+" "+[input.a3Weight]+")";
    }
  }
  t = input.description;
  if(t != ''){
    //return input.description
  } else {
    t = t.replace("“","\"");
  }
  if(t != '""'){
    if(t != ''){
      p += ", ("+t+" "+[input.postWeight]+")";
  
    }
  }
  return p
getScale() =>
  if(!(gs = Math.round([input.Gscale]))){
    gs = Math.floor((Math.random() * 78) + 20);
  }
  return "(guidanceScale:::"+gs+")"
getSteps() =>
  gst = [input.steps] | 0;
  gst = Math.floor(gst);
  if(!(gst)){
    gst = "";
  }else{
    gst = "(steps:::"+gst+")";
  }
  return gst
getSeed() =>
  seed = [input.seed] | 0;
  return "(seed:::"+seed+")"
getRand() =>
  rand = Math.floor((Math.random() * 100) + 1);
  return rand
getRandWeight() =>
  rw1 = Math.floor((Math.random() * 15) + 1);
  rw2 = Math.floor((Math.random() * 99) + 1);
  return "" //":"+rw1+"."+rw2;
