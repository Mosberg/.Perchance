getRandLoc() =>
  selectorNum = getRand();
  if(selectorNum > 25){
    n = locDesc+" ";
    n2 = Loc.selectOne||fantasyLoc.selectOne;
    n2 = n2.value || n2;
    n += n2;
  }else{
    n = Loc.selectOne||fantasyLoc.selectOne;
    n = n.value || n;
  }
  return "(expansive and highly detailed "+n+" "+rSett+" themed location with many props)";
