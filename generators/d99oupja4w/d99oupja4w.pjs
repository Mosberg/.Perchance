artsy = [if(input.artistic == 'True') {artsyPrompt} else {""}] 
curTheme = [rt = randomTheme.selectOne, rt.value || rt]
//adStyle = (((In the style of a [timePeriod] advertisement complete with a catch phrase that says [curAD = randomTheme.selectOne, curAD.value || curAD] in big bold letters)))
adStyle = [adType] ((([ad1 = getRandomTheme.evaluateItem, ""] [ad2 = getRandomTheme.evaluateItem, ""] In the style of a [timePeriod] {[artDesc]|retail|commercial} about [ad1] and [ad2] complete with a clever slogan relating to the advertisement that is clearly readable and not gibberish)))
adType
  movie poster
  grocery store flyer
  coupon advertisement
  magazine cover
  newspaper advertisement
  billboard
gsc = ([input.Gscale] == Random) ? [randNum()]:[input.Gscale]
randPrompt = a [bodyType] [ageDesc] [body_general] [nationality.selectOne.value || nationality] [randomGender] wearing a ([outfitDesc] [job.value || job] outfit) (actively [poseOption.value || poseOption]) at a [getRandLoc()]
randPers2 = an ((uncommon)) ([bodyType]) ([ageDesc]) ([body_general]) [(n= nationality.selectOne, n.value || n)]) thing ([hairStyle.selectOne.value]) (wearing a [outfitDesc] {[(j=job.selectOne, j.value || j)] outfit|[clothesType]}) (([poseDesc], [(po=poseOption.selectOne, po.value || po)] themed pose))
lifeLike = ((shot with a [cameraType] camera with a [lensType]. (([photoLighting] style lighting))). (([cameraEffects])))
vintPhoto = shot on Kodak Portra 400 film, ((warm skin tones with subtle orange cast)), ((fine grain visible)), (soft pastel highlight rolloff), (subject in natural light), (slightly underexposed shadows with rich detail), (analog film photography), (nostalgic and warm), (organic color palette)
loc2 = (Cinematic landscape photography. Shot with a [cameraType] [lensType]. [photoLighting]. [cameraEffects]), [getRandLoc()] // (Highly detailed {[Loc]|[job]|[nationality]|[usa]} {interior|exterior} {location|landscape} with many props :5)
