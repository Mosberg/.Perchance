posttheme
  themed
  styled
  looking
  inspired
getTheme() =>
  n = input.theme;
  switch(input.theme) {
    case 'Default':
      n = "";
      break;
    case 'Double Random':
      n = getRandomTheme;
      x = getRandomTheme;
      n += " and "+ x;
      break;
    case 'Random':
      n = randomTheme.selectOne;
      break;
    default:
      if(n.value != undefined) {
        n = n.value || n;
      }
      break;
  }
  if(n!=""){n = ", (part of the image is "+n+" "+[posttheme] +" " + [themeDesc]+" "+[WeightTheme] + ")"}
  return n;
