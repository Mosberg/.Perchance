kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

$meta
  title = Suno Viral Hit Generator
  description = AI-powered viral song concept engine for Suno — generates topic, genre fusion, full lyrics, cover art, BPM, key, and style tags in one click.
  tags = suno, ai music, song generator, lyrics, viral, cover art
  header
    mode = minimal

