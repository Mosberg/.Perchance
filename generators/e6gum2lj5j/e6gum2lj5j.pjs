    shape
      label = 🖼️ Shape
      type = select
      remember = true
      options
        Square = 768x768
        Portrait = 512x768
        Landscape = 768x512
      visible() =>
        return Number(localStorage.generateClickCount) > 0;

    numImages
      label = 🔢 How many?
      type = select
      remember = true
      options
        1 = 1
        2 = 2
        3 = 3
        4 = 4
      visible() =>
        return Number(localStorage.generateClickCount) > 0;

  defaultCommentOptions
    width = 100%
    height = 400
    commentPlaceholderText = Type a friendly comment...
    submitButtonText = submit comment
    customEmojis = {import:huge-emoji-list}

  commentChannels
    allowCustomChannels = true
    general
      label = General
    chat1
      label = Room 1
    chat2
      label = Room 2
    chat3
      label = Room 3
    prompts
      label = Prompts
      commentPlaceholderText = Share a cool prompt/style. If it's good, it may get added to the Art Style selector.
      submitButtonText = share prompt

  galleryOptions
    gallery = true
    sort = trending
    hideIfScoreIsBelow = -1
    adaptiveHeight = true
    contentFilter = pg13

  charStudioGallery
    gallery = true
    sort = recent
    adaptiveHeight = true
    contentFilter = pg13
    customButton
      emoji = 💬
      onClick(data) =>
        if(typeof window!=="undefined"&&window.charStudioImportFromGallery)window.charStudioImportFromGallery(data);

  showFeedback = false

