generateHTML = {import:t2i-framework-plugin-v2}
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}

$meta
  title = meu gerador melhor 2.0
  description = Create unique and surprising characters with the help of artificial intelligence! Ideal for RPGs, stories, games, or just for fun. Completely free, no registration needed, and unlimited use.
  image = https://user-uploads.perchance.org/file/c4d5454a9df9368cfe8ef614e01206ae.jpg

settings
  pageTitle = ✨ meu gerador melhor 2.0✨
  introMessage = Describe your character and click <b>generate</b>.<br><br><span style="font-size:80%; color:grey; max-width:320px; display:inline-block;">This generator was made using the <a href="https://perchance.org/text-to-image-plugin" target="_blank" style="white-space:nowrap;">text-to-image-plugin</a> and the <a href="https://perchance.org/ai-text-plugin" target="_blank" style="white-space:nowrap;">ai-text-plugin</a>.</span>
  underImagesMessage = <div style="max-width:700px; margin:0 auto; padding:0 1rem; font-size:85%; opacity:0.7;"><div style="margin-top:0.5rem;">Also check out <a href="https://perchance.org/ai-rpg" target="_blank" style="font-weight:bold; color:#2bbb00;">AI Text Adventure</a> and <a href="https://perchance.org/ai-story-generator" target="_blank" style="font-weight:bold;">AI Story Generator</a>.</div></div>
  numImages = [Number(input.numImages)]
  socialFeatures = button after 3 clicks

  imageButtons
    personality = true
    privateSave = true

  imageOptions
    saveTitle = ([input.artStyle.getName]) [input.description]
    prompt = [input.artStyle.prompt]
    negativePrompt = [input.artStyle?.negative || input.negative || ""]
    resolution = [input.shape]
    
   
    
    

  userInputs
    scratchpad
      label = 🗒️ Scratchpad
      tip = [t2i.defaultText.scratchpadTip]
      type = paragraph
      remember = true
      parseVariables = true
      width = min(750px, 100%)
      height = 40vh
      takesUpFullRow = true
      foldToggleState = hidden
      excludeFromShareLink = true
      visible() =>
        return Number(localStorage.generateClickCount) > 1;
      examples
        [t2i.defaultText.scratchpadPlaceholder]

    description
      label = 📝 Description
      tip = [t2i.defaultText.promptTip]
      type = paragraph
      remember = true
      width = min(750px, 100%)
      takesUpFullRow = true
      useVariables = true
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description.input, event:artStyle.change
      enterKeyTriggersGeneration = true
      examples
        a brave knight with golden armor
        a mysterious wizard in a dark forest
        a futuristic cyberpunk hero

    negative
      label = 🚫 Negative Prompt (optional)
      tip = [t2i.defaultText.negativePromptTip]
      type = text
      remember = true
      useVariables = true
      examples
        things you want to avoid in the character

    artStyle
      label = 🎨 Art Style
      type = select
      remember = true
      options

        girl
          prompt = [input.description],3d girl,  girl 3d Blender render, premium quality, distinguished, nuanced, very glossy superb, subject positioned on intersection of lower-right third, diagonal line from top-left to bottom-right at 35° creating dynamic composition, negative space occupying upper-left two-thirds, girl 3d Blender render, premium quality,distinguished, nuanced, very glossy superb, volumetric glossy, volumetric glossy, crisp painterly digital art, crisp oil painting, painterly realism, vibrant colors, subtle soft details, glossy, vivid, fresh, striking, depth of field, beautiful lighting, clean rendering, soft highlights, by chunie, by darkgem, by zaush, by puinkey, by honovy, by atey ghailan, by charlie bowater, by sakimichan, masterpiece, best quality, absurdres, ultra detailed, volumetric glossy, strong volumetric lighting, soft cinematic volumetric glow, crisp painterly digital art, crisp oil painting, painterly realism, vibrant colors, subtle soft details, glossy, vivid, fresh, striking, beautiful depth of field, dramatic soft rim light, luminous atmosphere, gentle god rays, soft glowing highlights, by chunie, by darkgem, by zaush, by puinkey, by honovy, by atey ghailan, by charlie bowater, by sakimichan, masterpiece, best quality, absurdres, ultra detailed, 
        cartoon
          prompt = [input.description], cartoon network style  premium quality, distinguished, nuanced, very glossy superb, cartoon network style premium quality, distinguished, nuanced, very glossy superb, traditional cel shading with hard ink outlines at 2.5px thickness, flat color fills in distinct layers, highlight separation visible between base tone and sheen layer, cartoon network style premium quality, distinguished, nuanced, very glossy superb, specular highlights positioned at 45° angle from assumed top-right light source, reflection streaks following surface curvature geometry, secondary bounce light at 20% intensity on opposite side, cartoon network style premium quality, distinguished, nuanced, very glossy superb, traditional cel shading with hard ink outlines at 2.5px thickness, flat color fills in distinct layers, highlight separation visible between base tone and sheen layer, cartoon network style premium quality, distinguished, nuanced, very glossy superb, specular highlights positioned at 45° angle from assumed top-right light source, reflection streaks following surface curvature geometry, secondary bounce light at 20% intensity on opposite side,  cartoon network style  premium quality, distinguished, nuanced, very glossy superb
