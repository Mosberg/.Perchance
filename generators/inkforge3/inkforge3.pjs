descClosing
  permanent in ink
  etched in skin
  carried for life
  worn like armor
  remembered in flesh
  seared into the soul

getRandomDescription() =>
  let visual = descVisual.selectOne.evaluateItem;
  let palette = descPalette.selectOne.evaluateItem;
  let mood = descMood.selectOne.evaluateItem;
  let meaning = descMeaning.selectOne.evaluateItem;
  let journey = descJourney.selectOne.evaluateItem;
  let closing = descClosing.selectOne.evaluateItem;
  // Generalized: leads with concrete visual direction the generator can follow,
  // followed by palette + mood, then a short poetic meaning line. This shape
  // steers the image while staying varied enough to break prompt convergence.
  return visual + ", " + palette + " palette, " + mood + " mood — a tattoo symbolizing " + meaning + ", " + journey + ", " + closing + ".";

// ---- GUIDANCE STEPS (selectable, each has a hint that influences the prompt) ----
guidanceStep
  step1
    text = Choose your AI model, style, subject, color, orientation, and composition — or leave any on Random.
    hint = cohesive well-planned aesthetic
  step2
    text = Select guidance tips and generator styles below to influence your design.
    hint = carefully curated design direction
  step3
    text = Set how many designs you want to generate (1–6).
    hint = multiple varied compositions
  step4
    text = Hit Generate. Each design comes with its own symbolic description.
    hint = polished professional quality
  step5
    text = Use the description reroll button to find a meaning that resonates.
    hint = meaningful symbolic depth
  step6
    text = Use Same Seed to reproduce, or New Seed for a fresh variation.
    hint = refined precise detail
  step7
    text = Pick your favorite, then Download it as a high-res PNG.
    hint = high resolution crisp detail
  step8
    text = Take the printout to a licensed tattoo artist to refine and apply.
    hint = artist-ready clean reference design

getGuidance() =>
  let result = [];
  let items = guidanceStep.selectAll;
  for (let i = 0; i < items.length; i++) {
    result.push({ text: items[i].text.evaluateItem, hint: items[i].hint.evaluateItem });
  }
  return result;

// ---- GUIDANCE TIPS (selectable, each has a hint that influences the prompt) ----
guidanceTip
  placement
    text = Placement matters — ribs, spine, and feet hurt more; outer arms and thighs are easier for first-timers.
    hint = clean placement-friendly composition suitable for body placement
    icon = 📍
  aging
    text = Think long-term — simple bold designs age better than tiny intricate details that blur over decades.
    hint = bold simple clean design with thick outlines that age well
    icon = ⏳
  size
    text = Go bigger than you think — tattoos shrink visually on the body; your artist can advise on sizing.
    hint = large bold prominent design with strong visual impact
    icon = 📏
  research
    text = Research your artist — look at their portfolio and make sure their style matches your vision.
    hint = portfolio-quality professional tattoo design
    icon = 🔍
  quality
    text = Don't price-shop — a cheap tattoo isn't good, and a good tattoo isn't cheap. Quality lasts forever.
    hint = premium quality craftsmanship with fine detail
    icon = 💰
  health
    text = Sleep and eat before your session — low blood sugar makes the pain worse and healing slower.
    hint = clean crisp well-defined lines and sharp edges
    icon = 🍎
  aftercare
    text = Follow aftercare exactly — keep it clean, moisturized, and out of direct sunlight for 2 weeks.
    hint = pristine clean design with flawless finish
    icon = 🧴
  sunwater
    text = Avoid sun and water — no swimming, soaking, or tanning until fully healed.
    hint = fade-resistant deep saturated ink with strong contrast
    icon = 🏖️
  healing
    text = Let it heal naturally — don't pick at scabs or scratch; let the skin shed on its own.
    hint = smooth clean healed appearance with even ink distribution
    icon = ✋
  touchups
    text = Touch-ups are normal — faded areas can be refreshed after healing; ask your artist.
    hint = crisp sharp long-lasting detail that holds up over time
    icon = 🔧
  inkfade
    text = Black ink fades slowest — color fades faster, especially lighter shades like yellow and white.
    hint = deep saturated ink with strong dark contrast and bold values
    icon = ⚫
  flow
    text = Consider flow — the best tattoos follow your body's natural lines and muscle contours.
    hint = flowing organic lines following natural body contours and curves
    icon = 〰️

getGuidanceTips() =>
  let result = [];
  let items = guidanceTip.selectAll;
  for (let i = 0; i < items.length; i++) {
    result.push({ key: items[i].evaluateItem, text: items[i].text.evaluateItem, hint: items[i].hint.evaluateItem, icon: items[i].icon.evaluateItem });
  }
  return result;

