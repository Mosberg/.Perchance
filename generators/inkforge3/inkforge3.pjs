getFreeGenerators() =>
  let result = [];
  let items = freeGenerator.selectAll;
  for (let i = 0; i < items.length; i++) {
    result.push({ name: items[i].evaluateItem, desc: items[i].desc.evaluateItem, hint: items[i].hint.evaluateItem });
  }
  return result;

