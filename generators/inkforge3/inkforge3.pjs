  configs["Egyptian Hieroglyph"] = { extra: "ancient Egyptian tattoo, hieroglyphic symbols, Ankh and Eye of Horus, Bastet and Anubis, cartouche framing, flat profile figures, gold and lapis lazuli tones, papyrus texture, wall-relief carving style", desc: "Hieroglyphs, Ankh, Eye of Horus, flat profile, gold tones." };
