  with a faint ghosted duplicate offset behind it
  framed by an asymmetric overflowing floral cascade
  with a single contrasting accent color used sparingly

// Vary the wording of the mandatory "isolated on white" anchor so the same
// trailing phrase doesn't pin every card to an identical token sequence.
varFinishPhrase
  isolated on a pure solid white background, professional tattoo flash art, highly detailed, sharp focus
  clean tattoo flash on a seamless white background, studio quality, crisp detail
  centered on pure white, no background scenery, professional tattoo reference art, masterpiece
  presented as isolated tattoo flash art on flat white, sharp clean lines, highly detailed
  floating on a plain white background, tattoo stencil aesthetic, crisp focus, detailed
  pure white background isolation, gallery-grade tattoo flash, sharp ink, highly detailed
  rendered on solid white with no backdrop, professional tattoo design, crisp and clean

// pick a random item from a list name (returns "" if list missing)
pickVar(listName) =>
  let lst = root[listName];
  if (!lst) return "";
  return lst.selectOne.evaluateItem;

// Fisher-Yates shuffle helper (used to reorder prompt parts so the model
// weights different tokens first on different cards → more visual variety).
shuffleArr(arr) =>
  let a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    let j = Math.floor(Math.random() * (i + 1));
    let tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }
  return a;

// ---- DEDUP HISTORY (prevents repeating prompt signatures) ----
// Tracks the subject+style+color "signature" of recent prompts so the
// same combination isn't repeated within a batch. This breaks the cyclic
// "same prompt every 4th time" behavior from selectOne's cycling.

resetPromptHistory() =>
  root._promptHistory = [];

signatureFor(sub, s, c, place, atmos) =>
  return String(sub) + "|" + String(s) + "|" + String(c) + "|" + String(place) + "|" + String(atmos);

// ---- PROMPT ENHANCER ----
// ONLY generalizes the description the user gives — nothing more.
// It does NOT add random style/placement/pose layers (that's buildPrompt's
// job). It takes the user's raw text and returns a generalized, color-free,
// subject-focused description suitable as tattoo prompt direction.
//
// Steps:
//   1. Strip explicit color words (colors removed → model picks a
//      style-fitting palette for variety)
//   2. Generalize the subject to its core motif (drop hyper-specific
//      adjectives so the image isn't pinned to one rendering)
//   3. Keep the user's short thematic fragments (<= 5 words each)
//   4. Return a clean generalized description — no injected layers

enhanceColorWords = [[["red","blue","green","yellow","purple","orange","pink","white","black","crimson","emerald","sapphire","ruby","gold","silver","amber","teal","navy","maroon","olive","indigo","violet","magenta","cyan","scarlet","burgundy","turquoise","charcoal","sepia","sienna","ochre","ivory","cream","beige","fuchsia","lavender","mauve","periwinkle","plum","salmon","coral","sage","slate","taupe","khaki","mustard","bronze","copper","brass","aqua","azure","cerulean","chartreuse","cobalt","jade","lilac","marigold","moss","umber","vermillion","wine","rose","colored","colour","color"]]]

// Core subject motifs to extract from raw text (animal/nature/object/symbolic)
enhanceCoreSubjects = [[["wolf","lion","tiger","bear","eagle","owl","raven","fox","stag","panther","dragon","koi","snake","serpent","viper","cobra","skull","rose","lotus","peony","dagger","sword","katana","anchor","compass","ship","galleon","hourglass","watch","key","crown","heart","angel","demon","reaper","moth","spider","octopus","whale","shark","phoenix","pegasus","unicorn","geisha","samurai","viking","gladiator","mary","buddha","ganesha","medusa","gargoyle","mandala","dreamcatcher","cross","star","moon","sun","tree","wave","mountain","flame","bee","butterfly","hummingbird","swallow","crane","carp","jaguar","rhino","deer","horse","stallion","ram","buffalo","scorpion","widow","harpy","hawk","falcon","crow","cat","dog","rabbit","mouse","frog","toad","turtle","tortoise","eel","ray","squid","crab","lobster","shrimp","ant","beetle","fly","wasp","hornet","dragonfly","grasshopper","centipede","millipede","tarantula","bat","rat","ox","cow","bull","goat","sheep","lamb","pig","boar","donkey","mule","camel","elephant","giraffe","zebra","hippo","gorilla","chimp","monkey","leopard","cheetah","hyena","panda","koala","kangaroo","sloth","otter","seal","walrus","penguin","flamingo","parrot","peacock","swan","dove","robin","rooster","hen","chicken","duck","goose","turkey","sparrow","cardinal","bluebird","pigeon","seagull","albatross","pelican","heron","stork","vulture","hydra","kraken","mermaid","fairy","wizard","witch","knight","templar","spartan","centurion","pharaoh","mummy","skeleton","zombie","ghost","wraith","shadow","ice","lightning","thunder","storm","cloud","mist","fog","dawn","dusk","twilight","midnight","galaxy","nebula","constellation","comet","meteor","planet","asteroid","orb","sphere","crystal","gem","jewel","talisman","amulet","relic","artifact","totem","sigil","glyph","rune","seal","crest","emblem","badge","insignia","heraldry"]]]

enhancePrompt(raw) =>
  let text = (raw || "").trim();
  if (!text) return root.getRandomDescription();
  // 1. STRIP color words (colors removed → model picks style-fitting palette)
  let colors = enhanceColorWords[0];
  for (let i = 0; i < colors.length; i++) {
    let c = colors[i];
    let re = new RegExp("\\b" + c + "\\b", "gi");
    text = text.replace(re, "");
  }
  // strip leftover color phrases
  text = text.replace(/\b(in colou?r|with colou?r|palette of|shades of|hue of|tones of)\b\s*,?\s*/gi, "");
  // 2. EXTRACT core subject motifs (generalize subject)
  let cores = enhanceCoreSubjects[0];
  let lower2 = text.toLowerCase();
  let found = [];
  for (let i = 0; i < cores.length; i++) {
    if (lower2.includes(cores[i]) && found.indexOf(cores[i]) < 0) found.push(cores[i]);
  }
  let subjectPhrase;
  if (found.length > 0) {
    subjectPhrase = found.slice(0, 2).join(" and ") + " motif";
  } else {
    // no recognizable core subject → keep the user's text as-is, just cleaned
    subjectPhrase = "";
  }
  // 3. GENERALIZE: keep only short meaningful fragments (<= 5 words each)
  let fragments = text.split(",").map(f => f.trim()).filter(f => f && f.length > 0);
  let kept = [];
  for (let i = 0; i < fragments.length && kept.length < 3; i++) {
    let words = fragments[i].split(/\s+/);
    if (words.length <= 5 && !/^\d+$/.test(fragments[i])) kept.push(fragments[i]);
  }
  let userIntent = kept.join(", ");
  // collapse doubled spaces / commas
  userIntent = userIntent.replace(/[\s,]+/g, " ").replace(/\s+,/g, ",").replace(/,\s*,/g, ",").trim();
  // 4. ASSEMBLE — only the generalized subject + user intent. No layers.
  let parts = [];
  if (subjectPhrase) parts.push(subjectPhrase);
  if (userIntent && userIntent !== subjectPhrase) parts.push(userIntent);
  if (parts.length === 0) return root.getRandomDescription();
  return parts.join(", ");

// ---- TATTOO COMPLEXITY MODES ----
// Research-backed: real tattoos fall into two design philosophies:
//   SIMPLE: bold thick outlines, limited detail, high negative space,
//   clean silhouette, iconic shapes — American Traditional style.
//   COMPLEX: intricate detail, layered depth, multiple elements,
//   ornamental flourishes, dense composition — Neo-Traditional/Irezumi.
//   BALANCED: the default — moderate detail with clean readability.
tattooComplexity
  balanced
  simple
  complex

getComplexityConfig(mode) =>
  let configs = {};
  configs["balanced"] = {
    extra: "balanced composition, moderate detail, clean readable silhouette, strong visual hierarchy, professional tattoo design with clear focal point",
    desc: "Balanced — moderate detail, clean readability, strong focal point."
  };
  configs["simple"] = {
    extra: "simple bold tattoo design, thick bold black outlines, simplified iconic shapes, high contrast, generous negative space, minimal shading, clean silhouette, classic American traditional flash aesthetic, strong readable at a glance, limited elements",
    desc: "Simple — bold outlines, minimal detail, high negative space. Classic traditional flash."
  };
  configs["complex"] = {
    extra: "complex intricate tattoo design, fine detailed linework, layered depth, ornamental flourishes, dense composition, multiple interconnected elements, rich decorative detail, elaborate ornamental borders, fine micro detail, sophisticated composition with many elements flowing together",
    desc: "Complex — fine detail, layered depth, ornamental flourishes. Dense and elaborate."
  };
  let m = mode ? mode : "balanced";
  if (!configs[m]) m = "balanced";
  return configs[m];

// ---- BUILD PROMPT (research-backed tattoo structure) ----
// Based on research from:
//   - RonShmuely/claude-skills tattoo-stencil-prompt.md
//   - justaspetrauskas/ink-forge prompt.ts
// Key findings applied:
//   1. Tattoo flash is BLACK INK on PURE WHITE — enforce strictly
//   2. Real tattoos use closed contour line art reproducible by a machine
//   3. No diffuse gradients, no photographic textures, no light physics
//   4. Composition reserves negative space for body curvature
//   5. Highly legible composition with strong contrast and clean silhouette
//   6. Phrases to AVOID: "soft gradients", "volumetric lighting", "chiaroscuro",
//      "hyper-realistic textures", "subtle highlights", "photorealistic"
// The prompt is now lean and tattoo-specific instead of a diffuse keyword soup.
buildPrompt(style, subject, color, orientation, composition, placement, model, extraHints, theme, description, complexity) =>
  let s = style ? style : tattooStyle.selectOne.evaluateItem;
  // `subject` may be a single phrase OR an array of phrases (multi-select).
  // Normalize to a combined descriptor: empty → random; array → combined.
  let sub;
  if (Array.isArray(subject) && subject.length > 0) {
    sub = root.combineSubjects(subject);
  } else if (subject && typeof subject === "string" && subject.trim() !== "") {
    sub = subject;
  } else {
    sub = root.getRandomSubjectFromCatalog();
  }
  let c = color ? color : colorMode.selectOne.evaluateItem;
  let place = placement ? placement : bodyPlacement.selectOne.evaluateItem;
  let comp = getCompositionForPlacement(place, composition);
  let orient = orientation === "landscape" ? "wide horizontal layout, 4:3" : orientation === "portrait" ? "tall vertical layout, 3:4" : "square centered layout, 1:1";
  let mc = getModelConfig(model);
  let hintStr = extraHints && extraHints.length > 0 ? ", " + extraHints.join(", ") : "";
  let tc = getThemeConfig(theme);
  let themeStr = tc.extra;
  let cc = getComplexityConfig(complexity);
  // dedup: re-roll subject/style/color until signature is fresh
  if (!root._promptHistory) root._promptHistory = [];
  let sig = signatureFor(sub, s, c, place, "");
  let attempts = 0;
  while (root._promptHistory.indexOf(sig) >= 0 && attempts < 12) {
    if (Array.isArray(subject) && subject.length > 0) {
      // multi-select: reshuffle the order instead of picking new subjects,
      // so all user-chosen subjects still appear in the combined composition
      let shuffled = subject.slice().sort(() => Math.random() - 0.5);
      sub = root.combineSubjects(shuffled);
    } else {
      sub = root.getRandomSubjectFromCatalog();
      s = style ? style : tattooStyle.selectOne.evaluateItem;
      c = color ? color : colorMode.selectOne.evaluateItem;
    }
    sig = signatureFor(sub, s, c, place, "");
    attempts++;
  }
  root._promptHistory.push(sig);
  if (root._promptHistory.length > 40) root._promptHistory.shift();
  // Pick ONE atmosphere word (not a soup) — keep prompt lean
  let atmos = pickVar("varAtmos");
  // Pick a line-weight descriptor that matches the complexity
  let lineW = (complexity === "simple") ? "thick bold black outlines" : (complexity === "complex") ? "fine detailed linework with varied line weight" : pickVar("varLineWeight");
  // Description goes FIRST so the model weights it heavily
  let descHead = (description && description.trim()) ? description.trim() : "";
  // ASSEMBLE — lean, tattoo-specific, research-backed structure:
  //   [desc], [subject], [complexity], [style] tattoo flash, [color mode],
  //   [theme], [line weight], [atmosphere] mood, [placement], [composition],
  //   [orientation], [model extra], [hints], [finish anchor]
  // Shuffled middle for variety, but kept SHORT — long keyword soups produce
  // coloring-book-style images.
  let head = descHead ? [descHead, sub] : [sub];
  let middle = [
    cc.extra,
    s + " tattoo flash design",
    c,
    themeStr,
    lineW,
    atmos + " mood",
    "for " + place + " placement, reserves negative space for body curvature",
    comp,
    orient,
    mc.extra,
    hintStr.trim()
  ].filter(p => p && p.trim() !== "");
  let shuffledMiddle = shuffleArr(middle);
  // Finish anchor — strict white background + tattoo flash + export quality
  let finishPhrase = "black ink tattoo flash on pure solid white background, highly legible composition, clean silhouette, strong contrast, closed contour line art, professional tattoo reference, export quality, masterpiece, sharp focus";
  let parts = head.concat(shuffledMiddle).concat([finishPhrase]);
  return parts.filter(p => p && p.trim() !== "").join(", ");

buildNegative() =>
  return "photograph, 3d render, photorealistic, soft gradients, volumetric lighting, chiaroscuro, hyper-realistic textures, subtle highlights, background scenery, landscape, environment, backdrop, multiple subjects, extra subjects, text, watermark, signature, logo, frame, border, low quality, worst quality, blurry, messy lines, smudged, jagged lines, broken lines, shadow on background, colored background, gradient background, textured background, busy background, skin, human body, body part, person, cluttered, noise, grain, jpeg artifacts, pixelated, coloring book, line art only without ink, sketch, rough draft, incomplete";

// ---- DESCRIPTION RANDOMIZER ----
// Produces a generalized visual+thematic description that the generator can
// actually follow. Each part is picked fresh for maximum variety, so rerolling
// or generating multiple cards yields meaningfully different direction text.
descVisual
