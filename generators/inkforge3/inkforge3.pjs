// ---- BUILD A COMPLEX TATTOO PROMPT ----
// Assembles all the layered lists above into one rich, detailed prompt.
// If useCurrent is true, it pulls from the sidebar/panel selections for
// style, color, placement, etc.; otherwise everything is randomized.
generateComplexPrompt(useCurrent) =>
  let sub = promptSubject.selectOne.evaluateItem;
  let accent = promptAccent.selectOne.evaluateItem;
  let technique = promptTechnique.selectOne.evaluateItem;
  let mood = promptMood.selectOne.evaluateItem;
  let influence = promptInfluence.selectOne.evaluateItem;
  let finish = promptFinish.selectOne.evaluateItem;
  let style, color, place, comp, orient, mc, theme, selectedSubs;
  if (useCurrent) {
    style = root._promptGenStyle || "";
    selectedSubs = root._promptGenSubjects || [];
    color = root._promptGenColor || "";
    place = root._promptGenPlacement || "";
    comp = root._promptGenComposition || "";
    orient = root._promptGenOrientation || "";
    mc = root._promptGenModel || "Tattoo Flash Pro";
    theme = root._promptGenTheme || "";
  }
  // If the user has multi-selected tattoo subjects, use those (combined) in
  // place of the random promptSubject. This makes the complex prompt reflect
  // the user's actual subject picks.
  if (selectedSubs && selectedSubs.length > 0) {
    sub = root.combineSubjects(selectedSubs);
  }
  if (!style) style = tattooStyle.selectOne.evaluateItem;
  if (!color) color = colorMode.selectOne.evaluateItem;
  if (!place) place = bodyPlacement.selectOne.evaluateItem;
  if (!comp) comp = getCompositionForPlacement(place, "");
  if (!orient) orient = "square centered layout";
  else orient = orient === "landscape" ? "wide horizontal layout" : orient === "portrait" ? "tall vertical layout" : "square centered layout";
  if (!mc) mc = "Tattoo Flash Pro";
  if (!theme) theme = tattooTheme.selectOne.evaluateItem;
  let mcObj = getModelConfig(mc);
  let tcObj = getThemeConfig(theme);
  // 50% chance to include flair for variety
  let flair = Math.random() < 0.5 ? ", " + promptFlair.selectOne.evaluateItem : "";
  let descHead = (root._promptGenDesc && root._promptGenDesc.trim()) ? root._promptGenDesc.trim() + ", " : "";
  let parts = [
    descHead + sub,
    accent,
    style + " tattoo design",
    "for " + place + " placement",
    color,
    comp,
    orient,
    technique,
    mood + " mood",
    influence,
    tcObj.extra,
    mcObj.extra,
    finish,
    flair,
    "export quality, ultra-detailed, 4k, masterpiece, game-asset ready, isolated on pure solid white background, professional tattoo flash art, sharp focus, clean linework"
  ];
  return parts.filter(p => p && p.trim() !== "").join(", ");
