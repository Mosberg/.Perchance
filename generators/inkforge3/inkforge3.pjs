// Combine a list of subject phrases into one composition descriptor for
// buildPrompt. Single subject → returned as-is. Multiple → combined into a
// unified scene so all selected subjects appear in the tattoo design.
combineSubjects(subjects) =>
  if (!subjects || subjects.length === 0) return "";
  if (subjects.length === 1) return subjects[0];
  // Join all selected subjects into one flowing composition. Use connecting
  // phrasing that tells the model these elements share one composition (not
  // separate tattoos). This keeps all selected subjects visible in the ink.
  let listed = subjects.map((s, i) =>
    i === 0 ? s :
    i === subjects.length - 1 ? "and " + s :
    s
  );
  return listed.join(", ") + ", composed together as a single unified tattoo design with all elements sharing one composition";

// Return a random subject phrase from the full catalog (used by buildPrompt
// when nothing is selected — keeps backward compatibility with the original
// getSubject). Falls back to the original category lists.
getRandomSubjectFromCatalog() =>
  let all = [];
  let catalog = root.tattooSubjectCatalog();
  for (let cat of catalog) {
    for (let item of cat.items) all.push(item);
  }
  return all[Math.floor(Math.random() * all.length)];

// ---- TATTOO THEMES (each generates visually distinct images) ----
// Comprehensive research of tattoo themes — each injects unique visual
// keywords into the prompt so the same subject renders differently per theme.
tattooTheme
  American Traditional
  Japanese Irezumi
  Tribal Polynesian
  Black and Grey Realism
  Dark Macabre
  Chicano Lowrider
  Fine Line Delicate
  Sacred Geometry
  Watercolor Splash
  Trash Polka
  Neo-Traditional Ornate
  New School Cartoon
  Dotwork Stipple
  Minimalist Clean
  Surreal Dreamscape
  Gothic Cathedral
  Norse Viking
  Celtic Knotwork
  Egyptian Hieroglyph
  Aztec Mayan
  Steampunk Clockwork
  Cyberpunk Neon
  Cosmic Galaxy
  Ocean Nautical
  Botanical Floral
  Horror Blood
  Fantasy Mythic
  Biomechanical Giger
  Art Nouveau Flow
  Art Deco Geometric
  Pop Art Comic
  Vaporwave Retro
  Woodcut Block Print
  Engraving Etching
  Ignorant Sketch
  Stick and Poke
  Portrait Realism
  Religious Sacred
  Memorial Tribute
  Military Patriotic
  Wildlife Nature
  Skull Death
  Lettering Script
  Abstract Nonobjective

getThemeConfig(theme) =>
  let configs = {};
  configs["American Traditional"] = { extra: "classic Sailor Jerry style, bold black outlines, limited primary color palette of red yellow green, nautical and military motifs, vintage flash sheet aesthetic, high contrast", desc: "Bold outlines, limited palette, classic nautical/military flash." };
  configs["Japanese Irezumi"] = { extra: "traditional Japanese irezumi tattoo, bold black outlines, flowing wind bars and wave patterns, ukiyo-e woodblock influence, iconic iconography, vibrant reds and blues, cherry blossoms and maple leaves", desc: "Bold outlines, wind/wave bars, ukiyo-e influence, iconic motifs." };
  configs["Tribal Polynesian"] = { extra: "Polynesian tribal tattoo, solid black geometric patterns, repeating cultural motifs, spearheads and turtle shells, symmetrical flowing lines, high contrast black fills, Maori koru spirals", desc: "Solid black geometric patterns, cultural motifs, symmetrical flow." };
  configs["Black and Grey Realism"] = { extra: "black and grey realism tattoo, smooth gradient shading, clean tattoo depth, soft transitions, lifelike tonal values, no color, grey wash technique, dramatic ink contrast", desc: "Smooth grey-wash gradients, clean tattoo depth, no color." };
  configs["Dark Macabre"] = { extra: "dark macabre tattoo, deep black shadows, gothic horror atmosphere, ominous mood, skeletal and death imagery, heavy black saturation, eerie glow accents, macabre detail", desc: "Deep shadows, gothic horror, heavy black, ominous mood." };
  configs["Chicano Lowrider"] = { extra: "Chicano fine line tattoo, smooth single-needle shading, subtle grey wash, old English lettering influence, lowrider and street culture aesthetic, detailed portrait work, payasa clowns", desc: "Single-needle fine line, grey wash, lowrider/street culture." };
  configs["Fine Line Delicate"] = { extra: "ultra-fine single-needle delicate linework, whisper-thin strokes, minimal shading, intricate micro detail, elegant understated botanical flow, airy negative space", desc: "Ultra-thin single-needle, minimal shading, micro detail." };
  configs["Sacred Geometry"] = { extra: "sacred geometry tattoo, precise mathematical patterns, metatron's cube and flower of life, mandala symmetry, interlocking triangles and circles, clean geometric linework, golden ratio proportions", desc: "Mathematical patterns, mandalas, metatron, clean geometry." };
  configs["Watercolor Splash"] = { extra: "watercolor-style tattoo, flowing ink splashes, soft color bleeds, artistic ink runs, wet-on-wet blending, vibrant translucent washes, no hard outlines", desc: "Flowing ink splashes, soft bleeds, translucent washes." };
  configs["Trash Polka"] = { extra: "trash polka tattoo, bold red and black only, collage of realistic and abstract elements, chaotic torn paper texture, splatter and brush strokes, typographic fragments, raw aggressive energy", desc: "Red/black collage, torn paper, splatter, raw chaos." };
  configs["Neo-Traditional Ornate"] = { extra: "neo-traditional tattoo, bold but refined outlines, rich ornamental detail, decorative flourishes, layered depth, modern traditional aesthetic, jewel-tone saturated color, symmetrical framing", desc: "Bold refined outlines, ornamental detail, jewel tones." };
  configs["New School Cartoon"] = { extra: "new school tattoo, exaggerated cartoon proportions, thick bold outlines, bubble-like shapes, vibrant saturated candy colors, playful energetic style, graffiti influence, exaggerated expressions", desc: "Exaggerated cartoon, thick outlines, candy colors, playful." };
  configs["Dotwork Stipple"] = { extra: "dotwork tattoo, precise stippling technique, gradient built from dot density, no solid lines, pointillist shading, geometric and mandala forms, clean pure-dot aesthetic, meditative precision", desc: "Stippling, dot-density gradients, no solid lines, mandalas." };
  configs["Minimalist Clean"] = { extra: "minimalist tattoo, single continuous line, extreme simplicity, vast negative space, elegant understated design, tiny delicate form, ultra-clean composition, one-stroke aesthetic", desc: "Single line, vast negative space, tiny delicate form." };
  configs["Surreal Dreamscape"] = { extra: "surrealism tattoo, dreamlike impossible imagery, melting and morphing forms, Daliesque distortion, floating disconnected elements, ethereal atmosphere, paradoxical composition, subconscious symbolism", desc: "Dreamlike, melting forms, paradoxical, ethereal." };
  configs["Gothic Cathedral"] = { extra: "gothic tattoo, cathedral arch tracery, pointed arches and ribbed vaults, gargoyles and grotesques, dark ornate stone texture, blackwork with fine gothic linework, rose windows, flying buttresses", desc: "Cathedral arches, gargoyles, rose windows, ornate stone." };
  configs["Norse Viking"] = { extra: "Norse Viking tattoo, intertwined Borre and Jelling style knotwork, runic inscriptions, Mjolnir and longship motifs, ravens and wolves, Yggdrasil tree, Valknut symbol, weathered carved stone texture", desc: "Norse knotwork, runes, Mjolnir, longships, Yggdrasil." };
