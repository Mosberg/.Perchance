// === INKFORGE 3 — TATTOO GENERATOR ===
// Generates clean tattoo flash art isolated on a pure white background.
// Guidance, steps, models, and generators are selectable and influence the prompt.

generateImage = {import:text-to-image-plugin}
commentsPlugin = {import:comments-plugin}

$meta
  title = InkForge 3
  description = Generate unique, high-quality tattoo designs on a clean white background. Pick a style, subject, color, orientation, and AI model — or randomize for inspiration. Community chat and requests included.
  tags = tattoo, tattoo design, tattoo generator, flash, art, ink, chicano, inkforge

// ---- STYLE OPTIONS ----
tattooStyle
  American Traditional^2
  Neo-Traditional^2
  Japanese (Irezumi)
  Blackwork
  Fine Line
  Dotwork
  Realism
  Black and Grey
  Geometric
  Watercolor
  Trash Polka
  Chicano^3
  Minimalist
  New School
  Surrealism
  Sketch / Ignorant
  Tribal
  Ornamental
  Stick and Poke
  Chicano Fine Line
  Black and Grey Realism
  Ignorant Style
  Dark Art

// ---- COLOR MODES ----
colorMode
  black and grey shading
  bold traditional color^2
  full vibrant color
  monochrome black ink only
  muted vintage color
  red and black only
  chicano black and grey with subtle accents
  full color realism

// ---- COMPOSITION ----
composition
  single centered subject
  full back tattoo composition, elaborate and sprawling
  full sleeve tattoo design, flowing vertical composition
  half sleeve tattoo design, dense detail
  chest panel tattoo composition, symmetrical
  forearm wrap tattoo design, elongated
  shoulder and arm cap tattoo, wrapping composition
  large elaborate thigh piece, rich detail
  full leg tattoo sleeve, vertical flow
  intricate central mandala composition, symmetrical radiating detail
  stacked multi-element composition, layered depth
  sprawling interconnected scene, many elements flowing together

// ---- BODY PLACEMENT ----
bodyPlacement
  forearm
  upper arm
  shoulder
  chest
  back
  ribs
  thigh
  calf
  neck
  wrist
  ankle
  spine
  full sleeve
  half sleeve

