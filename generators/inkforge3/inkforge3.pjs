  configs["Pop Art Comic"] = { extra: "pop art tattoo, Roy Lichtenstein comic style, bold black outlines, Ben-Day dot shading, vibrant primary colors, speech bubbles and action words, halftone patterns, graphic novel aesthetic, Warhol color blocks", desc: "Comic style, Ben-Day dots, primary colors, halftone." };
  configs["Vaporwave Retro"] = { extra: "vaporwave tattoo, retro 80s 90s aesthetic, neon pink and cyan grid, sunset gradient, palm silhouettes, VHS glitch texture, Greek statue fragments, Miami Vice color palette, synthwave sunset, pixelated retro", desc: "80s neon, pink/cyan grid, glitch, synthwave sunset." };
  configs["Woodcut Block Print"] = { extra: "woodcut block print tattoo, carved wood texture, bold black and white contrast, hand-carved gouge marks, medieval woodcut aesthetic, Albrecht Durer style hatching, rustic inked impression, no gradients only flat black/white", desc: "Carved wood, bold B&W, gouge marks, Durer hatching." };
  configs["Engraving Etching"] = { extra: "engraving etching tattoo, fine crosshatch linework, copper-plate engraving style, dense parallel line shading, vintage currency-note detail, intricate stippled texture, Gustave Dore illustration quality, no color only ink", desc: "Crosshatch, copper-plate, currency detail, Dore quality." };
  configs["Ignorant Sketch"] = { extra: "ignorant style tattoo, raw rough hand-drawn sketch, intentionally naive and childlike, uneven wobbly lines, punk DIY aesthetic, simple crude shapes, rebellious anti-technical style, stick-figure energy", desc: "Raw naive sketch, wobbly lines, punk DIY, crude." };
  configs["Stick and Poke"] = { extra: "stick and poke tattoo, handmade hand-poked aesthetic, uneven dot-and-line texture, slightly imperfect rustic linework, prison-style crude simplicity, raw authentic folk art, visible needle puncture texture", desc: "Hand-poked, uneven texture, rustic, folk art, crude." };
  configs["Portrait Realism"] = { extra: "portrait realism tattoo, detailed human face, smooth tonal shading, accurate facial proportions, soft natural grey wash, lifelike eyes and hair detail, black and grey or subtle color, dramatic contrast, clean tattoo linework", desc: "Detailed tattoo face, smooth tonal shading, accurate proportions." };
  configs["Religious Sacred"] = { extra: "religious sacred tattoo, Virgin Mary and Jesus imagery, praying hands and rosary, sacred heart and cross, halo radiance, cathedral icon style, gold leaf accents, devotional reverent mood, traditional iconography", desc: "Mary, Jesus, praying hands, halos, gold, devotional." };
  configs["Memorial Tribute"] = { extra: "memorial tribute tattoo, ribbon banner with dates, portrait with name scroll, angel wings and halo, rose and cross combination, doves and olive branches, heartfelt sentimental mood, vintage commemorative style, commemorative dates", desc: "Ribbons, dates, portraits, angels, sentimental mood." };
  configs["Military Patriotic"] = { extra: "military patriotic tattoo, eagle and flag motifs, dog tags and service insignia, camouflage and banner elements, bold red white and blue, American traditional military flash style, patriotic stars and stripes, memorial battle cross", desc: "Eagle, flag, dog tags, camo, red/white/blue, stars." };
  configs["Wildlife Nature"] = { extra: "wildlife nature tattoo, detailed animal tattoo, lifelike fur and feather texture rendered in ink, natural habitat tattoo elements, earthy brown and green tattoo tones, clean black and grey tattoo shading, tattoo background elements, professional tattoo reference", desc: "Detailed tattoo animals, fur/feather in ink, earthy tones." };
  configs["Skull Death"] = { extra: "skull and death tattoo, detailed human skull anatomy, sugar skull decoration, skeletal motifs, Día de los Muertos celebration, ornate skull with floral crown, dark memento mori aesthetic, cracked weathered bone texture, candle and marigold accents", desc: "Skulls, sugar skulls, skeletons, memento mori, marigolds." };
  configs["Lettering Script"] = { extra: "lettering script tattoo, ornate old English blackletter font, flowing cursive calligraphy, banner ribbon text, decorative typographic flourish, vintage sign-painter hand-lettering, illuminated manuscript capitals, text as central design element", desc: "Old English, calligraphy, banners, sign-painter lettering." };
  configs["Abstract Nonobjective"] = { extra: "abstract tattoo, non-representational shapes, flowing organic forms, color field blocks, Kandinsky and Klee influence, emotional expressionist marks, asymmetrical balance, modern art gallery aesthetic, no recognizable subject", desc: "Non-representational, color fields, expressionist marks." };
  let t = theme ? theme : "American Traditional";
  if (!configs[t]) t = "American Traditional";
  return configs[t];

getThemeConfigs() =>
  let result = [];
  let items = tattooTheme.selectAll;
  for (let i = 0; i < items.length; i++) {
    let name = items[i].evaluateItem;
    let tc = getThemeConfig(name);
    result.push({ name: name, extra: tc.extra, desc: tc.desc });
  }
  return result;

// ---- AI MODEL PRESETS (free tattoo-capable generators) ----
// Researched via GitHub API — these are genuinely free, open-source
// image-generation models/engines known to produce excellent unique tattoos.
// The text-to-image-plugin backend is fixed, so these presets inject
// tattoo-optimized quality keywords to steer output toward each engine's
// strengths. The GitHub API block in the UI lets the user verify the model
// list is up to date.
modelPreset
  Flux Schnell Free^3
  Flux Dev Free
  SDXL Base 1.0
  FLUX Tattoo LoRA
  SDXL Tattoo LoRA
  InkVision SDXL
  Stable Diffusion 1.5
  FLUX Realism LoRA
  SDXL Fine Line
  FLUX Black & Grey
  SDXL Traditional Bold
  FLUX Japanese Irezumi
  SDXL Chicano Fine Line
  FLUX Neo-Traditional
  FLUX Dotwork
  SDXL Watercolor

getModelConfig(model) =>
  let configs = {};
  // Research-backed free models from GitHub/HuggingFace:
  // - Flux Schnell/Dev (Black Forest Labs, Apache 2.0) — best prompt adherence
  // - SDXL 1.0 (Stability, OpenRAIL-M) — versatile open base
  // - SD 1.5 (Stability, OpenRAIL-M) — classic broad community support
  // - tattoo LoRAs: vonvolous/SDXL_1.0_LoRA, Baredal/sdxl_lora_tattoo,
  //   viktor369-best/inkvision-sdxl-controlnet-lora
  configs["Flux Schnell Free"] = { guidance: 7, extra: "flux schnell model, ultra sharp prompt-adherent detail, clean precise linework, excellent outline accuracy, export quality, 4k, masterpiece", desc: "Free Apache-2.0 Flux Schnell. Best prompt adherence + crisp linework — ideal default for clean tattoo flash." };
  configs["Flux Dev Free"] = { guidance: 7, extra: "flux dev model, high fidelity rendering, ultra sharp detail, clean precise outlines, excellent text accuracy, export quality, 4k, masterpiece", desc: "Free non-commercial Flux Dev. Highest fidelity + outline accuracy — premium quality tattoo flash." };
  configs["SDXL Base 1.0"] = { guidance: 8, extra: "stable diffusion XL 1.0, high-fidelity detailed rendering, broad style range, strong composition, versatile output, export quality, 4k, masterpiece", desc: "Free OpenRAIL-M SDXL base. Versatile and high fidelity across all tattoo styles." };
  configs["FLUX Tattoo LoRA"] = { guidance: 7, extra: "flux model with tattoo-style LoRA fine-tune, tattoo-optimized linework, authentic flash aesthetic, clean bold outlines, even ink saturation, export quality, 4k, masterpiece", desc: "Flux + tattoo LoRA fine-tune (vonvolous/SDXL_1.0_LoRA style). Authentic tattoo linework." };
  configs["SDXL Tattoo LoRA"] = { guidance: 8, extra: "stable diffusion XL with tattoo LoRA fine-tune, authentic tattoo flash aesthetic, clean bold outlines, even ink saturation, export quality, 4k, masterpiece", desc: "SDXL + tattoo LoRA (Baredal/sdxl_lora_tattoo style). Authentic tattoo flash output." };
  configs["InkVision SDXL"] = { guidance: 8, extra: "inkvision SDXL inpaint with multi-controlnet and LoRA, authentic tattoo linework, clean ink shading, professional tattoo flash aesthetic, export quality, 4k, masterpiece", desc: "InkVision SDXL (viktor369-best). Authentic tattoo linework with ControlNet + LoRA." };
  configs["Stable Diffusion 1.5"] = { guidance: 8, extra: "stable diffusion 1.5, versatile high-detail rendering, clean lines, broad style support, crisp output, export quality, 4k, masterpiece", desc: "Free OpenRAIL-M SD 1.5. Massive community support — adaptable across all tattoo styles." };
  configs["FLUX Realism LoRA"] = { guidance: 9, extra: "flux with realism LoRA, detailed tattoo shading, smooth gradient grey wash, lifelike tattoo depth, dramatic ink contrast, export quality, 4k, masterpiece", desc: "Flux + realism LoRA. Detailed tattoo depth — best for black & grey realism tattoos." };
  configs["SDXL Fine Line"] = { guidance: 7, extra: "stable diffusion XL with fine line LoRA, ultra-fine single-needle delicate linework, whisper-thin strokes, minimal shading, airy negative space, export quality, 4k, masterpiece", desc: "SDXL fine-tuned for delicate fine-line tattoos. Ultra-thin single-needle aesthetic." };
  configs["FLUX Black & Grey"] = { guidance: 9, extra: "flux with black and grey realism LoRA, smooth grey-wash gradients, clean tattoo depth, soft tonal transitions, no color, dramatic ink contrast, export quality, 4k, masterpiece", desc: "Flux + B&G LoRA. Smooth grey-wash gradients — clean tattoo depth, no color." };
  configs["SDXL Traditional Bold"] = { guidance: 9, extra: "stable diffusion XL with traditional bold LoRA, bold black outlines, limited saturated palette, high contrast, vintage Sailor Jerry flash, clean whip shading, export quality, 4k, masterpiece", desc: "SDXL tuned for bold American traditional. Thick outlines, limited palette, high contrast." };
  configs["FLUX Japanese Irezumi"] = { guidance: 8, extra: "flux with irezumi LoRA, traditional Japanese tattoo, bold black outlines, flowing wind bars and wave patterns, ukiyo-e woodblock influence, vibrant reds and blues, export quality, 4k, masterpiece", desc: "Flux + irezumi LoRA. Authentic Japanese tattoo aesthetic." };
  configs["SDXL Chicano Fine Line"] = { guidance: 8, extra: "stable diffusion XL with chicano LoRA, single-needle fine line, smooth grey wash, old English lettering influence, lowrider street culture aesthetic, export quality, 4k, masterpiece", desc: "SDXL + Chicano LoRA. Single-needle fine line, lowrider/street culture." };
  configs["FLUX Neo-Traditional"] = { guidance: 8, extra: "flux with neo-traditional LoRA, bold refined outlines, rich ornamental detail, decorative flourishes, jewel-tone saturated color, layered depth, export quality, 4k, masterpiece", desc: "Flux + neo-traditional LoRA. Bold refined outlines, ornamental depth, jewel tones." };
  configs["FLUX Dotwork"] = { guidance: 8, extra: "flux with dotwork LoRA, precise stippling technique, gradient from dot density, pointillist shading, geometric and mandala forms, clean pure-dot aesthetic, export quality, 4k, masterpiece", desc: "Flux + dotwork LoRA. Stippling with dot-density gradients." };
  configs["SDXL Watercolor"] = { guidance: 7, extra: "stable diffusion XL with watercolor-style tattoo LoRA, flowing ink splashes, soft color bleeds, wet-on-wet blending, vibrant translucent washes, export quality, 4k, masterpiece", desc: "SDXL + watercolor-style tattoo LoRA. Flowing ink splashes, soft bleeds, translucent washes." };
  let m = model ? model : "Flux Schnell Free";
  if (!configs[m]) m = "Flux Schnell Free";
  return configs[m];

getModelConfigs() =>
  let result = [];
  let items = modelPreset.selectAll;
  for (let i = 0; i < items.length; i++) {
    let name = items[i].evaluateItem;
    let mc = getModelConfig(name);
    result.push({ name: name, guidance: mc.guidance, extra: mc.extra, desc: mc.desc });
  }
  return result;

// ---- ORIENTATION → RESOLUTION ----
getResolution(orientation) =>
  if (orientation === "portrait") return "512x768";
  if (orientation === "landscape") return "768x512";
  return "768x768";

// ---- SUBJECT PICKER ----
getSubject(category) =>
  let cats = ["animal", "nature", "object", "symbolic", "chicano"];
  let pick = category && category !== "random" ? category : cats[Math.floor(Math.random() * cats.length)];
  return root[pick].selectOne.evaluateItem;

// ---- PLACEMENT-AWARE COMPOSITION ----
// Returns a composition that actually fits the chosen body placement, so the
// prompt never says e.g. "ankle placement, full back composition". A user-
// requested composition is honored only if it is placement-neutral or matches
// the placement; otherwise a placement-appropriate one is picked.
getCompositionForPlacement(placement, requested) =>
  let neutral = ["single centered subject", "intricate central mandala composition, symmetrical radiating detail", "stacked multi-element composition, layered depth", "sprawling interconnected scene, many elements flowing together"];
  if (requested && requested !== "" && (neutral.indexOf(requested) >= 0 || requested.indexOf(placement) >= 0)) return requested;
  let map = {
    "back": ["full back tattoo composition, elaborate and sprawling", "sprawling interconnected scene, many elements flowing together", "stacked multi-element composition, layered depth"],
    "chest": ["chest panel tattoo composition, symmetrical", "intricate central mandala composition, symmetrical radiating detail"],
    "forearm": ["forearm wrap tattoo design, elongated", "single centered subject", "stacked multi-element composition, layered depth"],
    "upper arm": ["single centered subject", "shoulder and arm cap tattoo, wrapping composition", "half sleeve tattoo design, dense detail"],
    "shoulder": ["shoulder and arm cap tattoo, wrapping composition", "single centered subject"],
    "ribs": ["single centered subject", "stacked multi-element composition, layered depth"],
    "thigh": ["large elaborate thigh piece, rich detail", "single centered subject"],
    "calf": ["single centered subject", "stacked multi-element composition, layered depth"],
    "neck": ["single centered subject"],
    "wrist": ["single centered subject"],
    "ankle": ["single centered subject"],
    "spine": ["stacked multi-element composition, layered depth", "single centered subject"],
    "full sleeve": ["full sleeve tattoo design, flowing vertical composition"],
    "half sleeve": ["half sleeve tattoo design, dense detail"]
  };
  let opts = map[placement];
  if (!opts || opts.length === 0) return "single centered subject";
  return opts[Math.floor(Math.random() * opts.length)];

// ---- PER-CARD VARIETY MODIFIERS ----
// Each list adds a randomized descriptor so multi-image generations
// don't all look the same. Picked fresh per card inside buildPrompt.
varPose
  viewed from a dramatic low angle
  seen head-on and symmetrical
  captured in three-quarter profile
  viewed from above looking down
  twisting in dynamic motion
  coiled and tensed mid-strike
  frozen mid-leap with momentum
  static and frontal like a heraldic crest
