    //Niorma
    Lichen^[(((Base == "Black" && Agouti == "Tabby" || Base == "Red") && (Tabby == "Spotted" || Tabby == "Ticked") && !Silver) && (White == "NoWhite" || White == "LowWhite") && Albino == "Normal") && (SouthAm)]
      desc = Niorma hosseusiana. Yellowish green lichen growing on bark, forming cup-shaped fruit bodies with orange insides. Found in South America.
    //Nodobryoria
    Lichen^[(((Base == "Black" || Base == "Chocolate") && Agouti != "Tabby" && (!Silver || Agouti == "Solid")) && (White == "NoWhite") && Albino == "Normal") && (NorthAm)]
      desc = Nodobryoria abbreviata (tufted foxtail lichen). Dark brown/black branching lichen growing on bark. Native to western North America and common in the interior Pacific Northwest, from western Montana and Idaho north into British Columbia and south to Baja California.
    //Normandina
    {Lichen|Blueheart|Heart}^[((Base == "Green") && (White == "NoWhite") && Albino == "Normal") && (NorthAm || Europe || British)]
      desc = Normandina pulchella (elf-ear lichen, blue heart). Tiny green leafy lichen growing on bark. Found primarily in Europe, also known from North America.

    //Oceanoplaca
    Lichen^[((Base == "Red") && (White == "NoWhite") && Albino == "Normal") && (SouthAm || Islands)]
