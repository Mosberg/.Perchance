    {Mushroom^0.5|Bolete}^[(((Base == "Red" && Rufous == "Low") || (Base == "Cream" && Rufous == "High")) && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus aurantiosplendens. Bright yellow mushroom. It is only known from seven sites, in central and western North Carolina, western South Carolina, northern Georgia and eastern Tennessee.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || Base == "CinnamonTort") && Albino == "Normal" && White == "LowWhite") && (NorthAm || MidAm || EastAs || Japan || Islands)]
      desc = Boletus auripes (butter-foot bolete). Pale brown mushroom with a yellow stem and pale pores. In North America, where it is relatively common, the range extends from Alaska south to Mexico, and east to New York. In Central America, it has been recorded in Belize. Also been recorded from Taiwan, China (including Yunnan, Sichuan, Guangdong, Guangxi, and Hunan), Japan, and the Russian Far East.
    {Mushroom^0.5|Bolete}^[((Base == "ChocolateTort" || Base == "Chocolate") && Albino == "Normal" && White == "NoWhite") && (Australia)]
      desc = Boletus barragensis. Brown mushroom with a red stem found in Australia.
    {Mushroom^0.5|Bolete}^[(Base == "White" || (Base == "Cream" && Albino != "Normal" || White != "NoWhite")) && (NorthAm)]
      desc = Boletus barrowsii (white king bolete). White and pale cream mushroom. It is abundant in the warmer parts of its range, namely Arizona and New Mexico, but also occurs in Colorado, west into California and north to British Columbia. It has been recorded from the San Marcos Foothills in Santa Barbara County.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || (Base == "Red" && Rufous == "High")) && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus bicoloroides. Red mushroom found in North America.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || (Base == "Red" && Rufous == "High")) && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus carminiporus. Red mushroom. Known only from North America, its distribution extends from North Carolina south to Florida, and west to Arkansas and Louisiana.
    {Mushroom^0.5|Bolete}^[((Base == "FawnTort") && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus coniferarum (conifer bolete). Pale creamy grey mushroom with yellow pores. Native to North America.
