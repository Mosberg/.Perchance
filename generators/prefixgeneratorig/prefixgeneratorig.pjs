    Lichen^[(Base == "Cream" && (Albino != "Normal" || White == "HighWhite" || White == "MidWhite")) && (British)]
      desc = Ochrolechia frigida. White lichen with cream fruiting bodies. Occurs frequently throughout Scotland and extends southward into northern England and the Snowdonia region of Wales.
    Lichen^[(Base == "Red" && Tabby == "Spotted" && Silver) && (Europe || British || EastAs)]
      desc = Ochrolechia tartarea. White lichen with sparse orange dots. Found across Europe, including the British Isles, and in South Korea.
    Lichen^[(Base == "White") && (NorthAm || Europe || Islands)]
