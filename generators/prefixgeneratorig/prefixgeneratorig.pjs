    Lichen^[(Base == "Green" && White == "NoWhite" && Albino == "Normal") && (Australia || NewZeal)]
      desc = Cladonia darwinii. A green lichen growing in leafy tendrils. Found in Australia and New Zealand.
    {Lichen|Soldier{s|}}^[(White == "NoWhite" && ((Base == "Red" && Rufous == "High") || Base == "Cinnamon" || (Agouti == "Tabby" && !Silver && Base == "BlackTort"))) && (NorthAm || MidAm || SouthAm || Europe || British || NorthAf || SouthAf || WestAs || EastAs || Japan || SEastAs || Australia || NewZeal || Hawaii || Islands)]
      desc = Cladonia didyma (southern soldiers). Lichen growing in leafy stalks with red tips. Found on almost all continents and regions.
    Lichen^[(Base == "Lilac" || Base == "White") && (NorthAm || Europe || WestAs || EastAs)]
