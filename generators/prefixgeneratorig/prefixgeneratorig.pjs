    Lichen^[(Base == "White") && (NorthAm)]
      desc = Dactylina arctica (butterfinger lichen, Arctic finger lichen). White lichen growing as rounded stalks in boreal forests of Canada.
    //Degelia
    Lichen^[(((Base == "Black" && Agouti == "Tabby") || Base == "BlackTort") && White == "NoWhite" && Albino == "Normal") && (Europe || British)]
      desc = Degelia cyanoloma. Dark grey & brown lichen growing on mossy trees. It is found in the Scottish Highlands, western Ireland and Norway (as well as less prolifically in Spain, France and Portugal). 
    Lichen^[((Base == "Blue" || Base == "BlueTort") && (White == "NoWhite" || White == "LowWhite") && Albino == "Normal") && (NorthAm || British)]
