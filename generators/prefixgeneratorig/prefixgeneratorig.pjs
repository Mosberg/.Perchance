    {Mushroom^0.5|Bolete}^[((Base == "Pink" || Base == "FawnTort") && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus michoacanus. Cream pink mushroom with red underside. Found in Mexico.
    {Mushroom^0.5|Bolete}^[((Base == "Pink" || Base == "Cream") && Albino == "Normal" && (White == "NoWhite" || White == "LowWhite")) && (NorthAm || SouthAm)]
