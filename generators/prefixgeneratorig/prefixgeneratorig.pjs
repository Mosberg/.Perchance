// Note: Text that comes after "//" is ignored, which allows
// you to write notes - like the one you're reading now!

selectLeaf = {import:select-leaf-plugin}

title
  Odd Prefix Generator

output
  <b>[pr = selectLeaf(Prefixes)]</b> <br> <small>[pr.desc]</small>
  
Prefixes
  emptyList^0
    No Prefixes Found
      desc = [""]

  Fungi^[document.getElementById('Fungi').checked]
    No Prefixes Found^0
      desc = [""]
    //Earth Tongues
    {Earth|Earthtongue|Tongue|Mushroom^0.5}^[(Base == "Black" && White == "NoWhite" && (Agouti != "Tabby" || Rufous == "Low") && Albino == "Normal" && !Karpati) && (NorthAm || Europe || British)]
      desc = Geoglossum cookeanum. A small black mushroom in the Earth Tongue family, found in the British Isles, France, and North America.
    {Earth|Earthtongue|Tongue|Mushroom^0.5}^[(Base == "Black" && White == "NoWhite" && (Agouti != "Tabby" || Rufous == "Low") && Albino == "Normal" && !Karpati) && (NorthAm || Europe)]
      desc = Geoglossum difforme. A small black mushroom in the Earth Tongue family, found in Europe and North America.
    {Earth|Earthtongue|Tongue|Mushroom^0.5}^[(Base == "Black" && (White == "NoWhite" || White == "LowWhite") && (Agouti != "Tabby" || Rufous == "Low") && Albino == "Normal" && !Karpati) && (Europe || British || Islands)]
      desc = Geoglossum dunense. A small black mushroom in the Earth Tongue family, found in Cyprus, Malta and England.
    {Earth|Tongue|Earthtongue|Mushroom^0.5}^[(Base == "Black" && White == "NoWhite" && (Agouti != "Tabby" || Rufous == "Low") && (Albino == "Normal" || Albino == "Sepia") && !Karpati) && (Islands || EastAs || Japan || SEastAs || Europe || NorthAm)]
      desc = Glutinoglossum glutinosum (viscid black earth tongue, glutinous earthtongue). A small black mushroom in the Earth Tongue family, found in Macaronesia, Asia (Bhutan, China, India, Japan, the Phillipines), Europe, and North America.
    {Earth|Earthtongue|Tongue|Mushroom^0.5}^[(Base == "Black" && White == "NoWhite" && (Agouti != "Tabby" || Rufous == "Low") && Albino == "Normal" && !Karpati) && (Europe)]
      desc = Sabuloglossum arenarium. A black mushroom in the Earth Tongue family, found in Europe.
    {Earth|Earthtongue|Tongue{s|}|Mushroom^0.5}^[(Base == "Black" && White == "NoWhite" && (Agouti != "Tabby" || Rufous == "Low") && Albino == "Normal" && !Karpati) && (Europe || Islands || NorthAf || SouthAf || NorthAm)]
      desc = Trichoglossum hirsutum (black earth tongues). A black mushroom in the Earth Tongue family, found in Europe, Macaronesia, Africa, and North America.
    //Ascobolus
    Fungus^[((Base == "Black" || Base == "BlackTort" || Base == "Cinnamon" || Base == "CinnamonTort" || Base == "Red") && White == "NoWhite" && !Karpati && !(Agouti != "Solid" && Agouti !="Grizzled" && Silver) && ((Albino == "Sepia" && Base != "Cinnamon" && Base != "cinnamonTort") || Albino == "Normal")) && (Europe)]
      desc = Ascobolus carbonarius. Olive-brown disc-shaped fungus, found in Europe.
    //Caloscypha
    {Fungus|{Orangep|P}eel|Cup|Mushroom^0.5}^[((Base == "BlueTort" || (Base == "Cream" && Rufous == "High") || Base == "Red" || (Base == "Blue" && ((White != "HighWhite" && White !="NoWhite") || Karpati))) && (White == "NoWhite" || Base == "Blue" || (Base == "BlueTort" && Karpati) && (Base != "Cream" || !Silver)) && (Albino == "Normal" || Albino == "Sepia")) && (NorthAm || British || Japan || Europe || WestAs)]
      desc = Caloscypha fulgens (spring orange peel fungus, golden cup, dazzling cup). A cup fungus that may be golden, orange, grey & yellow, or, rarely, blue-grey & white, found in North America (Rocky Mountains & Pacific Northwest). Also found in Britain, Japan, Sweden, the Netherlands, Turkey, and Slovakia.
    //Desert Truffle
    {Truffle|Mushroom^0.5}^[(((Base == "White" || (Base == "Cream" && Silver)) || Base == "Cream" || Base == "Red" || Base == "Cinnamon" || Base == "CinnamonTort" || Base == "Chocolate" || Base == "ChocolateTort" || Base == "Lilac" || Base == "LilacTort" || Base == "Fawn" || Base == "FawnTort") && (White == "NoWhite" || White == "HighWhite" || (Base == "White" || (Base == "Cream" && Silver)))) && (NorthAm)]
      desc = Carbomyces emergens. A desert truffle which may vary from white, to cream, or yellow to brownish-orange. It's found in desert habitats, namely the Chihuahuan desert.
    //Texas Star
    {Cigar|Texasstar|Mushroom^0.5}^[((Base == "Black" || Base == "BlackTort" || Base == "Red" || Base == "BlueTort") && ((White == "NoWhite" && !Karpati) || (Base == "BlackTort" && White != "HighWhite")) && (Base == "Red" || Agouti == "Solid") && (Base == "Black" || !Silver) && ((Base == "Red" && Albino == "Sepia") || Albino == "Normal")) && (NorthAm || Japan || EastAs)]
      desc = Chorioactis geaster (devil's cigar, Texas star). A rare mushroom found in Texas and Japan
    //Gyromitra
    {Morel|Mushroom^2}^[((Base == "BlackTort" || Base == "ChocolateTort") && White == "NoWhite" && Agouti != "Tabby" && Albino == "Normal" && !Karpati) && (NorthAm)]
      desc = Gyromitra ambigua. A mushroom in a false morel genus with an orange stem and a black/dark brown top. Found in North America.
    {Morel|Mushroom^2}^[(Base == "Black" && (White == "MidWhite" || Karpati) && (Agouti != "Tabby" || (Gold != "None" && !Silver && Agouti == "Charcoal")) && Albino == "Normal") && (Islands || Europe)]
      desc = Gyromitra anthracobia. A black mushroom with a white stem which is part of a false morel genus. Found in Cyprus.
    {Morel|Mushroom^2}^[((Base == "Red" || Base == "Cream") && (White == "MidWhite" || Karpati) && !Silver && Albino == "Normal") && (NorthAm)]
      desc = Gyromitra californica. A dull orange-brown mushroom with a white bottom, in a false morel genus. Found in the pacific northwest of the United States.
    {Morel|Red|Mushroom^0.5}^[((Base == "Cinnamon" || Base == "CinnamonTort") && (White == "MidWhite" || Karpati) && (Agouti != "Tabby" || (Gold != "None" && !Silver && Agouti == "Charcoal"))) && (NorthAm)]
      desc = Gyromitra caroliniana (Carolina false morel, big red). A mushroom in a false morel genus, which has a white stem and a wrinkled light brown top. Found in the United States.
    {Morel|Mushroom^2}^[((Base == "Chocolate" || Base == "ChocolateTort") && (White == "LowWhite" || White == "MidWhite" || Karpati) && (Agouti != "Tabby" || (Gold != "None" && !Silver && Agouti == "Charcoal"))) && (NorthAm || Europe || British || WestAs)]
      desc = Gyromitra esculenta. A mushroom in a false morel genus, which has a light stem and a wrinkled red-brown top. It is found in North America, Central Europe, Northern Ireland, and Western Turkey.
    {Morel|Mushroom^2}^[((Base == "Cinnamon" || Base == "Ginger" || Base == "Fawn") && (White == "LowWhite" || White == "MidWhite" || White == "HighWhite" || Karpati) && (Agouti != "Tabby" || (!Silver || Base != "Cinnamon"))) && (NorthAm)]
      desc = Gyromitra fastigiata. A mushroom in a false morel genus, which has a light stem and a wrinkled pinkish-brown top. It is found in North America.
    {Morel^2|{Brain|Bullnose}^2|Mushroom}^[((Base == "Cinnamon" || Base == "Red") && (White == "LowWhite" && !Karpati) && (Agouti != "Tabby" || (!Silver || Base != "Cinnamon"))) && (Europe)]
      desc = Gyromitra gigas (Giants false morel, snow model, snow false morel, calf brain, bull nose). A mushroom in a false morel genus, which has a broad light stem and a wrinkled brown top. It is found in Europe.
    {Morel^2|Saddle^2|Mushroom}^[((Base == "BlackTort" || Base == "Red") && (White == "LowWhite" || White == "MidWhite" || Karpati) && (Agouti != "Tabby" || (!Silver || Base != "BlackTort"))) && (NorthAm || SouthAm || Europe || WestAs || EastAs || SEastAs)]
      desc = Gyromitra infula (hooded false morel, elfin saddle). A mushroom in a false morel genus, which has a white stem and a u-shaped orange top. It is found in North America, but has also been reported in South America, Europe and Asia.
    //Hydnotrya
    {Morel|Mushroom}^[((Base == "Red") && (White == "LowWhite" || White == "MidWhite" || Karpati) && !Silver) && (NorthAm || Europe || Japan)]
      desc = Hydnotrya tulasnei. A mushroom related to a false morel genus, which is round and orange. It is found in North America, Europe and Japan.
    //Wynnella
    Mushroom^[((Base == "Chocolate" || Base == "Cinnamon") && (White == "LowWhite" || White == "MidWhite" || Karpati) && (Agouti != "Tabby")) && (NorthAm || Europe || British || EastAs)]
      desc = Wynnella silvicola. A tube-shaped mushroom which is white on the bottom and fades to brown at the top. It is found in North America, Europe and Asia.
    //Helvella
    {Helvella^2|Cup^2|Mushroom}^[((Base == "Lilac" || Base == "Fawn") && (White == "LowWhite" || Karpati)) && (NorthAm || Europe || WestAs || EastAs || Japan)]
      desc = Helvella acetabulum (cabbage leaf Helvella, vinegar cup, brown ribbed elfin cup). A cup-shaped mushroom which is white on the bottom and brownish-grey at the top. It is found in North America, Europe and Asia.
    {Saddle^2|Mushroom}^[((Base == "Red" || Base == "Cinnamon") && (White == "LowWhite" || White == "MidWhite" || Karpati) && (Agouti != "Tabby" || (Base == "Red" && !Silver))) && (NorthAm || Europe)]
      desc = Helvella albella. A mushroom in the elfin saddle genus, which has a white stem and a u-shaped orange-brown top. It is found in North America and Europe.
    {Saddle^2|Mushroom}^[((Base == "Blue" || Base == "Lilac") && White == "NoWhite" && !Karpati && Albino == "Normal") && (EastAs || Japan || NorthAm || Europe)]
      desc = Helvella atra. A mushroom in the elfin saddle genus, which has a long, thin stem and is completely grey. It is found in China and Japan, but has also been reported in North Carolina, the Eastern USA, Europe, Russia.
    {Saddle^2|Mushroom}^[((Base == "Black") && White == "NoWhite" && !Karpati && Albino == "Normal" && (Agouti == "Solid" || Agouti == "Grizzled")) && (WestAs || EastAs || SEastAs || NorthAm || Europe)]
      desc = Helvella corium. A mushroom in the elfin saddle genus, cup-shaped and entirely black. It is found in North America, Europe, and Asia.
    {Saddle^2|Mushroom}^[((Base == "Blue" || Base == "Lilac") && (White == "HighWhite" || Albino == "Point" || (Albino == "Mink" && Base == "Lilac"))) && (EastAs || NorthAm || Europe)]
      desc = Helvella costifera. A mushroom in the elfin saddle genus, which is white with a grey top. It is found in China, Spain, and North America.
    {Saddle^2|Helvel^2|Mushroom}^[(Base == "White" || (Base == "Cream" && Silver)) && (NorthAm || Europe || EastAs || Japan)]
      desc = Helvella crispa (white saddle, elfin saddle, common helvel). A mushroom in the elfin saddle genus, entirely white. It's found in eastern North America, Europe, China, and Japan.
    {Saddle^2|Mushroom}^[(Base == "White" || (Base == "Cream" && Silver)) && (NorthAm || EastAs)]
      desc = Helvella cupuliformis. A mushroom in the elfin saddle genus, entirely white. It's found in China and Mexico.
    {Saddle^2|Mushroom}^[((Base == "Black") && (White == "MidWhite" || Albino == "Point" || Karpati) && (Agouti == "Solid" || Agouti == "Grizzled")) && (NorthAm)]
      desc = Helvella dryophila. A mushroom in the elfin saddle genus, which is white with a black wrinkled top. It is found in North America.
    {Saddle^2|Helvella^2|Mushroom}^[(Base == "White" || (Base == "Cream" && Silver)) && (NorthAm || Europe || EastAs || Japan)]
      desc = Helvella elastica (flexible Helvella, elastic saddle, brown elfin saddle). A mushroom in the elfin saddle genus, entirely white with a long-thin stem. It's found in western North America, Europe, China, and Japan.
    {Saddle^2|Mushroom}^[((Base == "Fawn" || (Base == "Cream" && !Silver)) && (White == "HighWhite" || White == "MidWhite" || Albino != "Normal" || Karpati)) && (EastAs || Europe)]
      desc = Helvella ephippium. A mushroom in the elfin saddle genus, which is white with a creamy-grey top. It is found in Europe, and China.
    {Saddle^2|Mushroom}^[((Base == "Black") && (White == "MidWhite" || White == "HighWhite" || Albino == "Point" || Karpati) && (Agouti == "Solid" || Agouti == "Grizzled")) && (NorthAm || Europe || British || Japan || EastAs || WestAs)]
      desc = Helvella lacunosa (slate grey saddle, fluted black elfin saddle, elfin saddle). A mushroom in the elfin saddle genus, which is white with a black wrinkled top. It is found in eastern North America, Europe, Japan, China, and India.
    {Saddle^2|Mushroom}^[((Base == "Lilac" || Base == "LilacTort" || Base == "Fawn" || Base == "FawnTort") && (White == "MidWhite" || Albino == "Point" || Karpati)) && (NorthAm)]
      desc = Helvella latispora. A mushroom in the elfin saddle genus, with a white stem and flat greyish cap. Widely distributed across North America.
    {Cup^2|Mushroom}^[((Base == "Blue" || Base == "BlueTort") && ((White == "MidWhite" || Karpati) || (Albino == "Sepia" || Albino == "Mink" || Base == "BlueTort"))) && (NorthAm || SouthAm || Europe)]
      desc = Dissingia leucomelaena (white-footed elf cup). A round mushroom with a hollow center and open top, it is grey and cream, with a white inside. It is rare in North America, and also found in South America and Europe.
    {Saddle^2|Mushroom}^[((Base == "Lilac" || Base == "Fawn") && White == "NoWhite" && Albino == "Normal" && !Karpati && Agouti != "Tabby") && (NorthAm || MidAm || Europe || EastAs || Japan)]
      desc = Helvella macropus. A light grey mushroom in the elfin saddle genus, with a cup-shaped top. Reported in Europe, North America, Central America, China, Japan.
    {Saddle^2|Mushroom}^[((Base == "Black") && White == "NoWhite" && Albino == "Normal" && !Karpati && Agouti != "Tabby") && (Europe)]
      desc = Helvella queletii. A black mushroom in the elfin saddle genus, with a saddle-shaped top. Present in the Balkans(?).
    {Saddle|Mushroom^2}^[((Base == "Blue" || Base == "BlueTort") && White == "NoWhite" && (Albino == "Normal" || Albino == "Sepia") && !Karpati && Agouti != "Tabby") && (NorthAm)]
      desc = Helvella vespertina. A wrinkly grey mushroom in the elfin saddle genus. Found in North America.
    //Morchella
    {Morel|Mushroom}^[((Base == "Cinnamon" || Base == "CinnamonTort" || Base == "Red") && (White == "HighWhite" || Silver || Albino != "Normal")) && (Europe || Islands || WestAs)]
      desc = Morchella anatolica. A white and orange-brown mushroom in the true morel genus. Rare and restricted to the Mediterranian basin, it's known in Turkey, Spain, Cyprus, and Greece.
    {Morel^2|Mushroom}^[((Base == "Cinnamon" || Base == "CinnamonTort" || Base == "Red" || Base == "Cream" || Base == "Lilac" || Base == "LilacTort" || Base == "Fawn" || Base == "FawnTort") && (White == "HighWhite" || White == "MidWhite" || White == "LowWhite" || Silver || Albino != "Normal")) && (NorthAm || WestAs || Australia || Europe || Islands)]
      desc = Morchella rufobrunnea (Blushing morel). A white and orange-brown or pale grey mushroom in the true morel genus. First found in Mexico, it's also present on the west coast of the United States, Israel, Australia, Cyprus, Malta, and Switzerland.
    {Morel^2|Mushroom}^[(Base == "White" || (Silver && Gold == "Wideband")) && (NorthAm || Europe || WestAs)]
      desc = Morchella americana (Yellow morel). A white mushroom with a wrinkled top in the true morel genus. It's found across the United States primarily, but has also been found in Turkey, France, and Germany where it is believed to have been possibly introduced. 
    {Morel|Mushroom}^[((Base == "BlackTort" || Base == "BlueTort") && (White == "MidWhite" || White == "LowWhite" || Karpati || (Silver && Agouti != "Solid") || Albino != "Normal")) && (NorthAm)]
      desc = Morchella diminutiva). A mushroom in the true morel genus, it has a yellow-ish stem, and a black and white wrinkled top. Found in North America.
    {Morel|Mushroom}^[((Base == "Cream" || Base == "Fawn" || Base == "FawnTort" || Base == "Lilac" || Base == "LilacTort" || Base == "Blue" || Base == "BlueTort") && (White == "NoWhite" || White == "LowWhite") && !Karpati && (Albino == "Normal" || Albino == "Sepia")) && (NorthAm || SouthAm || Europe)]
      desc = Morchella esculenta (common morel, morel, yellow morel, true morel, morel mushroom, sponge morel). A mushroom in the true morel genus with a yellowish ir white stem and a wrinkled white, creamy, or grey top. It's found in North America, Brazil, and Bulgaria.
    {Morel|Mushroom}^[((Base == "Cream" || Base == "Fawn" || Base == "FawnTort" || Base == "Lilac" || Base == "LilacTort" || Base == "White") && (White == "NoWhite" || White == "LowWhite" || (Agouti != 'Solid' && Silver && Gold == 'Wideband'))) && (Europe || WestAs)]
      desc = Morchella fluvialis. A mushroom in the true morel genus with a pale stem, and a wrinkled off-white, creamy, or pale grey top. Found in Spain, but also reported in Turkey.
    {Morel|Mushroom}^[((Base == "Ginger" || Base == "Cinnamon" || Base == "CinnamonTort") && ((White == "NoWhite" && Albino != "Normal") || White == "LowWhite" || White == "MidWhite")) && (EastAs || SEastAs || Hawaii || WestAs || NewZeal || NorthAf || SouthAf)]
      desc = Morchella galilaea. A mushroom in the true morel genus with a pale stem, and a wrinkled light brown top. Found in China, Java, Hawaii, Israel, New Zealand, India, Turkey, and some countries in Africa (wasn't specified which).
    {Morel|Mushroom}^[((Base == "Black") && (White == "MidWhite" || Karpati || (Agouti != "Solid" && Silver))) && (NorthAm)]
      desc = Morchella prava. A mushroom in the true morel genus with a white stem and a white and black wrinkled top. Found in North America.
    {Morel|Mushroom}^[((Base == "LilacTort" || Base == "FawnTort") && (White == "MidWhite" || Karpati || Albino != "Normal" || (Agouti != "Solid" && Silver))) && (NorthAm)]
      desc = Morchella sceptriformis. A mushroom in the true morel genus with a white stem and a pale grey or creamy wrinkled top. Thought to be endemic to North America.
    {Morel|Mushroom}^[((Base == "Lilac" || Base == "LilacTort" || Base == "Fawn" || Base == "FawnTort") && (White == "MidWhite" || Karpati || Albino != "Normal" || (Agouti != "Solid" && Silver))) && (Europe)]
      desc = Morchella steppicola (morel of the steppes, blistered morel). A mushroom in the true morel genus with a white stem and a pale grey wrinkled top. Found in Ukraine.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort") && (Agouti == "Tabby" || Base == "BlackTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (NorthAm)]
      desc = Morchella angusticeps (black morel). A mushroom in the true morel genus with a white stem and a black and orange wrinkled top. Found in North America.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort") && (Agouti == "Tabby" || Base == "BlackTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (Islands || WestAs)]
      desc = Morchella arbutiphila. A mushroom in the true morel genus with a white stem and a dark grey and orange wrinkled top. Found only in Cyprus and Turkey.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort") && (Agouti == "Tabby" || Base == "BlackTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite")) && (Australia || NewZeal)]
      desc = Morchella australiana. A mushroom in the true morel genus with a white stem and a dark grey and orange wrinkled top. Found in several places in Australia, and Tasmania.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort" || Base == "Blue" || Base == "BlueTort") && (Agouti == "Tabby" || Base == "BlackTort" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (NorthAm)]
      desc = Morchella brunnea. A mushroom in the true morel genus with a white stem and a dark grey and orange wrinkled top. Found in Oregon.
    {Morel|Mushroom}^[((Base == "Cream" || Base == "Fawn" || Base == "FawnTort" || Base == "Lilac" || Base == "LilacTort" || Base == "Blue" || Base == "BlueTort") && (White == "NoWhite" || White == "LowWhite")) && (Europe)]
      desc = Morchella deliciosa. A mushroom in the true morel genus with a white stem and a wrinkled creamy, or light grey top. It's found in Europe.
    {Morel|Mushroom}^[((Base == "Blue" || Base == "BlueTort") && (Agouti == "Tabby" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (Europe || Islands)]
      desc = Morchella disparilis. A mushroom in the true morel genus with a white stem and a grey and orange wrinkled top. Found in Cyprus, Greece, and Spain.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort" || Base == "Blue" || Base == "BlueTort" || Base == "Fawn" || Base == "FawnTort" || Base == "Cream") && (Agouti == "Tabby" || Base == "BlackTort" || Base == "BlueTort" || Base == "FawnTort" || Base == "Cream") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (Europe || Islands || WestAs)]
      desc = Morchella dunalii. A mushroom in the true morel genus with a white stem and a dark grey and cream wrinkled top, the imature mushroom is creamy in colour. Confirmed across the Mediterranian to be in Balearic islands, Corsica, Cyprus, France, Spain and Turkey.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort" || Base == "Blue" || Base == "BlueTort") && (Agouti == "Tabby" || Base == "BlackTort" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || Karpati)) && (Europe)]
      desc = Morchella elata (black morel). A mushroom in the true morel genus with a white stem and a dark grey and orange wrinkled top. Once applied to several different species, this species name is now used for mushrooms in Europe.
    {Morel|Mushroom}^[((Base == "Blue" || Base == "BlueTort") && (Agouti == "Tabby" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || White == "LowWhite" || Karpati)) && (Europe || NorthAm || EastAs)]
      desc = Morchella eohespera. A mushroom in the true morel genus with a white stem and a grey and cream wrinkled top. Found in some areas of Canada, as well as Washinton state. Also known from Central and Northern Europe, Central China.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort" || Base == "Blue" || Base == "BlueTort" || Base == "LilacTort" || ((Base == "Chocolate" || Base == "Cinnamon") && Silver && Agouti != "Solid")) && (Agouti == "Tabby" || Base == "BlueTort" || Base == "BlackTort" || Base == "LilacTort") && (White == "MidWhite" || White == "LowWhite" || Karpati)) && (NorthAm || Europe || EastAs || WestAs)]
      desc = Morchella importuna. A mushroom in the true morel genus with a white stem and a grey and cream or grey-brown wrinkled top. The immature mushrooms are pale grey and orange. Known from Canada and the United States, but also reported in Turkey, Spain, France, Switzerland, and China where it may have been introduced.
    {Morel|Mushroom}^[((Base == "Black" || Base == "Blue" || Base == "BlueTort" || (Base == "Red" && Rufous == "Low") || (Base == "Cream" && Rufous == "High")) && (Agouti == "Tabby" || Base == "BlackTort" || Base == "BlueTort" || Base == "Red" || Base == "Cream") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || White == "HighWhite" || Karpati)) && (NorthAm)]
      desc = Morchella populiphila. A mushroom in the true morel genus with a white stem and a black, dark grey, dark grey and orange, or yellow-orange wrinkled top. Known to occur in California, Nevada, and Oregon.
    {Morel|Mushroom}^[((Base == "Black" || Base == "BlackTort" || Base == "Blue" || Base == "BlueTort") && ((Agouti == "Tabby" && Tabby == "Ticked" && Gold != "None" && !Silver) || Base == "BlackTort" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || White == "HighWhite" || Karpati)) && (NorthAm)]
      desc = Morchella punctipes. A mushroom in the true morel genus with a white stem and an orange, black-tipped wrinkled top. Widely distributed east of the Rocky Mountains.
    {Morel|Mushroom}^[((Base == "Blue" || Base == "BlueTort") && (Agouti == "Tabby" || Base == "BlueTort") && (Albino == "Normal" || Albino == "Sepia") && (White == "MidWhite" || White == "LowWhite" || Karpati)) && (Europe)]
      desc = Morchella purpurascens (purple morel). A mushroom in the true morel genus with a white stem and a grey and cream wrinkled top.
