    {Mushroom^0.5|Suillus}^[((Base == "Cream") && (Albino != "Normal" || White == "HighWhite" || White == "MidWhite")) && (MidAm)]
      desc = Suillus pseudoalbivelatus. Cream mushroom with a white stem. Found in the Dominican Republic.
