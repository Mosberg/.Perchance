    {Mushroom^0.5|Bolete}^[((Base == "Red" || (Base == "BlackTort" && Silver && Agouti != "Solid")) && (Albino != "Normal" || White == "MidWhite" || White == "HighWhite")) && (NorthAm || MidAm)]
