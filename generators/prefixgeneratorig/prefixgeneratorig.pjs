    {Mushroom^0.5|Suillus}^[(((Base == "Red" && Rufous == "Low") || (Base == "Cream" && Rufous == "High")) && Albino == "Normal" && (White == "NoWhite")) && (NorthAm || Islands)]
      desc = Suillus punctipes (spicy suillus). Yellow mushroom found in Taiwan and North America(? Wikipedia has sources about mushrooms from specifically both).
