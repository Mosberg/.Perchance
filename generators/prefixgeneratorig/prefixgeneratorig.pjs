      desc = Dermatocarpon americanum (American stippleback lichen). Silver-grey lichen with black dots. Grows on rocks from southwestern North American deserts to coastal areas.
    {Lichen|Stippleback}^[((Base == "Blue" || Base == "Lilac" || Base == "Black") && Agouti == "Tabby" && Silver && Tabby == "Ticked" && Albino == "Normal") && (NorthAm)]
      desc = Dermatocarpon atrogranulosum (charred stippleback). White lichen with black speckling. It is found in a few locations in British Columbia, Canada, where it grows on limestone outcrops.
    Lichen^[((Base == "Blue" || Base == "Lilac" || (Base == "Black" && Agouti == "Tabby" && Silver && Tabby == "Ticked")) && (White == "NoWhite") && Albino == "Normal") && (NorthAm || MidAm || SouthAm || Europe || British || WestAs || EastAs || Islands)]
