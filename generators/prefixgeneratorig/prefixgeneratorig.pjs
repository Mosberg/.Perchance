    Mushroom^[(Base == "White" || ((Base == "Lilac") && (Albino != "Normal" || White == "HighWhite"))) && (NorthAm || Europe)]
      desc = Panaeolus alcis. A pale mushroom with a grey-tipped cap. Found in Europe and Canada.
    Mushroom^[(Base == "White" || ((Base == "Cream") && (Albino != "Normal" || White == "HighWhite"))) && (NorthAm || MidAm || SouthAm)]
      desc = Panaeolus antillarum. A white mushroom with a creamy stem. Found from northern North America through Mexico into northern South America.
    Mushroom^[((Base == "CinnamonTort" || Base == "LilacTort" || Base == "FawnTort") && (Albino == "Normal" || Albino == "Sepia") && White == "NoWhite") && (NorthAm || Europe || NorthAf || Hawaii)]
      desc = Panaeolus bisporus. A warm grey mushroom with a brown stem. It has been found in Hawaii, Southern California, North Africa, Spain and Switzerland. 
    Mushroom^[((Base == "Blue" || Base == "BlueTort" || Base == "Lilac" || Base == "LilacTort") && (Albino != "Normal" || White != "NoWhite")) && (SEastAs || Hawaii)]
      desc = Panaeolus cambodginiensis. A white mushroom with a grey-brown stem. It was first described from Cambodia and is widespread throughout the Asian subtropics and Hawaii. 
    {Mushroom^0.5|Mottlegill|Panaeolus|Subbs}^[((Base == "CinnamonTort" || Base == "Cinnamon") && (Albino == "Normal" || Albino == "Sepia") && White == "NoWhite") && (NorthAm || SouthAm || Europe || British || SouthAf || EastAs || SEastAs || Japan || Australia || NewZeal)]
      desc = Panaeolus cinctulus (banded mottlegill, weed Panaeolus, belted panaeolus, or subbs). A brown & orange mushroom. Found across the world, including North America, South America, Europe, South Africa, India, Japan, Phillipenes, Papua New Guinea, Australia, New Zealand.
    Mushroom^[(Base == "White" || ((Base == "Black") && (Albino == "Point" || White == "HighWhite"))) && (NorthAm || MidAm || SouthAm || Europe || British || SouthAf || EastAs || Japan || SEastAs || Australia || NewZeal || Islands)]
      desc = Panaeolus cyanescens. A pale mushroom with black gills. It has been found in Vietnam, Africa (including South Africa, Madagascar and Democratic Republic of the Congo), Australia, Belize, the Caribbean (Bermuda, Grenada, Barbados Jamaica, Trinidad, and Puerto Rico) Costa Rica, India, Malaysia, Indonesia, Sri Lanka, Cambodia, Thailand, Japan, Mexico, Oceania (Fiji and Samoa), the Philippines, South America (Bolivia, Brazil, Paraguay, Colombia, Venezuela, and Ecuador), South Korea, and the United States (California, Hawaii, Louisiana, Mississippi, Alabama, Florida, Tennessee, Texas, Kentucky, Virginia, and North Carolina). 
    {Mushroom|Mottlegill}^[((Base == "Lilac" || Base == "Fawn" || Base == "LilacTort" || Base == "FawnTort") && White == "NoWhite" && (Albino == "Normal" || Albino == "Sepia")) && (NorthAm || MidAm || SouthAm || Europe || WestAs || NorthAf || SouthAf)]
      desc = Panaeolus fimicola (turf mottlegill). A creamy grey mushroom with brown stem. It is widespread and common across the Americas, as well as Europe and Africa. It has also been found in Turkey.
    {Mushroom|Haymaker|Panaeolus^0.5}^[(Base == "Chocolate" || Base == "ChocolateTort" || Base == "Lilac" || Base == "Fawn" || Base == "LilacTort" || Base == "FawnTort") && (NorthAm)]
      desc = Panaeolus foenisecii (mower's mushroom, haymaker, haymaker's panaeolus, or brown hay mushroom). Grey-brown mushroom with a pale stem. Found throughout North America.
    Mushroom^[((Base == "Blue" || Base == "BlueTort" || Base == "Lilac" || Base == "LilacTort" || Base == "Fawn" || Base == "FawnTort")) && (NorthAm || SouthAm || NewZeal || British)]
      desc = Panaeolus olivaceus. A pale mushroom with a grey-edged cap. Grows across North and South America, likely more widely distributed; it has been collected in the U.S. states of Washington, Oregon, Florida, Georgia, South Carolina, Minnesota, Canada's Quebec, New Zealand and in the United Kingdom.
    {Mushroom|Mottlegill}^[((Base == "Blue" || Base == "BlueTort" || Base == "Lilac" || Base == "Fawn" || Base == "LilacTort" || Base == "FawnTort" || Base == "Cream")) && (NorthAm || MidAm || SouthAm || Europe || WestAs || SEastAs || SouthAf)]
      desc = Panaeolus papilionaceus (Petticoat mottlegill). A grey or cream mushroom with brown stem. It can be found in countries including Canada (Alberta, British Columbia), the United States (Alabama, Alaska, California, Colorado, Florida, Georgia, Indiana, Louisiana, Maine, Massachusetts, Missouri, Montana, New Mexico, New York, Oklahoma, Texas, Washington), the Caribbean (Bahamas, Cuba, San Vincent Island), Chile, Colombia, Uruguay, France, The Netherlands, Greece, Mexico, Norway, Slovenia, South Africa, Uganda, China, Iran, Lithuania, Kuwait, and the Philippines. 
    Mushroom^[((Base == "Cream" || Base == "Blue" || Base == "BlueTort") && (White == "HighWhite" || Albino != "Normal")) && (NorthAm || NorthAf || SouthAf || SEastAs || Japan || Hawaii)]
      desc = Panaeolus tropicalis. A light mushroom with a cream or dark grey cap.  It is most often found in Hawaii, Central Africa, and Cambodia; it can also be found in Mexico, Tanzania, the Philippines, Florida, and Japan. 
    //Panellus
    Mushroom^[(Base == "White") && (NorthAm || SouthAm || Europe || EastAs || Australia)]
      desc = Panellus pusillus. A white fungus. A widely distributed species, it has been recorded in Australia, Asia, Europe, North America, and South America.
