    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || (Base == "Red" && Rufous == "High")) && Albino == "Normal" && (White == "MidWhite" || White == "LowWhite")) && (EastAs || SEastAs || Japan || Australia || Islands)]
      desc = Boletellus obscurecoccineus (rhubarb bolete). Red mushroom with a partly white stem and white underside to its cap. The distribution includes Korea, New Guinea, Java, Borneo, Japan, and Taiwan. Within Australia, the rhubarb bolete has been recorded from southwestern Western Australia, and the southeast of New South Wales, and into Victoria and Tasmania.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || Base == "CinnamonTort") && (Albino != "Normal" || White == "HighWhite")) && (NorthAm)]
      desc = Boletellus singerii. White mushroom with a wrinkly, brown-tipped cap. Known from the municipality of Tejupilco in Mexico.

