    //Nephroma
    Lichen^[((Base == "Green") && (White == "NoWhite") && Albino == "Normal") && (NorthAm || Islands)]
      desc = Nephroma arcticum (arctic kidney lichen). Large leafy lichen growing on ground. Arctic distribution, found in Alaska, northern Canada, and Greenland.
    Lichen^[((Base == "Green") && (White == "NoWhite") && Albino == "Normal") && (SouthAm || Australia || NewZeal || Islands)]
      desc = Nephroma australe. Large leafy lichen growing on ground. Found in cool temperate rainforests of Australasia and southern South America, with a wide distribution in New Zealand, including Stewart and Chatham Islands.
    Lichen^[(((Base == "Black" || Base == "Blue") && Agouti != "Tabby" && (!Silver || Agouti == "Solid")) && (White == "NoWhite") && Albino == "Normal") && (NorthAm || Europe)]
      desc = Nephroma helveticum (fringed kidney lichen). Dark grey-green leafy lichen. Found in North America, and more rarely in Europe.
    //Niebla
    Lichen^[(Base == "White") && (NorthAm)]
      desc = Niebla arenaria. Off-white shrub-like lichen. Grows along the Pacific Coast of North America in the fog regions of the northern peninsula of Baja California from near Colonet south to Morro Santo Domingo.
    Lichen^[(Base == "White") && (NorthAm || Islands)]
      desc = Niebla homalea. Off-white shrub-like lichen. Grows on rocks along the Pacific Coast of North America, from Mendocino County, California south to Bahía de San Quintín on the main peninsula of Baja California, and in the Channel Islands and on Guadalupe Island.
    Lichen^[(Base == "White") && (NorthAm)]
