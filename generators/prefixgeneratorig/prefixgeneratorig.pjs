    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || Base == "CinnamonTort" || (Base == "Red" && Rufous == "High")) && Albino == "Normal" && White == "NoWhite") && (NorthAm)]
      desc = Boletus harrisonii. Red mushroom with yellow pores found in the United States.
    {Mushroom^0.5|Bolete}^[((Base == "Chocolate") && Albino == "Normal" && (White == "NoWhite" || White == "LowWhite")) && (Japan)]
      desc = Boletus hiratsukae. Dark brown mushroom found in Japan.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || Base == "CinnamonTort" || (Base == "Red" && Rufous == "High")) && (Albino != "Normal" || White == "HighWhite")) && (NewZeal)]
      desc = Boletus leptospermi. White mushroom with pale yellow pores and red-splotched cap. Found on both the North and South island of New Zealand.
    {Mushroom^0.5|Bolete}^[((Base == "Cinnamon" || Base == "CinnamonTort") && Albino == "Normal" && White == "NoWhite") && (SouthAm)]
