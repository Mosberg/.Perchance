    {Mushroom^0.5|Coral}^[((Base == "Purple") && (White == "NoWhite") && (Albino == "Normal" || Albino == "Sepia")) && (NorthAm || SouthAm || Europe || British || EastAs || SEastAs || Australia || NewZeal)]
