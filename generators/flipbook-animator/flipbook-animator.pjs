$meta
  title = Flipbook Animator
  description = A simple flipbook-style 2D frame-by-frame animator with onion skinning, playback, and multiple drawing tools.
  tags = animation, flipbook, drawing, art

// Default settings — tweak these to change the app's defaults
defaultTool = pen
defaultColor = #1a1a2e
defaultSize = 11
defaultFps = 12
canvasWidth = 960
canvasHeight = 540
maxBrushSize = 80

commentsPlugin = {import:comments-plugin}
uploadPlugin = {import:upload-plugin}
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

// Minimum number of frames required before the "Predict Frame" button appears
predictMinFrames = 2

galleryOnLoad(comments) =>
  let entries = [];
  for (let i = 0; i < comments.length; i++) {
    let msg = comments[i].message || "";
    if (msg.indexOf("FLIPBOOK_GALLERY:") === 0) {
      try {
        let data = JSON.parse(msg.slice(17));
        if (data && data.url) entries.push(data);
      } catch(e) {}
    }
  }
  window.galleryData = window.galleryData || {};
  window.galleryData.entries = entries;
  window.galleryData.loaded = true;
  if (window.galleryRefresh) window.galleryRefresh();

galleryOnComment(comment) =>
  let msg = comment.message || "";
  if (msg.indexOf("FLIPBOOK_GALLERY:") === 0) {
    try {
      let data = JSON.parse(msg.slice(17));
      if (data && data.url) {
        window.galleryData = window.galleryData || {};
        if (!window.galleryData.entries) window.galleryData.entries = [];
        window.galleryData.entries.push(data);
        if (window.galleryRefresh) window.galleryRefresh();
      }
    } catch(e) {}
  }
