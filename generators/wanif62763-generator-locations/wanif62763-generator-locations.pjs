joinLists = {import:join-lists-plugin}
filterList = {import:filter-list-plugin}

title = Location Generator
description = Provides data for the Location dropdown on <a href="https://perchance.org/wanif62763-generator">https://perchance.org/wanif62763-generator</a>

$output = [joinLists(location, home, urban, rusticCozy, cafe, campus, business, hospitality, coastal, gardens, nature, heritage, entertainment, everyday, fantasy)]

