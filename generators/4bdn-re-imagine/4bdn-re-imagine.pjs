generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}

title
  4BDN Re-Imagine Image Engine

// Style presets. Format: "Label|prompt suffix"
stylePresets
  None|
  Oil Painting|oil painting, thick brush strokes, impressionist style
  Anime|anime, cel shaded, vibrant colors, studio ghibli inspired
  Watercolor|watercolor, soft edges, delicate washes of color
  Cyberpunk|cyberpunk, neon lights, futuristic, cinematic lighting
  Pixel Art|pixel art, 8-bit, retro game style
  Low Poly|low poly 3d render, flat shading, isometric
  Pencil Sketch|pencil sketch, graphite, detailed cross-hatching
  Renaissance|Renaissance oil painting, dramatic chiaroscuro lighting
  Vaporwave|vaporwave, pastel gradient, retro 80s aesthetic
  Claymation|claymation, stop motion, textured clay, handmade
  Stained Glass|stained glass window, leaded panels, luminous color
  Ink Wash|ink wash painting, sumi-e, minimalist, asian brush art
  Photoreal|photorealistic, ultra detailed, 8k, professional photography
  Fantasy Art|fantasy art, digital painting, magical atmosphere, trending on artstation
  Noir|film noir, black and white, high contrast, dramatic shadows
  Pop Art|pop art, bold colors, comic book style, Roy Lichtenstein inspired
  Ukiyo-e|ukiyo-e, japanese woodblock print, traditional, flat colors
  Concept Art|concept art, matte painting, cinematic, volumetric lighting
  Pixel Portrait|pixel art portrait, 16-bit, detailed sprite
  Steampunk|steampunk, brass gears, victorian, sepia tones, mechanical
  Surrealist|surrealist art, dreamlike, salvador dali inspired, melting
  Art Deco|art deco, geometric patterns, gold and black, 1920s elegance
  Gothic|gothic art, dark mood, ornate, cathedral atmosphere
  Comic Book|comic book illustration, halftone dots, bold outlines, dynamic

negativePromptDefault = blurry, low quality, distorted, deformed, ugly, watermark, text, signature, jpeg artifacts, extra limbs, bad anatomy, disfigured

// Mode selector: reimagine (full) or edit (inpaint masked region)
modes
  Reimagine|reimagine
  Edit Region (Inpaint)|edit
