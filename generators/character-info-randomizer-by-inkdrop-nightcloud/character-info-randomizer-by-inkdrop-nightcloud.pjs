// Note: This project is very WIP!! 0-0 (edit:not anymore, its much more finished now :D)
// another note : This is technically version 4.0 of this project of mine! 
// the first 3 variants were built on scratch, the best functioning one can be found here : https://scratch.mit.edu/projects/957075448/
locker = {import:locker-plugin}
copyText = {import:copy-text-plugin}
selectRange = {import:select-range-plugin}
title
  Inkdrop Nightcloud's <br> Character info randomizer

output
  <b>Name</b> : [locker ("fn", fname.evaluateItem)] [locker ("ln", lname.evaluateItem)] <br> <b>Gender & pronouns</b> : [locker ("gp", gender.evaluateItem)] <br> <b>Romantic orientation &/or Sexuality</b> : [locker ("ros", ros.evaluateItem)] <br><b>Species</b> : [locker("sp", spec.evaluateItem)]  <br> <b>Power or ability</b> : [locker ("pa", ability.evaluateItem)]  <br><b>Trait 1</b> : [locker ("t1", trait1.selectOne)]  || <b>Trait 2</b> : [locker ("t2", trait2.selectOne)] <br> <b>Hobby</b> : [locker ("hb", hobby.selectOne)]  <br><b>Birthday</b> : [locker ("bd", bday.evaluateItem)]  || <b>Age</b> : [locker ("ag", age.evaluateItem)] <br> <b>Likes</b> : [locker ("lks", likesdislikes.selectOne)] || <b>Dislikes</b> : [locker ("dlks", likesdislikes.selectOne)]

locks
  Output locks<br>First name ([locker ("fn_button")])Last name ([locker ("ln_button")]) Gender/pronouns ([locker ("gp_button")]) <br> RomOri/Sexuality ([locker ("ros_button")]) Species ([locker("sp_button")])<br> Power/ability ([locker ("pa_button")]) Trait 1 ([locker ("t1_button")]) Trait 2 ([locker ("t2_button")]) <br> Hobby ([locker ("hb_button")]) B-day ([locker ("bd_button")]) Age ([locker("ag_button")]) <br> Likes ([locker ("lks_button")]) Dislikes ([locker ("dlks_button")])

copy
  [c.evaluateItem.replaceText('<br>',"").replaceText('<b>', "(").replaceText('</b>',")")]


fname
  [firstname]^8
  [lastname]^0.5

lname
  [lastname]^12
  [lastname]-[lastname]^3
  [firstname]-[lastname]^0.1
  [lastname]-[firstname]^0.1
  [firstname]^0.3

ros
  [romori]
  [romori] [sexuality]
  [sexuality]
  [romori] + Polyamorous^0.1
  [romori] [sexuality] + Polyamorous^0.1
  [sexuality] + Polyamorous^0.1

spec
  [species.furred]^[st1.checked]
  [species.reptilianish]^[st2.checked]
  [species.bird]^[st3.checked]
  [species.underwater]^[st4.checked]
  [species.humanish]^[st5.checked]
  <b>(No species type selected!)</b>^[!st1.checked && !st2.checked && !st3.checked && !st4.checked && !st5.checked]
  
