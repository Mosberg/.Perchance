generateAttributeDropdownsHtml() =>
  let configs = getAttributeDropdowns();
  let html = '<div style="margin-bottom:0.5rem; display:flex; gap:0.3rem; align-items:center;">';
  html += '<input type="text" id="attrSearchEl" placeholder="🔍 Search settings..." oninput="clearTimeout(window.attrSearchTimer); window.attrSearchTimer = setTimeout(filterAttributeDropdowns, 150);" style="flex:1; padding:0.3rem; border-radius:4px; border:1px solid #555; background:transparent; color:inherit; font-size:85%; box-sizing:border-box;">';
  html += '</div>';
  html += '<div id="attrSearchResultsEl" style="display:none; margin-bottom:0.5rem; border:1px solid #444; border-radius:4px; padding:0.5rem; max-height:300px; overflow-y:auto;"></div>';
  html += '<div id="favouriteSettingsEl" style="margin-bottom:0.5rem; display:none; border:1px dashed #444; padding:0.5rem; border-radius:4px;"><b style="font-size:80%; opacity:0.7;">❤ Favourites</b><div id="favouriteSettingsListEl" style="display:flex; flex-wrap:wrap; gap:0.3rem; margin-top:0.3rem;"></div></div>';
  for(let category in configs) {
    let safeCatId = "attrCat_" + category.replace(/[^a-zA-Z0-9]/g, "");
    html += '<div class="panel collapsed" id="' + safeCatId + '" style="margin-bottom:0.5rem; border:1px solid var(--panel-border, #444); border-radius:4px; overflow:hidden;">';
    html += '<div class="panel-header" onclick="togglePanel(\'' + safeCatId + '\')" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer; background:var(--panel-header-bg, #e0e0e0); padding:0.4rem 0.6rem; font-size:85%;">';
    html += '<span style="font-weight:bold; opacity:0.8;">' + category + '</span>';
    html += '<span class="panel-chevron">▶</span>';
    html += '</div>';
    html += '<div class="panel-body" style="padding:0.5rem;">';
    html += '<div style="display:flex; flex-wrap:wrap; gap:0.3rem;">';
    for(let subList in configs[category]) {
      let safeId = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      html += '<div class="attr-item" data-name="' + subList.toLowerCase() + '" data-name-orig="' + subList + '" style="display:flex; align-items:center; border:1px solid #444; border-radius:4px; padding:0.2rem 0.4rem; font-size:75%;">';
      html += '<span class="fav-btn" onclick="toggleFavouriteSetting(\'' + safeId + '\')" style="cursor:pointer; margin-right:0.3rem; opacity:0.7;">♡</span>';
      html += '<span style="margin-right:0.3rem; opacity:0.7; white-space:nowrap;">' + subList + ':</span>';
      html += '<select id="' + safeId + '" onchange="localStorage.setItem(\'' + safeId + '\', this.value); updateFavouriteSettingIcons();" style="max-width:120px; font-size:90%; padding:0.1rem 0.2rem; border:1px solid #555; border-radius:3px; background:transparent; color:inherit;">';
      html += '<option value="Any">Any</option>';
      if(subList !== "●" && subList !== "●") {
        html += '<option value="Random">Random</option>';
      }
      for(let opt of configs[category][subList]) {
        html += '<option value="' + opt + '">' + opt + '</option>';
      }
      html += '</select>';
      html += '</div>';
    }
    html += '</div></div></div>';
  }
  html += '<div style="margin-top:0.5rem; text-align:right;"><button class="small-btn clear-btn" onclick="clearAllAttributes()">🗑️ clear all settings</button></div>';
  return html;

buildAttributeSearchCache() =>
  if(window.attributeSearchCache) return window.attributeSearchCache;
  let configs = getAttributeDropdowns();
  let cache = [];
  for(let category in configs) {
    for(let subList in configs[category]) {
      let safeId = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      for(let opt of configs[category][subList]) {
        if(opt === "Any" || opt === "None" || opt === "Random") continue;
        cache.push({
          text: opt,
          value: opt,
          listName: subList,
          safeId: safeId,
          searchText: (opt + " " + subList).toLowerCase()
        });
      }
    }
  }
  window.attributeSearchCache = cache;
  return cache;

filterAttributeDropdowns() =>
  let term = (document.getElementById("attrSearchEl").value || "").toLowerCase().trim();
  let resultsEl = document.getElementById("attrSearchResultsEl");
  let panels = document.querySelectorAll('[id^="attrCat_"]');
  let favEl = document.getElementById("favouriteSettingsEl");
  
  // If search is empty, just un-hide the panels and exit immediately. 
  // (No need to loop through thousands of items anymore!)
  if(!term) {
    if(resultsEl) { resultsEl.style.display = "none"; resultsEl.innerHTML = ""; }
    for(let p of panels) p.style.display = "";
    if(favEl) favEl.style.display = "";
    return;
  }
  
  // Hide panels to show search results
  for(let p of panels) p.style.display = "none";
  if(favEl) favEl.style.display = "none";
  
  let cache = buildAttributeSearchCache();
  let matches = [];
  let maxResults = 300; // Cap results so the browser doesn't freeze
  let totalMatches = 0;
  
  for(let i=0; i<cache.length; i++) {
    if(cache[i].searchText.includes(term)) {
      totalMatches++;
      if(matches.length < maxResults) {
        matches.push(cache[i]);
      }
    }
  }
  
  if(resultsEl) {
    if(matches.length === 0) {
      resultsEl.innerHTML = '<div style="opacity:0.5; font-size:80%; text-align:center; padding:0.5rem;">No results found.</div>';
    } else {
      let html = '';
      for(let m of matches) {
        let safeVal = m.value.replace(/'/g, "\\'");
        let safeId = m.safeId.replace(/'/g, "\\'");
        html += '<div onclick="selectSearchResult(\'' + safeId + '\', \'' + safeVal + '\')" style="cursor:pointer; padding:0.3rem 0.4rem; font-size:80%; border-bottom:1px solid #333;" onmouseover="this.style.background=\'rgba(19,160,0,0.1)\'" onmouseout="this.style.background=\'\'">';
        html += m.text + ' <span style="opacity:0.5;">(' + m.listName + ')</span>';
        html += '</div>';
      }
      // Tell the user there are more results so they know to type more
      if(totalMatches > maxResults) {
        html += '<div style="opacity:0.6; font-size:80%; text-align:center; padding:0.5rem;">Showing first 300 results. Type more letters to narrow down...</div>';
      }
      resultsEl.innerHTML = html;
    }
    resultsEl.style.display = "block";
  }

selectSearchResult(safeId, value) =>
  let el = document.getElementById(safeId);
  if(!el) return;
  el.value = value;
  localStorage.setItem(safeId, value);
  let panel = el.closest(".panel");
  if(panel && panel.classList.contains("collapsed")) {
    panel.classList.remove("collapsed");
    let body = panel.querySelector('.panel-body');
    if(body) body.style.display = 'block';
    let chevron = panel.querySelector('.panel-chevron');
    if(chevron) chevron.textContent = '▼';
  }
  let searchEl = document.getElementById("attrSearchEl");
  if(searchEl) searchEl.value = "";
  filterAttributeDropdowns();
  updateFavouriteSettingIcons();
  el.scrollIntoView({behavior:"smooth", block:"center"});
  el.style.outline = "2px solid #13a000";
  setTimeout(() => { if(el) el.style.outline = ""; }, 2000);

getFavouriteSettings() =>
  let raw = JSON.parse(localStorage.favouriteSettings || "[]");
  return raw.map(f => typeof f === "string" ? {value: f, safeId: null} : f);

toggleFavouriteSetting(safeId) =>
  let el = document.getElementById(safeId);
  if(!el || !el.value || el.value === "Any" || el.value === "None" || el.value === "Random") return;
  let val = el.value;
  let favs = getFavouriteSettings();
  let existingIdx = favs.findIndex(f => f.value === val && (!f.safeId || f.safeId === safeId));
  if(existingIdx !== -1) {
    favs.splice(existingIdx, 1);
  } else {
    favs.push({value: val, safeId: safeId});
  }
  localStorage.favouriteSettings = JSON.stringify(favs);
  renderFavouriteSettings();
  updateFavouriteSettingIcons();

removeFavouriteSetting(value, safeId) =>
  let favs = getFavouriteSettings();
  favs = favs.filter(f => !(f.value === value && (!safeId || !f.safeId || f.safeId === safeId)));
  localStorage.favouriteSettings = JSON.stringify(favs);
  renderFavouriteSettings();
  updateFavouriteSettingIcons();

selectFavouriteSetting(value, safeId) =>
  if(safeId) {
    let el = document.getElementById(safeId);
    if(el) {
      el.value = value;
      localStorage.setItem(safeId, value);
      let panel = el.closest(".panel");
      if(panel && panel.classList.contains("collapsed")) {
        panel.classList.remove("collapsed");
        let body = panel.querySelector('.panel-body');
        if(body) body.style.display = 'block';
        let chevron = panel.querySelector('.panel-chevron');
        if(chevron) chevron.textContent = '▼';
      }
      el.scrollIntoView({behavior:"smooth", block:"center"});
      el.style.outline = "2px solid #13a000";
      setTimeout(() => { if(el) el.style.outline = ""; }, 2000);
      updateFavouriteSettingIcons();
      return;
    }
  }
  let configs = getAttributeDropdowns();
  for(let category in configs) {
    for(let subList in configs[category]) {
      let id = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      let el = document.getElementById(id);
      if(el) {
        for(let i=0; i<el.options.length; i++) {
          if(el.options[i].value === value) {
            el.value = value;
            localStorage.setItem(id, value);
            let panel = el.closest(".panel");
            if(panel && panel.classList.contains("collapsed")) {
              panel.classList.remove("collapsed");
              let body = panel.querySelector('.panel-body');
              if(body) body.style.display = 'block';
              let chevron = panel.querySelector('.panel-chevron');
              if(chevron) chevron.textContent = '▼';
            }
            el.scrollIntoView({behavior:"smooth", block:"center"});
            el.style.outline = "2px solid #13a000";
            setTimeout(() => { if(el) el.style.outline = ""; }, 2000);
            updateFavouriteSettingIcons();
            return;
          }
        }
      }
    }
  }

updateFavouriteSettingIcons() =>
  let favs = getFavouriteSettings();
  let favValues = favs.map(f => f.value);
  let items = document.querySelectorAll(".attr-item");
  for(let item of items) {
    let selectEl = item.querySelector("select");
    if(!selectEl) continue;
    let val = selectEl.value;
    let btn = item.querySelector(".fav-btn");
    if(btn && val && favValues.includes(val)) btn.textContent = "❤";
    else if(btn) btn.textContent = "♡";
    
    for(let i=0; i<selectEl.options.length; i++) {
      let opt = selectEl.options[i];
      let baseName = opt.value;
      if(baseName === "Any" || baseName === "None" || baseName === "Random") continue;
      opt.textContent = baseName + (favValues.includes(baseName) ? " ♡" : "");
    }
  }

renderFavouriteSettings() =>
  let favs = getFavouriteSettings();
  let container = document.getElementById("favouriteSettingsListEl");
  let parent = document.getElementById("favouriteSettingsEl");
  if(!container || !parent) return;
  if(favs.length === 0) { parent.style.display = "none"; return; }
  parent.style.display = "block";
  container.innerHTML = "";
  for(let fav of favs) {
    let div = document.createElement("div");
    div.style.cssText = "display:flex; align-items:center; gap:0.2rem; border:1px solid #444; border-radius:4px; padding:0.2rem 0.4rem; font-size:75%;";
    let safeVal = fav.value.replace(/'/g, "\\'").replace(/"/g, "&quot;");
    let safeId = (fav.safeId || "").replace(/'/g, "\\'");
    div.innerHTML = '<span onclick="selectFavouriteSetting(\'' + safeVal + '\', \'' + safeId + '\')" style="opacity:0.7; cursor:pointer; flex:1;">' + fav.value + ' ❤</span><span onclick="removeFavouriteSetting(\'' + safeVal + '\', \'' + safeId + '\')" style="cursor:pointer;">🗑</span>';
    container.appendChild(div);
  }

clearAllAttributes() =>
  if(!confirm("Clear all attribute settings?")) return;
  let configs = getAttributeDropdowns();
  for(let category in configs) {
    for(let subList in configs[category]) {
      let safeId = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      let el = document.getElementById(safeId);
      if(el) {
        el.value = "Any";
        localStorage.removeItem(safeId);
      }
    }
  }

restoreAttributeDropdownValues() =>
  let configs = getAttributeDropdowns();
  for(let category in configs) {
    for(let subList in configs[category]) {
      let safeId = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      let el = document.getElementById(safeId);
      if(el) {
        let saved = localStorage.getItem(safeId);
        if(saved) el.value = saved;
      }
    }
  }
  renderFavouriteSettings();
  updateFavouriteSettingIcons();

getSelectedAttributes() =>
  let configs = getAttributeDropdowns();
  let attrs = [];
  for(let category in configs) {
    for(let subList in configs[category]) {
      let safeId = "attr_" + category.replace(/[^a-zA-Z0-9]/g, "") + "_" + subList.replace(/[^a-zA-Z0-9]/g, "");
      let el = document.getElementById(safeId);
      if(el && el.value && el.value !== "Any" && el.value !== "None") {
        let val = el.value;
        if(val === "Random") {
          let opts = configs[category][subList].filter(o => o !== "Any" && o !== "None" && o !== "Random");
          if(opts.length > 0) {
            val = opts[Math.floor(Math.random() * opts.length)];
          } else {
            continue;
          }
        }
        let promptVal = val;
        
        // Use .includes() instead of === to ignore the emojis in the subList names
        if(subList.includes("Species") && speciesPrompts[val]) {
          promptVal = speciesPrompts[val].evaluateItem;
        } else if(subList.includes("Fictional places") && fictionalplacesPrompts[val]) {
          promptVal = fictionalplacesPrompts[val].evaluateItem;
        } else if(subList.includes("Aesthetic") && aestheticPrompts[val]) {
          promptVal = aestheticPrompts[val].evaluateItem;
        } else {
          let promptDict = null;
          if(category === "🎨Art Style") {
            if(subList.includes("Photography")) promptDict = photoPrompts;
            else if(subList.includes("3D/CGI")) promptDict = threedPrompts;
            else if(subList.includes("Anime")) promptDict = artAnimePrompts;
            else if(subList.includes("Illustration")) promptDict = illustrationPrompts;
            else if(subList.includes("Cartoon")) promptDict = artCartoonPrompts;
            else if(subList.includes("Painting")) promptDict = paintingPrompts;
            else if(subList.includes("Vintage art")) promptDict = vintageArtPrompts;
            else if(subList.includes("Icons & Stickers")) promptDict = iconsStickersPrompts;
            else if(subList.includes("Artist")) promptDict = artistPrompts;
            else if(subList.includes("Figurines/Dolls/Sculptures")) promptDict = figurinesPrompts;
            else if(subList.includes("Various")) promptDict = variousPrompts;
          } else if(category === "🧚‍♀️Character Design") {
            if(subList.includes("Anime")) promptDict = charAnimePrompts;
            else if(subList.includes("Cartoon")) promptDict = charCartoonPrompts;
            else if(subList.includes("3D Animation")) promptDict = char3DAnimationPrompts;
            else if(subList === "3D Games") promptDict = char3DVideoGamesPrompts; // Fixed naming mismatch
            else if(subList === "2D Games") promptDict = char2DVideoGamesPrompts; // Fixed naming mismatch
            else if(subList === "Anime Games") promptDict = charAnimeVideoGamesPrompts; // Fixed naming mismatch
          }
          if(promptDict && promptDict[val]) {
            promptVal = promptDict[val].evaluateItem;
          }
        }
        if(promptVal) attrs.push(promptVal);
      }
    }
  }
  return attrs.length > 0 ? attrs.join(", ") : "";

getGuidanceScale() =>
  let el = document.getElementById("guidanceScaleEl");
  if(el && el.value && el.value !== "Any") {
    let val = el.value;
    if(val === "Random") val = Math.floor(Math.random() * 30) + 1;
    return `(guidanceScale:::${val})`;
  }
  return "";

getAestheticRank() =>
  let el = document.getElementById("aestheticRankEl");
  if(el && el.value && el.value !== "Any") {
    let val = el.value;
    if(val === "Random") val = Math.floor(Math.random() * 12);
    return `${val},`;
  }
  return "";

getSeedValue() =>
  let el = document.getElementById("seedEl");
  if(el && el.value.trim() !== "") {
    return `(seed:::${el.value.trim()})`;
  }
  return "";

////////////////////////////////////////
//   SHARED UTILITIES                 //
////////////////////////////////////////

getSelectedTones() =>
  let val = toneEl.value;
  if(val === "Random") {
    let keys = ["Concise", "Grounded", "Casual", "Dramatic", "Thrilling / Action", "Dark / Gritty", "Light-hearted / Comedic", "Mysterious", "Tragic", "Whimsical", "Epic", "Romantic", "Affectionate", "Flirtatious", "Sensual"];
    val = keys[Math.floor(Math.random() * keys.length)];
  }
  return val && val !== "Any" ? [val] : ["Any"];
  
getDetailsContext() =>
  return {
    name: (document.getElementById("nameEl") || {}).value || "",
    race: (document.getElementById("raceEl") || {}).value || "",
  };

applyGeneratedDetails(details) =>
  let nameEl = document.getElementById("nameEl");
  if(nameEl && details.name) { nameEl.value = details.name; localStorage.name = details.name; }
  let raceEl = document.getElementById("raceEl");
  if(raceEl && details.race) { raceEl.value = details.race; localStorage.race = details.race; }

getSectionText(section) =>
  let el = document.getElementById(section + "OutputEl");
  if(!el) return "";
  return el.innerText.trim();

formatSectionText(text) =>
  let r = text.replace(/(^|\n)([#a-zA-Z/ _\-0-9]{1,50})(:\s)/g, (m, p1, p2, p3) => p1+`<b style="color:#13a000">${p2.replaceAll("#","").trim()}</b>`+p3);
  return r.replace(/(^|\n)(#+[a-zA-Z/ _\-0-9]{1,50})(\n)/g, (m, p1, p2, p3) => p1+`<b style="color:#13a000">${p2.replaceAll("#","").trim()}</b>`+p3);

setGenerationStatus(message) =>
  let el = document.getElementById("generationStatusEl");
  if(el) el.textContent = message;

