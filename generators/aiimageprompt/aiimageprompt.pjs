getResolvedSetting() =>
  let el = document.getElementById("settingEl");
  if(!el) return "Any";
  let val = el.value;
  if(val === "Random") {
    let keys = ["Ancient Greek", "Cryptids ", "Viking", "Christmas ", "Medieval", "Alchemy "];
    val = keys[Math.floor(Math.random() * keys.length)];
  }
  return val;

getResolvedGenre() =>
  let el = document.getElementById("genreEl");
  if(!el) return "Any";
  let val = el.value;
  if(val === "Random") {
    let keys = ["Pirates", "Cyberpunk", "Steampunk", "Horror", "Dystopian", "Western", "Fantasy", "Sci-fi"];
    val = keys[Math.floor(Math.random() * keys.length)];
  }
  return val;

getSettingAndToneContext() =>
  let resolvedSetting = getResolvedSetting();
  let setting = settingPrompts[resolvedSetting] ? settingPrompts[resolvedSetting].evaluateItem : "";
  let tones = getSelectedTones();
  let toneParts = tones
    .filter(t => t !== "Any" && tonePrompts[t])
    .map(t => tonePrompts[t].evaluateItem);
  let parts = [];
  if(setting.trim()) parts.push("Setting: " + setting);
  if(toneParts.length > 0) parts.push("Tone: " + toneParts.join(" Additionally: "));
  let genre = getResolvedGenre();
  if(genre && genre !== "Any" && genrePrompts[genre]) parts.push("Genre: " + genrePrompts[genre].evaluateItem);
  let detailLevel = detailLevelEl.value;
  if(detailLevel === "Random") {
    let levels = ["Low", "Medium", "High"];
    detailLevel = levels[Math.floor(Math.random() * levels.length)];
  }
  if(detailLevel && detailLevel !== "Any" && detailLevelPrompts[detailLevel]) parts.push("Detail Level: " + detailLevelPrompts[detailLevel].evaluateItem);
  
  let promptStyle = promptStyleEl.value;
  if(promptStyle && promptStyle !== "Any" && promptstylePrompts[promptStyle]) parts.push("Prompt Style: " + promptstylePrompts[promptStyle].evaluateItem);
  
  if(parts.length === 0) return "";
  return "IMPORTANT SETTING, TONE, GENRE, PROMPT STYLE and DETAIL LEVEL — follow these closely:\n" + parts.join("\n");

////////////////////////////////////////
//   LENGTH SPECIFIERS                //
////////////////////////////////////////

lengthSpecifiers
  super-short =  2-3 lines
  short = at most 1 FULL short paragraph
  medium = 1-2 FULL paragraphs
  long = 2-4 FULL paragraphs
  super-long = 5-10 FULL paragraphs

getLengthInstruction(lengthVal) =>
  if(lengthVal === "super-short") return "IMPORTANT: Keep this section very short and concise, EXTREMELY SHORT — 2-3 lines maximum. Be concise.";
  if(lengthVal === "short")       return "IMPORTANT: Keep this section SHORT — no more than 1 brief paragraph.";
  if(lengthVal === "long")        return "IMPORTANT: Go into real depth — rich details. This section should be LONG AND DETAILED.";
  if(lengthVal === "super-long")  return "IMPORTANT: Write extensively and without restraint. This section must be VERY LONG AND EXHAUSTIVELY DETAILED.";
  return "";

////////////////////////////////////////
//   CONTEXT BUILDER                  //
////////////////////////////////////////

// Assembles all currently-filled content into a context block for use
// when generating any individual section.
buildCharacterContext(excludeSection) =>
  let d = getDetailsContext();
  let lines = [];

  // Always include whatever details are filled in
  let detailParts = [];
  if(d.name)        detailParts.push("Name: " + d.name);
  if(d.race)        detailParts.push("Race/Species: " + d.race);
  if(detailParts.length > 0) lines.push(detailParts.join("\n"));

  let sections = ["getDetailsContext", "physical", "background"];
  for(let s of sections) {
    if(s === excludeSection) continue;
    let text = getSectionText(s);
    if(text) {
      let label = s === "physical" ? "Main description" : "Background";
      lines.push(label + ":\n" + text);
    }
  }
  return lines.join("\n\n");

////////////////////////////////////////
//   DETAILS AUTO-FILL PROMPT         //
////////////////////////////////////////

  
// Called before any section generation to fill in any blank detail fields.
// Returns quickly if all fields are already filled.
async maybeGenerateDetails(sectionNotes) =>
  let d = getDetailsContext();
  let allFilled = d.name && d.race;
  if(allFilled) return;

  let blankFields = [];
  if(!d.name)        blankFields.push("name and surname. Is forbidden to use Vesper and Kaelen");
  if(!d.race)        blankFields.push("race/species (one word or short phrase.)");

  let existingContext = buildCharacterContext(null);
  let settingAndTone = getSettingAndToneContext();

  let allUserNotes = sectionNotes || "";
  let instruction = `You are filling in missing fields for a prompt. Generate ONLY the missing fields listed below — do not generate anything else.\n\nIMPORTANT — scan the user notes carefully before generating. If an explicit value for any field is stated anywhere (e.g. "human"), you MUST use that exact value. Do not infer or reinterpret. Only invent a value if no indication exists anywhere in the provided context.\n\n${existingContext ? "Existing context:\\n---\\n" + existingContext + "\\n---\\n" : ""}\n${allUserNotes ? "User notes — scan these first for any explicit field values before generating:\\n" + allUserNotes + "\\n" : ""}\n${settingAndTone ? settingAndTone + "\\n" : ""}\nFields to generate: ${blankFields.join(", ")}\n\nRespond with ONLY a JSON object containing the missing fields, exactly like this (include only the fields that were requested):\n{\n  "name": "...",\n  "race": "..."\n}\nNo explanation, no extra text.`;

  let stream = ai({ instruction });
  let result = await stream;
  try {
    let json = JSON.parse(result.text.replace(/```json|```/g, "").trim());
    applyGeneratedDetails(json);
  } catch(e) {}

// New function to handle the "generate details" button
async generateDetails() =>
  setGenerationStatus("⏳ Generating details...");
  let allSectionNotes = ["getDetailsContext", "physical", "background"]
    .map(s => (document.getElementById(s + "NotesEl") || {}).value || "")
    .filter(Boolean)
    .join("\n");
  
  // Force generation of any missing details (ignores if all filled)
  await maybeGenerateDetails(allSectionNotes);
  
  // If still missing some, force a full details generation
  let d = getDetailsContext();
  let stillMissing = !d.name || !d.race;
  if(stillMissing) {
    let blankFields = [];
    if(!d.name) blankFields.push("name and surname. Is forbidden to use Vesper, Kaelen and Elias");
    if(!d.race) blankFields.push("race/species (one word or short phrase.)");
    
    let existingContext = buildCharacterContext(null);
    let settingAndTone = getSettingAndToneContext();
    let instruction = `Generate complete prompt for an ai image based on any available context. Respond ONLY with JSON for ALL fields (fill in reasonable defaults if missing):\n{\n  "name": "...",\n  "race": "..."\n}\n\nContext:\n${existingContext}\n${settingAndTone ? settingAndTone : ""}`;
    
    let stream = ai({ instruction });
    let result = await stream;
    try {
      let json = JSON.parse(result.text.replace(/```json|```/g, "").trim());
      applyGeneratedDetails(json);
    } catch(e) {}
  }
  
  setGenerationStatus("");
  pushGenerationHistory();

////////////////////////////////////////
//   REFERENCED CHARACTERS            //
////////////////////////////////////////

getReferencedCharacters() =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  return saved.filter(c => {
    let checkbox = document.getElementById(`ref-${c.id}`);
    return checkbox && checkbox.checked;
  });

trimCharacterForReference(c) =>
  let sections = [];
  if(c.name)        sections.push("Name: " + c.name);
  if(c.physicalText) sections.push("Main description: " + c.physicalText.slice(0, 300) + (c.physicalText.length > 300 ? "..." : ""));
  if(c.backgroundText) sections.push("Background: " + c.backgroundText.slice(0, 300) + (c.backgroundText.length > 300 ? "..." : ""));
  return sections.join("\n");

getReferencedCharactersContext() =>
  let refs = getReferencedCharacters();
  if(refs.length === 0) return "";
  let refText = refs.map(c => `--- Referenced Character ---\n${trimCharacterForReference(c)}\n---`).join("\n\n");
  return "IMPORTANT — EXISTING Prompts FOR CONTEXT:\nThe following subject(s) already exist in this world. Your new prompt MUST have a concrete, specific connection to at least one of them — something that should be reflected in the section you are writing. Do NOT be vague about this connection. Do NOT copy their traits.\n\n" + refText;

////////////////////////////////////////
//   PER-SECTION PROMPTS              //
////////////////////////////////////////

buildPhysicalPrompt(context, notes, lengthVal) =>
  let lengthSpec = lengthSpecifiers[lengthVal] || lengthSpecifiers.medium;
  let lengthInstruction = getLengthInstruction(lengthVal);
  let settingAndTone = getSettingAndToneContext();
  let referencedCtx = getReferencedCharactersContext();
  let selectedAttrs = getSelectedAttributes();
  let parts = ["You are writing an ai image prompt."];
  parts.push("Start with the character name and surname (only if is a character specified by user) and species or race, Height (cm), skin color, hair color and style, eye colour, attire and color, body type, notable accessories. If the subject is a humanoid or a fantasy creature, describe their distinguishing features like ears, tail, wings etc. Do not make the character have scars unless requested by user. Copy the art style verbatim and add it at the end of the prompt. If there is no art style specified, choose one appropriate. Do NOT include personality, emotions, or backstory. This section is used directly for image generation so be specific and visual. If the main subject is an object or a place focus on that. If the subject is a character with a franchise, always include the franchise/title. Example: Neytiri (Avatar). If the user hasn't provided any instructions, just write an original character description. I FORBID YOU TO USE ELIAS, SORA, THALRIC, ELARA, LYRA, SYLA, VESPER AND KAELEN, UNLESS REQUESTED BY USER. Do not make the characters blind or disabled, with petite body unless requested by user.");
  parts.push("Write a minimum of " + lengthSpec + ". Each paragraph must contain at least 4 sentences. Do not shorten.");
  if(lengthInstruction) parts.push(lengthInstruction);
  parts.push("Be specific and concrete. Avoid vague or generic descriptions.");
  parts.push("Do NOT label the section — output the description text only, no heading.");
  if(selectedAttrs) parts.push("\nSelected attributes to incorporate: " + selectedAttrs);
  if(context) parts.push("\nExisting context (be consistent with this — do NOT introduce details that contradict what is already established):\n---\n" + context + "\n---");
  if(notes)   parts.push("\nSection-specific notes (follow these closely): " + notes);
  if(referencedCtx) parts.push("\n" + referencedCtx);
  if(settingAndTone) parts.push("\n" + settingAndTone);
  return parts.join("\n\n");

buildBackgroundPrompt(context, notes, lengthVal) =>
  let lengthSpec = lengthSpecifiers[lengthVal] || lengthSpecifiers.medium;
  let lengthInstruction = getLengthInstruction(lengthVal);
  let settingAndTone = getSettingAndToneContext();
  let referencedCtx = getReferencedCharactersContext();
  let selectedAttrs = getSelectedAttributes();
  let parts = ["You are writing the Background section of an ai image prompt."];
  parts.push("Focus on the details of the place or background.");
  parts.push("Write a minimum of " + lengthSpec + ". Each paragraph must contain at least 4 sentences. Do not shorten.");
  if(lengthInstruction) parts.push(lengthInstruction);
  parts.push("Be specific and concrete.");
  parts.push("Do NOT include a character description, unless requested by user.");
  parts.push("Do not add notes.");
  parts.push("Do NOT label the section — output the text only, no heading.");
  if(selectedAttrs) parts.push("\nSelected attributes to incorporate: " + selectedAttrs);
  if(context) parts.push("\nExisting context (be consistent with this — do NOT introduce details that contradict what is already established):\n---\n" + context + "\n---");
  if(notes)   parts.push("\nSection-specific notes (follow these closely): " + notes);
  if(referencedCtx) parts.push("\n" + referencedCtx);
  if(settingAndTone) parts.push("\n" + settingAndTone);
  return parts.join("\n\n");

////////////////////////////////////////
//   MAIN SECTION GENERATOR           //
////////////////////////////////////////

async generateSection(section) =>
  if(!window.sectionStreams) window.sectionStreams = {};

  // Stop any existing stream for this section
  if(window.sectionStreams[section]) window.sectionStreams[section].stop();

  setSectionGenerating(section, true);
  setSectionStatus(section, "⏳ Analyzing...");

  // Read all notes up front so they can be passed to maybeGenerateDetails
  let notes = (document.getElementById(section + "NotesEl") || {}).value || "";
  let lengthVal = (document.getElementById(section + "LengthEl") || {}).value || "medium";
  // Collect notes from all sections so any explicit field values are seen
  let allSectionNotes = ["getDetailsContext", "physical", "background"]
    .map(s => (document.getElementById(s + "NotesEl") || {}).value || "")
    .filter(Boolean)
    .join("\n");

  // Step 1: auto-fill any blank detail fields, passing all notes so
  // explicit values like "human" anywhere in the notes are respected
  await maybeGenerateDetails(allSectionNotes);

  // Step 2: build context from all other sections + details
  let context = buildCharacterContext(section);

  // Step 3: build the right prompt
  let instruction;
  if(section === "physical")    instruction = buildPhysicalPrompt(context, notes, lengthVal);
  else if(section === "background") instruction = buildBackgroundPrompt(context, notes, lengthVal);
  let sectionLabel = section === "physical" ? "prompt" : section;
  setSectionStatus(section, "✍️ Writing " + sectionLabel + "...");

  let stream = ai({ instruction });
  window.sectionStreams[section] = stream;

  // Stream into the output element
  let outputEl = document.getElementById(section + "OutputEl");
  outputEl.style.display = "block";
  outputEl.innerHTML = stream;

  let result = await stream;
  setSectionGenerating(section, false);

  if(result.stopReason === "user") {
    setSectionStatus(section, "⛔ Stopped.");
    return;
  }

  setSectionStatus(section, "");

  // Format the final output and Save to LocalStorage
  outputEl.innerHTML = formatSectionText(result.text);
  localStorage.setItem(section + "Output", result.text);

  // Show edit button
  let editBtn = document.getElementById(section + "EditBtnEl");
  if(editBtn) editBtn.style.display = "inline-block";
  updateClearAllBtn();

  // Persist to window state
  if(!window.characterSections) window.characterSections = {};
  window.characterSections[section] = result.text;

  pushGenerationHistory();

////////////////////////////////////////
//   🔥IMAGE GENERATION                 //
////////////////////////////////////////

getCaptionPromptInstruction(physicalText, backgroundText, settingValue, toneValues) =>
  let toneStr = toneValues.length > 0 && toneValues[0] !== "Any" ? toneValues.join(", ") : "";
  let promptStyle = promptStyleEl.value;
  let styleFormatInstruction = "";
  let matchedKey = Object.keys(promptstylePrompts).find(k => k.toLowerCase() === promptStyle.toLowerCase());
  if(matchedKey) {
    styleFormatInstruction = promptstylePrompts[matchedKey].evaluateItem;
  }

  let selectedAttrs = getSelectedAttributes();

  let parts = [];
  parts.push("You are generating an ai image prompt for an AI image generator. Below is a description. Copy all the Main description and background verbatim. Do not add anything else. Don't add another name different from the one in the Main description and background. Do not add words or phrases at the beginning that are not part of the aforementioned descriptions");
  parts.push("Rules: Do not add notes or explanations. Do not copy the words 'Tone:', 'Setting:', 'Background:', 'Main description:', 'A .'." + (styleFormatInstruction ? " " + styleFormatInstruction : ""));
  parts.push("Setting: " + (settingValue || "") + "\nTone: " + toneStr);
  if(selectedAttrs) parts.push("Additional attributes to include: " + selectedAttrs);
  parts.push("Main description:\n---\n" + physicalText + "\n---");
  if(backgroundText) {
    parts.push("Background:\n---\n" + backgroundText + "\n---");
  }
  parts.push("Copy the full text below. Do not add notes or explanations");
  return parts.join("\n\n");

buildNegativePrompt() =>
  let tones = getSelectedTones();
  let settingValue = getResolvedSetting();
  let base = "bad";
  if(tones.includes("Dark / Gritty") || tones.includes("Horror")) return base + ", bright colors, cheerful, cute, cartoon, anime, soft lighting, pastel";
  if(tones.includes("Light-hearted / Comedic") || tones.includes("Whimsical")) return base + ", dark, gritty, grimdark, horror, violence, disturbing";
  if(tones.includes("Erotic")) return base + ", childlike, cartoon, cute, non-suggestive";
  if(tones.includes("Epic")) return base + ", mundane, casual, low stakes, soft lighting, flat composition";
  if(tones.includes("Mysterious")) return base + ", bright, cheerful, overexposed, flat lighting";
  if(settingValue === "Sci-Fi" || settingValue === "Cyberpunk") return base + ", medieval, fantasy, nature, organic, rustic";
  if(settingValue === "Real World / Modern" || settingValue === "Historical") return base + ", fantasy, magic, unrealistic, anime";
  return base;

async triggerImageGeneration(physicalText, backgroundText) =>
  imagesAreaEl.style.display = "block";
  if(regenImagesBtn) regenImagesBtn.disabled = false;

  // Image prompt is now just the Main description and background text combined
  let combinedPrompt = physicalText || "";
  if(backgroundText) {
    combinedPrompt = combinedPrompt ? combinedPrompt + ", " + backgroundText : backgroundText;
  }

  if(!window.lastCharacterData) window.lastCharacterData = {};
  window.lastCharacterData.visualKeyphrasesText = combinedPrompt;
  window.lastCharacterData.physicalText = physicalText;
  window.lastCharacterData.backgroundText = backgroundText;
  window.lastCharacterData.visualStyleName = "";

  generateImages();
  setGenerationStatus("");

async generateImages() =>
  // Always read the CURRENT text directly from the DOM so that any edits
  // the user made to the Main description or Background sections are reflected.
  let physicalText = getSectionText("physical");
  let backgroundText = getSectionText("background");
  if(!physicalText) {
    // Fallback to basic details if no physical description
    let d = getDetailsContext();
    physicalText = `${d.race || ""}${d.name ? " named " + d.name : ""}.`;
  }
  
  // If the user has edited the sections since the last load or regenerate,
  // discard the stale visualKeyphrasesText so the prompt is rebuilt from
  // the current edited text.
  if(window.lastCharacterData) {
    let prevPhysical = (window.lastCharacterData.physicalText || "").trim();
    let prevBackground = (window.lastCharacterData.backgroundText || "").trim();
    if(physicalText !== prevPhysical || backgroundText !== prevBackground) {
      window.lastCharacterData.visualKeyphrasesText = "";
    }
  }
  
  // Build image prompt directly from main description and background text
  let basePrompt = "";
  if(window.lastCharacterData?.visualKeyphrasesText) {
    basePrompt = window.lastCharacterData.visualKeyphrasesText;
  } else {
    basePrompt = physicalText;
    if(backgroundText) basePrompt += ", " + backgroundText;
  }
  
  // Sync lastCharacterData with the current DOM state so future calls
  // can correctly detect whether sections were edited.
  if(!window.lastCharacterData) window.lastCharacterData = {};
  window.lastCharacterData.physicalText = physicalText;
  window.lastCharacterData.backgroundText = backgroundText;
  if(!window.lastCharacterData.visualKeyphrasesText) {
    window.lastCharacterData.visualKeyphrasesText = basePrompt;
  }
  
  if(!basePrompt.trim()) {
    setGenerationStatus("⚠️ Please generate or type a main description first.");
    return;
  }
  
  let count = parseInt(imageCountEl.value) || 6;
  
  // Resolution logic
  let resolutionVal = "Square (768x768)";
  let resEl = document.getElementById("resolutionEl");
  if(resEl) resolutionVal = resEl.value;
  if(resolutionVal === "Random") {
    let keys = Object.keys(resolutionPrompts).filter(k => k !== "Random");
    resolutionVal = keys[Math.floor(Math.random() * keys.length)];
  }
  let resolutionStr = resolutionPrompts[resolutionVal] ? resolutionPrompts[resolutionVal].evaluateItem : "(resolution:::768x768)";
  if(resolutionStr === "Random") resolutionStr = "(resolution:::768x768)";
  
  let aestheticRank = getAestheticRank();
  let guidanceScale = getGuidanceScale();
  let seedVal = getSeedValue();
  
  let basePromptWithRes = basePrompt;
  if(!basePromptWithRes.includes("(resolution:::")) {
    basePromptWithRes += ", " + resolutionStr;
  }
  if(guidanceScale) basePromptWithRes += ", " + guidanceScale;
  if(seedVal) basePromptWithRes += ", " + seedVal;
  
  let finalPrompt = basePromptWithRes;
  if(aestheticRank) finalPrompt = aestheticRank + " " + basePromptWithRes;
  
  let imageHtml = '<div style="display:flex; flex-wrap:wrap; justify-content:center; gap:1.5rem; width:100%; box-sizing:border-box; padding:1rem 0;">';
  for(let i = 0; i < count; i++) {
    let promptData = {
      prompt: finalPrompt,
      negativePrompt: "",
      style: "width:300px; max-width:100%; height:auto;",
    };
    let wrapper = '<div class="imageWrapper" style="display:flex; flex-direction:column; justify-content:center; align-items:center; width:300px; max-width:100%; box-sizing:border-box;">';
    wrapper += image(promptData).evaluateItem;
    wrapper += '<div class="characterCardButtons">';
    wrapper += '<button class="characterActionBtn" onclick="zoomImage(this.closest(\'.imageWrapper\'))">🔍 zoom</button>';
    wrapper += '<button class="characterActionBtn" onclick="saveCharacterButtonClickHandler(this.closest(\'.imageWrapper\').querySelector(\'iframe\').textToImagePluginOutput, this)">💾 save</button>';
    wrapper += '</div></div>';
    imageHtml += wrapper;
  }
  imageHtml += '</div>';
  imagesEl.innerHTML = imageHtml;

async regenerateImagePrompt() =>
  if(!window.lastCharacterData) window.lastCharacterData = {};
  
  if(regenImagePromptBtn) regenImagePromptBtn.disabled = true;
  setGenerationStatus("✏️ Generating image prompt...");

  // FORCE fresh physical text every time
  let physicalText = getSectionText("physical");
  let backgroundText = getSectionText("background");
  
  // Fallback if physical section is empty
  if(!physicalText) {
    let d = getDetailsContext();
    physicalText = `${d.race || ""}${d.name ? " named " + d.name : ""}.`;
  }

  // Update lastCharacterData so future regenerations stay in sync
  window.lastCharacterData.physicalText = physicalText;
  window.lastCharacterData.backgroundText = backgroundText;

  let resolvedSetting = getResolvedSetting();
  let settingValue = resolvedSetting !== "Any" ? resolvedSetting : "";
  let toneValues = getSelectedTones();

  let captionObj;
  let captionPromptObj = {
    instruction: getCaptionPromptInstruction(physicalText, backgroundText, settingValue, toneValues),
    onChunk: (data) => {
      if(data.fullTextSoFar.length > 1000) {
        let terms = data.fullTextSoFar.split(", ");
        let uniqueTerms = [...new Set(terms)];
        if(terms.length > 2*uniqueTerms.length) captionObj.stop();
    }
    },
  };

  captionObj = ai(captionPromptObj);
  let responseData = await captionObj;

  if(responseData.stopReason === "user") { 
    if(regenImagePromptBtn) regenImagePromptBtn.disabled = false; 
    setGenerationStatus(""); 
    return; 
  }

  let newKeyphrases = responseData.text.replace(/\n+/g, " ").trim();
  
  window.overwrittenVisualKeyphrasesText = null;
  window.lastCharacterData.visualKeyphrasesText = newKeyphrases;

  setGenerationStatus("");
  if(regenImagePromptBtn) regenImagePromptBtn.disabled = false;

clearOldImageStuff() =>
  window.overwrittenVisualKeyphrasesText = null;
  imagesEl.innerHTML = "";

clearImagePrompt() =>
  if(!confirm("Clear Image Prompt?")) return;
  window.overwrittenVisualKeyphrasesText = "";
  localStorage.imagePrompt = "";
  window.lastCharacterData = window.lastCharacterData || {};
  window.lastCharacterData.visualKeyphrasesText = "";

clearNotepad() =>
  if(!confirm("Clear Notepad?")) return;
  localStorage.notepad = "";
  let el = document.getElementById("notepadEl");
  if(el) el.value = "";
  
clearMainNotes() =>
  if(!confirm("Clear Main Description notes?")) return;
  localStorage.physicalNotes = "";
  let el = document.getElementById("physicalNotesEl");
  if(el) el.value = "";
    
clearBackgroundNotes() =>
  if(!confirm("Clear Background notes?")) return;
  localStorage.backgroundNotes = "";
  let el = document.getElementById("backgroundNotesEl");
  if(el) el.value = "";

////////////////////////////////////////
//   ZOOM & EXPORT                    //
////////////////////////////////////////

zoomImage(imageWrapper) =>
  let img = imageWrapper.querySelector('img');
  let iframe = imageWrapper.querySelector('iframe');
  let dataUrl = "";
  if(iframe && iframe.textToImagePluginOutput) {
    dataUrl = iframe.textToImagePluginOutput.dataUrl || "";
  } else if(img) {
    dataUrl = img.src || "";
  }
  if(!dataUrl) return;
  let overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:99999;display:flex;justify-content:center;align-items:center;cursor:zoom-out;';
  overlay.onclick = () => overlay.remove();
  let zoomImg = document.createElement('img');
  zoomImg.src = dataUrl;
  zoomImg.style.cssText = 'max-width:95%;max-height:95%;object-fit:contain;border-radius:4px;';
  overlay.appendChild(zoomImg);
  document.body.appendChild(overlay);

exportCurrentCharacter(imageWrapper) =>
  let iframe = imageWrapper.querySelector('iframe');
  let img = imageWrapper.querySelector('img');
  let d = getDetailsContext();
  let name = d.name || "character";
  let imageDataUrl = "";
  if(iframe && iframe.textToImagePluginOutput) {
    imageDataUrl = iframe.textToImagePluginOutput.dataUrl || "";
  } else if(img) {
    imageDataUrl = img.src || "";
  }
  let exportData = {
    name: name,
    physicalText: getSectionText("physical"),
    backgroundText: getSectionText("background"),
    visualKeyphrasesText: window.lastCharacterData?.visualKeyphrasesText || "",
    imageDataUrl: imageDataUrl,
    visualStyleName: "",
    setting: (document.getElementById("settingEl") || {}).value || "",
    tone: getSelectedTones(),
  };
  let json = JSON.stringify(exportData, null, 2);
  let blob = new Blob([json], {type: "application/json"});
  let a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = name.replace(/\s+/g, "_") + ".json";
  a.click();
  URL.revokeObjectURL(a.href);

exportCharacter(id) =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  let c = saved.find(x => x.id === id);
  if(!c) { alert("Prompt not found."); return; }
  let exportData = {
    name: c.name,
    displayTitle: c.displayTitle || "",
    physicalText: c.physicalText || "",
    backgroundText: c.backgroundText || "",
    visualKeyphrasesText: c.visualKeyphrasesText || "",
    imageDataUrl: c.imageDataUrl || "",
    visualStyleName: c.visualStyleName || "",
    setting: c.setting || "",
    tone: c.tone || [],
  };
  let json = JSON.stringify(exportData, null, 2);
  let blob = new Blob([json], {type: "application/json"});
  let a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (c.name || "ai").replace(/\s+/g, "_") + ".json";
  a.click();
  URL.revokeObjectURL(a.href);

async exportAllImagesAsZip() =>
  let scripts = document.querySelectorAll('script[src*="jszip"]');
  if(scripts.length === 0) {
    let s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
    document.head.appendChild(s);
    await new Promise(r => s.onload = r);
  }
  let zip = new JSZip();
  let wrappers = document.querySelectorAll('.imageWrapper');
  let d = getDetailsContext();
  let name = (d.name || "character").replace(/\s+/g, "_");
  let count = 0;
  for(let w of wrappers) {
    let iframe = w.querySelector('iframe');
    let img = w.querySelector('img');
    let dataUrl = "";
    if(iframe && iframe.textToImagePluginOutput) {
      dataUrl = iframe.textToImagePluginOutput.dataUrl || "";
    } else if(img) {
      dataUrl = img.src || "";
    }
    if(dataUrl && dataUrl.startsWith("data:image/")) {
      let base64 = dataUrl.split(',')[1];
      let ext = dataUrl.match(/data:image\/(.*?);/)[1] || 'png';
      if(ext === 'jpeg') ext = 'jpg';
      zip.file(name + "_" + (count + 1) + "." + ext, base64, {base64: true});
      count++;
    }
  }
  if(count === 0) { alert("No images to export."); return; }
  let content = await zip.generateAsync({type:"blob"});
  let a = document.createElement("a");
  a.href = URL.createObjectURL(content);
  a.download = name + "_images.zip";
  a.click();
  URL.revokeObjectURL(a.href);

////////////////////////////////////////
//   HISTORY                          //
////////////////////////////////////////

pushGenerationHistory() =>
  let d = getDetailsContext();
  let name = d.name;
  if(!name) {
    let physText = getSectionText("physical");
    if(physText) {
      name = physText.split('\n')[0].slice(0, 30);
      if(physText.length > 30) name += "...";
    } else {
      name = "Untitled Prompt";
    }
  }
  let entry = {
    name:            name,
    details:         d,
    physicalText:    getSectionText("physical"),
    backgroundText:  getSectionText("background"),
    visualKeyphrasesText: window.lastCharacterData?.visualKeyphrasesText || "",
    visualStyleName:      "",
    imageDataUrl:         window.lastCharacterData?.imageDataUrl || "",
    timestamp: Date.now(),
  };
  let history = window.generationHistory || [];
  history.unshift(entry);
  if(history.length > 20) history = history.slice(0, 20);
  window.generationHistory = history;
  updateHistoryBtn();

updateHistoryBtn() =>
  let btn = document.getElementById("historyBtn");
  if(!btn) return;
  let count = (window.generationHistory || []).length;
  btn.style.display = count > 0 ? "inline-block" : "none";
  btn.textContent = "🕓 history (" + count + ")";

showHistoryModal() =>
  let history = window.generationHistory || [];
  if(history.length === 0) return;
  let colorScheme = localStorage.forceColorScheme !== undefined ? localStorage.forceColorScheme : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? "dark" : "light";
  let itemsHtml = "";
  history.forEach(function(h, i) {
    let time = new Date(h.timestamp).toLocaleTimeString();
    itemsHtml += '<div style="display:flex; align-items:center; gap:0.5rem; padding:0.4rem 0; border-bottom:1px solid #444;">';
    itemsHtml += '<span style="flex:1; font-size:88%;">' + h.name + ' <span style="opacity:0.5; font-size:80%;">' + time + '</span></span>';
    itemsHtml += '<button onclick="restoreFromHistory(' + i + ')" style="font-size:80%;">↩ restore</button>';
    itemsHtml += '</div>';
  });
  let historyHtml = '<div style="min-width:300px;"><div style="font-weight:bold; margin-bottom:0.5rem;">🕓 Generation History</div>';
  historyHtml += '<div style="font-size:80%; opacity:0.6; margin-bottom:0.75rem;">Last 20 generations this session. Restoring will replace current text and images.</div>';
  historyHtml += itemsHtml + '</div>';
  prompt2({
    content: {type:"none", html: historyHtml}
  }, {cancelButtonText:"close", submitButtonText:null, verticallyCenter:true});

restoreFromHistory(index) =>
  let history = window.generationHistory || [];
  let h = history[index];
  if(!h) return;
  // Restore sections
  if(h.physicalText)    setSectionOutput("physical",    formatSectionText(h.physicalText));
  if(h.backgroundText)  setSectionOutput("background",  formatSectionText(h.backgroundText));
  // Read the actual DOM text so window.lastCharacterData stays in sync with
  // what getSectionText() would return (formatSectionText may alter text).
  let domPhysical = getSectionText("physical");
  let domBackground = getSectionText("background");
  // Restore images
  if(h.visualKeyphrasesText) {
    window.lastCharacterData = {
      physicalText:         domPhysical,
      backgroundText:       domBackground,
      visualKeyphrasesText: h.visualKeyphrasesText,
      visualStyleName:      "",
      imageDataUrl:         h.imageDataUrl,
    };
    window.overwrittenVisualKeyphrasesText = null;
    imagesAreaEl.style.display = "block";
    generateImages();
  } else {
    clearOldImageStuff();
  }

////////////////////////////////////////
//   SAVE / LOAD                      //
////////////////////////////////////////

// Assembles all sections into a single combined text block (for backwards
// compat with chat/save systems that expect one big text string).
assembleFullCharacterText() =>
  let d = getDetailsContext();
  let lines = [];
  if(d.name)        lines.push("Name: " + d.name);
  if(d.race)        lines.push("Race/Species: " + d.race);
  let physical    = getSectionText("physical");
  let background  = getSectionText("background");
  if(physical)    lines.push("\nMain description:\n" + physical);
  if(background)  lines.push("\nBackground:\n" + background);
  return lines.join("\n");

async generateCharacterMetadata(characterText, currentName) =>
  let instruction = "Based on the following image prompt description, generate a JSON object with two fields:\n1. \"characterName\": The full name of the character or main subject of the prompt. If a name is already mentioned in the text, use it. Otherwise, invent a fitting name. (I FORBID YOU TO USE 'ELIAS' OR 'KAELEN') If the subject of the description is an object or a place, just include the name of the object or place\n2. \"displayTitle\": a very short, catchy, evocative title (3 to 5 words) that captures the image essence. Example: 'The Exiled Fire Mage', 'An abandoned Cyberpunk City', 'The Enchanted Hammer', 'Just a plain object'.\n\nOutput ONLY valid JSON, no explanation, no markdown formatting, no notes.\n\nCharacter Description:\n" + characterText;
  let stream = ai({ instruction });
  let result = await stream;
  try {
    let json = JSON.parse(result.text.replace(/```json|```/g, "").trim());
    if(json.displayTitle && json.displayTitle.length > 60) json.displayTitle = json.displayTitle.slice(0, 57) + "...";
    return json;
  } catch(e) {
    // Fallback if JSON parsing fails
    return { characterName: currentName, displayTitle: "" };
  }

async generateNameAndTitle() =>
  setGenerationStatus("✏️ Generating name and title...");
  let genBtn = document.getElementById("generateNameBtn");
  if(genBtn) genBtn.disabled = true;
  
  let generatedText = assembleFullCharacterText();
  let d = getDetailsContext();
  let currentName = d.name || "Unknown";
  
  try {
    let metadata = await generateCharacterMetadata(generatedText, currentName);
    window.generatedName = metadata.characterName || currentName;
    window.generatedDisplayTitle = metadata.displayTitle || "";
    
    let outputEl = document.getElementById("nameAndTitleOutputEl");
    if(outputEl) {
      outputEl.innerHTML = `<div style="font-weight:bold; font-size:1.1rem;">${window.generatedName}</div><div style="font-style:italic; opacity:0.8;">${window.generatedDisplayTitle}</div>`;
      outputEl.style.display = "block";
    }
  } catch(e) {}
  
  setGenerationStatus("");
  if(genBtn) genBtn.disabled = false;

async saveCharacterButtonClickHandler(textToImagePluginOutput, buttonEl) =>
  let d = getDetailsContext();
  let name = window.generatedName || d.name || "Unknown";
  let displayTitle = window.generatedDisplayTitle || "";
  let imageDataUrl = textToImagePluginOutput?.dataUrl || window.lastCharacterData?.imageDataUrl || "";
  
  buttonEl.disabled = true;
  let originalText = buttonEl.textContent;
  buttonEl.textContent = "⏳ saving...";
  
  let generatedText = assembleFullCharacterText();
  
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  saved.push({
    id: Date.now(),
    name: name,
    displayTitle: displayTitle,
    details:         d,
    physicalText:    getSectionText("physical"),
    backgroundText:  getSectionText("background"),
    generatedText:   generatedText,
    visualKeyphrasesText: window.lastCharacterData?.visualKeyphrasesText || "",
    physicalAppearanceText: getSectionText("physical"),
    imageDataUrl,
    pluginOutput: textToImagePluginOutput,
    visualStyleName: "",
    setting: (document.getElementById("settingEl") || {}).value || "",
    tone: getSelectedTones(),
  });
  localStorage.savedCharacters = JSON.stringify(saved);
  renderSidebar();
  
  buttonEl.disabled = false;
  buttonEl.textContent = "✅ saved!";
  setTimeout(() => buttonEl.textContent = originalText, 2000);

loadCharacter(id) =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  let c = saved.find(x => x.id === id);
  if(!c) return;

  // Restore sections
  if(c.physicalText)    setSectionOutput("physical",    formatSectionText(c.physicalText));
  if(c.backgroundText)  setSectionOutput("background",  formatSectionText(c.backgroundText));
  // Read the actual DOM text so window.lastCharacterData stays in sync with
  // what getSectionText() would return (formatSectionText may alter text).
  let domPhysical = getSectionText("physical");
  let domBackground = getSectionText("background");

  // Restore image state
  window.lastCharacterData = {
    physicalText:         domPhysical,
    backgroundText:       domBackground,
    visualKeyphrasesText: c.visualKeyphrasesText || "",
    visualStyleName:      "",
    imageDataUrl:         c.imageDataUrl || "",
  };
  window.overwrittenVisualKeyphrasesText = null;
  let settingElRef = document.getElementById("settingEl");
  if(c.setting && settingElRef) settingElRef.value = c.setting;

  // Restore generated name and title
  window.generatedName = c.name || "";
  window.generatedDisplayTitle = c.displayTitle || "";
  let nameOutputEl = document.getElementById("nameAndTitleOutputEl");
  if(nameOutputEl) {
    if(window.generatedName || window.generatedDisplayTitle) {
      nameOutputEl.innerHTML = `<div style="font-weight:bold; font-size:1.1rem;">${window.generatedName}</div><div style="font-style:italic; opacity:0.8;">${window.generatedDisplayTitle}</div>`;
      nameOutputEl.style.display = "block";
    } else {
      nameOutputEl.innerHTML = "";
      nameOutputEl.style.display = "none";
    }
  }

  imagesAreaEl.style.display = "block";
  
  if(c.imageDataUrl) {
    let loadImgHtml = '<div style="display:flex; flex-wrap:wrap; justify-content:center; gap:1.5rem; width:100%; box-sizing:border-box; padding:1rem 0;">';
    loadImgHtml += '<div class="imageWrapper" style="display:flex; flex-direction:column; justify-content:center; align-items:center; width:300px; max-width:100%; box-sizing:border-box;">';
    loadImgHtml += '<img src="' + c.imageDataUrl + '" style="width:100%; max-height:90vh; object-fit:contain; border-radius:4px;">';
    loadImgHtml += '<div class="characterCardButtons">';
    loadImgHtml += '<button class="characterActionBtn" onclick="zoomImage(this.closest(\'.imageWrapper\'))">🔍 zoom</button>';
    loadImgHtml += '<button class="characterActionBtn" onclick="saveCharacterButtonClickHandler(window.lastCharacterData, this)">💾 save</button>';
    loadImgHtml += '</div></div>';
    loadImgHtml += '</div>';
    imagesEl.innerHTML = loadImgHtml;
  } else {
    imagesEl.innerHTML = "";
  }

renderSidebar() =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  let favs = JSON.parse(localStorage.favouriteCharacters || "[]");
  let listHtml = '<div style="margin-bottom:0.5rem;"><input type="text" id="savedSearchEl" placeholder="🔍 Search saved prompts..." oninput="filterSavedCharacters()" style="width:100%; padding:0.3rem; border-radius:4px; border:1px solid #555; background:transparent; color:inherit; font-size:85%; box-sizing:border-box;"></div>';
  
  let favCards = "";
  let regularCards = "";
  
  if(saved.length === 0) {
    regularCards = '<p style="opacity:0.5; font-size:85%; text-align:center;">No saved prompts yet.</p>';
  } else {
    for(let c of saved) {
      let card = '<div class="saved-card" data-name="' + (c.name || "character").toLowerCase() + '" style="display:flex; flex-direction:column; gap:0.3rem; padding:0.5rem; border:1px solid #444; border-radius:4px; background:var(--box-color);">';
      if(c.imageDataUrl) { 
        card += '<img src="' + c.imageDataUrl + '" alt="' + (c.name || "character") + '" style="width:100%; border-radius:3px; object-fit:cover; max-height:180px;">'; 
      } else { 
        card += '<div style="width:100%; height:80px; border-radius:3px; background:var(--panel-header-bg,#2a2a2a); display:flex; align-items:center; justify-content:center; font-size:200%; opacity:0.3;">📝</div>'; 
      }
      
      card += '<div style="display:flex; align-items:center; gap:0.4rem;">';
      card += '<input type="checkbox" id="ref-' + c.id + '" style="cursor:pointer;">';
      card += '<div style="flex:1; overflow:hidden;">';
      card += '<div style="display:flex; align-items:center; gap:0.2rem;">';
      card += '<label for="ref-' + c.id + '" id="nameLabel_' + c.id + '" style="font-weight:bold; font-size:90%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; flex:1;">' + c.name + '</label>';
      card += '<button onclick="editSavedCharacterName(' + c.id + ')" style="font-size:70%; padding:0.1rem 0.25rem; cursor:pointer; opacity:0.6;" title="Edit name">✏️</button>';
      card += '</div>';
      card += '<div style="display:flex; align-items:center; gap:0.2rem;">';
      card += '<span id="titleLabel_' + c.id + '" style="font-size:75%; opacity:0.7; font-style:italic; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1;">' + (c.displayTitle || "") + '</span>';
      card += '<button onclick="editSavedCharacterTitle(' + c.id + ')" style="font-size:70%; padding:0.1rem 0.25rem; cursor:pointer; opacity:0.6;" title="Edit title">✏️</button>';
      card += '</div>';
      card += '</div>';
      card += '<span class="fav-btn" onclick="toggleFavouriteCharacter(' + c.id + ')" style="cursor:pointer; font-size:110%;">' + (favs.includes(c.id) ? "❤" : "♡") + '</span>';
      card += '</div>';
      card += '<div style="display:flex; gap:0.3rem;">';
      card += '<button onclick="loadCharacter(' + c.id + ')" style="flex:1; font-size:80%;">📂 load</button>';
      card += '<button onclick="exportCharacter(' + c.id + ')" style="flex:1; font-size:80%;">📤 (JSON)</button>';
      card += '<button onclick="duplicateCharacter(' + c.id + ')" style="flex:1; font-size:80%;">📋 dupe</button>';
      card += '<button onclick="deleteCharacter(' + c.id + ')" style="flex:1; font-size:80%;">🗑️</button>';
      card += '</div></div>';
      
      if(favs.includes(c.id)) favCards += card;
      else regularCards += card;
    }
  }
  
  if(favCards.length > 0) {
    listHtml += '<div style="margin-bottom:0.5rem; border:1px dashed #444; padding:0.5rem; border-radius:4px;"><b style="font-size:80%; opacity:0.7;">❤ Favourites</b><div style="display:flex; flex-direction:column; gap:0.5rem; margin-top:0.3rem;">' + favCards + '</div></div>';
  }
  listHtml += '<div id="regularSavedListEl" style="display:flex; flex-direction:column; gap:0.5rem;">' + regularCards + '</div>';
  
  sidebarListEl.innerHTML = listHtml;
  updateSavedCountBadge();
  updateReferencesBanner();

editSavedCharacterName(id) =>
  let labelEl = document.getElementById("nameLabel_" + id);
  if(labelEl) renameSavedCharacter(id, labelEl);

editSavedCharacterTitle(id) =>
  let labelEl = document.getElementById("titleLabel_" + id);
  if(labelEl) renameSavedCharacterTitle(id, labelEl);

toggleFavouriteCharacter(id) =>
  let favs = JSON.parse(localStorage.favouriteCharacters || "[]");
  if(favs.includes(id)) {
    favs = favs.filter(f => f !== id);
  } else {
    favs.push(id);
  }
  localStorage.favouriteCharacters = JSON.stringify(favs);
  renderSidebar();

filterSavedCharacters() =>
  let term = (document.getElementById("savedSearchEl").value || "").toLowerCase();
  let cards = document.querySelectorAll(".saved-card");
  for(let card of cards) {
    if(card.getAttribute("data-name").includes(term)) {
      card.style.display = "flex";
    } else {
      card.style.display = "none";
    }
  }

renameSavedCharacterTitle(id, el) =>
  let currentTitle = el.textContent;
  let input = document.createElement("input");
  input.value = currentTitle;
  input.style.cssText = "font-size:75%; font-style:italic; width:100%; border:1px solid #13a000; border-radius:2px; padding:0.1rem 0.2rem; background:transparent; color:inherit; box-sizing:border-box;";
  el.replaceWith(input);
  input.focus(); input.select();
  let commit = () => {
    let newTitle = input.value.trim() || currentTitle;
    let saved = JSON.parse(localStorage.savedCharacters || "[]");
    let idx = saved.findIndex(x => x.id === id);
    if(idx !== -1) { saved[idx].displayTitle = newTitle; localStorage.savedCharacters = JSON.stringify(saved); }
    renderSidebar();
  };
  input.addEventListener("blur", commit);
  input.addEventListener("keydown", e => {
    if(e.key === "Enter") { e.preventDefault(); input.blur(); }
    if(e.key === "Escape") { input.value = currentTitle; input.blur(); }
  });

deleteCharacter(id) =>
  if(!confirm("Delete this saved prompt? This cannot be undone.")) return;
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  localStorage.savedCharacters = JSON.stringify(saved.filter(x => x.id !== id));
  renderSidebar();

duplicateCharacter(id) =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  let original = saved.find(x => x.id === id);
  if(!original) return;
  let dupe = Object.assign({}, original, { id: Date.now(), name: original.name + " (copy)" });
  saved.push(dupe);
  localStorage.savedCharacters = JSON.stringify(saved);
  renderSidebar();

renameSavedCharacter(id, labelEl) =>
  let currentName = labelEl.textContent;
  let input = document.createElement("input");
  input.value = currentName;
  input.style.cssText = "font-size:90%; font-weight:bold; width:100%; border:1px solid #13a000; border-radius:2px; padding:0.1rem 0.2rem;";
  labelEl.replaceWith(input);
  input.focus(); input.select();
  let commit = () => {
    let newName = input.value.trim() || currentName;
    let saved = JSON.parse(localStorage.savedCharacters || "[]");
    let idx = saved.findIndex(x => x.id === id);
    if(idx !== -1) { saved[idx].name = newName; localStorage.savedCharacters = JSON.stringify(saved); }
    renderSidebar();
  };
  input.addEventListener("blur", commit);
  input.addEventListener("keydown", e => {
    if(e.key === "Enter") { e.preventDefault(); input.blur(); }
    if(e.key === "Escape") { input.value = currentName; input.blur(); }
  });

exportSavedCharacters() =>
  let saved = JSON.parse(localStorage.savedCharacters || "[]");
  if(saved.length === 0) { alert("No saved prompts to export."); return; }
  let json = JSON.stringify(saved, null, 2);
  let blob = new Blob([json], {type: "application/json"});
  let a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "saved-characters.json";
  a.click();
  URL.revokeObjectURL(a.href);

importSavedCharacters() =>
  let input = document.createElement("input");
  input.type = "file"; input.accept = ".json";
  input.onchange = e => {
    let file = e.target.files[0];
    if(!file) return;
    let reader = new FileReader();
    reader.onload = ev => {
      try {
        let imported = JSON.parse(ev.target.result);
        if(!Array.isArray(imported)) {
          if (typeof imported === "object" && imported !== null) {
            imported = [imported];
          } else {
            throw new Error("Invalid format");
          }
        }
        let existing = JSON.parse(localStorage.savedCharacters || "[]");
        for(let c of imported) {
          if(!c.id) c.id = Date.now() + Math.floor(Math.random() * 1000);
        }
        localStorage.savedCharacters = JSON.stringify([...existing, ...imported]);
        renderSidebar();
        alert("✅ Imported " + imported.length + " character(s).");
      } catch(err) { alert("❌ Failed to import: invalid file."); }
    };
    reader.readAsText(file);
  };
  input.click();

