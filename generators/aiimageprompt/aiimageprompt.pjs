$meta
  title = 📝 AI Image Prompt Generator
  description = Generate a full prompt based on your keywords/ideas, including, theme, background, and images based on that prompt. Various styles/themes, including fantasy, D&D, anime, realistic, characters, anthro/furry, creative OCs, villain ideas, etc. Completely free, online AI PROMPT maker - no login or sign-up, unlimited.
  image = https://user.uploads.dev/file/8ea3c4147084820eb3f49b7dfe2e6820.jpg
  header
    mode = minimal

