$meta
  title = Hero Arena: Multiverse PvP
  description = a simple online pvp arena, forge your heroes and fight other players.
  tags = pvp, hero, arena, ai, fighting, strategy, rpg, multiverse

generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}
//createServerSocket = {import:server-plugin}
commentsPlugin = {import:comments-plugin}

// ============================================================
//  HERO ARENA: MULTIVERSE PvP  —  CONFIG & DATA
//  Tweak values below to balance the game.
// ============================================================

config
  startingGems = 100
  heroForgeCost = 25
  inventoryLimit = 20
  inventoryUpgradeCost = 50
  inventoryUpgradeAmount = 10
  maxRegistrations = 5
  maxSkillLevel = 10
  skillsPerHero = 5
  skillsInBattle = 3
  descCharLimit = 1500
  gemsToSkillPointCost = 30
  skillRegenCostSP = 1
  minHeroesToDelete = 3
  fightHistoryLimit = 10
  fightFavoritesLimit = 10
  heroBookCount = 5
  heroBookCost = 5
  unregisterLockRank = 50
  skillLevelWeight = 1.5
  statWeight = 1.0
  botMaxRP = 8
  botMaxWins = 4
  botMaxLosses = 3

// Class system — each has a name, short description (shown on cards),
// and stat bias guidelines the AI uses to balance generated heroes.
classes
  fighter
    name = Fighter
    desc = Close-combat brawlers who thrive in the thick of battle. Balanced attack and defense with high health.
    statBias = Balanced attack and defense, high health, medium speed and energy.
  marksman
    name = Marksman
    desc = Long-range specialists who pick off enemies from a distance. High attack but fragile up close.
    statBias = High attack, low defense, medium speed, low health, medium energy.
  mage
    name = Mage
    desc = Masters of arcane power who unleash devastating spells. High energy and attack but physically fragile.
    statBias = High attack and energy, low defense and health, medium speed.
  tank
    name = Tank
    desc = Immovable walls of armor and flesh. Very high defense and health, but slow and low damage.
    statBias = Low attack, very high defense and health, low speed and energy.
  assassin
    name = Assassin
    desc = Lethal strikers who eliminate targets with burst damage. Very high attack and speed but extremely fragile.
    statBias = Very high attack and speed, low defense, health, and energy.
  support
    name = Support
    desc = Force multipliers who empower allies and weaken foes. High energy and versatile utility.
    statBias = Low attack, medium defense and health, high energy, medium speed.

// Stat descriptions — shown as tooltips when hovering/holding stats
statInfo
  attack
    name = Attack
    desc = Determines raw damage output. Higher attack means each strike hits harder. Influenced by class and skill basePower.
  defense
    name = Defense
    desc = Reduces incoming damage. A high-defense fighter can weather blows that would fell others. Works against both physical and magical attacks.
  speed
    name = Speed
    desc = Affects reaction time, dodge chance, and how quickly a fighter can chain skills together. Fast fighters act first and more often.
  health
    name = Health
    desc = The total damage a fighter can take before falling. Tanks and fighters naturally have more. Determines survivability in prolonged fights.
  energy
    name = Energy
    desc = The resource pool for active skills. Each skill costs energy to use. Mages and supports rely heavily on energy. Running out limits you to basic attacks.

// Genre presets — shown as selectable cards before hero creation.
genres
  high_fantasy
    name = High Fantasy
    desc = Classic magic worlds of elves, dragons, and ancient spells. Swords hum with enchantment and wizards shape reality itself.
  futuristic
    name = Futuristic Cyborgs
    desc = Neon-lit megacities where flesh merges with steel. Cybernetic enhancements, plasma weapons, and digital warfare.
  apocalyptic
    name = Apocalyptic Mutation
    desc = Post-collapse wastelands where radiation and bio-engineering spawn monstrous abilities. Survival breeds terrible power.
  galactic
    name = Galactic Space
    desc = Interstellar civilizations warring across the cosmos. Alien biology, quantum technology, and the void between stars.
  martial_arts
    name = Martial Arts World
    desc = Ancient dojos and hidden sects where warriors perfect deadly techniques. Chi, ki, and the pursuit of physical perfection.
  dark_fantasy
    name = Dark Fantasy
    desc = Gothic realms of witches, vampires, and werewolves. Cursed blood, forbidden rituals, and an eternity of night.
  holy_war
    name = Holy War
    desc = Divine conflicts between gods and their mortal servants. Celestial power, demonic fury, and the fate of souls hangs in balance.

// Skill subtypes — each skill has 1 or 2 of these.
skillSubtypes
  offense
    name = Offense
    desc = Deals damage to enemies.
  defense
    name = Defense
    desc = Shields or protects from damage.
  buff
    name = Buff
    desc = Enhances self or allies, including healing.
  debuff
    name = Debuff
    desc = Weakens enemies, or self/allies in exchange for power (curses).
  summon
    name = Summon
    desc = Calls allies or constructs to fight.
  control
    name = Control
    desc = Limits enemy actions — stun, slow, freeze, etc.
  mobility
    name = Mobility
    desc = Movement and repositioning.

// Rank tiers — based on ranking points earned from ranked wins.
rankTiers
  beginner
    name = Beginner
    min = 0
    max = 49
  adept
    name = Adept
    min = 50
    max = 99
  veteran
    name = Veteran
    min = 100
    max = 149
  apex_veteran
    name = Apex Veteran
    min = 150
    max = 199
  ranker
    name = Ranker
    min = 200
    max = 249
  apex_ranker
    name = Apex Ranker
    min = 250
    max = 499
  champion
    name = Champion
    min = 500
    max = 999999

// Arena environments — randomly selected for each fight.
// Each item: "Name | visual description for AI image prompt" — the description
// should be concrete, short, and unambiguous (no vague words like "the bowl").
arenas
  Stone Pit
  Iron Colosseum
  Frozen Arena
  Lava Crater
  Sky Platform
  Underground Cavern
  Crystal Dome
  Desert Ruins
  Void Rift
  Forest Clearing
  Thunderdome
  Sunken Temple
  Obsidian Spire
  Wasteland Bunker
  Celestial Bridge

