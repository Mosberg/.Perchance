$meta
  title = Antimatter
  description = Free AI Image & Character Builder
  header
    mode = minimal
    background = #000000
    color = #000000
    title = Antimatter
    subtitle = Antimatter AI Image or Character Generator.

CharBuilder = {import:antimatter-builder}
PresetStyles = {import:antimatter-presets}
AMShared = {import:antimatter-shared}
MultiGalleryViewer = {import:multi-gallery-viewer}
createMediaGallery = {import:antimatter-media-gallery-plugin}
tabbedCommentsPlugin = {import:tabbed-comments-plugin-v1}
image = {import:text-to-image-plugin}
newImg = {import:antimatter-regenerate-port}

commentOptions
  defaultCommentsOptions // see perchance.org/comments-plugin for all available options
    forceColorScheme = dark
    adminPasswordHash = 10a9251edab53ad6e8d7bf2d67c3f6695f08c2b6ecfda3ae4fb865a50be4e0f1
    adminFlair = 💎OWNER💎 // this option will get applied to *all* channels below.
    commentPlaceholderText = Type a friendly comment...
    submitButtonText = submit comment
    customEmojis = {import:huge-emoji-list}
  channels
    allowCustomChannels = true // adds a "+" button so people can add more channels (others won't see the channel unless they also add it)
    general
      label = General Chat
      commentPlaceholderText = To get a nickname or avatar, you need to click on the settings icon right of submit comment.
      submitButtonText = submit
    chat1
      label = Prompts
      commentPlaceholderText = share your prompt here.
      submitButtonText = submit 
      allowBots = false
    chat2
      label = Suggestions
      commentPlaceholderText = request features or report bugs here.
      submitButtonText = submit 
      allowBots = false

generateText = {import:ai-text-plugin}
generateTextOptions
  model = gpt-3.5-turbo
  temperature = 0.7
  maxTokens = 1000
  topP = 1
  frequencyPenalty = 0
  presencePenalty = 0
  stop = ["\n", " Human:", " AI:"]
  prompt = You are a helpful assistant.