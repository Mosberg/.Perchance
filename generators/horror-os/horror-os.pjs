
glitch = {import:glitched-text-tag}

//Ë̶̡̦̘̙̖̳̪̞͎̦͎̼̘́͋̿̎͌̇̊̿̓̊͘͜͠x̴̱̬͇͖̺͊͌̎̋͆̉͑͂͊̊̿̆a̵̢̨̜͎͍̪̗͔͔̗̤̬̩̘͌͗̉͒͋̓͂͠͠m̷̧̨̛͍̞̙͉̦̠̠̜̲̰͉̔̄͊́̃́͋̏̇̈́̂͐̕p̴̛͛̎̃̒̈́̊͝ͅĺ̶̨̤̯̘̣̆̃̓̆͘͠ḛ̴̟̪̩̫̟̗̣̬̲͛̃̍̇̽̇͜ͅ

// === IMAGE FILTER OPTIONS (set `imageFilter` on any entry that has an `image`) ===
  //   none          — no filter (default)
  //   grayscale     — black & white
  //   inverted      — inverted colors (color negative)
  //   sepia         — vintage brown/tan tone
  //   thermal       — thermal-camera palette (hue-rotated + saturated)
  //   nightvision   — green-tinted night vision scope
  //   xray          — x-ray film look (inverted grayscale)
  //   deepfry       — blown-out saturation & contrast
  //   blur          — soft out-of-focus blur
  //   document      — photocopied B&W document
  //   static        — TV static noise overlay
  //   glitch        — RGB chromatic aberration split + jitter
  //   vhs           — VHS tape look (sepia + scanlines + tracking drift)
  //   crt           — CRT monitor scanlines + vignette
  //   cold          — cold blue tint
  //   overexpose    — washed-out bright highlight

// === SIGNAL MONITOR — FREQUENCY TUNER ===
  // Hidden "stations" at specific frequencies. Each has a distinct waveform pattern.
    
  // === ANOMALY OPTIONS (set these on any entry that should interact with the monitor) ===
    //   anomaly             — boolean, must be true to activate the signal monitor anomaly
    //   anomalyType         — "continuous" (sustained signal) or "sporadic" (bursting spikes). Default: "sporadic"
    //   anomalyAmplitude    — number 0..1, controls spike intensity. Default: 1 (continuous) or 0.7 (sporadic)
    //   anomalyName          — string, custom label shown in the signal monitor status readout. Default: "ANOMALY"
    //   anomalyColor         — CSS color string (e.g. "#ff4757" or "rgba(255,0,0,0.8)" or "orange"), trace/glow/echo color during the anomaly. Default: red "#ff4757"
    //   anomalyWave          — function(p) that returns a number, custom waveform blended into the signal sample. Default: none (standard random spike)
    //                          `p` is a phase value that increments ~0.08 per frame. Return values around ±10 fill the canvas height.
    //   independent          — boolean, when true the anomalyWave REPLACES the base signal instead of blending with it. Default: false
    //
    //   Example:
    //     anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.8, independent: true
    //     anomalyName: "MY_SIGNAL", anomalyColor: "#9a5a9a",
    //     anomalyWave: function(p) { return Math.sin(p * 5) * 8; },

// ideas
  
  // Desktop & UI
  
  // Boot sequence customization — let users pick a boot logo/style in Settings, or add a randomized "memory check" animation on reload
  // Window snapping — drag a window to a screen edge and it snaps to fill half the desktop
  // Desktop widgets — a clock, system resource meter (fake CPU/RAM bars), or a "threat level" indicator that changes over time
  // Right-click context menu on the desktop for quick access to settings, wallpaper change, or "new note"
  
  // Case Files / Scenario
  
  // Random event generator — periodically a notification pops up with a new lead, clue, or incident that gets added to the case files

  // Cipher Terminal
  
  // Cipher progression — solving ciphers unlocks harder tiers with new cipher types (Caesar, Vigenère, substitution, etc.)
  // Decoded messages feed into the story — each solved cipher reveals a lore snippet that appears in the Archive

  // Declassify
  
  // Time-attack mode — a timer + leaderboard stored in kv-plugin
  // Procedurally generated puzzles with escalating difficulty curves
  
  // Serpent / Detonation Grid
  
  // Custom grid themes tied to the overall terminal aesthetic (thermal, night vision, etc. — you already have image filters that could inspire this)
  
  // System-wide
  
  // Notifications/toast system — a small stack of terminal-style alerts in the corner
  // Achievements — track milestones (first cipher solved, first declassification, high scores) viewable in a hidden "personnel file" window
  // Ambient audio — subtle terminal hum, typing sounds, or the generate_music tool for a looping background track
  // Glitch events — random moments where the screen distorts briefly (you already have the glitched-text-tag import)

scenarios() =>
  return [
    {  //Trundle Well
      id: 'trundle',
      title: 'The Trundle Incident',
      icon: '📡',
      subtitle: 'ORIGINAL INVESTIGATION',
      summary: 'A looping radio signal. A vanishing postal worker. A sealed borehole breathing in the tundra. Trace the anomaly from 1979 to the final transmission.',
      entries: {
        "Introduction": { title: "Local Archive", text: "Welcome to the Local Archive.<br><br>This repository contains declassified fragments pertaining to the Trundle Incident — a series of anomalous events centered on the remote village of Trundle and its surrounding tundra.<br><br>Words highlighted in <span style='color:var(--wiki-blue)'>BLUE</span> are hyperlinked to related entries. An entry that has all of its links discovered is marked by a green checkmark, while one with no links is marked by a green \"Ø\". Black bars indicate [[REDACTED:classified]] material that can be declassified through the Declassify terminal.<br><br>Begin with the {Radio_Signal} — it is where everything began.", default: true, clearance: 0, status: "PUBLIC ACCESS" },
        "Radio_Signal": {
          title: "The Trundle Frequency",
          image: "https://user.uploads.dev/file/eda56f803c449bfe7f5d854d0150a974.jpg",
          imageCaption: "PHOTOGRAPHIC RECONSTRUCTION — RELAY SITE, CIRCA 1987",
          imageFilter: "glitch",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.7,
          anomalyColor: "#ff4757",
          anomalyWave: function(p) { return Math.sin(p * 2.5) * 17; },
          text: "Designated the {Radio_Signal}, this transmission broadcasts on a frequency that should not exist — one that falls entirely outside the electromagnetic spectrum. It was first detected in March 1987 by amateur radio operator {Lev_Arbatov}, a postal worker from the village of {Trundle_Village}.<br><br>The signal consists of a looping dirge interspersed with coordinates that shift every 24 hours. Following the coordinates leads to a concrete slab identical to the one sealing the Trundle Well. The slab is featureless except for a single engraved symbol that matches no known alphabet.",
          default: false, clearance: 1, status: "ACTIVE"
        },
        "Lev_Arbatov": {
          title: "Lev Arbatov — Subject Profile",
          text: "Lev Arbatov, age 34, was a postal worker residing in {Trundle_Village}. His amateur radio hobby led him to detect the {Radio_Signal} in March 1987. Arbatov spent three weeks tracking the shifting coordinates across the tundra before they converged on a concrete slab.<br><br>He filed reports with regional authorities, who dismissed the findings as interference from Soviet naval operations. Arbatov continued monitoring the signal independently for six months before vanishing from his home on September 14th, 1987. His equipment was still running. A notebook on his desk contained one phrase, written 412 times: 'the well is breathing.'<br><br>His last known direction of travel was towards the {Research_Vessel} wreckage.",
          default: false, clearance: 1, status: "MISSING PERSON"
        },
        "Trundle_Village": {
          title: "Trundle — Village Dossier",
          text: "Trundle is a small settlement in the northern tundra, established in 1953 as a meteorological outpost and later converted to civilian use. At its peak, the village housed 87 residents. By 1987, the population had dwindled to 31.<br><br>The village sits 14 kilometers from the {Trundle_Well|well site} drilled in 1979. Locals long reported strange acoustic phenomena — subsonic vibrations that caused nosebleeds and disorientation. Soviet geologists attributed these to permafrost shifting, but residents insisted the sounds were rhythmic, as if something were tapping from below.<br><br>The village was evacuated in October 1987, two days after the {Radio_Signal} was traced to the area. Most residents were resettled. Seven refused to leave. None of the seven were ever found. The regional {Radiation} survey began the following month.",
          default: false, clearance: 1, status: "EVACUATED"
        },
        "Research_Vessel": {
          title: "The R/V Kutuzov",
          text: "The Soviet research vessel Kutuzov was conducting hydroacoustic surveys in the Kara Sea when contact was lost on October 3rd, 1987. It was rediscovered six weeks later, drifting with no crew aboard.<br><br>Navigation logs showed a direct route towards the Trundle coastline. The ship's galley contained food that had been freshly prepared — still warm — with 12 place settings. Lifeboats were intact. The radio room was [[REDACTED:locked]] from the inside. A single {Radio_Signal|transmission} was found looping on the ship's transmitter.<br><br>The vessel's final position correlates with the null-radiation zone documented in the {Radiation} report. The ship's route also intersects the path taken by the {Missing_Pilgrims} before their disappearance. The Kutuzov remains quarantined at an undisclosed port.",
          default: false, clearance: 2, status: "QUARANTINED"
        },
        "Radiation": {
          title: "Radiation Report — Trundle Site",
          text: "Initial surveys of the Trundle site anticipated lethal levels of gamma radiation consistent with a nuclear event. Instead, the area registered a complete null reading — zero measurable radiation across all bands.<br><br>Scientists from the Institute of Applied Physics described the result as 'a pocket of anti-reality,' a region where the fundamental constants appeared to be [[REDACTED:inverted]]. Equipment brought within the null zone ceased functioning but showed no damage upon removal. Magnetic compasses pointed downward.<br><br>The phenomenon is believed connected to the {Subject_01} anomaly. The survey team's geological findings are documented separately under the {Well_Survey|well drilling records}.",
          default: false, clearance: 2, status: "SUPPRESSED"
        },
        "Missing_Pilgrims": {
          title: "The Missing Pilgrims",
          text: "In the summer of 1991, an expedition of 52 individuals — self-described as pilgrims — traveled to the old Trundle signal relay. All 52 vanished within a 3-hour window on July 19th.<br><br>Search teams found empty tents, fully packed supplies, and 47 pairs of boots arranged in a [[REDACTED:radial]] pattern, all pointing outward from a central point. The remaining five pilgrims had left no boots behind. Footprints in the snow simply stopped mid-stride, as if each person had stepped off the edge of the world.<br><br>The pilgrims' route had passed near the {Research_Vessel} wreckage. The full investigation is documented under {Subject_02}.",
          default: false, clearance: 2, status: "COLD CASE"
        },
        "Subject_01": {
          title: "Subject 01 — The Trundle Anomaly",
          text: "The {Subject_01} anomaly refers to the electromagnetic event registered near the Trundle perimeter on October 1st, 1987 — two days before the loss of the {Research_Vessel|Kutuzov}.<br><br>Government sensors recorded a sudden atmospheric spike followed by a complete radiation null, consistent with the {Radiation} report. The event lasted 11 minutes. During that window, every clock in the village of Trundle stopped at different times.<br><br>Witnesses within a 5-kilometer radius reported a persistent, high-pitched hum that resonated like a [[REDACTED:heartbeat]]. Several described the sound as 'coming from [[REDACTED:underneath]].' The anomaly is believed to be directly linked to the {Event_004} that occurred five years later. A firsthand account survives in the {Survivor_Log|survivor testimony}.",
          default: false, clearance: 3, status: "ARCHIVED"
        },
        "Subject_02": {
          title: "Subject 02 — The Pilgrim Investigation",
          text: "Following the disappearance documented under {Missing_Pilgrims}, a single {Radio_Signal} recording was recovered from the pilgrims' final campsite. The signal was broadcasting its standard dirge, but overlaid with a fragmented spoken message: 'It wears the face of your [[REDACTED:regret]].'<br><br>Analysis confirmed the voice belonged to {Lev_Arbatov} — the postal worker who had vanished four years earlier. The recording was time-stamped three days AFTER the pilgrims disappeared.<br><br>Among the pilgrims' belongings was a hand-drawn map showing the {Research_Vessel|Kutuzov} at the center of [[REDACTED:concentric]] circles, with notations in a language linguists could not identify. The {Well_Survey|geological records} from the original drilling expedition provided the only corroborating data.",
          default: false, clearance: 3, status: "ARCHIVED"
        },
        "Well_Survey": {
          title: "Geological Survey — Trundle Borehole",
          text: "The original geological survey of the Trundle site was conducted in 1979 by a team of six Soviet geologists. The borehole was intended to study permafrost composition but penetrated an unexpected hollow cavity at a depth of 12 kilometers.<br><br>Instruments lowered into the cavity detected a breathable atmosphere at 21 degrees Celsius — despite the surrounding rock being at -4 degrees. The cavity extended well beyond the borehole's diameter, suggesting a vast underground [[REDACTED:chamber]]. Sonar returns were inconsistent, as if the walls were [[REDACTED:moving]].<br><br>The team recommended immediate sealing. The borehole was filled with 40 tons of concrete. Two of the six geologists resigned their posts; one was later admitted to a psychiatric facility. The full history of the site is documented under {Trundle_Well}. The survey data would prove critical to understanding the {Event_004|later events} and the {Subject_01|anomaly}.",
          default: false, clearance: 3, status: "GEOTECHNICAL"
        },
        "Event_004": {
          title: "Event Log 004 — The Night of Many Eyes",
          text: "Designated {Event_004}, this incident occurred on the winter solstice of 1992 — December 21st. Satellite imagery captured an impossible grid of lights across the Trundle tundra, spanning 12 kilometers in every direction.<br><br>The light pattern exactly matched the radial layout of the boots left by the {Missing_Pilgrims}. Each light source was positioned where a pair of boots had been found. The five missing pairs — the five pilgrims who left no boots — corresponded to five lights that were [[REDACTED:white]].<br><br>Ground teams dispatched at dawn found nothing. The tundra was dark and undisturbed. However, the concrete slab near the site was [[REDACTED:warm]] to the touch, and the seal on the {Trundle_Well} had developed a hairline crack. The military response is documented under {Military_Response}. A single team member kept a {Survivor_Log|private journal}.",
          default: false, clearance: 4, status: "ARCHIVED"
        },
        "Military_Response": {
          title: "Operation Glasseye — Military Aftermath",
          text: "Following {Event_004}, the Soviet military dispatched a 40-personnel task force codenamed Operation Glasseye. The team arrived 72 hours after the event, equipped with full NBC (nuclear, biological, chemical) gear.<br><br>Of the 40 personnel, 28 refused to enter the grid area after their instruments registered impossible readings — compasses spinning, radios receiving on dead channels, and Geiger counters reporting [[REDACTED:negative]] values. The remaining 12 personnel entered the grid perimeter. Contact was maintained for 4 minutes, after which all 12 went silent simultaneously.<br><br>A recovery team found their NBC suits standing upright in formation, [[REDACTED:empty]]. The suits were [[REDACTED:unzipped]] from the inside. The operation was classified at the highest level. The {Trundle_Well|well site} was placed under permanent guard until the seal failed.",
          default: false, clearance: 4, status: "CLASSIFIED"
        },
        "Survivor_Log": {
          title: "Survivor Log — Pvt. E. Volkov",
          text: "Private Evgeny Volkov was one of the 28 personnel who refused to enter the grid during {Military_Response|Operation Glasseye}. His personal journal was recovered during the debriefing. Excerpts follow:<br><br>'The lights were white. Not amber like the report said. White, like looking at the sun through a pinhole. Five of them, exactly where the missing boots should have been. The slab was warm — 42 degrees in minus-30 air. The crack in the seal was 3 centimeters long and I could feel air moving through it. Warm air. [[REDACTED:Wet]].<br><br>I heard my mother calling my name from inside the {Trundle_Well|well}. She died in 1974. I ran. I am writing this from the evac truck. Sergeant Petrov says the 12 who went in are [[REDACTED:fine]]. He is [[REDACTED:lying]]. I can see their suits standing in the dark, and there is no one inside.'<br><br>Volkov was later admitted to the same psychiatric facility as the {Subject_01|geologist from the 1979 survey}.",
          default: false, clearance: 4, status: "PERSONAL LOG"
        },
        "Trundle_Well": {
          title: "The Trundle Well",
          image: "https://user.uploads.dev/file/34cafe29dad041bc864cd0f3ac52e63c.jpg",
          imageCaption: "SITE SURVEILLANCE — BOREHOLE SEAL, POST-EVENT_004",
          imageFilter: "nightvision",
          text: "Drilled in 1979 as part of a Soviet geological survey (see {Well_Survey}), the Trundle Well was abandoned after reaching a depth of 12 kilometers. At that depth, instruments detected a massive hollow cavity filled with a breathable atmosphere at a constant temperature — despite the surrounding rock being at -4 degrees.<br><br>The borehole was sealed with 40 tons of concrete. Thermal scans in 1992 revealed the seal had gone cold, as if nothing beneath it was generating heat. By 1993 — after the {Event_004} — a hairline crack had appeared in the seal, and the temperature at the bottom of the well had risen to 37 degrees: [[REDACTED:human body temperature]].<br><br>On quiet nights, locals report hearing [[REDACTED:voices]] from the well, speaking in languages they feel they should [[REDACTED:remember]] but cannot. The {Black_Box} recovered the following year may hold the only key to what lies beneath. A {Final_Transmission|final signal} was detected emanating from the well in 1995.",
          default: false, clearance: 5, status: "SEALED"
        },
        "Final_Transmission": {
          title: "Final Transmission — Well Signal 1995",
          text: "On March 14th, 1995, every radio receiver within 200 kilometers of Trundle simultaneously detected a broadcast originating from inside the {Trundle_Well}. The signal lasted exactly 7 minutes and was traced to a depth of 12 kilometers — the cavity floor.<br><br>The transmission consisted of a single spoken phrase, repeated on a loop: 'We are not dead. We are not alive. We are [[REDACTED:waiting]]. Come [[REDACTED:home]].' Voiceprint analysis matched the speaker to {Lev_Arbatov} with 94 percent certainty, despite Arbatov having vanished eight years earlier.<br><br>The signal contained an embedded subcarrier frequency identical to the original {Radio_Signal|Trundle Frequency}. When the transmission ended, the crack in the well's seal widened by 4 centimeters. The site was abandoned. The {Black_Box|black box} recovered the previous year is believed to be the only device capable of interpreting the full message.",
          default: false, clearance: 5, status: "INTERCEPTED"
        },
        "Black_Box": {
          title: "The Unlabeled Black Box",
          text: "Recovered in 1994 from the wreckage of a downed military transport 80 kilometers from Trundle, this {Black_Box} contains no flight data. Instead, it holds a single reel of magnetic tape wound tightly around a human [[REDACTED:molar]] tooth.<br><br>Dental records matched the tooth to {Lev_Arbatov}. When played, the tape emits static — yet every listener reports hearing their own name whispered by a voice from their [[REDACTED:childhood]]. Listeners who hear the full tape develop an irresistible urge to travel to the {Introduction|Trundle site}.<br><br>The box is believed to be the key to understanding the {Subject_01} anomaly and the {Final_Transmission|well signal}. No one who has attempted to use it at the site has [[REDACTED:returned]]. The full implications are documented under {The_Truth|the final entry}.",
          default: false, clearance: 6, status: "RESTRICTED"
        },
        "The_Truth": {
          title: "The Truth — Composite Analysis",
          text: "The {Black_Box|black box} tape, when played at the edge of the {Trundle_Well|well}'s cracked seal, produced a response. The crack widened fully. What emerged was not a creature or a phenomenon — it was a [[REDACTED:place]].<br><br>The cavity at the bottom of the well is a doorway. It opens onto a version of Earth where humanity never evolved, but something else did. The {Radio_Signal|signal}, the {Missing_Pilgrims|pilgrims}, the crew of the {Research_Vessel|Kutuzov}, the 12 soldiers from {Military_Response|Operation Glasseye}, and {Lev_Arbatov} himself — they are all there. Alive. Unchanged. [[REDACTED:Waiting]].<br><br>The {Final_Transmission|transmission from the well} was not a warning. It was an [[REDACTED:invitation]]. The [[REDACTED:door]] is still open. It has been open since 1979. Everything since — the signal, the anomaly, the pilgrims, the lights — has been the slow turning of a key in a lock that was never really locked at all.<br><br>The well is not a grave. It is a [[REDACTED:threshold]]. And we have been standing on the wrong side of it the entire time.",
          default: false, clearance: 6, status: "FINAL ENTRY"
        },
        "_TEST_NO_LINKS_": {
          title: "Test Entry — No Links",
          text: "This is a temporary test entry with no hyperlinks and no redacted words. It should display the 'no links' icon on the sidebar.",
          default: true, clearance: 0, status: "TEST"
        },
      },
      cipher: [
        { id: 1, title: "Cipher #1 — Signal Origin", hint: "Cross-reference: Radio Signal, Lev Arbatov, and the Village Dossier", parts: ["The signal falls outside the ", " spectrum. It was detected in ", " 1987 by a ", " worker. The coordinates shift every ", " hours. Trundle sits in the ", " tundra."], answers: ["electromagnetic", "March", "postal", "24", "northern"], solved: false },
        { id: 2, title: "Cipher #2 — Site Investigation", hint: "Three investigation reports plus the earlier Signal and Arbatov files", parts: ["The vessel's galley had ", " place settings. ", " pilgrims vanished within a ", "-hour window. The radiation reading was ", ", suggesting a pocket of ", "-reality. The slab was made of ", ". Arbatov vanished on September ", "th."], answers: ["12", "52", "3", "null", "anti", "concrete", "14"], solved: false },
        { id: 3, title: "Cipher #3 — The Anomaly", hint: "The anomaly files, the pilgrim investigation, and the geological survey", parts: ["The anomaly occurred on October 1st, ", ". The pilgrims vanished in the summer of ", ". ", " pairs of boots were found. The anomaly lasted ", " minutes, producing a sound like a ", ". The recording said: 'It wears the face of your ", ".' The survey reached a depth of ", " kilometers."], answers: ["1987", "1991", "47", "11", "heartbeat", "regret", "12"], solved: false },
        { id: 4, title: "Cipher #4 — Night of Many Eyes", hint: "Event Log 004, Operation Glasseye, the Survivor Log — and the original pilgrim count", parts: ["The event occurred on the winter ", " of ", " 21, 1992. The lights spanned ", " kilometers, matching the ", " pairs of boots. Five lights were ", ". The slab was ", " to the touch. The military arrived ", " hours later. The crack was ", " centimeters long."], answers: ["solstice", "December", "12", "47", "white", "warm", "72", "3"], solved: false },
        { id: 5, title: "Cipher #5 — The Well", hint: "The Well record, the Final Transmission — and the original geological survey", parts: ["The well was drilled in ", " and reached a depth of ", " kilometers. It was sealed with ", " tons of concrete. The cavity had a breathable atmosphere at ", " degrees. After Event_004, the temperature rose to ", " degrees. The final transmission lasted ", " minutes, with a ", " percent voice match."], answers: ["1979", "12", "40", "21", "37", "7", "94"], solved: false }
      ],
      signalStations: [
        { freq: 2.3,  label: 'DIRGE', color: '#ff4757', wave: function(p) { return Math.sin(p * 2.3) * 12 * (0.6 + 0.4 * Math.sin(p * 0.1)); } },
        { freq: 10,  label: 'BEACON', color: '#6a8a6a', independent: true, wave: function(p) { return (Math.sin(p * 2) > 0 ? 10 : -10) } },
        { freq: 5.7,  label: 'BREATH', color: '#ff4757', independent: true, wave: function(p) { let h = function(n,c) { let x = Math.sin(n * 127.1 + c * 311.7) * 43758.5453; return x - Math.floor(x); }; let cycle = 0, acc = 0, period = 7, type = 0; for (let i = 0; i < 50000; i++) { let tr = h(0.5, cycle); type = tr > 0.82 ? 1 : tr > 0.62 ? 2 : tr > 0.5 ? 3 : 0; period = type === 1 ? 11 + 2 * h(1.1, cycle) : type === 2 ? 3.8 + 1.4 * h(1.1, cycle) : 6.5 + 2.8 * h(1.1, cycle); if (acc + period > p) break; acc += period; cycle++; } let t = p - acc, r1 = h(2.3, cycle), r2 = h(4.7, cycle), r3 = h(8.9, cycle); let env = Math.max(0.35, 0.5 + 0.5 * Math.sin(p * 0.018 + cycle * 1.3)); let dr = 0.6 * Math.sin(p * 0.06); if (type === 2) { let amp = 10 + 4 * r1, inh = 0.18 + 0.08 * r2, he = inh + 0.12; if (t < inh) return -amp * env * (t / inh) + dr; if (t < he) return -amp * env + dr; let u = (t - he) / (period - he); return -amp * env * Math.pow(1 - u, 1.8) * (1 + 0.3 * Math.sin(u * 30)) + dr; } if (type === 1) { let amp = 16 + 3 * r1, inh = 0.7 + 0.3 * r2, ho = 0.5 + 0.3 * r3, he = inh + ho; if (t < inh) return -amp * env * Math.pow(t / inh, 0.4) + dr; if (t < he) return -amp * env * (0.98 + 0.02 * Math.sin(t * 20)) + dr; let u = (t - he) / (period - he), d = Math.pow(1 - u, 2.2); return -amp * env * d - 2.5 * env * d * Math.sin(u * 55) * (0.5 + u) - 2.8 * env * Math.exp(-Math.pow((u-0.2)/0.06,2)) - 1.8 * env * Math.exp(-Math.pow((u-0.5)/0.07,2)) + dr; } if (type === 3) { let amp = 12 + 3 * r1, inh = 0.35 + 0.15 * r2, he = inh + 0.3, ca = 0.35 + 0.2 * r3, ee = he + ca; if (t < inh) return -amp * env * Math.pow(t / inh, 0.35) + dr; if (t < he) return -amp * env * 0.97 + dr; if (t < ee) { let u = (t - he) / ca; return -amp * env * Math.pow(1 - u, 1.5) + dr; } let u2 = (t - ee) / (period - ee); return -2.5 * env * Math.exp(-Math.pow((u2-0.4)/0.08,2)) + dr; } let amp = 12 + 3 * r1, inh = 0.3 + 0.15 * r2, ho = 0.2 + 0.2 * r3, he = inh + ho, hk = h(16.3, cycle) > 0.5; if (t < inh) return -amp * env * Math.pow(t / inh, 0.3) + dr; if (t < he) return -amp * env * (0.96 + 0.04 * Math.sin(t * 28)) + dr; let u = (t - he) / (period - he), d = Math.pow(1 - u, 1.9), y = -amp * env * d - 1.8 * env * d * Math.sin(u * 42) * u; if (hk) y += -2.6 * env * Math.exp(-Math.pow((u-0.25)/0.04,2)); return y + dr; } },
        { freq: 8,  label: 'TAP', color: '#aaa', wave: function(p) { let s = Math.sin(p * 9.1); return s > 0.99 ? s * 18 : 0; } },
        { freq: 13.4, label: 'WELL', color: '#9b59b6', wave: function(p) { return Math.sin(p * 13.4) * 8 + Math.sin(p * 6.7) * 5; } },
        { freq: 19.2, label: 'STATIC', color: '#666', wave: function(p) { return (Math.random() - 0.5) * 8 * (0.2 + 0.8 * Math.abs(Math.sin(p * 0.3))); } },
        { freq: 25.6, label: 'BELOW', color: '#4a9eff', wave: function(p) { return Math.sin(p * 25.6) * 3 * Math.sin(p * 0.05) + Math.sin(p * 12.8) * 5; } },
      ],
    },
    {  //Hollow Coast
      id: 'hollow',
      title: 'The Hollow Coast',
      icon: '🦴',
      subtitle: 'FIELD EXPANSION — CASE B',
      summary: 'A fishing town where the tide stopped returning. Bones in the salt flats hum at 7 Hz. Recover the lost sonar logs before the next new moon.',
      entries: {
        "Introduction": { title: "Local Archive", text: "Welcome to the Local Archive.<br><br>This repository contains declassified fragments pertaining to the Hollow Coast incident — a series of anomalous events centered on the fishing town of Kessick and the surrounding salt flats.<br><br>Words highlighted in <span style='color:var(--wiki-blue)'>BLUE</span> are hyperlinked to related entries. Black bars indicate [[REDACTED:classified]] material that can be declassified through the Declassify terminal.<br><br>Begin with the {Kessick_Tide} — it is where everything began.", default: true, clearance: 0, status: "PUBLIC ACCESS" },
        "Kessick_Tide": {
          title: "The Kessick Tide",
          image: "https://user.uploads.dev/file/feebdf245bcbaa9f5dbff1c40d37af5e.jpg",
          imageCaption: "AERIAL RECON — EXPOSED HARBOUR SEABED, DAY 3",
          imageFilter: "thermal",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.9,
          anomalyName: "KESSICK", anomalyColor: "#4a9eff", anomalyWave: function(p) { return Math.sin(p*7) * 8 * Math.max(0, Math.sin(p*0.15)); },
          text: "On the morning of June 4th, 1989, the tide at {Kessick_Tide} failed to return. The harbour, normally eighteen feet deep at high water, lay exposed for the first time in recorded history. Fish flopped in the mud. Boats listed against the harbour wall.<br><br>By noon the sea had not come back. By dusk, townsfolk reported a low hum rising from the exposed seabed — a {Tuning_Signal|tuning signal} that rattled window glass and set dogs to howling. The local {Salt_Flats|salt flats} began to weep a thick, dark brine that would not evaporate.<br><br>The {Coastguard_Log|coastguard} logged the event as an unexplained tidal anomaly. The tide has not returned.",
          default: false, clearance: 1, status: "ACTIVE"
        },
        "Coastguard_Log": {
          title: "Coastguard Log — Kessick Station",
          text: "The {Coastguard_Log} for Kessick Station records the morning the tide failed as follows: '0600 — expected high water, nil. 0700 — seabed exposed, vessels grounding. 0800 — acoustic anomaly, source sub-seabed. {Kessick_Tide|Tide} negative.'<br><br>By the third day the log entries grow terse. The officer in charge, Warrant Officer {Maren_Holt}, noted that the depth sounder returned a flat line even when held above the mud — as though the seabed had no bottom. He requested a {Sonar_Survey|geological survey} from the regional authority.<br><br>The final entry, dated nine days after the tide's failure, reads only: 'the mud is [[REDACTED:breathing]]. requesting immediate evacuation.' No evacuation was granted. The station is now abandoned.",
          default: false, clearance: 1, status: "ARCHIVED"
        },
        "Maren_Holt": {
          title: "Maren Holt — Officer Profile",
          text: "Warrant Officer {Maren_Holt}, age 51, served as station officer at Kessick for nineteen years. He was the first to document the {Kessick_Tide|tide's} failure and the {Tuning_Signal|hum} that followed.<br><br>Holt kept a personal notebook in addition to the official {Coastguard_Log|log}. In it he sketched the exposed seabed and noted that the mud, when disturbed, released bubbles of a gas that smelled of ozone and blood. He recorded the hum's frequency as 7 Hz — below the threshold of conscious hearing but felt in the teeth and sternum.<br><br>Holt disappeared on the eleventh day. His boat was found drifting a mile offshore, engine cold, nets neatly stowed. His notebook lay open on the chart table, the final page bearing a single line written over and over: 'it is [[REDACTED:tuning]] itself.' His fate is entwined with the {Bones|bones} later found on the flats.",
          default: false, clearance: 1, status: "MISSING PERSON"
        },
        "Tuning_Signal": {
          title: "The Tuning Signal",
          text: "The {Tuning_Signal} is the persistent 7 Hz hum first documented by {Maren_Holt} on the morning the {Kessick_Tide|tide} failed. Instruments confirm it emanates from beneath the exposed seabed, though its precise source cannot be triangulated — it seems to come from everywhere at once.<br><br>Acousticians describe the frequency as 'biological in origin.' It matches no known geological or mechanical signature. Notably, 7 Hz falls within the range of the human body's natural resonance; prolonged exposure produces vertigo, nosebleeds, and a sensation of internal vibration.<br><br>Three weeks after the tide's failure, the hum changed. Listeners reported that it now carried a faint, structured pattern — as though something beneath the mud were attempting to {Tuning_Signal|tune} itself to a voice. The {Sonar_Survey|sonar survey} would capture the clearest recording. The {Hollow_Child|final pattern} is now believed to be a response.",
          default: false, clearance: 2, status: "INTERCEPTED"
        },
        "Salt_Flats": {
          title: "The Salt Flats",
          text: "The {Salt_Flats} extend north of Kessick along the receded coastline. Where the sea withdrew, a vast crust of crystallised salt remained — flat, white, and warm to the touch despite the air temperature.<br><br>Within days of the {Kessick_Tide|tide's} failure, dark brine began to seep upward through fissures in the crust. The brine does not evaporate. It pools in shallow depressions and, when disturbed, ripples in concentric rings despite the absence of wind.<br><br>The flats soon yielded a more disturbing feature. Eroding out of the salt were bones — not fish, not seabird, but [[REDACTED:human]]. The {Bones|recovery operation} documented hundreds within the first month. The brine, when analysed, was found to contain traces of a protein compound not present in any living tissue on record.",
          default: false, clearance: 2, status: "CONTAMINATED"
        },
        "Bones": {
          title: "The Bones of the Flats",
          text: "The {Bones} recovered from the {Salt_Flats|flats} number in excess of four hundred. Dental and skeletal analysis confirms them as human, yet none match any missing persons record. Stranger still, all lack skulls.<br><br>The bones are arranged in a pattern invisible from ground level. Aerial photographs commissioned by the {Recovery_Op|recovery team} revealed a [[REDACTED:spiral]] beginning at the harbour mouth and tightening toward a central point offshore — the precise location where {Maren_Holt}'s boat was found drifting.<br><br>Each bone hums faintly when struck, producing a tone identical to the {Tuning_Signal|7 Hz signal}. The recovery team's report is sealed, but fragments suggest the bones are not remains but [[REDACTED:instruments]] — components of something that was meant to be assembled. The {Sonar_Survey|sonar survey} and the {Final_Recording|final recording} provide the only context.",
          default: false, clearance: 3, status: "RESTRICTED"
        },
        "Sonar_Survey": {
          title: "Sonar Survey — Kessick Seabed",
          text: "The {Sonar_Survey} was conducted by a naval hydrography unit three weeks after the {Kessick_Tide|tide's} failure, in response to {Maren_Holt}'s request. The survey vessel deployed a towed array across the exposed seabed.<br><br>Findings were immediate and anomalous. The seabed, rather than sloping to a continental shelf, dropped vertically at the harbour mouth into a shaft of indeterminate depth. Sonar returns did not bounce back — they were absorbed, then returned seconds later, [[REDACTED:altered]], as though the shaft were listening and replying.<br><br>The clearest return depicted a structure at approximately 800 metres' depth: a hollow, [[REDACTED:chitinous]] lattice, kilometres in extent, that resonated in sympathy with the {Tuning_Signal|7 Hz hum}. The survey team's report is cross-referenced in the {Hollow_Child|later analysis}. The raw recording was later played back during the {Final_Recording|final incident}.",
          default: false, clearance: 3, status: "GEOTECHNICAL"
        },
        "Recovery_Op": {
          title: "Recovery Operation — Salt Flats",
          text: "The {Recovery_Op} was a joint police/military detail dispatched to the {Salt_Flats|flats} to catalogue the bones. Forty personnel established a base camp two kilometres inland.<br><br>Within the first week, twelve personnel reported hearing their own names spoken from beneath the salt crust. Eight deserted. Of the remainder, a subgroup of five began, without instruction or coordination, to arrange recovered bones into a new configuration on the flat — a [[REDACTED:horn]] or aperture, pointed out to sea.<br><br>When ordered to desist, the five complied. That night, all five walked out onto the flats and were not seen again. Their footprints terminated at the waterline of the absent sea. The arrangement they had begun completed itself overnight by unknown means. The {Hollow_Child|subsequent analysis} and {Final_Recording|final recording} hinge on this event.",
          default: false, clearance: 4, status: "CLASSIFIED"
        },
        "Hollow_Child": {
          title: "The Hollow Child",
          text: "Designated {Hollow_Child}, this analysis was compiled six months after the {Kessick_Tide|tide's} failure by a civilian acoustic research group. It correlates the {Tuning_Signal|7 Hz signal}, the {Sonar_Survey|seabed structure}, and the configuration of {Bones|bones} on the {Salt_Flats|flats}.<br><br>The conclusion: the shaft beneath the harbour mouth, the lattice at 800 metres, the humming bones, and the aperture assembled by the {Recovery_Op|recovery team} form a single apparatus — an organism, or part of one, that is [[REDACTED:tuning]] itself to communicate. The 7 Hz signal is not noise. It is a [[REDACTED:voice]] attempting to form words.<br><br>The analysis names the organism 'the Hollow Child' after a phrase recovered from {Maren_Holt}'s notebook: 'it is a child, and it is learning to speak, and it is calling its parents home.' The {Final_Recording|final recording} confirmed this interpretation in the worst possible way.",
          default: false, clearance: 5, status: "ARCHIVED"
        },
        "Final_Recording": {
          title: "Final Recording — The Shore Incident",
          text: "The {Final_Recording} was captured on the anniversary of the {Kessick_Tide|tide's} failure, when a research team played the raw {Sonar_Survey|sonar recording} back into the shaft at the harbour mouth.<br><br>The response was immediate. The {Tuning_Signal|hum} ceased. The assembled bone aperture on the {Salt_Flats|flats} oriented toward the shaft. For four minutes and eleven seconds, a sound emerged from beneath the seabed that all present described as speech — slow, tonal, and structured, though no language could be identified.<br><br>The recording, when slowed further, resolves into a single repeated phrase. Translation is contested, but the most widely accepted rendering is: 'I have found a [[REDACTED:throat]]. I have learned your [[REDACTED:names]]. I am coming [[REDACTED:up]].'<br><br>Following the recording, the tide began to return. It has not yet reached the harbour wall. The water is warm. The {Introduction|final entry} contains the composite conclusion.",
          default: false, clearance: 5, status: "INTERCEPTED"
        },
        "The_Truth": {
          title: "The Truth — Composite Analysis",
          text: "The {Final_Recording|final recording} was not a warning. It was a birth announcement.<br><br>The {Tuning_Signal|signal}, the {Bones|bones}, the {Sonar_Survey|lattice} beneath the seabed, and the aperture assembled by the {Recovery_Op|recovery team} were stages in a single process. The Hollow Coast was never haunted. It was [[REDACTED:gestating]].<br><br>The shaft beneath the harbour mouth opens onto a cavity — vast, warm, and inhabited by something that has spent forty years learning to speak. The {Kessick_Tide|tide's} failure was not an anomaly. It was a [[REDACTED:contraction]]. The returning water is not the sea returning. It is the thing beneath rising.<br><br>The {Coastguard_Log|coastguard officer} who wrote 'the mud is breathing' was not speaking metaphorically. {Maren_Holt|Maren Holt} heard it first, and it heard him. He is [[REDACTED:down there]] still. He is the one teaching it our names.<br><br>The tide will reach the harbour wall within the year. We are not being invaded. We are being [[REDACTED:born]].",
          default: false, clearance: 6, status: "FINAL ENTRY"
        },
      },
      cipher: [
        { id: 1, title: "Cipher #1 — The Tide", hint: "Cross-reference: the Kessick Tide, the Coastguard Log, and Officer Holt's profile", parts: ["The tide failed on the morning of June ", "th, 1989. The harbour was normally ", " feet deep. The hum registered at ", " Hz. Maren Holt served for ", " years at Kessick."], answers: ["4", "eighteen", "7", "nineteen"], solved: false },
        { id: 2, title: "Cipher #2 — The Flats", hint: "The Salt Flats, the Bones, and the Coastguard Log", parts: ["Over ", " bones were recovered, all lacking ", ". The brine pooled in ", " rings. The bones hummed at ", " Hz, identical to the ", " signal."], answers: ["four hundred", "skulls", "concentric", "7", "tuning"], solved: false },
        { id: 3, title: "Cipher #3 — The Survey", hint: "The Sonar Survey, the Bones, and the Tuning Signal", parts: ["The seabed dropped ", " metres to a lattice. Sonar returns came back ", ". The structure was ", " in nature. The survey was requested by Warrant Officer ", "."], answers: ["800", "altered", "chitinous", "Maren Holt"], solved: false },
        { id: 4, title: "Cipher #4 — The Recovery", hint: "The Recovery Operation, the Hollow Child analysis, and the original bone count", parts: ["Forty personnel staffed the base. ", " deserted. ", " walked onto the flats and vanished. They had arranged bones into a ", " or aperture pointed ", " to sea."], answers: ["eight", "five", "horn", "out"], solved: false },
        { id: 5, title: "Cipher #5 — The Voice", hint: "The Final Recording, the Hollow Child analysis, and the Sonar Survey", parts: ["The final recording lasted ", " minutes and ", " seconds. The phrase was rendered as: 'I have found a ", ". I have learned your ", ". I am coming ", ".'"], answers: ["four", "eleven", "throat", "names", "up"], solved: false }
      ],
      signalStations: [
        { freq: 0.8,  label: 'TIDE', color: '#4a9eff', wave: function(p) { return Math.sin(p * 0.8) * 16 * (0.5 + 0.5 * Math.sin(p * 0.05)); } },
        { freq: 3.5,  label: 'CURRENT', color: '#6a8a6a', wave: function(p) { return Math.sin(p * 3.5) * 10 + Math.sin(p * 1.75) * 6; } },
        { freq: 7.0,  label: 'TUNING', color: '#4a9eff', independent: true, wave: function(p) { return Math.sin(p * 7) * 8 * Math.max(0, Math.sin(p * 0.15)); } },
        { freq: 11.7, label: 'BONE', color: '#e67e22', wave: function(p) { let s = Math.sin(p * 11.7); return s * s * s * 12; } },
        { freq: 15.3, label: 'SALT', color: '#aaa', wave: function(p) { return Math.sin(p * 15.3) * 5 + Math.sin(p * 7.65) * 5; } },
        { freq: 20.8, label: 'CHORUS', color: '#9a5a9a', wave: function(p) { return Math.sin(p * 20.8) * 4 + Math.sin(p * 10.4) * 4 + Math.sin(p * 6.9) * 4; } },
        { freq: 27.1, label: 'RISE', color: '#4a9eff', wave: function(p) { return Math.sin(p * 27.1) * 2 * Math.sin(p * 0.12) + Math.sin(p * 13.55) * 6; } },
      ],
    },
    {  //Nightshift County Animal Control
      id: 'hotline',
      title: 'Nightshift County Animal Control',
      icon: '🐾',
      subtitle: 'WILDLIFE INCIDENT CATALOG — DISPATCH MANUAL',
      summary: 'A classified wildlife incident log used by Nightshift County Animal Control dispatchers. From raccoons and stray dogs to things that wear animal shapes, things that should not be alive, and things that come from where the woods end. Identify what is really at the door.',
      entries: {
        "Introduction": { title: "Wildlife Incident Catalog", text: "Welcome to the Wildlife Incident Catalog.<br><br>This repository catalogs animal encounters reported through the Nightshift County Animal Control dispatch line. Calls are received between 10 PM and 6 AM only. Entries are ordered by incident severity. Common wildlife calls are available to all dispatch personnel. Entries beyond your clearance are restricted.<br><br>Words highlighted in <span style='color:var(--wiki-blue)'>BLUE</span> are hyperlinked to related entries. An entry that has all of its links discovered is marked by a green checkmark, while one with no links is marked by a green \"Ø\". Black bars indicate [[REDACTED:classified]] material that can be declassified through the Declassify terminal.<br><br>Begin with the {Trash_Raccoon} entry — it is the baseline against which all other incidents are measured.", default: true, clearance: 0, status: "PUBLIC ACCESS" },
        "Trash_Raccoon": {
          title: "Trash Raccoon — Incident #001",
          image: "https://user.uploads.dev/file/5fa5e368e09bf840af5f51c2d9791dc0.jpg",
          imageCaption: "TRAIL CAM — RESIDENCE #4471, MARCH 2024",
          imageFilter: "nightvision",
          text: "Common raccoon foraging in residential garbage bins. The most frequent call on the Wildlife Incident Catalog and the baseline against which all other reports are measured.<br><br>Trash Raccoons are identified by overturned bins, scattered refuse, and tracks in mud or snow — five-toed prints with elongated rear heels. They are nocturnal, opportunistic, and avoid direct human contact. They are attracted to food waste, pet food left outdoors, and compost piles.<br><br>Distinguish from {Attic_Bat} (which produces high-pitched vocalizations, not ground-level rummaging) and {Stray_Dog|stray dogs} (which leave different tracks and do not climb bins). If the caller reports the raccoon is the size of a large dog, is active during daylight, or stands fully upright and holds eye contact, escalate to {Stalking_Dog|the appropriate entry}. Standard trapping and relocation applies.",
          default: true, clearance: 0, status: "COMMON"
        },
        "Attic_Bat": {
          title: "Attic Bat — Incident #002",
          image: "https://user.uploads.dev/file/8de43d47f9794dc961a7aa1b1f969eb0.jpg",
          imageCaption: "HOMEOWNER PHOTO — ATTIC ACCESS, APRIL 2024",
          imageFilter: "nightvision",
          text: "Small flying mammal roosting in attics and eaves. Identified by high-pitched squeaking at dusk and dawn, guano accumulation in the attic, and scratching sounds in the ceiling during the day. Bats enter through gaps as small as half an inch and roost in colonies.<br><br>Attic Bats are beneficial to the ecosystem and protected by state law — do not advise the caller to harm them. Distinguish from {Trash_Raccoon} (ground-level, not aerial) and {Chimney_Swarm} (which produces a buzzing rather than squeaking). If the caller reports the bats are silent and do not flee when the attic light is turned on, escalate to {Roostling}. Standard exclusion applies.",
          default: true, clearance: 0, status: "COMMON"
        },
        "Stray_Dog": {
          title: "Stray Dog — Incident #003",
          image: "https://user.uploads.dev/file/c542e835fc46dd03be8ddf7223bd617c.jpg",
          imageCaption: "DASHCAM CAPTURE — COUNTY ROAD 9, MAY 2024",
          imageFilter: "nightvision",
          text: "Unlicensed or abandoned domestic canine at large. Identified by canine tracks — four toes with claw marks, longer than they are wide — and behavioral patterns: approaching houses, begging at doors, and following people at a distance. Stray Dogs are often malnourished, fearful, and prone to defensive aggression.<br><br>Distinguish from {Trash_Raccoon} (which has five toes and does not approach humans) and {Coyote} (which maintains distance and does not beg). If the caller reports the dog has no shadow, does not blink, or appears in multiple locations simultaneously, escalate to {Stalking_Dog}. Standard animal control pickup applies.",
          default: true, clearance: 1, status: "COMMON"
        },
        "Chimney_Swarm": {
          title: "Chimney Swarm — Incident #004",
          image: "https://user.uploads.dev/file/24da65a583d9e8087af0678ca8df40c0.jpg",
          imageCaption: "HOMEOWNER PHOTO — FIREPLACE HEARTH, OCT 2023",
          imageFilter: "nightvision",
          text: "A collective term for unidentified flying organisms that enter homes through chimneys and flues. Identified by a low buzzing or humming from inside the chimney, a mass of small dark shapes visible when the flue is opened, and a fine black powder — not ash — accumulating in the fireplace. The swarm does not match any known insect species.<br><br>Chimney Swarms are seasonal — most active in late autumn. They are attracted to warmth and to homes with {Attic_Bat|bat} colonies. The individual organisms are the size of a thumbnail, dark, and do not have visible wings — they move by [[REDACTED:vibration]]. Distinguish from {Attic_Bat} (squeaking, not buzzing). If the caller reports the swarm has exited the chimney and entered the living space, do not advise them to open windows — the swarm orients toward breath. Escalate to {Roostling}.",
          default: false, clearance: 1, status: "UNCOMMON"
        },
        "Stalking_Dog": {
          title: "Stalking Dog — Incident #011",
          image: "https://user.uploads.dev/file/4dec31ab1ea86931e766fec23ab55424.jpg",
          imageCaption: "TRAIL CAM — PROPERTY #5129, APRIL 2024",
          imageFilter: "nightvision",
          anomaly: true, anomalyType: "sporadic", anomalyAmplitude: 0.7,
          anomalyColor: "#2ecc71",
          text: "A large canine-shaped entity that follows rural residents at a fixed distance. Identified by the caller reporting a dog — typically dark-furred, tall, and thin — that appears on their property or on the road behind them and maintains a distance of exactly 30 to 50 feet. It does not close the gap. It does not fall behind when the caller speeds up. It does not approach when the caller stops.<br><br>The Stalking Dog is not a {Stray_Dog|stray}. Strays beg, scavenge, and vary their distance. The Stalking Dog maintains its distance with mechanical precision. It has been observed for periods of up to [[REDACTED:nine]] days without breaking pattern. It does not eat, drink, or sleep. It does not leave tracks in snow.<br><br>If the caller reports the distance closing — the dog stepping closer than 30 feet — the entity is no longer observing. It is approaching. Escalate to {Threshold_Stand}. Do not advise the caller to confront or photograph the entity.",
          default: false, clearance: 2, status: "RARE"
        },
        "Coyote": {
          title: "Coyote — Incident #005",
          image: "https://user.uploads.dev/file/a7df83faac2d1db074ee0a7ae47835e5.jpg",
          imageCaption: "TRAIL CAM — PASTURE B, JUNE 2024",
          imageFilter: "nightvision",
          text: "Wild canine species common to rural and suburban areas. Identified by four-toed tracks without claw marks (coyotes retract their claws, unlike {Stray_Dog|dogs}), nocturnal yipping vocalizations, and a lean, gray-brown appearance. Coyotes are wary of humans and maintain distance.<br><br>Coyotes hunt small pets and livestock. They are identified by their vocalizations — a series of yips and howls that carry over long distances. Distinguish from {Stray_Dog} (which does not vocalize in groups and approaches humans). If the caller reports the coyote vocalizations contain recognizable words, laughter, or a child's voice, escalate to {Mockingbird_Coyote}. Standard deterrence applies.",
          default: true, clearance: 1, status: "COMMON"
        },
        "Mockingbird_Coyote": {
          title: "Mockingbird Coyote — Incident #014",
          image: "https://user.uploads.dev/file/9383444a7f3d0e3f5900215f24fd7ce1.jpg",
          imageCaption: "HOMEOWNER PHOTO — TREE LINE, JUNE 2024",
          imageFilter: "nightvision",
          anomaly: true, anomalyType: "sporadic", anomalyAmplitude: 0.7,
          anomalyColor: "#2ecc71",
          text: "A {Coyote|coyote} variant that produces vocalizations mimicking human speech, domestic animals, and mechanical sounds. Identified by the caller reporting coyote howls that resolve into recognizable words — typically the caller's name, the name of a deceased pet, or a phrase the caller spoke earlier that day. The mimicry is not perfect: words are slightly [[REDACTED:elongated]], as if the vocal mechanism is not built for human speech.<br><br>Mockingbird Coyotes do not approach homes. They call from the tree line or from the far side of fields. The purpose of the mimicry is not understood. In all documented cases, the caller who listened to the vocalizations for more than [[REDACTED:three]] nights left their home on the fourth night and walked into the woods. They were not found.<br><br>Distinguish from {Coyote} (which produces animal vocalizations, not speech). If the caller reports the voice is coming from inside the house — from the other side of a closed door — escalate to {Threshold_Stand}. Do not advise the caller to listen to the vocalizations. Do not advise the caller to respond.",
          default: false, clearance: 2, status: "RARE"
        },
        "Roostling": {
          title: "Roostling — Incident #016",
          image: "https://user.uploads.dev/file/9eb25723f6b3172a20f3ab6050db16f3.jpg",
          imageCaption: "HOMEOWNER PHOTO — BEDROOM CEILING, JULY 2024",
          imageFilter: "blur",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.8,
          anomalyColor: "#e67e22",
          text: "A creature that nests in the upper structures of occupied homes — attics, eaves, and the spaces between ceilings and roofs. It is not a bat, bird, or rodent. The Roostling is identified by three signs: the complete silence of {Attic_Bat|bat} or {Chimney_Swarm|swarm} colonies in the home (they flee), a wet, rhythmic breathing sound from above the ceiling, and stains on the ceiling that grow in [[REDACTED:branching]] patterns.<br><br>The Roostling does not leave the attic during the night. It waits until the household is asleep, then descends. It does not enter rooms where occupants are awake. Callers who have glimpsed it describe a pale, [[REDACTED:many-limbed]] shape that folds itself into the geometry of the ceiling, as if the house's structure is part of its body.<br><br>If the caller reports the breathing sound has moved from the ceiling to the walls — from above to beside — the Roostling has descended and is in the home. If the caller reports it is in the room with them, do not advise them to turn on the light. Escalate to {Threshold_Stand}.",
          default: false, clearance: 3, status: "RARE"
        },
        "Threshold_Stand": {
          title: "Threshold Stand — Incident #022",
          image: "https://user.uploads.dev/file/b02fadda68dd319e19fe780158be7080.jpg",
          imageCaption: "HOMEOWNER PHOTO — FRONT ENTRY, AUG 2024",
          imageFilter: "blur",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.8,
          anomalyColor: "#e67e22",
          text: "An entity that positions itself at the boundary between inside and outside — doorways, windows, the gap beneath a door. Identified by the caller reporting a shape visible through a window or in the gap beneath a door. The shape is dark, approximately human-height, and does not move. It stands at the threshold. It does not knock. It does not speak. It waits for the door to be opened.<br><br>The Threshold Stand is drawn to homes where a {Stalking_Dog} has closed its distance, a {Mockingbird_Coyote} has been listened to for multiple nights, or a {Roostling} has descended into the living space. It is not the same entity as any of these — it is what comes next.<br><br>The Threshold Stand cannot enter without invitation. The invitation need not be verbal. Opening the door constitutes invitation. Removing a lock constitutes invitation. Saying its name — if the caller has learned it — constitutes invitation. In [[REDACTED:four]] documented cases, the caller opened the door because they recognized the shape. They recognized it because it was wearing the face of someone who no longer lives at the address. Do not advise the caller to look through the door. Do not advise the caller to speak to it. If the caller has already opened the door, escalate to {Facekeeper}.",
          default: false, clearance: 3, status: "RARE"
        },
        "Carrion_Flock": {
          title: "Carrion Flock — Incident #019",
          image: "https://user.uploads.dev/file/7d284b79445fbdfec95b91c82e823dd7.jpg",
          imageCaption: "TRAIL CAM — PROPERTY #6843, JUNE 2024",
          imageFilter: "grayscale",
          text: "A group of large birds — identified as corvids, but larger than any known species — that congregate on properties where an animal has died or is about to die. Identified by an unusual concentration of dark birds on fences, rooftops, and power lines, all facing the same direction, and all silent. Carrion Flocks do not call. They do not feed. They watch.<br><br>The Flock appears 24 to 72 hours before a death on the property — typically livestock or a pet, but in [[REDACTED:two]] documented cases, a human resident. The birds do not leave until the death occurs. After the death, they depart silently and do not return.<br><br>Distinguish from ordinary corvid roosting (which is noisy and dispersed). If the caller reports the flock has been present for more than three days without a death occurring, the death may be [[REDACTED:delayed]] — or the birds are not waiting for a death. They are waiting for what comes after. Escalate to {Dirt_Eater}.",
          default: false, clearance: 3, status: "UNCOMMON"
        },
        "Dirt_Eater": {
          title: "Dirt Eater — Incident #028",
          image: "https://user.uploads.dev/file/019daad2560dfb46e04d8d4c2ef4ebe6.jpg",
          imageCaption: "SITE PHOTO — BURIAL SITE B, JULY 2024",
          imageFilter: "nightvision",
          text: "A quadruped entity, approximately the size of a large dog, that consumes grave soil. Identified by small, deep holes in yards — specifically at sites where pets or livestock are buried. The holes are not dug by an animal; the soil is not displaced — it is [[REDACTED:absorbed]]. The caller will report the holes appearing overnight and the ground around them being warm.<br><br>The Dirt Eater is not scavenging. It does not exhume remains. It consumes the soil itself, and in doing so, it appears to ingest what the soil held. Callers who have observed it describe a low, broad shape with no visible eyes and a mouth that opens [[REDACTED:vertically]]. It is not aggressive. It does not approach the living. It is interested only in what is already buried.<br><br>Related to {Carrion_Flock}: in every documented case, a Carrion Flock was present on the property 24 hours before the Dirt Eater appeared. If the caller reports the Dirt Eater has begun digging at a site where nothing is buried, escalate to {Pale_Grazers|Pale Grazers}. If the caller reports the Dirt Eater is digging at the foundation of the house, escalate to {Rooting_Thing}.",
          default: false, clearance: 4, status: "RARE"
        },
        "Pale_Grazers": {
          title: "Pale Grazers — Incident #031",
          image: "https://user.uploads.dev/file/075231c9c92ee70cf9e53d43b8a8c82e.jpg",
          imageCaption: "TRAIL CAM — FIELD 7, AUGUST 2024",
          imageFilter: "blur",
          text: "A collective of thin, white, deer-like entities observed in fields and pastures at night. Identified by the caller reporting animals in a field that are too thin, too tall, and too pale to be deer. They graze by pressing their faces to the ground and [[REDACTED:drinking]] it — consuming soil rather than grass. They are always in groups of three.<br><br>Pale Grazers do not react to human presence. They do not flee when approached. They continue grazing. Callers who approach within ten feet report a sound — a low, sustained tone from the ground beneath the Grazers, as if the soil itself is [[REDACTED:responding]]. Callers who approach within five feet do not return to the house. Their families find them standing in the field the next morning, facing the same direction as the Grazers, unmoving, alive, [[REDACTED:unresponsive]].<br><br>Related to {Dirt_Eater}: Pale Grazers appear on properties where the Dirt Eater has been active for more than two weeks. The soil the Grazers consume is soil the Dirt Eater has already processed. Escalate to {Rooting_Thing} if the Grazers approach the house.",
          default: false, clearance: 4, status: "EXOTIC"
        },
        "Rooting_Thing": {
          title: "Rooting Thing — Incident #035",
          image: "https://user.uploads.dev/file/4904b319f915058626a164036abbb9eb.jpg",
          imageCaption: "SITE PHOTO — BASEMENT, PROPERTY #7102",
          imageFilter: "thermal",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.9,
          anomalyColor: "#9b59b6",
          text: "A subterranean entity that undermines the foundations of homes from below. Identified by hairline cracks in basement floors, a sensation of vibration through the soles of the feet, and the gradual sinking of interior floors — approximately one centimeter per week. The Rooting Thing does not surface. It works beneath the foundation, consuming the ground the house stands on.<br><br>The Rooting Thing is drawn to properties where {Dirt_Eater|Dirt Eaters} have processed significant soil and where {Pale_Grazers} have begun consuming the processed ground. It is the next stage: after the soil is consumed, the structure itself becomes the target. The entity appears to feed on the [[REDACTED:weight]] of the building — not the materials, but the fact of occupation. An occupied house sinks faster than an empty one.<br><br>If the caller reports the basement floor has cracked open, escalate to {The_Gap}. Do not send the caller into the basement. Do not advise the caller to investigate the cracks.",
          default: false, clearance: 5, status: "MAGICAL"
        },
        "Facekeeper": {
          title: "Facekeeper — Incident #040",
          image: "https://user.uploads.dev/file/4813e53d89c38bb1b8fe9d78138511a9.jpg",
          imageCaption: "EVIDENCE PHOTO — BATHROOM MIRROR, AUG 2024",
          imageFilter: "glitch",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.9,
          anomalyColor: "#9b59b6",
          text: "An entity that enters homes through opened doors and collects faces. The Facekeeper is the result of a {Threshold_Stand} being invited inside. It does not enter forcefully. It enters because the door was opened to it — because the shape at the threshold was recognized, or because the caller could not endure the waiting.<br><br>The Facekeeper is tall, pale, and wears a surface that resembles a human face — not its own. The face it wears is always the face of someone the caller has lost. It does not speak with this face. It does not use the face to deceive. It holds it the way a person holds a photograph. Over the hours following entry, the Facekeeper moves through the home and touches every reflective surface — mirrors, windows, the surface of standing water. Each surface it touches shows the face it is wearing, even after the Facekeeper has left the room. The reflections do not revert. They continue to show the lost face from every angle.<br><br>The Facekeeper does not harm the caller physically. Its presence produces a specific psychological effect: the caller begins to forget the face of the person the Facekeeper is wearing. Within 24 hours, the caller cannot recall what the lost person looked like without looking at the corrupted reflections. Within 72 hours, the caller cannot distinguish their own face from the Facekeeper's collected face in a mirror.<br><br>There is no remediation. The home must be vacated. The mirrors remain. If the caller reports a second face has appeared on the Facekeeper — the face of someone who is still alive — the entity is no longer collecting. It is [[REDACTED:replacing]]. Escalate to {The_Gap}.",
          default: false, clearance: 5, status: "MAGICAL"
        },
        "The_Gap": {
          title: "The Gap — Incident #050",
          image: "https://user.uploads.dev/file/402893df555a170c265da83a956c6659.jpg",
          imageCaption: "SITE PHOTO — BASEMENT, PROPERTY #8991, NOV 2024",
          imageFilter: "static",
          anomaly: true, anomalyType: "continuous", anomalyAmplitude: 0.9,
          anomalyColor: "#9b59b6",
          text: "A structural opening that appears in the foundations of homes that have reached the final stage of the incident catalog. The Gap is not a crack, a hole, or a breach. It is a clean, rectangular opening in the basement floor, approximately three feet wide and six feet long, with edges that appear cut rather than broken. It appears overnight. The soil beneath it is warm and produces a low, sustained tone — the same tone reported by callers near {Pale_Grazers|Pale Grazers} and in homes with {Rooting_Thing|Rooting Thing} activity.<br><br>The Gap is not empty. It contains a vertical passage that descends beyond the range of standard surveying equipment. Cameras lowered into the Gap return [[REDACTED:images that do not correspond]] to the depth or direction they were lowered. The passage does not go down. It goes [[REDACTED:somewhere else]].<br><br>The Gap exerts no compulsion. It does not call. It does not invite. It is simply open. Occupants find it and make their own decision. In every documented case, the occupant entered the Gap voluntarily within 48 hours of its appearance. They were not coerced. They were not compelled. They said, in every case, that they 'wanted to see what was down there.' None returned. The Gap closed behind them.<br><br>The Gap appears only in homes that have progressed through the full incident sequence: a {Stalking_Dog} that closed its distance, a {Mockingbird_Coyote} that was listened to, a {Roostling} that descended, a {Threshold_Stand} that was invited in, a {Facekeeper} that collected, and a {Rooting_Thing} that undermined the foundation. The Gap is not the end of the sequence. It is the [[REDACTED:door the sequence was built to open]]. Proceed to the {Catalog_Synthesis}",
          default: false, clearance: 6, status: "MYTHICAL"
        },
        "Catalog_Synthesis": {
          title: "Catalog Synthesis — Field Analysis",
          text: "Cross-referencing all confirmed incidents reveals a pattern. No entry on this catalog is independent.<br><br>The {Trash_Raccoon|most common call} and {Attic_Bat|most common attic call} are not wildlife encounters in themselves — they are indicators. Their presence signals that a property is 'available.' A property with recurring nocturnal wildlife activity and unexplained chimney ingress will, within months, attract a {Stalking_Dog}. The Stalking Dog maintains distance. It is measuring.<br><br>A property under measurement produces disturbed soil and altered animal behavior. {Coyote|Coyotes} become {Mockingbird_Coyote|Mockingbird Coyotes}. {Chimney_Swarm|Swarms} flee. {Carrion_Flock|Carrion Flocks} arrive. The property is being prepared.<br><br>The {Roostling} descends. The {Threshold_Stand} arrives and waits. The {Facekeeper} enters and collects. The {Dirt_Eater} consumes the ground. {Pale_Grazers|Pale Grazers} process what remains. The {Rooting_Thing} undermines the foundation. And {The_Gap} opens.<br><br>The Wildlife Incident Catalog is not a list of animal encounters. It is a sequence. Every property that reached {The_Gap} began with a {Trash_Raccoon|raccoon in the trash}. Nightshift County Animal Control was never a service for removing wildlife. It was a monitoring system for identifying which properties were ready for the next stage. And it is still running.",
          default: false, clearance: 6, status: "FINAL ENTRY"
        },
      },
      cipher: [
        { id: 1, title: "Call #4471 — The Trash Pile", hint: "Cross-reference Trash Raccoon: overturned bins, five-toed prints, nocturnal, avoids humans", parts: ["CALL #4471 — NIGHTSHIFT COUNTY ANIMAL CONTROL\nDATE: March 14, 2024 — 11:42 PM\nCALLER: Female, mid-30s, suburban residence\n\nDISPATCHER: Nightshift Animal Control, this is Dana speaking.\nCALLER: Something has been getting into my trash every night this week. The bins are overturned, there's garbage all over the driveway, and I found little hand-like prints in the mud.\nDISPATCHER: Can you describe the prints?\nCALLER: Five toes. Long back foot. They go from the garage to the bins and back toward the creek.\nDISPATCHER: Have you seen the animal itself?\nCALLER: Just eyes. Reflective, in the flashlight. But it ran as soon as I opened the door.\nDISPATCHER: Has it approached you, made sounds, or stood upright?\nCALLER: No. It just runs. Every night. Same thing.\n[CALL ENDS]\n\nBased on the caller's report, the identified incident is ", ". The five-toed prints, overturned bins, and nocturnal avoidance of humans are consistent with ", ". Standard trapping and relocation applies."], answers: ["Trash Raccoon", "a common raccoon"], solved: false },
        { id: 2, title: "Call #5129 — The Distance", hint: "Cross-reference Stalking Dog and Stray Dog: fixed distance, no tracks, does not eat or sleep, does not beg", parts: ["CALL #5129 — NIGHTSHIFT COUNTY ANIMAL CONTROL\nDATE: April 2, 2024 — 2:17 AM\nCALLER: Male, late-40s, rural property\n\nDISPATCHER: Nightshift Animal Control, this is Dana speaking.\nCALLER: There's a dog outside. It's been there for three days.\nDISPATCHER: Can you describe it?\nCALLER: Big. Dark fur. Thin. It's standing at the edge of the field, about 40 feet from the house.\nDISPATCHER: Has it approached the house or come closer?\nCALLER: No. That's the thing. It's always the same distance. I walk to the mailbox, it's 40 feet. I go to the barn, it's 40 feet. It was snowing yesterday and there are no ", " in the snow. None. It's standing on nothing.\nDISPATCHER: Does it beg, scavenge, or vary its distance at all?\nCALLER: Never. It just stands there. Watching.\nDISPATCHER: Sir, do not approach the animal. The fixed distance, the absence of tracks, and the lack of feeding behavior indicate this is not a ", ". You are being observed by a ", ". Do not confront it. Do not photograph it.\n[CALL ENDS]\n\nThe mechanical precision of the distance, the absence of tracks, and the lack of feeding behavior rule out a ", ". The identified incident is a ", ". Do not advise the caller to approach."], answers: ["tracks", "stray dog", "Stalking Dog", "Stray Dog", "Stalking Dog"], solved: false },
        { id: 3, title: "Call #6843 — The Singing Field", hint: "Cross-reference Mockingbird Coyote, Carrion Flock, and Coyote: vocal mimicry, silent corvids, name-calling", parts: ["CALL #6843 — NIGHTSHIFT COUNTY ANIMAL CONTROL\nDATE: June 19, 2024 — 3:08 AM\nCALLER: Female, early-30s, rural property\n\nDISPATCHER: Nightshift Animal Control, this is Dana speaking.\nCALLER: The coyotes are saying my name.\nDISPATCHER: Can you describe what you're hearing?\nCALLER: It started as howling, like normal. But the last two nights, the howls turn into words. My name. Lily. They say it over and over. And last night they said the name of my dog — the one we put down last winter.\nDISPATCHER: Are the sounds coming from the tree line or from inside the property?\nCALLER: From the tree line. Far side of the field. But there's something else. There are birds on the fence — big ones, like crows, but bigger. Dozens of them. All facing the house. None of them are making a sound.\nDISPATCHER: Have you been listening to the coyotes for more than one night?\nCALLER: Three nights now. I can't stop. It sounds like they're trying to tell me something.\nDISPATCHER: Ma'am, the vocalizations you're hearing are not normal ", " calls. The mimicry of your name and your deceased pet's name indicates a ", ". The silent corvids on your fence are a ", " — they are present because the property has been marked. Do not listen to the vocalizations. Do not go outside. Do not respond to the voices.\n[CALL ENDS — caller advised to remain indoors. Follow-up scheduled.]\n\nThe speech-mimicking coyote vocalizations are consistent with a ", ". The silent, unidirectional corvid congregation is a ", ". The identified primary incident is a ", "."], answers: ["coyote", "Mockingbird Coyote", "Carrion Flock", "Mockingbird Coyote", "Carrion Flock", "Mockingbird Coyote"], solved: false },
        { id: 4, title: "Call #7102 — The Opened Door", hint: "Cross-reference Threshold Stand, Roostling, and Facekeeper: descending breathing, the shape at the door, faces in mirrors", parts: ["CALL #7102 — NIGHTSHIFT COUNTY ANIMAL CONTROL\nDATE: August 3, 2024 — 1:34 AM\nCALLER: Female, late-50s, rural home\n\nDISPATCHER: Nightshift Animal Control, this is Dana speaking.\nCALLER: I opened the door.\nDISPATCHER: What happened, ma'am?\nCALLER: For two weeks I heard breathing in the ceiling. Wet. Rhythmic. I thought it was raccoons. Then last week it moved — from the ceiling to the walls. From above to beside. I could hear it in the room with me.\nDISPATCHER: Did you see it?\nCALLER: No. I refused to turn on the light. But three nights ago, there was a shape at the front door. Through the window. Tall. Dark. It stood there for three nights. It didn't knock. It just stood and waited.\nDISPATCHER: Ma'am, did you know the shape?\nCALLER: ...It looked like my husband. He passed four years ago. I knew it wasn't him. I knew. But I opened the door anyway. I couldn't take the waiting.\nDISPATCHER: What happened after you opened the door?\nCALLER: It came in. It's in the house now. It touches every mirror, every window. And my husband's face — the one it's wearing — is in every reflection now. Even when it's not in the room. I look in the mirror and I see his face instead of mine.\nDISPATCHER: Ma'am, the breathing in your ceiling was a ", " that had descended. The shape at your door was a ", ". By opening the door, you invited in a ", ". You need to leave the house now. Do not look in the mirrors. Do not look at the windows. Leave the house.\n[CALL ENDS — caller evacuated safely]\n\nThe ceiling breathing and its descent into the walls indicate a ", ". The motionless shape at the door is a ", ". The entity that enters upon invitation and corrupts reflective surfaces with collected faces is a ", ". The identified incident is a ", "."], answers: ["Roostling", "Threshold Stand", "Facekeeper", "Roostling", "Threshold Stand", "Facekeeper", "Facekeeper"], solved: false },
        { id: 5, title: "Call #8991 — The Last Dispatch", hint: "Cross-reference Rooting Thing, The Gap, and Catalog Synthesis: foundation cracks, the rectangular opening, the full sequence from raccoon to the Gap", parts: ["CALL #8991 — NIGHTSHIFT COUNTY ANIMAL CONTROL\nDATE: November 21, 2024 — 4:51 AM\nCALLER: Male, early-40s, isolated farmhouse\n\nDISPATCHER: Nightshift Animal Control, this is Dana speaking.\nCALLER: There's a hole in my basement. It wasn't there yesterday. It's clean — like it was cut. Three feet wide, six feet long. And it goes down.\nDISPATCHER: Sir, is there warm air or sound coming from the opening?\nCALLER: Both. The air is warm and there's a low hum — almost like a note. I've heard it before. In the field last summer, when those pale animals were drinking the dirt.\nDISPATCHER: Sir, how long have you lived at this property?\nCALLER: Six years. We've had raccoons in the trash since day one. Then the dog that kept its distance. Then the coyotes that learned my name. Then the thing in the ceiling, then the shape at the door, then the thing that took my wife's face from every mirror. She left two months ago. I think she left because she couldn't look at herself anymore.\nDISPATCHER: Sir, the cracks in your foundation — the sinking floors, the warm soil — that was a ", ". The opening in your basement is ", ". It is the final stage.\nCALLER: I want to see what's down there.\nDISPATCHER: Sir, do not enter the opening. Every person who has entered has not returned. The opening is the end of a sequence that began with ", " in your trash six years ago. Your property was selected. Every call you made to this line was logged. Every incident was monitored. This was never animal control.\nCALLER: I know. I've known for a while. That's why I want to see.\n[CALL ENDS — caller did not evacuate. Case filed.]\n\nThe foundation damage and warm soil are consistent with a ", ". The clean rectangular opening with warm air and sustained tone is ", ". This property has progressed through every stage of the catalog — from ", " to ", ". The identified incident is ", ". The caller entered the opening voluntarily. The opening closed behind him."], answers: ["Rooting Thing", "The Gap", "Trash Raccoon", "Rooting Thing", "The Gap", "Trash Raccoon", "The Gap", "The Gap"], solved: false }
      ],
      signalStations: [
        { freq: 4.5,  label: 'PAW', color: '#2ecc71', wave: function(p) { let s = Math.sin(p * 4.5); return s > 0.3 ? s * 10 : s * 3; } },
        { freq: 8.3,  label: 'HOWL', color: '#2ecc71', wave: function(p) { return Math.sin(p * 8.3) * 7 * (0.5 + 0.5 * Math.sin(p * 0.2)); } },
        { freq: 12.6, label: 'HEART', color: '#e67e22', independent: true, wave: function(p) { let t = p % 8.0; return 1.3*Math.exp(-Math.pow((t-1.0)/0.28,2)) - 3.0*Math.exp(-Math.pow((t-2.45)/0.09,2)) + 14*Math.exp(-Math.pow((t-2.65)/0.08,2)) - 6.0*Math.exp(-Math.pow((t-2.85)/0.11,2)) + 3.5*Math.exp(-Math.pow((t-4.7)/0.45,2)); } },
        { freq: 17.9, label: 'FLIGHT', color: '#e67e22', wave: function(p) { return Math.sin(p * 17.9) * 5 + Math.sin(p * 8.95) * 3; } },
        { freq: 23.4, label: 'CRACKLE', color: '#9b59b6', wave: function(p) { return (Math.random() - 0.5) * 12 * (0.4 + 0.6 * Math.abs(Math.sin(p * 0.4))); } },
        { freq: 28.7, label: 'GAP', color: '#9b59b6', wave: function(p) { return Math.sin(p * 28.7) * 2 * Math.sin(p * 0.08) + Math.sin(p * 14.35) * 4; } },
      ],
    },
  ];


  
signalStations() =>
  let scenario = getScenarioData(currentScenarioId);
  if(scenario && scenario.signalStations) return scenario.signalStations;
  return [
    { freq: 11.3, label: 'PULSE', color: '#f1c40f', wave: function(p) { let s = Math.sin(p * 11); return s * s * s * 8; } },
    { freq: 27.8, label: 'WHISPER', color: '#9a5a9a', wave: function(p) { return Math.sin(p * 27) * 3 * Math.sin(p * 0.1) + Math.sin(p * 27.8) * 3; } },
  ];