createServerSocket = {import:server-plugin}

// High-level config the user may want to tweak
config
  minUsernameLength = 3
  maxUsernameLength = 16
  minPasswordLength = 4
  maxPasswordLength = 64
  minCharNameLength = 2
  maxCharNameLength = 20
  minAge = 13
  maxAge = 99
  stepCooldownMin = 0.1
  stepCooldownMax = 3
  startingHp = 100
  startingGold = 0

// Content lists for the exploration system
enemy
  goblin^3
  wolf^3
  bandit^2
  skeleton^2
  slime^2
  giant rat^2
  wild boar^2
  cave spider^2
  orc
  rogue mage

item
  rusty sword
  health potion
  leather shield
  gold coin
  gemstone
  old map
  wooden bow
  magic scroll
  iron helmet
  silver ring
  herbal remedy
  ancient relic
  mystic amulet
  bronze key

// Mining — ordered common → rare. Higher rarity = more Mining XP (and will
// eventually require a minimum Mining level to harvest).
ore
  copper ore^4
  tin ore^4
  iron ore^3
  coal^3
  silver ore^2
  gold ore^2
  mithril ore
  adamantite ore

// Chopping — ordered common → rare. Higher rarity = more Chop XP (and will
// eventually require a minimum Chop level to harvest).
tree
  oak^4
  pine^4
  birch^3
  maple^3
  walnut^2
  mahogany^2
  yew
  magicwood

// Prefixes rolled for equipment drops (weighted common → mythic).
equipPrefix
  Worn^5
  Sturdy^4
  Fine^3
  Gleaming^2
  Enchanted
  Mythic
