// https://perchance.org/tutorial

title
  Coffee ☕

output
  $output = [this.joinItems(" ")]
  Grind in [grind]<br>
  [s = size.selectOne; s.titleCase]
  [t = temp.selectOne; isCold = t == "cold"; t]
  [isCold ? drink$.cold : drink$.hot]<br>
  in [isCold ? utensil.machine : utensil.hot]

grind
  Moochi, size {{5-10}^5|{1-20}^3}
  Kitfort, time {10-40} s

utensil
  machine
    Moochi
  hot
    [this.getParent.machine.Moochi]
    Time More
    Loveramics Mellow Dripper + V60 stand + filter N2

size
  single
  double

temp
  cold
  hot

milk = milk{less|y}

// Constants.
milkTemp = (milk temperature: 65°C)
cappucino = cappucino \[⅓ × (froth + milk + espresso)\]
latte = latte

drink$
  cold = espresso
  hot
    $output = [this.joinItems(" ")]
    [m = milk.selectOne; isMilk = m == 'milky'; drink$.hot[m]]
    [isMilk ? '<br/>Frother: [frother]' : '']
    milky = {[cappucino]|[latte]}
    milkless = {espresso|americano}

frother
  Tarrington [milkTemp]
  Moochi with hose [hose]
  Homegleam [milkTemp]
  
hose
  one and the stock cup
  two (GPU holder and milk pack)
