$meta
  title = ImageGlitch
  description = ImageGlitch - An immersive, AI-powered image generator
  header
    mode = minimal

// --- IMPORTS ---
ai = {import:ai-text-plugin}
textToImage = {import:text-to-image-plugin}

// --- BUILDER ---
build_image_generation_html(data) =>
  var html = {import:apps/imageglitch/index.html}
  return html

// --- CONFIG ---
app_config
  img_seed = ""
  onFinish(result) => result.iframe.replaceWith(result.canvas)

// OUTPUT
main_output
  $output = [build_image_generation_html(app_config)]
