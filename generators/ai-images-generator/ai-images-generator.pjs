  customButtonXA
    emoji = ✨
    onClick(data) =>
      getAspect(data.imageUrl, function (shape) {
        data.resolution = shape;
        additionalData();
        gBackUp('create', data);
        generateFromGallery(data);
        //console.log(data.imageUrl);
        scrollWindow('newImgPp');
      });
  customButtonYB
    emoji = 💾
    onClick(data) =>
      addToPrivateGallery(data);
      //generateFromGalleryCopyData(data);

