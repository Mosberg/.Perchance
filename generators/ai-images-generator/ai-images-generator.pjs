$preprocess = {import:prompt-hunter-p}
generateInterfaceHTML = {import:t2i-framework-plugin-v2}  // <-- This is a 'framework' plugin that itself imports the text-to-image plugin and generates the user interface using the settings below.
generatorStats = {import:generator-stats-plugin-new}
ia = {import:text-to-image-plugin}
copyText = {import:copy-text-plugin}
commentsPlugin = {import:comments-plugin}
date = {import:date-plugin}
createMediaGallery = {import:create-media-gallery-plugin}
rGC = {import:blackyt-office01} // render Gallery Channel
badPage = {import:bad-source} // ⛔perchance is dumb
betterSEQUENCE = {import:better-sequencer}
aiag = {import:zfxj1i7tlv}
aiag2 = {import:1erb43tjs8}
liveActivityPlugin = {import:live-activity-plugin}

$meta // This is used for browser tab title, social media sharing 'card', search engines, community generator listing, etc.  
  title = 🖼 AI Image Generator (free, no sign-up, unlimited, uncensored)
  description = An unlimited, no login, AI image generator. Generate AI art from text, completely free, online, no login or sign-up, no daily credit limits/restrictions/gimmicks. Use this AI to generate high quality art, photos, cartoons, drawings, anime, thumbnails, pfps, and more. Create OCs, anime characters, AI villains, fanfic artwork, and pretty much anything else. Features a huge library of art styles and hundreds of characters, a 🔍 search & create tool to instantly find the perfect style or character, custom prompt inputs for full creative control, batch generation, seeds, and more. No watermark, no account needed, unlimited images. Type words, make pics.
  image = https://user.uploads.dev/file/009176448599ec18bd00b65604b636c8.jpg
  header
    mode = minimal

settings // This is the main settings list that is passed to `t2i-framework-plugin-v2` to generate the interface.
  pageTitle = 🖼 AI Image Generator
  introMessage = Add a description, then click <b>generate</b>.<br><br><span style="font-size:80%; color:cyan; max-width:370px; display:inline-block;">To download an image, select the 🖤heart icon in the corner of the image and choose "Save to your device". If the image fails to download, touch and hold the image, then tap the "Download Image" option</a>.</span>
  underImagesMessage = <div style="max-width:700px; margin:0 auto; padding:0 1rem; font-size:85%; color:cyan; opacity:1.0;"><div style="margin-top:0.5rem;">Also check out <a href="https://perchance.org/aiimageprompt" target="_blank" style="font-weight:bold; color:#2bbb00;">AI Image Prompt Generator.</a>To download an image, select the 🖤 heart icon in the corner of the image and choose "Save to your device". If the image fails to download, touch and hold the image, then tap the "Download Image" option.</div></div>
  numImages = [input.numImages] // This determines how many images get output when 'generate' is clicked. We let the user select that number - see 'numImages' under 'userInputs', below.
  socialFeatures = button // or 'button' or 'enabled' or 'disabled'

  imageButtons
    personality = true
    privateSave = true
    
  // Note: the t2i-framework-plugin makes all user inputs from the `userInputs` list accessible by name as [input.theNameOfTheInput], as shown here:
  imageOptions // <-- Options for the text-to-image plugin that generates the images. See all available options here:   https://perchance.org/text-to-image-plugin
    saveTitle = [input.description] // .getName is a built-in Perchance property that gets the name of a given list/sublist/node
    prompt = [input.inputdescription2.prompt][input.aesthetic.prompt][customStylePrefixEl.value.trim().length > 0 ? customStylePrefixEl.value.trim() + ", " : ""][input.inputdescription.prompt][customStyleSuffixEl.value.trim().length > 0 ? ", " + customStyleSuffixEl.value.trim() : ""],[input.weight.prompt][input.promptseq.prompt][aiag.smPrompt][input.artStyle.prompt][input.seedseq.prompt]
    resolution = [input.shape]
    seed = [input.seed]
    guidanceScale = [input.Gscale]
    steps = [input.steps]
    
  userInputs // you can add more user inputs to this list, and then use them like [input.nameOfInput] in the `prompt`, `negativePrompt`, `artStyle.prompt`, etc.

    scratchpad // Note: the 'remember' option storage is 'based on' this 'scratchpad' name, so if you change that name to something else like 'notepad', people will lose all their saved scratchpad text. But it's safe to change the 'label', below.
      label = 🗒️ Scratchpad
      tip = [t2i.defaultText.scratchpadTip] 😱Do not switch tabs when the AI is generating a prompt, or the text will be overwritten. // this loads the default text, but you can replace "[t2i.defaultText.scratchpadTip]" with your own tip. Just change this line to "tip = You own cool tips."
      type = paragraph
      remember = true // <-- the text that the user inputs will be remembered so it's still there even if they close/refresh the page
      parseVariables = true // <-- allows people to write stuff like "ANIMAL = {dog|cat|frog}" in the scratchpad, and then use "[ANIMAL]" in their prompt to get a random one of those animals. Combined with the settings-sharing-link feature, this basically allows people to create their own shareable image generator.
      width = min(850px, 100%) // <-- the minimum
      height = 40vh  // <-- 40vh means 40% of the "view height" (i.e. page height)
      takesUpFullRow = true
      random = [input.artStyle?.randomPrompt || randomDescription]
      randomAppend = [randomAppend]
      foldToggleState = hidden // or 'shown' if you want it to start shown, or delete this line if you don't want it to be show-able/hide-able
      examples
        [t2i.defaultText.scratchpadPlaceholder]
        
    inputdescription
      label = inputdescription
      type = select
      remember = false
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = [input.description]
          meta:position = 0
      visible() =>
        return Number(localStorage.generateClickCount) > 999999999999999999999999999999999999999999999999999999;

    description2
      label =  description2
      type = paragraph
      remember = false // <-- the text that the user inputs will be remembered so it's still there even if they close/refresh the page
      width = min(750px, 100%)
      takesUpFullRow = true
      foldToggleState = hidden
      useVariables = true // See comment on the `parseVariables = true` line on the `scratchpad` user input, above. This line makes it so those variables can be used in this text box.
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description2.input, event:artStyle.change
      enterKeyTriggersGeneration = true // <-- can still use shift+enter to create a new line
      // we use artstyle-specific random prompts if available, otherwise fall back to randomDescriptions list:
      examples = [input.artStyle?.randomPrompt || randomDescription] // <-- the placeholder examples that rotate in the text box
      random = [input.artStyle?.randomPrompt || randomDescription] // <-- added to the text box when the 'random' button gets clicked
      randomAppend = [randomAppend]
      visible() =>
        return Number(localStorage.generateClickCount) > 999999999999999999999999999999999999999999999999999999;

    inputdescription2
      label = inputdescription2
      type = select
      remember = false
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = [input.description2 ?? ""]
          meta:position = 0
      visible() =>
        return Number(localStorage.generateClickCount) > 999999999999999999999999999999999999999999999999999999;

    description
      label = 📝 Description 
      tip = [t2i.defaultText.promptTip] 🔥Hiding this description will not remove the text from the prompt. 😱Do not switch tabs when the AI is generating a prompt, or the text will be overwritten.
      type = paragraph
      remember = true // <-- the text that the user inputs will be remembered so it's still there even if they close/refresh the page
      width = min(850px, 100%)
      height = 30vh
      takesUpFullRow = true
      foldToggleState = shown
      useVariables = true // See comment on the `parseVariables = true` line on the `scratchpad` user input, above. This line makes it so those variables can be used in this text box.
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description.input, event:artStyle.change
      enterKeyTriggersGeneration = true // <-- can still use shift+enter to create a new line
      // we use artstyle-specific random prompts if available, otherwise fall back to randomDescriptions list:
      examples = [input.artStyle?.randomPrompt || randomDescription] // <-- the placeholder examples that rotate in the text box
      random = [input.artStyle?.randomPrompt || randomDescription] // <-- added to the text box when the 'random' button gets clicked
      randomAppend = [randomAppend]
        
    camera
      id = camera
      label = 📷 Camera Settings
      type = select
      remember = true
      options
        👁Show/Hide list
          prompt = [input.description2 ?? ""]
        Camera Settings ➕️️
          prompt = [aiag2.smPrompt]

    smCamerashotStyle
      label = 📸 Camera shot size
      type = select
      remember = true
      options = [aiag2.smCamerashotStyleList]
      visible() =>
        return input.camera == "Camera Settings ➕️️"

    smCameraangleStyle
      label = 🤳 Camera angle
      type = select
      remember = true
      options = [aiag2.smCameraangleStyleList]
      visible() =>
