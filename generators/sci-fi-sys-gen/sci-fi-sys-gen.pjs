// Sci-Fi Name Generator
// Names sourced from azgaar sci-fi namebases (species headers excluded).
// All three outputs (star, planet, species) draw names from the same `names` pool.
// The name list is large (29k names), so it's loaded at runtime from a hosted JSON file.

title = Sci-Fi System Generator

// Main sequence stars only (luminosity class V). No pulsars/black holes/white dwarfs/etc.
starType
  O — Blue Main Sequence Star
  B — Blue-White Main Sequence Star
  A — White Main Sequence Star
  F — Yellow-White Main Sequence Star
  G — Yellow Main Sequence Star
  K — Orange Main Sequence Star
  M — Red Dwarf Main Sequence Star
  O0V — Hot Blue Main Sequence Star
  B5V — Blue-White Main Sequence Star
  A0V — White Main Sequence Star
  F5V — Yellow-White Main Sequence Star
  G2V — Yellow Main Sequence Star (Sun-like)
  K0V — Orange Main Sequence Star
  M5V — Red Dwarf Main Sequence Star

// Planet types: common exoplanet types + jovian planet types
planetType
  Hot Jupiter
  Cold Jupiter
  Gas Giant
  Ice Giant
  Hot Neptune
  Mini-Neptune
  Super-Earth
  Terrestrial Planet
  Ocean World
  Lava World
  Desert World
  Frozen World
  Rocky Planet
  Carbon Planet
  Iron Planet

async loadNames() =>
  let res = await fetch("https://user.uploads.dev/file/c904a22c8c6d0d8951a788143f4583d4.json");
  let arr = await res.json();
  return arr;
