///last version 
textToImagePlugin = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
liveActivityPlugin = {import:live-activity-plugin}
kv = {import:kv-plugin} // supports the private gallery
superFetch = {import:super-fetch-plugin} // supports the private gallery
upload = {import:upload-plugin}
tabbedCommentsPlugin = {import:aiag-tabbed-comments-plugin}
commentsPlugin = {import:comments-plugin}
kazumaHTmL = {import:kazuma-plugin}
date = {import:date-plugin}
generatorStats = {import:generator-stats-plugin}
favicon = {import:favicon-plugin}

// t2i-regeneration: استوديو إعادة التوليد الكامل (تحرير prompt/seed/cfg، أبعاد، تنزيل بميتاداتا، إزالة خلفية، تبويبات متعددة)
t2iRegen = {import:t2i-regeneration}



test = {import:dokou-traits}
char = {import:char-list}
style = {import:style-list}
outfit = {import:kazuma-outfit}
poses = {import:poses-list}
world = {import:world-list}
effects = {import:effects-list}
mov = {import:dokou-moviemagic}
game = {import:game-girls}
clothes = {import:n-ai}
ns = {import:ns-dokou}
cosp = {import:cosplay-anime-es}
anime = {import:douko-anime}

$meta
  title = Dokou AI Art Generator - NeuralCanvas
  description = Free AI anime art generator with character, style, outfit, pose & world controls, image-to-prompt, regeneration studio, and community gallery
  tags = ai art generator, dokou, neuralcanvas
  image = https://user.uploads.dev/file/99b4dfdbee38e499af18f7c4c6baa29e.png
  header
    mode = minimal

bannedUsersList
  // add banned user IDs here, one per line

settings
  pageTitle = 🧠 KAZUMAART  · Dokou AI (FRE GENERATING IMAGES) IMAGE TO PROMPT 
  socialFeatures = disabled
  numImages = 1
  
  userInputs
    description
      label = 📝 Description
      type = paragraph
      remember = true
      takesUpFullRow = true
      random = [randomDescription]
      enterKeyTriggersGeneration = true
  
  imageOptions
    saveTitle = [imageTitle || "NeuralCanvas"]
    saveDescription = [imageDescription || ""]
    prompt = [createPrompt()]
    negativePrompt = [negPromptTextareaEl?.value || ""]
    resolution = [resolutionSelectEl?.value || "768x768"]
    guidanceScale = [Math.round(guidanceInputEl?.value || 7)]
    seed = [seedInputEl?.value || -1]
    width = [resolutionSelectEl?.value?.split("x")?.[0] || 768]
    hideGalleryButtons = false

  galleryOptions
    gallery = true
    sort = recent
    hideIfScoreIsBelow = -5
    adaptiveHeight = true
    contentFilter = PG-13

  defaultCommentOptions
    adminPasswordHash = f7ffc834b3e795103737ec7585362f015881e7d62e61254e2d9a0f47634a303d
   
    width = 100%
    height = 400
    messageBubbleStyle = background:pink; border:2px dotted red; color:black;
    messageFeedStyle = background-image:url(https://user.uploads.dev/file/856ec8cf14a408f8fa94f57840443b32.jpg); background-size:cover;
    inputAreaStyle = background:#fff391;
    submitButtonStyle = background:#00b6ff; border:none;
    commentPlaceholderText = Type a friendly comment...
    submitButtonText = submit comment
    bannedUsers = [bannedUsersList]
    adminFlair = 👑
    deleteButtonIcon = ❌
    customEmojis = {import:emojis-dokou}
    customEmojiSize = 1.5
  commentChannels
    general
      label = General
    request
      label = Request
      commentPlaceholderText = Share your request or suggestion. If suitable, it may be added to the generator
      submitButtonText = Submit Request
    prompt
      label = Prompt
      commentPlaceholderText = Share a cool prompt/style. If it's good, it may get added to the Art Style selector.
      submitButtonText = share prompt
    admin
      label = admin
      commentPlaceholderText = Explaining complex updates
      submitButtonText = Don't comment

randomDescription
  a beautiful landscape
  a cute character
  a futuristic city



















