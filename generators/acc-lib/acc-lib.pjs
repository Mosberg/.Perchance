$meta
  title = acc library
  description = discover, share, and upload character links from perchance's ai character chat. an organized, community-driven database for finding and submitting custom chat characters.
  tags = "ai character chat", "character chat", "acc library", "perchance chat", "character sharing", "perchance.org", "ai database", "chat characters", "roleplay ai"
  header
    background = #000000
    mode = minimal


