reindex
  [e1]^[elementmax >= 1 && isRegularElement(e1)]
  [e2]^[elementmax >= 2 && isRegularElement(e2)]
  [e3]^[elementmax >= 3 && isRegularElement(e3)]
  [e4]^[elementmax >= 4 && isRegularElement(e4)]
  [e5]^[elementmax >= 5 && isRegularElement(e5)]
  [e6]^[elementmax >= 6 && isRegularElement(e6)]
  [e7]^[elementmax >= 7 && isRegularElement(e7)]
  [e8]^[elementmax >= 8 && isRegularElement(e8)]
  [e9]^[elementmax >= 9 && isRegularElement(e9)]
  [e10]^[elementmax >= 10 && isRegularElement(e10)]
  [e11]^[elementmax >= 11 && isRegularElement(e11)]
  [e12]^[elementmax >= 12 && isRegularElement(e12)]
  [e13]^[elementmax >= 13 && isRegularElement(e13)]
  [e14]^[elementmax >= 14 && isRegularElement(e14)]
  [e15]^[elementmax >= 15 && isRegularElement(e15)]

hasElem(e) =>
	let elems = [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15];
	for (let i = 0; i < elems.length; i++) { if (elems[i] === e) return true; }
	return false;

isRegularElement(e) =>
	let el = elements[e];
	if (!el || !el.class) return false;
	let cls = el.class.evaluateItem;
	return cls === "natural" || cls === "magical" || cls === "ethereal" || cls === "paironormal";

hasBoth(a, b) =>
	return hasElem(a) && hasElem(b);

isLightColor(hex) =>
	let h = String(hex).replace('#', '');
	if (h.length !== 6) return false;
	let r = parseInt(h.slice(0,2), 16), g = parseInt(h.slice(2,4), 16), b = parseInt(h.slice(4,6), 16);
	return (r*0.299 + g*0.587 + b*0.114) > 170;


