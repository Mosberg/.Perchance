legendaryReqMet(l, nameSet) =>
	if (!l.requires) {
		if (l.requireElement) {
			let nm = islandname.evaluateItem;
			return nm && nm.indexOf(l.requireElement) !== -1;
		}
		return true;
	}
	let r0 = l.requires[0], r1 = l.requires[1];
	if (r0 === 'Shugabush' || r1 === 'Shugabush') {
		let sb = monsters.Shugabush;
		if (!sb || !sb.requires) return false;
		let shugaReq = sb.requires.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
		let otherParent = r0 === 'Shugabush' ? r1 : r0;
		return nameSet.has(otherParent) && nameSet.has(shugaReq[0]) && nameSet.has(shugaReq[1]);
	}
	return nameSet.has(r0) && nameSet.has(r1);

buildMonsterLookup() =>
	if (window.monsterLookup) return '';
	let lookup = {};
	let seasonals = [];
	let legendaries = [];
	let werdos = [];
	let mythicals = [];
	let monKeys = Object.keys(monsters).filter(function(k) { return k !== 'consumableList' && typeof monsters[k] === 'object' && k !== '???'; });
	for (let i = 0; i < monKeys.length; i++) {
		let name = monKeys[i];
		let mon = monsters[name];
		if (!mon || !mon.elements) continue;
		let elems = mon.elements.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
		if (elems.length === 0) continue;
		let requires = mon.requires ? mon.requires.consumableList.selectAll.map(function(e) { return e.evaluateItem; }) : null;
		let monClass = mon.monsterclass ? mon.monsterclass.evaluateItem : '';
		let subClass = mon.subclass ? mon.subclass.evaluateItem : '';
		if (monClass === 'legendary') {
			let lEntry = {
				name: name,
				imageurl: mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png',
				owner: mon.owner || '???',
				group: mon.group || '???',
				alt: false,
				element: elems[0],
				requires: requires,
				subclass: subClass,
				requireElement: mon.requireElement ? mon.requireElement.evaluateItem : null
			};
			if (subClass === 'werdos') {
				werdos.push(lEntry);
			} else {
				legendaries.push(lEntry);
			}
			continue;
		}
		let hasDream = elems.indexOf('Dream') !== -1;
		let hasMythical = elems.indexOf('Mythical') !== -1;
		if (hasDream || hasMythical) {
			mythicals.push({
				name: name,
				imageurl: mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png',
				owner: mon.owner || '???',
				group: mon.group || '???',
				alt: false,
				elements: elems,
				requires: requires
			});
			continue;
		}
		if (requires) {
			seasonals.push({
				name: name,
				imageurl: mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png',
				owner: mon.owner || '???',
				group: mon.group || '???',
				alt: false,
				element: elems[0],
				requires: requires
			});
			let sKey = elems[0];
			if (!lookup[sKey]) {
				lookup[sKey] = {
					name: name,
					imageurl: mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png',
					owner: mon.owner || '???',
					group: mon.group || '???',
					alt: false,
					seasonal: true
				};
			}
			if (!lookup[sKey + '__alts']) lookup[sKey + '__alts'] = [];
			continue;
		}
		let key = elems.slice().sort(function(a,b){ return (elements[a]||elements.Null).id - (elements[b]||elements.Null).id; }).join(',');
		let isAlt = mon.alt === true;
		let entry = {
			name: name,
			imageurl: mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png',
			owner: mon.owner || '???',
			group: mon.group || '???',
			alt: isAlt,
			minorurl: mon.minorurl || null
		};
		let prev = lookup[key];
		if (!prev || (isAlt === false && prev.alt === true)) {
			lookup[key] = entry;
		}
		if (!lookup[key + '__alts']) lookup[key + '__alts'] = [];
		if (isAlt) {
			lookup[key + '__alts'].push(entry);
		}
	}
	window.monsterLookup = lookup;
	window.seasonalMonsters = seasonals;
	window.legendaryMonsters = legendaries;
	window.werdosMonsters = werdos;
	window.mythicalMonsters = mythicals;
	return '';

prepareIslandData() =>
	buildMonsterLookup();
	let n = Number(elementmax);
	let rawElems = [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15].slice(0, n);
	let elems = rawElems.filter(function(e){ return e && e !== ""; });
	n = elems.length;
	let sig = n + '|' + elems.join(',') + '|' + iconsize;
	if (window._islandDataSig === sig && window._islandData) return '';
	window._islandDataSig = sig;
	let total = 1 << n;
	let lookup = window.monsterLookup;
	let iconCache = {};
	for (let i = 0; i < n; i++) iconCache[elems[i]] = (elements[elems[i]] || elements.Null).icon.evaluateItem;
	let popcnt = new Int8Array(total);
	let maskKeys = new Array(total);
	popcnt[0] = 0;
	maskKeys[0] = '';
	for (let mask = 1; mask < total; mask++) {
		popcnt[mask] = popcnt[mask & (mask - 1)] + 1;
		let key = '';
		for (let i = 0; i < n; i++) {
			if (mask & (1 << i)) {
				key += (key ? ',' : '') + elems[i];
			}
		}
		maskKeys[mask] = key;
	}
	let maskIconCache = new Array(total);
	let getMaskIcons = function(mask) {
		if (maskIconCache[mask] !== undefined) return maskIconCache[mask];
		let icons = '';
		for (let i = 0; i < n; i++) {
			if (mask & (1 << i)) icons += iconCache[elems[i]];
		}
		maskIconCache[mask] = icons;
		return icons;
	};
	window._islandData = { n: n, total: total, popcnt: popcnt, maskKeys: maskKeys, maskIcons: maskIconCache, getMaskIcons: getMaskIcons, iconCache: iconCache, lookup: lookup };
	return '';

buildSizeTabs(sizes) =>
	let tabId = 'mtabs_' + Math.random().toString(36).slice(2,9);
	let cardW = layoutsize * 1.25;
	let containerW = 700;
	let cols = Number(cardcolumns);
	let effectiveCols = cols > 0 ? cols : Math.max(1, Math.floor(containerW / (cardW + 8)));
	let perPage = Math.max(6, effectiveCols * 3);
	let html = '<div class="monster-tabs" id="' + tabId + '" data-per-page="' + perPage + '">';
	html += '<div class="monster-tabs-bar">';
	for (let i = 0; i < sizes.length; i++) {
		html += '<button class="mtab-btn' + (i === 0 ? ' active' : '') + '" onclick="monsterTabSwitch(\'' + tabId + '\',' + i + ',' + sizes.length + ')">' + sizes[i].name + (sizes[i].count !== undefined ? ' (' + sizes[i].count + ')' : '') + '</button>';
	}
	html += '</div>';
	window._mtabsData = window._mtabsData || {};
	let dataKey = tabId;
	window._mtabsData[dataKey] = {sizes: [], perPage: perPage, cols: cols, cardW: cardW};
	for (let i = 0; i < sizes.length; i++) {
		let cards;
		let isRaw = !!sizes[i].raw;
		if (isRaw) {
			cards = [sizes[i].html];
		} else {
			cards = sizes[i].cards || [];
		}
		window._mtabsData[dataKey].sizes.push({name: sizes[i].name, count: sizes[i].count, cards: cards, raw: isRaw});
		let showPager = !isRaw && cards.length > perPage;
		html += '<div class="mtab-content' + (i === 0 ? ' active' : '') + '" style="' + (i === 0 ? '' : 'display:none;') + '" data-tab-idx="' + i + '">';
		if (isRaw) {
			html += sizes[i].html;
		} else {
			html += '<div class="mtab-page-wrap" data-tab-idx="' + i + '">';
			html += renderMtabPage(dataKey, i, 0);
			html += '</div>';
			if (showPager) {
				let totalPages = Math.ceil(cards.length / perPage);
				html += renderMtabPager(dataKey, i, 0, totalPages);
			}
		}
		html += '</div>';
	}
	html += '</div>';
	return html;

renderMtabPage(dataKey, tabIdx, page) =>
	let data = window._mtabsData[dataKey];
	if (!data) return '';
	let s = data.sizes[tabIdx];
	if (!s) return '';
	let perPage = data.perPage;
	let start = page * perPage;
	let end = Math.min(start + perPage, s.cards.length);
	let cols = data.cols;
	let cardW = data.cardW;
	let gridCols = cols > 0 ? 'repeat(' + cols + ',minmax(' + cardW + 'px,1fr))' : 'repeat(auto-fit,minmax(' + cardW + 'px,1fr))';
	let html = '<div style="padding:8px;display:grid;grid-template-columns:' + gridCols + ';gap:' + cardgap + 'px;justify-items:center;align-items:center;">';
	for (let i = start; i < end; i++) html += s.cards[i];
	html += '</div>';
	return html;

renderMtabPager(dataKey, tabIdx, page, totalPages) =>
	let html = '<div class="mtab-pager" data-tab-idx="' + tabIdx + '">';
	html += '<button class="mtab-page-btn" onclick="mtabPageChange(\'' + dataKey + '\',' + tabIdx + ',' + Math.max(0, page - 1) + ')"' + (page === 0 ? ' disabled' : '') + '>&#9664;</button>';
	html += '<span class="mtab-page-info">Page ' + (page + 1) + ' / ' + totalPages + '</span>';
	html += '<button class="mtab-page-btn" onclick="mtabPageChange(\'' + dataKey + '\',' + tabIdx + ',' + Math.min(totalPages - 1, page + 1) + ')"' + (page >= totalPages - 1 ? ' disabled' : '') + '>&#9654;</button>';
	html += '</div>';
	return html;
precomputeCounts() =>
	buildMonsterLookup();
	if (islandtype === "Islet") {
		let target = e1;
		let monKeys = Object.keys(monsters).filter(function(k) { return k !== 'consumableList' && k !== '???' && typeof monsters[k] === 'object'; });
		let altsFillOn = cbChecked("altsfill", false);
		let total = 0, complete = 0;
		for (let i = 0; i < monKeys.length; i++) {
			let mon = monsters[monKeys[i]];
			if (!mon || !mon.elements) continue;
			let elems = mon.elements.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
			if (elems.length === 0 || elems.indexOf(target) === -1) continue;
			total++;
			if (mon.alt !== true || altsFillOn) complete++;
		}
		totalmonstercount = total;
		completemonstercount = complete;
		return '';
	}
	if (islandtype === "Outer Island") {
		let monKeys = Object.keys(monsters).filter(function(k) { return k !== 'consumableList' && k !== '???' && typeof monsters[k] === 'object'; });
		let pool = [];
		for (let i = 0; i < monKeys.length; i++) {
			let mon = monsters[monKeys[i]];
			if (!mon || !mon.elements || mon.requires) continue;
			let elems = mon.elements.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
			if (elems.length === 0) continue;
			pool.push({isAlt: mon.alt === true});
		}
		let count = Math.max(1, Math.min(Number(monsteramount) || 10, pool.length));
		totalmonstercount = count;
		completemonstercount = pool.slice(0, count).filter(function(m) { return !m.isAlt; }).length;
		return '';
	}
	prepareIslandData();
	let d = window._islandData;
	let n = d.n, total = d.total, popcnt = d.popcnt, maskKeys = d.maskKeys;
	let lookup = d.lookup;
	let tCount = 0, cCount = 0;
	let islandMonsterNames = new Set();
	let altsFillOn = cbChecked("altsfill", false);
	for (let mask = 1; mask < total; mask++) {
		let size = popcnt[mask];
		if (!isComboSizeEnabled(size)) continue;
		let data = lookup[maskKeys[mask]];
		tCount++;
		if (data && (!data.alt || altsFillOn)) {
			cCount++;
			islandMonsterNames.add(data.name);
		}
	}
	let seasonalCb = document.getElementById('seasonal');
	if (seasonalCb && seasonalCb.checked) {
		let islandElemsSet = new Set([e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15].slice(0, n));
		for (let s of (window.seasonalMonsters || [])) {
			if (islandElemsSet.has(s.element)) {
				tCount++; cCount++;
			} else if (islandMonsterNames.has(s.requires[0]) && islandMonsterNames.has(s.requires[1])) {
				tCount++; cCount++;
			}
		}
	}
	let legendaryCb = document.getElementById('legendary');
	if (legendaryCb && legendaryCb.checked) {
		for (let l of (window.legendaryMonsters || [])) {
			if (l.requires) {
				if (legendaryReqMet(l, islandMonsterNames)) {
					tCount++; cCount++;
				}
			} else if (l.requireElement) {
				if (legendaryReqMet(l, islandMonsterNames)) {
					tCount++; cCount++;
				}
			} else {
				tCount++; cCount++;
			}
		}
		let werdosPool = (window.werdosMonsters || []).slice();
		for (let i = werdosPool.length - 1; i > 0; i--) {
			let j = Math.floor(Math.random() * (i + 1));
			[werdosPool[i], werdosPool[j]] = [werdosPool[j], werdosPool[i]];
		}
		let selectedWerdos = werdosPool.slice(0, 2);
		for (let w of selectedWerdos) {
			tCount++; cCount++;
		}
	}
	let mythicalCountCb = document.getElementById('mythical');
	if (mythicalCountCb && mythicalCountCb.checked) {
		let mythicalMatched = {};
		let changed = true;
		while (changed) {
			changed = false;
			for (let m of (window.mythicalMonsters || [])) {
				if (mythicalMatched[m.name]) continue;
				if (m.requires && islandMonsterNames.has(m.requires[0]) && islandMonsterNames.has(m.requires[1])) {
					mythicalMatched[m.name] = true;
					islandMonsterNames.add(m.name);
					tCount++; cCount++;
					changed = true;
				}
			}
		}
	}
	totalmonstercount = tCount;
	completemonstercount = cCount;
	return '';

generateIslandBoss() =>
	buildMonsterLookup();
	let n = Number(elementmax);
	let islandElems = [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15].slice(0, n).filter(function(v){return v;});
	let islandSet = {};
	for (let e of islandElems) islandSet[e] = true;
	let monKeys = Object.keys(monsters).filter(function(k){ return k !== 'consumableList' && k !== '???' && typeof monsters[k] === 'object'; });
	let boss = null;
	let bossElemCount = 0;
	for (let i = 0; i < monKeys.length; i++) {
		let name = monKeys[i];
		let mon = monsters[name];
		if (!mon || !mon.elements) continue;
		if (mon.requires) continue;
		if (shouldHideMonster(mon)) continue;
		let elems = mon.elements.consumableList.selectAll.map(function(e){ return e.evaluateItem; });
		if (elems.length === 0) continue;
		let allPresent = true;
		for (let e of elems) { if (!islandSet[e]) { allPresent = false; break; } }
		if (!allPresent) continue;
		if (elems.length > bossElemCount) {
			bossElemCount = elems.length;
			boss = {name: name, mon: mon, elems: elems};
		}
	}
	if (!boss) return '<p style="color:#aaa;text-align:center;">No boss monster found for this island.</p>';
	let mysteryImg = "https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png";
	let imgUrl = boss.mon.imageurl || mysteryImg;
	let groupIcons = {"vocal":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","instrumental":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/b/bb/Pitched_Instrumental_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","percussion":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Percussion_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","???":"<span></span>","vocals":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">"};
	let iconsHtml = '';
	for (let e of boss.elems) {
		let el = elements[e] || elements.Null;
		let color = el.color.evaluateItem;
		iconsHtml += "<span class='elem-tip' style='position:relative;display:inline-block;margin:2px;'>" + el.icon.evaluateItem + "<span class='elem-tip-label' style='background:" + color + ";color:" + (isLightColor(color) ? "#1a0f2a" : "#fff") + ";border-color:" + color + ";'>" + e + "</span></span>";
	}
	let groupIcon = groupIcons[boss.mon.group] || groupIcons["???"];
	let showOwner = cbChecked("showowner", true);
	let showGroup = cbChecked("showgroupicon", true);
	let showElems = cbChecked("showelemicons", true);
	let html = '<div style="display:flex;gap:16px;align-items:center;justify-content:center;flex-wrap:wrap;padding:10px;">';
	html += '<img src="' + imgUrl + '" style="height:' + bosssize + 'px;border-radius:15px;border:4px solid #FFD700;box-shadow:0 0 12px rgba(255,215,0,0.4);" loading="lazy">';
	html += '<div style="text-align:center;">';
	html += '<div style="font-size:14px;color:#aaa;">👑 Island Boss</div>';
	html += '<div style="font-size:26px;color:#FFD700;font-weight:bold;">' + boss.name + '</div>';
	if (showOwner) html += '<div style="font-size:13px;color:#ccc;">by ' + (boss.mon.owner || '???') + '</div>';
	if (showElems) html += '<div style="margin-top:6px;">' + iconsHtml + '</div>';
	if (showGroup) html += '<div style="margin-top:4px;">' + groupIcon + '</div>';
	html += '<div style="font-size:13px;color:#5ED317;margin-top:4px;">' + bossElemCount + ' elements</div>';
	html += '</div>';
	html += '</div>';
	return html;

generateMonsterList() =>
	buildMonsterLookup();
	completemonstercount = 0;
	totalmonstercount = 0;
	if (islandtype === "Islet") return generateIsletList();
	if (islandtype === "Outer Island") return generateOuterIslandList();
	prepareIslandData();
	let d = window._islandData;
	let n = d.n, total = d.total, popcnt = d.popcnt, maskKeys = d.maskKeys, getMaskIcons = d.getMaskIcons;
	let lookup = d.lookup;
	let mysteryImg = "https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png";
	let mysteryData = {name:"???", imageurl:mysteryImg, owner:"???", group:"???", alt:false};
	let groupIcons = {"vocal":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=" + iconsize + "px>","instrumental":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/b/bb/Pitched_Instrumental_%28Composer_Type%29.png\" height=" + iconsize + "px>","percussion":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Percussion_%28Composer_Type%29.png\" height=" + iconsize + "px>","???":"<span></span>"};
	let sizeNames = ["","Singles","Doubles","Triples","Quads","Quintuples","Sextuples","Septuples","Octuples","Nonuples","Decuples","Undecuples","Duodecuples","Tredecuples","Quattuordecuples","Quindecuples"];
	let hideMissing = cbChecked("hidemissing", false) || n > 9;
	let sizeCounts = {};
	let missingCards = [];
	let missingCount = 0;
	let islandMonsterNames = new Set();
	let showOwner = cbChecked("showowner", true);
	let showGroup = cbChecked("showgroupicon", true);
	let showElems = cbChecked("showelemicons", true);
	let sizeParts = {};
	for (let mask = 1; mask < total; mask++) {
		let size = popcnt[mask];
		if (!isComboSizeEnabled(size)) continue;
		let key = maskKeys[mask];
		let altsFillOn = cbChecked("altsfill", false);
		let data = lookup[key];
		let isMissing = !data || (data.alt && !altsFillOn);
		if (!data || (data.alt && !altsFillOn)) data = mysteryData;
		totalmonstercount += 1;
		if (!isMissing) {
			sizeCounts[size] = (sizeCounts[size] || 0) + 1;
			completemonstercount += 1;
			islandMonsterNames.add(data.name);
		}
		if (isMissing) {
			missingCount++;
			if (hideMissing) continue;
		}
		let cardParts = [];
		cardParts.push('<div class="mcard' + (isMissing ? ' mcard-missing' : '') + '" style="height:' + (layoutsize*1.75) + 'px;width:' + (layoutsize*1.25) + 'px;border-radius:' + cardradius + 'px;">');
		cardParts.push('<div class="mcard-header"><span class="mcard-name">' + data.name + '</span>' + (showOwner ? '<span class="mcard-owner">by ' + data.owner + '</span>' : '') + '</div>');
		if (data.minorurl) {
			cardParts.push(paironormalImageHtml(data.imageurl, data.minorurl, imagesize));
		} else {
			cardParts.push('<div class="mcard-img"><img src="' + data.imageurl + '" height="' + imagesize + '" loading="lazy"></div>');
		}
		cardParts.push('<div class="mcard-elems">' + (showElems ? getMaskIcons(mask) : '') + '</div>');
		cardParts.push('<div class="mcard-group">' + (showGroup ? groupIcons[data.group] : '') + '</div>');
		cardParts.push('</div>');
		if (isMissing) missingCards.push(cardParts.join(''));
		else {
			if (!sizeParts[size]) sizeParts[size] = [];
			sizeParts[size].push(cardParts.join(''));
		}
	}
	let html = "";
	let sizes = [];
	for (let size = 1; size <= n; size++) {
		if (!sizeParts[size] || sizeCounts[size] === 0) continue;
		sizes.push({name: sizeNames[size], count: sizeCounts[size], cards: sizeParts[size]});
	}
	if (missingCards.length && !hideMissing) {
		sizes.push({name: "Missing", count: missingCards.length, cards: missingCards});
	}
	let seasonalCb = document.getElementById('seasonal');
	if (seasonalCb && seasonalCb.checked) {
		let islandElemsSet = new Set([e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15].slice(0, Number(elementmax)).filter(function(v){return v;}));
		let seasonalParts = [];
		for (let s of (window.seasonalMonsters || [])) {
			if (islandElemsSet.has(s.element)) continue;
			if (islandMonsterNames.has(s.requires[0]) && islandMonsterNames.has(s.requires[1])) {
				seasonalParts.push(renderMonsterCard(s.name, monsters[s.name], [s.element]));
				completemonstercount += 1;
				totalmonstercount += 1;
			}
		}
		if (seasonalParts.length) {
			sizes.push({name: "Seasonals", count: seasonalParts.length, cards: seasonalParts});
		}
	}
	let legendaryCb = document.getElementById('legendary');
	if (legendaryCb && legendaryCb.checked) {
		let legendaryParts = [];
		for (let l of (window.legendaryMonsters || [])) {
			if (l.requires) {
				if (legendaryReqMet(l, islandMonsterNames)) {
					legendaryParts.push(renderMonsterCard(l.name, monsters[l.name], [l.element]));
					completemonstercount += 1;
					totalmonstercount += 1;
				}
			} else if (l.requireElement) {
				if (legendaryReqMet(l, islandMonsterNames)) {
					legendaryParts.push(renderMonsterCard(l.name, monsters[l.name], [l.element]));
					completemonstercount += 1;
					totalmonstercount += 1;
				}
			} else {
				legendaryParts.push(renderMonsterCard(l.name, monsters[l.name], [l.element]));
				completemonstercount += 1;
				totalmonstercount += 1;
			}
		}
		if (legendaryParts.length) {
			sizes.push({name: "Legendaries", count: legendaryParts.length, cards: legendaryParts});
		}
		let werdosPool = (window.werdosMonsters || []).slice();
		for (let i = werdosPool.length - 1; i > 0; i--) {
			let j = Math.floor(Math.random() * (i + 1));
			[werdosPool[i], werdosPool[j]] = [werdosPool[j], werdosPool[i]];
		}
		let selectedWerdos = werdosPool.slice(0, 2);
		let werdosParts = [];
		for (let w of selectedWerdos) {
			werdosParts.push(renderMonsterCard(w.name, monsters[w.name], [w.element]));
			completemonstercount += 1;
			totalmonstercount += 1;
		}
		if (werdosParts.length) {
			sizes.push({name: "Werdos", count: werdosParts.length, cards: werdosParts});
		}
	}
	let mythicalCb = document.getElementById('mythical');
	if (mythicalCb && mythicalCb.checked) {
		let mythicalParts = [];
		let mythicalMatched = {};
		let changed = true;
		while (changed) {
			changed = false;
			for (let m of (window.mythicalMonsters || [])) {
				if (mythicalMatched[m.name]) continue;
				if (m.requires && islandMonsterNames.has(m.requires[0]) && islandMonsterNames.has(m.requires[1])) {
					mythicalMatched[m.name] = true;
					islandMonsterNames.add(m.name);
					mythicalParts.push(renderMonsterCard(m.name, monsters[m.name], m.elements));
					completemonstercount += 1;
					totalmonstercount += 1;
					changed = true;
				}
			}
		}
		if (mythicalParts.length) {
			sizes.push({name: "Mythicals", count: mythicalParts.length, cards: mythicalParts});
		}
	}
	if (showalts.checked) {
		let altsHtml = generateAltsInner();
		if (altsHtml) sizes.push({name: "Alternatives", html: altsHtml, raw: true});
	}
	return buildSizeTabs(sizes);
generateIsletList() =>
	buildMonsterLookup();
	let target = e1;
	let monKeys = Object.keys(monsters).filter(function(k) { return k !== 'consumableList' && k !== '???' && typeof monsters[k] === 'object'; });
	let matches = [];
	let altMatches = [];
	for (let i = 0; i < monKeys.length; i++) {
		let name = monKeys[i];
		let mon = monsters[name];
		if (!mon || !mon.elements) continue;
		let elems = mon.elements.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
		if (elems.length === 0) continue;
		if (elems.indexOf(target) === -1) continue;
		let entry = {name: name, elems: elems, isAlt: mon.alt === true, mon: mon};
		if (mon.alt === true) altMatches.push(entry);
		else matches.push(entry);
	}
	matches.sort(function(a, b) { if (a.elems.length !== b.elems.length) return a.elems.length - b.elems.length; return a.name.localeCompare(b.name); });
	let altsFillOn = cbChecked("altsfill", false);
	let fillAlts = altsFillOn ? altMatches : [];
	totalmonstercount = matches.length + altMatches.length;
	completemonstercount = matches.length + fillAlts.length;
	let sizeNames = ["","Singles","Doubles","Triples","Quads","Quintuples","Sextuples","Septuples","Octuples","Nonuples","Decuples","Undecuples","Duodecuples","Tredecuples","Quattuordecuples","Quindecuples"];
	let sizeGroups = {};
	for (let m of matches) {
		let s = m.elems.length;
		if (!sizeGroups[s]) sizeGroups[s] = [];
		sizeGroups[s].push(m);
	}
	for (let m of fillAlts) {
		let s = m.elems.length;
		if (!sizeGroups[s]) sizeGroups[s] = [];
		sizeGroups[s].push(m);
	}
	let html = "";
	let sizes = [];
	for (let s in sizeGroups) {
		let grp = sizeGroups[s];
		let cards = [];
		for (let m of grp) cards.push(renderMonsterCard(m.name, m.mon, m.elems));
		sizes.push({name: sizeNames[s] || (s + "-element"), count: grp.length, cards: cards});
	}
	if (showalts.checked && altMatches.length > 0 && !altsFillOn) {
		let altsHtml = generateIsletAltsInner(altMatches);
		if (altsHtml) sizes.push({name: "Alternatives", html: altsHtml, raw: true});
	}
	if (sizes.length === 0) return '<p style="color:#aaa;text-align:center;">No monsters found with the ' + target + ' element.</p>';
	return buildSizeTabs(sizes);

generateIsletAltsInner(altMatches) =>
	let groupIcons = {"vocal":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","instrumental":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/b/bb/Pitched_Instrumental_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","percussion":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Percussion_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","???":"<span></span>","vocals":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">"};
	let cardStyle = "box-sizing:border-box;border:4px solid #B94F2D;border-radius:14px;background:radial-gradient(circle at 50% 30%, #5a3a7d 0%, #2a1540 60%, #0a0510 100%);padding:8px;text-align:center;color:white;display:flex;flex-direction:column;align-items:center;gap:4px;transition:transform 0.25s,box-shadow 0.25s,border-color 0.25s;";
	let imgStyle = "height:" + (imagesize * 0.7) + "px;border-radius:10px;filter:drop-shadow(0 3px 6px rgba(0,0,0,0.5));";
	let nameStyle = "font-size:14px;font-weight:bold;color:#FFD700;";
	let smallStyle = "font-size:11px;color:#aaa;";
	let altsByCombo = {};
	for (let m of altMatches) {
		let comboKey = m.elems.slice().sort(function(a,b){ return (elements[a]||elements.Null).id - (elements[b]||elements.Null).id; }).join(',');
		if (!altsByCombo[comboKey]) {
			let icons = '';
			for (let e of m.elems) {
				if (elements[e] && elements[e].icon) icons += elements[e].icon.evaluateItem;
			}
			altsByCombo[comboKey] = { monsters: [], icons: icons, size: m.elems.length };
		}
		altsByCombo[comboKey].monsters.push({name: m.name, imageurl: m.mon.imageurl || 'https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png', group: m.mon.group || '???'});
	}
	let comboOrder = Object.keys(altsByCombo).sort(function(a,b) {
		let sa = altsByCombo[a].size, sb = altsByCombo[b].size;
		if (sa !== sb) return sa - sb;
		return a.localeCompare(b);
	});
	let html = "";
	if (comboOrder.length === 0) return '';
	html += '<div style="padding:8px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;">';
	for (let key of comboOrder) {
		let group = altsByCombo[key];
		html += '<div style="border:4px solid #B94F2D;border-radius:20px;background:linear-gradient(180deg, rgba(65,41,93,0.4), rgba(26,15,42,0.3));padding:10px;">';
		html += '<div style="font-size:12px;color:#aaa;margin-bottom:8px;">' + group.icons + '</div>';
		html += '<div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;">';
		for (let m of group.monsters) {
			html += '<div style="' + cardStyle + '">';
			html += '<img src="' + m.imageurl + '" style="' + imgStyle + '" loading="lazy">';
			html += '<div style="' + nameStyle + '">' + m.name + '</div>';
			html += '<div style="' + smallStyle + '">' + (groupIcons[m.group] || "") + '</div>';
			html += '</div>';
		}
		html += '</div>';
		html += '</div>';
	}
	html += '</div>';
	return html;

generateOuterIslandList() =>
	buildMonsterLookup();
	let monKeys = Object.keys(monsters).filter(function(k) { return k !== 'consumableList' && k !== '???' && typeof monsters[k] === 'object'; });
	let pool = [];
	for (let i = 0; i < monKeys.length; i++) {
		let name = monKeys[i];
		let mon = monsters[name];
		if (!mon || !mon.elements) continue;
		if (mon.requires) continue;
		if (shouldHideMonster(mon)) continue;
		let elems = mon.elements.consumableList.selectAll.map(function(e) { return e.evaluateItem; });
		if (elems.length === 0) continue;
		pool.push({name: name, elems: elems, isAlt: mon.alt === true, mon: mon});
	}
	let count = Math.max(1, Math.min(Number(monsteramount) || 10, pool.length));
	for (let i = pool.length - 1; i > 0; i--) {
		let j = Math.floor(Math.random() * (i + 1));
		let tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
	}
	let selected = pool.slice(0, count);
	totalmonstercount = selected.length;
	completemonstercount = selected.filter(function(m) { return !m.isAlt; }).length;
	let sizes = [];
	let mainCards = [];
	for (let m of selected) mainCards.push(renderMonsterCard(m.name, m.mon, m.elems));
	sizes.push({name: "Monsters", count: selected.length, cards: mainCards});
	let seasonalCb = document.getElementById('seasonal');
	if (seasonalCb && seasonalCb.checked) {
		let islandNames = new Set(selected.map(function(m) { return m.name; }));
		let seasonalParts = [];
		for (let s of (window.seasonalMonsters || [])) {
			if (islandNames.has(s.requires[0]) && islandNames.has(s.requires[1])) {
				seasonalParts.push(renderMonsterCard(s.name, monsters[s.name], [s.element]));
				completemonstercount += 1;
				totalmonstercount += 1;
			}
		}
		if (seasonalParts.length) sizes.push({name: "Seasonals", count: seasonalParts.length, cards: seasonalParts});
	}
	return buildSizeTabs(sizes);

paironormalImageHtml(majorUrl, minorUrl, sz) =>
	let imgId = 'pimg_' + Math.random().toString(36).slice(2, 10);
	let html = '<div class="mcard-img" style="flex-direction:column;gap:4px;">';
	html += '<img id="' + imgId + '" src="' + majorUrl + '" height="' + sz + '" loading="lazy" data-major="' + majorUrl + '" data-minor="' + minorUrl + '">';
	html += '<div class="ptab-bar">';
	html += '<button class="ptab-btn active" onclick="paironormalFormSwitch(\'' + imgId + '\',this,\'major\')">Major</button>';
	html += '<button class="ptab-btn" onclick="paironormalFormSwitch(\'' + imgId + '\',this,\'minor\')">Minor</button>';
	html += '</div>';
	html += '</div>';
	return html;

renderMonsterCard(name, mon, elems) =>
	let mysteryImg = "https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png";
	let groupIcons = {"vocal":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","instrumental":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/b/bb/Pitched_Instrumental_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","percussion":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Percussion_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","???":"<span></span>","vocals":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">"};
	let imgUrl = mon.imageurl || mysteryImg;
	let owner = mon.owner || "???";
	let group = mon.group || "???";
	let icons = "";
	for (let e of elems) {
		if (elements[e] && elements[e].icon) icons += elements[e].icon.evaluateItem;
	}
	let showOwner = cbChecked("showowner", true);
	let showGroup = cbChecked("showgroupicon", true);
	let showElems = cbChecked("showelemicons", true);
	let isMissing = (name === "???" || !mon.imageurl);
	let html = '<div class="mcard' + (isMissing ? ' mcard-missing' : '') + '" style="height:' + (layoutsize*1.75) + 'px;width:' + (layoutsize*1.25) + 'px;border-radius:' + cardradius + 'px;">';
	html += '<div class="mcard-header"><span class="mcard-name">' + name + '</span>' + (showOwner ? '<span class="mcard-owner">by ' + owner + '</span>' : '') + '</div>';
	if (mon.minorurl) {
		html += paironormalImageHtml(imgUrl, mon.minorurl, imagesize);
	} else {
		html += '<div class="mcard-img"><img src="' + imgUrl + '" height="' + imagesize + '" loading="lazy"></div>';
	}
	html += '<div class="mcard-elems">' + (showElems ? icons : '') + '</div>';
	html += '<div class="mcard-group">' + (showGroup ? (groupIcons[group] || "") : '') + '</div>';
	html += '</div>';
	return html;

generateAltsInner() =>
	if (islandtype !== "Island") return '';
	prepareIslandData();
	let d = window._islandData;
	let n = d.n, total = d.total, popcnt = d.popcnt, maskKeys = d.maskKeys, getMaskIcons = d.getMaskIcons;
	let lookup = d.lookup;
	let groupIcons = {"vocal":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","instrumental":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/b/bb/Pitched_Instrumental_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","percussion":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Percussion_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">","???":"<span></span>","vocals":"<img src=\"https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png\" height=\"" + iconsize + "px\">"};
	let cardStyle = "box-sizing:border-box;border:4px solid #B94F2D;border-radius:14px;background:radial-gradient(circle at 50% 30%, #5a3a7d 0%, #2a1540 60%, #0a0510 100%);padding:8px;text-align:center;color:white;display:flex;flex-direction:column;align-items:center;gap:4px;transition:transform 0.25s,box-shadow 0.25s,border-color 0.25s;";
	let imgStyle = "height:" + (imagesize * 0.7) + "px;border-radius:10px;filter:drop-shadow(0 3px 6px rgba(0,0,0,0.5));";
	let nameStyle = "font-size:14px;font-weight:bold;color:#FFD700;";
	let smallStyle = "font-size:11px;color:#aaa;";
	let altsByCombo = {};
	for (let mask = 1; mask < total; mask++) {
		let size = popcnt[mask];
		if (!isComboSizeEnabled(size)) continue;
		let comboKey = maskKeys[mask];
		let altsList = lookup[comboKey + '__alts'];
		let baseData = lookup[comboKey];
		if (!altsList || altsList.length === 0) continue;
		let altsFillOn = cbChecked("altsfill", false);
		if (altsFillOn && (!baseData || baseData.alt)) continue;
		let allMonsters = [];
		if (baseData && !baseData.alt) allMonsters.push(baseData);
		for (let a of altsList) allMonsters.push(a);
		if (allMonsters.length < 1) continue;
		altsByCombo[comboKey] = { monsters: allMonsters, icons: getMaskIcons(mask), size: size };
	}
	let comboOrder = [];
	for (let mask = 1; mask < total; mask++) {
		let sz = popcnt[mask];
		if (!isComboSizeEnabled(sz)) continue;
		let comboKey = maskKeys[mask];
		if (altsByCombo[comboKey]) comboOrder.push(comboKey);
	}
	let html = "";
	if (comboOrder.length === 0) return '';
	html += '<div style="padding:8px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;">';
	for (let key of comboOrder) {
		let group = altsByCombo[key];
		html += '<div style="border:4px solid #B94F2D;border-radius:20px;background:linear-gradient(180deg, rgba(65,41,93,0.4), rgba(26,15,42,0.3));padding:10px;">';
		html += '<div style="font-size:12px;color:#aaa;margin-bottom:8px;">' + group.icons + '</div>';
		html += '<div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;">';
		for (let m of group.monsters) {
			html += '<div style="' + cardStyle + '">';
			html += '<img src="' + m.imageurl + '" style="' + imgStyle + '" loading="lazy">';
			html += '<div style="' + nameStyle + '">' + m.name + '</div>';
			html += '<div style="' + smallStyle + '">' + groupIcons[m.group] + '</div>';
			html += '</div>';
		}
		html += '</div>';
		html += '</div>';
	}
	html += '</div>';
	return html;
generateBreedingTree() =>
	if (islandtype !== "Island") return '<p style="color:#aaa;text-align:center;">Breeding combinations are only available for Island type.</p>';
	prepareIslandData();
	let d = window._islandData;
	let n = d.n, total = d.total, popcnt = d.popcnt, maskKeys = d.maskKeys, getMaskIcons = d.getMaskIcons;
	let lookup = d.lookup;
	let mysteryImg = "https://static.wikia.nocookie.net/mysingingmonsters/images/3/31/Mystery_Like.png";
	let mysteryData = {name:"???", imageurl:mysteryImg};
	let nodes = [];
	let nameToId = {};
	let maxLevel = 0;
	let maxBreedSize = n <= 7 ? n : (n <= 10 ? 5 : 4);
	for (let mask = 1; mask < total; mask++) {
		let size = popcnt[mask];
		if (size > maxBreedSize) continue;
		if (!isComboSizeEnabled(size)) continue;
		let childKey = maskKeys[mask];
		let rawEntry = lookup[childKey];
		let altsFillOn = cbChecked("altsfill", false);
		let isMissing = !rawEntry || (rawEntry.alt && !altsFillOn);
		let childData = rawEntry || mysteryData;
		if (childData.alt && !altsFillOn) childData = mysteryData;
		let id = "m_" + mask;
		let node = {id: id, mask: mask, name: childData.name, imageurl: childData.imageurl, icons: getMaskIcons(mask), size: size, level: size - 1, parents: [], kind: "regular", missing: isMissing};
		nodes.push(node);
		if (childData.name && childData.name !== "???" && !isMissing) nameToId[childData.name] = id;
		if (size >= 2 && size <= maxBreedSize) {
			for (let sub = (mask - 1) & mask; sub > 0; sub = (sub - 1) & mask) {
				let comp = mask ^ sub;
				if (sub >= comp) continue;
				node.parents.push(["m_" + sub, "m_" + comp]);
			}
		}
		if (node.level > maxLevel) maxLevel = node.level;
	}
	let seasonalCb = document.getElementById("seasonal");
	let hasSeasonal = false;
	if (seasonalCb && seasonalCb.checked) {
		let islandElemsSet = new Set([e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15].slice(0, Number(elementmax)).filter(function(v){return v;}));
		let islandNames = new Set();
		for (let nd of nodes) if (nd.name && nd.name !== "???") islandNames.add(nd.name);
		for (let s of (window.seasonalMonsters || [])) {
			if (islandElemsSet.has(s.element)) continue;
			if (!islandNames.has(s.requires[0]) || !islandNames.has(s.requires[1])) continue;
			let sIcon = (elements[s.element] || elements.Null).icon.evaluateItem;
			let id = "s_" + s.name.replace(/\s+/g, "_");
			let p1 = nameToId[s.requires[0]], p2 = nameToId[s.requires[1]];
			nodes.push({id: id, name: s.name, imageurl: s.imageurl, icons: sIcon, size: 0, level: maxLevel + 1, parents: [[p1, p2]], kind: "seasonal", missing: false});
			nameToId[s.name] = id;
			hasSeasonal = true;
		}
	}
	if (hasSeasonal) maxLevel++;
	let legendaryCb = document.getElementById("legendary");
	let hasLegendary = false;
	if (legendaryCb && legendaryCb.checked) {
		let islandNames = new Set();
		for (let nd of nodes) if (nd.name && nd.name !== "???") islandNames.add(nd.name);
		for (let l of (window.legendaryMonsters || [])) {
			if (!l.requires) continue;
			if (!legendaryReqMet(l, islandNames)) continue;
			let lIcon = (elements[l.element] || elements.Null).icon.evaluateItem;
			let id = "l_" + l.name.replace(/\s+/g, "_");
			let p1 = nameToId[l.requires[0]], p2 = nameToId[l.requires[1]];
			nodes.push({id: id, name: l.name, imageurl: l.imageurl, icons: lIcon, size: 0, level: maxLevel + 1, parents: [[p1, p2]], kind: "legendary", missing: false});
			nameToId[l.name] = id;
			hasLegendary = true;
		}
	}
	if (hasLegendary) maxLevel++;
	let mythicalCb = document.getElementById("mythical");
	let hasMythical = false;
	if (mythicalCb && mythicalCb.checked) {
		let islandNames = new Set();
		for (let nd of nodes) if (nd.name && nd.name !== "???") islandNames.add(nd.name);
		let mythicalMatched = {};
		let changed = true;
		while (changed) {
			changed = false;
			for (let m of (window.mythicalMonsters || [])) {
				if (mythicalMatched[m.name]) continue;
				if (!m.requires) continue;
				if (!islandNames.has(m.requires[0]) || !islandNames.has(m.requires[1])) continue;
				mythicalMatched[m.name] = true;
				islandNames.add(m.name);
				let mIcon = m.elements.map(function(e) { return (elements[e] || elements.Null).icon.evaluateItem; }).join(' ');
				let id = "my_" + m.name.replace(/\s+/g, "_");
				let p1 = nameToId[m.requires[0]], p2 = nameToId[m.requires[1]];
				nodes.push({id: id, name: m.name, imageurl: m.imageurl, icons: mIcon, size: 0, level: maxLevel + 1, parents: [[p1, p2]], kind: "mythical", missing: false});
				nameToId[m.name] = id;
				hasMythical = true;
				changed = true;
			}
		}
	}
	if (hasMythical) maxLevel++;
	let nodeMap = {};
	for (let nd of nodes) nodeMap[nd.id] = nd;
	let imgSize = Math.max(36, Math.round(imagesize * 0.5));
	let borderFor = function(nd) {
		if (nd.kind === "legendary") return "#FFD700";
		if (nd.kind === "mythical") return "#D04FFF";
		if (nd.kind === "seasonal") return "#5ED317";
		return "#B94F2D";
	};
	let cellHtml = function(nd, sizeOverride) {
		let sz = sizeOverride || imgSize;
		let border = borderFor(nd);
		let missingCls = nd.missing ? " btable-missing" : "";
		return '<span class="btable-cell' + missingCls + '" style="position:relative;display:inline-block;vertical-align:middle;">' +
			'<img src="' + nd.imageurl + '" style="width:' + sz + 'px;height:' + sz + 'px;object-fit:contain;border-radius:8px;border:3px solid ' + border + ';background:rgba(0,0,0,0.4);cursor:pointer;" loading="lazy">' +
			'<span class="btable-tip" style="position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:6px;background:#1a0f2a;border:2px solid ' + border + ';border-radius:8px;padding:6px 10px;white-space:nowrap;z-index:30;pointer-events:none;text-align:center;">' +
				'<span style="display:block;font-size:13px;font-weight:bold;color:white;">' + nd.name + '</span>' +
				'<span style="display:block;font-size:16px;line-height:1;margin-top:2px;">' + nd.icons + '</span>' +
			'</span>' +
		'</span>';
	};
	let comboHtml = function(nd, p1, p2, smallImg) {
		let sz = smallImg ? Math.round(imgSize * 0.8) : imgSize;
		return '<div class="btable-combo">' + cellHtml(p1, sz) +
			'<span class="btable-op">+</span>' + cellHtml(p2, sz) +
			'<span class="btable-arrow">&rarr;</span>' + cellHtml(nd, sz) +
		'</div>';
	};
	let grouped = [];
	let seenResult = {};
	for (let nd of nodes) {
		if (!nd.parents || nd.parents.length === 0) continue;
		if (seenResult[nd.id]) continue;
		if (nd.missing) continue;
		seenResult[nd.id] = true;
		let combos = [];
		for (let pair of nd.parents) {
			let p1 = nodeMap[pair[0]], p2 = nodeMap[pair[1]];
			if (!p1 || !p2) continue;
			combos.push([p1, p2]);
		}
		if (combos.length === 0) continue;
		grouped.push({nd: nd, combos: combos});
	}
	let rows = '';
	let rowCt = 0;
	let maxRows = 300;
	let truncated = 0;
	window._btableCombos = [];
	window._btableImgSize = imgSize;
	for (let g of grouped) {
		if (rowCt >= maxRows) { truncated++; continue; }
		rowCt++;
		let border = borderFor(g.nd);
		let resultCell = '<td class="btable-result" style="text-align:center;padding:10px;border-right:2px solid rgba(185,79,45,0.4);">' + cellHtml(g.nd) + '</td>';
		let comboCell;
		if (g.combos.length === 1) {
			let c = g.combos[0];
			comboCell = '<td style="padding:10px;">' + comboHtml(g.nd, c[0], c[1]) + '</td>';
		} else {
			let first = g.combos[0];
			let serNode = function(nd) { return {n: nd.name, i: nd.imageurl, e: nd.icons, k: nd.kind, m: nd.missing}; };
			let comboData = [];
			for (let i = 1; i < g.combos.length; i++) {
				let c = g.combos[i];
				comboData.push({s: serNode(g.nd), a: serNode(c[0]), b: serNode(c[1])});
			}
			let comboIdx = window._btableCombos.length;
			window._btableCombos.push(comboData);
			comboCell = '<td style="padding:10px;">' +
				'<details class="btable-details" data-combo-idx="' + comboIdx + '" ontoggle="renderBtableCombo(this)">' +
					'<summary class="btable-summary">' +
						'<span class="btable-count">' + g.combos.length + ' combinations</span>' +
						comboHtml(g.nd, first[0], first[1], true) +
					'</summary>' +
					'<div class="btable-extra"></div>' +
				'</details>' +
			'</td>';
		}
		rows += '<tr class="btable-row">' + resultCell + comboCell + '</tr>';
	}
	if (truncated) rows += '<tr><td colspan="2" class="btable-empty">...and ' + truncated + ' more results (capped at ' + maxRows + ' for performance)</td></tr>';
	if (!rows) rows = '<tr><td colspan="2" class="btable-empty">No breeding combinations available.</td></tr>';
	let html = '<div class="btable-scroll" style="overflow:auto;max-width:100%;">' +
		'<table class="btable" style="border-collapse:collapse;margin:0 auto;width:100%;max-width:720px;">' +
			'<thead><tr>' +
				'<th class="btable-th" style="width:34%;">Result</th>' +
				'<th class="btable-th">Combination</th>' +
			'</tr></thead>' +
			'<tbody>' + rows + '</tbody>' +
		'</table></div>';
	return html;
monsterlist
