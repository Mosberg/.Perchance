title
  The Ultimate My Singing Monsters Island Generator

pickOrderedElements(n) =>
	let arr = elements.consumableList.selectAll;
	let classPools = {};
	let allPool = [];
	for (let i = 0; i < arr.length; i++) {
		let nm = arr[i].evaluateItem;
		let el = elements[nm];
		if (!el || !el.class) continue;
		let cls = el.class.evaluateItem;
		if (cls === 'legendary') continue;
		if (cls === 'mythical') continue;
		let cbId = cls === 'seasonal' ? 'seasonalcombos' : cls;
		let cb = document.getElementById(cbId);
		if (cb && cb.checked) {
			if (!classPools[cls]) classPools[cls] = [];
			classPools[cls].push([nm, elements[nm].id]);
			allPool.push([nm, elements[nm].id, cls]);
		}
	}
	let classes = Object.keys(classPools);
	if (classes.length === 0) return [];
	let equalClassesCb = document.getElementById('equalclasses');
	let equalClassesOn = !equalClassesCb || equalClassesCb.checked;
	allPool.sort(function(a, b) { return a[1] - b[1]; });
	let result = [];
	let usedClasses = {};
	for (let i = 0; i < n; i++) {
		let remaining = n - i;
		let available = allPool.filter(function(e) { return result.indexOf(e[0]) === -1; });
		if (available.length === 0) break;
		let classCounts = {};
		for (let c of classes) classCounts[c] = 0;
		for (let r of result) {
			let entry = allPool.find(function(e) { return e[0] === r; });
			if (entry) classCounts[entry[2]]++;
		}
		let minClass = classes[0];
		for (let c of classes) {
			if (classCounts[c] < classCounts[minClass]) minClass = c;
		}
		let candidates;
		if (equalClassesOn) {
			candidates = available.filter(function(e) { return e[2] === minClass; });
			if (candidates.length === 0) candidates = available;
		} else {
			candidates = available;
		}
		let remainingAfter = available.length - 1;
		let maxIdx = candidates.length - 1;
		if (remainingAfter < remaining - 1) maxIdx = Math.min(maxIdx, candidates.length - remaining);
		if (maxIdx < 0) maxIdx = 0;
		let pick = Math.floor(Math.random() * (maxIdx + 1));
		result.push(candidates[pick][0]);
	}
	result.sort(function(a, b) {
		let ea = allPool.find(function(e) { return e[0] === a; });
		let eb = allPool.find(function(e) { return e[0] === b; });
		return ea[1] - eb[1]; 
	});
	return result;

elementpicker
  [picks = pickOrderedElements(elementmax),''][e1 = picks[0],''][e2 = picks[1],''][e3 = picks[2],''][e4 = picks[3],''][e5 = picks[4],''][e6 = picks[5],''][e7 = picks[6],''][e8 = picks[7],''][e9 = picks[8],''][e10 = picks[9],''][e11 = picks[10],''][e12 = picks[11],''][e13 = picks[12],''][e14 = picks[13],''][e15 = picks[14],'']
applyElements() =>
	let locks = Array.isArray(lockedElements) ? lockedElements : [];
	let n = elementmax;
	let locked = locks.slice(0, n);
	let need = n - locked.length;
	let picks = need > 0 ? pickOrderedElements(n).filter(function(v){return locked.indexOf(v) === -1;}).slice(0, need) : [];
	let all = locked.concat(picks);
	all.sort(function(a, b) { return (elements[a] || elements.Null).id - (elements[b] || elements.Null).id; });
	e1 = all[0] || ""; e2 = all[1] || ""; e3 = all[2] || ""; e4 = all[3] || "";
	e5 = all[4] || ""; e6 = all[5] || ""; e7 = all[6] || ""; e8 = all[7] || "";
	e9 = all[8] || ""; e10 = all[9] || ""; e11 = all[10] || ""; e12 = all[11] || "";
	e13 = all[12] || ""; e14 = all[13] || ""; e15 = all[14] || "";
	return "";

elementIconsHtml() =>
	let locks = Array.isArray(lockedElements) ? lockedElements : [];
	let slots = [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15];
	let mainParts = [];
	let otherParts = [];
	for (let i = 0; i < elementmax; i++) {
		let name = slots[i];
		if (!name) continue;
		let el = elements[name] || elements.Null;
		let icon = el.icon.evaluateItem;
		let isLocked = locks.indexOf(name) !== -1;
		let badge = isLocked ? "&#128274;" : "";
		let color = el.color.evaluateItem;
		let slot = "<span class='elem-tip' data-elem='" + name + "' onclick='toggleElementLock(&#34;" + name + "&#34;)' style='cursor:pointer;position:relative;display:inline-block;margin:2px;'>" + icon + "<span style='position:absolute;top:-4px;right:-4px;font-size:13px;pointer-events:none;'>" + badge + "</span><span class='elem-tip-label' style='background:" + color + ";color:" + (isLightColor(color) ? "#1a0f2a" : "#fff") + ";border-color:" + color + ";'>" + name + "</span></span>";
		let cls = el.class ? el.class.evaluateItem : "";
		let seasonalCombosCb = document.getElementById('seasonalcombos');
		let seasonalCombosOn = seasonalCombosCb && seasonalCombosCb.checked;
		if (cls === "seasonal" && !seasonalCombosOn) otherParts.push(slot);
		else mainParts.push(slot);
	}
	let html = "";
	if (mainParts.length) {
		html += "<div style='margin-bottom:6px;'><div style='font-size:13px;color:#aaa;margin-bottom:2px;'>Breedable Elements</div>" + mainParts.join("") + "</div>";
	}
	if (otherParts.length) {
		html += "<div><div style='font-size:13px;color:#aaa;margin-bottom:2px;'>Other Elements</div>" + otherParts.join("") + "</div>";
	}
	return html;
