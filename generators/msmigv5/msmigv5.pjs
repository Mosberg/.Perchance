terrain
  Earth = cracked stone pavement, rocky dirt paths, compacted gravel beds, weathered cobblestone
  Cold = snow-covered ground, frosty ice sheets, frozen tundra, crystalline frost plains
  Water = wet sand, shallow tidal pools, damp mossy shore, rippling waterlogged terrain
  Plant = lush green grass, mossy earth, root-tangled soil, vibrant meadow ground
  Air = windswept grass, cloud-like soft terrain, airy floating platforms, breezy open fields
  Fire = scorched earth, obsidian glass ground, glowing magma cracks, charred volcanic rock
  Light = gleaming marble floors, radiant crystal tiles, sunlit polished stone, luminous alabaster ground
  Psychic = swirling patterned ground, iridescent psychic sand, floating mind-shards, hypnotic spiral terrain
  Faerie = flower-petal pathways, enchanted moss, glittering fairy-ring ground, pastel blossom-strewn earth
  Bone = bone-strewn dry earth, calcified white sand, fossilized terrain, chalky dust plains
  Plasma = bubbling gelatinous ground, glowing plasma pools, viscous luminous surface, rippling energy terrain
  Shadow = dark void-like terrain, shadowy mist floor, ink-black ground, darkness-shrouded earth
  Mech = metallic plating, gear-studded floors, copper mechanical walkways, iron riveted ground
  Crystal = crystal shard terrain, faceted gem floors, prismatic crystal ground, geode-studded earth
  Poison = toxic sludge pools, corroded swampy ground, bubbling venomous terrain, acidic mossy flats
  Control = grid-patterned floor, hovering control panels, digital terrain, circuit-lined ground
  Hoax = glitchy shifting terrain, illusory ground, pixelated false earth, reality-warping static floor
  Ruin = crumbling ancient pavement, moss-covered ruins, decayed broken stonework, fractured tile ground
  Depths = abyssal dark seafloor, bioluminescent deep terrain, crushing dark pressure floor, deep ocean trench ground

sky
  Earth = a dusty brown-tinged sky with swirling sediment
  Cold = a pale frosty grey sky heavy with snow clouds
  Water = a misty teal sky with visible moisture and light rain
  Plant = a vibrant green-hued sky with drifting pollen and spores
  Air = a bright airy sky with wispy white clouds and visible wind currents
  Fire = a smoldering orange-red sky with drifting embers and ash
  Light = a radiant golden sky filled with warm brilliant light
  Psychic = a deep indigo sky swirling with psychic energy patterns
  Faerie = a soft pastel pink-purple sky shimmering with fairy dust
  Bone = a bone-white pale sky with dusty chalk clouds
  Plasma = a glowing magenta sky rippling with plasma energy
  Shadow = a pitch-dark sky with barely visible shadowy tendrils
  Mech = a metallic grey sky with mechanical clouds and steam
  Crystal = a prismatic sky refracting light into rainbow bands
  Poison = a sickly yellow-green sky with toxic haze
  Control = a digital sky with grid lines and data streams
  Hoax = a glitchy pixelated sky with shifting false colors
  Ruin = a faded grey sky with crumbling clouds and dust
  Depths = a pitch-black abyssal sky with bioluminescent specks

bpm
  [bpmVal()]
bpmVal() =>
	return Math.floor(Math.random() * (Number(bpmax) - Number(bpmin) + 1)) + Number(bpmin);

keyout
  [keymode === "Any" ? key.selectOne : keymode]

scaleout
  [scalemode === "Any" ? scale.selectOne : scalemode]

genreout
  [genremode === "Any" ? mgenre.selectOne : genremode]

timesig
  4/4^50
  3/4
  6/8
  5/4
  7/8
  2/4

timesigout
  [timesigmode === "Any" ? timesig.selectOne : timesigmode]

cbChecked(id, def) =>
	let el = document.getElementById(id);
	if (!el) return def;
	return el.checked;

isComboSizeEnabled(size) =>
	let el = document.getElementById("combosize" + size);
	if (!el) return true;
	return el.checked;

shouldHideMonster(mon) =>
	if (!mon) return false;
	if (cbChecked("hidefanmade", false) && mon.alt === true) return true;
	return false;

