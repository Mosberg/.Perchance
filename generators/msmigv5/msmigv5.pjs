elementicons
  [elementIconsHtml()]
islandlayout
  container
		style = height:auto;width:auto;border: 5px solid #B94F2D;border-radius:35px;background: radial-gradient(circle at 50% 0%, #5a3a7d 0%, #2a1540 60%, #0a0510 100%);padding:16px;
  grid
    a a a a a
    b b d d d
    e e e e e
    f f g g g
    i i i i i
  columnSizes = 1fr 1fr 1fr 1fr 1fr
  areas
    a
      content = <details open><summary style="cursor:pointer;font-size:25px;color:white;">Island Info</summary><p>[setelements][precomputeCounts(),'']<h2>[mainelement = reindex.selectOne,''][bi = biome.selectOne,''][i = islandname]</h2></p></details>
      style = [cbChecked("showislandinfo", true) ? "border: 5px solid #B94F2D;border-radius:25px;background: radial-gradient(circle at 50% 20%, #5a3a7d 0%, #2a1540 70%, #0a0510 100%);color:white;font-size:25px;padding:14px 18px;" : "display:none;"]
    b
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Elements</summary>[islandtype === "Islet" ? (elements[e1] || elements.Null).icon : elementicons]</details>
      style = [(islandtype === "Outer Island" || !cbChecked("showelements", true)) ? "display:none;" : "height:auto;color:white;font-size:20px;padding:14px 18px;"]
    d
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Song Info</summary> <p>Tempo - [bpm]</p><p>Key - [keyout] [scaleout.titleCase]</p><p>Genre - [genreout]</p><p>Time Signature - [timesigout]</p><p style="text-align:center;"><button class="msm-button btn-sm" onclick="rerollSongInfo()"><img src="https://static.wikia.nocookie.net/mysingingmonsters/images/9/96/Acapella_%28Composer_Type%29.png" class="btn-icon" loading="lazy"> Reroll Song Info</button></p></details>
      style = [showsonginfo.checked ? "height:auto;color:white;font-size:20px;padding:14px 18px;" : "display:none;"]
    e
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Monsters</summary> <div style="padding: 0px;width:100%;margin:auto;">[monsterlist]</div></details>
      style = height:auto;color:white;font-size:20px;padding:14px 18px;
    f
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Monster Count</summary><h2>Total Monster Count: [completemonstercount] / [totalmonstercount]</h2></details>
      style = [showmonstercount.checked ? "padding:14px 18px;" : "display:none;"]
    g
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Island Boss</summary>[generateIslandBoss()]</details>
      style = [showboss && cbChecked("showboss", true) ? "height:auto;color:white;font-size:20px;padding:14px 18px;" : "display:none;"]
    i
      content = <details open><summary style="cursor:pointer;font-size:20px;color:white;">Breeding Combinations</summary> <div style="padding:10px;">[generateBreedingTree()]</div></details>
      style = [(showbreeding.checked && islandtype === "Island") ? "height:auto;color:white;font-size:20px;padding:14px 18px;" : "display:none;"]

islandname
  [customislandname.value.trim() || (islandtype === "Outer Island" ? outerword.selectOne + " " + bi.selectOne : (namestyle === "Direct" ? mainelement.selectOne : (namestyle === "Adjectives" ? (synonyms[mainelement.selectOne] && synonyms[mainelement.selectOne].adjectives ? synonyms[mainelement.selectOne].adjectives.selectOne.evaluateItem.charAt(0).toUpperCase() + synonyms[mainelement.selectOne].adjectives.selectOne.evaluateItem.slice(1) : mainelement.selectOne) : (Math.random() < 0.5 ? mainelement.selectOne : (synonyms[mainelement.selectOne] ? (s = synonyms[mainelement.selectOne].selectOne.evaluateItem, s.charAt(0).toUpperCase() + s.slice(1)) : mainelement.selectOne))) + " " + bi.selectOne))]
