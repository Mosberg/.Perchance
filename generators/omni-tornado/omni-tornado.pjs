  imageOptions
    saveTitle = [input.imageName != "" ? input.imageName : "(" + input.artStyle.getName + ") " + input.description]
    prompt = [input.artStyle.prompt][input.style][(input.style3 ? (Array.isArray(input.style3) ? input.style3.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.style3.prompt || "") : "")][(input.themes ? (Array.isArray(input.themes) ? input.themes.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.themes.prompt || "") : "")][input.style5][input.style6][(input.bodyshape ? (Array.isArray(input.bodyshape) ? input.bodyshape.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.bodyshape.prompt || "") : "")][input.quality][input.lighting][input.atmosphere][input.subject][input.location][input.time][input.texture][input.focus][input.composition][input.detail][input.emotion][(input.anime ? (Array.isArray(input.anime) ? input.anime.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.anime.prompt || "") : "")][(input.manga ? (Array.isArray(input.manga) ? input.manga.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.manga.prompt || "") : "")][(input.comic ? (Array.isArray(input.comic) ? input.comic.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.comic.prompt || "") : "")][(input.disney ? (Array.isArray(input.disney) ? input.disney.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.disney.prompt || "") : "")][(input.cartoon ? (Array.isArray(input.cartoon) ? input.cartoon.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.cartoon.prompt || "") : "")][(input.videogame ? (Array.isArray(input.videogame) ? input.videogame.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.videogame.prompt || "") : "")][(input.horror ? (Array.isArray(input.horror) ? input.horror.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.horror.prompt || "") : "")][(input.folklore ? (Array.isArray(input.folklore) ? input.folklore.map(function(s) { return s.prompt || ""; }).filter(function(p) { return p; }).join(", ") : input.folklore.prompt || "") : "")][input.fixes1.prompt][input.fixes2.prompt][input.fixes3.prompt][input.fixes4.prompt][input.lightningcamera.prompt][input.anglescamera.prompt][input.expocamera.prompt][input.focuscamera.prompt][input.lenscamera.prompt][input.lightingcamera.prompt][input.typecamera.prompt][input.specialEffect]
    negativePrompt = [input.negative || input.artStyle.negative || ""]
    resolution = [input.shape]
    guidanceScale = [Number(input.guidanceScale) || 7]
    seed = [input.seed === "" ? -1 : Number(input.seed)]
    upscale = [input.upscale === "true"]
    denoise = [Number(input.denoise) || 0.7]
    removeBackground = [input.removeBackground === "true"]
  
  
  
  
  
