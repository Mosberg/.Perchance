    userVariablesScratchpad
      type = paragraph
      remember = true
      parseVariables = true
      visible() => false
      
    description
      label = 📝 Description 
      tip = [t2i.defaultText.promptTip]
      type = paragraph
      remember = true
      width = min(750px, 100%)
      takesUpFullRow = true
      useVariables = true
      modifiers = [input.artStyle?.modifiers || null]
      modifierUpdates = event:description.input, event:artStyle.change
      enterKeyTriggersGeneration = true
      examples = [input.artStyle?.randomPrompt || ""]
      random = [input.artStyle?.randomPrompt || ""]

    negative
      label = 🚫 Anti-Description (optional) 
      tip = [t2i.defaultText.negativePromptTip]
      type = paragraph
      remember = true
      useVariables = true
      width = min(750px, 100%)
      takesUpFullRow = true
      examples = things you 𝗱𝗼𝗻'𝘁 want in the image
      visible() =>
        return Number(localStorage.generateClickCount) > 1;

    artStyle
      label = 🎨 Art Style
      type = select
      remember = true
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
          prompt = [input.description]
          negative = [input.negative || ""]
        meta:import
          from = {import:t2i-styles}
        MTG Card
          prompt = magic the gathering card, [input.description], incredible magic the gathering artwork
          negative = [input.negative || ""], low-quality, deformed, blurry, bad art
