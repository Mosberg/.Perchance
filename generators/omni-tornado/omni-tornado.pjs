      step = 0.5
      defaultValue = 7.5
      visible() =>
        if (!this._element) return true;
        return Number(localStorage.generateClickCount || 0) > 2;

    seed
      label = Seed
      type = text
      remember = true
      visible() =>
        if (!this._element) return true;
        return Number(localStorage.generateClickCount || 0) > 2;

    upscale
      label = Upscale
      type = select
      remember = true
      options
        No = false
        Yes = true
      visible() =>
        if (!this._element) return true;
        return Number(localStorage.generateClickCount || 0) > 3;

    denoise
      label = Denoise Strength
      type = number
      remember = true
      min = 0.1
      max = 1.0
      step = 0.05
      defaultValue = 0.7
      visible() =>
        if (!this._element) return true;
        return Number(localStorage.generateClickCount || 0) > 3;

    removeBackground
      label = Remove Background
      type = select
      remember = true
      options
        No = false
        Yes = true
      visible() =>
        if (!this._element) return true;
        return Number(localStorage.generateClickCount || 0) > 3;

    style
      label = 🎨 STYLE
      type = select
      remember = true
      defaultValue = 𝗡𝗼 𝘀𝘁𝘆𝗹𝗲
      options
        𝗡𝗼 𝘀𝘁𝘆𝗹𝗲 = {|}
        Grok Imagine Realistic = ultra-realistic portrait, high fidelity detail, natural skin texture, professional DSLR photography, Canon EOS R5, 50mm lens, f/1.8, balanced highlights, lifelike grounded mood, macro lens precision, ultra-sharp focus
        Grok Casual Photo = candid documentary style, real-life capture, authentic imperfections, minimal retouch, 35mm lens snapshot, unposed composition, soft ambient lighting, relatable everyday slice-of-life mood
        Grok Professional Photo = high-end editorial portrait, refined intricate detail, 85mm lens, f/1.4, Rembrandt lighting, controlled shadows, polished confident mood, shallow depth of field, elite subject isolation
        Grok Cinematic Realism = cinematic film still, anamorphic lens look, 35mm film grain, dramatic lighting, storytelling tone, narrative-driven tense emotional mood, atmospheric separations
        Grok Imagine Animated = universal anime artstyle, 2D illustration, clean linework, detailed hair flow, expressive features, dynamic silhouette, balanced composition, emotion-driven scene
        LEGO Movie = LEGO mini figure style character, modern cinematic LEGO movie aesthetic, stylized animated toy figure, smooth rounded ABS plastic material, glossy plastic surface with realistic reflections, expressive LEGO-inspired cartoon eyes, simplified facial design, high detail 3D animated movie render style, subtle micro-scratches on plastic, human skin tone color
        Genshin Impact = genshin impact style, masterpiece 3d anime render, cell-shaded aesthetic, flat shading, thick clean outlines, colorful anime palette, smooth skin texture, detailed anime eyes, vibrant magical atmosphere, soft global illumination, high-fidelity 3d cgi, fantasy character design, official art style
        Ghibli Studio = Studio Ghibli inspired, painterly backgrounds, warm natural palette, gentle hand-painted look, whimsical atmosphere, soft organic depth, calm cinematic mood
        Grand Theft Auto = Grand Theft Auto stylized realism, high-contrast game render, vibrant grounded colors, urban aesthetic, sharp character edges, modern open-world vibe, bold outlines
        Pixar 3D = Disney 3D render style, expressive features, soft stylized skin, warm rim highlights, subsurface scattering, colorful and inviting palette, clean 3D silhouette
        Unreal Engine 5 = Unreal Engine 5 AAA game character model render, ultra realistic plastic life like skin stylized game aesthetic, high-fidelity 3D CGI, photorealistic game graphics, next-gen visuals, ray-traced lighting, Lumen global illumination, advanced subsurface scattering, dynamic volumetric shadows, screen-space reflections, ultra-detailed PBR textures, intricate surface details, cinematic game engine look, sharp focus, maximum visual fidelity
        Cyberpunk Aesthetic = futuristic intricate details, neon lighting accents, glowing highlights, layered composition, dynamic perspective, high contrast, reflective surfaces
        Western Comics = classic comic book illustration, bold inked outlines, Ben-Day dots, cinematic dynamic poses, high-contrast shadows, graphic storytelling, vibrant primary colors
        Cartoon Network = modern 2D flat animation style, thick clean outlines, exaggerated expressions, solid vibrant colors, playful composition, minimalist background
        Classic Looney Tunes = vintage 1950s animation style, rubber hose limbs, expressive caricature, warm technicolor palette, hand-drawn cel animation texture
        Concept Art = professional digital illustration, detailed environment design, dynamic composition, atmospheric perspective, rich color story, mood-driven rendering
        Sketch & Pencil = hand-drawn pencil sketch, fine linework, cross-hatching texture, soft monochrome tones, expressive character outlines, natural graphite feel
        Ink & Line Art = clean inked line art, bold contours, smooth strokes, high contrast black and white, crisp silhouettes, clear visual hierarchy
        Watercolor = soft watercolor brush strokes, gentle gradient washes, muted palette, painterly texture, organic blending, dreamy soft focus

    furry
      label = 🐾 Furry Filter
      type = select
      remember = true
      options
        On
          meta:tags = [({furry:100, anthro:100, basicCartoon:30, cuteAnime:15})]
        Off
          meta:tags = [""]

