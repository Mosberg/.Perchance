generateImage = {import:text-to-image-plugin}
T2i = {import:text-to-image-plugin}
userCounter = {import:user-counter}
generatorStats = {import:generator-stats-plugin}
favicon = {import:favicon-plugin}
generateText = {import:ai-text-plugin}
commentsPlugin = {import:comments-plugin}
$meta
  title = Pergen
  description = A premium, Gemini-style AI platform for intelligent text conversations and instant, high-fidelity image generation
  tags = Glassmorphism, PremiumUI, Minimalist, CinematicAI
  image = https://user.uploads.dev/file/dea477bf83c89999de7cf6bfacaf351c.png
  header
    mode = minimal
    background =  #202124

v
  userPrompt =  Spain wins the cup 
  userStyle = cinematic
  userCamera = wide
  userCount = 1
  userScale = 7
  userSeed = 
  activeSeed = 
  finalPrompt = 
  selectedSize = 768x768

singleGen
  [T2i({ prompt: v.finalPrompt, guidanceScale: v.userScale * 1, resolution: v.selectedSize, seed: v.activeSeed })]

commentsOptions
  width = 100%
  height = 100%
  commentPlaceholderText = Share your words...
  submitButtonText = Post
  adminFlair = Catalyst
  deleteButtonIcon = ❌
  adminPasswordHash = 20ec1ec5e188ac1a459ebc0632de151db6476eb526db1163afbba4518fafd7dc
  messageBubbleStyle = background: rgba(44, 44, 46, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); color: #ffffff; padding: 12px 16px; border-radius: 18px 18px 18px 4px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14.5px; margin: 8px 0px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  messageFeedStyle = background: #1c1c1e; padding: 16px 12px; overflow-y: auto; position: relative; z-index: 2;
  inputAreaStyle = background: #2c2c2e; border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff; border-radius: 20px; padding: 12px 16px; font-size: 15px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; margin-top: 10px; margin-bottom: 10px; margin-left: 16px; width: calc(100% - 32px); box-sizing: border-box; outline: none; box-shadow: 0 0 0 500px #1c1c1e; position: relative; z-index: 1;
  submitButtonStyle = background: #0A84FF; border: none; color: #ffffff; padding: 12px 20px; border-radius: 20px; font-weight: 600; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; cursor: pointer; flex-grow: 1; margin-left: 16px; margin-right: 8px; margin-bottom: 16px; box-shadow: 0 4px 15px rgba(10, 132, 255, 0.3); position: relative; z-index: 2;
