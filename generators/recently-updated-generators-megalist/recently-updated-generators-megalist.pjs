  adminPasswordHash = 98a407adbe9b5f82e04743052c96700b32b41fbd0b086c1508e632538ed5c948
  slashCommands
    emoji
      output = {import:emoji} // when the user types '/emoji' it'll output a random emoji
    addemoji
      output = [this.input] {import:emoji} // when the user types '/addemoji blahblah' it'll output 'blahblah <emoji>'
    allcaps
      output = [this.input.upperCase] // the message '/allcaps hello' will output 'HELLO'
    count
      output = [num++] // `num` increases by 1 each time this is used
    mock
      output = [Array.from(this.input).map((char, i) => i % 2 == 0 ? char.toLowerCase() : char.toUpperCase()).join('')] // iT dOeS tHiS To tExT
    bold 
      output = [this.input.split("").map(char => boldChars[normalChars.indexOf(char)] || char).join("")] // whatever they write after '/bold' will be made bold
    gothic 
      output = [this.input.split("").map(char => gothicChars[normalChars.indexOf(char)] || char).join("")]
    format
      output = [formatText(this.input)] // in the message '/format **hello** how are *you*' the word 'hello' will be bold, and the word 'you' will be italic
