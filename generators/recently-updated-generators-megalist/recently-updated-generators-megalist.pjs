commentOptions
  width = 100%
  height = 100%
  commentPlaceholderText = Advertise gens. Suggestion time. Mention particualry good gens you visited. Gen ideas. + - Comments.
  submitButtonText = Submit
  inputAreaStyle = background:linear-gradient(90deg, rgba(170, 110, 110, 0.2) 0%, rgba(170, 140, 110, 0.2) 12%, rgba(170, 170, 110, 0.2) 27%, rgba(110, 170, 110, 0.2) 40%, rgba(110, 170, 170, 0.2) 55%, rgba(110, 140, 170, 0.2) 69%, rgba(170, 110, 160, 0.2) 86%, rgba(170, 110, 110, 0.2) 100%); color:white; text-shadow:1px 1px 3px rgba(0,0,0,0.2);
  messageBubbleStyle = background:linear-gradient(90deg, rgba(170, 110, 110, 0.2) 0%, rgba(170, 140, 110, 0.2) 12%, rgba(170, 170, 110, 0.2) 27%, rgba(110, 170, 110, 0.2) 40%, rgba(110, 170, 170, 0.2) 55%, rgba(110, 140, 170, 0.2) 69%, rgba(170, 110, 160, 0.2) 86%, rgba(170, 110, 110, 0.2) 100%); border:2px groove darkgray; color:white; text-shadow:1px 1px 3px rgba(0,0,0,0.2);
  submitButtonStyle = background:linear-gradient(90deg, rgba(170, 110, 110, 0.3) 0%, rgba(170, 140, 110, 0.2) 12%, rgba(170, 170, 110, 0.2) 27%, rgba(110, 170, 110, 0.2) 40%, rgba(110, 170, 170, 0.2) 55%, rgba(110, 140, 170, 0.2) 69%, rgba(170, 110, 160, 0.2) 86%, rgba(170, 110, 110, 0.3) 100%); border:groove black; color:white; text-shadow:1px 1px 3px rgba(0,0,0,0.2);
  messageFeedStyle = background:linear-gradient(90deg, rgba(170, 110, 110, 0.4) 0%, rgba(170, 140, 110, 0.2) 12%, rgba(170, 170, 110, 0.2) 27%, rgba(110, 170, 110, 0.2) 40%, rgba(110, 170, 170, 0.2) 55%, rgba(110, 140, 170, 0.2) 69%, rgba(170, 110, 160, 0.2) 86%, rgba(170, 110, 110, 0.3) 100%); border:groove black; color:white; text-shadow:1px 1px 3px rgba(0,0,0,0.2);
