$meta
  title = Realistic Engine Simulator
  description = A real-time internal combustion engine simulator with animated cutaway, torque curves, thermals, fuel consumption, multiple engine types, and a 6-speed gearbox.
  tags = engine, simulator, car, physics, realistic, cutaway

commentsPlugin = {import:comments-plugin}

// ── Engine presets (selectable at runtime) ──
engines
  i3
    name = Inline-3
    layout = inline
    cylinders = 3
    displacement = 1000
    idleRpm = 850
    redline = 7000
    revLimiter = 7300
    maxPower = 120
    peakPowerRpm = 5500
    maxTorque = 170
    peakTorqueRpm = 2000
    flywheelInertia = 0.18
    engineBraking = 0.12
    desc = Turbo 3-cyl — eager and buzzy
  i4
    name = Inline-4
    layout = inline
    cylinders = 4
    displacement = 2000
    idleRpm = 800
    redline = 7200
    revLimiter = 7500
    maxPower = 180
    peakPowerRpm = 6500
    maxTorque = 200
    peakTorqueRpm = 4000
    flywheelInertia = 0.25
    engineBraking = 0.15
    desc = 2.0L — balanced and versatile
  i6
    name = Inline-6
    layout = inline
    cylinders = 6
    displacement = 3000
    idleRpm = 700
    redline = 7000
    revLimiter = 7300
    maxPower = 250
    peakPowerRpm = 6000
    maxTorque = 350
    peakTorqueRpm = 3500
    flywheelInertia = 0.32
    engineBraking = 0.14
    desc = 3.0L straight-six — turbine-smooth
  v6
    name = V6
    layout = v
    vAngle = 60
    cylinders = 6
    displacement = 3500
    idleRpm = 700
    redline = 6800
    revLimiter = 7100
    maxPower = 280
    peakPowerRpm = 6200
    maxTorque = 350
    peakTorqueRpm = 3500
    flywheelInertia = 0.30
    engineBraking = 0.16
    desc = 3.5L — compact and punchy
  v8
    name = V8
    layout = v
    vAngle = 90
    cylinders = 8
    displacement = 5000
    idleRpm = 650
    redline = 6500
    revLimiter = 6800
    maxPower = 400
    peakPowerRpm = 5800
    maxTorque = 500
    peakTorqueRpm = 4000
    flywheelInertia = 0.38
    engineBraking = 0.20
    desc = 5.0L — deep burble, immense torque
  v10
    name = V10
    layout = v
    vAngle = 90
    cylinders = 10
    displacement = 5200
    idleRpm = 900
    redline = 8500
    revLimiter = 8800
    maxPower = 560
    peakPowerRpm = 8000
    maxTorque = 540
    peakTorqueRpm = 6500
    flywheelInertia = 0.35
    engineBraking = 0.18
    desc = 5.2L — screaming exotic
  v12
    name = V12
    layout = v
    vAngle = 60
    cylinders = 12
    displacement = 6000
    idleRpm = 700
    redline = 8000
    revLimiter = 8300
    maxPower = 650
    peakPowerRpm = 7250
    maxTorque = 700
    peakTorqueRpm = 5000
    flywheelInertia = 0.42
    engineBraking = 0.15
    desc = 6.0L — effortless, silent power
  flat4
    name = Flat-4
    layout = flat
    cylinders = 4
    displacement = 2400
    idleRpm = 750
    redline = 6800
    revLimiter = 7100
    maxPower = 170
    peakPowerRpm = 6000
    maxTorque = 235
    peakTorqueRpm = 4000
    flywheelInertia = 0.22
    engineBraking = 0.14
    desc = 2.4L boxer — low CG, distinctive rumble
  flat6
    name = Flat-6
    layout = flat
    cylinders = 6
    displacement = 3800
    idleRpm = 750
    redline = 7500
    revLimiter = 7800
    maxPower = 350
    peakPowerRpm = 6800
    maxTorque = 420
    peakTorqueRpm = 5000
    flywheelInertia = 0.28
    engineBraking = 0.15
    desc = 3.8L — iconic rear-engine character
  rotary
    name = Rotary
    layout = rotary
    rotors = 2
    cylinders = 4
    displacement = 1300
    idleRpm = 900
    redline = 9000
    revLimiter = 9500
    maxPower = 230
    peakPowerRpm = 8200
    maxTorque = 211
    peakTorqueRpm = 5500
    flywheelInertia = 0.15
    engineBraking = 0.10
    desc = 1.3L Wankel — revs like a turbine

// Shared engine parameters (constant across engines)
engineShared
  idleFuelRate = 0.3
  maxFuelRate = 12.0
  thermostatTemp = 90
  maxTemp = 120
  oilCapacity = 4.5
  fuelTank = 50

// Drivetrain (constant across engines)
drivetrain
  finalDrive = 4.1
  wheelRadius = 0.32
  dragCoeff = 0.35
  frontalArea = 2.2
  vehicleMass = 1300
  rollingResistance = 0.013

gears
  reverse = 3.4
  neutral = 0
  first = 3.6
  second = 2.1
  third = 1.4
  fourth = 1.0
  fifth = 0.8
  sixth = 0.65
