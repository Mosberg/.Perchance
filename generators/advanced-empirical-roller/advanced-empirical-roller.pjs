// --- APP STATE VARIABLES ---
dieType = d20
lastResult = 0

// --- THE DICE ENGINE ---
// This handles the math and safely creates the history array in JavaScript
doRoll(type) =>
  // Safely initialize the history array and input variables if they don't exist yet
  if(typeof window.diceHistory == "undefined") window.diceHistory = [];
  if(typeof window.totalRollCount == "undefined") window.totalRollCount = 0;
  if(typeof window.numDice == "undefined") window.numDice = 1;
  if(typeof window.modifier == "undefined") window.modifier = 0;

  let count = Math.max(1, parseInt(window.numDice) || 1);
  let mod = parseInt(window.modifier) || 0;
  
  root.dieType = type;
  let sum = 0;
  let individualRolls = [];
  
  // Loop through the selected die X times
  for(let i = 0; i < count; i++) {
    let val = Number(root[type].selectOne);
    sum += val;
    individualRolls.push(val);
  }
  
  // Calculate final math
  let total = sum + mod;
  root.lastResult = total;
  
  // Format the history string
  let sign = mod > 0 ? "+" : "-";
  let modStr = mod !== 0 ? (mod > 0 ? "+" + mod : mod) : "";
  let rollStr = `${count}${type}${modStr}`;
  
  // Create the "3 + 2 + 4" string, and append the modifier if it exists
  let rollDetails = individualRolls.join(' + ');
  if (mod !== 0) {
    rollDetails += ` ${sign} ${Math.abs(mod)}`;
  }
  
  // Increment the global roll count
  window.totalRollCount++;
  
  // Piece the entry together exactly as requested, keeping the total orange
  let entry = `<div style="margin-bottom:6px;"><span style="color:#aaa; font-size:0.9em;">${window.totalRollCount}. (${rollStr})</span> <span style="color:#888; font-size:0.9em;">${rollDetails} = </span><span style="color:#f39c12; font-weight:bold; font-size:1.1em;">${total}</span></div>`;
  
  // Add to top of history, cap the list at 10 items to prevent lag
  window.diceHistory.unshift(entry);
  if(window.diceHistory.length > 10) window.diceHistory.pop();
  
  return total;

// Helper to output the array to HTML safely
displayHistory
  [typeof window.diceHistory != "undefined" && window.diceHistory.length > 0 ? window.diceHistory.join("") : "<div style='color:#666'>No rolls yet...</div>"]


