// Neolithic city builder — config & flavor data

generateText = {import:ai-text-plugin}

$meta
  title = Neolithic City Builder
  description = Build a stone-age settlement: farm, forage, quarry, and grow your tribe across the seasons.
  tags = game, strategy, city-builder, neolithic, emoji

// ---- Random event flavor (drawn by index.html's event system) ----
eventGood
  A bountiful harvest! 🌾 The tribe rejoices.
  Hunters return with deer 🦌 — extra food for all.
  A wandering family joins your settlement. 👨‍👩‍👧
  Clay deposits found near the river. 🏺 +stone
  Warm rains bless the crops. 🌦️
  An elder shares wisdom of the stars. ✨ +happiness
  A glittering amber vein is discovered in the hills. 🟡 +amber
  Bees swarm to a new hive — surplus honey! 🍯 +honey
  A trading caravan gifts you shells and pearls. 🐚 +shell
  Pitch seeps from a natural tar spring. 🟤 +pitch
  A child finds a cache of ochre in the riverbed. 🟠 +ochre
  Stags shed antlers across the forest — free materials! 🦌 +antler
  A bark harvest festival yields medicine and tannin. 🌳 +bark
  Trappers bring a bounty of pelts. 🟤 +pelt
  A sacred spring bubbles up with tannin-rich water. 🌰 +tannin
  The watchtower sentinel spots a wolf pack — raid prevented! 🗼 +food +hides
  Hunters drive off wolves and claim the spoils. 🐺 +hides +food
  A wild flax field is discovered — free fibres! 🌱 +flax
  A nomadic shepherd gifts you a woolly ram. 🐑 +wool
  Mushroom pickers return with baskets of food. 🍄 +food
  A fennel patch sprouts wild near the river. 🌿 +herbs
  Travelling bards share songs of the old world. 🎵 +knowledge +happiness
  A beekeeper's apprentice joins the village. 🐝 +wax
  A friendly clan donates salt for the winter. 🧂 +salt
  Hot springs are found — the tribe bathes in warmth. ♨️ +happiness
  A wandering horse-tamer brings a foal. 🐴 +happiness +food
  A vagabond storyteller tells tales of distant copper hills. ⛰️ +knowledge
  A grain merchant samples your wheat and pays well. 🌾 +gold
  A mead-taster praises your brew and spreads the word. 🍯 +gold
  A herbalist discovers a new healing root. 🌿 +herbs +knowledge
  Hunters drive wolves from the antler grounds — the sheds are saved! 🦌 +antler
  The watchtower's alarm scares wolves from the pasture — the prize ewe is safe! 🐑 +wool
  Divers rotate the shell beds, staving off depletion. 🐚 +shell
  Quick-thinking pitch-burners smother a fire before it catches. 🫕 +pitch
  Resin traps catch bark beetles before they infest the stores. 🪲 +bark
  The tannin bund holds fast against a bursting vat. 🌰 +tannin
  Herb sachets keep weevils from the grain stores. 🐛 +food
  The mead cellar's cool stays a souring batch. 🍶 +mead
  The assayer spots false copper ore before it's stockpiled. 🔬 +copper
  The tin vault's locks foil night-time thieves. 🔒 +tin
  The bridge crew repairs a fraying rope just in time. 🪢 +rope
  The drainage channel diverts floodwater from the gardens. 💧 +vegetables

eventBad
  Drought withers the crops. 🏜️ -food
  Wolves raid the stores. 🐺 -food
  A sickness spreads through the huts. 🤒 -population
  A harsh frost kills the harvest. ❄️ -food
  Raiders steal tools and stone. ⚔️ -stone
  Floods damage a hut. 🌊 -wood
  A landslide buries an amber mine. 💠 -amber
  Hornets destroy an apiary. 🐝 -honey -wax
  Shell beds are depleted by overharvesting. 🐚 -shell
  A pitch fire burns the workshop. 🫕 -pitch
  A flood washes away ochre stores. 🎨 -ochre
  Wolves scatter the shed antlers. 🦌 -antler
  Bark beetles infest the bark stores. 🪲 -bark
  Moths ruin the pelt cache. 🦋 -pelt
  A tannin vat spills into the river. 🌰 -tannin
  A flax crop fails to blight. 🌱 -flax
  Wolves kill a prize ewe. 🐑 -wool
  Frost destroys the mushroom beds. 🍄 -food
  Weevils spoil the grain stores. 🐛 -food
  A mead batch sours and must be dumped. 🍺 -ale
  Copper ore turns out to be worthless rock. 🟠 -copper
  Tin thieves raid the mine under cover of night. ⚪ -tin
  A rope bridge collapses into the gorge. 🪢 -rope
  Flooding ruins the vegetable garden. 🥬 -vegetables

eventNeutral
  Travelers barter furs for grain. 🫎
  Children play by the river. 🛶
  The shaman reads omens in the smoke. 🔥
  A new potter joins the village. 🏺
  Strange lights dance in the northern sky. 🌌
  An amber trader passes through, admiring your gems. 🟡
  Divers surface with shells and stories of the deep. 🤿
  The pitch-burners hum work-songs by the kiln. 🎶
  A wandering ochre-painter offers to decorate the huts. 🎨
  Antler-carvers exchange techniques with visiting craftsmen. 🦌
  Bark collectors trade gossip at the forest's edge. 🌳
  Pelt-curers argue over the best tanning method. 🟤
  A tannin-boiler claims to have found a new bark recipe. 🌰
  Shell-divers watch the moonrise over the water. 🌙
  A child strings amber beads into a necklace. 💎
  A wandering shepherd seeks shelter for the night. 🐑
  A travelling bard sings of copper mountains. ⛰️
  Mushroom gatherers swap recipes with the cooks. 🍄
  A fennel farmer shares cuttings with the village. 🌿
  A flax-weaver demonstrates a new loom pattern. 🧵
  A rope-maker splices strands for the bridge crew. 🪢
  A mead-taster debates brewing techniques. 🍺
  Children chase fireflies through the meadow. 🌟
  A vagabond clay-shaper offers to mend broken pots. 🏺
  An old hunter tells tales of the great stag. 🦌

// ---- Season names ----
season
  🌸 Spring
  ☀️ Summer
  🍂 Autumn
  ❄️ Winter

// ---- Terrain tile types (weighted for map generation) ----
terrainWeight
  grass^3
  forest^2
  rock
  water
  fertile^2

// ---- Building catalog (consumed by index.html) ----
building
  housing
    hut
      name = 🛖 Hut
      cost = wood:10,stone:2
      desc = Houses +4 population.
  food
    farm
      name = 🌾 Farm
      cost = wood:5,stone:0
      desc = +3 food/turn. Best on fertile soil.
    pasture
      name = 🐑 Pasture
      cost = wood:6,stone:2
      desc = +2 food/turn, +1 happiness.
    storage
      name = 🏺 Granary
      cost = wood:12,stone:4
      desc = +30 food storage & +2 food/turn.
  water
    well
      name = 💧 Well
      cost = wood:6,stone:4
      desc = +3 water/turn. Prevents drought.
    aqueduct
      name = 🏛️ Aqueduct
      cost = wood:8,stone:6
      desc = +5 water/turn. Must be on water.
    cistern
      name = 🛢️ Cistern
      cost = wood:4,stone:8
      desc = +20 max water, +1 water/turn.
  production
    lumber
      name = 🪵 Logging Camp
      cost = wood:3,stone:3
      desc = +3 wood/turn. Must be on forest.
    quarry
      name = ⛏️ Quarry
      cost = wood:8,stone:0
      desc = +3 stone/turn. Must be on rock.
    claypit
      name = 🧱 Clay Pit
      cost = wood:6,stone:2
      desc = +3 clay/turn. Must be on water.
    hunt
      name = 🏹 Hunting Lodge
      cost = wood:5,stone:1
      desc = +2 hides, +1 food/turn. Must be on forest.
  defense
    watchtower
      name = 🗼 Watchtower
      cost = wood:8,stone:2
      desc = Prevents wolf raids. +1 happiness.
    apothecary
      name = 🌿 Apothecary
      cost = wood:5,stone:5
      desc = Prevents sickness. +1 happiness.
    smokehouse
      name = 🍖 Smokehouse
      cost = wood:6,stone:3
      desc = Prevents harsh frost. +1 food, +5 max food.
    palisade
      name = 🛡️ Palisade
      cost = wood:10,stone:0
      desc = Prevents raider attacks. +1 happiness.
    levee
      name = 🏞️ Levee
      cost = wood:4,stone:6
      desc = Prevents floods. +1 happiness.
  culture
    shrine
      name = 🔥 Shrine
      cost = wood:5,stone:8
      desc = +2 happiness. Center of ritual life.
  monument
    stonecircle
      name = 🗿 Stone Circle
      cost = wood:15,stone:25
      desc = Monument. +5 happiness, +2 knowledge/turn.
    megalith
      name = 🏯 Megalith
      cost = wood:12,stone:30
      desc = Monument. +3 happiness, +10 max food & water.
    totem
      name = 🎎 Totem Pole
      cost = wood:20,stone:10
    desc = Monument. +4 happiness, +2 pop cap.

// ---- Techs (research with knowledge) ----
tech
  pottery
    name = 🏺 Pottery
    cost = 3
    desc = +20 max food, +20 max water.
  agriculture
    name = 🌱 Agriculture
    cost = 5
    desc = Farms +2 food/turn.
  tools
    name = 🪓 Toolmaking
    cost = 5
    desc = Logging +2 wood, Quarry +2 stone.
  husbandry
    name = 🐂 Animal Husbandry
    cost = 6
    desc = Pastures +2 food, +1 happy.
  irrigation
    name = 🚿 Irrigation
    cost = 6
    desc = Wells +2 water, Aqueducts +2 water.
  masonry
    name = 🧱 Masonry
    cost = 8
    desc = Huts +2 pop cap each.
  medicine
    name = ⚗️ Medicine
    cost = 8
    desc = Apothecary +2 happy, global +1 happy.
  writing
    name = 📜 Writing
    cost = 10
    desc = +2 knowledge/turn from shrines.
