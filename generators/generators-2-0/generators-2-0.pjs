pride = {import:pride-plugin}
hubData = {import:hub-external-card}
PerFavIcon = {import:per-favicon-plugin}
diceLoader = {import:dice-loader-plugin}

$meta
  title = Perchance Generators _PRIDE HUB 2.0_
  description = PRIDE HUB 2.0 is the next generation of Perchance.org generators. Experience a smoother, more dynamic hub with animated, auto-updating generators, live search, and a customizable UI. Find your next favorite generator, reimagined.
  image = https://user.uploads.dev/file/57d00b0b676b48f8da7d3163f39cc2cd.gif
  tags = perchance, perchance.org, generator, generators, text generator, random generator, animated, auto update, live search, customizable, settings, UI, user interface, hub, 2.0, perchance hub, perchance generators hub, perchance community, PRIDE HUB 2.0, Brainiac-Goat-Dev
  header
    background = ghostwhite
    mode = minimal

// I'm Brainiac-Goat-Dev, the creator of this generator to know more about me, click on the info icon.
// Here's the code for the comments section.
// If you want a similar comment section on your generator,
// then copy this code, and the "comments section" code in the
// HTML editor (bottom-right panel).
PCP = {import:public-comment-plugin}
commentOptions
  width = 100%
  height = 400px
  accentColor = #6366f1
  backgroundColor = #ffffff
  textColor = #0f172a
  headerColor = #f8fafc
  borderColor = #e2e8f0
  borderRadius = 12px
  placeholder = Add a friendly comment.
  sendButtonText = Submit

// Every page on perchance is a "generator", even this one!
// But since there's no need for random stuff on this page
// (it's just a list of recently updated generators), most
// of the code for this page is in the HTML panel (the
// bottom-right text editor).
  