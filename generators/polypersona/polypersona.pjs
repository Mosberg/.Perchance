$meta
  title = PolyPersona
  description =  YOUR PERSONAS. YOUR CONVERSATIONS. NO LIMITS
  image = https://user.uploads.dev/file/fd9a99a3e899fd0682203c6886c99534.png

loadDependencies = {import:ai-character-chat-dependencies-v1}
aiTextPlugin = {import:ai-text-plugin}
textToImagePlugin = {import:text-to-image-plugin}

commentsPlugin = {import:comments-plugin}

commentOptions
  channel = polypersona
  width = 100%
  height = 400
  commentPlaceholderText = Add a friendly comment.
  adminPasswordHash = 93b469a73f2e65e2dbb743446f723d942b1fe475d88c314c52497606e09a4a7b
  adminFlair = 💎Admin💎
  deleteButtonIcon = ❌
  rateLimits = 1 per minute, 3 per 10 minutes