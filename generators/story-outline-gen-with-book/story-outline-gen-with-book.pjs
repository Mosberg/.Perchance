kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}

$meta
  title = AI Story Outline & Book Generator
  description = Generate detailed story outlines with AI, then build full books chapter by chapter with continuity-aware generation. Choose genres, writing styles, tone, and more.
  tags = story, writing, ai, outline, book, fiction, novel, generator

// Max chapters whose full text is sent as context when generating a new chapter.
// Older chapters contribute only their hidden summaries. This prevents context
// bloat in long books while preserving continuity.
maxFullTextContextChapters = 2
