generateText = {import:ai-text-plugin}
BustersommentsPlugin = {import:comments-plugin}

 
$meta
  description=Better than Warrior Cats!
  
  
fullscreenButton = {import:fullscreen-button-plugin}
tornado = {import:tornado-plugin}
background = {import:background-image-plugin}
pageSubtitle =[Splashtext]
fontSize = 131
fontColor = black
textAlignment = middle
buttonText = Take a chance!
numberOfItems = 1
itemSeparator = <br>


pageDescription
  This is still a heavy work in progress!
