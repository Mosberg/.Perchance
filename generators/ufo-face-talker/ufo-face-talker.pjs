$meta
  title = Face Talker
  description = Upload image with face, Select mouth shape, Add text, Makes face talk text, Save video.🤯View code! 3 versions.
  tags = talking photo. text to talking image, image face talker.
  image = https://user.uploads.dev/file/ba7449242d891efa1c5de35038482436.jpg //https://user.uploads.dev/file/35318980140aa736ba1c5d1388bb3dea.webm 

