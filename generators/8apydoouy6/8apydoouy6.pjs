generateText = {import:ai-text-plugin}
createServerSocket = {import:server-plugin}

// Used the rare word generator as a preset for this

title = Random Superpower Generator
subtitle = Simply generates a random super-power at each click :)
fontSize = 200
fontColor = black
buttonText = randomize
numberOfItems = 1
itemSeperator = <br/>
description
	{import:simple-gen-footer}
	$output = <p>[this.joinItems("</p><p>")]</p> // <-- don't remove this last line, it uses the special "$output" property to join and format your description as HTML paragraphs :)


$output = [power]
output = [w=power.selectOne]<p style\="opacity:0.5;font-size:60%;margin:0;">([w.def])</p>

weakness
  bright sunlight
  salt water
  loud music
  physical contact with rubber
  being seen eating
  compliments
  the smell of lavender
  running out of snacks
  mirrors
  sincere apologies
  wet socks
  small dogs
  the color yellow
  being ignored
  tight spaces
  crowds
  silence
  caffeine
  promise-keeping
  their own reflection

personality
  hot-headed rival who respects strength above all
  cheerful airhead who fights on instinct
  cold strategist who treats people like chess pieces
  lazy genius who only tries when bored
  anxious overthinker who apologizes mid-fight
  smug prodigy with a soft spot for underdogs
  stoic loner secretly desperate for friends
  chaotic gremlin who fights for entertainment
  kind healer forced onto the battlefield
  vengeance-obsessed edgelord with a tragic past
  honor-bound knight type who refuses cheap shots
  fraud who faked their way to power and is panicking
  sleepy dreamer who barely notices the danger
  showboating narcissist who poses mid-combat
  reluctant hero who just wants a normal life

archetype
  shonen protagonist
  rival/antagonist
  mysterious mentor
  comic relief sidekick
  redeemed villain
  tragic antihero
  tournament arc wild card
  slice-of-life transfer student
  final boss
  childhood friend with a secret

setting
  a cram school at midnight
  a floating arena above the city
  a haunted shrine in the mountains
  a high-stakes cooking competition
  a train that never stops
  a dimension made of folded paper
  the rooftop where rivals always meet
  an abandoned arcade
  a beach episode gone wrong
  the student council's underground bunker

animalSidekick
  a one-eyed crow that steals shiny loose change
  a fat toad that belches smoke rings when nervous
  a three-legged cat that can sense lies
  a tiny bat that whispers gossip it overhears
  a glowing moth that only appears at midnight
  a grumpy hedgehog that curls up and bounces like a ball
  a spectral ferret that can phase through walls
  a deceptively wise goldfish in a sealed bubble
  a pigeon that delivers letters to the wrong people
  a miniature turtle whose shell glows in the dark
  a scarab beetle that clicks before danger arrives
  a ragged-eared rabbit that eats important documents
  a baby owl that refuses to sleep at night
  a jellyfish that floats in the air and stings enemies
  a loyal lizard that can regrow its tail repeatedly

// Credit goes to: https://powerlisting.fandom.com/wiki/List_of_Supernatural_Powers_and_Abilities

obj = {import:object}

power
  Affinity
    def = The power to gain strength from something, or when a certain event occurs.
  
  {|[obj.titleCase] }Aversion
    def = The circumstance or negative quality in which the user has a supernatural weakness when in contact with a certain object, occurring event, or emotion.
  
  Power Absorption
    def = The power to absorb or steal powers from others.
  
  Power Augmentation
    def = The ability to enhance the powers of oneself and/or others.
  
  Power Bestowal
    def = The ability to bestow powers upon another.
  
  Power Detection
    def = The power to sense the presence of supernatural powers within others.
  
  Power Erasure
    def = The ability to eliminate the powers of others.
  
  Power Negation
    def = The power to nullify powers/abilities.
  
  Power Randomization
    def = The ability to have any random powers at any time.
  
  Power Replication
    def = The power to replicate the powers of others.
  
  Power Restoration
    def = The ability to restore lost powers.
  
  Powers Via {Object|[obj.titleCase]}
    def = The ability to obtain supernatural powers through objects.
  
  Superpower Manipulation
    def = The power to manipulate superpowers.
  
  Accelerated Rotation
