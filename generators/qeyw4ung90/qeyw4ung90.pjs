difficultyConfig
  easy
    name = Easy
    money = 25
    stats = 7
    suspicionDecay = 12
    eventChance = 0.15
    desc = Comfortable start. More cash, higher stats, calmer prison.
  normal
    name = Normal
    money = 15
    stats = 5
    suspicionDecay = 8
    eventChance = 0.2
    desc = Balanced experience. The intended way to play.
  hard
    name = Hard
    money = 8
    stats = 3
    suspicionDecay = 5
    eventChance = 0.28
    desc = Brutal. Low resources, aggressive guards, frequent events.

location
  cell
    name = Cell Block
    desc = Your home base. Store contraband, rest, and craft in secret.
    activities = rest, craft, stash, workout, study, sleep
    risk = 0
  yard
    name = Yard
    desc = Open air. Train, trade, and gather intel.
    activities = workout, trade, gamble, fight, recon, socialize
    risk = 1
  cafeteria
    name = Cafeteria
    desc = Crowded and noisy. Good for picking pockets and trading.
    activities = trade, steal, eat, socialize, quest
    risk = 2
  workshop
    name = Workshop
    desc = Tools and materials. High contraband yield, high risk.
    activities = craft, scavenge, workJob
    risk = 3
  library
    name = Library
    desc = Quiet. Study books, plan escapes, reduce suspicion.
    activities = study, plan, mapStudy, quest
    risk = 0
  infirmary
    name = Infirmary
    desc = Restock meds, heal up, or swipe supplies.
    activities = heal, steal
    risk = 2
  showers
    name = Showers
    desc = Slippery and dangerous. Smuggle routes run through here.
    activities = shower, recon
    risk = 2
  laundry
    name = Laundry Room
    desc = Smuggle yourself out in a cart. Key escape route.
    activities = recon, stash, plan, quest
    risk = 2
  sewers
    name = Sewers
    desc = Dark tunnels beneath the prison. Escape path if you dig.
    activities = dig, recon
    risk = 3
    locked = true
  perimeter
    name = Perimeter
    desc = The outer wall. Guard towers and razor wire.
    activities = recon, escape
    risk = 4
    locked = true

