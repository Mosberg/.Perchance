events
  shakedown
    name = Shakedown!
    desc = Guards raid cells. Contraband found without a pouch is confiscated.
    type = bad
  fight
    name = Yard Fight
    desc = An inmate challenges you. Fight or back down.
    type = choice
  findStash
    name = Hidden Stash
    desc = You find materials hidden behind a loose tile.
    type = good
  snitch
    name = The Snitch
    desc = Someone's talking to the guards. Suspicion rises.
    type = bad
  contraband
    name = Contraband Deal
    desc = An inmate offers cheap materials.
    type = choice
  favor
    name = Favor Asked
    desc = Help an inmate for reputation, or refuse.
    type = choice
  lockdown
    name = Lockdown
    desc = The prison locks down. Lose a phase.
    type = bad
  gift
    name = Care Package
    desc = A gift arrives. Gain some cash and materials.
    type = good
  allyOffer
    name = Ally Approach
    desc = An inmate offers to join your crew.
    type = choice
  inspection
    name = Surprise Inspection
    desc = A guard inspects your current location. High suspicion means trouble.
    type = bad
  freeTime
    name = Unexpected Break
    desc = Guards are distracted. Suspicion drops sharply.
    type = good

