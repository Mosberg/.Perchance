craftedItems
  shovel
    name = Makeshift Shovel
    type = tool
    value = 20
    recipe = spoon, spoon, tape, metal
    desc = Digs through walls. Required for tunnel escapes.
  rope
    name = Sheet Rope
    type = tool
    value = 15
    recipe = sheet, sheet, sheet, sheet
    desc = Climb down walls. Required for perimeter escapes.
  lockpick
    name = Lockpick
    type = tool
    value = 18
    recipe = wire, metal, tape
    desc = Opens doors silently. -30% suspicion when moving.
  shiv
    name = Shiv
    type = weapon
    value = 12
    recipe = toothbrush, tape, metal
    desc = Self-defense. +15 fight strength.
  lighter
    name = Lighter
    type = tool
    value = 10
    recipe = battery, wire
    desc = Creates distractions. Usable once per day to cut suspicion.
  dummy
    name = Bed Dummy
    type = tool
    value = 14
    recipe = pillowcase, sheet, rag
    desc = Fools guards at night. Halves night shakedown chance.
  taser
    name = Stun Taser
    type = weapon
    value = 35
    recipe = battery, battery, wire, tape, metal
    desc = Incapacitates foes. +25 fight strength. Requires Engineer.
  smokebomb
    name = Smoke Bomb
    type = tool
    value = 22
    recipe = battery, rag, tape, magazine
    desc = Cover for escapes. +10% escape success chance.
  pouch
    name = Contraband Pouch
    type = tool
    value = 16
    recipe = pillowcase, tape, button
    desc = Hides items from shakedowns. Protects your stash.
  uniform
    name = Guard Uniform
    type = tool
    value = 50
    recipe = sheet, sheet, button, button, tape
    desc = Disguise. Required for helicopter extraction. Requires Engineer.

