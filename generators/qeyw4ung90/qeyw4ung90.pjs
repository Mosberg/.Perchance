skillTree
  combat
    name = Combat
    color = #e74c3c
    ironFist
      name = Iron Fist
      desc = +20% fight strength
      cost = 1
      branch = combat
    brawler
      name = Brawler
      desc = Win fights with less damage taken
      cost = 2
      branch = combat
      req = ironFist
    intimidator
      name = Intimidator
      desc = +Reputation from fights
      cost = 2
      branch = combat
      req = brawler
  stealth
    name = Stealth
    color = #9b59b6
    lightSteps
      name = Light Steps
      desc = -25% suspicion from actions
      cost = 1
      branch = stealth
    pickpocket
      name = Pickpocket
      desc = Steal succeeds more often
      cost = 1
      branch = stealth
      req = lightSteps
    shadow
      name = Shadow
      desc = Move at night without raising suspicion
      cost = 3
      branch = stealth
      req = pickpocket
  crafting
    name = Crafting
    color = #f39c12
    handyman
      name = Handyman
      desc = +1 bonus material when scavenging
      cost = 1
      branch = crafting
    engineer
      name = Engineer
      desc = Craft advanced items (taser, uniform)
      cost = 2
      branch = crafting
      req = handyman
    masterCrafter
      name = Master Crafter
      desc = Craft with 1 fewer material
      cost = 3
      branch = crafting
      req = engineer
  social
    name = Social
    color = #27ae60
    connected
      name = Connected
      desc = Better trade deals
      cost = 1
      branch = social
    broker
      name = Broker
      desc = Unlock rare materials in shop
      cost = 2
      branch = social
      req = connected
    kingpin
      name = Kingpin
      desc = +30% pay from all jobs
      cost = 3
      branch = social
      req = broker

escapePlans
  tunnel
    name = Tunnel Escape
    desc = Dig through the sewers to freedom. Requires a shovel and patience.
    needs = shovel
    statCheck = strength
    statReq = 35
    timePhases = 3
    suspicion = 30
  perimeter
    name = Perimeter Breach
    desc = Scale the wall with rope. Dangerous but fast.
    needs = rope
    statCheck = strength
    statReq = 45
    timePhases = 2
    suspicion = 40
  laundry
    name = Laundry Smuggle
    desc = Hide in a laundry cart and roll out the gate.
    needs = dummy
    statCheck = stealth
    statReq = 40
    timePhases = 1
    suspicion = 20
  riot
    name = Prison Riot
    desc = Spark a riot and escape in the chaos. Needs muscle and a shiv.
    needs = shiv
    statCheck = reputation
    statReq = 50
    timePhases = 2
    suspicion = 50
  helicopter
    name = Helicopter Extraction
    desc = A contact lands a chopper in the yard. Needs a guard uniform and cash.
    needs = uniform
    statCheck = charisma
    statReq = 55
    timePhases = 1
    suspicion = 35
    cost = 200

companions
  rat
    name = Ratty
    role = Smuggler
    desc = Knows every hidden corner. +1 material when scavenging, trade prices -15%.
    reqStat = charisma
    reqVal = 15
    perk = scavengeBonus
  brick
    name = Brick
    role = Bruiser
    desc = Tough as nails. +18 fight strength, take less damage in fights.
    reqStat = reputation
    reqVal = 20
    perk = combatBonus
  ghost
    name = Ghost
    role = Infiltrator
    desc = Moves like a shadow. -20% suspicion from all actions.
    reqStat = stealth
    reqVal = 25
    perk = stealthBonus
  doc
    name = Doc
    role = Medic
    desc = Former field medic. Heal +60% more, medical costs halved.
    reqStat = intelligence
    reqVal = 20
    perk = healBonus
  wrench
    name = Wrench
    role = Engineer
    desc = Can build anything. Crafting requires 1 fewer material (stacks with MasterCrafter).
    reqStat = intelligence
    reqVal = 35
    perk = craftBonus

questTemplates
  deliver
    name = Package Delivery
    desc = Deliver a %item% to an inmate in the %location%.
    rewardType = money
  craft
    name = Crafting Request
    desc = Craft a %item% for an inmate.
    rewardType = xp
    rewardStat = intelligence
  fight
    name = Settle a Score
    desc = Win a fight in the yard to settle a dispute.
    rewardType = rep
  gather
    name = Supply Run
    desc = Gather %count%x %item% for the crew.
    rewardType = money
  workout
    name = Training Session
    desc = Complete %count% workouts to prove your dedication.
    rewardType = xp
    rewardStat = strength
  steal
    name = Acquisition Job
    desc = Successfully steal %count% times without getting caught.
    rewardType = xp
    rewardStat = stealth

