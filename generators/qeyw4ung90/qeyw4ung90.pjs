$meta
  title = Prison Break Simulator
  description = Plan your escape, craft tools, build skills, dodge the guards, and break free.
  tags = prison, escape, simulator, strategy, rpg

weatherTypes
  sunny
    name = Sunny
    icon = ☀
    color = #f39c12
    desc = Clear skies. Energy is up.
    scavengeMod = 1.2
    stealthMod = 1
    suspicionMod = 1
    statXpMod = 1.1
  cloudy
    name = Cloudy
    icon = ☁
    color = #95a5a6
    desc =Overcast. Normal conditions.
    scavengeMod = 1
    stealthMod = 1
    suspicionMod = 1
    statXpMod = 1
  rainy
    name = Rainy
    icon = 🌧
    color = #3498db
    desc = Heavy rain. Scavenging harder, but guards stay indoors.
    scavengeMod = 0.6
    stealthMod = 1.2
    suspicionMod = 0.85
    statXpMod = 0.95
  foggy
    name = Foggy
    icon = 🌫
    color = #bdc3c7
    desc = Thick fog. Perfect for sneaking around.
    scavengeMod = 0.8
    stealthMod = 1.4
    suspicionMod = 0.7
    statXpMod = 1
  stormy
    name = Stormy
    icon = ⛈
    color = #e74c3c
    desc =Violent storm. Guards on edge, but noise covers tracks.
    scavengeMod = 0.5
    stealthMod = 1.1
    suspicionMod = 1.2
    statXpMod = 1.15

