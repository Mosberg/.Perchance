numberSet = {import:number-set-plugin}
consumableListLoop = {import:consumable-list-loop-plugin}
createInstance = {import:create-instance-plugin}
r1 = report1  // the default (must be the same as the first <option> in the HTML panel)
d1 = day1
doughfed = 0
doughbank = 0
jobscore = 0
auctionscore = 0
bidscore = 0
rookscore = 0
pizzascore = 0
doughscore = 0
cookiescore = 0
shellscore = 0
hire = 0
threestar = 0
fivestar = 0
sevenstar = 0
bidcount = 0
touradd = 0
tourmulti = 0
itemprice = 0
powernum = 0
drynum = 0
loadsnum = 0
cupnum = 0
cupmaxnum = 0
netW = 0
w1 = ['']
w2 = ['']
j1 = jobno

prizename
	prize ^0 

namer
	name ^0 

title
  Store and Job


currencydisplay
  [currselect.selectUnique(7).join(" ")]


currselect
  [""] ^500
  [""] ^500
  [""] ^500
  [""] ^500
  [""] ^500
  [""] ^500
  [""] ^500
  [""] ^500
  --- 💵 R$ [rookscore.toLocaleString()] ^[(rookscore > 0)*20000]
  --- 🍕 [pizzascore]  ^[(pizzascore > 0)*20000]
  ---   🍩 [doughscore]  ^[(doughscore > 0)*20000]
  --- 🍪 [cookiescore]  ^[(cookiescore > 0)*20000]
  --- 🐚 [shellscore]  ^[(shellscore > 0)*20000]

titledisplay 
  # 🍨 Ice Cream Van Report ^[r1 == "report5"]
  # 🥪 Sandwich Stand Report ^[r1 == "report9"]
  # 🏨 Hotel Reports ^[r1 == "report6"]
  # 🧺 Laundry Report ^[r1 == "report1"]
  # 🧺 Laundry Report ^[r1 == "report2"]
  # 🏬 Department Store ^[r1 == "report4"]
  # 🗳️ Lemonade Time! ^[r1 == "report3"]
  # 🏦 Ring Ring! It's Auction Day! ^[r1 == "report7"]
  # 📋 Hiring Alert ^[((hire > 0) && (r1 != "report8"))*20000000]
  [""] ^20000

hiredisplay
  Job {1-3}

namesDropDownList
  $output = [this.selectAll.joinItems("")]
  <select oninput\="namer \= this.value">
  [nameslist.selectAll.map(a => `<option value="${a}">${a}</option>`).joinItems("")]
  </select>

nameslist
  name
  Fakelamb
  Koel
  Salem
  Fauna
  Lackofa
  Beep
  PhoenixRemixed
  Snowwyvern
  Trash-hime
  Kata
  Ohn
  Sou  
  Illigur

hireroll
  <br><br>[namer] got the [prizename] position! ^[hire.evaluateItem]
  <br><br>[namer] was not hired.

generatenum
  {1-5}
  
generatenum2
  {5-20}

generatenum3
  {10-100}

generatenum4
  {1-9} ^[d1 != "day4" || d1 == "day5"]
  {7-12} ^[d1 == "day4"]
  {8-10} ^[d1 == "day5"]
  {9-16} ^[d1 == "day6"]

generatenum5
  0.3
  0.5
  0.7

generatenum6
  {100-10000}

generatenum7
  {1000-100000}

daysstand
  {1-5} ^[d1 == "day1"]
  {5-10} ^[d1 == "day2"] 
  {10-20} ^[d1 == "day3"] 
  {20-50} ^[d1 == "day4"] 
  {30-100} ^[d1 == "day5"] 
  {70-200} ^[d1 == "day6"] 

daysbusiness
  {10-20}  ^[d1 == "day1"]
  {20-40}  ^[d1 == "day2"] 
  {40-100} ^[d1 == "day3"]  
  {80-200} ^[d1 == "day4"]  
  {250-500} ^[d1 == "day5"]  
  {350-800} ^[d1 == "day6"]  

daysrest
  {80-100}  ^[doughbank <= 3]
  {300-400}  ^[doughbank == 6] 
  {300-600} ^[doughbank ==9]  
  {200-500} ^[doughbank > 11 && doughbank < 21]  
  {600-1200} ^[doughbank >= 21] 
  {900-2000} ^[doughbank == 30] 

daysjob
  1 ^[d1 == "day1"]
  {2-4} ^[d1 == "day2"] 
  {3-5} ^[d1 == "day3"] 
  {5-7} ^[d1 == "day4"] 
  {8-14} ^[d1 == "day5"] 
  {13-20} ^[d1 == "day6"] 

daysauction
  {1-3} ^[d1 == "day1"]
  {4-7} ^[d1 == "day2"] 
  {5-10} ^[d1 == "day3"] 
  {7-15} ^[d1 == "day4"] 
  {10-20} ^[d1 == "day5"] 
  {15-40} ^[d1 == "day6"] 


guestnumber
  {1-20}  ^[g1 == "guest1"]
  {10-30}  ^[g1 == "guest2"] 
  {40-100} ^[g1 == "guest3"]  
  {80-300} ^[g1 == "guest4"]  
  {400-1000} ^[g1 == "guest5"]  

daytime
  day  ^[d1 == "day1"]
  few days  ^[d1 == "day2"] 
  several days ^[d1 == "day3"]  
  week ^[d1 == "day4"]  
  weeks ^[d1 == "day5"]  
  month or so ^[d1 == "day6"]  

randomset
  [generatenum.evaluateItem*10]

output
  {This|That}

Reportdisplay
  [Washtext] ^[r1 == "report1"]
  [Dryertext] ^[r1 == "report2"]
  [Lemontext] ^[r1 == "report3"]
  [Departmenttext] ^[r1 == "report4"]
  [Icetext] ^[r1 == "report5"]
  [Hoteltext] ^[r1 == "report6"]
  [Auctiontext] ^[r1 == "report7"]
  [Restroll] <br>[Jobtip]<br><br> ^[r1 == "report8"]
  [Sandtext] ^[r1 == "report9"]
  <br><br>[namer]'s new bank total is 💵 $R[pt = payment,""][ptreal = Math.round(pt),""][ptreal.toLocaleString()][promo][extracal][extracal2]  ^[(payBox.checked) ? 200000 : 0]

Reportdisplay2
  $output = [this.joinItems("")]
  [if (report10Box.checked){"<br>"+Jobtext} else {""}]
  [if (report1Box.checked){Washtext} else {""}]
  [if (report2Box.checked){"<br>"+Dryertext} else {""}]
  [if (report3Box.checked){"<br>"+Lemontext} else {""}]
  [if (report4Box.checked){"<br>"+Departmenttext} else {""}]
  [if (report5Box.checked){"<br>"+Icetext} else {""}]
  [if (report6Box.checked){"<br>"+Hoteltext} else {""}]
  [if (report7Box.checked){"<br>"+Auctiontext} else {""}]
  [if (report8Box.checked){"<br>"+Restroll+"<br>"+[Jobtip]} else {""}]
  [if (report9Box.checked){"<br>"+Sandtext} else {""}]


Reportprices
  Washer: + Profits [washtotal]<br> + Tips 🍩 [washdough] 🍕[washpizza]<br> --- Expenses [washexp]
  Dryer
  Lemonade
  Department
  Ice Cream
  Hotel <br> --- Expenses [washexp]
  Auction <br> --- Expenses [washexp]
  Restaurant <br> --- Expenses [washexp]
  Sandwich

tourdisplay
  [""]
  <br>📸 Tourist Bonus: [touradd] +!<br><br> ^[(tourBox.checked)*20000]
  <br>📸  Tourists Bonus: x[mt = tourmulti*0.01, ""][mt.toFixed(1)]<br><br> ^[(tourmulti > 0)*20000]

tips
  [tipsloot]
  [tipsloot]  ^[String(prizename).includes("Fisher") ? 200000 : 0] 
  [tipsloot]  ^[(r1 == "report8") ? 200000 : 0] 
  [tipsloot]  ^[(report8Box.checked) ? 200000 : 0] 
  [t1 = tipsloot.consumableList] and [t1]
  [t1 = tipsloot.consumableList] and [t1] ^[(r1 == "report8") ? 200000 : 0] 
  [t1 = tipsloot.consumableList] and [t1] ^[(report8Box.checked) ? 200000 : 0] 
  [t2 = tipsloot.consumableList], [t2] and [t2]


tipsloot
  💵 $R [tipgtc1 = generatenum3 * 1000, ""] [tipgtc1.toLocaleString()] [rookscore += tipgtc1,""]
  🍩 [tipgtc2 = generatenum2 * 10, ""] [tipgtc2.toLocaleString()] [doughscore += tipgtc2,""]
  🍕 [tipgtc3 = generatenum2 * 10, ""] [tipgtc3.toLocaleString()] [pizzascore += tipgtc3,""]
  🍕 [tipgtc3 = generatenum2 * 10, ""] [tipgtc3.toLocaleString()] [pizzascore += tipgtc3,""]  ^[String(prizename).includes("Fisher") ? 200000 : 0] 
  🍕 [tipgtc3 = generatenum2 * 100, ""] [tipgtc3.toLocaleString()] [pizzascore += tipgtc3,""]  ^[(r1 == "report8") ? 10 : 0]
  🍩 [tipgtc2 = generatenum2 * 100, ""] [tipgtc2.toLocaleString()] [doughscore += tipgtc2,""]  ^[(r1 == "report8") ? 10 : 0]
  🍕 [tipgtc3 = generatenum2 * 10, ""] [tipgtc3.toLocaleString()] [pizzascore += tipgtc3,""]  ^[String(prizename).includes("Shoreline") ? 200000 : 0] 
  🐚 [tipgtc4 = generatenum3, ""] [tipgtc4.toLocaleString()]  [shellscore += tipgtc4,""] ^[String(prizename).includes("Shoreline") ? 200000 : 0] 
  🐚 [tipgtc4 = generatenum3, ""] [tipgtc4.toLocaleString()]  [shellscore += tipgtc4,""] ^[r1 == "report9"]
  🍪 [tipgtc5 = generatenum2, ""] [tipgtc5.toLocaleString()] [cookiescore += tipgtc5,""]  ^[String(prizename).includes("Shoreline") ? 200000 : 0] 

Washtext
  $output = [this.joinItems("")]
  🌀 [dp = daysstand.selectOne.evaluateItem,""][dpc = dp.evaluateItem + touradd.evaluateItem] people used [namer]'s washer machine!<br><br>[tourdisplay]

  There was a total of [gensumplus = generatenum.evaluateItem.selectMany(dpc).sumItems] loads washed over the past [daytime]!<br><br>
  
  You've gained 💵 $R[gn = gensumplus * 1250, ""][gn.toLocaleString()]!<br><br> [rookscore += gn,""]
  
Dryertext
  $output = [this.joinItems("")]
  💽 [dp = daysstand.selectOne.evaluateItem,""][drynum.evaluateItem] people used [namer]'s dryer machine!<br><br>

  There was a total of [gensumplus = loadsnum.evaluateItem] loads dried over the past [daytime]!<br><br>
  
  Someone posted on the Laundry Bulletin:<br>
  ""<br><br>
  
  [namer] gained 💵 $R[gn = gensumplus * 1500, ""][gn.toLocaleString()]!<br><br> [rookscore += gn,""]


Dryertextbackup
  $output = [this.joinItems("")]
  💽 [dp = daysstand.selectOne.evaluateItem,""][dpc = dp.evaluateItem + doughfed.evaluateItem] people used [namer]'s dryer machine!<br><br>

  There was a total of [gensumplus = generatenum.evaluateItem.selectMany(dpc).sumItems + doughbank.evaluateItem] loads dried over the past [daytime]!<br><br>
  
  
  [namer] gained 💵 $R[gn = gensumplus * 1500, ""][gn.toLocaleString()]!<br><br> [rookscore += gn,""]

Lemontext
  $output = [this.joinItems("")]
  🥤  [namer] had [dp = daysstand.selectOne.evaluateItem + touradd.evaluateItem] lemonade orders the past [daytime]![tourdisplay]<br><br><br>


  [namer] gained 💵 $R[dt = dp * 10000, ""][dt.toLocaleString()]!<br> [rookscore += dt,""]
  Someone also tipped [namer]'s stand [tips]!<br><br>
  
  🗳️ ([dr = cupnum.evaluateItem - dp]/[cupmaxnum] Cups)
  <br>🥤🍋x[ddr = dr.evaluateItem/32,""][Math.ceil(ddr)] Left<br><br>
	
Departmenttext
  $output = [this.joinItems("")]
  
  👚 [db1 = daysbusiness.selectOne.evaluateItem,""][dbc = db1.evaluateItem + (db1.evaluateItem + (db1.evaluateItem * tourmulti.evaluateItem)),""][dbcfinal = Math.ceil(dbc)] volumes of clothes were sold at [namer]'s department store! [set = numberSet(3, dbcfinal), ""][tourdisplay]<br><br>

  🧢 [ss1 = set.n1] hats were sold. + 💵 $R [ssum1 = ss1 * 1300, ""][ssum1.toLocaleString()]!<br>
  👕 [ss2 = set.n2] shirts were sold. + 💵 $R [ssum2 = ss2 * 1550, ""][ssum2.toLocaleString()]!<br>
  👖 [ss3 = set.n3] bottoms were sold. + 💵 $R [ssum3 = ss3 * 2000, ""][ssum3.toLocaleString()]!<br><br>
  
  [customitem]
  
  [namer] gained 💵 $R [totalsum = ssum1 + ssum2 + ssum3 + dsum, ""][totalsum.toLocaleString()]!<br><br> [rookscore += totalsum,""]

customitem
  [dsum = 0, ""]
  🍞 [db2 = daysbusiness.selectOne.evaluateItem] [prizename] were sold. + 💵 $R[dsum = db2 * itemprice, ""][dsum.toLocaleString()]!<br><br>  ^[(itemBox.checked)*20000]
  
Icetext
  $output = [this.joinItems("")]
  🍨  [namer] had [dp = daysstand.selectOne.evaluateItem, ""][dpc = dp.evaluateItem + touradd.evaluateItem] ice cream orders the past [daytime]![tourdisplay]<br><br><br>


  [namer] gained 💵 $R[dt = dpc * 10000, ""][dt.toLocaleString()]!<br> [rookscore += dt,""]
  Someone also tipped [namer]'s stand [tips]!<br><br>
  
  🍦 ([powernum - [gensum = genice.evaluateItem]]% Ice Cream Power left)<br><br>


Sandtext
  $output = [this.joinItems("")]
  🥪  [namer] had [dp = daysstand.selectOne.evaluateItem, ""][dpc = dp.evaluateItem + touradd.evaluateItem] sandwich orders the past [daytime]![tourdisplay]<br><br><br>


  [namer] gained 💵 $R[dt = dpc * 25000, ""][dt.toLocaleString()]!<br> [rookscore += dt,""]
  Someone also tipped [namer]'s stand [tips]!<br><br>
  
  🥪 ([powernum - [gensum = genice.evaluateItem]]% Sandwich Power left)<br><br>

Auctiontext
  $output = [this.joinItems("")]
  🏦 [gp = daysauction.selectOne.evaluateItem,""][gpc = gp.evaluateItem + doughfed.evaluateItem] items provided by the auction overseer were put up for auction at [namer]'s auction house!<br><br>

  [Auctionselect = Auctionitem.selectMany(gpc)]<br><br>
  
  🧾 Auction Supply Fee: - 💵 $R[fn = auctionscore * generatenum5.evaluateItem, ""][auctionscore -= fn,""][fn.toLocaleString()]<br><br>
  
  You've gained 💵 $R[acs = auctionscore, ""][acs.toLocaleString()]!
  [customitemau]<br><br>

Auctionitem
  [itemoption] was sold for 💵 $R[gn = auctionamount.evaluateItem * 10000, ""][auctionscore += gn,""][gn.toLocaleString()] to [winner]!<br>

bidding1
  [w1] bidded 💵 $R[gn = auctionamount.evaluateItem * 10000, ""][bidscore += gn,""][auctionscore += gn,""][bidscore.toLocaleString()]!<br>

bidding2
  [w2] bidded 💵 $R[gn = auctionamount.evaluateItem * 10000, ""][bidscore += gn,""][auctionscore += gn,""][bidscore.toLocaleString()]!<br>

auctionamount
  [generatenum]
  [generatenum3]

bidamount
  [generatenum]
  [generatenum2]

auctiondisplay
  [""] ^[r1 != "report7"]
  You made 💵 $R[auctionscore.toLocaleString()] total! ^[r1 == "report7"]

customitemau
  [""]
  <br>🌟 [namer]'s star item, [prizename], is up for auction! There were {1-40} bids. <br>All proceeds from the star auction goes to [namer], no fees charged.<br><br>  ^[(itemBox.checked)*20000]

bidcountdisplay
  [""] ^[r1 != "report7"]
  Bids: [bidcount] ^[r1 == "report7"]


