jobsalary
  40000  ^[String(Joblist.selectOne).includes("Waiter") ? 200000 : 0] 
  80000  ^[String(Joblist.selectOne).includes("Shoreline Patrol") ? 200000 : 0]
  80000   ^[String(Joblist.selectOne).includes("Fisher") ? 200000 : 0]
  35000 ^[String(Joblist.selectOne).includes("Grocery Pickup") ? 200000 : 0]
  45000  ^[String(Joblist.selectOne).includes("Pizza Delivery") ? 200000 : 0]
  100000 ^[String(Joblist.selectOne).includes("Underground Chef") ? 200000 : 0]
  100000   ^[String(Joblist.selectOne).includes("Treasure Hunter") ? 200000 : 0]
  120000 ^[String(Joblist.selectOne).includes("Forge Assistant") ? 200000 : 0]
  100000  ^[String(Joblist.selectOne).includes("Bounty Poster Artist") ? 200000 : 0]
  95000  ^[String(Joblist.selectOne).includes("Greeter") ? 200000 : 0] 
  250000  ^[String(Joblist.selectOne).includes("Shoreline Enforcer") ? 200000 : 0]
  200000   ^[String(Joblist.selectOne).includes("Commercial Fisher") ? 200000 : 0]
  100000  ^[String(Joblist.selectOne).includes("Pizza Supplier") ? 200000 : 0]
  150000 ^[String(Joblist.selectOne).includes("Underground Recipe Hunter") ? 200000 : 0]
  150000   ^[String(Joblist.selectOne).includes("Gem Hunter") ? 200000 : 0]
  250000 ^[String(Joblist.selectOne).includes("Forge Helper") ? 200000 : 0]
  150000  ^[String(Joblist.selectOne).includes("Bounty Assistant") ? 200000 : 0]

Joblist
  [prizename]   ^[j1 == "jobno"]
  Waiter   ^[j1 == "job1"]
  Shoreline Patrol  ^[j1 == "job2"]
  Fisher  ^[j1 == "job3"]
  Grocery Pickup  ^[j1 == "job4"]
  Pizza Delivery  ^[j1 == "job5"]
  Underground Chef  ^[j1 == "job6"]
  Treasure Hunter  ^[j1 == "job7"]
  Forge Assistant  ^[j1 == "job8"]
  Bounty Poster Artist  ^[j1 == "job9"]
  Greeter   ^[j1 == "job10"]
  Shoreline Enforcer  ^[j1 == "job11"]
  Commercial Fisher  ^[j1 == "job12"]
  Pizza Supplier  ^[j1 == "job13"]
  Underground Recipe Hunter  ^[j1 == "job14"]
  Gem Hunter  ^[j1 == "job15"]
  Forge Helper  ^[j1 == "job16"]
  Bounty Assistant  ^[j1 == "job17"]

Jobpay
  $output = [this.joinItems("")]
  Waiter (tip) 25%: 💵 $40000 <br> ^[String(prizename).includes("Fisher") ? 200000 : 0] 
  Shoreline Patrol (find) 20%: 💵 $80000 <br><br> 
  Fisher (pizza) 20%: 💵 $80000 <br>
  Grocery Pickup (tip) 75%: 💵 $35000<br><br>
  Pizza Delivery (tip) 75%: 💵 $45000<br>
  Underground Chef (tip) 25%: 💵 $100000<br><br>
  Treasure Hunter 25% 💵 $100000 <br>
  Forge Assistant 10%: 💵 $120000<br><br>
  Bounty Poster Artist (tip) 10% 💵 $100000<br>
  Waiter (tip) 25%: 💵 $40000<br><br>

payment
  [rookscore+(netW+extra.evaluateItem)*percent1*percent2*percent3*percent4*percent5]

extra  
  0
  250000 ^[((report3Box.checked) && (!report9Box.checked) && (!report5Box.checked)) ? 200000 : 0] 
  200000 ^[((report5Box.checked) && (!report9Box.checked) && (!report3Box.checked)) ? 200000 : 0] 
  200000 ^[((!report5Box.checked) && (report9Box.checked) && (!report3Box.checked)) ? 200000 : 0] 
  450000 ^[((report3Box.checked) && (report9Box.checked) && (!report5Box.checked)) ? 200000 : 0]  
  450000 ^[((report3Box.checked) && (!report9Box.checked) && (report5Box.checked)) ? 200000 : 0]  
  650000 ^[((report3Box.checked) && (report9Box.checked) && (report5Box.checked)) ? 200000 : 0]  

extracal
  [""]
  <br>🗳️ ([dr = cupnum.evaluateItem - 250]/[cupmaxnum] Cups)<br>🥤🍋x[ddr = dr.evaluateItem/32,""][Math.ceil(ddr)] Left ^[(report3Box.checked) ? 200000 : 0]

extracal2
  [""]
  <br>([powernum - 20]% Power left) ^[((report9Box.checked) || (report5Box.checked)) ? 200000 : 0]

percent1
  1
  0.95 ^[(percent1Box.checked) ? 200000 : 0] 
  
percent2
  1
  0.9 ^[(percent2Box.checked) ? 200000 : 0] 

percent3
  1
  0.85 ^[(percent3Box.checked) ? 200000 : 0] 

percent4
  1
  0.95 ^[(percent4Box.checked) ? 200000 : 0] 
  
percent5
  1
  0.9 ^[(percent5Box.checked) ? 200000 : 0] 


