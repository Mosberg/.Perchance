genice
  [generatenum]  ^[d1 == "day1"]
  [generatenum.evaluateItem.selectMany(2).sumItems]  ^[d1 == "day2"] 
  [generatenum.evaluateItem.selectMany(3).sumItems] ^[d1 == "day3"]  
  [generatenum2] ^[d1 == "day4"]  
  [generatenum2] ^[d1 == "day5"] 
  [generatenum2.selectMany(2).sumItems] ^[d1 == "day6"] 

Hoteltext
  $output = [this.joinItems("")]
  🛏️  [namer] had [gp1 = guestnumber.selectOne.evaluateItem] guests at [namer]'s hotel! [set = numberSet(3, gp1, "3,1,1"), ""]<br><br><br>

  🌙 [if (d1 != "day1") {ss1 = set.n1} else {ss1 = gp1}] guests stayed for 1 night. + 💵 $R [ssum1 = ss1 * 400000, ""][ssum1.toLocaleString()]!<br>
  🌓 [if (d1 == "day2") {ss2 = set.n2 + set.n3} else if ((d1 == "day4") || (d1 == "day5")  || (d1 == "day6")) {ss2 = set.n2} else {ss2 = 0}] guests stayed for 3 nights. + 💵 $R [ssum2 = ss2 * (400000*3), ""][ssum2.toLocaleString()]!<br>
  🌝 [if ((d1 == "day4") || (d1 == "day5")  || (d1 == "day6")) {ss3 = set.n3} else {ss3 = 0}] guests stayed for 1 week. + 💵 $R [ssum3 = ss3 * (400000*7), ""][ssum3.toLocaleString()]!<br><br>

  <br>Accomadation Expenses - 💵 $R [ex1 = (ssum1 + ssum2 + ssum3) * generatenum5.selectOne.evaluateItem, ""][ex1.toLocaleString()]!
  <br>Hotel Staff Pay - 💵 $R [ex2 = 50000 * generatenum4, ""][ex2.toLocaleString()]!<br><br>
  [customitem]
  
  [namer] gained 💵 $R [totalsum = ssum1 + ssum2 + ssum3 + dsum - ex1 - ex2, ""][totalsum.toLocaleString()]!<br><br> [rookscore += totalsum,""]

Restroll
  [Resttext1] ^[String(namer).includes("Koel")]
  [Resttext2] ^[String(namer).includes("Lackofa")]
  [Resttext3] ^[String(namer).includes("Sou")]
  [Resttext4] ^[String(namer).includes("Ohn")]
  [Resttext5] ^[String(namer).includes("Fauna")]
  [Resttext6] ^[String(namer).includes("Kata")]
  [Resttext7] ^[String(namer).includes("Snowwyvern")]
  [Resttext8] ^[String(namer).includes("Beep")]
  [Resttext9] ^[String(namer).includes("Salem")]

Resttext1
  $output = [this.joinItems("")]
  🍞 Kneady Kitty Report
  <br>\=\=\=\=<br><br>
  <br>🍞 Loaves sold: [dp1 = daysrest.selectOne.evaluateItem][dp2 = dp1,""]
  <br>✨ Donated Dish Multiplier: x[ml = hire*0.1, ""][ml.toFixed(1)][dp2 += (dp1*ml),""]
  <br>⭐ 3-Star Dish Multiplier: x[m3 = threestar*0.1, ""][(m3*3).toFixed(1)][dp2 += (dp1*(m3*3)),""]
  <br>🌟 5-Star Dish Multiplier: x[m5 = fivestar*0.1, ""][(m5*5).toFixed(1)][dp2 += (dp1*(m5*5)),""]
  <br>☄️ 7-Star Dish Multiplier: x[m7 = sevenstar*0.1, ""][(m7*7).toFixed(1)][dp2 += (dp1*(m7*7)),""]
  <br>📸  Tourists Bonus: x[mt = tourmulti*0.01, ""][mt.toFixed(1)][dp2 += (dp1*mt),""]
  <br>💰 Profits: 💵 $R [prosum = dp2 * 10000, ""][prosum.toLocaleString()]

  [if (doughbank == 0){exbank = 3,""} else {exbank = doughbank,""}]
  <br><br>👔  Employee 3-day salary (x[exbank.evaluateItem/3]): -- 💵 $R [ex1 = 432000 * (exbank.evaluateItem/3), ""][ex1.toLocaleString()]
  <br>:oven:  Oven Fees: -- 💵 $R [ex2 = 105000 * (exbank.evaluateItem/3), ""][ex2.toLocaleString()]
  <br>🌾 Ingredient Fees:  -- 💵 $R [ex3 = (dp1) * 1000, ""][ex3.toLocaleString()][chargeroll]<br><br>
  
  
  
  <br><br>[namer] gained 💵 $R [totalsum = prosum - ex1 - ex2 - ex3, ""][totalsum.toLocaleString()]!<br><br> [rookscore += totalsum,""]


Resttext2
  $output = [this.joinItems("")]
  🥛  Cloud Nine Report
  <br>\=\=\=\=<br><br>
  <br>🥛 Drinks & Tasties sold: [dp1 = daysrest.selectOne.evaluateItem][dp2 = dp1,""]
  <br>✨ Donated Dish Multiplier: x[ml = hire*0.1, ""][ml.toFixed(1)][dp2 += (dp1*ml),""]
  <br>⭐ 3-Star Dish Multiplier: x[m3 = threestar*0.1, ""][(m3*3).toFixed(1)][dp2 += (dp1*(m3*3)),""]
  <br>🌟 5-Star Dish Multiplier: x[m5 = fivestar*0.1, ""][(m5*5).toFixed(1)][dp2 += (dp1*(m5*5)),""]
  <br>☄️ 7-Star Dish Multiplier: x[m7 = sevenstar*0.1, ""][(m7*7).toFixed(1)][dp2 += (dp1*(m7*7)),""]
  <br>📸  Tourists Bonus: x[mt = tourmulti*0.01, ""][mt.toFixed(1)][dp2 += (dp1*mt),""]
  <br>🎟️ Tickets Sold: [tp1 = daysrest.selectOne.evaluateItem]
  <br>🥊 Underground Boxing Ticket Revenue: 💵 $R [tsum  = tp1 * 20000, ""][tsum.toLocaleString()]
  <br>💰 Profits: 💵 $R [prosum = dp2 * 9000 + tsum, ""][prosum.toLocaleString()]

  [if (doughbank == 0){exbank = 3,""} else {exbank = doughbank,""}]
  <br><br>👔  Employee 3-day salary (x[exbank.evaluateItem/3]): -- 💵 $R [ex1 = 500000 * (exbank.evaluateItem/3), ""][ex1.toLocaleString()]
  <br>🚪  Fridge & Brewing Fees: -- 💵 $R [ex2 = 100000 * (exbank.evaluateItem/3), ""][ex2.toLocaleString()]
  <br>🌾 Ingredient Fees:  -- 💵 $R [ex3 = (dp1 - 10) * 1000, ""][ex3.toLocaleString()][chargeroll2][chargeroll]<br><br>
  
  
  
  <br><br>[namer] gained 💵 $R [totalsum = prosum - ex1 - ex2 - ex3, ""][totalsum.toLocaleString()]!<br><br> [rookscore += totalsum,""]

Resttext3
  $output = [this.joinItems("")]
  🍗  Dorky Doggos Diner Report
  <br>\=\=\=\=<br><br>
  <br>🍗 Meals sold: [dp1 = daysrest.selectOne.evaluateItem][dp2 = dp1,""]
  <br>✨ Donated Dish Multiplier: x[ml = hire*0.1, ""][ml.toFixed(1)][dp2 += (dp1*ml),""]
  <br>⭐ 3-Star Dish Multiplier: x[m3 = threestar*0.1, ""][(m3*3).toFixed(1)][dp2 += (dp1*(m3*3)),""]
  <br>🌟 5-Star Dish Multiplier: x[m5 = fivestar*0.1, ""][(m5*5).toFixed(1)][dp2 += (dp1*(m5*5)),""]
  <br>☄️ 7-Star Dish Multiplier: x[m7 = sevenstar*0.1, ""][(m7*7).toFixed(1)][dp2 += (dp1*(m7*7)),""]
  <br>📸  Tourists Bonus: x[mt = tourmulti*0.01, ""][mt.toFixed(1)][dp2 += (dp1*mt),""]
  <br>💰 Profits: 💵 $R [prosum = dp2 * 15000, ""][prosum.toLocaleString()]

