commentsPlugin = {import:comments-plugin}

$meta
  title = Audio Editor Pro
  description = A powerful browser-based audio editor. Upload MP3, MP4 (video), WAV, OGG and more. Visualize waveforms, adjust speed & pitch, toggle effects on/off, trim, and export your audio — all in your browser.
  tags = audio, editor, music, waveform, mp3, mp4, sound, pitch, speed, effects
  image = https://user.uploads.dev/file/f7444867eb18a5ca0397083e26cc04e4.jpg
  header
    mode = minimal
    background = #6c5ce7

// Supported file types for upload
supportedFormats
  MP3
  MP4 (Video)
  WAV
  OGG
  M4A
  AAC
  FLAC
  WebM

// Default effect presets
effectPresets
  Bass Boost
  Treble Boost
  Vocal Enhance
  Room Reverb
  Telephone
  Echo
  Lowpass
  Highpass

// Effect definitions (used to build toggle cards)
effectList
  Bass Boost
  Treble Boost
  Reverb
  Distortion
  Delay
  Compressor
