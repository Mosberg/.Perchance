// CashBunny — a platformer by 4BDN
// Config / data lives here; game logic is in index.html.

$meta
  title = CashBunny
  description = A flashy platformer by 4BDN — bounce, collect cash, and stack that paper.
  tags = platformer, game, cashbunny, 4bdn

gameConfig
  title = CashBunny
  author = 4BDN
  gravity = 0.55
  jumpPower = 12
  moveSpeed = 4.2
  airControl = 0.8
  startLives = 3
  cashPerLevel = 10

tip
  Grab the cash, dodge the gaps, keep your heels on!
  Higher combos = bigger payouts.
  Watch for the golden bills — they're worth 5x.
  Don't fall off the stage, honey.
  Land on platforms to keep your streak alive.
  The pole gives you a boost — grab it and spin!

danceMove
  Hair Flip
  Heel Click
  Hip Sway
  Spin Drop
  Stage Strut
