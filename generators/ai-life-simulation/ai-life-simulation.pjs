something = {import:yv49wuj5d6}
commentsPlugin = {import:comments-plugin}

$meta
  title = AI Life Simulation (free, no sign-up, unlimited, uncensored)
  description = This game is a interactive simulation where you create and manage characters, places, rooms, and objects in a virtual world. Characters can move around, interact with objects, chat with each other, and evolve based on their stats and moods. The game combines elements of life simulation, role-playing, and AI-driven behaviors.
  header
    mode = minimal

defaultCommentOptions // for comments plugin: https://perchance.org/comments-plugin
  adminFlair =  Admin
  adminPasswordHash = e9de19301c56ea8d883b0d46d387e1147f2fb45d951b6db429846885f5d08cec
  commentPlaceholderText = Type a friendly comment...
  submitButtonText = submit comment
  customEmojis = {import:huge-emoji-list}
    
commentChannels
  allowCustomChannels = false // adds a "+" button so people can add more channels (others won't see the channel unless they also add it)
  general
    label = General
    commentPlaceholderText = General discussion about the generator. You can report issues or make suggestions here. Please be as detailed as possible when reporting an issue.
    submitButtonText = submit
  // feedback