$meta
  title = Step Prompt Lab
  description = Sequential prompt refinement image generator
  image = https://user.uploads.dev/file/8e326a88ac2575a52c191f2b391b8630.png

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
stepModeLibrary = {import:step-prompt-lab-modes}

setupPluginBridge() =>
  window.stepPromptLabGenerateImage = generateImage;
  window.stepPromptLabGenerateText = generateText;
  return "";

output
  Step Prompt Lab
