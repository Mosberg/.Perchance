adminName = [adminNomen + ' | MOD 🌟']
adminPass = b3dd14c9b9b7f23a3638e408e3e5b7f785a9e04e6033277176771f47f980d005
bannedWords = cbat,c​b​a​t,concell, cockell, C[o0]{0,1}n+[cC]{0,1}e{0,1}l{l}{1,}, Freya
fontSize = 15px
DefautlmessageBubbleStyle = font-family: "Work Sans"; font-size: [fontSize]; background: #1e1f20; color: #e6e8ec; border-radius: 10px; padding: 10px; margin: 10px; margin-block: 25px; border: 1px solid #313638; margin: 0; line-height: 1.7; image-rendering: pixelated;
DefautmessageFeedStyle = font-family: "Work Sans"; font-size: [fontSize]; background-color: #070707; background-size: contain, cover; background-repeat: no-repeat; background-position: center, center; overflow-x: auto; display: flex; flex-direction: column; gap: 4px; padding: 10px; 
DefautinputAreaStyle = font-family: "Work Sans"; font-size: [fontSize]; background: #101010ad; color: #e6e8ec; padding: 10px; resize: none; border: 0;
DefautsubmitButtonStyle = font-family: "Work Sans"; font-size: [fontSize]; background: #101010ad; color: #e6e8ec; height: 50px; border: none; user-select: none; flex-grow: 1;
DefaultcontainerStyle = width: 100%; height: 100%;
DefautfullscreenButtonStyle = "Work Sans"; font-size: [fontSize]; border: none; background: #101010ad; color: #e6e8ec; cursor: pointer; user-select: none;
DefautsettingsButtonStyle = "Work Sans"; font-size: [fontSize]; border: none; background: #101010ad; color: #e6e8ec; cursor: pointer; user-select: none;
DefaultloadFonts = Work Sans
DefaultrateLimits = 1200 per second
EmojiSize = 5
DefaultCustomEmojiSize = 1.01
