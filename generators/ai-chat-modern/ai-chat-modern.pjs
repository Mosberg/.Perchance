ai = {import:ai-text-plugin}
chat = {import:comments-plugin}
upload = {import:upload-plugin}
generatorStats = {import:generator-stats-plugin-v2}
Cocell = {import:cocell}
favicon = {import:favicon-plugin}
bannedUsers = {import:ai-chat-modern-banned-users-list}

// It is official, `/ai-chat-modern` is no longer canon! 🔥🔥🔥
$meta
  header
    mode = minimal
    background = black
    color = white
    filter = grayscale(1)
    font-family = "Work Sans", system
  title = Modern
  description = Visually attractive spin-off with a modern user interface and a focus on a playful user experience.
  tags = AI, modern

__currentId = [Math.floor((new Date() - new Date('2025-01-16T00:00:00Z')) / (1000 * 60 * 60 * 24)) + 1]
publicChatId = [__currentId]

reportUserIndex = [Math.floor((new Date() - new Date('2025-03-01T00:00:00Z')) / (1000 * 60 * 60 * 24 * 7)) +1]

EmojiTags
  funny = joy, lol, lmao,


// Comments
adminNomen
  ​
  🌊
  🔥
  ✨
  🥼
  💎
  👑
  🔱
  👁️
