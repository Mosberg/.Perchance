commands
  /
    output = [formatText(this.input)]
  thumbsUp
    output = 👍
  thumbsDown
    output = 👎
  chat
    output = [handleChatCommand(this.input.trim().toLowerCase())]
  rand // Requested by Table
    output = [handleRandomNumCommand(this.input.trim())]
  cocell
    output = Coc̀éll's time: [cocellTime()]
  time
    output = [getTime(this.input.trim())]
  +
    output = [handleChatCommand("+")]
  -
    output = [handleChatCommand("-")]
  e
    output = [wee()]

wee() =>
  document.body.style.transition = "transform 2s ease-in-out";
  document.body.style.transform = "rotate(360deg)";
  
  setTimeout(() => {
    document.body.style.transition = "";
    document.body.style.transform = "";
  }, 2200);
  return "";


cocellTime() => const d = new Date(Date.now() + 21600000), h = d.getUTCHours(), m = d.getUTCMinutes().toString().padStart(2, '0'), s = d.getUTCSeconds().toString().padStart(2, '0'), ap = h >= 12 ? 'PM' : 'AM', th = h % 12 || 12; return `${th}:${m}:${s} ${ap} — ${d.toISOString().substring(11,19)}`

getTime(offset) =>
  let now = new Date();
  if(!offset) {
    let year = now.getFullYear();
    let month = String(now.getMonth() + 1).padStart(2, '0');
    let day = String(now.getDate()).padStart(2, '0');

    let h = now.getHours();
    let m = now.getMinutes();
    let s = now.getSeconds();

    let ampm = h >= 12 ? 'PM' : 'AM';
    let h12 = h % 12 || 12;
    let h24 = String(h).padStart(2, '0');
    let mm = String(m).padStart(2, '0');
    let ss = String(s).padStart(2, '0');

    return `Current time: ${h12}:${mm}:${ss} ${ampm} / ${h24}:${mm}:${ss} ${year}-${month}-${day}`
  }

  let utc = now.getTime() + now.getTimezoneOffset() * 60000;
  let d = new Date(utc + offset * 3600000);

  let year = d.getFullYear();
  let month = String(d.getMonth() + 1).padStart(2, '0');
  let day = String(d.getDate()).padStart(2, '0');

  let h = d.getHours();
  let m = d.getMinutes();
  let s = d.getSeconds();

  let ampm = h >= 12 ? 'PM' : 'AM';
  let h12 = h % 12 || 12;
  let h24 = String(h).padStart(2, '0');
  let mm = String(m).padStart(2, '0');
  let ss = String(s).padStart(2, '0');

  return `Time in UTC${offset >= 0 ? '+' : ''}${offset}: ${h12}:${mm}:${ss} ${ampm} / ${h24}:${mm}:${ss} ${year}-${month}-${day}`

handleRandomNumCommand(text) =>
  if(text == "") {
    return "";
  }
  const decimalIndex = text.indexOf('.');
  if (decimalIndex !== -1) {
    text = text.substring(0, decimalIndex);
  }
  if(text == "") { // String detection to prevent 0-nan generation; probably could be optimized but this is simpler imo 一 Table
    return "";
  }
  text = text.replace(/[^0-9]/g, '');
  var functionOutput = Math.round(Math.random() * parseInt(text));
  toast(`Number: ${functionOutput} (0-${text})`)
  return `<<Number: ${functionOutput} (0-${text})>>`;

normalChars = [Array.from("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")]
boldChars = [Array.from("𝗮𝗯𝗰𝗱𝗲𝗳𝗴𝗵𝗶𝗷𝗸𝗹𝗺𝗻𝗼𝗽𝗾𝗿𝘀𝘁𝘂𝘃𝘄𝘅𝘆𝘇𝗔𝗕𝗖𝗗𝗘𝗙𝗚𝗛𝗜𝗝𝗞𝗟𝗠𝗡𝗢𝗣𝗤𝗥𝗦𝗧𝗨𝗩𝗪𝗫𝗬𝗭𝟬𝟭𝟮𝟯𝟰𝟱𝟲𝟳𝟴𝟵")]
italicChars = [Array.from("𝘢𝘣𝘤𝘥𝘦𝘧𝘨𝘩𝘪𝘫𝘬𝘭𝘮𝘯𝘰𝘱𝘲𝘳𝘴𝘵𝘶𝘷𝘸𝘹𝘺𝘻𝘈𝘉𝘊𝘋𝘌𝘍𝘎𝘏𝘐𝘑𝘒𝘓𝘔𝘕𝘖𝘗𝘘𝘙𝘚𝘛𝘜𝘝𝘞𝘟𝘠𝘡0123456789")]
boldAndItalicChars = [Array.from("𝙖𝙗𝙘𝙙𝙚𝙛𝙜𝙝𝙞𝙟𝙠𝙡𝙢𝙣𝙤𝙥𝙦𝙧𝙨𝙩𝙪𝙫𝙬𝙭𝙮𝙯𝘼𝘽𝘾𝘿𝙀𝙁𝙂𝙃𝙄𝙅𝙆𝙇𝙈𝙉𝙊𝙋𝙌𝙍𝙎𝙏𝙐𝙑𝙒𝙓𝙔𝙕𝟬𝟭𝟮𝟯𝟰𝟱𝟲𝟳𝟴𝟵")]
gothicChars = [Array.from("𝖆𝖇𝖈𝖉𝖊𝖋𝖌𝖍𝖎𝖏𝖐𝖑𝖒𝖓𝖔𝖕𝖖𝖗𝖘𝖙𝖚𝖛𝖜𝖝𝖞𝖟𝕬𝕭𝕮𝕯𝕰𝕱𝕲𝕳𝕴𝕵𝕶𝕷𝕸𝕹𝕺𝕻𝕼𝕽𝕾𝕿𝖀𝖁𝖂𝖃𝖄𝖅0123456789")]
cstm = [Array.from("𝕒𝕓𝕔𝕕𝕖𝕗𝕘𝕙𝕚𝕛𝕜𝕝𝕞𝕟𝕠𝕡𝕢𝕣𝕤𝕥𝕦𝕧𝕨𝕩𝕪𝕫𝔸𝔹ℂ𝔻𝔼𝔽𝔾ℍ𝕀𝕁𝕂𝕃𝕄ℕ𝕆ℙℚℝ𝕊𝕋𝕌𝕍𝕎𝕏𝕐ℤ𝟘𝟙𝟚𝟛𝟜𝟝𝟞𝟟𝟠𝟡")]
// https://instafonts.io

formatText(text) =>
  text = text.replace(/\*\*\*(.*?)\*\*\*/g, (match, p1) => p1.split("").map(char => boldAndItalicChars[normalChars.indexOf(char)] || char).join(""));
  text = text.replace(/\*\*(.*?)\*\*/g, (match, p1) => p1.split("").map(char => boldChars[normalChars.indexOf(char)] || char).join(""));
  text = text.replace(/\*(.*?)\*/g, (match, p1) => p1.split("").map(char => italicChars[normalChars.indexOf(char)] || char).join(""));
  text = text.replace(/\$(.*?)\$/g, (match, p1) => p1.split("").map(char => gothicChars[normalChars.indexOf(char)] || char).join(""));
  text = text.replace(/\^(.*?)\^/g, (match, p1) => p1.split("").map(char => cstm[normalChars.indexOf(char)] || char).join(""));
  return text;

handleChatCommand(text) =>
  if (text === "help" || text === "") {
    return `\`/chat\` Command Help:\n- \`+\` or \`next\` to increment chat ID by 1.\n- \`-\` or \`back\` to decrement chat ID by 1.\n- \`|\` to set chat ID to the current ID.\n- Or set a custom ID with \`/chat my-cool-id\` where \`my-cool-id\` is your cool ID. Make sure everything is in lowercase.\n\nRun these commands with \`/chat\` to navigate or set the chat ID.`;
  } else if (text === "+" || text === "next") {
    publicChatId++;
    if (isNaN(publicChatId)) {
      publicChatId = 'not-a-number';
    }
    update();
    return publicChatId;
  } else if (text === "-" || text === "back") {
    publicChatId--;
    toast(`Moved to '${publicChatId}'' chat. Use '/chat |' or '/chat current' to move to current chat.`);
    if (isNaN(publicChatId)) {
      publicChatId = 'not-a-number';
    };
    update();
    return publicChatId;
  } else if (["today", "current", "this", "now", "|", "i"].includes(text)) {
    if (publicChatId === __currentId) {
      toast('You are already in the current chat.');
    } else {
      publicChatId = __currentId;
      update();
    }
    return '';
  } else {
    publicChatId = text;
    toast(`Moved to '${publicChatId}'' chat. Use '/chat |' or '/chat current' to move to current chat.`);
    update();
    return publicChatId;
  }

cocellsName = Coc̀éll 
//  ꧁🔥 Coc̀éll the Phoenix 🔥꧂
erStyle  = width: 100%; height: 100%;

// Comments------------------------------------------------------------------------------------------

chatOne
  // Style >>>
    // Style >>>
  width = 100vw
  height = 80vh
  replacedDuringUpdate = true
  messageBubbleStyle = [DefautlmessageBubbleStyle]
  messageFeedStyle = [DefautmessageFeedStyle]
  inputAreaStyle = [DefautinputAreaStyle]
  submitButtonStyle = [DefautsubmitButtonStyle]
  containerStyle = [DefaultcontainerStyle]
