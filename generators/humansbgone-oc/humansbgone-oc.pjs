$meta
  title = Humans-B-Gone! OC Generator
  description = Generate an OC for the web series Humans-B-Gone!


backgroundPlugin = {import:background-image-plugin}

backgroundImage = <img src\="https://user-uploads.perchance.org/file/7bc070e131e78e5dd3630489e37258a7.png"/>

