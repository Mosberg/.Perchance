showHex = false
showRe = false
showDamp = false
_updateOnly = false
_wasIs = false

userChoiceRace = random
userChoiceAlignment = random
userChoiceGender = random
userChoiceClass = random
userChoiceBackground = random
userChoiceAge = random
userChoiceCloth = random


isAgeless(race) =>
  return race == "warforged envoy" || race == "warforged juggernaut" || race == "warforged skirmisher" || race == "autognome";

noSkin(race) =>
  return race == "plasmoid" || race == "fire genasi" || race == "water genasi" || race == "earth genasi" || race == "air genasi" || race == "warforged envoy" || race == "warforged juggernaut" || race == "warforged skirmisher" || race == "autognome" || race == "locathah";

canNoClothes(race) =>
  return race == "fire genasi" || race == "water genasi" || race == "earth genasi" || race == "air genasi" || race == "plasmoid" || race == "lizardfolk" || race == "thri-kreen" || race == "grung" || race == "tortle" || race == "aarakocra" || race == "locathah";

hasLegs(race) =>
  return race != "merfolk";

calcGender(race, raw) =>
  let special = race == "plasmoid" || race == "fire genasi" || race == "water genasi" || race == "earth genasi" || race == "air genasi" || race == "changeling";
  return special ? (userChoiceGender == "random" ? genderappearance.selectOne : (raw == "male" ? "masculine" : "feminine")) : (Gender[raw] || raw);


Basic_Info
  [_updateOnly ? (_wasIs = _wasIs || "is") : (_wasIs = Math.random() < 0.5 ? "was" : "is"), _updateOnly == "race" ? (r = userChoiceRace == "random" ? ALLraces.selectOne.evaluateItem : userChoiceRace, g = calcGender(r, g_raw), a = isAgeless(r) ? "" : a, "") : _updateOnly == "gender" ? (g_raw = userChoiceGender == "random" ? Gender.selectOne.evaluateItem : userChoiceGender, g = calcGender(r, g_raw), "") : _updateOnly == "class" ? (c = userChoiceClass == "random" ? dnd_class.selectOne : userChoiceClass, "") : _updateOnly == "background" ? (b = userChoiceBackground == "random" ? dnd_background.selectOne : userChoiceBackground, "") : _updateOnly == "alignment" ? (al = userChoiceAlignment == "random" ? alignment.selectOne.evaluateItem : userChoiceAlignment, "") : _updateOnly == "age" ? (a = isAgeless(r) ? "" : Age.selectOne.evaluateItem, "") : _updateOnly ? ("") : (r = userChoiceRace == "random" ? ALLraces.selectOne.evaluateItem : userChoiceRace, g_raw = userChoiceGender == "random" ? Gender.selectOne.evaluateItem : userChoiceGender, g = calcGender(r, g_raw), c = userChoiceClass == "random" ? dnd_class.selectOne : userChoiceClass, b = userChoiceBackground == "random" ? dnd_background.selectOne : userChoiceBackground, a = isAgeless(r) ? "" : Age.selectOne.evaluateItem, al = userChoiceAlignment == "random" ? alignment.selectOne.evaluateItem : userChoiceAlignment, ""), _updateOnly = false, ""]You are {a} [a ? a + " " : ""][al] [isAgeless(r) ? "" : g + " "][r][showHex ? " hexblood" : ""][showDamp ? " dhampir" : ""][showRe ? " reborn" : ""] [c] who [_wasIs] {a} [b]

Personality
  [al == "chaotic good" ? cg_traits : ""] [al == "lawful good" ? lg_traits : ""] [al == "neutral good" ? ng_traits : ""] [al == "chaotic neutral" ? cn_traits : ""] [al == "lawful neutral" ? ln_traits : ""] [al == "neutral" ? n_traits : ""] [al == "chaotic evil" ? ce_traits : ""] [al == "lawful evil" ? le_traits : ""] [al == "neutral evil" ? ne_traits : ""] <br> [picked = ActivityorThingUniversal.selectUnique(4), lk1 = alignmentMap[al].evaluateItem, dk1 = alignmentMapdis[al].evaluateItem, likes2 = picked[0] == lk1 || picked[0] == dk1 ? picked[2] : picked[0], dislikes2 = picked[1] == lk1 || picked[1] == dk1 || picked[1] == likes2 ? (picked[3] == lk1 || picked[3] == dk1 || picked[3] == likes2 ? picked[2] : picked[3]) : picked[1], ""]Likes: [lk1] and [likes2] <br> Dislikes: [dk1] and [dislikes2] <br> You are [sexuality].

Clothing
  [gName = (g && g.name) ? g.name : (g || ""), cl = isAgeless(r) ? (Math.random() < 0.5 ? "No Clothes" : Clothing_list.selectOne) : (userChoiceCloth != "random" ? userChoiceCloth : (canNoClothes(r) && Math.random() < 0.3 ? "No Clothes" : gName == "female" || gName == "feminine" ? FeminineClothing_list.selectOne : gName == "male" || gName == "masculine" ? MasculineClothing_list.selectOne : Clothing_list.selectOne)), cl == "No Clothes" ? (isAgeless(r) ? "It" : gName == "male" ? "He" : gName == "female" ? "She" : "It") + " wears no clothes." : cl == "Robes" ? RobeDetails.evaluateItem : cl == "Masculine Common Clothes" ? MCommon.evaluateItem : cl == "Feminine Common Clothes" ? FCommon.evaluateItem : cl == "Masculine Traveler's Clothes" ? MTravel.evaluateItem : cl == "Feminine Traveler's Clothes" ? FTravel.evaluateItem : cl == "Masculine Fine Clothes" ? MFine.evaluateItem : cl == "Feminine Fine Clothes" ? FFine.evaluateItem : ""]


