$meta
  title = Electric Motor Simulator
  description = A real-time electric motor simulator with cross-section animation, back-EMF waveforms, brush sparking, and sound for Brushed DC, Induction, Synchronous, PMSM, and BLDC motors.
  tags = electric, motor, simulator, physics, BLDC, induction, PMSM

// ── Motor type configurations ──
motors
  brushed
    name = Brushed DC
    poles = 2
    phases = 1
    kv = 800           // RPM per volt
    resistance = 1.5   // ohms (armature)
    inductance = 0.003 // henries (armature)
    maxVoltage = 48      // rated voltage
    sliderMaxVoltage = 250
    maxCurrent = 15
    torqueConst = 0.04
    inertia = 0.00001
    friction = 0.000005
    slots = 12
    brushDrop = 1.6
    burnTemp = 110
    smokeTemp = 75
    fanCooling = 0.0045
    voltageRatings = 3, 6, 12, 24, 48, 90, 180, 240
    desc = Permanent magnet DC motor with 12-slot armature and carbon brushes
    failModes = thermal, overspeed, brush, short, bearing, overvolt, centrifugal, wire, ringoffire
