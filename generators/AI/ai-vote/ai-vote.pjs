  // onInput
  onInputTextChange(text) =>
    let container = document.activeElement ? document.activeElement.closest("#main-comment-panel, #room-comment-panel, #dnd-comment-panel") : null;
    let panelId = container && container.id === "room-comment-panel" ? "roomSlashSuggestPanel"
      : container && container.id === "dnd-comment-panel" ? "dndSlashSuggestPanel"
      : "slashSuggestPanel";
    ["slashSuggestPanel","roomSlashSuggestPanel","dndSlashSuggestPanel"].forEach(function(id) {
      if (id !== panelId) { let p = document.getElementById(id); if (p) { p.hidden = true; p.innerHTML = ""; } }
    });
    let panel = document.getElementById(panelId);
    if (!panel) return text;
    if (typeof text === "string" && text.charAt(0) === "/") {
      let query = text.slice(1).toLowerCase();
      let cmds = [["mock","aLtErNaTiNg CaSe"],["b","bold unicode text"],["i","italic unicode text"],["d20","roll a d20"],["help","help"]];
      let hits = query ? cmds.filter(function(c){ return c[0].indexOf(query) !== -1; }) : cmds;
      panel.hidden = false;
      panel.innerHTML = hits.length ? "<div class='ss-hint'>Slash commands</div>" + hits.map(function(c){ return "<div class='ss-row'><span class='ss-cmd'>/"+c[0]+"</span><span class='ss-desc'>"+c[1]+"</span></div>"; }).join("") : "<div class='ss-empty'>No matching commands</div>";
    } else {
      panel.hidden = true;
      panel.innerHTML = "";
    }
    return text

  // slash commands
  slashCommands
    mock
      output = [Array.from(this.input).map((char, i) => i % 2 == 0 ? char.toLowerCase() : char.toUpperCase()).join('')] // iT dOeS tHiS To tExT
    b
      output = [(() => { const U = Array.from("𝗔𝗕𝗖𝗗𝗘𝗙𝗚𝗛𝗜𝗝𝗞𝗟𝗠𝗡𝗢𝗣𝗤𝗥𝗦𝗧𝗨𝗩𝗪𝗫𝗬𝗭"); const L = Array.from("𝗮𝗯𝗰𝗱𝗲𝗳𝗴𝗵𝗶𝗷𝗸𝗹𝗺𝗻𝗼𝗽𝗾𝗿𝘀𝘁𝘂𝘃𝘄𝘅𝘆𝘇"); return this.input.replace(/[a-zA-Z]/g, function(c) { return c >= 'A' && c <= 'Z' ? U[c.charCodeAt(0)-65] : L[c.charCodeAt(0)-97]; }); })()]
    i
      output = [(() => { const U = Array.from("𝘈𝘉𝘊𝘋𝘌𝘍𝘎𝘏𝘐𝘑𝘒𝘓𝘔𝘕𝘖𝘗𝘘𝘙𝘚𝘛𝘜𝘝𝘞𝘟𝘠𝘡"); const L = Array.from("𝘢𝘣𝘤𝘥𝘦𝘧𝘨𝘩𝘪𝘫𝘬𝘭𝘮𝘯𝘰𝘱𝘲𝘳𝘴𝘵𝘶𝘷𝘸𝘹𝘺𝘻"); return this.input.replace(/[a-zA-Z]/g, function(c) { return c >= 'A' && c <= 'Z' ? U[c.charCodeAt(0)-65] : L[c.charCodeAt(0)-97]; }); })()]
    d20
      output = [(() => { const r = Math.floor(Math.random() * 20) + 1; let f = (r === 20) ? " (𝙉𝙖𝙩𝙪𝙧𝙖𝙡 𝟐𝟎 — 𝘾𝙍𝙄𝙏𝙄𝘾𝘼𝙇 𝙎𝙐𝘾𝘾𝙀𝙎𝙎!)" : (r === 1) ? " (𝘾𝙍𝙄𝙏𝙄𝘾𝘼𝙇 𝙁𝘼𝙄𝙇𝙐𝙍𝙀...)" : (r === 10) ? " (Neutral)" : (r < 10) ? " (Failure)" : " (Success)"; return `🎲 D20 Roll: ${r}${f}`; })()]
    help
      output = [(() => { const cmds = [["mock","aLtErNaTiNg CaSe"],["b","bold unicode text"],["i","italic unicode text"],["d20","roll a d20"],["help","help"]]; const q = (this.input || "").trim().toLowerCase(); const hits = q ? cmds.filter(function(c) { return c[0].indexOf(q) !== -1; }) : cmds; if (!hits.length) return "No slash commands matching \"" + q + "\""; const list = "📜 Commands  ‖  " + hits.map(function(c) { return "/" + c[0] + " — " + c[1]; }).join("  ·  "); if (q) return list; const about = "📖 Story Roulette  ‖  a collaborative story told one sentence at a time. Everyone writes, everyone votes, and the top-voted sentence wins and continues the story. One round per hour, one story per day."; const rooms = "🏠 Rooms  ‖  want your own private story with friends? Go to the ROOMS tab → tap + → name your room and set its round length & cooldown → then share that room name with the people you want to invite so they can type it into \"Join\" and hop in."; return about + "\n\n" + rooms + "\n\n" + list; })()]

