navbar = {import:navbar-plugin}
menu = {import:delta-index} 
title = Funki Fungerator
subtitle = Mushroom for more!
fontSize = 230
fontColor = black
buttonText = randomize
numberOfItems = 1
itemSeperator = <br/>

$meta
  title = Funki Fungerator
  description = (WIP) Creates a fictional mushroom name plus description, for all your fungal needs!


description
	{import:simple-gen-footer}
	<b>Please note:</b> This generator is still in progress! The word pool will continue to grow!</b> 
	$output = <p>[this.joinItems("</p><p>")]</p> // <-- don't remove this last line, it uses the special "$output" property to join and format your description as HTML paragraphs :)


$output = <b>[namemaker.titleCase]</b> <br><p style="font-size: 20px","text-align: left;""> [descriptioner]{|[descriptioner2]}. [fnfc = funfacter.consumableList]. [fnfc]. </p></br>

//first word for each pool also represents their root! 
//Base colors are also a top pool just for a higher chance to receive them
//Repeats of colors within pools may also exist for the same reason

namemaker
  {{import:adjective}|{import:mood}|{import:comparative-adjective}|{import:occupation}'s^0.5|{import:monster-type}'s|{import:terrain}|[outtexture]|[flavor]} {[capshape]|[fungtype]^5|{import:object}|{import:personal-title}|{import:random-weapon-types}^0.25|{import:container-type}|{import:musical-instrument}|{{import:noun}|{import:concrete-noun}}}

descriptioner
  {A} [size] [fungtype] with {{a} [outtexture] [fungiparts]|[outtexture] [fungiparts]s}
  {A} [size] [fungtype] featuring {a} [outtexture] stack of [capshape]s
  {A} {armored|hard-shelled} [fungtype] with {a} [outtexture] {skirt of plates|exoskeleton|outer cover|helmet}
  {A} [size], {import:face-shape} [fungtype] with {{a} [outtexture] [fungiparts]|[outtexture] [fungiparts]s}
  {A} [fungtype] with {a} [size] {main body|stem|{water|nutrient} chamber|trunk|base|neck|spore sack|primary pod|bag}
  {A} [size], {bundle|cluster|clump|swarm|pile|wad|bushel|hand|bouquet}-{shaped|style} [fungtype] with [size] {[fungiparts]|[capshape]}s

descriptioner2
  , and {a} [intexture] {middle|interior|center|core}
  , and {encrusted|coated|covered|encircled|lined|filled|plated} {with|by} {{import:morecolors}|[outtexture]} {minerals|crystals|gemstones|callouses|scabs|warts|keratin|chitin|{bone|armor|exoskeleton} plates|outer walls}
  , and {changes|shifts} to {a} {import:morecolors} {hue|shade|color} {with age|when damaged}
  , {becoming|being|shifting to be|appearing|and is visibly} more {[intexture]|[outtexture]|{import:morecolors}} {towards|near|at} its {base|center|top|bottom|[fungiparts]}
  , and {{filled|stuffed}|overflowing|{covered|coated}} with {{import:morecolors}|[flavor]} {sap|latex|goo|liquid|gel|plasm}
  , and [outtexture] {thorns|spines|spikes|barbs|hooks|needles}
  , and {a {pronounced|distinct|signature} {[fungiparts]|[capshape]}|{pronounced|distinct|signature} {[fungiparts]|[capshape]}s}

