comments = {import:comments-plugin}

bannedUsersList = [[]]


$meta
  title = Binarycat111's gateway
  description = the gate way to all of my generators
  header
    background
      #d8d3c5
    mode
      minimal

commentOptions // for comments plugin: https://perchance.org/comments-plugin
  adminFlair = 💎BINARYCODEDCAT💎
  deleteButtonIcon = ❌   
  width = 100%
  height = 400
  commentPlaceholderText = Type a friendly comment...
  submitButtonText = SUBMIT COMMENT
  bannedUsers = [bannedUsersList]
  adminPasswordHash = 64c38614675dad8f3eceacdccee80f284f17bdf9d253ed77f6b2ffa904c7506f
  customEmojiSize = 1.5
  messageBubbleStyle = background: rgba(0,40,28,0.6); font-family: 'Courier New'; color: #c8ffd9; border: 1px solid rgba(0,255,140,0.3); border-left: 3px solid #00ff7f; border-radius: 6px; text-shadow: 0 0 4px rgba(0,255,140,0.4)
  submitButtonStyle = background: rgba(0,40,28,0.6); font-family: 'Courier New'; color: #00ff7f; border: 1px solid rgba(0,255,140,0.4); border-radius: 6px; text-shadow: 0 0 6px rgba(0,255,127,0.6); cursor: pointer
  messageFeedStyle = background: #001a14; font-family: 'Courier New'; color: #7dffb0; border: 2px solid #1c1c1c; border-radius: 8px
  inputAreaStyle = background: rgba(0,30,22,0.8); font-family: 'Courier New'; color: {#c8ffd9|#7dffb0}; border: 1px solid rgba(0,255,140,0.3); border-radius: 6px
  customEmojis = {import:the-epic-emoji-list}