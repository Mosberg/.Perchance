$meta
  title = Kids Gym Tycoon 🏋️‍♂️
  description = Run your own super fun kids gym! Buy equipment, hire coaches, attract mini members, and grow your gym empire!
  tags = kids, gym, tycoon, simulator, manager

equipmentList() =>
  return [
  {key:"wall", name:"🧗 Climbing Wall", cost:200, appeal:8, income:12, desc:"Kids love scrambling up the colourful wall!"},
  {key:"tramp", name:"🤸 Trampoline", cost:150, appeal:10, income:9, desc:"Boing boing! Super bouncy fun."},
  {key:"hoop", name:"⛹️ Basketball Hoop", cost:120, appeal:6, income:7, desc:"Shoot some hoops and score big!"},
  {key:"obstacle", name:"🪢 Obstacle Course", cost:280, appeal:12, income:16, desc:"Crawl, climb, and dash to the finish!"},
  {key:"ballpit", name:"🏊 Ballpit", cost:180, appeal:9, income:10, desc:"A sea of squishy colourful balls!"},
  {key:"target", name:"🎯 Target Toss", cost:90, appeal:5, income:5, desc:"Aim, throw, and win stickers!"},
  {key:"slide", name:"🛝 Giant Slide", cost:350, appeal:14, income:20, desc:"Wheee! The biggest slide in town!"},
  {key:"yoga", name:"🧘 Yoga Mats", cost:70, appeal:4, income:4, desc:"Stretch and breathe like a pretend tree."},
  {key:"rope", name:"🪜 Rope Ladder", cost:110, appeal:6, income:6, desc:"Climb the wobbly ropes to the top!"},
  {key:"tunnel", name:"🌀 Play Tunnel", cost:80, appeal:5, income:4, desc:"Squeeze through the twisty tunnel!"},
  {key:"balance", name:"⚖️ Balance Beam", cost:130, appeal:7, income:8, desc:"Walk the plank — don't fall off!"},
  {key:"spring", name:"🦘 Spring Riders", cost:95, appeal:6, income:5, desc:"Bouncy animal riders for little ones!"},
  {key:"pool", name:"🏊‍♀️ Splash Pool", cost:400, appeal:15, income:22, desc:"A mini splash pad with fountains!"},
  {key:"dodge", name:"🏐 Dodgeball Arena", cost:220, appeal:11, income:14, desc:"Duck, dip, dive, and dodge!"},
  {key:"parkour", name:"🤾 Parkour Blocks", cost:320, appeal:13, income:18, desc:"Jump from block to block like a ninja!"},
  {key:"zip", name:"🪝 Zipline", cost:500, appeal:18, income:28, desc:"Zoom across the gym on a wire!"},
  {key:"ring", name:"💍 Ring Swing", cost:160, appeal:8, income:9, desc:"Swing from ring to ring like a gymnast!"},
  {key:"maze", name:"🧩 Foam Maze", cost:260, appeal:11, income:13, desc:"Find your way through soft foam walls!"},
  {key:"trampolong", name:"🤾‍♂️ Long Trampoline", cost:300, appeal:13, income:17, desc:"A runway of bouncy fun — do flips!"},
  {key:"climbrope", name:"🧗‍♀️ Climbing Rope", cost:140, appeal:7, income:8, desc:"Climb to the ceiling on a thick rope!"},
  {key:"ninja", name:"🥷 Ninja Course", cost:450, appeal:16, income:25, desc:"Stealth, speed, and agility training!"},
  {key:"boxing", name:"🥊 Mini Boxing Ring", cost:380, appeal:13, income:21, desc:"Jab, cross, hook — safe foam gloves!"},
  {key:"jungle", name:"🌳 Jungle Gym", cost:240, appeal:11, income:13, desc:"Swing and climb like a monkey!"},
  {key:"spinning", name:"🚴 Spin Bikes", cost:200, appeal:8, income:11, desc:"Pedal fast to the music!"},
  {key:"rowing", name:"🚣 Rowing Machines", cost:260, appeal:9, income:14, desc:"Row, row, row your boat!"},
  {key:"bouldering", name:"🪨 Bouldering Wall", cost:330, appeal:14, income:19, desc:"Climb sideways across colourful rocks!"},
  {key:"trapeze", name:"🎪 Trapeze Bars", cost:420, appeal:15, income:23, desc:"Swing through the air like a circus star!"},
  {key:"monkeybars", name:"🐒 Monkey Bars", cost:130, appeal:7, income:7, desc:"Swing from bar to bar!"},
  {key:"foampit", name:"🛏️ Foam Pit", cost:290, appeal:12, income:15, desc:"Jump and land in a giant soft pit!"},
  {key:"dance", name:"💃 Dance Studio", cost:350, appeal:14, income:20, desc:"Learn cool dance moves with mirrors!"},
  {key:"treadmill", name:"🏃‍♀️ Kids Treadmills", cost:190, appeal:7, income:10, desc:"Walk and jog safely with side rails!"},
  {key:"tenniswall", name:"🎾 Tennis Practice Wall", cost:170, appeal:7, income:9, desc:"Bounce balls off the wall — practise your swing!"},
  {key:"volleyball", name:"🏐 Volleyball Net", cost:200, appeal:8, income:11, desc:"Bump, set, spike over the net!"},
  {key:"minigolf", name:"⛳ Mini Golf Course", cost:280, appeal:11, income:15, desc:"Putt-putt fun with colourful obstacles!"},
  {key:"bowling", name:"🎳 Mini Bowling Lane", cost:340, appeal:12, income:18, desc:"Roll the ball and knock down the pins!"},
  {key:"punchbags", name:"🥊 Punching Bags", cost:160, appeal:7, income:8, desc:"Jab and hook at soft foam punching bags!"},
  {key:"cargonet", name:"🪢 Cargo Net Climb", cost:150, appeal:7, income:8, desc:"Climb the big rope net to the ceiling!"},
  {key:"hurdles", name:"🏃 Mini Hurdles", cost:100, appeal:5, income:6, desc:"Leap over the colourful hurdles!"},
  {key:"handball", name:"🤾 Handball Court", cost:260, appeal:10, income:14, desc:"Throw, bounce, and score in the goal!"},
  {key:"tumbling", name:"🤸 Tumbling Mats", cost:120, appeal:6, income:7, desc:"Soft mats for cartwheels and rolls!"},
  {key:"pegboard", name:"🧩 Peg Board", cost:230, appeal:10, income:12, desc:"Move pegs from hole to hole as you climb up!"},
  {key:"spinpoles", name:"🌀 Spinning Poles", cost:180, appeal:8, income:10, desc:"Twirl and spin around colourful padded poles!"},
  {key:"balboard", name:"⚖️ Balance Boards", cost:90, appeal:5, income:5, desc:"Wobble and balance on wooden boards!"},
  {key:"parachute", name:"🪂 Parachute Play", cost:140, appeal:7, income:7, desc:"Giant colourful parachute — wave it together!"},
  {key:"scooterbrd", name:"🛴 Scooter Boards", cost:110, appeal:6, income:6, desc:"Zip around the floor on wheeled scooters!"},
  {key:"pingpong", name:"🏓 Ping Pong Table", cost:170, appeal:7, income:9, desc:"Paddle and rally across the table!"},
  {key:"climbcube", name:"🧊 Climbing Cube", cost:310, appeal:13, income:16, desc:"A four-sided cube you can climb all around!"},
  {key:"aerobicstep", name:"🪜 Aerobic Steps", cost:130, appeal:6, income:7, desc:"Step up, step down to the beat!"},
  {key:"tightrope", name:"🪢 Slackline", cost:200, appeal:9, income:11, desc:"Walk the wobbly line between two posts!"},
  ];

staffList() =>
  return [
  {key:"coach", name:"🧑‍🏫 Coach", cost:100, salary:5, happiness:6, income:0, desc:"Trains kids and keeps them happy."},
  {key:"clown", name:"🤡 Party Entertainer", cost:160, salary:8, happiness:12, income:0, desc:"Balloon animals and silly jokes!"},
  {key:"snack", name:"🍎 Snack Bar Worker", cost:120, salary:6, happiness:0, income:8, desc:"Sells juicy snacks and smoothies."},
  {key:"janitor", name:"🧹 Janitor", cost:80, salary:4, happiness:3, income:0, desc:"Keeps the gym sparkling clean."},
  {key:"lifeguard", name:"🏊‍♀️ Lifeguard", cost:140, salary:7, happiness:5, income:0, desc:"Keeps kids safe around the splash pool!"},
  {key:"medic", name:"🧑‍⚕️ First Aider", cost:130, salary:6, happiness:4, income:0, desc:"Treats bumps and scrapes fast!"},
  {key:"music", name:"🎵 DJ", cost:170, salary:8, happiness:10, income:4, desc:"Plays upbeat tunes to keep energy high!"},
  {key:"photographer", name:"📸 Photographer", cost:150, salary:7, happiness:6, income:6, desc:"Takes fun photos of kids for parents to buy!"},
  {key:"dance", name:"💃 Dance Instructor", cost:145, salary:7, happiness:9, income:3, desc:"Teaches fun dance routines and choreography!"},
  {key:"security", name:"🛡️ Security Guard", cost:130, salary:6, happiness:2, income:0, desc:"Keeps everyone safe and supervises the floor!"},
  {key:"greeter", name:"🤗 Greeter", cost:90, salary:4, happiness:5, income:2, desc:"Welcomes every kid with a high-five and a smile!"},
  {key:"barista", name:"☕ Juice Barista", cost:160, salary:7, happiness:4, income:9, desc:"Whips up healthy smoothies and juice drinks!"},
  {key:"swimcoach", name:"🏊 Swim Instructor", cost:170, salary:8, happiness:7, income:3, desc:"Teaches kids to swim safely in the pool!"},
  {key:"yogateacher", name:"🧘 Yoga Instructor", cost:120, salary:5, happiness:8, income:2, desc:"Guides kids through fun stretching and mindfulness!"},
  {key:"maintenance", name:"🔧 Maintenance Worker", cost:100, salary:5, happiness:2, income:0, desc:"Fixes equipment fast — fewer breakdowns!"},
  {key:"nutritionist", name:"🥗 Nutritionist", cost:150, salary:7, happiness:3, income:5, desc:"Plans healthy menus that kids actually love!"},
  {key:"babysitter", name:"🧸 Babysitter", cost:90, salary:4, happiness:7, income:0, desc:"Watches the youngest kids while parents relax!"},
  {key:"lifeguard2", name:"🌊 Pool Attendant", cost:120, salary:5, happiness:3, income:0, desc:"Helps kids at the pool and keeps the deck dry!"},
  {key:"spotter", name:"🧗 Spotter", cost:115, salary:5, happiness:5, income:1, desc:"Watches kids on climbing walls — safer climbing!"},
  {key:"crafts", name:"🎨 Arts & Crafts Coordinator", cost:130, salary:6, happiness:9, income:2, desc:"Runs creative arts & crafts sessions — kids love it!"},
  ];

