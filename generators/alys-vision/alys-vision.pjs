image = {import:text-to-image-plugin}

BASE_NEGATIVE = "blurry, low quality, distorted, deformed, watermark, text, signature, jpeg artifacts, extra fingers, bad anatomy, ugly, oversaturated, grain, noise, artifact, cropped, out of frame, duplicate"

QUALITY_SUFFIX = ", masterpiece, best quality, highly detailed, sharp focus, professional, high resolution"

$output(data) =>
  if (data === undefined) return "Aguardando prompt...";

  let prompt = typeof data === "string" ? data : (data.prompt || "");
  let negative = typeof data === "object" && data.negativePrompt ? data.negativePrompt : BASE_NEGATIVE;
  let resolution = typeof data === "object" && data.resolution ? data.resolution : "768x768";
  let guidance = typeof data === "object" && data.guidanceScale ? data.guidanceScale : 30;
  let seed = typeof data === "object" && data.seed !== undefined ? data.seed : 792061758;

  let fullPrompt = prompt + QUALITY_SUFFIX;

  return image(fullPrompt, {
    resolution: resolution,
    guidanceScale: guidance,
    seed: seed,
    negativePrompt: negative
  });
