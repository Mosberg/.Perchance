$meta
  title = Very Very Detailed CYOA!!
  description = Forge worlds, craft heroes, and weave your own destiny through AI-driven interactive fiction. A deeply customizable choose-your-own-adventure storyteller with live narration, world-building, and character profiles.
  tags = interactive fiction, ai story, cyoa, choose your own adventure, roleplay, text adventure, storytelling
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}

// ── Option lists ──────────────────────────────────────────────
// Edit these lists to customize what appears in the Story Creator.
// Add/remove items freely; the UI rebuilds itself from them.

themes
  Fantasy
  Sci-Fi
  Horror
  Mystery
  Romance
  Cyberpunk
  Steampunk
  Post-Apocalyptic
  Historical
  Noir
  Superhero
  Survival
  Political Intrigue
  Time Travel
  Cosmic Horror
  Western
  Modern
  Medieval
  Space Opera
  Urban Fantasy
  Mythology
  Espionage
  Drama
  Comedy
  Thriller
  Slice of Life
  Supernatural
  War
  Exploration
  Philosophical Fiction

tones
  Grimdark
  Whimsical
  Epic
  Melancholic
  Humorous
  Tense
  Hopeful
  Cynical
  Dreamlike
  Violent
  Philosophical
  Nostalgic
  Solemn
  Sardonic
  Inspirational
  Ominous
  Romantic
  Brutal
  Surreal
  Lighthearted
  Sentimental
  Eerie
  Pessimistic
  Optimistic
  Satirical
  Mysterious
  Reverent

paces
  Glacial (Very slow, lingering moments)
  Deliberate (Slow, atmospheric)
  Steady (Balanced progression)
  Brisk (Moves quickly, light descriptions)
  Breakneck (Rapid fire action)

difficulties
  Easy (Rare challenges, forgiving)
  Normal (Occasional tough choices)
  Hard (Frequent problems, consequences)
  Unforgiving (Constant threats, high stakes)

detailLevels
  Minimal (Sparse)
  Moderate (Balanced)
  Rich (Vivid)
  Excessive (Immersion)

// Quick-start presets are defined in index.html (PRESETS constant).
// Add custom themes/tones by simply adding new lines to the lists above.
