$meta
  title = Public Comment Plugin
  description = A feature-rich public comment/chat plugin for Perchance generators.
  image = https://user.uploads.dev/file/a94a18d1fdfc51fb1a1a1f51dd5fb7b5.jpg
  tags = comments, chat, plugin, firebase, social

PerFavIcon = {import:per-favicon-plugin}

// --- Main Plugin Entry Point ---
// Usage:  ctn.innerHTML = $output({ channel: "my-chat", width: "400px" })
// Or:     [$output()] in HTML
// Options: width, height, channel, messageLimit, maxMessageLength,
//          accentColor, backgroundColor, backgroundImage, textColor, headerColor, borderColor,
//          borderRadius, fontFamily, placeholder, pgFilter, allowGifs, allowEmojis,
//          showHeader, showMinimize, showSidebar, showGifButton, showSendButton,
//          sendButtonText, headerText, emptyText, showDevModeToggle,
//          enableMarkdown, enableScheduledDeletion, dblClickToEdit, dblClickToReply
$output(options = {}) =>
  let defaults = {
    width: "320px",
    height: "auto",
    channel: "comments",
    messageLimit: 1000,
    maxMessageLength: 500,
    accentColor: "#5271ff",
    backgroundColor: "#ffffff",
    backgroundImage: "",
    textColor: "#333333",
    headerColor: "#f8f9fa",
    borderColor: "#e0e0e0",
    borderRadius: "8px",
    fontFamily: "Arial, sans-serif",
    placeholder: "Type a message...",
    pgFilter: true,
    allowGifs: true,
    allowEmojis: true,
    showHeader: true,
    showMinimize: true,
    showSidebar: true,
    showGifButton: true,
    showSendButton: true,
    showSendButtonIcon: true,
    enterToSend: true,
    sendButtonText: "",
    headerText: "",
    perdbApiKey: "pk_live_hzqj5cw9g47",
    showEllipsis: true,
    showThemeToggle: true,
    theme: "light",
    emptyText: "",
    showDevModeToggle: true,
    enableMarkdown: true,
    enableScheduledDeletion: true,
    dblClickToEdit: true,
    dblClickToReply: true
  };
  let opts = Object.assign({}, defaults, options);
  let optsJson = JSON.stringify(opts);
  let uid = "p" + Math.random().toString(36).slice(2, 10);
  let b64Js = "";
  let b64Html = "";
  let b64Css = "";
  let html = decodeURIComponent(escape(atob(b64Html)));
  let css = decodeURIComponent(escape(atob(b64Css)));
  if (opts.width) html = html.replace("width: 320px", "width: " + opts.width);
  html = html.replace('id="commentPluginCtn"', 'id="commentPluginCtn_' + uid + '"');
  setTimeout(function inject() {
    if (!document.getElementById('commentPluginCtn_' + uid)) {
      setTimeout(inject, 50);
      return;
    }
    let styleEl = document.createElement("style");
    styleEl.textContent = css;
    document.head.appendChild(styleEl);
    let js = atob(b64Js);
    let parts = js.split("__OPTS__");
    js = parts[0] + optsJson + parts[1];
    js = js.split("__UID__").join(uid);
    let s = document.createElement("script");
    s.type = "module";
    s.textContent = js;
    document.head.appendChild(s);
  }, 50);
  return html;
  