generateInterfaceHTML = {import:t2i-framework-plugin-v2-azel}


$meta
  title = 🌸 Mira 🌸

settings 
  pageTitle = 🌸 Mira - AI Art Generator 🌸  
  numImages = 2

  imageButtons
    
  
  // =========================================================
  // نظام توجيه البيانات إلى محرك الجافاسكريبت الداخلي
  // =========================================================
  imageOptions
    timestamp = [Date.now()]
    saveTitle = [input.description]
    prompt = [input.person] [input.artStyle.prompt] [input.description]
    negativePrompt = [input.negative] [input.artStyle.negative] 
    resolution = [input.shape]
    guidanceScale = 6
    seed = -1
    
  userInputs     
    scratchpad
      label = ✍️ Text-Based Prompt Output
      tip = The system will construct and display the final high-fidelity text prompt here.
      type = paragraph
      remember = true 
      parseVariables = true 
      width = min(750px, 100%) 
      height = 80vh  
      takesUpFullRow = true
      foldToggleState = hidden
      style = "border: 2px solid #000; background-color: #f9f9f9;"
      
    description
      label = 👍 Description 
      type = paragraph
      remember = true
      width = min(750px, 100%)
      takesUpFullRow = true
      useVariables = true
      useEnhancers = true

    negative
      label = 👎 Negative
      type = text
      remember = true
      useVariables = true
      useEnhancers = true
      
    artStyle
      label = 🎨 Art Style
      type = select
      remember = true
      options
        No_style
          prompt = ,
          negative = ,
        meta:import
          from = {import:t2i-styles-azel-v1}
          
    shape
      label = 🖼️ Image Resolution
      type = select
      remember = true
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512  
        
    person
      label = 🧝‍♀️ Person-Centric Focus
      type = select
      remember = true
      options
        No Specific Subject = ,
        Marilyn Monroe = A candid, intimate portrait of Marilyn Monroe capturing a natural, unguarded moment of cinematic elegance, hyper-realistic skin pores and fine facial textures, shimmering depth in the eyes, subtle soft-focus background, luminous cinematic lighting with soft volumetric highlights, rich velvet textures, high-fidelity film grain, 8k resolution, masterfully detailed complexion, preserve original composition, maintain exact subject pose and facial structure, retain original color palette and layout, sharp focus, highly detailed photorealism, professional color grading, shot on 35mm film, exquisite detail, ultra-sharp, refined textures.
        Audrey Hepburn = A timeless candid portrait of Audrey Hepburn, captured with effortless grace and natural poise, hyper-realistic skin textures with visible pores and fine lines, intricate fabric weave of her period-accurate attire, soft natural light illuminating her facial contours, shimmering depth in her expressive eyes, cinematic grain of vintage 35mm film, ultra-high definition clarity, 8k resolution, masterful chiaroscuro, preserve original composition, subject pose, facial structure, and authentic monochromatic or natural color palette, maintain identical layout and framing, highly detailed skin, sharp focus, professional photography, masterpiece, refined elegance, polished finish.
        Rita Hayworth = A candid, intimate portrait of actress Rita Hayworth, capturing her timeless elegance and natural expression. Enhance with hyper-realistic skin textures, fine pore detail, individual eyelash definition, and a soft cinematic glow. Amplify the richness of her auburn hair with subtle shimmering highlights and deep contrast. Refine the fabric texture of her attire to a tactile, high-fidelity quality. Maintain identical composition, subject positioning, original facial features, and the existing color palette. 8k resolution, masterwork, sharp focus, highly detailed eyes, professional studio lighting, film grain authenticity, photorealistic, polished finish, UHD.
        Jayne Mansfield = A candid cinematic portrait of actress Jayne Mansfield, capturing a spontaneous and natural expression, high-fidelity skin pores, intricate fabric textures of period-accurate clothing, soft ambient film lighting with subtle catchlights in the eyes, refined facial contours, polished 35mm film grain, hyper-realistic depth of field, preserve original composition, pose, facial structure, and color palette exactly, no structural alterations, 8k resolution, masterwork quality, sharp focus, professional color grading, Kodak Portra 400 aesthetic, ultra-detailed skin texture, photorealistic refinement.

  
    autoProcess
      label = ⚙️ Auto-Processing
      type = select
      remember = true
      tip = Automatically process each image as soon as it finishes generating. "Auto-fix" detects failed/blank generations and auto-retries them (real error recovery). "Auto-enhance" runs real pixel-level sharpening + auto-levels on a canvas — actually rewrites the image, not a CSS filter. "Full" does fix + enhance + auto-saves to your local gallery.
      options
        Off = off
        Auto-fix = autofix
        Auto-enhance = autoenhance
        Full = full
