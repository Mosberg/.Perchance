link = {import:link-plugin}
pageTitle = Just another random hybrid generator....
pageSubtitle = nothing crazy exept extra crazy....
fontSize = 130
fontColor = black // or "blue" or "green" or "#22c0f5" (hex colour code)
textAlignment = left
buttonText = randomize
numberOfItems = 1
itemSeparator = <br>
pageDescription
  totally not inspired/ripped off of this [link("https://randomanimalgenerator.pages.dev/", "random animal generator that's popping off")]. nope, just another random hybrid generator.

output = ["<p>"+paragraphs.joinItems("</p><p>")+"</p>"]

paragraphs
  [head]
  [eyes]
  [base]
  [leg]
  [feet]
  [tail]
  [coat]
  [colors]
  [extra]




head
  <b>head</b>: [being]^[HEAD.checked]
  [" "]^0.0001

eyes
  <b>eyes</b>: [being]^[EYES.checked]
  [" "]^0.0001
  

base
  <b>body</b>: [being]^[BASE.checked]
  [" "]^0.0001

leg
  <b>legs</b>: [being]^[LEGS.checked]
  [" "]^0.0001

feet
  <b>feet</b>: [being]^[FEET.checked]
  [" "]^0.0001

tail
  <b>tail</b>: [being]^[TAIL.checked]
  [" "]^0.0001

coat
  <b>skin</b>: [being]^[COAT.checked]
  [" "]^0.0001

colors
  <b>color</b>: {[being]|[being], but it's {import:colorz2}|{import:colorz2}}^[COLOR.checked]
  [" "]^0.0001 

extra
  <b>extra features</b>: {[feat]|[being]}^[EXTRA.checked]
  [" "]^0.0001

feat
  {2-10} legged
  {2-8} wings
  [being]-like shape
  {long|short|curled|curved|forked|many|{1-6}|weird|tuffed} {horns|antlers|antennae}
  {1-8} eyes
  {2-4} heads
  saber teeth
  tusks
  very {big|small|huge|tiny|skinny|chunky} in size
  is {a} {alien|robot|elemental|machine|toy|ghost}
  super {cute|ugly|pretty|scary}
  breaths fire
  {beaked|split|many-mouthed} face
  has a {trunk|single horn|row of spikes the back|shell|tall spine}
  armored {head|body|limbs|tail}
  a split jaw
  {1-6} horns
  {2-6} wings
  {2-6} tendrils sticking out their {back|shoulders|head}
  back {spikes|armor|plates|quills}
  {2-6} limbs
  {1-3} tails
  sharp teeth
  tentacles on their {face|back|forehead}
  a long tongue
  massive {talons|claws}
  antennae
  {1-6} eyes
  a {hammer|hatchet|saber}-shaped {tailtip|horn|nasal horn}
  saber teeth
  {small|large} tusks
  fins on their {head|back|tail|limbs}
  {a} {furry|feathery|spikey|quilly} mane
  a {long|short} {body|tail|neck|face}
  {long|short} limbs
  a {clubbed|thagomizer|stinger|fur|feather|blade|spade|quill}-tipped tail
  {hands|paws|talons|{odd|even|single}-toed hooves|webbed {hands|paws|talons}} for feet
  a wide mouth
  {chitinous|scaly|bony|leathery} armor
  

being
  [animal]^[ANIMAL.checked]
  [domestic]^[DOMESTIC.checked]
  [mythical]^[MYTH.checked]
  [vehicle]^[VEHICLE.checked]
  [fic]^[FIC.checked]
  [plant]^[PLANT.checked]
  {import:gemstone}^[GEM.checked]

