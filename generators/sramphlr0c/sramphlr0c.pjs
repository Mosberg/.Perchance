// ── Potion Brewing Game ──────────────────────────────────────────────
generateText = {import:ai-text-plugin}

$meta
  title = Potion Brewer
  description = Mix strange ingredients, brew potions with AI-generated effects, then drink them or sell them for gold.
  tags = potion, alchemy, ai, rpg, brewing

// Starting state is defined in index.html JS. main.pjs holds the data.

// Each ingredient: name + its magical essences (fed to the AI).
ingredient
  Bat Wing
    essence = night, flight, shadow, echolocation
  Dragon Scale
    essence = fire, protection, ancient power, wrath
  Moonpetal
    essence = light, dreams, calm, lunacy
  Toad Slime
    essence = poison, viscosity, transformation, swamp
  Phoenix Feather
    essence = fire, rebirth, radiance, flight
  Mandrake Root
    essence = screaming, sleep, death, earth
  Mermaid Tear
    essence = water, sorrow, longing, song
  Goblin Tooth
    essence = greed, malice, mischief, hunger
  Frost Moss
    essence = cold, stillness, time, decay
  Sunpetal
    essence = warmth, vitality, joy, growth
  Spider Silk
    essence = binding, patience, traps, fate
  Ghost Ash
    essence = memory, spirit, fading, regret
  Basilisk Eye
    essence = stone, gaze, fear, death
  Thunderstone
    essence = storm, speed, shock, chaos
  Witch Hazel
    essence = healing, sight, intuition, bitter
  Nightshade
    essence = poison, sleep, beauty, death
  Quartz Dust
    essence = clarity, mind, focus, fragility
  Banshee Wail (bottled)
    essence = sound, grief, warning, piercing
  Griffin Claw
    essence = nobility, sky, sharpness, courage
  Kraken Ink
    essence = depth, secrecy, abyss, black
  Honeycomb
    essence = sweetness, gold, community, stickiness
  Iron Shard
    essence = metal, strength, cold, war
  Lotus Bloom
    essence = serenity, enlightenment, water, rebirth
  Vampire Dust
    essence = blood, immortality, thirst, dusk

// Player starts with a random handful of these.

// Body parts that potions can mutate. Each starts as "normal human".
bodyPart
  head
  face
  eyes
  ears
  arms
  hands
  legs
  feet
  skin
  hair
  torso
  voice

