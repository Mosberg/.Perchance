{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./character-visual-description.schema.json",
  "title": "Character Visual Description",
  "type": "object",

  "properties": {
    "characterId": { "type": "string" },

    "name": {
      "type": "object",
      "properties": {
        "full": { "type": "string" },
        "nickname": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["full"]
    },

    "identity": {
      "type": "object",
      "properties": {
        "age": { "type": "number" },
        "genderExpression": { "type": "string" },
        "pronouns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "species": { "type": "string" },
        "ethnicity": { "type": "string" },
        "cultureInfluence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "body": {
      "type": "object",
      "properties": {
        "height": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "relative": { "type": "string" }
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "overall": { "type": "string" },
            "details": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "posture": {
          "type": "object",
          "properties": {
            "default": { "type": "string" },
            "walkStyle": { "type": "string" }
          }
        },
        "skin": {
          "type": "object",
          "properties": {
            "tone": { "type": "string" },
            "undertone": { "type": "string" },
            "texture": {
              "type": "array",
              "items": { "type": "string" }
            },
            "marks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "location": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["type", "location", "description"]
              }
            }
          }
        }
      }
    },

    "face": {
      "type": "object",
      "properties": {
        "shape": { "type": "string" },
        "features": {
          "type": "object",
          "properties": {
            "eyes": {
              "type": "object",
              "properties": {
                "shape": { "type": "string" },
                "size": { "type": "string" },
                "color": {
                  "type": "object",
                  "properties": {
                    "base": { "type": "string" },
                    "details": { "type": "string" }
                  }
                },
                "brows": {
                  "type": "object",
                  "properties": {
                    "shape": { "type": "string" },
                    "thickness": { "type": "string" },
                    "notes": { "type": "string" }
                  }
                },
                "expressionDefault": { "type": "string" },
                "expressionRange": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "nose": {
              "type": "object",
              "properties": {
                "shape": { "type": "string" },
                "size": { "type": "string" },
                "tip": { "type": "string" }
              }
            },
            "mouth": {
              "type": "object",
              "properties": {
                "lipShape": { "type": "string" },
                "lipSize": { "type": "string" },
                "defaultExpression": { "type": "string" },
                "teeth": { "type": "string" }
              }
            },
            "cheeks": {
              "type": "object",
              "properties": {
                "definition": { "type": "string" },
                "notes": { "type": "string" }
              }
            },
            "chin": {
              "type": "object",
              "properties": {
                "shape": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "hair": {
      "type": "object",
      "properties": {
        "length": { "type": "string" },
        "overallStyle": { "type": "string" },
        "color": {
          "type": "object",
          "properties": {
            "base": { "type": "string" },
            "highlights": { "type": "string" },
            "roots": { "type": "string" },
            "tips": { "type": "string" }
          }
        },
        "texture": { "type": "string" },
        "parting": { "type": "string" },
        "movement": { "type": "string" },
        "facialHair": {
          "type": "object",
          "properties": {
            "hasFacialHair": { "type": "boolean" },
            "description": { "type": ["string", "null"] }
          }
        }
      }
    },

    "eyesDetail": {
      "type": "object",
      "properties": {
        "glasses": {
          "type": "object",
          "properties": {
            "wearsGlasses": { "type": "boolean" },
            "type": { "type": "string" },
            "color": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "other": {
          "type": "object",
          "properties": {
            "makeup": {
              "type": "object",
              "properties": {
                "style": { "type": "string" },
                "details": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "clothing": {
      "type": "object",
      "properties": {
        "overallStyle": { "type": "string" },
        "primaryOutfit": {
          "type": "object",
          "properties": {
            "top": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "color": { "type": "string" },
                "material": { "type": "string" },
                "details": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "innerLayer": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "color": { "type": "string" },
                "material": { "type": "string" }
              }
            },
            "bottom": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "color": { "type": "string" },
                "material": { "type": "string" },
                "details": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "footwear": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "color": { "type": "string" },
                "material": { "type": "string" },
                "details": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "outerwearOptional": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "color": { "type": "string" },
                "material": { "type": "string" },
                "usage": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "accessories": {
      "type": "object",
      "properties": {
        "jewelry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" },
              "symbolism": { "type": "string" }
            }
          }
        },
        "gear": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "position": { "type": "string" },
              "color": { "type": "string" },
              "details": { "type": "string" },
              "functionHint": { "type": "string" }
            }
          }
        },
        "other": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" },
              "color": { "type": "string" },
              "symbolism": { "type": "string" }
            }
          }
        }
      }
    },

    "colorPalette": {
      "type": "object",
      "properties": {
        "dominant": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mood": { "type": "string" }
      }
    },

    "styleAndVibe": {
      "type": "object",
      "properties": {
        "visualKeywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "firstImpression": { "type": "string" },
        "silhouette": { "type": "string" },
        "motionFeel": { "type": "string" }
      }
    },

    "environmentContext": {
      "type": "object",
      "properties": {
        "typicalSetting": { "type": "string" },
        "lighting": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weatherInteraction": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "expressionVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "eyes": { "type": "string" },
          "mouth": { "type": "string" },
          "body": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "intendedMediums": {
          "type": "array",
          "items": { "type": "string" }
        },
        "detailLevel": { "type": "string" },
        "referenceNotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "required": ["characterId", "name"]
}
