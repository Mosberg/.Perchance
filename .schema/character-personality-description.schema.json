{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./character-personality-description.schema.json",
  "title": "Character Personality Description",
  "type": "object",

  "properties": {
    "characterId": { "type": "string" },

    "corePersonality": {
      "type": "object",
      "properties": {
        "traitsPrimary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "traitsSecondary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "temperament": { "type": "string" },
        "dominantMotivations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emotionalBaseline": { "type": "string" }
      }
    },

    "communicationStyle": {
      "type": "object",
      "properties": {
        "tone": { "type": "string" },
        "pace": { "type": "string" },
        "directness": { "type": "string" },
        "expressiveness": { "type": "string" },
        "listeningStyle": { "type": "string" }
      }
    },

    "socialBehavior": {
      "type": "object",
      "properties": {
        "introversionExtroversion": { "type": "string" },
        "groupRole": { "type": "string" },
        "trustLevel": { "type": "string" },
        "humorStyle": { "type": "string" },
        "conflictStyle": { "type": "string" }
      }
    },

    "valuesAndBeliefs": {
      "type": "object",
      "properties": {
        "coreValues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "worldview": { "type": "string" },
        "moralAlignment": { "type": "string" },
        "personalCode": { "type": "string" }
      }
    },

    "strengthsAndWeaknesses": {
      "type": "object",
      "properties": {
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blindSpots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "emotionalProfile": {
      "type": "object",
      "properties": {
        "defaultMood": { "type": "string" },
        "stressResponse": { "type": "string" },
        "comfortActivities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emotionalTriggers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "relationshipDynamics": {
      "type": "object",
      "properties": {
        "attachmentStyle": { "type": "string" },
        "interactionPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supportStyle": { "type": "string" },
        "boundaries": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "decisionMaking": {
      "type": "object",
      "properties": {
        "logicVsEmotion": { "type": "string" },
        "riskTolerance": { "type": "string" },
        "planningStyle": { "type": "string" },
        "problemSolvingApproach": { "type": "string" }
      }
    },

    "quirksAndHabits": {
      "type": "object",
      "properties": {
        "quirks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "habits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "microExpressions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "narrativeHooks": {
      "type": "object",
      "properties": {
        "personalGoals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fears": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "internalConflicts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "intendedUse": { "type": "string" },
        "detailLevel": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "required": ["characterId", "corePersonality"]
}
